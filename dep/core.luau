    return ok, res
end

-- a timeout surfaces as a transport failure, not a status; those, plus 408/429 and 5xx, are worth another attempt, and every other status is the server's final answer
function M.isTransient(ok, res)
    if not ok or type(res) ~= "table" then return true end
    local status = readStatus(res)
    if status == 0 or status == 408 or status == 429 then return true end
    return status >= 500
end

-- cfg = { attempts, backoff, factor, ceiling, onRetry = fn(attempt, res) }; every field is optional
local function backoffLoop(cfg, attempt_fn)
    cfg = cfg or {}
    local attempts = cfg.attempts or RETRY_ATTEMPTS
    local delay    = cfg.backoff or RETRY_BACKOFF
    local factor   = cfg.factor or RETRY_FACTOR
    local ceiling  = cfg.ceiling or RETRY_CEILING

    local a, b, c
    for attempt = 1, attempts do
        local settled
        settled, a, b, c = attempt_fn(attempt)
        if settled then return a, b, c end
        if attempt < attempts then
            if cfg.onRetry then pcall(cfg.onRetry, attempt, a) end
            task.wait(delay)
            delay = math.min(delay * factor, ceiling)
        end
    end
    return a, b, c
end

