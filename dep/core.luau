__bundle_register("Features/Configs/Reporter", function(require, _LOADED, __bundle_register, __bundle_modules)
-- config report flow: mints a one-click moderator delete URL then posts an embed to ConfigsReportWebhook; steps pcall-isolated

local ConfigSecrets = require("ConfigSecrets")
local Api           = require("Features/Configs/Api")
local Http          = require("Utility/Helpers/Http")
local Log           = require("Utility/Log")

local M = {}

local DISCORD_RED  = 15158332   -- #E74C3C, decimal
local DISCORD_GRAY = 9807270    -- neutral fallback

local function postWebhook(webhookUrl, body)
    if not Http.client() then return false, "no http client" end
    local data, err = Http.postJson(webhookUrl, body, { ["Accept"] = "application/json" })
    if data then return true end
    return false, tostring(err)
end

local function buildEmbed(opts)
    local fields = {
        { name = "Reason",       value = tostring(opts.reason or "Unspecified"), inline = true },
        { name = "Game",         value = tostring(opts.game or "Unknown"),       inline = true },
        { name = "Config Name",  value = tostring(opts.configName or "(unnamed)"), inline = false },
        { name = "Config ID",    value = "`" .. tostring(opts.configId or "?") .. "`", inline = true },
        { name = "Owner",        value = "`" .. tostring(opts.ownerDiscordId or "?") .. "`", inline = true },
        { name = "Reporter",     value = "`" .. tostring(opts.reporterDiscordId or "anonymous") .. "`", inline = true },
    }

    local description = opts.description
    if type(description) == "string" and description:gsub("%s", "") ~= "" then
        fields[#fields + 1] = { name = "Description", value = description, inline = false }
    end

    if type(opts.deleteUrl) == "string" and opts.deleteUrl ~= "" then
        local expiry = opts.deleteExpiresAt
        local linkValue = "[Click to delete (one-time, " ..
            (expiry and ("expires " .. tostring(expiry)) or "TTL bounded") ..
            ")](" .. opts.deleteUrl .. ")"
        fields[#fields + 1] = { name = "Moderator Action", value = linkValue, inline = false }
    elseif opts.deleteUrlError then
        fields[#fields + 1] = {
            name  = "Moderator Action",
            value = "Couldn't mint delete link: `" .. tostring(opts.deleteUrlError) ..
                    "` — delete via the admin panel.",
            inline = false,
        }
    end

    return {
        title       = "Config Reported",
        description = "A user has flagged a community config for review.",
        color       = DISCORD_RED,
        fields      = fields,
        timestamp   = os.date("!%Y-%m-%dT%H:%M:%SZ"),
        footer      = { text = "Cerberus / Community Configs" },
    }
end

-- returns (ok, errMessage); delete-link mint is best-effort — a failure is noted in the embed and the webhook still posts
function M.submit(opts)
    if type(opts) ~= "table" then return false, "invalid opts" end
    if type(opts.configId) ~= "string" or opts.configId == "" then
        return false, "missing config id"
    end

    local webhookUrl = ConfigSecrets and ConfigSecrets.ConfigsReportWebhook
    if type(webhookUrl) ~= "string" or webhookUrl == "" then
        return false, "report webhook not configured"
    end

    -- the mint API requires the OWNER's discord_id, not the reporter's
    local deleteUrl, deleteExpires, deleteErr
    if Api.canWrite() and type(opts.ownerDiscordId) == "string" and opts.ownerDiscordId ~= "" then
        local data, err = Api.mintDeleteLink(opts.configId, opts.ownerDiscordId, 720)
        if data and type(data.url) == "string" then
            deleteUrl     = data.url
            deleteExpires = data.expires_at
        else
            deleteErr = err or "unknown error"
        end
    else
        deleteErr = "no API key or missing owner id"
    end

    local embed = buildEmbed({
        reason            = opts.reason,
        description       = opts.description,
        configId          = opts.configId,
        configName        = opts.configName,
        game              = opts.game,
        ownerDiscordId    = opts.ownerDiscordId,
        reporterDiscordId = opts.reporterDiscordId,
        deleteUrl         = deleteUrl,
        deleteExpiresAt   = deleteExpires,
        deleteUrlError    = deleteErr,
    })

    local ok, err = postWebhook(webhookUrl, { embeds = { embed } })
    Log.webhook("config report", ok)
    return ok, err
end

return M

end)
__bundle_register("Features/Configs/Api", function(require, _LOADED, __bundle_register, __bundle_modules)
-- http client for getcerberus.com /api/configs; every endpoint returns (data, errMessage, statusCode, rawDecoded), data nil on non-2xx

local ConfigSecrets = require("ConfigSecrets")
local Http          = require("Utility/Helpers/Http")
local Services      = require("Services")

local HttpService = Services.HttpService

-- reads are safe to repeat, writes are not, so only GETs retry past a timeout
local READ_RETRY = { attempts = 3 }

local M = {}

local function trimSlashes(s)
    return (tostring(s or ""):gsub("/+$", ""))
end

local function baseUrl()
    return trimSlashes(ConfigSecrets.ConfigsApiUrl or "")
end

local function urlEncode(s)
    if HttpService.UrlEncode then
        local ok, encoded = pcall(HttpService.UrlEncode, HttpService, tostring(s))
        if ok then return encoded end
    end
    return tostring(s):gsub("[^%w%-_%.~]", function(c)
        return string.format("%%%02X", string.byte(c))
    end)
end

local function buildQuery(params)
    if type(params) ~= "table" then return "" end
    local parts = {}
    for k, v in pairs(params) do
        if v ~= nil and v ~= "" then
            parts[#parts + 1] = urlEncode(k) .. "=" .. urlEncode(v)
        end
    end
    if #parts == 0 then return "" end
    return "?" .. table.concat(parts, "&")
end

local function request(method, path, body, withAuth)
    if not Http.client() then
        return nil, "no http client available on this executor", 0, nil
    end

    local url = baseUrl()
    if url == "" then
        return nil, "ConfigsApiUrl not configured", 0, nil
    end

    local headers = { ["Accept"] = "application/json" }
    if withAuth then
        local key = ConfigSecrets.ConfigsApiKey or ""
        if key == "" then
            return nil, "ConfigsApiKey not configured (writes disabled)", 0, nil
        end
        headers["Authorization"] = "Bearer " .. key
    end

    -- reads are safe to repeat, writes are not, so only GETs get the retry cfg
    return Http.json({
        url     = url .. path,
        method  = method,
        body    = body,
        headers = headers,
        retry   = (method == "GET") and READ_RETRY or false,
    })
end

-- GET /api/configs (metadata only, public)
function M.list(opts)
    opts = opts or {}
    local query = buildQuery({
        game              = opts.game,
        discord_id        = opts.discord_id,
        viewer_discord_id = opts.viewer_discord_id,
        sort              = opts.sort,
        limit             = opts.limit,
    })
    return request("GET", "/api/configs" .. query, nil, false)
end

-- GET /api/configs/:id (full document, public)
function M.get(id, viewerDiscordId)
    if id == nil or id == "" then return nil, "missing id", 0, nil end
    local query = buildQuery({ viewer_discord_id = viewerDiscordId })
    return request("GET", "/api/configs/" .. urlEncode(tostring(id)) .. query, nil, false)
end

-- POST /api/configs (auth)
function M.create(payload)
    return request("POST", "/api/configs", payload, true)
end

-- PATCH /api/configs/:id (auth)
function M.update(id, payload)
    if id == nil or id == "" then return nil, "missing id", 0, nil end
    return request("PATCH", "/api/configs/" .. urlEncode(tostring(id)), payload, true)
end

-- POST /api/configs/:id/delete-link (auth) — one-time moderator delete URL; discord_id must be the owner's, ttl_hours max 720
function M.mintDeleteLink(id, ownerDiscordId, ttlHours)
    if id == nil or id == "" then return nil, "missing id", 0, nil end
    return request("POST",
        "/api/configs/" .. urlEncode(tostring(id)) .. "/delete-link",
        {
            discord_id = ownerDiscordId,
            ttl_hours  = ttlHours or 720,  -- 30 days max — moderation can be slow
        }, true)
end

-- DELETE /api/configs/:id (auth) — body carries discord_id for server-side ownership verification
function M.delete(id, discordId)
    if id == nil or id == "" then return nil, "missing id", 0, nil end
    return request("DELETE",
        "/api/configs/" .. urlEncode(tostring(id)),
        { discord_id = discordId }, true)
end

-- POST /api/configs/:id/vote (auth, idempotent)
function M.vote(id, discordId)
    if id == nil or id == "" then return nil, "missing id", 0, nil end
    return request("POST",
        "/api/configs/" .. urlEncode(tostring(id)) .. "/vote",
        { discord_id = discordId }, true)
end

-- DELETE /api/configs/:id/vote (auth, idempotent)
function M.unvote(id, discordId)
    if id == nil or id == "" then return nil, "missing id", 0, nil end
    return request("DELETE",
        "/api/configs/" .. urlEncode(tostring(id)) .. "/vote",
        { discord_id = discordId }, true)
end

-- true when the bundle has a configs API key; UI hides submit/vote when false
function M.canWrite()
    local key = ConfigSecrets.ConfigsApiKey
    return type(key) == "string" and key ~= ""
end

