__bundle_register("Features/Configs/Storage", function(require, _LOADED, __bundle_register, __bundle_modules)
-- local file ops for the per-game Cerberus/<gameName>/settings/Configurations folder that SaveManager owns

local References = require("References")
local Services   = require("Services")

local HttpService = Services.HttpService

local M = {}

local function root()
    local game = (References and References.gameName) or "Universal"
    return ("Cerberus/%s/settings/Configurations"):format(game)
end

local function ensureFolder(path)
    if not (isfolder and makefolder) then return end
    if isfolder(path) then return end
    -- create each segment in turn so partial trees don't break makefolder
    local parts = path:split("/")
    local accum = ""
    for i, seg in ipairs(parts) do
        accum = (i == 1) and seg or (accum .. "/" .. seg)
        if not isfolder(accum) then
            pcall(makefolder, accum)
        end
    end
end

local function safeName(name)
    if type(name) ~= "string" then return nil end
    -- strip path separators / control chars so writes can't escape the Configurations folder
    local cleaned = name:gsub("[/\\%c%z%*%?%<%>%|%:%\"]", ""):gsub("^%s+", ""):gsub("%s+$", "")
    if cleaned == "" then return nil end
    if cleaned == "autoload_players" then return nil end -- internal SaveManager file
    return cleaned
end

-- local config names sans .json, sorted; excludes the internal autoload_players mapping
function M.listLocal()
    local out = {}
    if not (listfiles and isfolder) then return out end
    local dir = root()
    if not isfolder(dir) then return out end
    local ok, files = pcall(listfiles, dir)
    if not ok or type(files) ~= "table" then return out end
    for _, full in ipairs(files) do
        local name = full:match("([^/\\]+)%.json$")
        if name and name ~= "autoload_players" then
            out[#out + 1] = name
        end
    end
    table.sort(out)
    return out
end

-- decoded JSON payload, or nil on any failure
function M.read(name)
    local clean = safeName(name)
    if not clean then return nil end
    if not (isfile and readfile) then return nil end
    local path = root() .. "/" .. clean .. ".json"
    if not isfile(path) then return nil end
    local okRead, raw = pcall(readfile, path)
    if not okRead or type(raw) ~= "string" then return nil end
    local okDecode, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
    if not okDecode then return nil end
    return decoded
end

-- returns (ok, errMessage); on success the file is immediately visible to SaveManager:RefreshConfigList
function M.write(name, data)
    local clean = safeName(name)
    if not clean then return false, "invalid config name" end
    if not writefile then return false, "writefile unavailable" end
    ensureFolder(root())
    local okEnc, encoded = pcall(HttpService.JSONEncode, HttpService, data)
    if not okEnc or type(encoded) ~= "string" then return false, "encode failed" end
    local okWrite, err = pcall(writefile, root() .. "/" .. clean .. ".json", encoded)
    if not okWrite then return false, "write failed: " .. tostring(err) end
    return true
end

function M.exists(name)
    local clean = safeName(name)
    if not clean or not isfile then return false end
    return isfile(root() .. "/" .. clean .. ".json")
end

-- best-effort delete, returns (ok, errMessage); pcall-wrapped so an executor hiccup doesn't crash the popup
function M.deleteLocal(name)
    local clean = safeName(name)
    if not clean then return false, "invalid config name" end
    if not delfile then return false, "delfile unavailable" end
    local path = root() .. "/" .. clean .. ".json"
    if isfile and not isfile(path) then return true end
    local ok, err = pcall(delfile, path)
    if not ok then return false, "delete failed: " .. tostring(err) end
    return true
end

function M.gameName()
    return (References and References.gameName) or "Universal"
end

-- pick a non-colliding local name: "My Build", "My Build (1)", ...
function M.pickFreeName(suggested)
    local base = safeName(suggested) or "imported"
    if not M.exists(base) then return base end
    for i = 1, 50 do
        local candidate = ("%s (%d)"):format(base, i)
        if not M.exists(candidate) then return candidate end
    end
    return ("%s (%d)"):format(base, os.time() % 100000)
end

return M

end)
__bundle_register("Bootstrap/SessionLifecycle", function(require, _LOADED, __bundle_register, __bundle_modules)
-- sessionlifecycle: unloader, character respawn wiring, Library:OnUnload, autoload + teleport-queue + logger + auth detectors

local Services      = require("Services")
local References    = require("References")
local TeleportQueue = require("TeleportQueue")
local Jobs          = require("Utility/Jobs")
local Logger        = require("Utility/Logger")
local Globals       = require("Utility/Globals")
local Log           = require("Utility/Log")

-- the façade, not the sub-modules: the build toggle (core/Build.lua auth.detections) stubs
-- this one require out when the tamper layer is off, dropping the detectors from the bundle
local AuthDetections = require("Auth/Detections")

local M = {}

function M.buildUnloader(rootMaid)
    local unloader = { _maid = rootMaid, _ran = false }
    function unloader:Register(t) if not self._ran and t ~= nil then self._maid:GiveTask(t) end end
    function unloader:Add(t) self:Register(t) end
    -- outermost guard: Maid isolates each task, this catches a failure in the sweep itself
    function unloader:Run()
        if self._ran then return end
        self._ran = true
        local ok, err = pcall(function() self._maid:DoCleaning() end)
        if not ok then Log.warn(("[Cerberus] unload sweep failed: %s"):format(tostring(err))) end
    end
    function unloader:Destroy() self:Run() end
    return unloader
end

local function setupReferences(char)
    References.character = char or References.player.Character
    References.humanoid = References.character and References.character:FindFirstChildOfClass("Humanoid") or nil
    References.humanoidRootPart = References.character and References.character:FindFirstChild("HumanoidRootPart") or nil
    References.camera = Services.Workspace.CurrentCamera
end

function M.bindCharacterHooks(ctx, Movement)
    local Toggles  = ctx.Library.Toggles
    local Unloader = ctx.Unloader

    local function onCharacterAdded(char)
        -- never call setupReferences with a partial character — nil humanoid/hrp silently breaks every feature until next respawn
        local hum = char:WaitForChild("Humanoid", 5)
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if not hum or not hrp then
            local missing = (not hum and not hrp) and "Humanoid+HumanoidRootPart"
                or (not hum and "Humanoid" or "HumanoidRootPart")
            Log.warn(("[Cerberus] character respawn: %s did not replicate within 5s — features will rebind on next respawn."):format(missing))
            return
        end
        setupReferences(char)
        References._fireCharacter(char)
        if not Movement then return end
        -- via Jobs so an unload inside the 0.25s settle window can't re-arm movement on a torn-down feature
        local function rearm(toggleName, startFn)
            if Toggles[toggleName] and Toggles[toggleName].Value and Movement[startFn] then
                Unloader:Register(Jobs.delay(0.25, function() Movement[startFn]() end,
                    { name = "Rearm:" .. startFn }))
            end
        end
        rearm("FlightEnabled",  "startFlight")
        rearm("SpeedEnabled",   "startSpeed")
        rearm("JumpPower",      "startJumpMod")
        rearm("InfiniteJump",   "startInfiniteJump")
    end

    Unloader:Register(References.player.CharacterAdded:Connect(function(char)
        onCharacterAdded(char)
    end))

    -- task.spawn so the up-to-5s WaitForChild inside onCharacterAdded can't block boot
    if References.player.Character then
        task.spawn(onCharacterAdded, References.player.Character)
    end

    Unloader:Register(References.player.CharacterRemoving:Connect(function()
        References._fireCharacterRemoving()
        if Movement then
            for _, fn in ipairs({"stopFlight","stopSpeed","stopJumpMod","stopInfiniteJump"}) do
                if Movement[fn] then Movement[fn]() end
            end
        end
        setupReferences(nil)
    end))

    Unloader:Register(Services.Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        References.camera = Services.Workspace.CurrentCamera
    end))
end

-- obsidian's OnUnload fires before RootMaid: save the active config, then clear globals so the next launch's guard sees a clean slate
function M.wireOnUnload(ctx)
    local Library     = ctx.Library
    local SaveManager = ctx.SaveManager
    local Unloader    = ctx.Unloader

    Library:OnUnload(function()
        pcall(function()
            -- Globals.clear() sweeps every registered cross-execution global (marker Instance destroyed generically); a re-exec re-queues teleport payloads but the single-instance guard makes duplicates harmless
            Globals.clear()
            if SaveManager and SaveManager.Save then
                local name
                if Library.Options and Library.Options.SaveManager_ConfigList then
                    name = Library.Options.SaveManager_ConfigList.Value
                end
                if (not name or name == "") and SaveManager.GetAutoloadConfig then
                    local auto = SaveManager:GetAutoloadConfig()
                    if auto and auto ~= "none" then name = auto end
                end
                if name and name ~= "" then SaveManager:Save(name) end
            end
        end)
        Unloader:Run()
    end)
end

function M.applyAutoload(ctx)
    local Library     = ctx.Library
    local SaveManager = ctx.SaveManager

    SaveManager:LoadAutoloadConfig()
    local auto = SaveManager.GetAutoloadConfig and SaveManager:GetAutoloadConfig()
    if auto and auto ~= "none" and Library.Options and Library.Options.SaveManager_ConfigList then
        Library.Options.SaveManager_ConfigList:SetValue(auto)
    end
end

-- passive in-session detectors (gate already ran in Init); each registers with ctx.Unloader so a re-exec can't stack duplicates
function M.startAuthDetectors(ctx)
    local unloader = ctx and ctx.Unloader or nil
    pcall(AuthDetections.start, unloader)
end

function M.startLogger(ctx)
    -- _G (not getgenv) so external harness rawget(_G, ...) sees it; Globals-registered so the unload sweep clears it
    Globals.setRaw("scriptName", References.gameName)
    pcall(Logger, ctx)
end

function M.startTeleportQueue(ctx)
    TeleportQueue(ctx)
end

return M

end)
