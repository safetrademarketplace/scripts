    end

    MusicGroup:AddButton({
        Text = "Add Music To Music List",
        Func = function()
            local url = Str.trim(tostring((Options.MUSIC_URL and Options.MUSIC_URL.Value) or ""))
            local nm  = Str.trim(tostring((Options.MUSIC_NAME and Options.MUSIC_NAME.Value) or ""))
