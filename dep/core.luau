-- attach sessions: scoped handles that pin one instance, hand back every setting they borrowed, and release ownership when they end

local M = {}

function M.new(deps)
    local Controls = deps.Controls
    local Engine   = deps.Engine
    local signal   = deps.signal

    local owner, current = nil, nil

    -- advisory, not a lock: it stops two farms fighting over the engine, it does not shut the ui out
    local function claim(id)
        id = tostring(id or "anonymous")
        if owner ~= nil and owner ~= id then
            return nil, "already claimed by " .. owner
        end
        owner = id
        local released = false
        return function()
            if released then return end
            released = true
            if owner == id then owner = nil end
        end
    end

    local function open(instance, opts)
        if typeof(instance) ~= "Instance" or not instance.Parent then
            return nil, "instance invalid"
        end
        opts = (type(opts) == "table") and opts or {}

        if current then current:Detach("replaced") end

        local release = nil
        if opts.owner ~= nil then
            local fn, err = claim(opts.owner)
            if not fn then return nil, err end
            release = fn
        end

        -- only what the caller actually overrode is captured, so an untouched setting is never written back
        local restore = {}
        if type(opts.offset) == "table" then
            restore.offset = Controls.getOffset()
            Controls.setOffset(opts.offset)
        end
        if opts.retarget ~= nil then
            restore.retarget = Controls.getRetarget()
            Controls.setRetarget(opts.retarget)
        end
        if opts.mover ~= nil then
            restore.mover = Controls.getMover()
            Controls.setMover(opts.mover)
        end

        local ok, err = Controls.setExplicit(instance, { name = opts.name, group = opts.group })
        if not ok then
            if release then release() end
            return nil, err or "instance invalid"
        end

        local startedEngine = false
        if opts.autoStart ~= false and not Engine.IsRunning() then
