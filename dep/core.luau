    })

    local currentSpeedValue = Options.SpeedValue.Value

    local speedPropConn
    local speedCharConn
    local speedEnabled = false
    local speedOrigWalkSpeed
    local speedOrigHumanoid

    local function cacheSpeedBaseline(hum)
