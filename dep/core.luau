        })
        local scroll = New("ScrollingFrame", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
            ScrollBarThickness = 3, ScrollBarImageColor3 = palette.TextMuted,
            ScrollBarImageTransparency = 0.4, ScrollingDirection = Enum.ScrollingDirection.Y,
            CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ZIndex = 21, Parent = group,
        })
        local layout = New("UIListLayout", {
            FillDirection = Enum.FillDirection.Vertical, SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 10), Parent = scroll,
        })
        -- 2px each side keeps outlined children clear of the CanvasGroup edge, which clips their stroke
        New("UIPadding", {
            PaddingTop = UDim.new(0, PAD_TOP), PaddingBottom = UDim.new(0, PAD_BOTTOM),
            PaddingLeft = UDim.new(0, 2), PaddingRight = UDim.new(0, 8), Parent = scroll,
        })

        local order = 0
        local function nextOrder() order = order + 1; return order end

        New("TextLabel", {
            BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y, Font = Enum.Font.Gotham, TextSize = 13,
            TextColor3 = palette.Text, TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true, LineHeight = 1.3, Text = stepDef.body or "",
            LayoutOrder = nextOrder(), ZIndex = 21, Parent = scroll,
        })

        for _, line in ipairs(stepDef.bullets or {}) do
            local row = New("Frame", {
                Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1, LayoutOrder = nextOrder(), ZIndex = 21, Parent = scroll,
            })
            New("Frame", {
                Position = UDim2.fromOffset(2, 7), Size = UDim2.fromOffset(4, 4),
                BackgroundColor3 = palette.Accent, BorderSizePixel = 0, ZIndex = 22, Parent = row,
            })
            New("TextLabel", {
                BackgroundTransparency = 1, Position = UDim2.fromOffset(16, 0),
                Size = UDim2.new(1, -16, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = palette.TextMuted,
                TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, LineHeight = 1.25,
                Text = line, ZIndex = 21, Parent = row,
            })
        end

        -- a diagram only gets a slot when one actually exists, or the card reserves dead space
        local job
        if Illustrations.has(stepDef.illustration) then
            local slot = New("Frame", {
                Size = UDim2.new(1, -2, 0, Illustrations.height(stepDef.illustration)),
                BackgroundTransparency = 1, LayoutOrder = nextOrder(), ZIndex = 21, Parent = scroll,
            })
            job = Illustrations.render(stepDef.illustration, slot, palette, { gameName = gameName })
        end

        if stepDef.warning then
            local warn = New("Frame", {
                Size = UDim2.new(1, -2, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundColor3 = palette.Danger, BackgroundTransparency = 0.82,
                BorderSizePixel = 0, LayoutOrder = nextOrder(), ZIndex = 21, Parent = scroll,
            })
            Round(warn, 8, palette.Danger)
            New("UIPadding", {
                PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
                PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), Parent = warn,
            })
            New("TextLabel", {
                BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y, Font = Enum.Font.GothamSemibold,
                TextSize = 12, TextColor3 = palette.Danger,
                TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, LineHeight = 1.25,
                Text = stepDef.warning, ZIndex = 22, Parent = warn,
            })
        end

        return group, layout, job
    end

    local function showStep(target, direction)
        if busy or finished then return end
        busy = true
        index = target

        local stepDef = steps[index]
        local outgoing, outgoingJob = currentGroup, illusJob
        local group, layout, job = buildContent(stepDef)

        -- one frame for wrapped text to settle before AbsoluteContentSize is worth reading
        task.wait()
        if finished then busy = false; return end

        local vp = viewport()
        local natural = layout.AbsoluteContentSize.Y + PAD_TOP + PAD_BOTTOM
        local height = math.clamp(natural, 60, math.max(160, vp.Y * 0.58))
        TweenService:Create(viewportFrame, GROW, { Size = UDim2.new(1, 0, 0, height) }):Play()

        iconImage.Image = ""
        local okIcon, iconInfo = pcall(Library.GetCustomIcon, Library, stepDef.icon)
        if okIcon and type(iconInfo) == "table" and iconInfo.Url then
            iconImage.Image = iconInfo.Url
            iconImage.ImageRectOffset = iconInfo.ImageRectOffset or Vector2.zero
            iconImage.ImageRectSize   = iconInfo.ImageRectSize or Vector2.zero
        end
        kicker.Text     = stepDef.kicker or ""
        titleLabel.Text = stepDef.title or ""
        counter.Text    = ("%d / %d"):format(index, #steps)
        layoutPips(index, true)

        -- old body slides out the way the user is travelling, new one arrives behind it
        local dx = (direction == -1) and -34 or 34
        group.Position = UDim2.fromOffset(dx, 0)
        TweenService:Create(group, SLIDE, {
            Position = UDim2.fromOffset(0, 0), GroupTransparency = 0,
        }):Play()
        if outgoing then
            TweenService:Create(outgoing, SLIDE, {
                Position = UDim2.fromOffset(-dx, 0), GroupTransparency = 1,
            }):Play()
            Jobs.delay(0.36, function()
                if outgoingJob then outgoingJob:Cancel() end
                pcall(function() outgoing:Destroy() end)
            end, { name = "StartGuide.dropStep" })
        end
        currentGroup, illusJob = group, job

        backBtn.Visible = index > 1
        nextBtn.Text = (index >= #steps) and "Finish" or "Next"
        busy = false
    end

    local function advance(delta)
        if busy or finished or confirm then return end
        local target = index + delta
        if target > #steps then finish("completed"); return end
        if target < 1 then return end
        showStep(target, delta >= 0 and 1 or -1)
    end

    track(nextBtn.Activated:Connect(function() advance(1) end))
    track(backBtn.Activated:Connect(function() advance(-1) end))
    track(skipBtn.Activated:Connect(openConfirm))

    track(UserInputService.InputBegan:Connect(function(input, processed)
        if finished or processed then return end
        local key = input.KeyCode
        -- while the confirm is up it owns the keyboard, and escape backs out of it rather than the tour
        if confirm then
            if key == Enum.KeyCode.Escape then closeConfirm() end
            return
        end
        if key == Enum.KeyCode.Right or key == Enum.KeyCode.Return or key == Enum.KeyCode.Space then
            advance(1)
        elseif key == Enum.KeyCode.Left or key == Enum.KeyCode.Backspace then
            advance(-1)
        elseif key == Enum.KeyCode.Escape then
            openConfirm()
        end
    end))

    -- failsafe: something destroys our gui and the Wait below would block the caller forever
    track(screen.AncestryChanged:Connect(function()
        if not screen:IsDescendantOf(game) then finish("destroyed") end
    end))

    TweenService:Create(backdrop, TweenInfo.new(0.35), { BackgroundTransparency = DIM }):Play()
    TweenService:Create(cardScale,
        TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
    showStep(1, 1)

    local reason = done.Event:Wait()
    done:Destroy()
    if illusJob then illusJob:Cancel(); illusJob = nil end
    if confirmJob then confirmJob:Cancel(); confirmJob = nil end

    local outInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    TweenService:Create(cardScale, outInfo, { Scale = 0.92 }):Play()
    TweenService:Create(backdrop, outInfo, { BackgroundTransparency = 1 }):Play()
    if currentGroup then
        TweenService:Create(currentGroup, outInfo, { GroupTransparency = 1 }):Play()
    end
    task.wait(0.24)

    for i = #connections, 1, -1 do
        local c = connections[i]
        if c then pcall(c.Disconnect, c) end
        connections[i] = nil
    end
    pcall(function() screen:Destroy() end)

    Log.print(("[Cerberus/StartGuide] guide ended (%s) on step %d of %d")
        :format(tostring(reason), index, #steps))
    return reason == "completed"
end

return M

end)
__bundle_register("UI/StartGuide/Illustrations", function(require, _LOADED, __bundle_register, __bundle_modules)
-- startguide illustrations: the animated diagram on each card, built from plain frames so nothing is fetched

local Services = require("Services")
local Build    = require("UI/Build")
local Jobs     = require("Utility/Jobs")

local TweenService = Services.TweenService

local New   = Build.New
local Round = Build.Round

local M = {}

local RISE = TweenInfo.new(0.34, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local FADE = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- slot height each diagram needs; Panel reads this so the card reserves exactly the right space
local HEIGHTS = {
    welcome   = 124,
    around    = 134,
    menu      = 116,
    configs   = 122,
    community = 122,
    files      = 118,
    extras    = 70,
}

function M.height(name) return HEIGHTS[name] end
function M.has(name) return type(name) == "string" and type(rawget(M, name)) == "function" and HEIGHTS[name] ~= nil end

-- fades and lifts an element into its resting spot after `delay`
local function riseIn(inst, delay, restingPos, transparency)
    inst.Position = restingPos + UDim2.fromOffset(0, 10)
    inst.BackgroundTransparency = 1
    local texts = {}
    for _, desc in ipairs(inst:GetDescendants()) do
        if desc:IsA("TextLabel") then
            texts[#texts + 1] = desc
            desc.TextTransparency = 1
        end
    end
    if inst:IsA("TextLabel") then
        texts[#texts + 1] = inst
        inst.TextTransparency = 1
    end
    Jobs.delay(delay, function()
        TweenService:Create(inst, RISE, {
            Position = restingPos, BackgroundTransparency = transparency or 0,
        }):Play()
        for _, lbl in ipairs(texts) do
            TweenService:Create(lbl, RISE, { TextTransparency = 0 }):Play()
        end
    end, { name = "GuideRise" })
end

local function label(parent, text, size, pos, opts)
    opts = opts or {}
    return New("TextLabel", {
        BackgroundTransparency = 1, Size = size, Position = pos, Text = text,
        Font = opts.bold and Enum.Font.GothamBold or (opts.semi and Enum.Font.GothamSemibold or Enum.Font.Gotham),
        TextSize = opts.textSize or 11,
        TextColor3 = opts.color or Color3.fromRGB(200, 200, 210),
        TextXAlignment = opts.align or Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = opts.z or 22, Parent = parent,
    })
end

local function box(parent, size, pos, color, radius, stroke)
    local f = New("Frame", {
        Size = size, Position = pos, BackgroundColor3 = color,
        BorderSizePixel = 0, ZIndex = 21, Parent = parent,
    })
    Round(f, radius or 6, stroke)
    return f
end

-- fixed-width group centred in the slot, so diagrams can use absolute layout without guessing the card width
local function centred(parent, width, height)
    return New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0),
        Size = UDim2.fromOffset(width, height), BackgroundTransparency = 1,
        ZIndex = 21, Parent = parent,
    })
end

-- a miniature of the menu: tab rail down the side, groupboxes of toggles beside it
function M.welcome(parent, palette)
    local frame = box(parent, UDim2.fromScale(1, 1), UDim2.new(), palette.Background, 8, palette.Outline)

    local rail = box(frame, UDim2.new(0, 78, 1, -12), UDim2.fromOffset(6, 6), palette.Panel, 6)
    for i, name in ipairs({ "Home", "Main", "Player", "Combat" }) do
        local active = (i == 2)
        local pill = box(rail, UDim2.new(1, -12, 0, 20), UDim2.new(), active and palette.Accent or palette.Row, 5)
        label(pill, name, UDim2.fromScale(1, 1), UDim2.fromOffset(8, 0), {
            semi = true, textSize = 10,
            color = active and Color3.new(1, 1, 1) or palette.TextMuted,
        })
        riseIn(pill, 0.05 * i, UDim2.fromOffset(6, 8 + (i - 1) * 25))
    end

    for i = 1, 2 do
        local groupbox = box(frame, UDim2.new(1, -104, 0, 48), UDim2.new(), palette.Panel, 6, palette.Outline)
        box(groupbox, UDim2.fromOffset(52, 6), UDim2.fromOffset(9, 8), palette.Accent, 3)
        for row = 1, 2 do
            local y = 22 + (row - 1) * 13
            box(groupbox, UDim2.fromOffset(16, 8), UDim2.fromOffset(9, y), palette.Accent, 3)
            box(groupbox, UDim2.new(1, -40, 0, 6), UDim2.fromOffset(31, y + 1), palette.Row, 3)
        end
        riseIn(groupbox, 0.12 + 0.09 * i, UDim2.fromOffset(92, 6 + (i - 1) * 56))
    end
end

-- search filtering a feature list, typed out live so it reads as a demo rather than a picture
function M.around(parent, palette)
    local ROWS = {
        { name = "Aimbot",     hit = true },
        { name = "Aim Assist", hit = true },
        { name = "Silent Aim", hit = true },
        { name = "ESP Boxes",  hit = false },
        { name = "Infinite Jump", hit = false },
    }
    local QUERY = "aim"

    local field = box(parent, UDim2.new(1, 0, 0, 28), UDim2.new(), palette.Row, 7, palette.Outline)
    local magnifier = New("Frame", {
        Size = UDim2.fromOffset(10, 10), Position = UDim2.fromOffset(11, 9),
        BackgroundTransparency = 1, ZIndex = 22, Parent = field,
    })
    Round(magnifier, 5)
    New("UIStroke", { Color = palette.TextMuted, Thickness = 1.5, Parent = magnifier })
    box(field, UDim2.fromOffset(5, 1.5), UDim2.fromOffset(20, 18), palette.TextMuted, 1)

    local typed = label(field, "", UDim2.new(1, -60, 1, 0), UDim2.fromOffset(30, 0),
        { semi = true, textSize = 12, color = palette.Text })
    local caret = box(field, UDim2.fromOffset(1, 13), UDim2.fromOffset(30, 8), palette.Accent, 1)
    riseIn(field, 0.05, UDim2.new())

    local rows = {}
    for i, row in ipairs(ROWS) do
        local y = 36 + (i - 1) * 19
        local holder = New("Frame", {
            Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1, ZIndex = 21, Parent = parent,
        })
        local dot = box(holder, UDim2.fromOffset(14, 8), UDim2.fromOffset(4, 4), palette.Row, 3)
        local name = label(holder, row.name, UDim2.new(1, -28, 1, 0), UDim2.fromOffset(26, 0),
            { textSize = 11, color = palette.TextMuted })
        rows[i] = { holder = holder, dot = dot, name = name, hit = row.hit }
        riseIn(holder, 0.08 + 0.04 * i, UDim2.fromOffset(0, y), 1)
    end

    local function setFiltered(on)
        for _, r in ipairs(rows) do
            local dim = on and not r.hit
            TweenService:Create(r.name, FADE, {
                TextTransparency = dim and 0.8 or 0,
                TextColor3 = (on and r.hit) and palette.Text or palette.TextMuted,
            }):Play()
            TweenService:Create(r.dot, FADE, {
                BackgroundTransparency = dim and 0.75 or 0,
                BackgroundColor3 = (on and r.hit) and palette.Accent or palette.Row,
            }):Play()
        end
    end

    return Jobs.spawn(function(job)
        if not job:sleep(0.9) then return end
        while job.alive and parent.Parent do
            for i = 1, #QUERY do
                if not job:sleep(0.14) then return end
                typed.Text = QUERY:sub(1, i)
                caret.Position = UDim2.fromOffset(30 + typed.TextBounds.X + 2, 8)
            end
            setFiltered(true)
            if not job:sleep(1.9) then return end
            typed.Text = ""
            caret.Position = UDim2.fromOffset(30, 8)
            setFiltered(false)
            if not job:sleep(1.3) then return end
        end
    end, { name = "GuideIllus.around" })
end

-- a keycap tapping the window in and out of view, with the two neighbouring controls named
function M.menu(parent, palette)
    local group = centred(parent, 330, 116)

    local cap = box(group, UDim2.fromOffset(96, 40), UDim2.new(), palette.Row, 8, palette.Outline)
    label(cap, "Left Alt", UDim2.fromScale(1, 1), UDim2.new(),
        { semi = true, textSize = 13, color = palette.Text, align = Enum.TextXAlignment.Center })
    riseIn(cap, 0.05, UDim2.fromOffset(0, 14))

    local arrow = label(group, "→", UDim2.fromOffset(26, 20), UDim2.fromOffset(108, 24),
        { bold = true, textSize = 18, color = palette.TextMuted, align = Enum.TextXAlignment.Center })
    arrow.BackgroundTransparency = 1

    local window = box(group, UDim2.fromOffset(184, 68), UDim2.new(), palette.Background, 7, palette.Outline)
    box(window, UDim2.new(1, -12, 0, 12), UDim2.fromOffset(6, 6), palette.Panel, 3)
    box(window, UDim2.fromOffset(26, 6), UDim2.fromOffset(9, 9), palette.Accent, 3)
    for i = 1, 3 do
        box(window, UDim2.new(1, -22, 0, 7), UDim2.fromOffset(11, 26 + (i - 1) * 12), palette.Row, 3)
    end
    riseIn(window, 0.16, UDim2.fromOffset(146, 0))

    for i, name in ipairs({ "Auto Show UI", "Unload" }) do
        local chip = box(group, UDim2.fromOffset(150, 22), UDim2.new(), palette.Row, 5)
        label(chip, name, UDim2.fromScale(1, 1), UDim2.new(),
            { semi = true, textSize = 10, color = palette.TextMuted, align = Enum.TextXAlignment.Center })
        riseIn(chip, 0.24 + 0.05 * i, UDim2.fromOffset((i - 1) * 160, 88))
    end

    return Jobs.spawn(function(job)
        local hidden = false
        while job.alive and parent.Parent do
            if not job:sleep(1.7) then return end
            -- the cap dips as if pressed, and the window answers it
            TweenService:Create(cap, TweenInfo.new(0.08), { Position = UDim2.fromOffset(0, 17) }):Play()
            if not job:sleep(0.1) then return end
            TweenService:Create(cap, TweenInfo.new(0.12), { Position = UDim2.fromOffset(0, 14) }):Play()
            hidden = not hidden
            for _, inst in ipairs(window:GetDescendants()) do
                if inst:IsA("Frame") then
                    TweenService:Create(inst, FADE, { BackgroundTransparency = hidden and 1 or 0 }):Play()
                elseif inst:IsA("UIStroke") then
                    TweenService:Create(inst, FADE, { Transparency = hidden and 1 or 0 }):Play()
                end
            end
            TweenService:Create(window, FADE, { BackgroundTransparency = hidden and 1 or 0 }):Play()
        end
    end, { name = "GuideIllus.menu" })
end

