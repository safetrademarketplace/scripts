function M.getEntry(entries, name)
    for i, e in ipairs(entries) do
        if e.name == name then
            return e, i
        end
    end
end

function M.getEntryIndex(entries, name)
    for i, e in ipairs(entries) do
        if e.name == name then
            return i, e
        end
    end
end

function M.buildNames(entries)
    local t = {}
    for _, e in ipairs(entries) do
        t[#t + 1] = e.name
    end
    return t
end

function M.propsFromPreset(entry)
    if not entry then return nil end
    local p = entry.props or {}
    if entry.type == "crosshair" then
        return {
            type = "crosshair",
            color = M.hexToColor3(p.color or "#FFFFFF"),
            thickness = math.max(1, tonumber(p.thickness) or 2),
            length = math.max(2, tonumber(p.length) or 18),
            gap = math.max(0, tonumber(p.gap) or 8),
            lineCount = math.clamp(tonumber(p.lineCount) or 4, 2, 24),
            centerDot = p.centerDot == true,
            dotSize = math.max(1, tonumber(p.dotSize) or 2),
            outline = p.outline == true,
            outlineColor = M.hexToColor3(p.outlineColor or "#000000"),
            outlineThickness = math.max(0, tonumber(p.outlineThickness) or 0)
        }
    else
        return {
            type = "dot",
            color = M.hexToColor3(p.color or "#FFFFFF"),
            size = math.max(1, tonumber(p.size) or 10),
            outline = p.outline == true,
            outlineColor = M.hexToColor3(p.outlineColor or "#000000"),
            outlineThickness = math.max(0, tonumber(p.outlineThickness) or 0)
        }
    end
end

return M

end)
__bundle_register("Features/Fun/CustomCursor/Render", function(require, _LOADED, __bundle_register, __bundle_modules)
-- cursor renderer: ScreenGui + line/dot frames, ShowCustomCursor cooperation, and the per-frame position loop
local Scheduler = require("Utility/Scheduler")
local UiHost    = require("UI/UiHost")

return function(env)
    local Services   = env.Services
    local Library    = env.Library
    local References = env.References
    local track      = env.track

    -- capture pre-existing Library state for cleanup; explicit nil check so a valid false doesn't collapse via or-fallback
    local originalShowCustomCursor
    if Library then originalShowCustomCursor = Library.ShowCustomCursor end

    local destroyed = false

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name             = "_Cursor"
    screenGui.IgnoreGuiInset   = true
    screenGui.ZIndexBehavior   = Enum.ZIndexBehavior.Global
    screenGui.DisplayOrder     = 2147483647
    screenGui.ResetOnSpawn     = false
    screenGui.Parent           = UiHost.pick()

    local TOP_Z = 2147483647

    local function newLine()
        local f = Instance.new("Frame")
        f.BorderSizePixel       = 0
        f.AnchorPoint           = Vector2.new(0.5, 0.5)
        f.BackgroundColor3      = Color3.new(1, 1, 1)
        f.BackgroundTransparency = 0
        f.ZIndex                = TOP_Z
        f.Parent                = screenGui
        local s = Instance.new("UIStroke")
        s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        s.Parent          = f
        return f, s
    end

    local function newDot()
        local f = Instance.new("Frame")
        f.BorderSizePixel  = 0
        f.AnchorPoint      = Vector2.new(0.5, 0.5)
        f.BackgroundColor3 = Color3.new(1, 1, 1)
        f.ZIndex           = TOP_Z
        local corner = Instance.new("UICorner", f)
        corner.CornerRadius = UDim.new(1, 0)
        f.Parent = screenGui
        local s = Instance.new("UIStroke")
        s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        s.Parent          = f
        return f, s
    end

    local LINES = {}
    local DOT     = { newDot() }
    local DOTONLY = { newDot() }

    local function ensureLineCount(n)
        n = math.clamp(n, 2, 24)
        for i = #LINES + 1, n do
            LINES[i] = { newLine() }
        end
        for i = #LINES, n + 1, -1 do
            LINES[i][1]:Destroy()
            LINES[i] = nil
        end
    end

    -- zero out obsidian's own ShowCustomCursor crosshair frame once so it can't visually double our cursor
    local obsidianCursorNeutered = false
    local function neutralizeObsidianCursor()
        if obsidianCursorNeutered then return end
        if not (Library and Library.ScreenGui) then return end
        for _, d in ipairs(Library.ScreenGui:GetDescendants()) do
            if d:IsA("Frame") and d.ZIndex == 999 and d.Size == UDim2.fromOffset(9, 1) then
                pcall(function()
                    d.Size = UDim2.fromOffset(0, 0)
                    d.BackgroundTransparency = 1
                    for _, c in ipairs(d:GetDescendants()) do
                        if c:IsA("Frame") then c.BackgroundTransparency = 1 end
                    end
                end)
                obsidianCursorNeutered = true
                break
            end
        end
    end

    -- 4 Hz one-shot poller (5 s cap): the GetDescendants scan halved frame rate when it rode RenderStepped, so it lives off the hot loop
    local cursorPollerStarted = false
    local function ensureObsidianPoller()
        if cursorPollerStarted or obsidianCursorNeutered then return end
        cursorPollerStarted = true
        local deadline = os.clock() + 5
        track(Jobs.interval(0.25, function(job)
            if destroyed or obsidianCursorNeutered or os.clock() >= deadline then
                job:Cancel()
                return
            end
            neutralizeObsidianCursor()
        end, { name = "CursorNeuterPoll", immediate = true }))
    end

    -- ShowCustomCursor=true has obsidian write MouseIconEnabled=false each frame; we also write it directly since the Library's render step isn't bound while closed
    local lastHidden = nil
    local function applyCursorVisibility(hide)
        if destroyed then return end
        if hide then
            neutralizeObsidianCursor()
            -- if the first scan missed, the async poller retries off RenderStepped
            ensureObsidianPoller()
            if lastHidden ~= true then
                lastHidden = true
                pcall(function()
                    if Library and Library.ShowCustomCursor ~= nil then
                        Library.ShowCustomCursor = true
                    end
                end)
                pcall(function() Services.UserInputService.MouseIconEnabled = false end)
                pcall(function()
                    local m = References.player:GetMouse()
                    if m then m.Icon = "" end
                end)
            end
        else
            if lastHidden ~= false then
                lastHidden = false
                pcall(function()
                    if Library and Library.ShowCustomCursor ~= nil then
                        Library.ShowCustomCursor = originalShowCustomCursor == true
                    end
                end)
                pcall(function() Services.UserInputService.MouseIconEnabled = true end)
            end
        end
    end

    local function apply(P, enabled)
        if destroyed then return end
        applyCursorVisibility(enabled)
        if not P then return end

        if P.type == "crosshair" then
            ensureLineCount(math.clamp(P.lineCount or 4, 2, 24))
            for i = 1, #LINES do
                local f, s = LINES[i][1], LINES[i][2]
                f.BackgroundColor3 = P.color
                f.Size             = UDim2.fromOffset(math.max(1, P.thickness or 2), math.max(2, P.length or 18))
                s.Thickness        = (P.outline and math.max(0, P.outlineThickness or 0)) or 0
                s.Color            = P.outlineColor or Color3.new(0, 0, 0)
                f.Visible          = enabled
            end
            DOT[1].BackgroundColor3 = P.color
            DOT[1].Size             = UDim2.fromOffset(math.max(1, P.dotSize or 2), math.max(1, P.dotSize or 2))
            DOT[2].Thickness        = (P.outline and math.max(0, P.outlineThickness or 0)) or 0
            DOT[2].Color            = P.outlineColor or Color3.new(0, 0, 0)
            DOT[1].Visible          = enabled and (P.centerDot == true)
            DOTONLY[1].Visible      = false
        else
            DOTONLY[1].BackgroundColor3 = P.color
            DOTONLY[1].Size             = UDim2.fromOffset(math.max(1, P.size or 10), math.max(1, P.size or 10))
            DOTONLY[2].Thickness        = (P.outline and math.max(0, P.outlineThickness or 0)) or 0
            DOTONLY[2].Color            = P.outlineColor or Color3.new(0, 0, 0)
            DOTONLY[1].Visible          = enabled
            for _, pair in ipairs(LINES) do
                pair[1].Visible = false
            end
            DOT[1].Visible = false
        end
    end

    -- per-frame position update; state = { getProps, isEnabled, getNudge } callbacks
    local function bindLoop(state)
        track(Scheduler.render(function()
            if destroyed or not state.isEnabled() then return end

            -- re-assert cursor-hidden every frame: at boot there's a window before Library:Toggle binds where the game can re-enable MouseIconEnabled (the "double cursor" bug); both checks are cheap reads
            if Services.UserInputService.MouseIconEnabled then
                Services.UserInputService.MouseIconEnabled = false
            end
            if Library and Library.ShowCustomCursor == false then
                Library.ShowCustomCursor = true
            end

            local P = state.getProps()
            if not P then return end
            local nx, ny = state.getNudge()
            local ml = Services.UserInputService:GetMouseLocation()
            local mx, my = ml.X + (nx or 0), ml.Y + (ny or 0)
            if P.type == "crosshair" then
                local thick = math.max(1, P.thickness or 2)
                local len   = math.max(2, P.length or 18)
                local gap   = math.max(0, P.gap or 8)
                local lines = math.clamp(P.lineCount or 4, 2, 24)
                local offset = gap + (len / 2)
                local step   = 360 / lines
                for i = 1, lines do
                    local f = LINES[i][1]
                    local angle = (i - 1) * step
                    local rad   = math.rad(angle)
                    f.Position = UDim2.fromOffset(mx + math.cos(rad) * offset, my + math.sin(rad) * offset)
                    f.Size     = UDim2.fromOffset(thick, len)
                    f.Rotation = angle
                end
                DOT[1].Position = UDim2.fromOffset(mx, my)
            else
                DOTONLY[1].Position = UDim2.fromOffset(mx, my)
            end
        end, { name = "CustomCursor", priority = 200 }))
    end

    local function destroy()
        if destroyed then return end
        destroyed = true
        if screenGui then
            pcall(function() screenGui:Destroy() end)
            screenGui = nil
        end
        LINES, DOT, DOTONLY = {}, {}, {}
        pcall(function()
            if Library and originalShowCustomCursor ~= nil then
                Library.ShowCustomCursor = originalShowCustomCursor
            end
        end)
        pcall(function()
            local m = References.player:GetMouse()
            if m then m.Icon = "" end
        end)
        -- obsidian's self-unbinding render step restores MouseIconEnabled to a stale false; re-restore on defer + short delay so the OS cursor returns regardless of teardown order
        local function restoreMouseIcon()
            pcall(function() Services.UserInputService.MouseIconEnabled = true end)
        end
        restoreMouseIcon()
        task.defer(restoreMouseIcon)
        -- leak:allow — completes a teardown; cancelling it at unload would leave the cursor hidden
        task.delay(0.2, restoreMouseIcon)
    end

    return {
        apply        = apply,
        bindLoop     = bindLoop,
        destroy      = destroy,
        isDestroyed  = function() return destroyed end,
        resetHidden  = function() lastHidden = nil end,
    }
end

end)
__bundle_register("Utility/Scheduler", function(require, _LOADED, __bundle_register, __bundle_modules)
-- shared frame scheduler: one runservice connection per lane dispatching a priority-sorted task list under an optional frame budget, so features never hold their own per-frame connections

local Services = require("Services")
local Log      = require("Utility/Log")

local RunService = Services.RunService

local DEFAULT_PRIORITY = 100
local COST_SMOOTHING   = 0.1 -- ema weight for the per-task cost estimate the budget spends against
local MAX_STRIKES      = 3   -- consecutive errors before a task is dropped instead of left to spam
local MAX_STARVES      = 2   -- a deferrable task runs regardless after this many budget skips
local PHASE_SLOTS      = 8   -- start offsets equal-interval tasks are spread across

local M = {}

local budget    = nil -- seconds of dispatch time per frame; nil = unlimited
local paused    = false
local profiling = false
local nextSeq   = 0
local lanes     = {}

-- compaction and sorting happen here, never in the dispatch loop, so the hot path only ever walks a stable array
local function compact(lane)
    local tasks = lane.tasks
    local n = 0
    for i = 1, #tasks do
        local t = tasks[i]
        if t.alive then
            n = n + 1
            tasks[n] = t
        end
    end
    for i = #tasks, n + 1, -1 do
        tasks[i] = nil
    end
    -- seq tiebreak keeps equal priorities in registration order, which table.sort alone does not guarantee
    table.sort(tasks, function(a, b)
        if a.priority ~= b.priority then return a.priority < b.priority end
        return a.seq < b.seq
    end)
    lane.dirty = false
end

local function detach(lane)
    if lane.conn then
        lane.conn:Disconnect()
        lane.conn = nil
    end
end

local function unbind(lane, t)
    if not t.alive then return end
    t.alive = false
    lane.live = lane.live - 1
    lane.dirty = true
    if lane.live > 0 then return end
    detach(lane)
    -- an idle lane would otherwise hold every dead task's closure until something rebinds it
    if not lane.running then compact(lane) end
end

local function makeDispatch(lane)
    return function(a, b)
        if paused then return end
        if lane.dirty then compact(lane) end

        local tasks   = lane.tasks
        local dt      = lane.dtSecond and b or a
        local cap     = budget
        local measure = cap ~= nil or profiling
        local now     = os.clock()
        local spent   = 0

        lane.running = true
        -- `t` may be nil: a task that triggers the unloader clears this array mid-iteration, after the numeric for fixed its bound
        for i = 1, #tasks do
            local t = tasks[i]
            if t and t.alive and now >= t.nextRun then
                if cap and t.deferrable and t.starved < MAX_STARVES and spent + t.cost > cap then
                    t.starved = t.starved + 1
                else
                    t.starved = 0
                    local started = measure and os.clock() or 0
                    local ok, err = pcall(t.fn, dt)
                    if measure then
                        local elapsed = os.clock() - started
                        t.cost = t.cost + (elapsed - t.cost) * COST_SMOOTHING
                        spent = spent + elapsed
                    end
                    -- scheduled off the frame stamp, not the post-run clock, so a slow task can't drift its own cadence
                    t.nextRun = (t.interval > 0) and (now + t.interval) or 0
                    if ok then
                        t.strikes = 0
                    else
                        t.strikes = t.strikes + 1
                        Log.devwarn("Scheduler", "%s/%s errored (%d/%d): %s",
                            lane.name, t.name, t.strikes, MAX_STRIKES, tostring(err))
                        if t.strikes >= MAX_STRIKES then
                            lane.dropped = lane.dropped + 1
                            unbind(lane, t)
                        end
                    end
                end
            end
        end
        lane.running = false

        lane.spent = spent
    end
end

local function newLane(name, signal, dtSecond)
    local lane = {
        name     = name,
        signal   = signal,
        dtSecond = dtSecond, -- Stepped passes (elapsed, delta); render and heartbeat pass delta first
        tasks    = {},
        live     = 0,
        phase    = 0,
        spent    = 0,
        dropped  = 0,
        dirty    = false,
        running  = false,
        conn     = nil,
    }
    lane.dispatch = makeDispatch(lane)
    return lane
end

lanes.render    = newLane("render", RunService.RenderStepped, false)
lanes.heartbeat = newLane("heartbeat", RunService.Heartbeat, false)
lanes.stepped   = newLane("stepped", RunService.Stepped, true)

local function attach(lane)
    if lane.conn then return end
    local ok, conn = pcall(lane.signal.Connect, lane.signal, lane.dispatch)
    if not ok or not conn then
        Log.devwarn("Scheduler", "%s lane failed to connect: %s", lane.name, tostring(conn))
        return
    end
    lane.conn = conn
end

-- Destroy mirrors Disconnect so one handle is equally valid for Mount's track() and Maid:GiveTask()
local function newHandle(lane, t)
    local handle = {}

    function handle:Disconnect()
        unbind(lane, t)
    end

    handle.Destroy = handle.Disconnect

    function handle:SetInterval(seconds)
        t.interval = math.max(0, tonumber(seconds) or 0)
        t.nextRun = 0
    end

    function handle:SetPriority(priority)
        t.priority = tonumber(priority) or DEFAULT_PRIORITY
        lane.dirty = true
    end

    -- read through to the task so Connected stays honest after a strike-out drop, not just after Disconnect
    return setmetatable(handle, {
        __index = function(_, key)
            if key == "Connected" then return t.alive end
            return nil
        end,
    })
end

function M.bind(laneName, fn, opts)
    local lane = lanes[laneName]
    if not lane then
        Log.devwarn("Scheduler", "unknown lane %s", tostring(laneName))
        return nil
    end
    if type(fn) ~= "function" then
        Log.devwarn("Scheduler", "%s bind ignored: fn is %s", lane.name, type(fn))
        return nil
    end

    opts = opts or {}
    nextSeq = nextSeq + 1

    local interval = math.max(0, tonumber(opts.interval) or 0)
    local t = {
        fn         = fn,
        name       = tostring(opts.name or ("task#" .. nextSeq)),
        priority   = tonumber(opts.priority) or DEFAULT_PRIORITY,
        interval   = interval,
        deferrable = opts.deferrable == true,
        seq        = nextSeq,
        alive      = true,
        cost       = 0,
        strikes    = 0,
        starved    = 0,
        nextRun    = 0,
    }

    -- phase-offset equal-interval tasks so they land on different frames instead of stacking on one
    if interval > 0 then
        t.nextRun = os.clock() + (lane.phase / PHASE_SLOTS) * interval
        lane.phase = (lane.phase + 1) % PHASE_SLOTS
    end

    lane.tasks[#lane.tasks + 1] = t
    lane.live = lane.live + 1
    lane.dirty = true
    attach(lane)

    return newHandle(lane, t)
end

function M.render(fn, opts) return M.bind("render", fn, opts) end
function M.heartbeat(fn, opts) return M.bind("heartbeat", fn, opts) end
function M.stepped(fn, opts) return M.bind("stepped", fn, opts) end

-- milliseconds in, seconds internally: os.clock deals in seconds but a frame budget is only ever discussed in ms
function M.setBudget(ms)
    local value = tonumber(ms)
    budget = (value and value > 0) and (value / 1000) or nil
end

function M.getBudget()
    return budget and (budget * 1000) or nil
end

function M.setPaused(on)
    paused = on == true
end

function M.isPaused()
    return paused
end

-- cost sampling rides along for free while a budget is set; this turns it on for read-only consumers like the perf hud
function M.setProfiling(on)
    profiling = on == true
end

function M.stats()
    local out = { budgetMs = M.getBudget(), paused = paused, lanes = {} }
    for name, lane in pairs(lanes) do
        out.lanes[name] = {
            tasks     = lane.live,
            connected = lane.conn ~= nil,
            spentMs   = lane.spent * 1000,
            dropped   = lane.dropped,
        }
    end
    return out
end

function M.stop()
    for _, lane in pairs(lanes) do
        detach(lane)
        for i = 1, #lane.tasks do
            lane.tasks[i].alive = false
        end
        table.clear(lane.tasks)
        lane.live = 0
        lane.dirty = false
        lane.running = false
    end
end

return M

end)
