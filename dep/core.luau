        local function applyVote(voted, count)
            voteBtn.BackgroundColor3 = voted and theme.Accent
                or (canVote and theme.Background or theme.Row)
            countLabel.TextColor3 = voted and Color3.new(1, 1, 1)
                or (canVote and theme.Text or theme.TextMuted)
            -- flame stays white in both states for consistent emoji rendering
            flameLabel.TextColor3 = Color3.new(1, 1, 1)
            countLabel.Text = tostring(count)
        end

        voteBtn.Activated:Connect(function()
            if not canVote then
                if not Api.canWrite() then
                    Library:Notify(tr("Voting is disabled in this build"), 3)
                else
                    Library:Notify(tr("Link your Discord on the Luarmor dashboard to vote"), 4)
                end
                return
            end

            local prevVoted = item.has_voted == true
            local prevCount = tonumber(item.vote_count) or 0
            local nowVoted  = not prevVoted
            local newCount  = math.max(0, prevCount + (nowVoted and 1 or -1))

            item.has_voted  = nowVoted
            item.vote_count = newCount
            applyVote(nowVoted, newCount)

            task.spawn(function()
                local discordId = services.viewerDiscordId
                local data, err
                if nowVoted then
                    data, err = Api.vote(item.id, discordId)
                else
                    data, err = Api.unvote(item.id, discordId)
                end
                if not data then
                    item.has_voted  = prevVoted
                    item.vote_count = prevCount
                    applyVote(prevVoted, prevCount)
                    Library:Notify(string.format(tr("Vote failed: %s"), tostring(err)), 4)
                end
            end)
        end)

        local function refreshSaveManagerDropdown()
            local SaveManager = services.SaveManager
            if SaveManager and SaveManager.Library
                and SaveManager.Library.Options
                and SaveManager.Library.Options.SaveManager_ConfigList
            then
                pcall(function()
                    SaveManager.Library.Options.SaveManager_ConfigList:SetValues(
                        SaveManager:RefreshConfigList()
                    )
                end)
            end
        end

        dlBtn.Activated:Connect(function()
            -- exists() checked freshly each click so external file writes don't desync the row
            local hasLocal = Storage.exists(item.name)

            if hasLocal then
                dlBtn.Text = "..."
                local ok, delErr = Storage.deleteLocal(item.name)
                if not ok then
                    Library:Notify(string.format(tr("Delete failed: %s"), tostring(delErr)), 4)
                    applyActionVisual(true)
                    return
                end
                Library:Notify(string.format(tr("Deleted local %q — you can re-download now."), item.name), 4)
                refreshSaveManagerDropdown()
                applyActionVisual(false)
                return
            end

            dlBtn.AutoButtonColor = false
            dlBtn.Text = "..."
            task.spawn(function()
                local full, err = Api.get(item.id)
                if not full then
                    Library:Notify(string.format(tr("Download failed: %s"), tostring(err)), 4)
                    applyActionVisual(false)
                    return
                end
                -- defensive payload extraction: backends wrap responses or JSON-string the data field; log top-level keys if no shape matches
                local payload = full.data
                if payload == nil and type(full.config) == "table" then
                    payload = full.config.data
                end
                if payload == nil and type(full.payload) ~= "nil" then
                    payload = full.payload
                end
                if type(payload) == "string" then
                    local HttpService = Services.HttpService
                    local okDecode, decoded = pcall(HttpService.JSONDecode, HttpService, payload)
                    if okDecode then payload = decoded end
                end
                if payload == nil then
                    local keys = {}
                    for k in pairs(full) do keys[#keys + 1] = tostring(k) end
                    Log.warn("[Cerberus.Configs] /api/configs/" .. tostring(item.id)
                        .. " — no recognized data field. keys=[" .. table.concat(keys, ", ") .. "]")
                    Library:Notify(string.format(
                        tr("Download failed: server returned no data field (keys: %s)"),
                        table.concat(keys, ", ")), 8)
                    applyActionVisual(false)
                    return
                end
                -- race guard: bail if a same-named config appeared on disk mid-download
                if Storage.exists(item.name) then
                    Library:Notify(string.format(tr("You already have a config named %q — delete the local copy first."), item.name), 6)
                    applyActionVisual(true)
                    return
                end
                local ok, writeErr = Storage.write(item.name, payload)
                if not ok then
                    Library:Notify(string.format(tr("Save failed: %s"), tostring(writeErr)), 4)
                    applyActionVisual(false)
                    return
                end
                Library:Notify(string.format(tr("Saved %q — visible in Configurations"), item.name), 4)
                refreshSaveManagerDropdown()
                applyActionVisual(true)
            end)
        end)

        return row
    end

    function self:Refresh()
        if self.loading then return end
        self.loading = true
        clearRows()
        emptyLabel.Visible = false
        setStatus(tr("Loading…"), false)

        task.spawn(function()
            local data, err = Api.list({
                game              = Storage.gameName(),
                viewer_discord_id = services.viewerDiscordId,
                sort              = self.sort,
                limit             = 100,
            })
            self.loading = false
            if not data then
                setStatus(string.format(tr("Couldn't load: %s"), tostring(err)), true)
                return
            end
            -- accept { items = [...] } or a bare array, backend-dependent
            local items = data.items or data.configs or data
            if type(items) ~= "table" or #items == 0 then
                setStatus("", false)
                emptyLabel.Text = string.format(
                    tr("No configs uploaded for %s yet — be the first!"),
                    Storage.gameName())
                emptyLabel.Visible = true
                return
            end
            self.items = items
            for i, item in ipairs(items) do
                self.rows[item.id] = buildRow(item, i)
            end
            setStatus(string.format(tr("%d configs"), #items), false)
        end)
    end

    sortBtn.Activated:Connect(function()
        local idx = (self.sort == "popular") and 2 or 1
        self.sort = SORT_VALUES[idx]
        sortBtn.Text = tr("Sort: ") .. tr(SORT_LABELS[self.sort])
        self:Refresh()
    end)

    refreshBtn.Activated:Connect(function()
        self:Refresh()
    end)

    function self:OnShow()
        self:Refresh()
    end

    return self
end

end)
