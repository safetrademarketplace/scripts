__bundle_register("Utility/Debug", function(require, _LOADED, __bundle_register, __bundle_modules)
-- wires EventBuffer + LoadingScreen + CrashReport into the historical Debugger API so call sites stay unchanged
local EventBuffer   = require("Utility/EventBuffer")
local LoadingScreen = require("UI/LoadingScreen")
local CrashReport   = require("Utility/CrashReport")
local Log           = require("Utility/Log")

return function(ctx)
    local buffer  = EventBuffer.new(160)
    -- tier comes from pre-boot, so the loader is already dressed the first frame it draws
    local loading = LoadingScreen.new(ctx.Tier)
    local crash   = CrashReport.new({
        ScriptVersion = ctx.ScriptVersion or "unknown",
        Services      = ctx.Services,
        References    = ctx.References,
        StartTime     = tick(),
        buffer        = buffer,
    })

    local Debugger = {}

    function Debugger:Log(stage, message)
        local stageText = tostring(stage or "INFO")
        local rawMsg    = tostring(message or "")
        buffer:push(stageText, rawMsg)
        loading:notifyStep(stageText, rawMsg)
    end

    function Debugger:ShowLoading(_message)
        loading:show()
    end

    function Debugger:HideLoading(onComplete)
        loading:hide(onComplete)
    end

    function Debugger:FinalizeLoading(_message, onComplete)
        loading:finalize(onComplete)
    end

    -- translation-phase pass-throughs used by Cerberus.lua between mountAll and FinalizeLoading
    function Debugger:FreezeBootProgress() loading:freezeBootProgress() end
    function Debugger:SetLoadingStatus(text) loading:setStatus(text) end
    function Debugger:SetLoadingSubtitle(text) loading:setSubtitle(text) end
    function Debugger:SetLoadingProgress(ratio) loading:setProgress(ratio) end
    function Debugger:AddLoaderSkipButton(label, onClick)
        return loading:addSkipButton(label, onClick)
    end

    function Debugger:BuildCrashReport(label, err)
        return crash:build(label, err)
    end

    function Debugger:ShowCrashGui(reportText)
        crash:show(reportText)
    end

    function Debugger:HandleCrash(label, err)
        loading:hide()
        local report = crash:build(label, err)
        Log.warn("[Cerberus/Crash]\n" .. report)
        crash:show(report)
        return report
    end

    local function xpcallTraceback(e)
        return debug.traceback(tostring(e), 2)
    end

    function Debugger:Try(label, fn)
        self:Log("STEP", "Begin " .. tostring(label))
        local out = table.pack(xpcall(fn, xpcallTraceback))
        if out[1] == true then
            self:Log("STEP", "Completed " .. tostring(label))
            return true, table.unpack(out, 2, out.n)
        end
        self:Log("ERROR", tostring(label) .. " failed")
        self:HandleCrash(label, out[2])
        return false, out[2]
    end

    function Debugger:RunOrThrow(label, fn)
        self:Log("STEP", "Begin " .. tostring(label))
        local out = table.pack(xpcall(fn, xpcallTraceback))
        if out[1] == true then
            self:Log("STEP", "Completed " .. tostring(label))
            return table.unpack(out, 2, out.n)
        end
        error(string.format("[%s] %s", tostring(label), tostring(out[2])), 0)
    end

    function Debugger:LoadModule(moduleName, fn)
        local label = string.format("Module %s", tostring(moduleName))
        self:Log("STEP", "Begin " .. label)
        local out = table.pack(xpcall(fn, xpcallTraceback))
        if out[1] == true then
            self:Log("STEP", "Completed " .. label)
            return table.unpack(out, 2, out.n)
        end
        local errMsg = tostring(out[2])
        self:Log("WARN", label .. " failed to load (skipping): " .. errMsg)
        Log.warn(string.format("[Cerberus] %s failed to load — continuing without it: %s", label, errMsg))
        return nil
    end

    return Debugger
end

end)
