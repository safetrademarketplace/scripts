-- small string helpers: trim + brandless random hex names

local M = {}

function M.trim(s)
    if type(s) ~= "string" then return s end
    return (s:gsub("^%s+", ""):gsub("%s+$", ""))
end

-- cache the result at module-init: FindFirstChild by a cached name misses a fresh roll
function M.randomHex(len)
    len = len or 8
    local chars = "0123456789abcdef"
    local out = {}
    for i = 1, len do
        local j = math.random(1, #chars)
        out[i] = chars:sub(j, j)
    end
    return table.concat(out)
end

return M

