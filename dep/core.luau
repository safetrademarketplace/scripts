    MusicGroup:AddButton({
        Text = "Stop Music",
        Func = function()
            stopMusicHard()
            Library:Notify("⏹ Stopped.", 2)
        end
    })

    MusicGroup:AddDivider()

    MusicGroup:AddInput("MUSIC_URL", {
        Text = "Music URL",
        Placeholder = "https://... .mp3 / .ogg / .wav",
        ClearTextOnFocus = false,
        Finished = false
    })
    MusicGroup:AddInput("MUSIC_NAME", {
        Text = "Music Name",
        Placeholder = "Enter Name",
        ClearTextOnFocus = false,
        Finished = false
    })

    local removeDD

    local function refreshDropdowns(selectName)
