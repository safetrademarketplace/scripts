__bundle_register("Utility/BuildStamp", function(require, _LOADED, __bundle_register, __bundle_modules)
-- build age: turns Meta.builtAt (stamped by build.sh) into the phrase the boot notification reads, "last updated 3 hours ago"

local Meta = require("Meta")

local MINUTE = 60
local HOUR   = 60 * MINUTE
local DAY    = 24 * HOUR
local WEEK   = 7 * DAY

local M = {}

local function count(n, unit)
    n = math.floor(n)
    return ("%d %s%s"):format(n, unit, n == 1 and "" or "s")
end

-- builtAt is unix seconds and the real answer; the date-only `updated` is the fallback for a
-- bundle built before the stamp existed, and noon keeps that guess inside a day of the truth
local function stampedAt()
    local epoch = tonumber(Meta.builtAt)
    if epoch and epoch > 0 then return epoch end

    local y, m, d = tostring(Meta.updated or ""):match("^(%d%d%d%d)%-(%d%d)%-(%d%d)$")
    if not y then return nil end
    local ok, guess = pcall(os.time, { year = tonumber(y), month = tonumber(m), day = tonumber(d), hour = 12 })
    return ok and guess or nil
end

-- how long ago this build was made, in plain english. weeks is the largest unit on purpose:
-- past that the number is the point, not the calendar. a clock skewed ahead reads as "just now"
function M.relative(now)
    local at = stampedAt()
    if not at then return nil end

    local delta = (now or os.time()) - at
    if delta < 0      then delta = 0 end
    if delta < MINUTE then return "just now" end
    if delta < HOUR   then return count(delta / MINUTE, "minute") .. " ago" end
    if delta < DAY    then return count(delta / HOUR,   "hour")   .. " ago" end
    if delta < WEEK   then return count(delta / DAY,    "day")    .. " ago" end
    return count(delta / WEEK, "week") .. " ago"
end

-- the boot line itself; with no stamp to work from it degrades to whatever date Meta carries
function M.describe()
    local rel = M.relative()
    if rel then return "Last updated " .. rel end
    return "Last updated " .. tostring(Meta.updated or "unknown")
end

return M

end)
__bundle_register("Utility/Maid", function(require, _LOADED, __bundle_register, __bundle_modules)
-- quenty nevermore Maid, forked: luau types stripped for luabundler and every task dispatched under pcall, because upstream lets one throwing task abort the rest of DoCleaning
local Log = require("Utility/Log")

local Maid = {}
Maid.ClassName = "Maid"

-- one task's failure is logged and skipped, never allowed to abort the sweep
local function runTask(job)
	local ok, err = pcall(function()
		if typeof(job) == "function" then
			job()
		elseif typeof(job) == "table" then
			if type(job.Destroy) == "function" then
				job:Destroy()
			end
		elseif typeof(job) == "Instance" then
			job:Destroy()
		elseif typeof(job) == "thread" then
			local cancelled
			if coroutine.running() ~= job then
				cancelled = pcall(function()
					task.cancel(job)
				end)
			end

			if not cancelled then
				task.defer(function()
					task.cancel(job)
				end)
			end
		elseif typeof(job) == "RBXScriptConnection" then
			job:Disconnect()
		end
	end)
	if not ok then
		Log.devwarn("Maid", "task failed during cleanup: %s", tostring(err))
	end
end

function Maid.new()
	return setmetatable({ _tasks = {} }, Maid)
end

function Maid.isMaid(value)
	return type(value) == "table" and value.ClassName == "Maid"
end

function Maid.__index(self, index)
	if Maid[index] then
		return Maid[index]
	else
		return self._tasks[index]
	end
end

function Maid.__newindex(self, index, newTask)
	if Maid[index] ~= nil then
		error(string.format("Cannot use '%s' as a Maid key", tostring(index)), 2)
	end

	local tasks = self._tasks
	local job = tasks[index]

	if job == newTask then
		return
	end

	tasks[index] = newTask

	if job then
		runTask(job)
	end
end

function Maid:Add(taskItem)
	if not taskItem then
		error("Task cannot be false or nil", 2)
	end

	self[#self._tasks + 1] = taskItem

	if type(taskItem) == "table" and not taskItem.Destroy then
		Log.warn("[Maid.Add] - Gave table task without .Destroy\n\n" .. debug.traceback())
	end

	return taskItem
end

function Maid:GiveTask(taskItem)
	if not taskItem then
		error("Task cannot be false or nil", 2)
	end

	local taskId = #self._tasks + 1
	self[taskId] = taskItem

	if type(taskItem) == "table" and not taskItem.Destroy then
		Log.warn("[Maid.GiveTask] - Gave table task without .Destroy\n\n" .. debug.traceback())
	end

	return taskId
end

function Maid:GivePromise(promise)
	if not promise:IsPending() then
		return promise
	end

	local newPromise = promise.resolved(promise)
	local id = self:GiveTask(newPromise)

	newPromise:Finally(function()
