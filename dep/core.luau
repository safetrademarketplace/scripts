__bundle_register("Tabs/Player", function(require, _LOADED, __bundle_register, __bundle_modules)
-- player tab: mounts Movement/PlayerUtils/Visuals; returns the Movement module so Cerberus.lua can re-arm it on respawn
local Movement    = require("Features/Player/Movement")
local PlayerUtils = require("Features/Player/Utils")
local Visuals     = require("Features/Visuals/Visuals")

local function buildBase(ctx)
    return {
        Api         = ctx.Api,
        Services    = ctx.Services,
        Tabs        = ctx.Tabs,
        References  = ctx.References,
        Library     = ctx.Library,
        Options     = ctx.Library.Options,
        Toggles     = ctx.Library.Toggles,
        Helpers     = ctx.Helpers,
        Unloader    = ctx.Unloader,
        Maid        = ctx.Maid,
        NewMaid     = ctx.NewMaid,
    }
end

return function(ctx)
    local Config = ctx.Config
    local movementInst

    if Config.Movement then
        movementInst = Movement(buildBase(ctx))
    end
    if Config.PlayerUtils then
        local sub = buildBase(ctx)
        sub.quickReset  = ctx.Helpers.quickReset
        sub.startNoclip = ctx.Helpers.startNoclip
        sub.stopNoclip  = ctx.Helpers.stopNoclip
        PlayerUtils(sub)
    end
    if Config.Visuals and ctx.Tabs.ESP then
        Visuals(buildBase(ctx))
    end

    return movementInst
end

end)
__bundle_register("Features/Visuals/Visuals", function(require, _LOADED, __bundle_register, __bundle_modules)
-- visuals orchestrator: wires Radar (esp tab) + InfiniteCamera, NoFog, XRay, Fullbright, FOV, Freecam (shared groupbox on player tab)
local Mount          = require("Utility/Mount")
local Radar          = require("Features/Visuals/Visuals/Radar")
local InfiniteCamera = require("Features/Visuals/Visuals/InfiniteCamera")
local NoFog          = require("Features/Visuals/Visuals/NoFog")
local XRay           = require("Features/Visuals/Visuals/XRay")
local Fullbright     = require("Features/Visuals/Visuals/Fullbright")
