-- teleports ui: Teleports/Waypoints groupboxes wired against the Engine + Waypoints store

local Str = require("Utility/Helpers/Str")

local function normalizeBindKey(bindValue)
    if typeof(bindValue) == "EnumItem" then return bindValue.Name end
    if bindValue == nil then return nil end
    return tostring(bindValue)
end

local function uniq(used, base)
    local k, n = base, 1
    while used[k] do
        n = n + 1
        k = ("%s (%d)"):format(base, n)
    end
    used[k] = true
    return k
end

return function(deps)
    local Tabs       = deps.Tabs
    local Library    = deps.Library
    local Options    = deps.Options
    local Toggles    = deps.Toggles
    local References = deps.References
