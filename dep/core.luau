__bundle_register("Utility/Store", function(require, _LOADED, __bundle_register, __bundle_modules)
-- namespaced json persistence: one path builder, one folder-ensure, one encode/decode, so a feature never hand-rolls the readfile/writefile/pcall dance again

local Services   = require("Services")
local References = require("References")
local Fs         = require("Utility/Helpers/Fs")
local Log        = require("Utility/Log")

local HttpService = Services.HttpService

local ROOT = "Cerberus"

local M = {}

-- a fork's Meta game name is arbitrary ("Bleach: VV"), and executors reject makefolder/writefile on reserved punctuation, so anything outside this set becomes "_"
local function sanitize(segment)
    segment = tostring(segment or "")
    segment = segment:gsub("[^%w%-_ %.]", "_")
    segment = segment:gsub("^%s+", ""):gsub("%s+$", "")
    return segment
end

M.GLOBAL = ""
M.GAME   = sanitize(References.gameName)

-- creates each segment in turn: makefolder fails on a nested path whose parent doesn't exist yet
local function ensureFolder(dir)
    if not (isfolder and makefolder) then return false end
    if isfolder(dir) then return true end
    local accum = nil
    for segment in dir:gmatch("[^/]+") do
        accum = accum and (accum .. "/" .. segment) or segment
        if not isfolder(accum) then
            local ok = pcall(makefolder, accum)
            if not ok then
                Log.devwarn("Store", "makefolder failed for %s", accum)
                return false
            end
        end
    end
    return true
end

-- a namespace may nest ("Universal/settings"); each segment is sanitized, the separators survive
local function folderOf(namespace)
    local dir = ROOT
    for segment in tostring(namespace or ""):gmatch("[^/]+") do
        local clean = sanitize(segment)
        if clean ~= "" then dir = dir .. "/" .. clean end
    end
    return dir
end

function M.path(namespace, key)
    return folderOf(namespace) .. "/" .. sanitize(key) .. ".json"
end

function M.exists(namespace, key)
    return type(isfile) == "function" and isfile(M.path(namespace, key)) == true
end

-- reads the raw file body; nil when absent or unreadable, so a caller can tell empty from missing
function M.readRaw(namespace, key)
    local file = M.path(namespace, key)
    if type(isfile) ~= "function" or type(readfile) ~= "function" then return nil end
    if not isfile(file) then return nil end
    local ok, body = pcall(readfile, file)
    if not ok or type(body) ~= "string" then
        Log.devwarn("Store", "readfile failed for %s", file)
        return nil
    end
    return body
end

function M.writeRaw(namespace, key, body)
    if not ensureFolder(folderOf(namespace)) then return false, "no folder" end
    return Fs.safeWrite(M.path(namespace, key), body, "Store")
end

-- `default` covers missing and corrupt alike: a half-written json file should degrade to first-run rather than throw
function M.read(namespace, key, default)
    local body = M.readRaw(namespace, key)
    if not body or body == "" then return default end
    local ok, value = pcall(HttpService.JSONDecode, HttpService, body)
    if not ok then
        Log.devwarn("Store", "corrupt json at %s, using default", M.path(namespace, key))
        return default
    end
    return value
end

function M.write(namespace, key, value)
    local ok, body = pcall(HttpService.JSONEncode, HttpService, value)
    if not ok or type(body) ~= "string" then
        Log.devwarn("Store", "encode failed for %s", M.path(namespace, key))
        return false, "encode failed"
    end
    return M.writeRaw(namespace, key, body)
end

function M.delete(namespace, key)
    local file = M.path(namespace, key)
    if type(isfile) ~= "function" or not isfile(file) then return true end
    if type(delfile) ~= "function" then return false end
    return (pcall(delfile, file))
end

-- key names (no directory, no .json) of every entry in the namespace
function M.list(namespace)
    local out = {}
    local dir = folderOf(namespace)
    if not (type(listfiles) == "function" and type(isfolder) == "function") then return out end
    if not isfolder(dir) then return out end
    local ok, entries = pcall(listfiles, dir)
    if not ok or type(entries) ~= "table" then return out end
    for _, full in ipairs(entries) do
        local name = tostring(full):match("([^/\\]+)%.json$")
        if name then out[#out + 1] = name end
    end
    table.sort(out)
    return out
end

return M

end)
