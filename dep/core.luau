        end)
        reportBtn.MouseLeave:Connect(function()
            reportBtn.TextColor3 = theme.TextMuted
        end)
        reportBtn.Activated:Connect(function()
            local opener = services.openReportModal
            if type(opener) == "function" then
                opener(item)
            end
        end)

        local function applyActionVisual(hasLocal)
            if hasLocal then
                dlBtn.Text = tr("Delete Local")
                dlBtn.BackgroundColor3 = theme.Danger
                dlBtn.TextColor3 = Color3.new(1, 1, 1)
            else
                dlBtn.Text = tr("Download")
                dlBtn.BackgroundColor3 = theme.Accent
                dlBtn.TextColor3 = Color3.new(1, 1, 1)
