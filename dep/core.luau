            ddMusic:SetValues(names)
            local want = selectName
            if not want and ddMusic.Value and table.find(names, ddMusic.Value) then
                want = ddMusic.Value
            end
            ddMusic:SetValue(want or names[1])
        end
        if removeDD and removeDD.SetValues then
            removeDD:SetValues(names)
