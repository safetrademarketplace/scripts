        MAIN.TimePosition = 0

        local ok, mappedOrErr = ensure_local_asset(song.url)
        if not ok then
            Library:Notify("⚠️ " .. (song.name or ("Track " .. index)) .. ": " .. tostring(mappedOrErr), 5)
