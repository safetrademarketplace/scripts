-- pure player/character lookups — no ctx, no state

local Services = require("Services")
local Players  = Services.Players

local M = {}

-- display name match wins over username
function M.findByName(name)
    if type(name) ~= "string" or name == "" then return nil end
    local lower = name:lower()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.DisplayName:lower() == lower then return plr end
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name:lower() == lower then return plr end
    end
    return nil
end

-- HumanoidRootPart preferred, then PrimaryPart, then any BasePart descendant
function M.getRootPart(model)
    if not (model and model.Parent) then return nil end
    return model:FindFirstChild("HumanoidRootPart")
        or model.PrimaryPart
        or model:FindFirstChildWhichIsA("BasePart")
end

function M.getHumanoid(model)
    if not (model and model.Parent) then return nil end
    return model:FindFirstChildOfClass("Humanoid")
end

return M

end)
