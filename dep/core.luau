__bundle_register("Features/Player/Utils/ReplicationLag", function(require, _LOADED, __bundle_register, __bundle_modules)
-- replication-lag sub-module of utils: writes NetworkSettings.IncomingReplicationLag to fake a backtrack window for client-authoritative bursts
return function(ctx)
    local Library    = ctx.Library
    local Toggles    = ctx.Toggles
    local UtilsGroup = ctx.UtilsGroup

    local DEFAULT_LAG = 0.2
    local lagAmount = DEFAULT_LAG
    local applied = false

    local function netSettings()
        local ok, ns = pcall(function() return settings():GetService("NetworkSettings") end)
        if ok and ns then return ns end
        return nil
    end

    local function writeLag(seconds)
        local ns = netSettings()
        if not ns then return false end
        local ok = pcall(function() ns.IncomingReplicationLag = seconds end)
        return ok
    end

    local function apply()
        if writeLag(lagAmount) then
            applied = true
            return true
        end
        return false
    end

    local function clear()
        if not applied then return end
        writeLag(0)
        applied = false
    end

    UtilsGroup:AddToggle("ReplicationLagEnabled", {
        Text = "Replication Lag",
        Default = false,
        Tooltip = "Adds artificial incoming replication lag (backtrack). Server sees your inputs delayed by the chosen amount.",
    })

    local ReplicationLagBox = UtilsGroup:AddDependencyBox()

    ReplicationLagBox:AddSlider("ReplicationLagAmount", {
        Text = "Lag",
        Default = DEFAULT_LAG,
        Min = 0,
        Max = 1,
        Rounding = 2,
        Suffix = "s",
        Tooltip = "Incoming replication delay applied while Replication Lag is enabled.",
        Callback = function(v)
            lagAmount = v
            if Toggles.ReplicationLagEnabled and Toggles.ReplicationLagEnabled.Value then
                writeLag(v)
            end
        end
    })

    ReplicationLagBox:SetupDependencies({
        { Toggles.ReplicationLagEnabled, true },
    })

    Toggles.ReplicationLagEnabled:OnChanged(function()
        if Toggles.ReplicationLagEnabled.Value then
            if not apply() then
                Library:Notify("Replication Lag: NetworkSettings unavailable in this executor.", 3)
                Toggles.ReplicationLagEnabled:SetValue(false)
            end
        else
            clear()
        end
    end)

    return { cleanup = clear }
end

end)
__bundle_register("Features/Player/Utils/Desync", function(require, _LOADED, __bundle_register, __bundle_modules)
-- desync sub-module of utils (server_desync preferred, FFlag fallback)
return function(ctx)
    local Library    = ctx.Library
    local Toggles    = ctx.Toggles
    local UtilsGroup = ctx.UtilsGroup

    UtilsGroup:AddToggle("DesyncEnabled", {
        Text = "Desync",
        Default = false,
        Tooltip = "Perform movements and actions client-side without server recognition until re-synced",
    }):AddKeyPicker("DesyncKey", {
        Default = nil,
        SyncToggleState = true,
        Mode = "Toggle",
    })

    local hasServerDesync      = (type(server_desync) == "function")
    local hasSetFflag          = (type(setfflag) == "function")
    local fflagDesyncConfirmed = false
    local internalChange       = false

    Toggles.DesyncEnabled:OnChanged(function()
        if internalChange then return end

        local desired = Toggles.DesyncEnabled.Value

        if hasServerDesync then
            server_desync(desired)
            Library:Notify("Server Desync " .. (desired and "enabled." or "disabled."), 2)
            return
        end

        if not hasSetFflag then
            Library:Notify("Desync not available (no server_desync / setfflag in this executor).", 3)
            if desired then
                internalChange = true
                Toggles.DesyncEnabled:SetValue(false)
                internalChange = false
            end
            return
        end

        if desired and not fflagDesyncConfirmed then
            fflagDesyncConfirmed = true

            internalChange = true
            Toggles.DesyncEnabled:SetValue(false)
            internalChange = false

            Library:Notify(
                "FFlag desync uses NextGenReplicatorEnabledWrite4.\n" ..
                "It is unstable and potentially detectable.\n\n" ..
                "Click the toggle again if you still want to enable it.",
                6
            )
            return
        end

        local value = desired and "true" or "false"
        local ok, err = pcall(function()
            setfflag("NextGenReplicatorEnabledWrite4", value)
        end)

        if not ok then
            Library:Notify("Failed to apply FFlag desync: " .. tostring(err), 3)
            internalChange = true
            Toggles.DesyncEnabled:SetValue(false)
            internalChange = false
            return
        end

        if desired then
            Library:Notify("FFlag Desync enabled (use with caution).", 4)
        else
            Library:Notify("FFlag Desync disabled.", 2)
        end
    end)

    local function cleanup()
        if not Toggles.DesyncEnabled or Toggles.DesyncEnabled.Value ~= true then return end
        if hasServerDesync then
            pcall(server_desync, false)
        elseif hasSetFflag then
            pcall(setfflag, "NextGenReplicatorEnabledWrite4", "false")
        end
    end

    return { cleanup = cleanup }
end

end)
