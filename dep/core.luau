__bundle_register("Features/Player/Movement/Jump", function(require, _LOADED, __bundle_register, __bundle_modules)
-- jump sub-module of movement (jump power + infinite jump)
return function(ctx)
    local Services   = ctx.Services
    local Tabs       = ctx.Tabs
    local References = ctx.References
    local Options    = ctx.Options
    local Toggles    = ctx.Toggles
    local track      = ctx.track

    local JumpGroup = Tabs.Player:AddLeftGroupbox("Jump", "move-vertical")

    JumpGroup:AddToggle("JumpPower", {
        Text = "Jump Power",
        Default = false
    })

    local JumpPowerBox = JumpGroup:AddDependencyBox()

    JumpPowerBox:AddSlider("JumpHeight", {
        Text = "Jump Height",
        Default = 7.2,
        Min = 5,
        Max = 200,
        Rounding = 1
    })

    JumpPowerBox:SetupDependencies({
        { Toggles.JumpPower, true },
    })

    JumpGroup:AddToggle("InfiniteJump", {
        Text = "Infinite Jump",
        Default = false
    })

    local currentJumpHeight = Options.JumpHeight.Value
    local isInfiniteJumpEnabled = Toggles.InfiniteJump.Value

    local function applyJumpHeight()
        local hum = References.humanoid
        if not hum then return end

        -- use the native JumpHeight property instead of calculating JumpPower math
        if hum.UseJumpPower ~= nil then
            hum.UseJumpPower = false
        end
        if hum.JumpHeight ~= nil then
            if hum.JumpHeight ~= currentJumpHeight then
                hum.JumpHeight = currentJumpHeight
            end
        end
    end

    local _orig = nil
    local jumpConn               -- humanoid:GetPropertyChangedSignal("JumpHeight")
    local jumpCharConn           -- References.onCharacter unsubscribe
    local jumpModEnabled = false

    References.onCharacterRemoving(function() _orig = nil end)

    local function bindHumanoid()
        if jumpConn then jumpConn:Disconnect(); jumpConn = nil end
        local hum = References.humanoid
        if not hum then return end

        if not _orig then
            _orig = {
                UseJumpPower = hum.UseJumpPower,
                JumpPower = hum.JumpPower,
                JumpHeight = hum.JumpHeight
            }
        end

        applyJumpHeight()

        -- re-assert on external JumpHeight writes; applyJumpHeight checks ~= before assigning, so this can't infinite-loop
        jumpConn = hum:GetPropertyChangedSignal("JumpHeight"):Connect(function()
            if jumpModEnabled then applyJumpHeight() end
        end)
    end

    local function startJumpMod()
        if jumpModEnabled then return end
        jumpModEnabled = true
        bindHumanoid()
        -- re-bind on respawn so the new humanoid gets the override
        jumpCharConn = References.onCharacter(function() bindHumanoid() end)
    end

    local function stopJumpMod()
        jumpModEnabled = false
        if jumpConn then jumpConn:Disconnect(); jumpConn = nil end
        if jumpCharConn then jumpCharConn(); jumpCharConn = nil end
        local hum = References.humanoid

        if hum and _orig then
            if hum.UseJumpPower ~= nil then hum.UseJumpPower = _orig.UseJumpPower end
            if hum.JumpPower ~= nil then hum.JumpPower = _orig.JumpPower end
            if hum.JumpHeight ~= nil then hum.JumpHeight = _orig.JumpHeight end
        end
    end

    local ijConn, ijBusy = nil, false

    local function startInfiniteJump()
        if ijConn then return end
        ijConn = track(Services.UserInputService.JumpRequest:Connect(function()
            if not isInfiniteJumpEnabled then return end

            local hum = References.humanoid
            if not hum or ijBusy then return end

            ijBusy = true
            -- leak:allow — one-frame busy-flag reset; it cannot outlive the frame it starts in
            task.defer(function()
                pcall(function()
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                    hum.Jump = true
                end)
                task.wait()
                ijBusy = false
            end)
        end))
    end

    local function stopInfiniteJump()
        if ijConn then ijConn:Disconnect(); ijConn = nil end
        ijBusy = false
    end

    if Toggles.JumpPower then
        Toggles.JumpPower:OnChanged(function()
            if Toggles.JumpPower.Value then startJumpMod() else stopJumpMod() end
        end)
    end

    if Options.JumpHeight then
        Options.JumpHeight:OnChanged(function()
            currentJumpHeight = Options.JumpHeight.Value
            if Toggles.JumpPower and Toggles.JumpPower.Value then
                applyJumpHeight()
            end
        end)
    end

    if Toggles.InfiniteJump then
        Toggles.InfiniteJump:OnChanged(function()
            isInfiniteJumpEnabled = Toggles.InfiniteJump.Value
            if isInfiniteJumpEnabled then startInfiniteJump() else stopInfiniteJump() end
        end)
    end

    return {
        startJumpMod      = startJumpMod,
        stopJumpMod       = stopJumpMod,
        startInfiniteJump = startInfiniteJump,
        stopInfiniteJump  = stopInfiniteJump,
    }
end

end)
