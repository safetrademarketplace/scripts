        Values = {"Passive", "Aggressive"},
        Tooltip = "Passive: Soft lighting, preserves shadows.\nAggressive: Max brightness, removes shadows."
    })

    FullbrightBox:AddSlider("Fullbright_Brightness", {
        Text = "Brightness",
        Default = 1,
        Min = 0.01,
        Max = 5,
        Rounding = 3
    })

    FullbrightBox:SetupDependencies({
        { Toggles.Fullbright, true },
    })

    local currentBrightness = Options.Fullbright_Brightness.Value

    local fbConn, fbSaved

    local COLOR_AGGRESSIVE = Color3.new(1, 1, 1)
    local COLOR_PASSIVE    = Color3.fromRGB(150, 150, 150)

    local function fbOn()
        if fbConn then return end

        local lighting = Services.Lighting

        fbSaved = fbSaved or {
            B = lighting.Brightness,
            GS = lighting.GlobalShadows,
            A = lighting.Ambient,
            OA = lighting.OutdoorAmbient
        }

        fbConn = track(Scheduler.render(function()
            local mode = Options.Fullbright_Mode and Options.Fullbright_Mode.Value or "Aggressive"

            local targetShadows = (mode == "Passive")
            local targetColor   = (mode == "Passive") and COLOR_PASSIVE or COLOR_AGGRESSIVE

            -- only write properties that differ — this runs every frame
            if lighting.Brightness ~= currentBrightness then
                lighting.Brightness = currentBrightness
            end
            if lighting.GlobalShadows ~= targetShadows then
                lighting.GlobalShadows = targetShadows
            end
            if lighting.Ambient ~= targetColor then
                lighting.Ambient = targetColor
            end
            if lighting.OutdoorAmbient ~= targetColor then
                lighting.OutdoorAmbient = targetColor
            end
        end, { name = "Fullbright" }))
    end

    local function fbOff()
        if fbConn then
            fbConn:Disconnect()
            fbConn = nil
        end
        if fbSaved then
            local lighting = Services.Lighting
            lighting.Brightness = fbSaved.B
            lighting.GlobalShadows = fbSaved.GS
            lighting.Ambient = fbSaved.A
            lighting.OutdoorAmbient = fbSaved.OA
            fbSaved = nil
        end
    end

    if Toggles.Fullbright then
        Toggles.Fullbright:OnChanged(function()
            if Toggles.Fullbright.Value then fbOn() else fbOff() end
        end)
    end

    if Options.Fullbright_Brightness then
        Options.Fullbright_Brightness:OnChanged(function()
            currentBrightness = Options.Fullbright_Brightness.Value
        end)
    end

    return { cleanup = fbOff }
