__bundle_register("Features/Visuals/ESP/Ui", function(require, _LOADED, __bundle_register, __bundle_modules)
-- esp ui: universal groupbox + a full per-group control set (box/fill/3d/name/distance/health/tracer/skeleton/arrow/chams/team-color), dependency-gated (a group's controls hide until it's enabled, sub-settings hide until their element is on) and bound to the shared ctx.Api.Esp engine. groups come from Engine.GetGroupList() so fork groups appear automatically

return function(deps)
    local Tabs    = deps.Tabs
    local Options = deps.Options
    local Toggles = deps.Toggles
    local Engine  = deps.Engine

    if not (Tabs and Tabs.ESP and Engine) then return end

    -- a toggle with an attached color picker; pickers fire Callback, not :OnChanged
    local function coloredToggle(container, id, text, dflt, toggleApply, colorId, colorDflt, title, colorApply)
        local t = container:AddToggle(id, { Text = text, Default = dflt, Callback = toggleApply })
        t:AddColorPicker(colorId, { Default = colorDflt, Title = title,
            Callback = function() colorApply(Options[colorId].Value) end })
        return t
    end

    local function buildUniversal()
        local Uni = Tabs.ESP:AddLeftGroupbox("Universal", "settings")
        Uni:AddSlider("ESP_TextSize", { Text = "Text Size", Default = 13, Min = 10, Max = 28, Rounding = 0,
            Callback = function(v) Engine.SetShared({ textSize = v }) end })
        Uni:AddDropdown("ESP_TracerOrigin", { Text = "Tracer Origin", Values = { "Bottom", "Middle", "Top" }, Default = "Bottom",
            Callback = function(v) Engine.SetAllGroups({ tracer = { origin = v } }) end })
        Uni:AddToggle("ESP_LimitRange", { Text = "Limit Range", Default = false,
            Callback = function(v) Engine.SetAllGroups({ limitDistance = v }) end })
        local rangeBox = Uni:AddDependencyBox()
        rangeBox:AddSlider("ESP_MaxRange", { Text = "Range (studs)", Default = 150, Min = 50, Max = 2000, Rounding = 0,
            Callback = function(v) Engine.SetAllGroups({ maxDistance = v }) end })
        rangeBox:SetupDependencies({ { Toggles.ESP_LimitRange, true } })
    end

    local function buildGroup(group, side)
        local key = group.key
        local cfg = Engine.GetGroupConfig(key)
        if not cfg then return end
        local isPlayers = key == "Players"
        local gbox = (side == "left") and Tabs.ESP:AddLeftGroupbox(group.label, "eye")
            or Tabs.ESP:AddRightGroupbox(group.label, "eye")

        gbox:AddToggle(key .. "_Enable", { Text = "Enabled", Default = cfg.enabled,
            Callback = function(v) Engine.SetEnabled(key, v) end })

        -- everything below hides until the group is enabled
        local body = gbox:AddDependencyBox()

        if isPlayers then
            body:AddToggle(key .. "_TeamColor", { Text = "Use Team Color", Default = cfg.teamColor,
                Callback = function(v) Engine.SetGroupConfig(key, { teamColor = v }) end })
        end

        coloredToggle(body, key .. "_Box", "Box", cfg.box.enabled,
            function(v) Engine.SetGroupConfig(key, { box = { enabled = v } }) end,
            key .. "_BoxColor", cfg.box.color, "Box Color",
            function(c) Engine.SetGroupConfig(key, { box = { color = c }, boxFill = { color = c }, box3d = { color = c } }) end)
        -- box sub-settings hide until Box is on
        local boxOpts = body:AddDependencyBox()
        boxOpts:AddToggle(key .. "_BoxOutline", { Text = "Outline", Default = cfg.box.outline,
            Callback = function(v) Engine.SetGroupConfig(key, { box = { outline = v } }) end })
        boxOpts:AddToggle(key .. "_Box3d", { Text = "3D Box", Default = cfg.box3d.enabled,
            Callback = function(v) Engine.SetGroupConfig(key, { box3d = { enabled = v } }) end })
        boxOpts:AddToggle(key .. "_BoxFill", { Text = "Fill", Default = cfg.boxFill.enabled,
            Callback = function(v) Engine.SetGroupConfig(key, { boxFill = { enabled = v } }) end })
        boxOpts:AddSlider(key .. "_BoxFillAlpha", { Text = "Fill Opacity", Default = math.floor(cfg.boxFill.transparency * 100), Min = 0, Max = 100, Rounding = 0, Suffix = "%",
            Callback = function(v) Engine.SetGroupConfig(key, { boxFill = { transparency = v / 100 } }) end })
        boxOpts:SetupDependencies({ { Toggles[key .. "_Box"], true } })

        coloredToggle(body, key .. "_Name", "Name", cfg.name.enabled,
            function(v) Engine.SetGroupConfig(key, { name = { enabled = v } }) end,
            key .. "_NameColor", cfg.name.color, "Name Color",
            function(c) Engine.SetGroupConfig(key, { name = { color = c } }) end)

        coloredToggle(body, key .. "_Distance", "Distance", cfg.distance.enabled,
            function(v) Engine.SetGroupConfig(key, { distance = { enabled = v } }) end,
            key .. "_DistColor", cfg.distance.color, "Distance Color",
            function(c) Engine.SetGroupConfig(key, { distance = { color = c } }) end)

        body:AddToggle(key .. "_HealthBar", { Text = "Health Bar", Default = cfg.health.bar,
            Callback = function(v) Engine.SetGroupConfig(key, { health = { bar = v } }) end })
        body:AddToggle(key .. "_HealthText", { Text = "Health Text", Default = cfg.health.text,
            Callback = function(v) Engine.SetGroupConfig(key, { health = { text = v } }) end })

        coloredToggle(body, key .. "_Tracer", "Tracer", cfg.tracer.enabled,
            function(v) Engine.SetGroupConfig(key, { tracer = { enabled = v } }) end,
            key .. "_TracerColor", cfg.tracer.color, "Tracer Color",
            function(c) Engine.SetGroupConfig(key, { tracer = { color = c } }) end)

        coloredToggle(body, key .. "_Skeleton", "Skeleton", cfg.skeleton.enabled,
            function(v) Engine.SetGroupConfig(key, { skeleton = { enabled = v } }) end,
            key .. "_SkeletonColor", cfg.skeleton.color, "Skeleton Color",
            function(c) Engine.SetGroupConfig(key, { skeleton = { color = c } }) end)

        body:AddToggle(key .. "_Arrow", { Text = "Off-Screen Arrow", Default = cfg.arrow.enabled,
            Callback = function(v) Engine.SetGroupConfig(key, { arrow = { enabled = v } }) end })

        local chamsT = body:AddToggle(key .. "_Chams", { Text = "Chams", Default = cfg.chams.enabled,
            Callback = function(v) Engine.SetGroupConfig(key, { chams = { enabled = v } }) end })
        chamsT:AddColorPicker(key .. "_ChamsFill", { Default = cfg.chams.fillColor, Title = "Chams Fill",
            Callback = function() Engine.SetGroupConfig(key, { chams = { fillColor = Options[key .. "_ChamsFill"].Value } }) end })
        chamsT:AddColorPicker(key .. "_ChamsOutline", { Default = cfg.chams.outlineColor, Title = "Chams Outline",
            Callback = function() Engine.SetGroupConfig(key, { chams = { outlineColor = Options[key .. "_ChamsOutline"].Value } }) end })
        local chamsOpts = body:AddDependencyBox()
        chamsOpts:AddToggle(key .. "_ChamsVisible", { Text = "Visible-Only", Default = cfg.chams.visibleOnly,
            Callback = function(v) Engine.SetGroupConfig(key, { chams = { visibleOnly = v } }) end })
        chamsOpts:SetupDependencies({ { Toggles[key .. "_Chams"], true } })

        body:SetupDependencies({ { Toggles[key .. "_Enable"], true } })
    end

    buildUniversal()
    for i, group in ipairs(Engine.GetGroupList()) do
        buildGroup(group, (i % 2 == 1) and "right" or "left")
    end
end

end)
