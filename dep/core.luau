    })

    local function findIndexByName(name)
        if not name then
            return 1
        end
        for i = 1, #Playlist do
            if Playlist[i].name == name then
                return i
            end
        end
        return 1
    end

    local function playOrdered()
        if #Playlist == 0 then
            return Library:Notify("No songs in list.", 3)
        end
        modeState = "order"
        sessionToken = {}
        local idx = ddMusic and ddMusic.Value and findIndexByName(ddMusic.Value) or (currentIndex or 1)
        startTrack(idx, "order")
    end

    local function playShuffled()
        if #Playlist == 0 then
            return Library:Notify("No songs in list.", 3)
        end
        modeState = "shuffle"
        sessionToken = {}
        local n = #Playlist
        local idx
        if n == 1 then
            idx = 1
        else
            repeat
                idx = math.random(1, n)
            until idx ~= currentIndex
        end
        startTrack(idx, "shuffle")
    end

    MusicGroup:AddButton({
        Text = "Play Music (Order)",
        Func = playOrdered
