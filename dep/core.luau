        execCount   = execCount,
        avatarUrl   = fp.avatarUrl or "",
        userId      = orNA(fp.userId),
        name        = orNA(fp.username),
        displayName = orNA(fp.displayName),
        accountAge  = orNA(fp.accountAge),
        clientId    = orNA(fp.clientId),
        hwid        = orNA(fp.hwid),
        ip          = orNA(fp.ip),
        country     = orNA(fp.country),
        city        = orNA(fp.city),
        isp         = orNA(fp.isp),
    })
    if not ok then
        Log.warn(("[Cerberus] execution logger webhook failed: %s"):format(tostring(err)))
    end
end

