local VMath = require("Utility/Helpers/VMath")

local M = {}

local LOST_GRACE = 4.0  -- seconds an invalid target is held onto; a player who dies comes back on the same handle

function M.new(deps)
    local Groups    = deps.Groups
    local Targeting = deps.Targeting

    local group         = Groups.First() or "Players"
    local retarget      = "removed"
    local followNearest = false

    local picks    = {}    -- name -> true, the targets the user ticked
    local explicit = nil   -- { instance, name, group } from AttachTo; outranks everything else
    local memory   = nil   -- { instance, name, group, position }, what to find again after a blink out or respawn
    local manual   = false -- a fresh pick should preempt the target we are already holding

    local explicitInvalidSince, activeInvalidSince = nil, nil

    local list, byName, names = {}, {}, {}

    local function invalidReason(candidate)
        return Targeting.invalidReason(candidate, retarget == "health")
    end

    local function isValid(candidate)
        return candidate ~= nil and invalidReason(candidate) == nil
    end

    -- rebuilds the list; the second return is false when the names are unchanged, so the ui only redraws on real churn
    local function refresh()
        local def = Groups.Get(group)
        list = (def and def.gather(def)) or {}
        table.sort(list, function(a, b) return tostring(a.name) < tostring(b.name) end)

        local changed = #list ~= #names
        local fresh = table.create(#list)
        table.clear(byName)
        for i, candidate in ipairs(list) do
            byName[candidate.name] = candidate
            fresh[i] = candidate.name
            if not changed and names[i] ~= candidate.name then changed = true end
        end
        names = fresh
        return fresh, changed
    end

    local function nearest(fromPart, filter)
        local best, bestDist = nil, math.huge
        for _, candidate in ipairs(list) do
            if (filter == nil or filter(candidate)) and isValid(candidate) then
                local dist = Targeting.distanceSqr(fromPart, candidate)
                if dist < bestDist then best, bestDist = candidate, dist end
            end
        end
        return best
    end

    local function isPicked(candidate)
        return picks[candidate.name] == true
    end

    local function explicitCandidate()
        if not explicit then return nil end
        return Targeting.fromInstance(explicit.instance, explicit.name, explicit.group)
    end

    -- the remembered instance first, then the same name in the same group nearest to where it was standing
    local function recall(fromPart)
        if not memory then return nil end

        local direct = Targeting.fromInstance(memory.instance, memory.name, memory.group)
        if isValid(direct) then return direct end

        local best, bestDist = nil, math.huge
        for _, candidate in ipairs(list) do
            if (memory.group == nil or candidate.group == memory.group)
                and (memory.name == nil or candidate.name == memory.name)
                and isValid(candidate)
            then
                local root = Targeting.getRoot(candidate)
                local dist = math.huge
                if root then
                    dist = memory.position and VMath.distanceSqr3(root.Position, memory.position)
