            alive = false
            for i = #conns, 1, -1 do
                conns[i]:Disconnect()
                conns[i] = nil
            end
            if Controls.getExplicit() == instance then Controls.setExplicit(nil) end
            if restore.offset then Controls.setOffset(restore.offset) end
            if restore.retarget then Controls.setRetarget(restore.retarget) end
            if restore.mover then Controls.setMover(restore.mover) end
            if release then
                release()
                release = nil
            end
            if startedEngine and opts.autoStop ~= false and Engine.IsRunning() then Engine.Stop() end
            if current == session then current = nil end
            self.OnLost:Fire(tostring(reason or "detached"))
        end

        -- the engine only drops the explicit target once it has given up on it, so that is the real end of the session
