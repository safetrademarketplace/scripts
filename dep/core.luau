-- attach api: pins the local character onto a chosen player, entity or fork-registered target; built once at boot and shared as ctx.Api.Attach

local Api         = require("Api")
local EntityIndex = require("Utility/EntityIndex")
local Engine      = require("Api/Attach/Engine")
local Groups      = require("Api/Attach/Groups")
local Movers      = require("Api/Attach/Movers")
local Placement   = require("Api/Attach/Placement")
local Runtime     = require("Api/Attach/Runtime")
local Selection   = require("Api/Attach/Selection")
local Session     = require("Api/Attach/Session")
local Targeting   = require("Api/Attach/Targeting")

