    local References = ctx.References

    local noclipConn
    local refCount = 0
    local prior = setmetatable({}, { __mode = "k" })

    -- BasePart cache kept current by DescendantAdded/Removing so the stepped loop never re-walks GetDescendants
    local partSet = setmetatable({}, { __mode = "k" })
    local charConns = {}

    local function disconnectCharConns()
        for i = #charConns, 1, -1 do
            local c = charConns[i]
            charConns[i] = nil
            pcall(function() c:Disconnect() end)
        end
    end

    local function addPart(part)
        if part:IsA("BasePart") then partSet[part] = true end
    end

    local function rebuildCache()
        table.clear(partSet)
        disconnectCharConns()
        local char = References.character
        if not char then return end
        for _, d in ipairs(char:GetDescendants()) do addPart(d) end
        charConns[#charConns + 1] = char.DescendantAdded:Connect(addPart)
        charConns[#charConns + 1] = char.DescendantRemoving:Connect(function(inst)
            partSet[inst] = nil
        end)
    end

    local function clearPrior()
        prior = setmetatable({}, { __mode = "k" })
        rebuildCache()
    end
    References.onCharacter(clearPrior)
    References.onCharacterRemoving(function()
        prior = setmetatable({}, { __mode = "k" })
        table.clear(partSet)
        disconnectCharConns()
    end)

    function Helpers.startNoclip()
        refCount = refCount + 1
        if noclipConn then return end
        if next(partSet) == nil then rebuildCache() end

        noclipConn = Scheduler.stepped(function()
            if not References.character then return end
            for part in pairs(partSet) do
                if part.Parent then
                    if prior[part] == nil then prior[part] = part.CanCollide end
                    part.CanCollide = false
                else
                    partSet[part] = nil
                end
            end
        end, { name = "Noclip", priority = 50 })
    end

    function Helpers.stopNoclip()
        refCount = math.max(0, refCount - 1)
        if refCount > 0 or not noclipConn then return end
        noclipConn:Disconnect()
        noclipConn = nil
        for part, value in pairs(prior) do
            pcall(function() part.CanCollide = value end)
        end
