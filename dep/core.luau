-- teleportqueue: persists script_key + relaunch payload through teleports; luarmor-only, and skips without a resolvable key (queueing keyless would hit the key page next place)
local AuthGate = require("Auth/Gate")
local Globals  = require("Utility/Globals")
local Log      = require("Utility/Log")

-- source order: Main.lua snapshot first (some injectors deliver script_key via fenv), then standard globals; reports which source resolved
local function resolveScriptKey()
    local lrm = rawget(_G, "__rbx_runtime_auth")
    if type(lrm) == "table" and type(lrm.script_key) == "string" and lrm.script_key ~= "" then
        return lrm.script_key, "_G.__CERB_LRM.script_key"
    end
    local ok, env = pcall(getgenv)
    if ok and type(env) == "table" and type(env.script_key) == "string" and env.script_key ~= "" then
        return env.script_key, "getgenv().script_key"
    end
    local gKey = rawget(_G, "script_key")
    if type(gKey) == "string" and gKey ~= "" then
        return gKey, "_G.script_key"
    end
    return nil, "none"
end

return function(ctx)
    local TAG = "[Cerberus.TQ]"

    if not (queue_on_teleport and getgenv) then return end

    -- Auto Execute toggle off = drop the script on the next place
    local toggle = ctx and ctx.Library and ctx.Library.Toggles and ctx.Library.Toggles.Menu_AutoExecute
    if toggle and toggle.Value == false then
        Log.print(TAG .. " skip: Auto Execute toggle is off")
        return
    end

    if not AuthGate.isLuarmor() then
        Log.print(TAG .. " skip: not running under Luarmor — no teleport persistence needed")
        return
    end

    local key, source = resolveScriptKey()
    if not key then
        Log.warn(TAG .. " skip: Luarmor detected but no script_key resolved — next place will boot keyless")
        return
    end
    Log.print(string.format("%s resolved script_key from %s (len=%d)", TAG, source, #key))

    -- dedup: only the first execution per client session wires the teleport hook
    if Globals.get("__rbx_runtime_queued") then return end
    Globals.set("__rbx_runtime_queued", true)

    -- load-gate prelude: wait for full client load so CoreScript-gated calls don't throw on rejoin
    local prelude = [[
        if not game:IsLoaded() then game.Loaded:Wait() end
        local ok = false
        for _ = 1, 50 do
            if pcall(function()
                return game:GetService("StarterGui"):GetCore("DevConsoleVisible")
            end) then ok = true break end
            task.wait(0.1)
        end
        if not ok then task.wait(1) end
    ]]

    local payload = string.format(
        '%s getgenv().script_key = %q; loadstring(game:HttpGet(%q))()',
        prelude, key, "https://getcerberus.com/loader.lua"
    )

    Log.print(TAG .. " queue_on_teleport: enqueued for next teleport")
    local ok, err = pcall(queue_on_teleport, payload)
    if not ok then
        Log.warn(("%s queue_on_teleport failed: %s — script_key will not survive the next teleport")
            :format(TAG, tostring(err)))
        Globals.unset("__rbx_runtime_queued")
    end
end

end)
__bundle_register("UI/StartGuide", function(require, _LOADED, __bundle_register, __bundle_modules)
-- startguide: quick tour played once on first launch, and replayable from UI Settings

local Services       = require("Services")
local LanguagePicker = require("Auth/LanguagePicker")
local Log            = require("Utility/Log")
local Panel          = require("UI/StartGuide/Panel")
local Steps          = require("UI/StartGuide/Steps")

local HttpService = Services.HttpService

local M = {}

local FLAG_PATH = "Cerberus/tutorial.json"
local VERSION   = 1

local function readFlag()
    if not (isfile and readfile) then return nil end
    local exists = false
    pcall(function() exists = isfile(FLAG_PATH) end)
    if not exists then return nil end
    local ok, raw = pcall(readfile, FLAG_PATH)
    if not ok or type(raw) ~= "string" or raw == "" then return nil end
    local okDecode, data = pcall(HttpService.JSONDecode, HttpService, raw)
    if not okDecode or type(data) ~= "table" then return nil end
    return data
end

local function writeFlag(data)
    if makefolder then pcall(makefolder, "Cerberus") end
    if not writefile then
        Log.warn("[Cerberus/StartGuide] writefile unavailable; the guide will be offered again next session")
        return
    end
    local ok, encoded = pcall(HttpService.JSONEncode, HttpService, data)
    if not ok then return end
    local writeOk, err = pcall(writefile, FLAG_PATH, encoded)
    if not writeOk then
        Log.warn(("[Cerberus/StartGuide] save failed: %s"):format(tostring(err)))
    end
end

-- the guide is written in english only, so anyone on another locale never sees it offered
function M.isEnglish()
    local locale = LanguagePicker.read() or "en"
    return (locale:lower():match("^([a-z]+)") or "en") == "en"
end

function M.hasSeen()
    local flag = readFlag()
    return type(flag) == "table" and flag.version == VERSION and flag.seen == true
end

function M.run(ctx)
    local ok, completed = pcall(Panel.play, ctx, Steps.build(ctx))
    if not ok then
        Log.warn(("[Cerberus/StartGuide] guide failed: %s"):format(tostring(completed)))
        return false
    end
    -- skipping still counts as seen: the replay button in UI Settings is the way back in
    writeFlag({ version = VERSION, seen = true, completed = completed == true })
    return completed == true
end

-- first launch only. nothing is written for a non-english locale, so switching to english later still gets it
function M.runIfFirstTime(ctx)
    if not M.isEnglish() then
        Log.dev("StartGuide", "locale is not english, skipping the guide")
        return false
    end
    if M.hasSeen() then return false end
    return M.run(ctx)
end

M.FLAG_PATH = FLAG_PATH

return M

end)
