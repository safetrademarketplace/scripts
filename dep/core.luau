-- scrim: full-viewport backdrop geometry for modals living inside a ScreenGui they do not own, where IgnoreGuiInset being off leaves the topbar strip undimmed

local Services = require("Services")

local M = {}

-- how far the gui's own origin sits below the true top of the screen, zero when it already ignores the inset
function M.topInset(screenGui)
    if screenGui and screenGui.IgnoreGuiInset then return 0 end
    local ok, inset = pcall(function() return Services.GuiService:GetGuiInset() end)
    if not ok or typeof(inset) ~= "Vector2" then return 0 end
    return inset.Y
end

-- size a frame to the whole screen rather than the whole ScreenGui; host defaults to the frame's own ancestry so a caller cannot pass the wrong one
function M.cover(frame, screenGui)
    local host = screenGui or frame:FindFirstAncestorWhichIsA("ScreenGui")
    local inset = M.topInset(host)
    frame.Position = UDim2.fromOffset(0, -inset)
    frame.Size = UDim2.new(1, 0, 1, inset)
    return frame
end

return M

end)
