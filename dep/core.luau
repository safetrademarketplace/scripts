__bundle_register("Features/Combat/HitboxExpander", function(require, _LOADED, __bundle_register, __bundle_modules)
-- inflates other players' HumanoidRootPart for easier ranged hits; client-side, many games clamp Size server-side
local Mount     = require("Utility/Mount")
local Log       = require("Utility/Log")
local Scheduler = require("Utility/Scheduler")

return function(env)
    local O = Mount.orchestrator(env, "HitboxExpander")
    if not O then return end

    local Services   = env.Services
    local References = env.References
    local Tabs       = env.Tabs
    local Toggles    = env.Toggles
    if not (Tabs and Tabs.Combat) then return end

    -- one log per (userId, op) pair — surface the first failure without per-frame spam
    local logged = {}
    local function tryWrite(userId, op, fn)
        local ok, err = pcall(fn)
        if ok then return end
        local key = userId .. ":" .. op
        if logged[key] then return end
        logged[key] = true
        Log.warn(("[Cerberus/HitboxExpander] %s write failed for player %d: %s"):format(
            op, userId, tostring(err)))
    end

    local group = Tabs.Combat:AddLeftGroupbox("Hitbox Expander", "expand")

    local DEFAULT_SIZE   = 5
    local SWEEP_INTERVAL = 0.2

    -- References.player is cloneref'd; compare UserIds, never identity
    local localUserId = References.player and References.player.UserId

    local state = {
        on        = false,
        size      = DEFAULT_SIZE,
        originals = {},  -- [UserId] = { size, trans, canCollide, massless }
        sweepConn = nil,
        leaveConn = nil,
    }

    local function snapshot(hrp, userId)
        if state.originals[userId] then return end
        state.originals[userId] = {
            size       = hrp.Size,
            trans      = hrp.Transparency,
            canCollide = hrp.CanCollide,
            massless   = hrp.Massless,
        }
    end

    local function restore(hrp, userId)
        local orig = state.originals[userId]
        if not orig then return end
        if hrp and hrp.Parent then
            tryWrite(userId, "Size",         function() hrp.Size         = orig.size end)
            tryWrite(userId, "Transparency", function() hrp.Transparency = orig.trans end)
            tryWrite(userId, "CanCollide",   function() hrp.CanCollide   = orig.canCollide end)
            tryWrite(userId, "Massless",     function() hrp.Massless     = orig.massless end)
        end
        state.originals[userId] = nil
    end

    local function expand(hrp, userId)
        snapshot(hrp, userId)
        local s = state.size
        -- skip writes when already matching: avoids fighting engine replication on big parts
        if hrp.Size.X ~= s or hrp.Size.Y ~= s or hrp.Size.Z ~= s then
            tryWrite(userId, "Size", function() hrp.Size = Vector3.new(s, s, s) end)
        end
        if hrp.Transparency ~= 0.5 then
            tryWrite(userId, "Transparency", function() hrp.Transparency = 0.5 end)
        end
        if hrp.CanCollide then
            tryWrite(userId, "CanCollide", function() hrp.CanCollide = false end)
        end
        if not hrp.Massless then
            tryWrite(userId, "Massless", function() hrp.Massless = true end)
        end
    end

    local function sweep()
        for _, pl in ipairs(Services.Players:GetPlayers()) do
            if pl.UserId ~= localUserId and pl.Character then
                local hrp = pl.Character:FindFirstChild("HumanoidRootPart")
                if hrp and hrp:IsA("BasePart") then
                    expand(hrp, pl.UserId)
                end
            end
        end
    end

    local function restoreAll()
        for userId in pairs(state.originals) do
            local pl  = Services.Players:GetPlayerByUserId(userId)
            local hrp = pl and pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
            restore(hrp, userId)
        end
        table.clear(state.originals)
    end

    local function start()
        if state.sweepConn then return end
        sweep()
        state.sweepConn = O.track(Scheduler.heartbeat(function()
            sweep()
        end, { name = "HitboxExpander", interval = SWEEP_INTERVAL }))
        -- drop snapshot for leavers — char is gone, restore is moot
        state.leaveConn = O.track(Services.Players.PlayerRemoving:Connect(function(pl)
            state.originals[pl.UserId] = nil
        end))
    end

    local function stop()
        if state.sweepConn then state.sweepConn:Disconnect(); state.sweepConn = nil end
        if state.leaveConn then state.leaveConn:Disconnect(); state.leaveConn = nil end
        restoreAll()
    end

    group:AddToggle("HitboxExpand_Enable", {
        Text    = "Hitbox Expander",
        Default = false,
        Tooltip = "Inflates other players' HumanoidRootPart for easier ranged hits. Many games clamp size server-side, so it is not guaranteed to work in every game.",
        Callback = function(v)
            state.on = v
            if v then start() else stop() end
        end,
    })

    local HitboxBox = group:AddDependencyBox()

    HitboxBox:AddSlider("HitboxExpand_Size", {
        Text     = "Hitbox Size",
        Default  = DEFAULT_SIZE,
        Min      = 3,
        Max      = 30,
        Rounding = 0,
        Suffix   = " studs",
        Callback = function(v)
            state.size = v
            if state.on then sweep() end
        end,
    })

    HitboxBox:SetupDependencies({
        { Toggles.HitboxExpand_Enable, true },
    })

    O.onUnload(stop)
    O.finalize()
    return {}
end

end)
