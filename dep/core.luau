__bundle_register("Features/Auto/Webhooks/UI", function(require, _LOADED, __bundle_register, __bundle_modules)
-- webhook ui: builds the webhook groupbox and wires url/color/anon/events + auto-generated per-event option controls to the webhook api

-- set {label=true} or array -> array of labels, for obsidian multi-dropdown Default
local function toLabelArray(v)
    local out = {}
    if type(v) ~= "table" then return out end
    if v[1] ~= nil then
        for _, x in ipairs(v) do out[#out + 1] = x end
    else
        for label, on in pairs(v) do if on then out[#out + 1] = label end end
    end
    return out
end

-- render one event's option schema as obsidian controls, persisting each change through the api
local function renderEventOptions(group, api, ev)
    group:AddLabel(ev.label .. " Options", true)
    for _, opt in ipairs(ev.options) do
        local uid = "Webhook_" .. ev.key .. "_" .. opt.key
        local cur = api.GetEventOption(ev.key, opt.key, opt.default)
        local function guard(fn)
            return function(v) if not api.IsSuspended() then fn(v) end end
        end

        if opt.kind == "toggle" then
            group:AddToggle(uid, {
                Text = opt.label,
                Default = cur == true,
                Callback = guard(function(v) api.SetEventOption(ev.key, opt.key, v == true) end),
            })
        elseif opt.kind == "slider" then
            group:AddSlider(uid, {
                Text = opt.label,
                Default = tonumber(cur) or tonumber(opt.default) or opt.min or 0,
                Min = opt.min or 0,
                Max = opt.max or 100,
                Rounding = opt.rounding or 0,
                Callback = guard(function(v) api.SetEventOption(ev.key, opt.key, v) end),
            })
        elseif opt.kind == "dropdown" then
            group:AddDropdown(uid, {
                Text = opt.label,
                Values = opt.values or {},
                Default = cur or opt.default,
                Callback = guard(function(v) api.SetEventOption(ev.key, opt.key, v) end),
            })
        elseif opt.kind == "multi" then
            group:AddDropdown(uid, {
                Text = opt.label,
                Values = opt.values or {},
                Multi = true,
                Default = toLabelArray(cur ~= nil and cur or opt.default),
                Callback = guard(function(v) api.SetEventOption(ev.key, opt.key, v) end),
            })
        elseif opt.kind == "input" then
            group:AddInput(uid, {
                Text = opt.label,
                Default = tostring(cur or opt.default or ""),
                Callback = guard(function(v) api.SetEventOption(ev.key, opt.key, v) end),
            })
        end
    end
end

return function(ctx, api)
    local Tabs = ctx.Tabs
    local group = Tabs.Auto:AddLeftGroupbox("Webhook", "send")

    -- fire a test ping and notify discord's actual response (submit + button share this)
    local function fireTest()
        local queued = api.Test(nil, function(sent, status)
            if sent then
                ctx.Library:Notify(("Webhook connected — Discord returned HTTP %s."):format(tostring(status or "2xx")), 5)
            else
                ctx.Library:Notify(("Webhook test failed (HTTP %s) — check the URL."):format(tostring(status or "?")), 6)
            end
        end)
        if not queued then
            ctx.Library:Notify("That doesn't look like a Discord webhook URL.", 5)
        end
    end

    group:AddInput("WebhookURL", {
        Text = "Webhook URL",
        Placeholder = "https://discord.com/api/webhooks/...",
        ClearTextOnFocus = false,
        Finished = true,   -- fire on submit (enter / focus-out), not per keystroke
        Default = api.GetUrl(),
        Callback = function(val)
            if api.IsSuspended() then return end
            api.SetUrl(val)
            if val and val ~= "" then fireTest() end   -- auto test ping on submit
        end,
    })

    group:AddLabel("Embed Color")
        :AddColorPicker("WebhookColor", {
            Default = api.GetColor(),
            Callback = function(val)
                if api.IsSuspended() then return end
                api.SetColor(val)
            end,
        })

    group:AddToggle("WebhookAnon", {
        Text = "Anonymize User Data",
        Default = api.GetAnon(),
        Callback = function(val)
            if api.IsSuspended() then return end
            api.SetAnon(val)
        end,
    })

    -- events multi-dropdown shows friendly labels, maps back to keys on change
    local events = api.GetEventList()
    local labels, labelToKey = {}, {}
    for _, ev in ipairs(events) do
        labels[#labels + 1] = ev.label
        labelToKey[ev.label] = ev.key
    end

    local function enabledLabels()
        local out = {}
        for _, ev in ipairs(events) do
            if api.IsEventEnabled(ev.key) then out[#out + 1] = ev.label end
        end
        return out
    end

    group:AddDropdown("WebhookEvents", {
        Text = "Events",
        Values = labels,
        Default = enabledLabels(),
        Multi = true,
        Callback = function(val)
            if api.IsSuspended() then return end
            local sel = {}
            for label, on in pairs(val) do
                local key = labelToKey[label]
                if key then sel[key] = on end
            end
            api.SetEnabledFromSelection(sel)
        end,
    })

    group:AddButton("Send Test", fireTest)

    for _, ev in ipairs(events) do
        if ev.options and #ev.options > 0 then
            renderEventOptions(group, api, ev)
        end
    end
end

end)
