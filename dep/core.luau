__bundle_register("Utility/Helpers/Move", function(require, _LOADED, __bundle_register, __bundle_modules)
-- physics-driven move-to-position via AlignPosition/AlignOrientation, noclip-refcount aware
local Str       = require("Utility/Helpers/Str")
local Scheduler = require("Utility/Scheduler")

return function(ctx, Helpers)
    local References = ctx.References
    local NewMaid    = ctx.NewMaid

    -- random per-session name: HRP children replicate to the server, so no brand string
    local MOVER_NAME = "_mv" .. Str.randomHex(8)

    function Helpers.MoveToPos(targetPos, studsPerSecond, dynamicTargetFunc)
        studsPerSecond = math.max(0, tonumber(studsPerSecond) or 0)
        if studsPerSecond == 0 then
            Helpers.stopNoclip()
            return function() end
        end

        Helpers.startNoclip()
        local maid = NewMaid()

        local hrp = References.humanoidRootPart
        local hum = References.humanoid

        for _, v in ipairs(hrp:GetChildren()) do
            if v.Name == MOVER_NAME then
                v:Destroy()
            end
        end

        if hum then hum.AutoRotate = false end
        hrp.AssemblyAngularVelocity = Vector3.zero

        local a0 = Instance.new("Attachment")
        a0.Name = MOVER_NAME
        a0.Parent = hrp
        maid:GiveTask(a0)

        local ap = Instance.new("AlignPosition")
        ap.Name = MOVER_NAME
        ap.Mode = Enum.PositionAlignmentMode.OneAttachment
        ap.Attachment0 = a0
        ap.ApplyAtCenterOfMass = true
        ap.Responsiveness = 200
        -- finite 1e7, not math.huge: avoids the infinite-force-constraint anti-cheat heuristic
        ap.MaxForce = 1e7
        ap.MaxVelocity = studsPerSecond
        ap.Position = targetPos
        ap.Parent = hrp
        maid:GiveTask(ap)

        local ao = Instance.new("AlignOrientation")
        ao.Name = MOVER_NAME
        ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
        ao.Attachment0 = a0
        ao.Responsiveness = 100
        ao.RigidityEnabled = true
        ao.MaxTorque = 1e7
        ao.Parent = hrp
        maid:GiveTask(ao)

        local alive = true
        local startT = os.clock()
        local isDynamic = type(dynamicTargetFunc) == "function"

        local function cleanup()
            if not alive then return end
            alive = false

            maid:DoCleaning()

            if hum then hum.AutoRotate = true end
            Helpers.stopNoclip()
        end

        local conn = Scheduler.heartbeat(function()
            if not alive then return end

            if not (hrp and hrp.Parent) then
                cleanup()
                return
            end

            local targetNow = isDynamic and dynamicTargetFunc() or targetPos
            if not targetNow then
                cleanup()
                return
            end

            ap.Position = targetNow

            -- flatten orientation so the character stays upright
            local flatTarget = Vector3.new(targetNow.X, hrp.Position.Y, targetNow.Z)
            if (flatTarget - hrp.Position).Magnitude > 0.001 then
                ao.CFrame = CFrame.lookAt(hrp.Position, flatTarget)
            end

            if (hrp.Position - targetNow).Magnitude <= 3 then
                cleanup()
                return
            end

            -- timeout only applies to static points
            if not isDynamic and (os.clock() - startT) > 15 then
                cleanup()
            end
        end, { name = "MoveToPos", priority = 50 })
        maid:GiveTask(conn)

        return cleanup
    end
end

end)
