local Services = require("Services")

local Jobs = require("Utility/Jobs")

local CoreGui = Services.CoreGui

local BIND_TIMEOUT = 3
local HISTORY_MAX  = 32
local SETTLE_PASSES = 3
local WINDOW = "DevConsoleWindow"

local M = {}

M.Colors = {
    Grey   = Color3.fromRGB(170, 170, 170),
    Blue   = Color3.fromRGB(80, 170, 255),
    Cyan   = Color3.fromRGB(0, 255, 255),
    Yellow = Color3.fromRGB(255, 220, 80),
    Orange = Color3.fromRGB(255, 165, 0),
    Green  = Color3.fromRGB(0, 255, 100),
    Red    = Color3.fromRGB(255, 70, 70),
}

local function resolveColor(c)
    if typeof(c) == "Color3" then return c end
    if type(c) == "string" and M.Colors[c] then return M.Colors[c] end
    return M.Colors.Grey
end

function M.progressBar(percent, length)
    length = length or 25
    local filled = math.clamp(math.floor((percent / 100) * length + 0.5), 0, length)
    return ("[%s%s]"):format(("█"):rep(filled), ("░"):rep(length - filled))
end

-- entries { seed, prefix, text, written }, mutated in place so a rebind reproduces current state rather than the seed originally printed
local history = {}
local stepEntry

local master, masterConn, enabledConn, coreConn
local window, windowConn
local resolver, requested

local function readText(obj)
    local ok, txt = pcall(function() return obj.Text end)
    if ok and type(txt) == "string" then return txt end
    return nil
end

-- ours only while the label reads back what we last wrote; anything else means the console rebuilt it from the log store
local function stillOurs(entry)
    local label = entry.label
    if not (label and label.Parent) then return false end
    local current = readText(label)
    if not current then return false end
    if entry.written then return current == entry.written end
    local cut = #current - #entry.seed
    return cut >= 0 and current:sub(cut + 1) == entry.seed
end

local function write(entry)
    if not stillOurs(entry) then return false end
    local text = (entry.prefix or "") .. entry.text
    local applied = pcall(function()
        entry.label.Text = text
        entry.label.TextColor3 = entry.color
    end)
    if applied then entry.written = text end
    return applied
end

-- one descendant walk matched against every unbound entry at once, so a reopened console costs one scan per frame rather than one per line
local function bindPass(root)
    local labels = {}
    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            local txt = readText(obj)
            if txt and txt ~= "" then
                labels[#labels + 1] = { obj = obj, text = txt }
            end
        end
    end

    local claimed, unbound = {}, 0
    for _, entry in ipairs(history) do
        if entry.label then claimed[entry.label] = true end
    end

    -- newest line against newest label; claiming keeps two identically-worded lines off the same one
    for i = #history, 1, -1 do
        local entry = history[i]
        if not stillOurs(entry) then
            unbound = unbound + 1
            for j = #labels, 1, -1 do
                local cand = labels[j]
                local cut = #cand.text - #entry.seed
                if cut >= 0 and not claimed[cand.obj] and cand.text:sub(cut + 1) == entry.seed then
                    entry.label, entry.prefix, entry.written = cand.obj, cand.text:sub(1, cut), nil
                    claimed[cand.obj] = true
                    if write(entry) then unbound = unbound - 1 end
                    break
                end
            end
        end
    end
    return unbound
end

-- mutually recursive: resolving installs the reopen watchers, and a watcher asks for another pass
local resolve, schedule, watch, watchWindow, observe

-- DevConsoleMaster.Enabled never toggles; DevConsoleWindow.Visible does, and going invisible destroys every log label
function watchWindow(win)
    if window == win then return end
    if windowConn then windowConn:Disconnect() end
    window, windowConn = win, nil
