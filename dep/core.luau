__bundle_register("Utility/Executor", function(require, _LOADED, __bundle_register, __bundle_modules)
-- unified resolver for executor-injected globals: extra envs -> _G -> getgenv() -> getfenv(0) -> shared

local M = {}

-- searched before _G; populated by Main.lua registering getfenv(1)
local extraEnvs = {}

local function safeGetenv()
    local ok, env = pcall(getgenv)
    if ok and type(env) == "table" then return env end
    return nil
end

local function safeGetfenv(depth)
    local ok, env = pcall(getfenv, depth)
    if ok and type(env) == "table" then return env end
    return nil
end

local function sharedEnv()
    local ok, val = pcall(function() return shared end)
    if ok and type(val) == "table" then return val end
    return nil
end

-- rawget first to skip surprising __index defaults; fall back for lazy-load envs
local function lookupIn(env, name)
    if type(env) ~= "table" then return nil end
    local v = rawget(env, name)
    if v ~= nil then return v end
    local ok, mv = pcall(function() return env[name] end)
    if ok then return mv end
    return nil
end

-- walks dotted names like "syn.request" at arbitrary depth
local function lookupDottedIn(env, name)
    if type(env) ~= "table" then return nil end
    local dot = name:find(".", 1, true)
    if not dot then return lookupIn(env, name) end
    local base, rest = name:sub(1, dot - 1), name:sub(dot + 1)
    local t = lookupIn(env, base)
    if type(t) ~= "table" then return nil end
    return lookupDottedIn(t, rest)
end

local function lookupOrdered(name)
    for i = 1, #extraEnvs do
        local v = lookupDottedIn(extraEnvs[i], name)
        if v ~= nil then return v end
    end
    local v = lookupDottedIn(_G, name)
    if v ~= nil then return v end
    v = lookupDottedIn(safeGetenv(), name)
    if v ~= nil then return v end
    v = lookupDottedIn(safeGetfenv(0), name)
    if v ~= nil then return v end
    return lookupDottedIn(sharedEnv(), name)
end

function M.addEnv(env)
    if type(env) ~= "table" then return end
    for i = 1, #extraEnvs do
        if extraEnvs[i] == env then return end
    end
    extraEnvs[#extraEnvs + 1] = env
end

function M.get(name)
    if type(name) ~= "string" or name == "" then return nil end
    return lookupOrdered(name)
end

function M.has(name)
    return M.get(name) ~= nil
end

function M.isFn(name)
    return type(M.get(name)) == "function"
end

-- pcall via resolved name: (false,"missing"|"not function"|err) or (true,...)
function M.call(name, ...)
    local fn = M.get(name)
    if fn == nil then return false, "missing" end
    if type(fn) ~= "function" then return false, "not function" end
    return pcall(fn, ...)
end

function M.check(names)
    local out = {}
    if type(names) ~= "table" then return out end
    for _, n in ipairs(names) do
        out[n] = M.isFn(n)
    end
    return out
end

-- read-only caching proxy: first access resolves, writes ignored
function M.proxy()
    return setmetatable({}, {
        __index = function(t, k)
            local v = M.get(k)
            if v ~= nil then rawset(t, k, v) end
            return v
        end,
        __newindex = function() end,
    })
end

return M

end)
__bundle_register("Utility/Globals", function(require, _LOADED, __bundle_register, __bundle_modules)
-- tracked registry for cross-execution getgenv()/_G state so Globals.clear() nils every key on unload — no manual list to drift

local M = { _records = {} }

local function gg()
    return getgenv()
end

function M.set(key, value)
    M._records[key] = { table = gg(), kind = "executor" }
    gg()[key] = value
end

-- _G variant for keys external harness code reads via rawget(_G, ...), not the getgenv view
function M.setRaw(key, value)
    M._records[key] = { table = _G, kind = "raw" }
    rawset(_G, key, value)
end

-- falls back to getgenv() for executor-set values (script_key, etc.) the registry didn't author
function M.get(key)
    local rec = M._records[key]
    if rec then return rec.table[key] end
    return gg()[key]
end

-- Instance values get :Destroy()'d since orphaned Instances persist in CoreGui across reloads
function M.unset(key)
    local rec = M._records[key]
    if not rec then return end
    local current = rec.table[key]
    if typeof(current) == "Instance" then
        pcall(function() current:Destroy() end)
    end
    if rec.kind == "raw" then
        rawset(rec.table, key, nil)
    else
        rec.table[key] = nil
    end
    M._records[key] = nil
end

-- the single call SessionLifecycle uses on unload
function M.clear()
    for key, _ in pairs(M._records) do
        M.unset(key)
    end
    M._records = {}
end

-- debug aid for diagnosing "why does the next launch think Cerberus is already loaded"
function M.snapshot()
    local out = {}
    for key in pairs(M._records) do out[#out + 1] = key end
    table.sort(out)
    return out
end

return M

end)
