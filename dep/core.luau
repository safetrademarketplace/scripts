__bundle_register("Features/Auto/Attach/Ui", function(require, _LOADED, __bundle_register, __bundle_modules)
-- attach ui: builds the attach groupboxes on the auto tab and keeps them in step with the shared attach api

return function(ctx)
    local Attach  = ctx.Attach
    local Options = ctx.Options
    local Tabs    = ctx.Tabs
    local Toggles = ctx.Toggles
    local track   = ctx.track

    if not (Tabs and Tabs.Auto and Attach and track) then return end

    local defaults = Attach.GetDefaultOffset()
    local offset   = Attach.GetOffset()
    local status   = Attach.GetStatus()

    local function labelsOf(entries, activeKey)
        local labels, current = table.create(#entries), nil
        for i, entry in ipairs(entries) do
            labels[i] = entry.label
            if entry.key == activeKey then current = entry.label end
        end
        return labels, current or labels[1]
    end

    local groupLabels, currentGroup = labelsOf(Attach.GetGroups(), status.group)
    local moverLabels, currentMover = labelsOf(Attach.GetMovers(), status.mover)

    -- obsidian fires callbacks for programmatic writes too, so anything we set must not read back as a user action
    local syncing = false

    local AttachGroup = Tabs.Auto:AddRightGroupbox("Attach", "paperclip")
    local TargetGroup = Tabs.Auto:AddRightGroupbox("Attach Targets", "crosshair")

    AttachGroup:AddToggle("AT_Enabled", {
        Text = "Enable Attach",
        Default = status.running,
        Tooltip = "Stick to the targets you picked, or to the closest one.",
        Callback = function(on)
            if syncing then return end
            if on then Attach.Start() else Attach.Stop() end
        end,
    })

    local Box = AttachGroup:AddDependencyBox()

    Box:AddDropdown("AT_RetargetCondition", {
        Text = "Switch Target When",
        Values = { "Health", "Removed" },
        Default = (status.retarget == "removed") and "Removed" or "Health",
        Tooltip = "Health moves on as soon as the target dies. Removed waits until it leaves the game.",
        Callback = function(value) Attach.SetRetarget(value) end,
    })

    Box:AddToggle("AT_WholeCategory", {
        Text = "Follow Nearest",
        Default = status.followNearest,
        Tooltip = "Ignore your picks and stick to whichever target is closest.",
        Callback = function(on) Attach.SetFollowNearest(on) end,
    })

    if #moverLabels > 1 then
        Box:AddDropdown("AT_Mover", {
            Text = "Hold Method",
            Values = moverLabels,
            Default = currentMover,
            Tooltip = "How you are held in place. Try another one if attach gets you kicked.",
            Callback = function(value) Attach.SetMover(value) end,
        })
    end

    Box:AddDivider()
    Box:AddLabel("Offset From Target")

    local function syncOffset()
        local right, up, forward = Options.AT_OffsetRight, Options.AT_OffsetUp, Options.AT_OffsetForward
        if not (right and up and forward) then return end
        Attach.SetOffset({ right = right.Value, up = up.Value, forward = forward.Value })
    end

    Box:AddSlider("AT_OffsetRight", {
        Text = "Right / Left", Default = offset.right,
        Min = -50, Max = 50, Rounding = 1, Suffix = " studs",
        Callback = syncOffset,
    })
    Box:AddSlider("AT_OffsetUp", {
        Text = "Up / Down", Default = offset.up,
        Min = -50, Max = 50, Rounding = 1, Suffix = " studs",
        Callback = syncOffset,
    })
    Box:AddSlider("AT_OffsetForward", {
        Text = "Forward / Back", Default = offset.forward,
        Min = -50, Max = 50, Rounding = 1, Suffix = " studs",
        Callback = syncOffset,
    })

    Box:AddButton({
        Text = "Reset Offset",
        Tooltip = "Put the offset sliders back where they started.",
        Func = function()
            -- each SetValue runs the slider callback, which is what pushes the value into the api
            if Options.AT_OffsetRight then Options.AT_OffsetRight:SetValue(defaults.right) end
            if Options.AT_OffsetUp then Options.AT_OffsetUp:SetValue(defaults.up) end
            if Options.AT_OffsetForward then Options.AT_OffsetForward:SetValue(defaults.forward) end
        end,
    })

    Box:SetupDependencies({
        { Toggles.AT_Enabled, true },
    })

    TargetGroup:AddDropdown("AT_Category", {
        Text = "Target Category",
        Values = groupLabels,
        Default = currentGroup,
        Tooltip = "Which pool the target list is drawn from.",
        Callback = function(value)
            if syncing then return end
            Attach.SetGroup(value)
        end,
    })

    local ddTarget = TargetGroup:AddDropdown("AT_Target", {
        Text = "Targets",
        Values = {},
        Multi = true,
        AllowNull = true,
        Tooltip = "Tick everyone you are willing to attach to; the closest one wins.",
        Callback = function(value)
            if syncing then return end
            Attach.SetTargets(value)
        end,
    })

    TargetGroup:AddButton({
        Text = "Refresh Targets",
        Tooltip = "Rebuild the target list right now.",
        Func = function() Attach.RefreshTargets() end,
    })

    local function syncTargets(names)
        local picked, shown = Attach.GetPicked(), {}
        for _, name in ipairs(names) do
            if picked[name] then shown[name] = true end
        end
        syncing = true
        ddTarget:SetValues(names)
        ddTarget:SetValue(shown)
        syncing = false
    end

    -- an autofarm can start and stop attach on its own, so mirror the engine rather than trusting the toggle
    local function syncRunning(on)
        if not Toggles.AT_Enabled then return end
        syncing = true
        Toggles.AT_Enabled:SetValue(on)
        syncing = false
    end

    track(Attach.TargetsChanged:Connect(syncTargets))
    track(Attach.Started:Connect(function() syncRunning(true) end))
    track(Attach.Stopped:Connect(function() syncRunning(false) end))

    Attach.SetAutoRefresh(true)
    Attach.RefreshTargets()
end

end)
