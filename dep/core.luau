        end

        local seen = {}
        radar.conn = track(Scheduler.heartbeat(function()
            local root = References.humanoidRootPart
            if not root then
                for _, blip in pairs(radar.blips) do blip.Visible = false end
                return
            end

            local size = holder.AbsoluteSize
            local cx, cy = size.X / 2, size.Y / 2
            local radius = math.min(size.X, size.Y) / 2 - (12 * radar.scale)
            local rangeSqr = radar.range * radar.range
            local invRange = 1 / radar.range
            local blipSize = 8 * radar.scale

            local teamsAvailable = Services.Teams and #Services.Teams:GetChildren() > 0
            local myTeam = Services.Players.LocalPlayer.Team

            local cam = Services.Workspace.CurrentCamera
            local camRight = cam and cam.CFrame.RightVector
            local camForward = cam and cam.CFrame.LookVector
            local cameraMode = (radar.mode == "Camera") and camRight and camForward

            table.clear(seen)
            local rootPos = root.Position
            -- References.player is cloneref'd so `~=` against raw GetPlayers entries is always true; compare UserIds
            local localUserId = References.player and References.player.UserId

            for _, pl in ipairs(Services.Players:GetPlayers()) do
                if pl.UserId ~= localUserId and pl.Character then
                    local hrp = pl.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local d2 = VMath.distanceSqr3(hrp.Position, rootPos)
                        if d2 <= rangeSqr then
                            local rel = hrp.Position - rootPos
                            local rx, rz
                            if cameraMode then
                                rx = rel:Dot(camRight)
                                rz = -rel:Dot(camForward)
                            else
                                rx = rel.X; rz = rel.Z
                            end

                            local px = cx + rx * invRange * radius
                            local py = cy + rz * invRange * radius
                            local isFriendly = teamsAvailable and
                                (pl.Team ~= nil and myTeam ~= nil and pl.Team == myTeam)

                            local blip = radar.blips[pl]
                            if not blip or not blip.Parent then
                                blip = makeBlip()
                                radar.blips[pl] = blip
                            end
                            blip.Size = UDim2.fromOffset(blipSize, blipSize)
                            blip.Position = UDim2.fromOffset(px, py)
                            blip.BackgroundColor3 = isFriendly and Color3.fromRGB(55, 235, 120) or
                                Color3.fromRGB(235, 55, 55)
                            blip.Visible = true
                            seen[pl] = true
                        end
                    end
                end
            end

            -- hide unseen blips; destroy blips for players that left
            for pl, blip in pairs(radar.blips) do
                if not seen[pl] then
                    if not pl.Parent then
                        blip:Destroy()
                        radar.blips[pl] = nil
                    else
                        blip.Visible = false
                    end
                end
            end
