        local countLabel = New("TextLabel", {
            Name                   = "Count",
            BackgroundTransparency = 1,
            Position               = UDim2.new(0, 0, 1, -22),
            Size                   = UDim2.new(1, 0, 0, 18),
            Font                   = Enum.Font.GothamBold,
            TextSize               = 13,
            TextColor3             = item.has_voted and Color3.new(1, 1, 1)
                or (canVote and theme.Text or theme.TextMuted),
            Text                   = tostring(item.vote_count or 0),
            Parent                 = voteBtn,
        })

        -- center column; 76 = vote pill 64 + 12 gap, 122 right reservation keeps Action/Report off the truncating text
        local center = New("Frame", {
            Name             = "Center",
            Position         = UDim2.fromOffset(76, 0),
            Size             = UDim2.new(1, -76 - 122, 1, 0),
            BackgroundTransparency = 1,
            Parent           = row,
        })

        local nameLabel = New("TextLabel", {
            Name             = "Name",
            BackgroundTransparency = 1,
            Position         = UDim2.fromOffset(0, 0),
            Size             = UDim2.new(1, 0, 0, 22),
            Font             = Enum.Font.GothamBold,
            TextSize         = 15,
            TextColor3       = theme.Text,
            TextXAlignment   = Enum.TextXAlignment.Left,
            TextTruncate     = Enum.TextTruncate.AtEnd,
            Text             = item.name or tr("(unnamed)"),
            Parent           = center,
        })
        local _ = nameLabel

        New("TextLabel", {
            Name             = "Description",
            BackgroundTransparency = 1,
            Position         = UDim2.fromOffset(0, 22),
            Size             = UDim2.new(1, 0, 0, 18),
            Font             = Enum.Font.Gotham,
            TextSize         = 12,
            TextColor3       = theme.TextMuted,
            TextXAlignment   = Enum.TextXAlignment.Left,
            TextTruncate     = Enum.TextTruncate.AtEnd,
            Text             = item.description or "",
            Parent           = center,
        })

        New("TextLabel", {
            Name             = "Submitter",
            BackgroundTransparency = 1,
            Position         = UDim2.fromOffset(0, 42),
            Size             = UDim2.new(1, 0, 0, 14),
            Font             = Enum.Font.Gotham,
            TextSize         = 11,
            TextColor3       = theme.TextMuted,
            TextXAlignment   = Enum.TextXAlignment.Left,
            Text             = tr("by Discord:") .. shortDiscordId(item.discord_id) ..
                               "  ·  " .. tostring(item.game or ""),
            Parent           = center,
        })

        -- action button: "Download" when no local copy, "Delete Local" when one exists so we never silently overwrite
        local dlBtn = New("TextButton", {
            Name             = "Action",
            AnchorPoint      = Vector2.new(1, 0),
            Position         = UDim2.new(1, 0, 0, 0),
            Size             = UDim2.fromOffset(110, 32),
            BackgroundColor3 = theme.Accent,
            BorderSizePixel  = 0,
            Text             = tr("Download"),
            TextColor3       = Color3.new(1, 1, 1),
            Font             = Enum.Font.GothamBold,
            TextSize         = 13,
            AutoButtonColor  = false,
            Parent           = row,
        })
        Round(dlBtn, 6)

        -- report button opens the report modal seeded with this row's item
        local reportBtn = New("TextButton", {
            Name                   = "Report",
            AnchorPoint            = Vector2.new(1, 1),
            Position               = UDim2.new(1, 0, 1, 0),
            Size                   = UDim2.fromOffset(110, 18),
            BackgroundTransparency = 1,
            BorderSizePixel        = 0,
