        local okFetch, raw = pcall(function()
            return Game:HttpGet(url)
        end)
        if okFetch and type(raw) == "string" and raw ~= "" then return raw end

        local okReq, res = M.request({ Url = url, Method = "GET" })
        if not okReq or type(res) ~= "table" then
            return nil, ("fetch failed: %s"):format(tostring(okFetch and "empty body" or raw))
        end

        local status = readStatus(res)
        local body   = readBody(res)
        if status >= 200 and status < 300 and body and body ~= "" then return body end
        return nil, ("http %d"):format(status)
    end

    if not cfg then return once() end
    return backoffLoop(cfg, function()
        local body, err = once()
        return body ~= nil, body, err
    end)
