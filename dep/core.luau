    Error         = Color3.fromRGB(255, 80, 80),
}

-- one look per boot tier, so which build you launched is readable before the menu exists.
-- colour alone would be useless to a colour-blind reader, hence the badge as well. an
-- unknown/absent tier keeps the original green and shows no badge.
local Tiers = {
    premium = {
        Accent    = Color3.fromRGB(255, 196, 61),
        AccentDim = Color3.fromRGB(176, 124, 20),
        Badge     = "PREMIUM",
        BadgeText = Color3.fromRGB(24, 18, 4),
    },
    free = {
        Accent    = Color3.fromRGB(122, 162, 255),
        AccentDim = Color3.fromRGB(64, 94, 168),
        Badge     = "FREE",
        BadgeText = Color3.fromRGB(8, 12, 24),
    },
    dev = {
        Accent    = Color3.fromRGB(214, 112, 255),
        AccentDim = Color3.fromRGB(138, 62, 176),
        Badge     = "DEV BUILD",
        BadgeText = Color3.fromRGB(20, 6, 26),
    },
}

local GenericStatuses = {
    "Allocating memory resources...",
    "Verifying script integrity...",
    "Initializing core subsystems...",
    "Linking libraries...",
    "Optimizing environment...",
    "Registering callbacks...",
    "Loading configuration...",
    "Establishing hooks...",
    "Parsing runtime data...",
}

local function genericStatus()
    return GenericStatuses[math.random(1, #GenericStatuses)]
end

local M = {}
M.Theme = Theme

-- tier is resolved in pre-boot (Auth/Tier) and passed down through Utility/Debug
function M.new(tier)
    local skin = Tiers[tier] or {}
    local accent    = skin.Accent or Theme.Accent
    local accentDim = skin.AccentDim or Theme.AccentDim

    local self = {
        tier = tier,
        gui = nil, blur = nil, panelGroup = nil,
        statusLabel = nil, subtitleLabel = nil, progressFill = nil, percentLabel = nil,
        value = 0, target = 0,
        renderConn = nil,
        bootAdvance = 0,
        bootPhase = false,
        bootStartTime = 0,
        -- 9 tab mounts × 2 STEP events (Begin+Completed) + 1 final BOOT log
        bootExpectedSteps = 18,
        -- spread visible motion over at least this long so the bar never snaps to 95% then stalls
        bootMinSeconds = 1.6,
    }

    function self:_applyVisuals(r)
        if self.progressFill then
            self.progressFill.Size = UDim2.fromScale(r, 1)
        end
        if self.percentLabel then
            self.percentLabel.Text = string.format("%d%%", math.floor(r * 100 + 0.5))
        end
    end

    function self:_recomputeBootTarget()
        if not self.bootPhase then return end
        local stepRatio = math.min((self.bootAdvance or 0) / self.bootExpectedSteps, 1)
        local elapsed   = tick() - (self.bootStartTime or tick())
        local timeRatio = math.min(elapsed / self.bootMinSeconds, 1)
        local progress  = math.min(stepRatio, timeRatio) * 0.95
        if progress > (self.target or 0) then
            self.target = progress
        end
    end

    function self:_startLoop()
        if self.renderConn then return end
        -- scheduler:allow — boot ui, runs during pre-boot before any feature (or the scheduler's consumers) exist
        self.renderConn = RunService.RenderStepped:Connect(function(dt)
            self:_recomputeBootTarget()

            local current = self.value or 0
            local target  = self.target or 0
            if math.abs(current - target) < 0.0005 then
                if current ~= target then
                    self.value = target
                    self:_applyVisuals(target)
                end
                return
            end
            local alpha    = math.clamp(dt * 5, 0, 1)
            local newValue = current + (target - current) * alpha
            self.value = newValue
            self:_applyVisuals(newValue)
        end)
    end

    function self:_stopLoop()
        if self.renderConn then
            pcall(function() self.renderConn:Disconnect() end)
            self.renderConn = nil
        end
    end

    function self:notifyStep(stageText, rawMsg)
        if self.statusLabel then
            if stageText == "STEP" or stageText == "INFO" then
                self.statusLabel.Text = genericStatus()
            else
                if rawMsg:lower():find("module") then
                    self.statusLabel.Text = "Initializing module..."
                else
                    self.statusLabel.Text = rawMsg
                end
            end
        end

        if self.gui and self.gui.Parent and self.bootPhase then
            self.bootAdvance = self.bootAdvance + 1
            self:_recomputeBootTarget()
        end
    end

    function self:show()
        if self.gui and self.gui.Parent then return end

        local parent = UiHost.pick()
        if not parent then return end

        local screen = Instance.new("ScreenGui")
        screen.Name = "Loader"
        screen.ResetOnSpawn = false
        screen.IgnoreGuiInset = true
        screen.DisplayOrder = 9999
        screen.Parent = parent
        self.gui = screen

        self.value = 0
        self.target = 0
        self.bootAdvance = 0
        self.bootStartTime = tick()
        self.bootPhase = true
        self:_startLoop()

        local blur = Instance.new("BlurEffect")
        blur.Name = "LoaderBlur"
        blur.Size = 0
        blur.Parent = Lighting
        self.blur = blur

        local backdrop = Instance.new("Frame")
        backdrop.Size = UDim2.fromScale(1, 1)
        backdrop.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        backdrop.BackgroundTransparency = 1
        backdrop.BorderSizePixel = 0
        backdrop.Parent = screen

        local panel = Instance.new("CanvasGroup")
        panel.AnchorPoint = Vector2.new(0.5, 0.5)
        panel.Position = UDim2.fromScale(0.5, 0.55)
        -- 92% viewport width with a 500px cap so the panel doesn't clip on phones
        panel.Size = UDim2.new(0.92, 0, 0, 200)
        panel.BackgroundColor3 = Theme.Panel
        panel.BorderSizePixel = 0
        panel.GroupTransparency = 1
        panel.Parent = backdrop
        self.panelGroup = panel

        local panelCap = Instance.new("UISizeConstraint")
        panelCap.MaxSize = Vector2.new(500, math.huge)
        panelCap.Parent = panel

        local panelCorner = Instance.new("UICorner")
        panelCorner.CornerRadius = UDim.new(0, 10)
        panelCorner.Parent = panel

        local panelStroke = Instance.new("UIStroke")
        panelStroke.Thickness = 2
        panelStroke.Transparency = 0
        panelStroke.Parent = panel

        local strokeGrad = Instance.new("UIGradient")
        strokeGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,   accentDim),
            ColorSequenceKeypoint.new(0.5, accent),
            ColorSequenceKeypoint.new(1,   accentDim),
        })
        strokeGrad.Rotation = 45
        strokeGrad.Parent = panelStroke

        local title = Instance.new("TextLabel")
        title.BackgroundTransparency = 1
        title.Position = UDim2.fromOffset(24, 24)
        title.Size = UDim2.new(1, -48, 0, 26)
        title.Font = Enum.Font.GothamBold
        title.TextSize = 26
        title.TextColor3 = Theme.TextPrimary
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Text = "CERBERUS"
        title.Parent = panel

        -- tier badge, sized to its own text so "DEV BUILD" and "FREE" both sit flush right
        if skin.Badge then
            local badge = Instance.new("TextLabel")
            badge.Name = "TierBadge"
            badge.AnchorPoint = Vector2.new(1, 0)
            badge.Position = UDim2.new(1, -24, 0, 26)
            badge.AutomaticSize = Enum.AutomaticSize.X
            badge.Size = UDim2.fromOffset(0, 22)
            badge.BackgroundColor3 = accent
            badge.BorderSizePixel = 0
            badge.Font = Enum.Font.GothamBold
            badge.TextSize = 12
            badge.TextColor3 = skin.BadgeText or Theme.Background
            badge.Text = skin.Badge
            badge.Parent = panel

            local badgePad = Instance.new("UIPadding")
            badgePad.PaddingLeft  = UDim.new(0, 10)
            badgePad.PaddingRight = UDim.new(0, 10)
            badgePad.Parent = badge

            local badgeCorner = Instance.new("UICorner")
            badgeCorner.CornerRadius = UDim.new(1, 0)
            badgeCorner.Parent = badge
        end

        local sub = Instance.new("TextLabel")
        sub.BackgroundTransparency = 1
        sub.Position = UDim2.fromOffset(24, 54)
        sub.Size = UDim2.new(1, -48, 0, 18)
        sub.Font = Enum.Font.Gotham
        sub.TextSize = 13
        sub.TextColor3 = accent
        sub.TextXAlignment = Enum.TextXAlignment.Left
        sub.Text = "INITIALIZING ENVIRONMENT"
        sub.Parent = panel
        self.subtitleLabel = sub

        local status = Instance.new("TextLabel")
        status.BackgroundTransparency = 1
        status.Position = UDim2.fromOffset(24, 85)
        status.Size = UDim2.new(1, -48, 0, 40)
        status.Font = Enum.Font.Code
        status.TextSize = 13
        status.TextWrapped = true
        status.TextColor3 = Theme.TextSecondary
        status.TextXAlignment = Enum.TextXAlignment.Left
        status.TextYAlignment = Enum.TextYAlignment.Top
        status.Text = "Starting up..."
        status.Parent = panel
        self.statusLabel = status

        local progressBg = Instance.new("Frame")
        progressBg.Position = UDim2.new(0, 24, 1, -40)
        progressBg.Size = UDim2.new(1, -100, 0, 10)
        progressBg.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
        progressBg.BorderSizePixel = 0
        progressBg.Parent = panel

        local progressCorner = Instance.new("UICorner")
        progressCorner.CornerRadius = UDim.new(1, 0)
        progressCorner.Parent = progressBg

        local progressFill = Instance.new("Frame")
        progressFill.Size = UDim2.fromScale(0, 1)
        progressFill.BackgroundColor3 = accent
        progressFill.BorderSizePixel = 0
        progressFill.Parent = progressBg

        local fillGlow = Instance.new("UIStroke")
        fillGlow.Color = accent
        fillGlow.Transparency = 0.6
        fillGlow.Thickness = 3
        fillGlow.Parent = progressFill

        local fillCorner = Instance.new("UICorner")
        fillCorner.CornerRadius = UDim.new(1, 0)
        fillCorner.Parent = progressFill

        local fillGradient = Instance.new("UIGradient")
        fillGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, accentDim),
            ColorSequenceKeypoint.new(1, accent),
        })
        fillGradient.Parent = progressFill

        self.progressFill = progressFill

        local percent = Instance.new("TextLabel")
        percent.BackgroundTransparency = 1
        percent.Position = UDim2.new(1, -65, 1, -47)
        percent.Size = UDim2.fromOffset(50, 24)
        percent.Font = Enum.Font.GothamBold
        percent.TextSize = 16
        percent.TextColor3 = accent
        percent.TextXAlignment = Enum.TextXAlignment.Right
        percent.Text = "0%"
        percent.Parent = panel
        self.percentLabel = percent

        local animInfo = TweenInfo.new(0.6, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out)
        TweenService:Create(blur, animInfo, { Size = 15 }):Play()
        TweenService:Create(backdrop, animInfo, { BackgroundTransparency = 0.4 }):Play()
        TweenService:Create(panel, animInfo, {
            GroupTransparency = 0,
            Position = UDim2.fromScale(0.5, 0.5),
        }):Play()

        self.target = 0.02
    end

    function self:hide(onComplete)
        if not self.gui then
            if onComplete then pcall(onComplete) end
            return
        end

        local gui      = self.gui
        local blur     = self.blur
        local panel    = self.panelGroup
        local backdrop = gui:FindFirstChild("Frame")

        local animInfo = TweenInfo.new(0.8, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out)

        if blur then
            TweenService:Create(blur, animInfo, { Size = 0 }):Play()
        end
        if backdrop then
            TweenService:Create(backdrop, animInfo, { BackgroundTransparency = 1 }):Play()
        end
        if panel then
            TweenService:Create(panel, animInfo, {
                Position = UDim2.fromScale(0.5, 0.45),
                GroupTransparency = 1,
            }):Play()
            -- per-descendant fallback: some executors don't respect CanvasGroup transparency
            for _, desc in ipairs(panel:GetDescendants()) do
                if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                    -- background as well as text: it is a no-op for the labels that are already
                    -- transparent, and it is the whole fade for the ones that are filled (the tier
                    -- badge, the skip button), which would otherwise sit solid and then vanish
                    TweenService:Create(desc, animInfo,
                        { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
                elseif desc:IsA("ImageLabel") then
                    TweenService:Create(desc, animInfo, { ImageTransparency = 1 }):Play()
                elseif desc:IsA("UIStroke") then
                    TweenService:Create(desc, animInfo, { Transparency = 1 }):Play()
                elseif desc:IsA("Frame") then
                    TweenService:Create(desc, animInfo, { BackgroundTransparency = 1 }):Play()
                end
            end
        end

        -- leak:allow — completes a teardown; cancelling it at unload would strand the loader on screen
        task.delay(0.85, function()
            self:_stopLoop()
            if gui then gui:Destroy() end
            if blur then blur:Destroy() end

            if self.gui == gui then
                self.gui = nil
                self.blur = nil
                self.panelGroup = nil
                self.statusLabel = nil
                self.subtitleLabel = nil
                self.progressFill = nil
                self.percentLabel = nil
                self.value = 0
                self.target = 0
                self.bootAdvance = 0
                self.bootPhase = false
            end

            if onComplete then pcall(onComplete) end
        end)
    end

    -- translation phase: boot step driver is frozen so manual setProgress calls don't get clobbered

    function self:freezeBootProgress()
        self.bootPhase = false
    end

    function self:setStatus(text)
        if self.statusLabel then
            self.statusLabel.Text = tostring(text or "")
        end
    end

    function self:setSubtitle(text)
        if self.subtitleLabel then
            self.subtitleLabel.Text = tostring(text or "")
        end
    end

    function self:setProgress(ratio)
        if type(ratio) ~= "number" then return end
        self.target = math.clamp(ratio, 0, 1)
    end

    -- adds a skip button row below the bar; returns a remove function for when the queue drains
    function self:addSkipButton(label, onClick)
        if not (self.gui and self.panelGroup) then return function() end end
        local panel = self.panelGroup

        -- grow taller but keep scale-based width so mobile-safe sizing from show() survives
        if panel.Size.Y.Offset < 240 then
            panel.Size = UDim2.new(panel.Size.X.Scale, panel.Size.X.Offset, 0, 240)
        end

        -- percent label renders right where the skip button needs to live
        if self.percentLabel then
            self.percentLabel.Visible = false
        end

        -- lift the bar so the skip button gets its own row beneath it
        if self.progressFill and self.progressFill.Parent then
            local progressBg = self.progressFill.Parent
            progressBg.Position = UDim2.new(0, 24, 1, -64)
            progressBg.Size = UDim2.new(1, -48, 0, 10)
        end

        local btn = Instance.new("TextButton")
        btn.Name = "SkipButton"
        btn.AnchorPoint = Vector2.new(0.5, 1)
        btn.Position = UDim2.new(0.5, 0, 1, -16)
        btn.Size = UDim2.fromOffset(220, 28)
        btn.BackgroundColor3 = Color3.fromRGB(34, 34, 42)
        btn.BackgroundTransparency = 0
        btn.BorderSizePixel = 0
        btn.AutoButtonColor = false
        btn.Text = tostring(label or "Skip")
        btn.Font = Enum.Font.GothamSemibold
        btn.TextSize = 13
        btn.TextColor3 = Theme.TextPrimary
        btn.Parent = panel

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = btn

        local stroke = Instance.new("UIStroke")
        stroke.Color = accentDim
        stroke.Thickness = 1
        stroke.Transparency = 0.4
        stroke.Parent = btn

        local hoverInfo = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        btn.MouseEnter:Connect(function()
            TweenService:Create(btn, hoverInfo,
                { BackgroundColor3 = Color3.fromRGB(46, 46, 56) }):Play()
            TweenService:Create(stroke, hoverInfo, { Transparency = 0.1 }):Play()
        end)
        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, hoverInfo,
                { BackgroundColor3 = Color3.fromRGB(34, 34, 42) }):Play()
            TweenService:Create(stroke, hoverInfo, { Transparency = 0.4 }):Play()
        end)
        btn.MouseButton1Down:Connect(function()
            TweenService:Create(btn, hoverInfo,
                { BackgroundColor3 = Color3.fromRGB(28, 28, 36) }):Play()
        end)

        local fired = false
        btn.Activated:Connect(function()
            if fired then return end
            fired = true
            if onClick then pcall(onClick) end
        end)

        return function()
            if btn and btn.Parent then
                pcall(function() btn:Destroy() end)
            end
            if self.percentLabel then self.percentLabel.Visible = true end
            if self.progressFill and self.progressFill.Parent then
                local progressBg = self.progressFill.Parent
                progressBg.Position = UDim2.new(0, 24, 1, -40)
                progressBg.Size = UDim2.new(1, -100, 0, 10)
            end
        end
    end

    function self:finalize(onComplete)
        if self.statusLabel then
            self.statusLabel.Text = "Ready."
        end
        self.bootPhase = false
        self.target = 1

        -- wait for the lerp to reach 100%; onComplete fires post-fade so the main UI never appears over the loader
        Jobs.spawn(function(job)
            local deadline = tick() + 0.8
            while job.alive and tick() < deadline and (self.value or 0) < 0.995 do
                if not job:sleep() then return end
            end
            if not job:sleep(0.25) then return end
            self:hide(onComplete)
        end, { name = "LoaderFade" })
    end

    return self
end

return M

end)
