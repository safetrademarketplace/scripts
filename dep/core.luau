__bundle_register("Features/Player/Movement", function(require, _LOADED, __bundle_register, __bundle_modules)
-- movement orchestrator: wires Flight, Speed, Jump, ClickTp, ClickWalk, PositionRewind
local Mount          = require("Utility/Mount")
local Flight         = require("Features/Player/Movement/Flight")
local Speed          = require("Features/Player/Movement/Speed")
local Jump           = require("Features/Player/Movement/Jump")
local ClickTp        = require("Features/Player/Movement/ClickTp")
local ClickWalk      = require("Features/Player/Movement/ClickWalk")
local PositionRewind = require("Features/Player/Movement/PositionRewind")

return function(ctx)
    local O = Mount.orchestrator(ctx, "Movement")
    if not O then return end

    -- O.mount so a crashing sub-module factory can't take down siblings; manual onUnload stays since these expose stopX, not cleanup
    local subCtx = O.subCtx()
    local flightAPI    = O.mount(Flight, subCtx)
    local speedAPI     = O.mount(Speed, subCtx)
    local jumpAPI      = O.mount(Jump, subCtx)
    local clickTpAPI   = O.mount(ClickTp, subCtx)
    local clickWalkAPI = O.mount(ClickWalk, subCtx)
    local rewindAPI    = O.mount(PositionRewind, subCtx)

    local API = {
        startFlight       = flightAPI.startFlight,
        stopFlight        = flightAPI.stopFlight,
        startSpeed        = speedAPI.startSpeed,
        stopSpeed         = speedAPI.stopSpeed,
        startJumpMod      = jumpAPI.startJumpMod,
        stopJumpMod       = jumpAPI.stopJumpMod,
        startInfiniteJump = jumpAPI.startInfiniteJump,
        stopInfiniteJump  = jumpAPI.stopInfiniteJump,
        startClickTP      = clickTpAPI.startClickTP,
        stopClickTP       = clickTpAPI.stopClickTP,
        stopClickWalk     = clickWalkAPI.stopClickWalk,
        startRewind       = rewindAPI.startRewind,
        stopRewind        = rewindAPI.stopRewind,
    }

    O.onUnload(function()
        if API.stopClickWalk    then API.stopClickWalk() end
        if API.stopFlight       then API.stopFlight() end
        if API.stopSpeed        then API.stopSpeed(true) end
        if API.stopJumpMod      then API.stopJumpMod() end
        if API.stopInfiniteJump then API.stopInfiniteJump() end
        if API.stopClickTP      then API.stopClickTP() end
        if API.stopRewind       then API.stopRewind() end
    end)
    O.finalize()

    return API
end

end)
__bundle_register("Features/Player/Movement/PositionRewind", function(require, _LOADED, __bundle_register, __bundle_modules)
-- position rewind: ring buffer of HumanoidRootPart CFrames, hotkey snaps back n seconds (pair with ReplicationLag or anti-teleport rubber-bands you forward)
local Scheduler = require("Utility/Scheduler")

return function(ctx)
    local Services   = ctx.Services
    local Tabs       = ctx.Tabs
    local References = ctx.References
    local Library    = ctx.Library
    local Options    = ctx.Options
    local Toggles    = ctx.Toggles
    local track      = ctx.track

    local RewindGroup = Tabs.Player:AddLeftGroupbox("Position Rewind", "rewind")

    -- sized for worst-case slider settings (60s / 100ms); pre-allocated so the ring never grows once warm
    local MAX_BUFFER = 600

    local buffer = table.create(MAX_BUFFER)
    local head   = 1   -- next write index (1-based)
    local count  = 0

    local sampleConn         = nil
    local sampleAcc          = 0
    local pauseSamplingUntil = 0

    -- defaults only; live values re-read from Options every sample/rewind so the slider is authoritative
    local DEFAULT_REWIND_SECONDS = 5
    local DEFAULT_SAMPLE_MS      = 250
    local POST_REWIND_PAUSE      = 0.5  -- seconds

    local function sampleIntervalSec()
        local v = Options.RewindSampleMs and Options.RewindSampleMs.Value or DEFAULT_SAMPLE_MS
        return math.max(0.05, v / 1000)
    end

    local function rewindSeconds()
        return Options.RewindWindow and Options.RewindWindow.Value or DEFAULT_REWIND_SECONDS
    end

    local function clearBuffer()
        for i = 1, MAX_BUFFER do buffer[i] = nil end
        head  = 1
        count = 0
    end

    local function sample()
        local hrp = References.humanoidRootPart
        if not hrp then return end
        -- reuse the entry table to avoid gc pressure on the steady-state ring
        local entry = buffer[head] or {}
        entry.cf = hrp.CFrame
        entry.t  = os.clock()
        buffer[head] = entry
        head = (head % MAX_BUFFER) + 1
        if count < MAX_BUFFER then count = count + 1 end
    end

    -- newest entry with timestamp <= targetTime, or nil if the buffer doesn't reach that far back
    local function findEntryAtOrBefore(targetTime)
        for i = 1, count do
            local idx = ((head - 1 - i) % MAX_BUFFER) + 1
            local entry = buffer[idx]
            if entry and entry.t <= targetTime then return entry end
        end
        return nil
    end

    local function oldestEntry()
        if count == 0 then return nil end
        if count < MAX_BUFFER then
            return buffer[1]  -- ring hasn't wrapped yet
        end
        return buffer[(head % MAX_BUFFER) + 1]  -- wrapped: oldest is just past head
    end

    local function rewind()
        local hrp = References.humanoidRootPart
        if not hrp then
            Library:Notify("Position Rewind: no character.", 2)
            return
        end
        if count == 0 then
            Library:Notify("Position Rewind: nothing buffered yet.", 2)
            return
        end

        local target = os.clock() - rewindSeconds()
        local entry  = findEntryAtOrBefore(target) or oldestEntry()
        if not entry then return end

        hrp.CFrame = entry.cf
        -- zero velocities so we don't keep falling/spinning on landing (angular guards mid-ragdoll rewinds)
        pcall(function()
            hrp.AssemblyLinearVelocity  = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)

        -- pause sampling briefly or the next Heartbeat overwrites good entries and a second rewind lands on the same spot
        pauseSamplingUntil = os.clock() + POST_REWIND_PAUSE
    end

    local function startRewind()
        if sampleConn then return end
        sampleAcc = 0
        -- own accumulator, not the lane interval: the sample rate is slider-driven and changes mid-run
        sampleConn = track(Scheduler.heartbeat(function(dt)
            if os.clock() < pauseSamplingUntil then return end
            sampleAcc = sampleAcc + dt
            if sampleAcc < sampleIntervalSec() then return end
            sampleAcc = 0
            sample()
        end, { name = "PositionRewind" }))
    end

    local function stopRewind()
        if sampleConn then
            sampleConn:Disconnect()
            sampleConn = nil
        end
        clearBuffer()
    end

    -- wipe the ring on respawn — rewinding to the death spot is a footgun
    track(References.player.CharacterAdded:Connect(function()
        clearBuffer()
        sampleAcc = 0
    end))

    RewindGroup:AddToggle("RewindEnabled", {
        Text    = "Position Rewind",
        Default = false,
        Tooltip = "Press the rewind key to jump back to where you were a few seconds ago. Useful for falls, punts, and failed parkour.",
    })

    local RewindBox = RewindGroup:AddDependencyBox()

    RewindBox:AddLabel({
        Text     = "<b>Tip:</b> Enable <b>Replication Lag</b> in Player Utils so the server accepts the rewind instead of snapping you forward.",
        DoesWrap = true,
    })

    RewindBox:AddSlider("RewindWindow", {
        Text     = "Rewind Window",
        Default  = DEFAULT_REWIND_SECONDS,
        Min      = 1,
        Max      = 30,
        Rounding = 0,
        Suffix   = "s",
        Tooltip  = "How many seconds back the rewind key takes you.",
    })

    RewindBox:AddSlider("RewindSampleMs", {
        Text     = "Sample Interval",
        Default  = DEFAULT_SAMPLE_MS,
        Min      = 100,
        Max      = 1000,
        Rounding = 0,
        Suffix   = "ms",
        Tooltip  = "How often your position is recorded. Lower = more precise rewinds at the cost of a tiny bit more work each frame. Default 250ms is plenty.",
    })

    -- KeyPicker has no fire-on-press callback, so stash the key via ChangedCallback and match in InputBegan; init from Enum because ChangedCallback only fires on user interaction
    local rewindKey = Enum.KeyCode.R
    RewindBox:AddLabel("Rewind Key"):AddKeyPicker("RewindKey", {
        Default          = "R",
        SyncToggleState  = false,
        Mode             = "Toggle",
        Text             = "Rewind Now",
        NoUI             = false,
        ChangedCallback  = function(k) rewindKey = k end,
    })

    RewindBox:SetupDependencies({
        { Toggles.RewindEnabled, true },
    })

    Toggles.RewindEnabled:OnChanged(function()
        if Toggles.RewindEnabled.Value then startRewind() else stopRewind() end
    end)

    track(Services.UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if not (Toggles.RewindEnabled and Toggles.RewindEnabled.Value) then return end
        if not rewindKey then return end
        if input.KeyCode == rewindKey or input.UserInputType == rewindKey then
            rewind()
        end
    end))

    return { startRewind = startRewind, stopRewind = stopRewind, rewind = rewind }
end

end)
__bundle_register("Features/Player/Movement/ClickWalk", function(require, _LOADED, __bundle_register, __bundle_modules)
-- click-to-walk sub-module of movement (pathfinding beacon walker)
local Scheduler = require("Utility/Scheduler")

return function(ctx)
    local Services   = ctx.Services
    local Tabs       = ctx.Tabs
    local References = ctx.References
    local Library    = ctx.Library
    local Options    = ctx.Options
    local Toggles    = ctx.Toggles
    local track      = ctx.track

    local CTWGroup = Tabs.Player:AddLeftGroupbox("Click To Walk", "mouse-pointer")

    CTWGroup:AddToggle("ClickToWalk", {
        Text = "Enable Click To Walk",
        Default = false
    })

    local CTWBox = CTWGroup:AddDependencyBox()

    CTWBox:AddSlider("CTW_Speed", {
        Text = "Walk Speed",
        Default = 16,
        Min = 8,
        Max = 300,
        Rounding = 0,
        Suffix = " studs/s"
    })

    CTWBox:SetupDependencies({
        { Toggles.ClickToWalk, true },
    })

    local MAX_HOP_DISTANCE = 700
    local MIN_REPATH_INTERVAL = 0.3
    local lastComputeAt = 0

    local clickConn, moveConn, blockedConn, spinConn
    local pathObj
    local segmentFolder
    local beaconFolder
    local currentDest
    local checkpoints = nil
    local segIndex = 0

    local isClickMoving = false
    local origWalkSpeed = nil
    local interruptConns = {}

    local function applyCTWSpeed()
        local hum = References.humanoid
        if not hum then return end
        if origWalkSpeed == nil then origWalkSpeed = hum.WalkSpeed end
        hum.WalkSpeed = Options.CTW_Speed.Value
    end

    local function restoreWalkSpeed()
        local hum = References.humanoid
        if hum and origWalkSpeed ~= nil then hum.WalkSpeed = origWalkSpeed end
        origWalkSpeed = nil
    end

    local function fadeAndDestroy(folder)
        if not folder then return end
        for _, inst in ipairs(folder:GetDescendants()) do
            if inst:IsA("BasePart") then
                Services.TweenService:Create(inst, TweenInfo.new(0.25), {
                    Transparency = 1
                }):Play()
            end
        end
        -- leak:allow — completes a teardown; cancelling it at unload would orphan the beacon folder
        task.delay(0.3, function()
            pcall(function()
                if folder then folder:Destroy() end
            end)
        end)
    end

    local function clearBeacon()
        if spinConn then spinConn:Disconnect(); spinConn = nil end
        if beaconFolder then fadeAndDestroy(beaconFolder); beaconFolder = nil end
    end

    local function clearPathViz()
        if segmentFolder then fadeAndDestroy(segmentFolder); segmentFolder = nil end
    end

    local function clearAllViz()
        clearBeacon()
        clearPathViz()
    end

    local function haltHumanoidMotion()
        local hum, root = References.humanoid, References.humanoidRootPart
        if hum then
            pcall(function()
                if root then hum:MoveTo(root.Position) end
            end)
            pcall(function() hum:Move(Vector3.zero) end)
        end
    end

    local function disconnectMovePathConns()
        if moveConn then moveConn:Disconnect(); moveConn = nil end
        if blockedConn then blockedConn:Disconnect(); blockedConn = nil end
        pathObj = nil
    end

    local function disconnectInterrupts()
        for k, c in pairs(interruptConns) do
            if c then c:Disconnect() end
            interruptConns[k] = nil
        end
    end

    local function cancelActiveWalk()
        if not isClickMoving then
            clearAllViz()
            disconnectMovePathConns()
            restoreWalkSpeed()
            disconnectInterrupts()
            currentDest, checkpoints, segIndex = nil, nil, 0
            return
        end

        isClickMoving = false
        haltHumanoidMotion()
        clearAllViz()
        disconnectMovePathConns()
        restoreWalkSpeed()
        disconnectInterrupts()
        currentDest, checkpoints, segIndex = nil, nil, 0
    end

    local function stopClickWalk()
        cancelActiveWalk()
        if clickConn then clickConn:Disconnect(); clickConn = nil end
    end

    local function createBeacon(pos)
        clearBeacon()

        beaconFolder = Instance.new("Folder")
        beaconFolder.Name = "Beacon"
        beaconFolder.Parent = Services.Workspace

        local pillar = Instance.new("Part")
        pillar.Name = "Pillar"
        pillar.Anchored, pillar.CanCollide = true, false
        pillar.Material = Enum.Material.Neon
        pillar.Color = Color3.fromRGB(55, 235, 120)
        pillar.Size = Vector3.new(0.25, 12, 0.25)
        pillar.CFrame = CFrame.new(pos + Vector3.new(0, pillar.Size.Y / 2, 0))
        pillar.Parent = beaconFolder

        local ring = Instance.new("Part")
        ring.Name = "Ring"
        ring.Shape = Enum.PartType.Cylinder
        ring.Anchored, ring.CanCollide = true, false
        ring.Material = Enum.Material.Neon
        ring.Color = Color3.fromRGB(55, 235, 120)
        ring.Size = Vector3.new(2, 0.2, 2)
        ring.CFrame = CFrame.new(pos) * CFrame.Angles(math.rad(90), 0, 0)
        ring.Parent = beaconFolder

        local glow = Instance.new("Part")
        glow.Name = "Glow"
        glow.Anchored, glow.CanCollide = true, false
        glow.Material = Enum.Material.Neon
        glow.Color = Color3.fromRGB(55, 235, 120)
        glow.Transparency = 0.5
        glow.Size = Vector3.new(1.5, 0.15, 1.5)
        glow.CFrame = CFrame.new(pos + Vector3.new(0, 0.05, 0))
        glow.Parent = beaconFolder

        Services.TweenService:Create(ring,
            TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, -1, true), {
                Size = Vector3.new(6, ring.Size.Y, 6)
            }):Play()
        Services.TweenService:Create(pillar,
            TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
                Transparency = 0.25
            }):Play()

        local theta = 0
        spinConn = track(Scheduler.heartbeat(function(dt)
            if not ring or not ring.Parent then return end
            theta = theta + dt * math.pi / 2
            ring.CFrame = CFrame.new(pos) * CFrame.Angles(math.rad(90), theta, 0)
        end, { name = "ClickWalkBeacon", priority = 200, deferrable = true }))
    end

    local function drawPath(waypoints)
        clearPathViz()

        segmentFolder = Instance.new("Folder")
        segmentFolder.Name = "PathContainer"
        segmentFolder.Parent = Services.Workspace

        for i = 1, #waypoints do
            local wp = Instance.new("Part")
            wp.Name = "Waypoint"
            wp.Anchored, wp.CanCollide = true, false
            wp.Material = Enum.Material.Neon
            wp.Color = Color3.fromRGB(55, 235, 120)
            wp.Size = Vector3.new(0.35, 0.35, 0.35)
            wp.Shape = Enum.PartType.Ball
            wp.CFrame = CFrame.new(waypoints[i].Position + Vector3.new(0, 0.15, 0))
            wp.Parent = segmentFolder
        end

        for i = 1, #waypoints - 1 do
            local a, b = waypoints[i].Position, waypoints[i + 1].Position
            local seg = Instance.new("Part")
            seg.Name = "Segment"
            seg.Anchored, seg.CanCollide = true, false
            seg.Material = Enum.Material.Neon
            seg.Color = Color3.fromRGB(55, 235, 120)
            seg.Size = Vector3.new(0.15, 0.15, (a - b).Magnitude)
            seg.CFrame = CFrame.new((a + b) / 2, b)
            seg.Transparency = 1
            seg.Parent = segmentFolder
            Services.TweenService:Create(seg, TweenInfo.new(0.2), {
                Transparency = 0
            }):Play()
        end
    end

    local function buildCheckpoints(startPos, dest)
        local delta = dest - startPos
        local dist = delta.Magnitude
        if dist < 1 then return { dest } end
        local dir = delta.Unit
        local pts, covered = {}, 0
        while covered + MAX_HOP_DISTANCE < dist do
            covered = covered + MAX_HOP_DISTANCE
            pts[#pts + 1] = startPos + dir * covered
        end
        pts[#pts + 1] = dest
        return pts
    end

    local function safeCompute(path, a, b)
        local now = os.clock()
        local waitLeft = MIN_REPATH_INTERVAL - (now - lastComputeAt)
        if waitLeft > 0 then task.wait(waitLeft) end
        lastComputeAt = os.clock()
        local ok, err = pcall(function() path:ComputeAsync(a, b) end)
        if not ok then return false, err end
        return true
    end

    local function wireInterrupts()
        disconnectInterrupts()

        interruptConns.WASD = track(Services.UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            local kc = input.KeyCode
            if kc == Enum.KeyCode.W or kc == Enum.KeyCode.A or kc == Enum.KeyCode.S or kc == Enum.KeyCode.D then
                cancelActiveWalk()
            end
        end))

        interruptConns.GP = track(Services.UserInputService.InputChanged:Connect(function(input, gp)
            if gp then return end
            if input.UserInputType == Enum.UserInputType.Gamepad1
                and input.KeyCode == Enum.KeyCode.Thumbstick1 then
                if input.Position.Magnitude > 0.15 then cancelActiveWalk() end
            end
        end))

        interruptConns.RMB = track(Services.UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.UserInputType == Enum.UserInputType.MouseButton2 then
                cancelActiveWalk()
            end
        end))

        if References.player then
            interruptConns.CharAdded = track(References.player.CharacterAdded:Connect(function()
                cancelActiveWalk()
            end))
        end

        local hum = References.humanoid
        if hum then
            interruptConns.Died = track(hum.Died:Connect(cancelActiveWalk))
            interruptConns.Seated = track(hum.Seated:Connect(function(active)
                if active then cancelActiveWalk() end
            end))
            interruptConns.Ancestry = track(hum.AncestryChanged:Connect(function(_, parent)
                if parent == nil then cancelActiveWalk() end
            end))
        end
    end

    local function computeSegmentAndWalk(segStart, segEnd)
        if not isClickMoving then return end

        local p = Services.PathfindingService:CreatePath({
            AgentRadius = 2,
            AgentHeight = 5,
            AgentCanJump = true,
            WaypointSpacing = 4
        })
        pathObj = p

        local ok = safeCompute(p, segStart, segEnd)
        if not ok or p.Status ~= Enum.PathStatus.Success then
            local half = segStart:Lerp(segEnd, 0.5)
            ok = safeCompute(p, segStart, half)
            if not ok or p.Status ~= Enum.PathStatus.Success then
                Library:Notify("Unable to compute path.", 3)
                cancelActiveWalk()
                return
            else
                if checkpoints then
                    table.insert(checkpoints, segIndex, half)
                end
            end
        end

        if not isClickMoving then return end

        local wps = p:GetWaypoints()
        if #wps == 0 then
            Library:Notify("No waypoints for this segment.", 3)
            cancelActiveWalk()
            return
        end
        drawPath(wps)

        if blockedConn then blockedConn:Disconnect(); blockedConn = nil end
        blockedConn = track(p.Blocked:Connect(function()
            if not isClickMoving then return end
            local root = References.humanoidRootPart
            if root and currentDest and checkpoints then
                computeSegmentAndWalk(root.Position, checkpoints[segIndex])
            end
        end))

        if moveConn then moveConn:Disconnect(); moveConn = nil end
        local i = 1
        local hum = References.humanoid
        if not hum then cancelActiveWalk(); return end

        hum:MoveTo(wps[i].Position)
        moveConn = track(hum.MoveToFinished:Connect(function(reached)
            if not isClickMoving then return end
            if pathObj ~= p then return end

            if not reached then
                local root = References.humanoidRootPart
                if root and checkpoints then
                    computeSegmentAndWalk(root.Position, checkpoints[segIndex])
                else
                    cancelActiveWalk()
                end
                return
            end

            i = i + 1
            if wps[i] then
                hum:MoveTo(wps[i].Position)
            else
                segIndex = segIndex + 1
                if checkpoints and checkpoints[segIndex] then
                    local root = References.humanoidRootPart
                    if root then
                        computeSegmentAndWalk(root.Position, checkpoints[segIndex])
                    else
                        cancelActiveWalk()
                    end
                else
                    cancelActiveWalk()
                end
            end
        end))
    end

    local function startClickListener()
        if clickConn then return end
        clickConn = track(Services.UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end

            local mouse = References.player and References.player:GetMouse()
            if not mouse or not mouse.Hit then return end
            local dest = mouse.Hit.Position

            if isClickMoving then cancelActiveWalk() end

            currentDest = dest
            clearAllViz()
            createBeacon(dest)

            local root = References.humanoidRootPart
            local hum = References.humanoid
            if not (root and hum) then cancelActiveWalk(); return end

            isClickMoving = true
            applyCTWSpeed()
            wireInterrupts()

            checkpoints = buildCheckpoints(root.Position, dest)
            segIndex = 1
            computeSegmentAndWalk(root.Position, checkpoints[segIndex])
        end))
    end

    Toggles.ClickToWalk:OnChanged(function()
        if Toggles.ClickToWalk.Value then startClickListener() else stopClickWalk() end
    end)

    Options.CTW_Speed:OnChanged(function(v)
        if isClickMoving and References.humanoid then
            References.humanoid.WalkSpeed = v
        end
    end)

    return { stopClickWalk = stopClickWalk }
end

end)
