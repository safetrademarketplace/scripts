    local TeleportsGroupbox = Tabs.Navigation:AddLeftGroupbox("Teleports", "move-3d")
    local WaypointsGroupbox = Tabs.Navigation:AddRightGroupbox("Waypoints Editor", "pencil")

    TeleportsGroupbox:AddDropdown("TP_TravelMode", {
        Text = "Travel Mode",
        Values = { "Teleport", "Flight" },
        Default = "Teleport",
    })

    local TravelSpeedBox = TeleportsGroupbox:AddDependencyBox()
    TravelSpeedBox:AddSlider("TP_TravelSpeed", {
        Text = "Flight Speed",
        Default = 250, Min = 50, Max = 1000, Rounding = 0, Suffix = " studs/s",
    })
    TravelSpeedBox:SetupDependencies({
        { Options.TP_TravelMode, "Flight" },
    })

    TeleportsGroupbox:AddToggle("TP_SafetyMode", {
        Text = "Safety Mode",
        Default = false,
        Tooltip = "Teleportion will be blocked if a player is within Safety Range, and flight travel will occur at Travelling Height.",
    })

    local SafetyBox = TeleportsGroupbox:AddDependencyBox()
    SafetyBox:AddSlider("TP_SafetyRange", {
        Text = "Safety Range",
        Default = 50, Min = 10, Max = 250, Rounding = 0, Suffix = " studs",
    })
    SafetyBox:AddSlider("TP_TravelHeight", {
        Text = "Travelling Height",
        Default = -50, Min = -500, Max = 500, Rounding = 0, Suffix = " studs",
    })
    SafetyBox:SetupDependencies({
        { Toggles.TP_SafetyMode, true },
    })

    local current = catByKey["Players"] or categories[1]
    local currentValue = current.label or current.key

    local function currentType()
        return current and (current.type or current.key)
    end

    local function isWaypoints()
        return currentType() == "waypoints"
    end

    Engine.scan(current)
    local names = Engine.namesFor(current)
    local selected = names[1]

    local ddCat = TeleportsGroupbox:AddDropdown("TP_Category", {
        Text = "Category", Values = catValues, Default = currentValue,
    })
    local ddLoc = TeleportsGroupbox:AddDropdown("TP_Location", {
        Text = "Select Location", Values = names, Default = selected,
        Searchable = true,
    })

    local function refreshList(preserve)
        local prev = preserve and ddLoc.Value or selected
        Engine.scan(current)
        names = Engine.namesFor(current)

        if #names == 0 then
            selected = nil
            ddLoc:SetValues({})
            ddLoc:SetValue(nil)
            return
        end
        if prev and table.find(names, prev) then
            selected = prev
        else
            selected = names[1]
        end
        ddLoc:SetValues(names)
        ddLoc:SetValue(selected)
    end

    ddCat:OnChanged(function(v)
        current = catByValue[v] or catByKey[v] or current
        refreshList(false)
    end)
    ddLoc:OnChanged(function(v) selected = v end)

    local function PerformTeleport(targetName)
        if not References.humanoidRootPart then
            return Library:Notify("No character.", 3)
        end

        -- rescan non-waypoint categories so positions reflect the world now, not the last dropdown refresh
        if not isWaypoints() then
            Engine.scan(current)
            if Waypoints.list[targetName] then
                Engine.tpMap[targetName] = Waypoints.list[targetName]
            end
        end

        local p = Engine.tpMap[targetName]
        if not p then return Library:Notify("Invalid destination: " .. tostring(targetName), 3) end

        if Toggles.TP_SafetyMode and Toggles.TP_SafetyMode.Value then
            local inRange, who = Engine.isPlayerNear(p, Options.TP_SafetyRange.Value)
            if inRange then
                local nm = (who and ((who.DisplayName ~= "" and who.DisplayName) or who.Name)) or "a player"
                return Library:Notify(("Safety Mode: %s is within %d studs of the destination. Aborting.")
                    :format(nm, tonumber(Options.TP_SafetyRange.Value) or 0), 5)
            end
        end

        if Options.TP_TravelMode.Value == "Teleport" then
            References.humanoidRootPart.CFrame = CFrame.new(p + Vector3.new(0, 3, 0))
        else
            local spd = math.max(10, Options.TP_TravelSpeed.Value or 250)
            if Toggles.TP_SafetyMode and Toggles.TP_SafetyMode.Value then
                local heightY = tonumber(Options.TP_TravelHeight.Value) or (References.humanoidRootPart.Position.Y + 100)
                Engine.flyViaAltitude(p, heightY, spd)
            else
                Engine.stopActiveMove()
                Engine.setMoveCleanup(deps.Helpers.MoveToPos(p + Vector3.new(0, 3, 0), spd))
            end
        end
    end

    TeleportsGroupbox:AddButton({
        Text = "Teleport",
        Func = function()
            local choice = ddLoc.Value or selected
            if not choice then return Library:Notify("No destination selected.", 3) end
            PerformTeleport(choice)
        end,
    })

    TeleportsGroupbox:AddButton({
        Text = "Refresh",
        Func = function() refreshList(true) end,
    })

    WaypointsGroupbox:AddInput("TP_WP_Name", {
        Text = "Waypoint Name",
        Placeholder = "My Waypoint",
        ClearTextOnFocus = false,
        Finished = false,
    })

    WaypointsGroupbox:AddButton({
        Text = "Add Waypoint",
        Tooltip = "Adds a waypoint at your current location you can teleport too later.",
        Func = function()
            if not References.humanoidRootPart then return Library:Notify("No character.", 3) end

            local base = Str.trim(tostring(Options.TP_WP_Name.Value or ""))
            if base == "" then base = "Waypoint" end

            local name = base
            if Waypoints.list[name] ~= nil then
                local used = {}; for _, n in ipairs(Waypoints.order) do used[n] = true end
                name = uniq(used, base)
            end

            Waypoints.list[name] = References.humanoidRootPart.Position
            Waypoints.order[#Waypoints.order + 1] = name
            Waypoints.save()

            if isWaypoints() then
                refreshList(true)
                ddLoc:SetValue(name)
                selected = name
            end

            Library:Notify("Added waypoint: " .. name, 3)
        end,
    })

    WaypointsGroupbox:AddButton({
        Text = "Remove Waypoint",
        Tooltip = "Removes the currently selected waypoint.",
        Func = function()
            if not isWaypoints() then return Library:Notify("Switch to Waypoints to remove.", 3) end
            local choice = ddLoc.Value or selected
            if not choice or not Waypoints.list[choice] then return Library:Notify("Select a waypoint to remove.", 3) end

            Waypoints.list[choice] = nil
            Waypoints.keybinds[choice] = nil
            for i = #Waypoints.order, 1, -1 do
                if Waypoints.order[i] == choice then table.remove(Waypoints.order, i) end
            end
            Waypoints.save()
            refreshList(true)
            Library:Notify("Removed waypoint: " .. choice, 3)
        end,
    })

    WaypointsGroupbox:AddDivider()
    WaypointsGroupbox:AddLabel("Keybind Manager")

    WaypointsGroupbox:AddToggle("TP_EnableKeybinds", {
        Text = "Enable Waypoint Keybinds",
        Default = true,
        Tooltip = "Globally enables or disables hotkeys for waypoints.",
    })

    WaypointsGroupbox:AddLabel("Key to Assign:"):AddKeyPicker("TP_Binder", {
        Default = "None",
        SyncToggleState = false,
        Mode = "Toggle",
        Text = "Binder",
        NoUI = true,
    })

    local function getKeybindLabel()
        local choice = ddLoc.Value or selected
        if isWaypoints() and choice and Waypoints.keybinds[choice] then
            return "Current Bind: " .. tostring(normalizeBindKey(Waypoints.keybinds[choice]))
        end
        return "Current Bind: None"
    end

    local lbBindStatus = WaypointsGroupbox:AddLabel(getKeybindLabel())

    ddLoc:OnChanged(function(v)
        selected = v
        lbBindStatus:SetText(getKeybindLabel())
    end)

    WaypointsGroupbox:AddButton({
        Text = "Assign Key to Selected",
        Tooltip = "Assigns the key set in 'Binder' to the currently selected waypoint.",
        Func = function()
            if not isWaypoints() then return Library:Notify("Can only assign binds to Waypoints.", 3) end
            local choice = ddLoc.Value or selected
            if not choice then return Library:Notify("No waypoint selected.", 3) end

            local key = normalizeBindKey(Options.TP_Binder.Value)
            if key == "None" or key == nil then return Library:Notify("Please press a key in the binder first.", 3) end

            Waypoints.keybinds[choice] = key
            Waypoints.save()
            lbBindStatus:SetText(getKeybindLabel())
            Library:Notify(string.format("Bound [%s] to '%s'", key, choice), 3)
        end,
    })

    WaypointsGroupbox:AddButton({
        Text = "Clear Keybind (Selected)",
        Func = function()
            if not isWaypoints() then return end
            local choice = ddLoc.Value or selected
            if choice and Waypoints.keybinds[choice] then
                Waypoints.keybinds[choice] = nil
                Waypoints.save()
                lbBindStatus:SetText(getKeybindLabel())
                Library:Notify("Cleared bind for " .. choice, 3)
            end
        end,
    })

    local function doClearAllKeybinds()
        if next(Waypoints.keybinds) == nil then return Library:Notify("No keybinds to clear.", 3) end
        for k in pairs(Waypoints.keybinds) do Waypoints.keybinds[k] = nil end
        Waypoints.save()
        lbBindStatus:SetText(getKeybindLabel())
        Library:Notify("All waypoint keybinds have been cleared.", 3)
    end

    WaypointsGroupbox:AddButton({
        Text = "Clear All Keybinds",
        Func = function()
            if next(Waypoints.keybinds) == nil then return Library:Notify("No keybinds to clear.", 3) end
            if Window and Window.AddDialog then
                Window:AddDialog("WaypointsClearAllKeybindsDialog", {
                    Title = "Clear Every Waypoint Hotkey?",
                    Description = "This will remove every key you have set for jumping to a waypoint. Your waypoints themselves will stay.",
                    AutoDismiss = true,
                    OutsideClickDismiss = true,
                    FooterButtons = {
                        Cancel = {
                            Title = "Keep My Hotkeys",
                            Variant = "Ghost",
                            Order = 1,
                            Callback = function() end,
                        },
                        Confirm = {
                            Title = "Clear All",
                            Variant = "Destructive",
                            Order = 2,
                            Callback = doClearAllKeybinds,
                        },
                    },
                })
            else
                doClearAllKeybinds()
            end
        end,
    })

    moduleMaid:GiveTask(Services.UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if not Toggles.TP_EnableKeybinds or not Toggles.TP_EnableKeybinds.Value then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            local keyPressed = input.KeyCode.Name
            for wpName, bindKey in pairs(Waypoints.keybinds) do
                if normalizeBindKey(bindKey) == keyPressed then
                    PerformTeleport(wpName)
                    return
                end
            end
        end
    end))
end

end)
__bundle_register("Features/Navigation/Teleports/Engine", function(require, _LOADED, __bundle_register, __bundle_modules)
-- teleport engine: category scanning (players/entities/npcs/waypoints) plus teleport/flight-travel execution

local VMath     = require("Utility/Helpers/VMath")
local tbl_to_v3 = require("Features/Navigation/Teleports/Waypoints").tbl_to_v3

local M = {}

local function uniq(used, base)
    local k, n = base, 1
    while used[k] do
        n = n + 1
        k = ("%s (%d)"):format(base, n)
    end
    used[k] = true
    return k
end

function M.new(opts)
    local Services   = opts.Services
    local References = opts.References
    local Helpers    = opts.Helpers
    local Waypoints  = opts.Waypoints

    local tpMap = {}
    local activeMoveCleanup = nil
    local alive = true

    local function stopActiveMove()
        if activeMoveCleanup then
            pcall(activeMoveCleanup)
            activeMoveCleanup = nil
        end
    end

    -- full rebuild every scan: positions drift per tick, staleness is worse
    local function scan(category)
        table.clear(tpMap)
        if type(category.scan) == "function" then
            local ok, result = pcall(category.scan, {
                Services   = Services,
                References = References,
                Helpers    = Helpers,
                Waypoints  = { list = Waypoints.list, order = Waypoints.order, keybinds = Waypoints.keybinds },
            })
            if ok and type(result) == "table" then
                for k, v in pairs(result) do
                    if type(k) == "string" then
                        local pos = tbl_to_v3(v)
                        if pos then tpMap[k] = pos end
                    elseif type(v) == "table" then
                        local name = v.name or v.label or v[1]
                        local pos = tbl_to_v3(v.position or v.pos or v[2])
                        if type(name) == "string" and pos then
                            tpMap[name] = pos
                        end
                    end
                end
            end
            return
        end

        local ctype = category.type or category.key
        local localUserId = References.player and References.player.UserId
        if ctype == "players" then
            local used = {}
            for _, pl in ipairs(Services.Players:GetPlayers()) do
                if pl.UserId ~= localUserId then
                    local ch = pl.Character
                    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local base = (pl.DisplayName ~= "" and pl.DisplayName) or pl.Name
                        tpMap[uniq(used, base)] = hrp.Position
                    end
                end
            end
        elseif ctype == "entities" then
            -- any non-player Model with a Humanoid anywhere in workspace
            local used, seen = {}, {}
            for _, d in ipairs(Services.Workspace:GetDescendants()) do
                if d:IsA("Humanoid") then
                    local m = d.Parent
                    if m and m:IsA("Model") and not seen[m] then
                        seen[m] = true
                        if not Services.Players:GetPlayerFromCharacter(m) then
                            local pos
                            local ok, piv = pcall(m.GetPivot, m)
                            if ok and typeof(piv) == "CFrame" then pos = piv.Position end
                            if not pos then
                                local hrp = m:FindFirstChild("HumanoidRootPart")
                                    or m:FindFirstChildWhichIsA("BasePart")
                                pos = hrp and hrp.Position
                            end
                            if pos then
                                local dn = m:FindFirstChild("DisplayName")
                                local name = (dn and dn:IsA("StringValue") and dn.Value) or m.Name or "Entity"
                                tpMap[uniq(used, name)] = pos
                            end
                        end
                    end
                end
            end
        elseif ctype == "npcs" then
            local folder = Services.Workspace:FindFirstChild("NPCs")
            if not folder then return end
            local used = {}
            for _, npc in ipairs(folder:GetChildren()) do
                if npc:IsA("Model") then
                    local pos
                    local ok, piv = pcall(npc.GetPivot, npc)
                    if ok and typeof(piv) == "CFrame" then pos = piv.Position end
                    if not pos then
                        local hrp = npc:FindFirstChild("HumanoidRootPart")
                            or npc:FindFirstChildWhichIsA("BasePart")
                        pos = hrp and hrp.Position
                    end
                    if pos then
                        local name = npc.Name or "NPC"
                        tpMap[uniq(used, name)] = pos
                    end
                end
            end
        elseif ctype == "waypoints" then
            for i = 1, #Waypoints.order do
                local k = Waypoints.order[i]
                local v = Waypoints.list[k]
                if v then tpMap[k] = v end
            end
        end
    end

    local function namesFor(category)
        local t = {}
        local ctype = category.type or category.key
        if ctype == "waypoints" then
            for i = 1, #Waypoints.order do
                local k = Waypoints.order[i]
                if tpMap[k] then t[#t + 1] = k end
            end
        else
            for n in pairs(tpMap) do t[#t + 1] = n end
            table.sort(t)
        end
        return t
    end

    local function isPlayerNear(pos, range)
        range = tonumber(range) or 50
        local range2 = range * range
        local localUserId = References.player and References.player.UserId
        for _, pl in ipairs(Services.Players:GetPlayers()) do
            if pl.UserId ~= localUserId then
                local ch = pl.Character
                local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local d2 = VMath.distanceSqr3(hrp.Position, pos)
                    if d2 <= range2 then
                        return true, pl
                    end
                end
            end
        end
        return false, nil
    end

    local function waitUntilNear(pos, radius, timeout)
        radius = radius or 3
        local radius2 = radius * radius
        local t0 = os.clock()
        while alive and os.clock() - t0 < (timeout or 12) do
            local hrp = References.humanoidRootPart
            if not hrp then return false end
            local d2 = VMath.distanceSqr3(hrp.Position, pos)
            if d2 <= radius2 then return true end
            task.wait()
        end
        return false
    end

    local function moveToAndWait(targetPos, speed, radius, timeout)
        stopActiveMove()
        activeMoveCleanup = Helpers.MoveToPos(targetPos, speed)
        waitUntilNear(targetPos, radius, timeout)
        stopActiveMove()
    end

    local function flyViaAltitude(targetPos, heightY, studsPerSecond)
        if not References.humanoidRootPart then return end
        local hrp = References.humanoidRootPart
        local cur = hrp.Position
        local spd = math.max(10, tonumber(studsPerSecond) or 250)
        local step1 = Vector3.new(cur.X, heightY, cur.Z)
        moveToAndWait(step1, spd, 3, 12)
        if not alive then return end
        local step2 = Vector3.new(targetPos.X, heightY, targetPos.Z)
        moveToAndWait(step2, spd, 3, 12)
        if not alive then return end
        local step3 = targetPos + Vector3.new(0, 2, 0)
        moveToAndWait(step3, spd, 3, 12)
    end

    return {
        tpMap           = tpMap,
        scan            = scan,
        namesFor        = namesFor,
        isPlayerNear    = isPlayerNear,
        moveToAndWait   = moveToAndWait,
        flyViaAltitude  = flyViaAltitude,
        stopActiveMove  = stopActiveMove,
        setMoveCleanup  = function(fn) activeMoveCleanup = fn end,
        kill            = function() alive = false end,
    }
end

return M

end)
__bundle_register("Features/Navigation/Teleports/Waypoints", function(require, _LOADED, __bundle_register, __bundle_modules)
-- persistent { name -> Vector3 } waypoint store with ordering + keybinds, serialized to gameDir/waypoints.json

local Fs = require("Utility/Helpers/Fs")

local M = {}

local function v3_to_tbl(v) return { x = v.X, y = v.Y, z = v.Z } end

local function tbl_to_v3(t)
    if typeof(t) == "Vector3" then return t end
    if type(t) == "table" then
        local x = t.x or t.X or t[1]
        local y = t.y or t.Y or t[2]
        local z = t.z or t.Z or t[3]
        if tonumber(x) and tonumber(y) and tonumber(z) then
            return Vector3.new(tonumber(x), tonumber(y), tonumber(z))
        end
    end
    return nil
end

M.v3_to_tbl = v3_to_tbl
M.tbl_to_v3 = tbl_to_v3

function M.new(opts)
    local HttpService = opts.HttpService
    local path        = opts.path

    local state = { list = {}, order = {}, keybinds = {} }

    local function load()
        if not (isfile and isfile(path)) then return end
        local ok, data = pcall(readfile, path)
        if not (ok and data and #data > 0) then return end
        local okDec, obj = pcall(function() return HttpService:JSONDecode(data) end)
        if not (okDec and type(obj) == "table") then return end

        local L   = obj.list or {}
        local Ord = obj.order or {}
        local K   = obj.keybinds or {}
        state.list, state.order, state.keybinds = {}, {}, {}

        for name, posObj in pairs(L) do
            local v = tbl_to_v3(posObj)
            if v then state.list[name] = v end
        end
        for i = 1, #Ord do
            local nm = Ord[i]
            if state.list[nm] then state.order[#state.order + 1] = nm end
        end
        for name, key in pairs(K) do
            if state.list[name] then state.keybinds[name] = tostring(key) end
        end

        if #state.order == 0 then
            for nm in pairs(state.list) do state.order[#state.order + 1] = nm end
            table.sort(state.order)
        end
    end

    local function save()
        local enc = { list = {}, order = state.order, keybinds = state.keybinds }
        for name, v in pairs(state.list) do
            if typeof(v) == "Vector3" then
                enc.list[name] = v3_to_tbl(v)
            elseif type(v) == "table" then
                enc.list[name] = v
            end
        end
        Fs.safeWrite(path, HttpService:JSONEncode(enc), "Teleports")
    end

    load()

    return {
        list     = state.list,
        order    = state.order,
        keybinds = state.keybinds,
        save     = save,
        setKeybinds = function(k) state.keybinds = k; return state.keybinds end,
    }
end

return M

end)
__bundle_register("Features/Navigation/Subplaces", function(require, _LOADED, __bundle_register, __bundle_modules)
-- lists every place in the current universe and TPs to one; develop.roblox.com via Http.client() (executor forwards .ROBLOSECURITY)
local Http  = require("Utility/Helpers/Http")
local Mount = require("Utility/Mount")

return function(ctx)
    local O = Mount.orchestrator(ctx, "Subplaces")
    if not O then return end

    local Services   = ctx.Services
    local Tabs       = ctx.Tabs
    local Library    = ctx.Library
    local References = ctx.References

    local SubplacesGroup = Tabs.Navigation:AddLeftGroupbox("Subplaces", "map")

    local statusLabel = SubplacesGroup:AddLabel({ Text = "Idle.", DoesWrap = true })

    local subplaceDD = SubplacesGroup:AddDropdown("SubplaceTarget", {
        Text       = "Destination",
        Values     = {},
        Default    = nil,
        Multi      = false,
        Searchable = true,
    })

    local labelToPlaceId = {}
    local fetching = false
    local cancelled = false

    O.onUnload(function() cancelled = true end)

    local function setStatus(text)
        if cancelled then return end
        if statusLabel and statusLabel.SetText then
            pcall(function() statusLabel:SetText(text) end)
        end
    end

    local function fetchSubplaces()
        if fetching then return end
        fetching = true
        setStatus("Fetching subplaces…")

        task.spawn(function()
            local httpRequest = Http.client()
            if not httpRequest then
                setStatus("HTTP request unavailable on this executor.")
                fetching = false
                return
            end

            local universeId = Services.Game.GameId
            if not universeId or universeId == 0 then
                setStatus("No universe ID available.")
                fetching = false
                return
            end

            local collected = {}
            local cursor = nil
            local errMsg = nil
            local MAX_PAGES = 5

            for page = 1, MAX_PAGES do
                if cancelled then fetching = false; return end
                local url = ("https://develop.roblox.com/v1/universes/%d/places?isUniverseCreation=false&limit=100&sortOrder=Asc"):format(universeId)
                if cursor and cursor ~= "" then
                    url = url .. "&cursor=" .. Services.HttpService:UrlEncode(cursor)
                end

                local okCall, res = pcall(httpRequest, {
                    Url = url,
                    Method = "GET",
                    Headers = { ["Content-Type"] = "application/json" },
                })

                if not okCall or type(res) ~= "table" then
                    errMsg = "request failed"
                    break
                end

                local status = res.StatusCode or res.status_code or res.Status
                local ok2xx = type(status) == "number" and status >= 200 and status < 300
                if status == nil and res.Success ~= nil then ok2xx = res.Success == true end
                if not ok2xx then
                    errMsg = "HTTP " .. tostring(status or "error")
                    break
                end

                local body = res.Body or res.body
                if type(body) ~= "string" or body == "" then
                    errMsg = "empty response"
                    break
                end

                local okDec, data = pcall(Services.HttpService.JSONDecode, Services.HttpService, body)
                if not okDec or type(data) ~= "table" or type(data.data) ~= "table" then
                    errMsg = "decode failed"
                    break
                end

                for _, entry in ipairs(data.data) do
                    if entry.id and entry.name then
                        collected[#collected + 1] = { id = entry.id, name = entry.name }
                    end
                end

                cursor = data.nextPageCursor
                if not cursor or cursor == "" then break end
            end

            if #collected == 0 then
                if errMsg == "HTTP 401" or errMsg == "HTTP 403" then
                    setStatus("API rejected request — Roblox only lists subplaces for users with developer access to this universe.")
                elseif errMsg then
                    setStatus("Failed to fetch subplaces: " .. errMsg)
                else
                    setStatus("No subplaces found for this universe.")
                end
                fetching = false
                return
            end

            table.sort(collected, function(a, b)
                return a.name:lower() < b.name:lower()
            end)

            local labels = {}
            local mapping = {}
            local currentPlaceId = Services.Game.PlaceId
            for _, p in ipairs(collected) do
                local label = p.name
                if p.id == currentPlaceId then
                    label = label .. "  (current)"
                end
                -- disambiguate duplicate names by appending the placeId
                if mapping[label] then
                    label = ("%s [%d]"):format(label, p.id)
                end
                labels[#labels + 1] = label
                mapping[label] = p.id
            end

            if cancelled then fetching = false; return end

            labelToPlaceId = mapping
            pcall(function() subplaceDD:SetValues(labels) end)
            setStatus(("Loaded %d subplace%s."):format(#collected, #collected == 1 and "" or "s"))
            fetching = false
        end)
    end

    SubplacesGroup:AddButton({
        Text = "Teleport",
        Func = function()
            local label = subplaceDD.Value
            local placeId = label and labelToPlaceId[label]
            if not placeId then
                Library:Notify("Pick a subplace first.", 3)
                return
            end
            local ok, err = pcall(function()
                Services.TeleportService:Teleport(placeId, References.player)
            end)
            if not ok then
                Library:Notify("Teleport failed: " .. tostring(err), 4)
            end
        end,
    })

    task.spawn(fetchSubplaces)

    O.finalize()
    return {}
end

end)
