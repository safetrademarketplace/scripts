        if inst == nil then
            explicit = nil
            return true
        end
        if typeof(inst) ~= "Instance" or not inst.Parent then return false, "instance invalid" end
        meta = (type(meta) == "table") and meta or {}
        explicit = { instance = inst, name = meta.name, group = meta.group }
        manual = true
        return true
    end

    return {
        Refresh       = refresh,
        Resolve       = resolve,
        Remember      = remember,
        Forget        = function() memory = nil end,
        InvalidReason = invalidReason,

        SetGroup      = setGroup,
        SetPicks      = setPicks,
        PickOne       = pickOne,
        SetExplicit   = setExplicit,
        SetRetarget   = function(mode)
            retarget = (tostring(mode or ""):lower() == "removed") and "removed" or "health"
        end,
        SetFollowNearest = function(on)
            followNearest = on == true
            if followNearest then manual = false end
        end,

        GetGroup    = function() return group end,
        GetRetarget = function() return retarget end,
        GetExplicit = function() return explicit and explicit.instance or nil end,
        FollowsNearest = function() return followNearest end,
        GetNames    = function() return table.move(names, 1, #names, 1, table.create(#names)) end,
        GetPicks    = function()
            local out = {}
            for name in pairs(picks) do out[name] = true end
            return out
        end,
    }
end

return M

end)
__bundle_register("Api/Attach/Runtime", function(require, _LOADED, __bundle_register, __bundle_modules)
-- attach runtime: the character-scoped overrides attach needs while it runs, reapplied on every respawn and restored on stop

local M = {}

function M.new(deps)
    local Helpers    = deps.Helpers
    local NewMaid    = deps.NewMaid
    local References = deps.References

    local options = { autoRotate = true, noclip = true, invisicam = true }
    local maid, stopping = nil, false

    local function holdCharacter(char)
        if not options.autoRotate then return end
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.AutoRotate = false end
    end

    local function start()
        if maid then return end
        -- maid first: every override registers its own restore as it lands, so a failure part-way still unwinds
        maid = NewMaid()

        if options.noclip then
            Helpers.startNoclip()
            maid:GiveTask(function() Helpers.stopNoclip() end)
        end

        if options.autoRotate then
            maid:GiveTask(function()
                local hum = References.humanoid
                if hum and hum.Parent then hum.AutoRotate = true end
            end)
        end

        if options.invisicam then
            local player = References.player
            local previous = player.DevCameraOcclusionMode

            local function force()
                if stopping then return end
                player.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Invisicam
            end

            force()
            -- a changed-signal instead of a per-frame write: catches the game re-setting it at no frame cost
            maid:GiveTask(player:GetPropertyChangedSignal("DevCameraOcclusionMode"):Connect(force))
            maid:GiveTask(function() player.DevCameraOcclusionMode = previous end)
        end

        -- fires for the live character straight away, so this covers both the current one and every respawn
        maid:GiveTask(References.onCharacter(holdCharacter))
    end

    local function stop()
        if not maid then return end
        stopping = true
        pcall(function() maid:DoCleaning() end)
        maid, stopping = nil, false
    end

    -- forks that must not touch the camera or collisions narrow the override set before starting
    local function configure(overrides)
        if type(overrides) ~= "table" then return false end
        for key, value in pairs(overrides) do
            if options[key] ~= nil then options[key] = value == true end
        end
        return true
    end

    return {
        Start     = start,
        Stop      = stop,
        Configure = configure,
        IsActive  = function() return maid ~= nil end,
    }
end

return M

end)
__bundle_register("Api/Attach/Placement", function(require, _LOADED, __bundle_register, __bundle_modules)
-- attach placement: turns the live target into the cframe the character should hold, slewing the offset and riding out brief gaps in the target's own cframe

local M = {}

local DEFAULT_OFFSET = { right = 0, up = 8, forward = 0 }
local OFFSET_SLEW    = 240   -- studs/second the applied offset may chase the requested one; a jump trips physics snapback
local CFRAME_GRACE   = 4     -- seconds the last good cframe is reused while the target reports none
local BASIS_VELOCITY = 1.25  -- studs/second of target motion before the offset frame follows travel instead of facing
local FLAT_EPSILON   = 0.01  -- below this the offset is effectively straight up, so facing falls back to the basis

function M.new(deps)
    local Targeting = deps.Targeting

    local requested = { right = DEFAULT_OFFSET.right, up = DEFAULT_OFFSET.up, forward = DEFAULT_OFFSET.forward }
    local applied   = { right = DEFAULT_OFFSET.right, up = DEFAULT_OFFSET.up, forward = DEFAULT_OFFSET.forward }

    local basisToken, basisLook = nil, nil
    local lastDesired, blindSince = nil, nil

    local function copyOf(source)
        return { right = source.right, up = source.up, forward = source.forward }
    end

    local function setOffset(a, b, c)
        local source = (type(a) == "table") and a or { right = a, up = b, forward = c }
        requested.right   = tonumber(source.right)   or requested.right
        requested.up      = tonumber(source.up)      or requested.up
        requested.forward = tonumber(source.forward) or requested.forward
    end

    local function approach(current, target, maxStep)
        local delta = target - current
        if math.abs(delta) <= maxStep then return target end
        return current + ((delta > 0) and maxStep or -maxStep)
    end

    -- dt-scaled so the slew rate is the same at 30fps and 240fps
    local function step(dt)
        local maxStep = OFFSET_SLEW * math.max(tonumber(dt) or 0, 0)
        if maxStep <= 0 then return end
        applied.right   = approach(applied.right,   requested.right,   maxStep)
        applied.up      = approach(applied.up,      requested.up,      maxStep)
        applied.forward = approach(applied.forward, requested.forward, maxStep)
    end

    -- the frame the offset is expressed in: the target's facing when first seen, switching to its travel direction once it moves
    local function basisOf(candidate, targetCf)
        local token = Targeting.token(candidate)
        if not token then return targetCf end

        if basisToken ~= token or not basisLook then
            basisToken = token
            local look = targetCf.LookVector
            local flat = Vector3.new(look.X, 0, look.Z)
            basisLook = (flat.Magnitude < FLAT_EPSILON) and Vector3.new(0, 0, -1) or flat.Unit
        end

        local root = Targeting.getRoot(candidate)
        if root then
            local velocity = root.AssemblyLinearVelocity
            local flat = Vector3.new(velocity.X, 0, velocity.Z)
            if flat.Magnitude >= BASIS_VELOCITY then basisLook = flat.Unit end
        end

        return CFrame.lookAt(targetCf.Position, targetCf.Position + basisLook, Vector3.yAxis)
    end

    local function desired(candidate)
        local targetCf = Targeting.getCFrame(candidate)
        if not targetCf then
            blindSince = blindSince or os.clock()
            if lastDesired and (os.clock() - blindSince) <= CFRAME_GRACE then return lastDesired end
            return nil
        end
        blindSince = nil

        local basis = basisOf(candidate, targetCf)
        local origin = targetCf.Position
            + basis.RightVector * applied.right
            + Vector3.yAxis * applied.up
            + basis.LookVector * applied.forward

        -- upright and turned toward the target: a character pitched face-down at a target below it reads as an anomaly
        local toTarget = Vector3.new(targetCf.Position.X - origin.X, 0, targetCf.Position.Z - origin.Z)
        local facing = (toTarget.Magnitude > FLAT_EPSILON) and toTarget.Unit or basis.LookVector
        lastDesired = CFrame.lookAt(origin, origin + facing, Vector3.yAxis)
        return lastDesired
    end

    local function reset()
        basisToken, basisLook = nil, nil
        lastDesired, blindSince = nil, nil
    end

    return {
        Step       = step,
        Desired    = desired,
        Reset      = reset,
        SetOffset  = setOffset,
        GetOffset  = function() return copyOf(requested) end,
        GetDefault = function() return copyOf(DEFAULT_OFFSET) end,
        HasFix     = function() return lastDesired ~= nil end,
    }
end

return M

end)
