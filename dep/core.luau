__bundle_register("Features/Home", function(require, _LOADED, __bundle_register, __bundle_modules)
-- home tab: about/executor/links/changelog/key-status/feedback/credits groupboxes
local ExecutorSupport = require("Utility/ExecutorSupport")
local PremiumPopup    = require("UI/PremiumPopup")
local Connectivity    = require("Features/Connectivity")

return function(ctx)
    local Tabs       = ctx.Tabs
    local References = ctx.References
    local Library    = ctx.Library
    local Options    = ctx.Options
    local META       = ctx.META or {}
    local Helpers    = ctx.Helpers
    local Toggles    = Library.Toggles

    do
        local aboutGroup = Tabs.Home:AddLeftGroupbox((META.name or "Cerberus"), "info")
        aboutGroup:AddDivider()
        aboutGroup:AddLabel(('<b>Version</b>  %s'):format(META.version or "v1.0.0"))
        aboutGroup:AddLabel(('<b>Updated</b>  %s'):format(META.updated or "Unknown"))
        aboutGroup:AddLabel(('<b>Status</b>  <font color="#86efac">%s</font>'):format(META.status or "Stable Release"))
        aboutGroup:AddDivider()
    end

    do
        local KeyCheck = ctx.Api and ctx.Api.KeyCheck
        if KeyCheck and KeyCheck.HasKey() then
            local keyGroup    = Tabs.Home:AddLeftGroupbox("Key Status", "key")
            local execLabel   = keyGroup:AddLabel({ Text = '<b>Executions:</b>  <font color="#9ca3af">Loading...</font>', DoesWrap = true })
            local statusLabel = keyGroup:AddLabel({ Text = '<b>Expiry:</b>  <font color="#9ca3af">Loading...</font>', DoesWrap = true })

            local function set(label, prefix, text, color)
                if label and label.SetText then
                    pcall(label.SetText, label, ('<b>%s:</b>  <font color="%s">%s</font>'):format(prefix, color, text))
                end
            end

            -- the sdk fetch, status policy and countdown all live in ctx.Api.KeyCheck; this is display only
            task.spawn(function()
                local result = KeyCheck.Check()
                if result.valid and result.data then
                    set(execLabel, "Executions", tostring(result.data.totalExecutions or 0), "#9ca3af")
                    KeyCheck.StartCountdown(result.data.authExpire, function(text, state)
                        local color = (state == "expired" and "#fca5a5")
                            or (state == "lifetime" and "#86efac")
                            or "#fde047"
                        set(statusLabel, "Expiry", text, color)
                    end)
                else
                    set(execLabel, "Executions", "N/A", "#fca5a5")
                    set(statusLabel, "Status", result.message or "Key check failed", result.color or "#fca5a5")
                end
            end)
        end
    end

    do
        local executorGroup = Tabs.Home:AddLeftGroupbox("Executor", "code")
        local report = ExecutorSupport.analyze(META, References.executorName)

        local statusColor
        if not report.ok then
            statusColor = "#fca5a5"
        elseif report.isLimited or #report.missingRecommended > 0 then
            statusColor = "#fde047"
        else
            statusColor = "#86efac"
        end

        executorGroup:AddLabel({
            Text    = ('<b>Executor</b>  %s'):format(report.executorName),
            DoesWrap = true,
        })
        executorGroup:AddLabel({
            Text    = ('<b>Status</b>  <font color="%s">%s</font>'):format(statusColor, report.statusLabel),
            DoesWrap = true,
        })

        local gaps = ExecutorSupport.describeGaps(report)
        if #gaps > 0 then
            executorGroup:AddDivider()
            for _, line in ipairs(gaps) do
                local label, body = line:match("^(.-):%s*(.*)$")
                if label and body then
                    executorGroup:AddLabel({
                        Text    = ('<font color="#9ca3af"><b>%s</b></font>  %s'):format(label, body),
                        DoesWrap = true,
                    })
                else
                    executorGroup:AddLabel({ Text = line, DoesWrap = true })
                end
            end
        end

        if report.isLimited and report.ok then
            executorGroup:AddDivider()
            executorGroup:AddLabel({
                Text    = ('<font color="#fde047"><b>Note</b></font>  %s\'s drawing/gethui APIs are limited — ESP and some UI may not render correctly.'):format(
                    report.isXeno and "Xeno" or "Solara"),
                DoesWrap = true,
            })
        end
    end

    do
        local urls = META.urls or {}
        local linksGroup = Tabs.Home:AddLeftGroupbox("Links", "link")

        local function link(text, url, msg)
            if Helpers.copyLink and url then
                linksGroup:AddButton({
                    Text = text,
                    Tooltip = url,
                    Func = function()
                        Helpers.copyLink(url, msg)
                    end,
                })
            end
        end

        link("Website", urls.website, "Website link copied!")
        link("Discord", urls.discord, "Discord invite copied!")
        link("Youtube", urls.youtube, "Youtube link copied!")
        link("More Scripts", urls.scripts, "Scripts link copied!")
    end

    do
        local feedbackGroup = Tabs.Home:AddLeftGroupbox("Feedback", "quote")
        local feedbackSent = false

        feedbackGroup:AddInput("feedbackTextbox", {
            Text = "Message",
            Placeholder = "Write a message to the dev team here.",
            ClearTextOnFocus = true,
        })

        feedbackGroup:AddButton("Send Feedback", function()
            if feedbackSent then
                Library:Notify("Feedback already sent.", 4)
                return
            end

            local msg = Options.feedbackTextbox and Options.feedbackTextbox.Value
            if not msg or msg == "" then
                Library:Notify("Please write feedback first.", 3)
                return
            end

            if not Helpers.SendDiscordWebhook then
                Library:Notify("Feedback webhook unavailable.", 3)
                return
            end

            -- secret lives in ConfigSecrets (obfuscated half); never inline it here, Home ships unobfuscated
            local feedbackWebhook = ctx.ConfigSecrets and ctx.ConfigSecrets.FeedbackWebhook
            if not feedbackWebhook or feedbackWebhook == "" then
                Library:Notify("Feedback webhook unavailable.", 3)
                return
            end

            Helpers.SendDiscordWebhook(
                feedbackWebhook,
                References.player.Name .. " has provided feedback.",
                msg,
                "Cerberus Feedback",
                nil,
                nil,
                false
            )

            Library:Notify("Feedback sent successfully!", 5)
            feedbackSent = true
        end)
    end

    do
        local updatesGroup = Tabs.Home:AddRightGroupbox("Latest Updates", "sparkles")
        updatesGroup:AddLabel({
            Text    = ('<b>Changelog</b>  <font color="#9ca3af">%s</font>'):format(META.version or ""),
            DoesWrap = true,
        })
        updatesGroup:AddDivider()

        for _, entry in ipairs(META.changelog or {}) do
            updatesGroup:AddLabel({
                Text    = ('<font color="#9ca3af">•</font>  %s'):format(entry),
                DoesWrap = true,
            })
        end
    end

    do
        local Link = ctx.Api and ctx.Api.Link
        if Link and Link.Mode() ~= "off" then
            local linkGroup = Tabs.Home:AddRightGroupbox("Dashboard", "monitor-smartphone")
            local hasKey    = Link.HasKey()
            local reverting = false

            linkGroup:AddToggle("Menu_Dashboard", {
                -- always off at boot, key or no key: the dashboard only ever sees a client
                -- because someone switched it on during this session
                Default = false,
                Text    = "Dashboard Link",
                Tooltip = "See and control this client from getcerberus.com/dashboard.",
                Callback = function(value)
                    if reverting then return end
                    -- without a key there is nothing to link to, so the switch bounces back and explains itself
                    if not hasKey then
                        if value then
                            reverting = true
                            Toggles.Menu_Dashboard:SetValue(false)
                            reverting = false
                            PremiumPopup.show(Library)
                        end
                        return
                    end
                    Link.SetEnabled(value)
                    Library:Notify(value and "Dashboard link on — this client will show as online."
                        or "Dashboard link off — this client will not appear on the dashboard.", 5)
                end,
            })

            linkGroup:AddLabel({
                Text = hasKey
                    and '<font color="#9ca3af">Your key is linked. One account at a time. This starts off every time you run the script.</font>'
                    or  '<font color="#fca5a5">Needs a key.</font>  <font color="#9ca3af">Get one at getcerberus.com.</font>',
                DoesWrap = true,
            })
        end
    end

    -- connectivity lives in its own module; mounted here so it sits below the changelog
    pcall(Connectivity, ctx)

    do
        local creditsGroup = Tabs.Home:AddRightGroupbox("Credits + Disclaimer", "shield-alert")
        creditsGroup:AddLabel('<b>Script</b>  @tevilii')
        creditsGroup:AddLabel('<b>UI Library</b>  Obsidian by deivid')

        local urls = META.urls or {}
        if Helpers.copyLink and urls.obsidian then
            creditsGroup:AddButton({
                Text = "Obsidian Library",
                Tooltip = urls.obsidian,
                Func = function()
                    Helpers.copyLink(urls.obsidian, "Obsidian link copied!")
                end,
            })
        end

        creditsGroup:AddDivider()
        creditsGroup:AddLabel(
            "This script is provided for educational and customization purposes.\n" ..
            "Respect Roblox and game TOS. You are responsible for your usage.",
            true
        )
    end
end

end)
__bundle_register("Utility/ExecutorSupport", function(require, _LOADED, __bundle_register, __bundle_modules)
-- analyzes Meta.executor capability lists (required/requiredAnyOf/recommended) for Home display and launch notification

local Executor = require("Utility/Executor")

local resolveExec = Executor.get
local isFn = Executor.isFn

local function analyze(meta, executorName)
    local execMeta = (type(meta) == "table" and meta.executor) or {}
    local requiredList    = type(execMeta.required)      == "table" and execMeta.required      or {}
    local requiredAnyOf   = type(execMeta.requiredAnyOf) == "table" and execMeta.requiredAnyOf or {}
    local recommendedList = type(execMeta.recommended)   == "table" and execMeta.recommended   or {}

    local missingRequired    = {}
    local missingAnyOfGroups = {}
    local missingRecommended = {}

    for _, name in ipairs(requiredList) do
        if not isFn(name) then
            missingRequired[#missingRequired + 1] = name
        end
    end

    for groupName, options in pairs(requiredAnyOf) do
        if type(options) == "table" then
            local satisfied = false
            for _, name in ipairs(options) do
                if isFn(name) then satisfied = true; break end
            end
            if not satisfied then
                missingAnyOfGroups[#missingAnyOfGroups + 1] = {
                    name = tostring(groupName),
                    options = options,
                }
            end
        end
    end

    for _, name in ipairs(recommendedList) do
        if not isFn(name) then
            missingRecommended[#missingRecommended + 1] = name
        end
    end

    local execLower = tostring(executorName or ""):lower()
    local isXeno    = execLower:find("xeno",   1, true) ~= nil
    local isSolara  = execLower:find("solara", 1, true) ~= nil
    -- Xeno/Solara always classify partial: their gethui/hookmetamethod/Drawing are unstable and we route around them
    local isLimited = isXeno or isSolara

    local totalRequired = #requiredList
    for _ in pairs(requiredAnyOf) do totalRequired = totalRequired + 1 end

    local satisfiedRequired = totalRequired
        - #missingRequired
        - #missingAnyOfGroups

    local hasBlockingGap = (#missingRequired + #missingAnyOfGroups) > 0

    local statusLabel
    if hasBlockingGap then
        statusLabel = string.format(
            "Partial support (%d/%d required)",
            satisfiedRequired, totalRequired
        )
    elseif isLimited then
        statusLabel = ("Partial support (%s — known limitations)"):format(
            isXeno and "Xeno" or "Solara")
    elseif #missingRecommended > 0 then
        statusLabel = string.format(
            "Partial support (%d recommended unavailable)",
            #missingRecommended
        )
    else
        statusLabel = "Full support"
    end

    return {
        ok                 = not hasBlockingGap,
        isXeno             = isXeno,
        isSolara           = isSolara,
        isLimited          = isLimited,
        executorName       = tostring(executorName or "Unknown"),
        missingRequired    = missingRequired,
        missingAnyOfGroups = missingAnyOfGroups,
        missingRecommended = missingRecommended,
        totalRequired      = totalRequired,
        satisfiedRequired  = satisfiedRequired,
        statusLabel        = statusLabel,
    }
end

local function describeGaps(report)
    local lines = {}
    if #report.missingRequired > 0 then
        lines[#lines + 1] = "Missing required: " .. table.concat(report.missingRequired, ", ")
    end
    for _, group in ipairs(report.missingAnyOfGroups) do
        lines[#lines + 1] = string.format(
            "Missing any-of [%s]: %s",
            group.name, table.concat(group.options, " / ")
        )
    end
    if #report.missingRecommended > 0 then
        lines[#lines + 1] = "Missing recommended: " .. table.concat(report.missingRecommended, ", ")
    end
    return lines
end

local function buildLaunchMessage(report)
    local parts = {}
    if #report.missingRequired > 0 then
        parts[#parts + 1] = string.format(
            "%d required missing (%s)",
            #report.missingRequired,
            table.concat(report.missingRequired, ", ")
        )
    end
    if #report.missingAnyOfGroups > 0 then
        local groupNames = {}
        for _, g in ipairs(report.missingAnyOfGroups) do
            groupNames[#groupNames + 1] = g.name
        end
        parts[#parts + 1] = string.format(
            "%d required group(s) unmet (%s)",
            #report.missingAnyOfGroups,
            table.concat(groupNames, ", ")
        )
    end
    if #parts == 0 then return nil end
    return "Executor missing capabilities — " .. table.concat(parts, "; ")
end

return {
    analyze            = analyze,
    resolveExec        = resolveExec,
    describeGaps       = describeGaps,
    buildLaunchMessage = buildLaunchMessage,
}

end)
