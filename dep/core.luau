                type = "crosshair",
                props = {
                    color            = color3ToHex(P.color),
                    thickness        = P.thickness,
                    length           = P.length,
                    gap              = P.gap,
                    lineCount        = P.lineCount,
                    centerDot        = P.centerDot,
                    dotSize          = P.dotSize,
                    outline          = P.outline,
                    outlineColor     = color3ToHex(P.outlineColor),
                    outlineThickness = P.outlineThickness
                }
            }
        else
            return {
                type = "dot",
                props = {
                    color            = color3ToHex(P.color),
                    size             = P.size,
                    outline          = P.outline,
                    outlineColor     = color3ToHex(P.outlineColor),
