    if typeof(host) == "Instance" and host:IsA("GuiObject") then return host end
    return nil
end

-- the first table arg carrying `Premium = true`; works for both strict (self,idx,info) and loose (self,text|info,...) add shapes
local function findPremiumInfo(...)
    for i = 1, select("#", ...) do
        local a = select(i, ...)
        if type(a) == "table" and a.Premium == true then return a end
    end
    return nil
end

local function resolveElement(idx)
    if type(idx) ~= "string" or not Library then return nil end
    local toggles, options = Library.Toggles, Library.Options
    return (toggles and toggles[idx]) or (options and options[idx]) or nil
end

-- keypicker and colorpicker hang off a second shared funcs table only reachable through an element, so it is patched the first time one comes back
local addonFuncs
local wrapAdd

-- buttons copy AddKeyPicker off that table at construction rather than inheriting it, so any built before the patch is re-pointed afterwards
local ORPHAN_LIMIT = 32
local orphans = {}

local function adoptAddons(element)
    if type(element) ~= "table" or rawget(element, "AddKeyPicker") == nil then return end
    if addonFuncs then
        element.AddKeyPicker = addonFuncs.AddKeyPicker
    elseif #orphans < ORPHAN_LIMIT then
        orphans[#orphans + 1] = element
    end
end

local function patchAddons(element)
    if addonFuncs or type(element) ~= "table" then return end
    local mt = getmetatable(element)
    local Funcs = mt and type(mt.__index) == "table" and mt.__index or nil
    if not (Funcs and type(Funcs.AddKeyPicker) == "function") then return end

    addonFuncs = Funcs
    wrapAdd(Funcs, "AddKeyPicker")
    wrapAdd(Funcs, "AddColorPicker")
    for _, orphan in ipairs(orphans) do orphan.AddKeyPicker = Funcs.AddKeyPicker end
    table.clear(orphans)
    Log.print("[Cerberus/Premium] BaseAddons Add* wrapped")
end

function wrapAdd(Funcs, name)
    local orig = Funcs[name]
    if type(orig) ~= "function" then return end
    local isAddon = ADDON[name] == true

    Funcs[name] = function(self, ...)
        local info = findPremiumInfo(...)
        if not info then
            local plain = orig(self, ...)
            if not isAddon then
                patchAddons(plain)
                adoptAddons(plain)
            end
            return plain
        end

        info.Premium = nil
        guardInfo(info)

        local host   = overlayHost(self, name)
        local before = host and snapshot(host) or nil
        local result = orig(self, ...)

        if before then coverNew(host, before) end
        if STRICT[name] then gateValues(resolveElement((select(1, ...)))) end
        if not isAddon then
            patchAddons(result)
            adoptAddons(result)
        end
        return result
    end
end

-- BaseGroupbox.__index is shared across every groupbox, so one patch covers all present and future elements
local funcsPatched = false
local function patchFuncs(groupboxLike)
    if funcsPatched then return end
    local mt = getmetatable(groupboxLike)
    if not (mt and type(mt.__index) == "table") then
        Log.warn("[Cerberus/Premium] patchFuncs: missing metatable on groupbox")
        return
    end

    funcsPatched = true
    local Funcs = mt.__index
    for name in pairs(STRICT) do wrapAdd(Funcs, name) end
    for _, name in ipairs(LOOSE) do wrapAdd(Funcs, name) end
    Log.print("[Cerberus/Premium] BaseGroupbox Add* wrapped")
end

local function wrapTab(tab)
    if not tab or tab.__cerb_premium_wrapped then return tab end
    tab.__cerb_premium_wrapped = true

    local function wrapGroupboxFactory(method)
        local orig = tab[method]
        if type(orig) ~= "function" then return end
        tab[method] = function(self, ...)
            local gb = orig(self, ...)
            if gb then patchFuncs(gb) end
            return gb
        end
    end
    wrapGroupboxFactory("AddLeftGroupbox")
    wrapGroupboxFactory("AddRightGroupbox")

    -- tabbox tabs share the same Funcs table, so patching from one covers them too
    local function wrapTabboxFactory(method)
        local orig = tab[method]
        if type(orig) ~= "function" then return end
        tab[method] = function(self, ...)
            local tabbox = orig(self, ...)
            if tabbox and not tabbox.__cerb_premium_wrapped then
                tabbox.__cerb_premium_wrapped = true
                local addTab = tabbox.AddTab
                if type(addTab) == "function" then
                    tabbox.AddTab = function(tbself, ...)
                        local subTab = addTab(tbself, ...)
                        if subTab then patchFuncs(subTab) end
                        return subTab
                    end
                end
            end
            return tabbox
        end
    end
    wrapTabboxFactory("AddLeftTabbox")
    wrapTabboxFactory("AddRightTabbox")

    return tab
end

local function wrapWindow(window)
    if not window or window.__cerb_premium_wrapped then return window end
    window.__cerb_premium_wrapped = true

    local function wrapTabFactory(method)
        local orig = window[method]
        if type(orig) ~= "function" then return end
        window[method] = function(self, ...)
            return wrapTab(orig(self, ...))
        end
    end
    wrapTabFactory("AddTab")
    wrapTabFactory("AddKeyTab")

    -- dialogs expose the same element funcs, so a premium element inside one is gated too
    local origAddDialog = window.AddDialog
    if type(origAddDialog) == "function" then
        window.AddDialog = function(self, ...)
            local dlg = origAddDialog(self, ...)
            if dlg then patchFuncs(dlg) end
            return dlg
        end
    end

    return window
end

-- install before CreateWindow so the returned window/tab/groupbox closures are the wrapped variants
local installed = false
function M.install(lib)
    if installed or type(lib) ~= "table" then return lib end
    installed = true
    Library = lib

    local origCreateWindow = lib.CreateWindow
    if type(origCreateWindow) == "function" then
        lib.CreateWindow = function(self, info)
            return wrapWindow(origCreateWindow(self, info))
        end
    end

    Log.print("[Cerberus/Premium] Library wrappers installed")
    return lib
end

return M

