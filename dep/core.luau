__bundle_register("Api/Attach/Targeting", function(require, _LOADED, __bundle_register, __bundle_modules)
-- attach targeting: candidate geometry over the shared entity index, plus the validity rule the engine retargets on

local PlayersH = require("Utility/Helpers/Players")
local VMath    = require("Utility/Helpers/VMath")

local M = {}

-- a candidate is { group, name, player?, model?, instance? }; every accessor tolerates whichever subset a fork's gather() filled in
function M.new(opts)
    local index = opts.index

    local function getModel(candidate)
        if type(candidate) ~= "table" then return nil end
        if candidate.player then
            local char = candidate.player.Character
            return (char and char.Parent) and char or nil
        end
        if candidate.model and candidate.model.Parent then return candidate.model end
        local inst = candidate.instance
        if not (inst and inst.Parent) then return nil end
        if inst:IsA("Model") then return inst end
        if inst:IsA("BasePart") then return inst:FindFirstAncestorOfClass("Model") end
        return nil
    end

    local function getHumanoid(candidate)
        local model = getModel(candidate)
        return model and model:FindFirstChildOfClass("Humanoid") or nil
    end

    local function getRoot(candidate)
        if type(candidate) == "table" then
            local inst = candidate.instance
            if inst and inst.Parent and inst:IsA("BasePart") then return inst end
        end
        local model = getModel(candidate)
        return model and PlayersH.getRootPart(model) or nil
    end

    local function getCFrame(candidate)
        local root = getRoot(candidate)
        if root then return root.CFrame end
        local model = getModel(candidate)
        if not model then return nil end
        local ok, pivot = pcall(model.GetPivot, model)
        return (ok and typeof(pivot) == "CFrame") and pivot or nil
    end

    local function getName(candidate)
        if type(candidate) ~= "table" then return "Unknown" end
        if type(candidate.name) == "string" and candidate.name ~= "" then return candidate.name end
        local player = candidate.player
        if player then return (player.DisplayName ~= "" and player.DisplayName) or player.Name end
        local model = getModel(candidate)
        return (model and model.Name) or "Unknown"
    end

    -- the handle a candidate keeps across list refreshes; two candidates sharing one are the same target
    local function token(candidate)
        if type(candidate) ~= "table" then return nil end
        return candidate.player or candidate.model or candidate.instance or getRoot(candidate)
    end

    -- strict about nil on purpose: "no target" is not a target, so it never counts as a match
    local function same(a, b)
        if a == nil or b == nil then return false end
        local left = token(a)
        return left ~= nil and left == token(b)
    end

    -- rebuilds a candidate from a bare instance, keeping the player/model handle so the geometry accessors still resolve
    local function fromInstance(inst, name, group)
        if typeof(inst) ~= "Instance" or not inst.Parent then return nil end
        local candidate = {
            group    = group,
            name     = (type(name) == "string" and name ~= "" and name)
                or (inst.Name ~= "" and inst.Name) or "Target",
            instance = inst,
        }
        if inst:IsA("Player") then
            candidate.player = inst
        elseif inst:IsA("Model") then
            candidate.model = inst
        end
        return candidate
    end

    local function distanceSqr(fromPart, candidate)
        local root = getRoot(candidate)
        if not (fromPart and root) then return math.huge end
        return VMath.distanceSqr3(fromPart.Position, root.Position)
    end

    -- nil while the candidate is still attachable, a short user-readable reason once it is not
    local function invalidReason(candidate, requireAlive)
        if not candidate then return "no target" end

        local root = getRoot(candidate)
        if not root then
            if not getModel(candidate) then return "target gone" end
            if not getCFrame(candidate) then return "target has no position" end
        end

        if requireAlive then
            local hum = getHumanoid(candidate)
            if hum then
                local dead = false
                pcall(function() dead = hum:GetState() == Enum.HumanoidStateType.Dead end)
                if dead then return "target died" end
                if (tonumber(hum.MaxHealth) or 0) > 0 and (tonumber(hum.Health) or 0) <= 0 then
                    return "target died"
                end
            end
        end
        return nil
    end

    -- suffixes " (2)", " (3)" … so two entities sharing a model name stay separately selectable
    local function uniqueName(base, used)
        base = tostring(base or "Target")
        if not used[base] then
            used[base] = true
            return base
        end
        local n = 2
        local name = ("%s (%d)"):format(base, n)
        while used[name] do
            n = n + 1
            name = ("%s (%d)"):format(base, n)
        end
        used[name] = true
        return name
    end

    local function gatherPlayers(def)
        local group = (def and def.key) or "Players"
        local list, used = {}, {}
        for _, player in ipairs(index.players()) do
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root and char:FindFirstChildOfClass("Humanoid") then
                local label = (player.DisplayName ~= "" and player.DisplayName) or player.Name
                list[#list + 1] = {
                    group  = group,
                    name   = uniqueName(label, used),
                    player = player,
                    model  = char,
                }
            end
        end
        return list
    end

    local function gatherEntities(def)
        local group = (def and def.key) or "Entities"
        local list, used = {}, {}
        for _, model in ipairs(index.entities(def and def.options or nil)) do
            if model:FindFirstChildOfClass("Humanoid") and PlayersH.getRootPart(model) then
                list[#list + 1] = {
                    group = group,
                    name  = uniqueName(model.Name, used),
                    model = model,
                }
            end
        end
        return list
    end

    return {
        getModel       = getModel,
        getHumanoid    = getHumanoid,
        getRoot        = getRoot,
        getCFrame      = getCFrame,
        getName        = getName,
        token          = token,
        same           = same,
        fromInstance   = fromInstance,
        distanceSqr    = distanceSqr,
        invalidReason  = invalidReason,
        uniqueName     = uniqueName,
        gatherPlayers  = gatherPlayers,
        gatherEntities = gatherEntities,
    }
end

return M

end)
