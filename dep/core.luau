-- premium gate: any element built with `Premium = true` renders normally but, while the gate is shut, swallows clicks behind an upsell overlay, no-ops its callbacks and rejects every value mutation including config loads, replaying the last rejected mutation if entitlement lands afterwards

local Jobs = require("Utility/Jobs")
local Log  = require("Utility/Log")

local M = {}

-- until configure() wires the real predicate nothing is locked
local lockPredicate = function() return false end
local popupFn       = function() end
local Library

-- strict adds take (idx, info) and register the element under that idx; addons take the same shape but return the parent element and build into its label
local STRICT = {
    AddToggle = true, AddCheckbox = true, AddSlider = true, AddDropdown = true,
    AddInput = true, AddViewport = true, AddImage = true, AddVideo = true,
    AddUIPassthrough = true, AddKeyPicker = true, AddColorPicker = true,
}
local ADDON = { AddKeyPicker = true, AddColorPicker = true }
local LOOSE = { "AddButton", "AddLabel" }

local CALLBACKS = { "Callback", "Func", "Changed", "ChangedCallback", "Clicked" }
local MUTATORS  = { "SetValue", "SetValueRGB" }

-- covering a frame that arranges its children would add the overlay as one more flex item, so descend instead of filling
local MAX_COVER_DEPTH = 3

-- long enough for an in-flight key check to settle, so an entitled user never sees the notice
local SKIP_NOTICE_DELAY = 6

local overlays = {}   -- click-catchers we own, so one refresh retargets them all
local gated    = {}   -- premium elements whose value mutators we own
local skipNoticeArmed = false

local function isLocked()
    local ok, res = pcall(lockPredicate)
    return ok and res == true
end
M.isLocked = isLocked

local function noteSkipped()
    if skipNoticeArmed or not Library then return end
    skipNoticeArmed = true
    Jobs.delay(SKIP_NOTICE_DELAY, function()
        if not isLocked() then
            skipNoticeArmed = false
            return
        end
        pcall(Library.Notify, Library,
            "Some options in that config are premium only, so they were left switched off.", 7)
    end, { name = "PremiumSkipNotice" })
end

local function replay(entry)
    for name, call in pairs(entry.pending) do
        local orig = entry.originals[name]
        if orig then pcall(orig, entry.element, table.unpack(call, 1, call.n)) end
    end
    table.clear(entry.pending)
end

-- point every overlay at the current lock state, dropping dead ones, then release anything a config tried to set while the gate was shut
local function refresh()
    local shut = isLocked()
    for i = #overlays, 1, -1 do
        local ov = overlays[i]
        if not (ov and ov.Parent) then
            table.remove(overlays, i)
        else
            ov.Visible = shut
        end
    end
    if shut then return end
    skipNoticeArmed = false
    for _, entry in ipairs(gated) do replay(entry) end
end
M.refresh = refresh

function M.configure(opts)
    if type(opts) ~= "table" then return end
    if type(opts.isLocked) == "function" then lockPredicate = opts.isLocked end
    if type(opts.showPopup) == "function" then popupFn = opts.showPopup end
    refresh()
end

-- a premium callback no-ops while locked so keybinds and dependency boxes can't drive it either
local function guard(fn)
    if type(fn) ~= "function" then return fn end
    return function(...)
        if isLocked() then return end
        return fn(...)
    end
end

local function guardInfo(info)
    for _, key in ipairs(CALLBACKS) do
        if type(info[key]) == "function" then info[key] = guard(info[key]) end
    end
end

-- obsidian stores each element's mutators on the element table itself, so wrapping them there catches every write path: autoload, shared configs and scripted SetValue alike
local function gateValues(element)
    if type(element) ~= "table" or rawget(element, "__cerbPremium") then return end

    local entry = { element = element, originals = {}, pending = {} }
    for _, name in ipairs(MUTATORS) do
        local orig = rawget(element, name)
        if type(orig) == "function" then
            entry.originals[name] = orig
            element[name] = function(self, ...)
                if not isLocked() then return orig(self, ...) end
                entry.pending[name] = table.pack(...)
                noteSkipped()
            end
        end
    end
    if not next(entry.originals) then return end

    rawset(element, "__cerbPremium", true)
    gated[#gated + 1] = entry
end

