        if not self.panes[name] then
            self.order[#self.order + 1] = name
        end
        self.panes[name] = { factory = factory, frame = nil, ctrl = nil, built = false }
    end

    function shell:_buildTabButton(name, index)
        -- registry key stays english for internal lookups; tr() resolves the displayed label
        local btn = New("TextButton", {
            Name             = "Tab_" .. name,
            Size             = UDim2.fromOffset(120, 28),
            BackgroundColor3 = theme.Background,
            BackgroundTransparency = 1,
            BorderSizePixel  = 0,
            Text             = tr(name),
            Font             = Enum.Font.GothamMedium,
            TextSize         = 14,
            TextColor3       = theme.TextMuted,
            AutoButtonColor  = false,
            LayoutOrder      = index,
            Parent           = self.tabBar,
        })
        local underline = New("Frame", {
            Name             = "Underline",
            AnchorPoint      = Vector2.new(0.5, 1),
            Position         = UDim2.fromScale(0.5, 1),
            Size             = UDim2.new(0, 60, 0, 2),
            BackgroundColor3 = theme.Accent,
            BorderSizePixel  = 0,
            Visible          = false,
            Parent           = btn,
        })
        table.insert(self.connections, btn.Activated:Connect(function()
            self:SetActive(name)
        end))
        return btn, underline
    end

    function shell:_buildTabButtons()
        for i, name in ipairs(self.order) do
            if not self.tabButtons[name] then
                local btn, underline = self:_buildTabButton(name, i)
                self.tabButtons[name] = { button = btn, underline = underline }
            end
        end
    end

    function shell:_buildPane(name)
        local pane = self.panes[name]
        if not pane or pane.built then return pane end

        local frame = New("Frame", {
            Name             = "Pane_" .. name,
            Size             = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            BorderSizePixel  = 0,
            Visible          = false,
            Parent           = self.contentArea,
        })
        pane.frame = frame
        local ok, ctrl = pcall(pane.factory, frame, self.services)
        if not ok then
            Log.warn("[Cerberus.Configs] pane factory '" .. name .. "' threw: " .. tostring(ctrl))
            ctrl = nil
        end
        pane.ctrl = type(ctrl) == "table" and ctrl or {}
        pane.built = true
        return pane
    end

    function shell:SetActive(name)
        if not self.panes[name] then return end
        if self.active == name then return end

        local previous = self.active and self.panes[self.active]
        self.active = name

        for tabName, refs in pairs(self.tabButtons) do
            local isActive = (tabName == name)
            refs.button.TextColor3 = isActive and theme.Text or theme.TextMuted
            refs.underline.Visible = isActive
        end

        if previous and previous.frame then
            previous.frame.Visible = false
            if previous.ctrl and type(previous.ctrl.OnHide) == "function" then
                pcall(previous.ctrl.OnHide, previous.ctrl)
            end
        end

        local current = self:_buildPane(name)
        if current and current.frame then
            current.frame.Visible = true
            if current.ctrl and type(current.ctrl.OnShow) == "function" then
                pcall(current.ctrl.OnShow, current.ctrl)
            end
        end
    end

    function shell:Show()
        self:_buildOnce()
        self:_buildTabButtons()

        local first = self.active or self.order[1]
        if first and first ~= self.active then
            self:SetActive(first)
        elseif first then
            -- re-fire OnShow on the already-active pane so it refreshes data on every reopen
            local pane = self:_buildPane(first)
            if pane and pane.ctrl and type(pane.ctrl.OnShow) == "function" then
                pcall(pane.ctrl.OnShow, pane.ctrl)
            end
        end

        self.gui.Enabled = true
        self.opened = true

        -- fire viewport change so panes know their starting dimensions
        if self._fireViewport then self._fireViewport() end

        -- open animation: backdrop fades in, panel scales 0.92 → 1
        self.backdrop.BackgroundTransparency = 1
        self.panelScale.Scale = 0.92

        local fadeInfo = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(self.backdrop, fadeInfo, {
            BackgroundTransparency = theme.BackdropAlpha,
        }):Play()
        TweenService:Create(self.panelScale, fadeInfo, {
            Scale = 1,
        }):Play()
    end

    function shell:Hide()
        if not self.opened or not self.gui then return end
        self.opened = false

        local hideInfo = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        TweenService:Create(self.backdrop, hideInfo, {
            BackgroundTransparency = 1,
        }):Play()
        local panelTween = TweenService:Create(self.panelScale, hideInfo, {
            Scale = 0.92,
        })
        panelTween:Play()
        panelTween.Completed:Connect(function()
            if not self.opened and self.gui then
                self.gui.Enabled = false
            end
        end)

        if self.active then
            local pane = self.panes[self.active]
            if pane and pane.ctrl and type(pane.ctrl.OnHide) == "function" then
                pcall(pane.ctrl.OnHide, pane.ctrl)
            end
        end
    end

    function shell:Toggle()
        if self.opened then self:Hide() else self:Show() end
    end

    -- panes subscribe in their factory; callback fires per viewport change with the new Vector2 size
    function shell:OnViewportChange(cb)
        if type(cb) ~= "function" then return end
        self._viewportListeners[#self._viewportListeners + 1] = cb
        if self._fireViewport then self._fireViewport() end
    end

    return shell
end

end)
