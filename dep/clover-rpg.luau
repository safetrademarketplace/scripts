__bundle_register("UI/Build", function(require, _LOADED, __bundle_register, __bundle_modules)
-- shared instance-creation helpers for hand-built panels: New(class, props, children?), Round, Pad, Hoverable

local M = {}

function M.New(class, props, children)
    local inst = Instance.new(class)
    if type(props) == "table" then
        local parent = props.Parent
        for k, v in pairs(props) do
            if k ~= "Parent" then
                inst[k] = v
            end
        end
        if parent then inst.Parent = parent end
    end
    if type(children) == "table" then
        for _, child in ipairs(children) do
            if typeof(child) == "Instance" then child.Parent = inst end
        end
    end
    return inst
end

-- round corners + optional 1px border stroke attached to inst
function M.Round(inst, radius, strokeColor)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 6)
    corner.Parent = inst
    if strokeColor then
        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 1
        stroke.Color = strokeColor
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        stroke.Parent = inst
    end
end

-- uniform UIPadding on every side
function M.Pad(inst, px)
    local pad = Instance.new("UIPadding")
    pad.PaddingLeft   = UDim.new(0, px)
    pad.PaddingRight  = UDim.new(0, px)
    pad.PaddingTop    = UDim.new(0, px)
    pad.PaddingBottom = UDim.new(0, px)
    pad.Parent = inst
    return pad
end

-- hover feedback on a TextButton; returns the connections so callers can disconnect on tear-down
function M.Hoverable(button, baseColor, hoverColor)
    local conns = {}
    button.BackgroundColor3 = baseColor
    conns[#conns + 1] = button.MouseEnter:Connect(function()
        button.BackgroundColor3 = hoverColor
    end)
    conns[#conns + 1] = button.MouseLeave:Connect(function()
        button.BackgroundColor3 = baseColor
    end)
    return conns
end

return M

end)
