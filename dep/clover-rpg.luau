__bundle_register("UI/Place", function(require, _LOADED, __bundle_register, __bundle_modules)
-- place: builds a feature's groupbox or tabbox in the tab and column its tab file injected (env.Tab, env.Side), else in the feature's own fallback tab, so moving a box is a tab-file edit and no element id ever changes
local Identity = require("Utility/Identity")
local Log      = require("Utility/Log")

local M = {}

M.DEFAULT_FALLBACK = "Auto"
M.DEFAULT_SIDE     = "Left"

local SIDES = { left = "Left", right = "Right" }

local function sideName(value)
    if type(value) ~= "string" then return nil end
    return SIDES[value:lower()]
end

-- a tab file's value for one box: a plain value covers every box the feature builds, a table is box name -> value with [1] for the rest
local function injected(env, field, name)
    if type(env) ~= "table" then return nil end
    local value = env[field]
    if type(value) ~= "table" then return value end
    local named = nil
    if name ~= nil then named = value[name] end
    if named ~= nil then return named end
    return value[1]
end

local function injectedSide(env, name)
    return sideName(injected(env, "Side", name))
end

-- env.Collapsed the same way, so a tab file can start a moved box folded (or open) without touching the feature
local function injectedCollapsed(env, name)
    local collapsed = injected(env, "Collapsed", name)
    if type(collapsed) == "boolean" then return collapsed end
    return nil
end

local function describe(fallback)
    if type(fallback) == "table" then return table.concat(fallback, ", ") end
    return tostring(fallback)
end

-- the column a box goes in: the tab file's pick, else the feature's own default, else the left
function M.side(env, default, name)
    return injectedSide(env, name) or sideName(default) or M.DEFAULT_SIDE
end

-- the tab a box goes in and whether the tab file chose it; fallback is a tab key, or a list tried in order, and a missing tab is nil, never an error
function M.tab(env, fallback)
    if type(env) ~= "table" then return nil, false end
    if type(env.Tab) == "table" then return env.Tab, true end
    local tabs = env.Tabs
    if type(tabs) ~= "table" then return nil, false end
    if fallback == nil then fallback = M.DEFAULT_FALLBACK end
    local keys = type(fallback) == "table" and fallback or { fallback }
    for _, key in ipairs(keys) do
        local tab = type(key) == "string" and tabs[key] or nil
        if type(tab) == "table" then return tab, false end
    end
    return nil, false
end

-- a copy of env that hosts its feature in tab (and side), for the tab files; env itself is left alone since an orchestrator's ctx is shared
function M.host(env, tab, side, collapsed)
    local out = {}
    if type(env) == "table" then
        for key, value in pairs(env) do out[key] = value end
    end
    out.Tab = tab
    out.Side = side
    out.Collapsed = collapsed
    return out
end

local function build(env, kind, name, opts)
    local tab = M.tab(env, opts.fallback)
    if not tab then
        Log.devwarn("Place", "no tab to hold %s (tried %s)", tostring(name), describe(opts.fallback or M.DEFAULT_FALLBACK))
        return nil
    end
    local side = M.side(env, opts.side, name)
    local add = tab["Add" .. side .. kind]
    if type(add) ~= "function" then
        Log.devwarn("Place", "the tab for %s has no Add%s%s", tostring(name), side, kind)
        return nil
    end
    return tab, side, add
end

-- the groupbox, then the tab and side it went to; nil when no tab is there to hold it
function M.groupbox(env, name, icon, opts)
    opts = type(opts) == "table" and opts or {}
    local tab, side, add = build(env, "Groupbox", name, opts)
    if not tab then return nil end
    local collapsed = injectedCollapsed(env, name)
    if collapsed == nil then collapsed = opts.collapsed == true end
    -- a game call earlier in the feature's mount can drop the identity obsidian needs to build a box
    Identity.elevate()
    return add(tab, name, icon, opts.visible, collapsed, opts.noCollapse == true), tab, side
end

-- the tabbox (add pages with :AddTab(name, icon)), then the tab and side it went to; nil when no tab is there to hold it
function M.tabbox(env, name, opts)
    opts = type(opts) == "table" and opts or {}
    local tab, side, add = build(env, "Tabbox", name, opts)
    if not tab then return nil end
    Identity.elevate()
    return add(tab, name), tab, side
end

return M

end)
__bundle_register("Utility/Identity", function(require, _LOADED, __bundle_register, __bundle_modules)
-- thread identity: restores the executor thread to an identity that may create and touch gui instances, because a game-api call or a yield silently drops it mid-build

-- 8 is the level at which Instance.new and gui property writes are permitted; below it they throw
-- "lacking capability Plugin"
local TARGET = 8

local setter = setthreadidentity or set_thread_identity or setidentity
    or (syn and syn.set_thread_identity)
local getter = getthreadidentity or get_thread_identity or getidentity
    or (syn and syn.get_thread_identity)

local M = {}

M.supported = type(setter) == "function"

function M.current()
    if type(getter) ~= "function" then return nil end
    local ok, value = pcall(getter)
    return ok and value or nil
end

-- always sets, never trusts a read: the getter can report the target while the thread has already lost the
