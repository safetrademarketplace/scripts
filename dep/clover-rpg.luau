                break
            end
        end
    end

    local function unwatch(model)
        local entry = watched[model]
        if not entry then return end
        for _, conn in ipairs(entry.conns) do conn:Disconnect() end
        watched[model] = nil
        watchCount = watchCount - 1
    end

    local function watch(mob)
        if watched[mob.model] then return end
        local entry = { model = mob.model, root = mob.root, base = mob.baseName or mob.name, conns = {} }
        local model = mob.model
        local conns = entry.conns
        conns[#conns + 1] = model.AttributeChanged:Connect(function(attribute)
            if attribute ~= SWINGING and attribute ~= SKILL then return end
            if model:GetAttribute(attribute) ~= true then return end
            onTell(entry, attribute == SWINGING and "Swinging" or "SkillActive")
        end)
        local okAnimator, animator = pcall(function() return mob.humanoid:FindFirstChildOfClass("Animator") end)
        if okAnimator and animator then
            conns[#conns + 1] = animator.AnimationPlayed:Connect(function(track) onAnim(entry, track) end)
        end
