    if Localize.locale() == "en" then
        Log.print("[Cerberus/LocalizePatch] truncation sweep skipped (English passthrough mode)")
        truncateInstalled = true
        return
    end
    truncateInstalled = true
    local sg = Library.ScreenGui
    for _, d in ipairs(sg:GetDescendants()) do
        ensureTruncate(d)
    end
