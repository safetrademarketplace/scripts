__bundle_register("Features/Clover/SilentAim", function(require, _LOADED, __bundle_register, __bundle_modules)
-- spell silent aim: points the server's aim poll for your spells at the enemy nearest your mouse through the combat api's one aim override (mobs, players or both, inside an fov circle and a max distance, at the torso or head) and lets the game answer for itself whenever nothing qualifies
local Executor  = require("Utility/Executor")
local Identity  = require("Utility/Identity")
local Log       = require("Utility/Log")
local Mount     = require("Utility/Mount")
local Scheduler = require("Utility/Scheduler")
local Place     = require("UI/Place")
local FOV       = require("Features/Combat/Aimbot/FOV")
local Target    = require("Features/Clover/SilentAim/Target")

local TARGETS = { "Mobs", "Players" }
local PARTS   = { "Torso", "Head" }

local DEFAULT_FOV   = 200
local DEFAULT_RANGE = 250

-- what each refusal to install the aim means to a player, keyed by the combat api's own Errors names
local AIM_LINES = {
    BUSY       = "Something else is already aiming your spells. Turn it off first.",
    NO_AIM_API = "Your executor can't redirect spell aim, so this won't work.",
    NOT_READY  = "Spell aim isn't ready yet. Try again in a moment.",
}
local AIM_FALLBACK = "Couldn't turn on spell silent aim. Try again in a moment."

return function(ctx)
    local O = Mount.orchestrator(ctx, "SilentAim")
    if not O then return end

    local Api = ctx.Api
    local Combat = Api and Api.Combat
    local World  = Api and Api.World
    local State  = Api and Api.State
    if type(Combat) ~= "table" or type(World) ~= "table" or type(State) ~= "table" then
        Log.devwarn("SilentAim", "the combat, world or state api is missing, so spell silent aim won't load")
        return
    end

    local box = Place.groupbox(ctx, "Spell Silent Aim", "crosshair", { fallback = "Combat", side = "Right" })
    if not box then return end

    local Library   = ctx.Library
    local Services  = ctx.Services
    local UserInput = Services.UserInputService

    local settings = { mobs = true, players = false, fov = DEFAULT_FOV, range = DEFAULT_RANGE, part = PARTS[1] }
    local provider = Target.new({
        World     = World,
        State     = State,
        Workspace = Services.Workspace,
        UserInput = UserInput,
        settings  = settings,
    })

    -- the aimbot's own fov painter, handed the shape it reads (its on switch is called AimbotEnabled)
    local circle = {
        AimbotEnabled    = false,
        FOVCircleVisible = false,
        FOVCircle        = nil,
        FOV              = DEFAULT_FOV,
        FOVColor         = Color3.fromRGB(170, 140, 255),
        FOVFilled        = false,
        FOVTransparency  = 1,
    }
    local painter = FOV(circle, UserInput)
    local Drawing = Executor.get("Drawing")
    local canDraw = type(Drawing) == "table" and type(Drawing.new) == "function"

    local handle = nil
    local paintTask = nil
    local enabledToggle

    local function notify(text)
        Identity.elevate()
        pcall(Library.Notify, Library, text, 4)
    end

    local function explain(code)
        local errors = Combat.Errors
        if type(errors) == "table" and code ~= nil then
            for name, value in pairs(errors) do
                if value == code then return AIM_LINES[name] or AIM_FALLBACK end
            end
        end
        return AIM_FALLBACK
    end

    -- the drawing is made the first time the circle is wanted, so nobody who never shows it pays for one
    local function ensureCircle()
        if circle.FOVCircle then return true end
        if not canDraw then return false end
        local ok, drawing = pcall(Drawing.new, "Circle")
        if not ok or drawing == nil then
            Log.devwarn("SilentAim", "could not make the fov circle: %s", tostring(drawing))
            canDraw = false
            return false
        end
        drawing.Thickness = 1
        drawing.NumSides  = 64
        drawing.Filled    = false
        drawing.ZIndex    = 2
        drawing.Visible   = false
