__bundle_register("Features/Clover/PlayerUtils/AntiKnockback", function(require, _LOADED, __bundle_register, __bundle_modules)
-- anti knockback sub-module of clover utils: kills the LaunchBV mover the server drops into your root on a hit (the game's own dash removes it the same way) and keeps Client.Velocity pushes off your own character while the game's handler still runs for every other part
local Executor = require("Utility/Executor")
local Log      = require("Utility/Log")

local MOVER = "LaunchBV"

local TOOLTIP         = "Hits and spells won't knock you back."
local TOOLTIP_PARTIAL = "Hits won't knock you back. Your executor can't block every push, so some spells may still move you."

local function strip(child)
    if child.Name == MOVER and child:IsA("BodyMover") then
        -- zero it now so not even one frame pushes, then destroy once the parent change settles
        child.MaxForce = Vector3.zero
        task.defer(child.Destroy, child)
    end
end

return function(ctx)
    local Services   = ctx.Services
    local References = ctx.References
    local State      = ctx.Api and ctx.Api.State

    -- without it the LaunchBV half still works; only the Client.Velocity half is skipped
    local getconnections = Executor.get("getconnections")
    if type(getconnections) ~= "function" then getconnections = nil end

    local active = false
    local unsubscribe, rootConn, velocityConn = nil, nil, nil
    local gameHandlers = {}

    local function mine(part)
        local char = nil
        if State then
            local ok, value = State.character()
            if ok then char = value end
        else
            char = References.player.Character
        end
        return char ~= nil and part:IsDescendantOf(char)
    end

    local function hookVelocity()
        if velocityConn or not getconnections then return end
        local remotes = Services.ReplicatedStorage:FindFirstChild("Remotes")
        local client = remotes and remotes:FindFirstChild("Client")
        local velocity = client and client:FindFirstChild("Velocity")
        if not velocity then return end
        local ok, list = pcall(getconnections, velocity.OnClientEvent)
        if not ok or type(list) ~= "table" then
            Log.devwarn("CloverUtils", "anti knockback could not list the push handlers: %s", tostring(list))
            return
        end
        for _, conn in ipairs(list) do
            if conn.Function and pcall(function() conn:Disable() end) then
                gameHandlers[#gameHandlers + 1] = conn
            end
        end
        if #gameHandlers == 0 then return end
        velocityConn = velocity.OnClientEvent:Connect(function(origin, part, speed, ...)
            if typeof(part) == "Instance" and mine(part) then return end
            for _, conn in ipairs(gameHandlers) do
                -- the game's own handler, run the way its connection would have; it ends when its part does
                task.spawn(conn.Function, origin, part, speed, ...)
            end
        end)
        Log.dev("CloverUtils", "anti knockback took over %d push handlers", #gameHandlers)
    end

    local function unhookVelocity()
        if velocityConn then
            velocityConn:Disconnect()
            velocityConn = nil
        end
        for _, conn in ipairs(gameHandlers) do
            pcall(function() conn:Enable() end)
        end
        table.clear(gameHandlers)
    end

    local function watch(char)
        if rootConn then
            rootConn:Disconnect()
            rootConn = nil
        end
        -- the remote may not have replicated when the toggle went on, so each spawn looks again
        hookVelocity()
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        for _, child in ipairs(root:GetChildren()) do strip(child) end
        rootConn = root.ChildAdded:Connect(strip)
    end

    local function set(on)
        on = on == true
        if on == active then return end
        active = on
        if on then
            hookVelocity()
            -- fires at once for the current character, then on every respawn
            unsubscribe = References.onCharacter(watch)
            return
        end
        if unsubscribe then
            unsubscribe()
            unsubscribe = nil
        end
        if rootConn then
            rootConn:Disconnect()
            rootConn = nil
        end
        unhookVelocity()
    end

    ctx.CloverGroup:AddToggle("CloverAntiKnockback", {
        Text     = "Anti Knockback",
        Default  = false,
        Tooltip  = getconnections and TOOLTIP or TOOLTIP_PARTIAL,
        Callback = set,
    })

    return { cleanup = function() set(false) end }
end

end)
__bundle_register("Features/Clover/PlayerUtils/AirDash", function(require, _LOADED, __bundle_register, __bundle_modules)
-- air dash sub-module of clover utils: while you're in the air, the game's normal roll (which still sends the server the same plain roll) runs the game's own air dash instead, a short burst toward your cursor; every character builds its own dash module, so each spawn is patched again
