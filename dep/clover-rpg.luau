        if handle and not handle.active() then handle = nil end
        if on == true and handle == nil then
            local ok, result = Combat.setAim(provider)
            if not ok then
                notify(explain(result))
                -- the switch goes back off; its callback lands here again with nothing to clear
                Identity.elevate()
                pcall(enabledToggle.SetValue, enabledToggle, false)
                return
            end
            handle = result
        elseif on ~= true then
            release()
        end
        circle.AimbotEnabled = handle ~= nil
        syncCircle()
    end

    enabledToggle = box:AddToggle("SilentAimEnabled", {
        Text     = "Spell Silent Aim",
        Default  = false,
        Tooltip  = "Your aimed spells hit the enemy nearest your mouse",
        Callback = setEnabled,
    })

    local options = box:AddDependencyBox()
    options:AddDropdown("SilentAimTargets", {
        Text     = "Targets",
        Values   = TARGETS,
        Default  = { "Mobs" },
        Multi    = true,
        Tooltip  = "Who your spells can lock onto.",
        Callback = function(value)
            value = type(value) == "table" and value or {}
            settings.mobs = value.Mobs == true
            settings.players = value.Players == true
        end,
    })
    options:AddDropdown("SilentAimPart", {
        Text     = "Aim At",
        Values   = PARTS,
        Default  = PARTS[1],
        Tooltip  = "Which part of the enemy your spells aim for.",
        Callback = function(value)
            if Target.PARTS[value] then settings.part = value end
        end,
    })
    options:AddSlider("SilentAimFOV", {
        Text     = "FOV Size",
        Default  = DEFAULT_FOV,
        Min      = 25,
        Max      = 600,
        Rounding = 0,
        Suffix   = " px",
        Tooltip  = "How close to your mouse an enemy has to be. Only enemies inside this circle are aimed at.",
        Callback = function(value)
            local radius = tonumber(value) or DEFAULT_FOV
            settings.fov = radius
            circle.FOV = radius
        end,
    })
    options:AddSlider("SilentAimRange", {
        Text     = "Max Distance",
        Default  = DEFAULT_RANGE,
        Min      = 25,
        Max      = 1000,
        Rounding = 0,
        Suffix   = " studs",
        Tooltip  = "How far away an enemy can be and still be aimed at.",
        Callback = function(value)
            settings.range = tonumber(value) or DEFAULT_RANGE
        end,
    })
    options:AddToggle("SilentAimShowFOV", {
        Text            = "Show FOV Circle",
        Default         = false,
        Tooltip         = "Draws the aim circle around your mouse so you can see where spells will lock on.",
        Disabled        = not canDraw,
        DisabledTooltip = "Your executor can't draw this circle.",
        Callback        = function(on)
            circle.FOVCircleVisible = on == true
            syncCircle()
        end,
    })
    options:SetupDependencies({
        { enabledToggle, true },
    })

    -- the aim goes back while the combat api is still open, which the session's reverse-order unload guarantees
    O.onUnload(function()
        release()
        circle.AimbotEnabled = false
        if paintTask then
            paintTask:Disconnect()
            paintTask = nil
        end
        if circle.FOVCircle then
            pcall(circle.FOVCircle.Remove, circle.FOVCircle)
            circle.FOVCircle = nil
        end
    end)
    O.finalize()
end

end)
__bundle_register("Features/Clover/SilentAim/Target", function(require, _LOADED, __bundle_register, __bundle_modules)
-- silent aim target choice: the enemy whose aim point sits nearest the cursor on screen, inside the fov circle and the range, read from the world api's live mob and player indexes; it only ever hands back a part of that enemy's own model, or nothing so the game answers for itself
local M = {}

-- r15 names first, then r6; a rig with neither is aimed at through its root
local PARTS = {
    Torso = { "UpperTorso", "Torso" },
    Head  = { "Head" },
}

M.PARTS = PARTS

local function isPart(value)
    return typeof(value) == "Instance" and value:IsA("BasePart")
end

local function aimPart(model, root, names)
    for _, name in ipairs(names) do
        local part = model:FindFirstChild(name)
        if isPart(part) then return part end
    end
    return root
end

-- deps: World, State, Workspace, UserInput, settings (read live: mobs, players, fov, range, part)
function M.new(deps)
    local World, State, Workspace, UserInput = deps.World, deps.State, deps.Workspace, deps.UserInput
    local settings = deps.settings

    -- provider() -> (position, part) or nil, the shape Combat.setAim asks for
    return function()
        if not (settings.mobs or settings.players) then return nil end
        local camera = Workspace.CurrentCamera
        if camera == nil then return nil end
        local okRoot, root = State.root()
        if not okRoot or root == nil then return nil end

        local filter = { alive = true, origin = root.Position, maxDistance = settings.range }
        local names = PARTS[settings.part] or PARTS.Torso
        local mouse = UserInput:GetMouseLocation()
        local fov = settings.fov
        local best, bestGap = nil, nil

        local function consider(model, rootPart)
            if typeof(model) ~= "Instance" or not isPart(rootPart) then return end
            local part = aimPart(model, rootPart, names)
            -- viewport space matches GetMouseLocation: both include the top bar
            local screen, visible = camera:WorldToViewportPoint(part.Position)
            if not visible then return end
            local gap = (Vector2.new(screen.X, screen.Y) - mouse).Magnitude
            if gap <= fov and (bestGap == nil or gap < bestGap) then best, bestGap = part, gap end
        end

        if settings.mobs then
            local ok, list = World.mobs(filter)
            if ok then
                for _, entry in ipairs(list) do consider(entry.model, entry.root) end
            end
        end
        if settings.players then
            local ok, list = World.players(filter)
            if ok then
                for _, entry in ipairs(list) do consider(entry.character, entry.root) end
            end
        end

        if best == nil then return nil end
        return best.Position, best
    end
end

return M

end)
