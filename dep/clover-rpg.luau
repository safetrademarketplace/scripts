__bundle_register("Features/Clover/Notifications/Personal", function(require, _LOADED, __bundle_register, __bundle_modules)
-- alerts, you: your health dropping below a line (told once, again only after it climbs back), the items you drop when you die (a place the go-to button can head back to), your level and profession levels rising, and your reputation changing
local Scheduler         = require("Utility/Scheduler")
local LevelUp           = require("Api/Webhook/Events/LevelUp")
local ProfessionLevelUp = require("Api/Webhook/Events/ProfessionLevelUp")
local Watch             = require("Api/Webhook/Events/Watch")
local Words             = require("Api/Webhook/Events/Words")

local HEALTH_EVERY = 0.25
-- health has to climb this many percent back over the line before a new drop is told
local HEALTH_REARM = 5
-- MapService.lua:793-871: a Vector3 player attribute per bag of dropped items, cleared once it is gone
local BAG_PREFIX = "DeathBag_"
-- NotifyClient.lua:560-570: a RemoteEvent parented to the player
local REPUTATION = "ReputationChanged"
local REPUTATION_AGAIN = 3
local LEVEL_TOLD_FOR = 600

local M = {}

M.HEALTH_REARM = HEALTH_REARM

-- deps = { Api, References, feed }
function M.new(deps)
    local Api, References, feed = deps.Api, deps.References, deps.feed
    local source = {}

    local healthTick, line = nil, 30
    local armed = true

    local function lookHealth()
        local State = Api.State
        if State == nil then return end
        local ok, vitals = State.vitals()
        if not ok or type(vitals) ~= "table" or not vitals.maxHealth or vitals.maxHealth <= 0 then return end
        local percent = vitals.health / vitals.maxHealth * 100
        if percent >= line + HEALTH_REARM or percent <= 0 then
            -- back over the line, or dead (a respawn starts full): the next drop is news again
            armed = true
            return
        end
        if not armed or percent >= line then return end
        armed = false
        feed.post({
            kind  = "lowHealth",
            text  = ("Your health is low: %d%% (%s of %s)."):format(
                math.floor(percent + 0.5), Words.number(math.floor(vitals.health + 0.5)), Words.number(math.floor(vitals.maxHealth + 0.5))),
            title = "Low Health",
        })
    end

    function source.setLowHealth(on)
        if on and healthTick == nil then
            armed = true
            healthTick = Scheduler.heartbeat(lookHealth, { interval = HEALTH_EVERY, name = "Alerts.lowHealth" })
        elseif not on and healthTick ~= nil then
            healthTick:Disconnect()
            healthTick = nil
        end
    end

    function source.setLine(percent)
        line = math.max(1, math.min(99, tonumber(percent) or line))
    end

    local bagConn = nil

    local function bagPlace(name)
        local player = References.player
        return {
            key    = name,
            label  = "your dropped items",
            check  = function()
                if typeof(player:GetAttribute(name)) ~= "Vector3" then
                    return false, "your dropped items are gone (picked up or cleared)"
                end
                return true
            end,
            target = function() return player:GetAttribute(name) end,
        }
    end

    local function onAttribute(name)
        if string.sub(name, 1, #BAG_PREFIX) ~= BAG_PREFIX then return end
        local position = References.player:GetAttribute(name)
        if typeof(position) ~= "Vector3" then
            feed.forget("deathBag", name)
            return
        end
        local where = Words.where(position)
        feed.post({
            kind     = "deathBag",
            subject  = name,
            cooldown = math.huge,
            text     = where and ("You dropped your items in %s. Press Go To Latest Alert to head back to them."):format(where)
                or "You dropped your items. Press Go To Latest Alert to head back to them.",
            title    = "Items Dropped",
            place    = bagPlace(name),
        })
    end

    function source.setDeathBags(on)
        local player = References.player
        if on and bagConn == nil and player ~= nil then
            local places = {}
            for name, value in pairs(player:GetAttributes()) do
                if string.sub(name, 1, #BAG_PREFIX) == BAG_PREFIX and typeof(value) == "Vector3" then
                    feed.mark("deathBag", name, math.huge)
                    feed.remember(bagPlace(name))
                    places[#places + 1] = Words.where(value) or "somewhere unknown"
                end
            end
            if #places > 0 then
                feed.notify(("You have dropped items waiting in %s."):format(Words.list(places)))
            end
            bagConn = player.AttributeChanged:Connect(onAttribute)
        elseif not on and bagConn ~= nil then
            bagConn:Disconnect()
            bagConn = nil
        end
    end

    local levelHandles = nil

    local function onLevel(rise)
        local facts = LevelUp.facts(rise)
        local gained = (rise.level or 0) - (rise.from or 0)
        feed.post({
            kind     = "level",
            subject  = rise.level,
            cooldown = LEVEL_TOLD_FOR,
            text     = gained > 1 and ("Level up! You're now level %s (up %d)."):format(Words.number(rise.level), gained)
                or ("Level up! You're now level %s."):format(Words.number(rise.level)),
            event    = LevelUp,
            facts    = facts,
        })
    end

    local function onProfession(rise)
        local facts = ProfessionLevelUp.facts(rise)
        feed.post({
            kind     = "profession",
            subject  = ProfessionLevelUp.subject(facts),
            cooldown = LEVEL_TOLD_FOR,
            text     = ("Your %s went up to level %s."):format(facts.profession, Words.number(rise.level)),
            event    = ProfessionLevelUp,
            facts    = facts,
        })
    end

    function source.setLevels(on)
        if on and levelHandles == nil then
            levelHandles = { Watch.levels(onLevel), Watch.professions(onProfession) }
        elseif not on and levelHandles ~= nil then
            for _, watch in ipairs(levelHandles) do watch:Disconnect() end
            levelHandles = nil
        end
    end

    local repHandle = nil

    local function onReputation(_, message, value, increment)
        local shown = Words.plain(message)
        local numbers = {}
        if tonumber(increment) then numbers[#numbers + 1] = Words.signed(increment) end
        if tonumber(value) then numbers[#numbers + 1] = "now " .. Words.number(value) end
        local text = shown and ("Your reputation changed: %s"):format(shown) or "Your reputation changed"
        if #numbers > 0 then text = ("%s (%s)"):format(text, table.concat(numbers, ", ")) end
        feed.post({
            kind     = "reputation",
            subject  = text,
            cooldown = REPUTATION_AGAIN,
            text     = text .. ".",
            title    = "Reputation Changed",
        })
    end

    function source.setReputation(on)
        if on and repHandle == nil then
            repHandle = Watch.follow("reputation", function()
                local player = References.player
                local remote = player and player:FindFirstChild(REPUTATION)
                if remote ~= nil and remote:IsA("RemoteEvent") then return remote end
                return nil
            end, function(remote, links)
                links:GiveTask(remote.OnClientEvent:Connect(onReputation))
            end)
        elseif not on and repHandle ~= nil then
            repHandle:Disconnect()
            repHandle = nil
        end
    end

    function source.stop()
        source.setLowHealth(false)
        source.setDeathBags(false)
        source.setLevels(false)
        source.setReputation(false)
    end

    return source
end

return M

end)
__bundle_register("Features/Clover/Notifications/People", function(require, _LOADED, __bundle_register, __bundle_modules)
-- alerts, other players: staff in your server (Utility/Staff's shared check, the same one mod safety uses), another player coming within range (once per approach, again only after they leave it) and players joining or leaving; you yourself are never news
local Scheduler   = require("Utility/Scheduler")
local Staff       = require("Utility/Staff")
local StaffJoined = require("Api/Webhook/Events/StaffJoined")
local Words       = require("Api/Webhook/Events/Words")

local NEAR_EVERY = 0.5
-- past the range by a tenth of it (at least NEAR_SLACK_MIN studs) or unseen this long counts as gone
local NEAR_SLACK = 0.1
local NEAR_SLACK_MIN = 15
local NEAR_GONE_AFTER = 3
-- joins and leaves inside one beat share a notice once there are more than this many
local ROSTER_EVERY = 0.5
local ROSTER_SINGLES = 2
local ROSTER_AGAIN = 10
local STAFF_AGAIN = 60

local M = {}

M.NEAR_GONE_AFTER = NEAR_GONE_AFTER

function M.slack(range)
    return math.max(NEAR_SLACK_MIN, range * NEAR_SLACK)
end

local function userIdOf(player)
    local ok, id = pcall(function() return player.UserId end)
    if ok and type(id) == "number" then return id end
    return nil
end

local function nameOf(player)
    local okName, name = pcall(function() return player.Name end)
    local okShown, shown = pcall(function() return player.DisplayName end)
    return Words.player(okName and name or nil, okShown and shown or nil)
end

local function studs(distance)
    return math.floor((tonumber(distance) or 0) + 0.5)
end

-- deps = { Api, Services, References, feed, clock }
function M.new(deps)
    local Api, Services, References, feed = deps.Api, deps.Services, deps.References, deps.feed
    local clock = deps.clock or os.clock
    local source = {}

    local function isMe(player)
        local me = References.player
        local mine, theirs = me and userIdOf(me), userIdOf(player)
        return mine ~= nil and mine == theirs
    end

    local staffHandle = nil

    local function onStaff(info)
        local facts = StaffJoined.facts(info)
        local role = Words.capital(facts.role)
        local text = facts.joined and ("%s joined the server: %s"):format(role, facts.player)
            or ("%s is in this server: %s"):format(role, facts.player)
        return feed.post({
            kind     = "staff",
            subject  = facts.userId,
            cooldown = STAFF_AGAIN,
            text     = text,
            long     = true,
            event    = StaffJoined,
            facts    = facts,
        })
    end

    function source.setStaff(on)
        if on and staffHandle == nil then
            local told = 0
            staffHandle = Staff.watch(function(info)
                if onStaff(info) then told = told + 1 end
            end)
            -- the id lists answer at once; group ranks take a moment, so "so far"
            if told == 0 then feed.notify("Staff alerts are on. No staff found in this server so far.") end
        elseif not on and staffHandle ~= nil then
            staffHandle:Disconnect()
            staffHandle = nil
        end
    end

    local nearTick, range = nil, 100
    -- userId -> clock of the last look that saw them in range (with slack)
    local inside = {}

    local function nearList()
        local World, State = Api.World, Api.State
        if World == nil or State == nil then return nil end
        local okRoot = State.root()
        if not okRoot then return nil end
        local ok, list = World.players({ maxDistance = range + M.slack(range) })
        if not ok then return nil end
        return list
    end

    local function lookNear(fromSwitch)
        local list = nearList()
        -- nothing expires while you have no position to measure from
        if list == nil then return end
        local now = clock()
        local arrived = {}
        for _, entry in ipairs(list) do
            local id = userIdOf(entry.player)
            if id ~= nil and not isMe(entry.player) then
                if inside[id] ~= nil then
                    inside[id] = now
                elseif (entry.distance or math.huge) <= range then
                    inside[id] = now
                    arrived[#arrived + 1] = entry
                end
            end
        end
        for id, seen in pairs(inside) do
            if now - seen >= NEAR_GONE_AFTER then inside[id] = nil end
        end
        if fromSwitch then
            local names = {}
            for _, entry in ipairs(arrived) do names[#names + 1] = ("%s (%d studs)"):format(nameOf(entry.player), studs(entry.distance)) end
            if #names == 0 then
                return feed.notify(("Player alerts are on. Nobody is within %d studs of you right now."):format(studs(range)))
            end
            return feed.notify(("Player alerts are on. Within %d studs right now: %s."):format(studs(range), Words.list(names)))
        end
        -- no subject: the inside set is what tells each approach once
        for _, entry in ipairs(arrived) do
            feed.post({
                kind  = "near",
                text  = ("%s came near you, %d studs away."):format(nameOf(entry.player), studs(entry.distance)),
                title = "Player Came Near",
            })
        end
    end

    function source.setNear(on)
        if on and nearTick == nil then
            inside = {}
            lookNear(true)
            nearTick = Scheduler.heartbeat(function() lookNear(false) end, { interval = NEAR_EVERY, name = "Alerts.near" })
        elseif not on and nearTick ~= nil then
            nearTick:Disconnect()
            nearTick = nil
            inside = {}
        end
    end

    function source.setRange(value)
        range = math.max(1, tonumber(value) or range)
    end

    local joinConn, leaveConn, rosterTick = nil, nil, nil
    local joined, left = {}, {}

    local function playerCount()
        local ok, list = pcall(function() return Services.Players:GetPlayers() end)
        if ok and type(list) == "table" then return #list end
        return nil
    end

    local function hereNow()
        local n = playerCount()
        if n == nil then return "" end
        return (" %s here now."):format(n == 1 and "1 player is" or (n .. " players are"))
    end

    local function postRoster(name, id, verb)
        return feed.post({
            kind     = "joinLeave",
            subject  = ("%s:%s"):format(verb, tostring(id or name)),
            cooldown = ROSTER_AGAIN,
            text     = ("%s %s the server.%s"):format(name, verb, hereNow()),
            title    = verb == "joined" and "Player Joined" or "Player Left",
        })
    end

    local function flushRoster()
        local ins, outs = joined, left
        if #ins + #outs == 0 then return end
        joined, left = {}, {}
        if #ins + #outs <= ROSTER_SINGLES then
            for _, entry in ipairs(ins) do postRoster(entry.name, entry.id, "joined") end
            for _, entry in ipairs(outs) do postRoster(entry.name, entry.id, "left") end
            return
        end
        local function names(list)
            local out = {}
            for _, entry in ipairs(list) do out[#out + 1] = entry.name end
            return Words.list(out, 4)
        end
        local parts = {}
        if #ins > 0 then parts[#parts + 1] = ("Joined: %s."):format(names(ins)) end
        if #outs > 0 then parts[#parts + 1] = ("Left: %s."):format(names(outs)) end
        local text = table.concat(parts, " ") .. hereNow()
        feed.post({ kind = "joinLeave", subject = text, cooldown = ROSTER_AGAIN, text = text, title = "Players Joined And Left" })
    end

    function source.setJoinLeave(on)
        if on and rosterTick == nil then
            joined, left = {}, {}
            joinConn = Services.Players.PlayerAdded:Connect(function(player)
                if not isMe(player) then joined[#joined + 1] = { name = nameOf(player), id = userIdOf(player) } end
            end)
            leaveConn = Services.Players.PlayerRemoving:Connect(function(player)
                if not isMe(player) then left[#left + 1] = { name = nameOf(player), id = userIdOf(player) } end
            end)
            rosterTick = Scheduler.heartbeat(flushRoster, { interval = ROSTER_EVERY, name = "Alerts.joinLeave" })
            local n = playerCount()
            local okMax, cap = pcall(function() return Services.Players.MaxPlayers end)
            if n and okMax and tonumber(cap) then
                feed.notify(("Join and leave alerts are on. %d of %d players are here."):format(n, cap))
            else
                feed.notify("Join and leave alerts are on.")
            end
        elseif not on and rosterTick ~= nil then
            rosterTick:Disconnect()
            joinConn:Disconnect()
            leaveConn:Disconnect()
            rosterTick, joinConn, leaveConn = nil, nil, nil
            joined, left = {}, {}
        end
    end

    function source.stop()
        source.setStaff(false)
        source.setNear(false)
        source.setJoinLeave(false)
    end

    return source
end

return M

end)
__bundle_register("Features/Clover/Notifications/Feed", function(require, _LOADED, __bundle_register, __bundle_modules)
-- alerts feed: pops each alert up (for the chosen time, with the game's own alert sound when asked), lets each subject through once per cooldown, forwards it to the webhook when asked, and remembers the alerts that lead somewhere so the go-to button can head for the newest one still there through the movement api
local Identity = require("Utility/Identity")
local Log      = require("Utility/Log")
local Alerts   = require("Api/Webhook/Events/Alerts")
local Watch    = require("Api/Webhook/Events/Watch")
local Words    = require("Api/Webhook/Events/Words")

-- how many places the go-to button can fall back through
local HISTORY = 10
local DEFAULT_TIME = 6
local DEFAULT_COOLDOWN = 10
-- how close the trip stops to what it heads for
local REACH = 8
local OWNER = "Alerts"
-- the game's own alert sound, the one its quest and item alerts play (QuestClient.lua:861, InventoryListener.lua:42)
local SOUND_PATH = { "SFX", "Misc", "Alert" }
local SOUND_VOLUME = 1
-- the universal join and leave post already covers that alert when it is ticked
local JOIN_LEAVE_EVENT = "PlayerJoinLeave"

local MOVE_WORDS = {
    ["movement/not_ready"]    = "Moving isn't ready yet. Try again in a moment.",
    ["movement/no_character"] = "Your character isn't loaded right now.",
    ["movement/no_path"]      = "Couldn't find a way there.",
    ["movement/blocked"]      = "The way there is blocked.",
    ["movement/corrected"]    = "The game kept pulling you back, so the trip stopped.",
    ["movement/interrupted"]  = "The game moved you, so the trip stopped.",
    ["movement/died"]         = "You died on the way.",
    ["movement/respawned"]    = "You respawned, so the trip stopped.",
    ["movement/timed_out"]    = "It took too long to get there.",
}
local MOVE_FALLBACK = "Couldn't get there. Try again in a moment."

local M = {}

M.REACH = REACH
M.OWNER = OWNER
M.HISTORY = HISTORY

-- deps = { Library, Services, Api, settings = { time, sound, webhook }, clock }
function M.new(deps)
    local Api, settings = deps.Api, deps.settings
    local feed = {}
    local seen = Watch.ledger(deps.clock)
    -- newest first, one per key: { key, label, check() -> there, why, target }
    local places = {}
    local token, trip = nil, 0
    local soundId = nil

    local function sound()
        if soundId ~= nil then return soundId end
        local node = deps.Services.ReplicatedStorage
        for _, name in ipairs(SOUND_PATH) do
            node = node and node:FindFirstChild(name)
        end
        if node ~= nil and node:IsA("Sound") and type(node.SoundId) == "string" and node.SoundId ~= "" then
            soundId = node.SoundId
        end
        return soundId
    end

    -- most alerts arrive on a game signal or a job thread, either of which can lack the identity a notification needs
    function feed.notify(text, seconds)
        Identity.elevate()
        local id = nil
        if settings.sound then id = sound() end
        local ok, err = pcall(function()
            deps.Library:Notify(text, seconds or settings.time or DEFAULT_TIME, id, id and SOUND_VOLUME or nil)
        end)
        if not ok then Log.devwarn("Alerts", "a notice failed: %s", tostring(err)) end
    end

    function feed.remember(place)
        if type(place) ~= "table" or place.key == nil then return end
        for index = #places, 1, -1 do
            if places[index].key == place.key then table.remove(places, index) end
        end
        table.insert(places, 1, place)
        places[HISTORY + 1] = nil
    end

    -- claims a subject without a notice, for what a switch-on summary already named
    function feed.mark(kind, subject, cooldown)
        seen.first(kind, subject, cooldown or DEFAULT_COOLDOWN)
    end

    function feed.forget(kind, subject)
        seen.forget(kind, subject)
    end

    -- the matching clover post, else "other alerts"; only kinds ticked in the webhook box go out
    function feed.forward(alert)
        if not settings.webhook then return false end
        local Webhook = Api.Webhook
        if Webhook == nil then return false end
        local event, facts = alert.event, alert.facts
        if event == nil then
            if alert.kind == "joinLeave" and Webhook.IsEventEnabled(JOIN_LEAVE_EVENT) then return false end
            event = Alerts
            facts = { title = alert.title, text = alert.text, subject = alert.kind .. ":" .. alert.text }
        end
        if not Webhook.IsEventEnabled(event.key) then return false end
        return Watch.post(function(spec) return Webhook.Emit(event.key, spec) end, event, facts)
    end

    -- alert = { kind, subject, cooldown, text, long, place, event, facts, title }; false when its subject was told too recently
    function feed.post(alert)
        if alert.subject ~= nil and not seen.first(alert.kind, alert.subject, alert.cooldown or DEFAULT_COOLDOWN) then
            return false
        end
        local seconds = settings.time or DEFAULT_TIME
        if alert.long then seconds = seconds * 2 end
        feed.notify(alert.text, seconds)
        if alert.place then feed.remember(alert.place) end
        local ok, err = pcall(feed.forward, alert)
        if not ok then Log.devwarn("Alerts", "a webhook forward failed: %s", tostring(err)) end
        return true
    end

    function feed.size()
        return #places
    end

    local function release()
        local held = token
        token = nil
        local Movement = Api.Movement
        if held ~= nil and Movement ~= nil then Movement.release(held) end
    end

    local function busyLine(Movement)
        local ok, owner = Movement.owner()
        if ok and type(owner) == "string" and owner ~= "" then
            return ("%s is moving your character right now. Try again once it's done."):format(owner)
        end
        return "Something else is moving your character right now. Try again once it's done."
    end

    -- the movement api is the only thing that moves the character; a held claim is reused, so a second press heads somewhere new
    local function go(place, lead)
        local Movement = Api.Movement
        if Movement == nil then return feed.notify("Moving isn't available right now.") end
        if token == nil then
            local ok, claimed = Movement.claim(OWNER)
            if not ok then
                if claimed == Movement.Errors.BUSY then return feed.notify(busyLine(Movement)) end
                return feed.notify(MOVE_WORDS[claimed] or MOVE_FALLBACK)
            end
            token = claimed
        end
        trip = trip + 1
        local mine = trip
        local ok, err = Movement.moveTo(place.target, {
            token  = token,
            reach  = REACH,
            onDone = function(arrived, reason)
                if mine ~= trip then return end
                release()
                if arrived then
                    feed.notify(("You reached %s."):format(place.label))
                elseif reason ~= Movement.Errors.CANCELLED then
                    feed.notify(MOVE_WORDS[reason] or MOVE_FALLBACK)
                end
            end,
        })
        if not ok then
            trip = trip + 1
            release()
            return feed.notify(MOVE_WORDS[err] or MOVE_FALLBACK)
        end
        feed.notify(Words.capital(("%sheading to %s."):format(lead, place.label)))
    end

    local function still(place)
        local ok, there, why = pcall(place.check)
        if not ok then return false, nil end
        return there == true, why
    end

    -- emptyLine is what to say when nothing that leads somewhere has been told yet
    function feed.goToLatest(emptyLine)
        if #places == 0 then return feed.notify(emptyLine) end
        local newestWhy = nil
        for index, place in ipairs(places) do
            local there, why = still(place)
            if there then
                local lead = ""
                if index > 1 then
                    lead = (newestWhy or ("%s is gone"):format(places[1].label)) .. ", so you're "
                end
                return go(place, lead)
            end
            if index == 1 then newestWhy = why end
        end
        local line = Words.capital((newestWhy or ("%s is gone"):format(places[1].label)) .. ".")
        if #places > 1 then line = line .. " Nothing else an alert told you about is still there." end
        feed.notify(line)
    end

    function feed.stop()
        trip = trip + 1
        release()
        places = {}
        seen.clear()
    end

    return feed
end

return M

end)
__bundle_register("Features/Clover/Notifications/Bosses", function(require, _LOADED, __bundle_register, __bundle_modules)
-- alerts, bosses: a notice when a boss the game has loaded near you appears (only the picked ones, or every boss), each a place the go-to button can head for while it lives, plus the pick list (the world's mob names that the bestiary marks as bosses)
local Log         = require("Utility/Log")
local BossSpawned = require("Api/Webhook/Events/BossSpawned")
local Words       = require("Api/Webhook/Events/Words")
local Catalog     = require("Api/World/Catalog")

-- a boss streaming out and back in is the same model, so it is told once while that model lives
local TOLD_FOR = 1800
local ROOT = "HumanoidRootPart"

local M = {}

M.TOLD_FOR = TOLD_FOR

function M.new(deps)
    local Api, feed = deps.Api, deps.feed
    local source = {}
    -- name -> true for the bosses picked, nil for every boss
    local picked = nil
    local listener = nil
    local catalog = nil

    local function wanted(name)
        return picked == nil or picked[name] == true
    end

    local function place(entry)
        local model = entry.model
        local label = Words.plain(entry.name) or "the boss"
        local last = entry.position
        return {
            key    = model,
            label  = label,
            check  = function()
                if model.Parent == nil then return false, ("%s is gone"):format(label) end
                local humanoid = model:FindFirstChildOfClass("Humanoid")
                if humanoid ~= nil and humanoid.Health <= 0 then return false, ("%s has been defeated"):format(label) end
                return true
            end,
            -- follows the boss while its body is loaded, else heads for where it was last seen
            target = function()
                local root = model:FindFirstChild(ROOT)
                if root ~= nil then last = root.Position end
                return last
            end,
        }
    end

    local function line(facts)
        local name = Words.plain(facts.name) or "a boss"
        if facts.where then return ("A boss appeared: %s (%s)"):format(name, facts.where) end
        return ("A boss appeared: %s"):format(name)
    end

    local function onAdded(entry)
        if type(entry) ~= "table" or not entry.boss or not wanted(entry.name) then return end
        local facts = BossSpawned.facts(entry)
        feed.post({
            kind     = "boss",
            subject  = entry.model,
            cooldown = TOLD_FOR,
            text     = line(facts),
            place    = entry.position and place(entry) or nil,
            event    = BossSpawned,
            facts    = facts,
        })
    end

    -- bosses already loaded never appear while it watches, so they are named once here and remembered as places
    local function summary(World)
        local ok, list = World.mobs({ bossOnly = true, alive = true })
        local names = {}
        if ok then
            for index = #list, 1, -1 do
                local entry = list[index]
                if wanted(entry.name) then
                    feed.mark("boss", entry.model, TOLD_FOR)
                    if entry.position then feed.remember(place(entry)) end
                    local where = Words.where(entry.position)
                    local name = Words.plain(entry.name) or "a boss"
                    table.insert(names, 1, where and ("%s (%s)"):format(name, where) or name)
                end
            end
        end
        if #names == 0 then
            return feed.notify("Boss alerts are on. No boss is loaded near you right now. "
                .. "Only bosses near enough for the game to load are seen.")
        end
        feed.notify(("Boss alerts are on. Near you right now: %s."):format(Words.list(names)))
    end

    function source.set(on)
        local World = Api.World
        if on and listener == nil and World ~= nil then
            summary(World)
            listener = World.onMobAdded:Connect(onAdded)
        elseif not on and listener ~= nil then
            listener:Disconnect()
            listener = nil
        end
    end

    -- the names picked, or nil (or an empty pick) for every boss
    function source.setPicked(set)
        local out = nil
        for name, on in pairs(set or {}) do
            if on then
                out = out or {}
                out[name] = true
            end
        end
        picked = out
    end

    function source.names()
        local World = Api.World
        if World == nil then return {} end
        local ok, all = World.mobNames()
        if not ok or type(all) ~= "table" then return {} end
        catalog = catalog or Catalog.new(function(message, ...) Log.devwarn("Alerts", message, ...) end)
        local bosses = {}
        local okBeasts, beasts = pcall(catalog.beasts)
        if okBeasts and type(beasts) == "table" then
            for _, beast in pairs(beasts.byModel) do
                if beast.boss then bosses[beast.displayName] = true end
            end
        end
        -- a boss seen this session counts even if the bestiary could not be read
        local okLive, live = World.mobs({ bossOnly = true })
        if okLive then
            for _, entry in ipairs(live) do bosses[entry.name] = true end
        end
        local out = {}
        for _, name in ipairs(all) do
            if bosses[name] then out[#out + 1] = name end
        end
        table.sort(out)
        return out
    end

    function source.stop()
        source.set(false)
    end

    return source
end

return M

end)
