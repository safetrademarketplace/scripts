local Maid       = require("Utility/Maid")
local Scheduler  = require("Utility/Scheduler")
local Api        = require("Api")

local ReplicatedStorage = Services.ReplicatedStorage

-- something the game makes late is looked for on this cadence while anything listens
local FIND_EVERY = 2
-- a ledger entry for a subject with no window of its own
local DEFAULT_WINDOW = 30
-- the value shelf is swept of stale entries once it holds this many
local SWEEP_AT = 200

local M = {}

M.FIND_EVERY = FIND_EVERY

local function noop() end

local function handle(stop)
    local done = false
    local function disconnect()
        if done then return end
        done = true
        stop()
    end
    return { Disconnect = disconnect, Destroy = disconnect }
end

M.handle = handle

-- first(kind, subject, window) is true once per window for each subject; instance subjects are held weakly, so a destroyed model drops out by itself
function M.ledger(clock)
    clock = clock or os.clock
    local byValue, byObject = {}, {}
    local count = 0
    local ledger = {}

    local function shelf(kind, object)
        local shelves = object and byObject or byValue
        local found = shelves[kind]
        if found == nil then
            found = object and setmetatable({}, { __mode = "k" }) or {}
            shelves[kind] = found
        end
        return found
    end

    local function sweep(now)
        count = 0
        for _, entries in pairs(byValue) do
            for subject, expires in pairs(entries) do
                if expires <= now then entries[subject] = nil else count = count + 1 end
            end
        end
    end

    function ledger.first(kind, subject, window)
        if subject == nil then return true end
        local now = clock()
        local object = type(subject) == "table" or type(subject) == "userdata"
        local entries = shelf(kind, object)
        local expires = entries[subject]
        if expires ~= nil and expires > now then return false end
        if expires == nil and not object then
            count = count + 1
            if count >= SWEEP_AT then sweep(now) end
        end
        entries[subject] = now + (window or DEFAULT_WINDOW)
        return true
    end

    function ledger.forget(kind, subject)
        if subject == nil then return end
        local object = type(subject) == "table" or type(subject) == "userdata"
