            guard(kit, true)
            local untilAt = os.clock() + GUARD_TIME
            while os.clock() < untilAt and alive(mob) do
                local now = rootOf(mob)
                if now then kit.face(now) end
                if not kit.sleep(0.1) then return end
            end
            target.swings = 0
            return
        end

