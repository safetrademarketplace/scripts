        local t = now()
        stepDt = math.min(dt, Tuning.maxStepDt)
        if driver and not driver.alive then return finish(false, Errors.INTERRUPTED) end
        if overdue(Tuning.watchSlack) then return finish(false, Errors.TIMED_OUT) end

        -- every handle is read fresh: the character and all under it are replaced on respawn
        local hasChar, liveChar = State.character()
        if not hasChar or liveChar ~= char then return finish(false, Errors.RESPAWNED) end
        local hasRoot, liveRoot = State.root()
        local hasHum, liveHum = State.humanoid()
        if not (hasRoot and hasHum) then return finish(false, Errors.RESPAWNED) end
        if liveHum.Health <= 0 then return finish(false, Errors.DIED) end
        -- an anchor with no Transition is ZeroSecure putting the root back, waited out as a correction rather than taken for the server's own teleport
        local okTeleport, teleporting = State.teleporting()
        if okTeleport and teleporting then
            if serverMove() then return finish(false, Errors.INTERRUPTED) end
            if not correcting then beginCorrection("rewind", liveRoot.Position) end
            return
        end

        if t >= busyAt then
            busyAt = t + Tuning.busyPoll
            local okBusy, busy, why = State.busy()
            if okBusy and busy and why == "Dead" then return finish(false, Errors.DIED) end
            local pause = nil
            if okBusy and busy and Tuning.pauseReasons[why] then pause = why end
            if pause and not paused then
                paused, pausedSince = pause, t
                state = "paused"
                dropRoute("paused")
                hold, lastPlaced = nil, nil
            elseif not pause and paused then
                deadline = deadline + (t - pausedSince)
                paused, pausedSince = nil, nil
                state = "planning"
            end
        end
        if paused or correcting then return end

        local position = liveRoot.Position
        if t >= trailAt then
            trailAt = t + Tuning.trailEvery
            trail[#trail + 1] = position
            if #trail > Tuning.trailLength then table.remove(trail, 1) end
        end

        -- a rewind shows as the server taking the root; fighting it only earns another one
        if ownership.trusted and isOwner then
            local okOwner, owned = pcall(isOwner, liveRoot)
            if okOwner and owned == false then
                if route or hold or lastPlaced then beginCorrection("ownership", position) end
                return
            end
        end
        -- a rewind puts the root somewhere its own motion could not have taken it: for a placed root that is the last place written, for a steered broom where the commanded velocity leads, give or take being stopped short
        if riding() and driven then
            local expected = driven.velocity * dt
            local step = expected.Magnitude
            if distance(position, driven.from + expected) > Tuning.jumpLimit + step then
                return beginCorrection("jump", position)
            end
            -- physics stopping it short is something no sweep saw, so the leg is planned again from here and air legs cruise higher, over it
            if step > Tuning.stallMinStep then
                local moved = position - driven.from
                local along = (moved.X * expected.X + moved.Y * expected.Y + moved.Z * expected.Z) / step
                if along < step * Tuning.stallShare then heldFrames = heldFrames + 1 else heldFrames = 0 end
                if heldFrames >= Tuning.stallFrames then
                    heldFrames = 0
                    airRaise = airRaise + Tuning.airRewindRaise
                    base.log("the broom was held up at %s; planning again from there", tostring(position))
                    return dropRoute("blocked")
                end
            end
        elseif lastPlaced and distance(position, lastPlaced) > Tuning.jumpLimit then
            return beginCorrection("jump", position)
        end

        -- the broom lost mid-flight (knocked off, the server's own dismount): the trip holds still where it lost it and gets back on before going on (the user, 2026-10-24); only a broom that cannot come back (a no-fly zone) or takes longer than remountWait is gone on without
        if rider and not ending then
            if riding() then
                if remountSince and state == "remounting" then state = route and route.kind or "planning" end
                hadBroom, remountSince, remountAt = true, nil, nil
            elseif hadBroom then
                remountSince = remountSince or t
                remountAt = remountAt or position
                local why = rider.blocked()
                if why == "nofly" or why == "unsupported" or t - remountSince > Tuning.remountWait then
                    base.log("the broom is not coming back (%s); going on without it", tostring(why or "took too long"))
                    hadBroom, remountSince, remountAt = false, nil, nil
                else
                    state = "remounting"
                    -- the wait is the game's doing, so the deadline stands still through it
                    deadline = deadline + stepDt
                    pin(liveRoot, remountAt)
                    return
                end
            end
        end

        local current = route
        if not current then
            if hold then pin(liveRoot, hold) else lastPlaced = nil end
            return
        end

        if current.dwellUntil then
            if t < current.dwellUntil then
                pin(liveRoot, lastPlaced or position)
                return
            end
            current.dwellUntil = nil
        end

        -- never a catch-up burst: a long frame earns at most maxStepDt of travel, a route may ask to go slower than the trip, and off the broom nothing goes past the speed placing was measured safe at
        local pace = speed
        if current.speed and current.speed < pace then pace = current.speed end
        local points = current.points
        local index = current.index
        local at = position
        -- the frame's time is spent segment by segment, so a turn into a climb or a drop mid-frame takes that segment's own limit
        local remaining = stepDt
        local corner, cornerIndex = nil, nil
        local dwell = false
        -- only an air leg is flown by the broom; everything else is placed, at the speed placing was measured safe at
        local steer = riding() ~= nil and current.air == true
        local cap = Tuning.placeSpeed
        if steer then cap = Tuning.ceiling end
        while remaining > 1e-9 and index <= #points do
            local target = points[index]
            local gap = distance(at, target)
            local rate = math.min(pace, cap)
            -- a climb or a drop goes no faster than the tween that was measured accepted
            if math.abs(target.Y - at.Y) > flatDistance(at, target) then rate = math.min(rate, climbRate) end
            local reachable = rate * remaining
            if gap <= reachable then
                remaining = remaining - gap / rate
                local before = at
                at = target
                index = index + 1
                if not corner then corner, cornerIndex = at, index end
                local after = points[index]
                -- an open-air corner has nothing for a replicated chord to cut, so only ground routes hold on one
                if after and not current.air and sharpTurn(before, at, after) then
                    dwell = true
                    break
                end
            else
                local f = reachable / gap
                at = Vector3.new(at.X + (target.X - at.X) * f, at.Y + (target.Y - at.Y) * f, at.Z + (target.Z - at.Z) * f)
                remaining = 0
            end
        end

        -- the exact chord this frame replicates is swept again, so geometry that streamed in after planning still stops it
        if distance(position, at) > 1e-3 and not probe.sweep(position, at) then
            if corner and distance(corner, at) > 1e-3 and probe.sweep(position, corner) then
                at, index, dwell = corner, cornerIndex, false
            else
                return dropRoute("blocked")
            end
        end

        place(liveRoot, position, at, steer)
        current.index = index
        if dwell then current.dwellUntil = t + Tuning.cornerDwell end
        if index > #points then dropRoute("done") end
    end

    -- a broom frame that asked for nothing hovers, so a pause, a correction or a stop never leaves it flying on
    local function step(dt)
        commanded = false
        stepFrame(dt)
        local rig = riding()
        if rig and not commanded then rig.hover() end
        if not (rig and commanded) then driven = nil end
    end

    local function sleep(job, seconds)
        return job:sleep(seconds) and not finished
    end

    -- the first real "true" teaches the api the executor's answer can be trusted; one that never says true is ignored in favour of the jump check
    local function awaitOwnership(job)
        if ownership.distrusted then return true end
        local limit = now() + Tuning.ownershipWait
        while true do
            local answer = ownerAnswer()
            if answer == nil then return true end
            if answer then
                ownership.trusted = true
                return true
            end
            if now() >= limit then
                if ownership.trusted then return false end
                ownership.distrusted = true
                base.warn("isnetworkowner never answered true; corrections are caught by position jumps alone")
                return true
            end
            if not sleep(job, 0) then return nil end
        end
    end

    local function run(job, current, limit)
        current.index = 1
        route, hold = current, nil
        state = current.kind
        local look = now() + Tuning.retargetPoll
        local travelling = current.kind ~= "settling" and current.kind ~= "landing"
        repeat
            if not sleep(job, 0) then return end
            local t = now()
            if travelling then
                if stopping then
                    dropRoute("stopped")
                elseif overdue(0) then
                    dropRoute("timeout")
                elseif t >= look then
                    look = t + Tuning.retargetPoll
                    goal = resolve() or goal
                    local okR, part = State.root()
                    if okR and gapTo(part.Position) <= reach then
                        dropRoute("arrived")
                    elseif current.final and distance(goal, current.target) > math.max(reach, Tuning.retargetDrift) then
                        dropRoute("retarget")
                    end
                end
            elseif limit and t > limit then
                dropRoute("timeout")
            end
        until current.ended
    end

    -- straight down onto CanCollide floor found from just above the feet, swept like any other segment
    local function descend(job, minDrop, settle)
        if paused or correcting then return end
        local okR, part = State.root()
        if not okR then return end
        local here = part.Position
        local floorY = probe.floorUnder(here, Tuning.landProbe)
        if not floorY then return end
        local spot = Vector3.new(here.X, floorY + height, here.Z)
        local gap = here.Y - spot.Y
        if gap <= minDrop and not (settle and -gap > minDrop) then return end
        if not probe.sweep(here, spot, true) then return end
        run(job, { points = { spot }, kind = settle and "settling" or "landing" }, now() + Tuning.landTimeout)
    end

    local function airborne(position)
        local floorY = probe.floorUnder(position, Tuning.landProbe)
        return floorY ~= nil and position.Y - height - floorY > Tuning.safeDrop
    end

    -- a trip left in the air keeps its broom paused for the owner's next trip rather than handing it back to the game in between
    local function keepOrLand(job, nearFloor)
        if not nearFloor and deps.keep then
            local kept = rider.handOff(job)
            if kept then
                deps.keep(kept)
                return
            end
        end
        rider.land(job, nearFloor)
    end

    -- a trip that ends near the floor gets off the broom; one left hanging higher stays on it rather than drop
    local function getOff(job)
        if not rider or finished then return end
        local nearFloor = false
        local okR, part = State.root()
        if okR then
            local here = part.Position
            local floorY = probe.floorUnder(here, Tuning.landProbe)
            nearFloor = floorY ~= nil and here.Y - height - floorY <= Tuning.broomDismountGap
        end
        keepOrLand(job, nearFloor)
    end

    -- an air goal is held on the broom, never landed under
    local function arrive(job)
        route = nil
        ending = true
        if air then
            if rider then keepOrLand(job, false) end
        else
            descend(job, Tuning.settleSlack, true)
            getOff(job)
        end
        if not finished then finish(true) end
    end

    -- every ending the trip chooses for itself puts a character left hanging back on the floor first
    local function land(job, why)
        route = nil
        ending = true
        descend(job, Tuning.safeDrop, false)
        getOff(job)
        if not finished then finish(false, why) end
    end

    -- an anchor is waited out, and where it leaves the root says whose move it was: back on the trail is a rewind, anywhere else the server's own move (a knock with no anchor is planned on from wherever it lands); answers whether to carry on and whether the root was anchored
    local function settleAnchor(job)
        local limit = now() + Tuning.rewindWait
        local anchored = false
        while true do
            if serverMove() then
                finish(false, Errors.INTERRUPTED)
                return false
            end
            local okT, held = State.teleporting()
            if not (okT and held) then break end
            anchored = true
            if now() >= limit then
                finish(false, Errors.INTERRUPTED)
                return false
            end
            if not sleep(job, 0) then return false end
        end
        if not anchored then return true, false end
        local okR, part = State.root()
        if not okR then
            finish(false, Errors.RESPAWNED)
            return false
        end
        if not onTrail(part.Position) then
            base.log("the server moved the character off the trip's path; standing down")
            finish(false, Errors.INTERRUPTED)
            return false
        end
        return true, anchored
    end

    local function handleCorrection(job)
        local current = correcting
        if not current.counted then
            local carryOn, anchored = settleAnchor(job)
            if not carryOn then return false end
            if anchored then current.kind = "rewind" end
            current.counted = true
            corrections = corrections + 1
            legCorrections = legCorrections + 1
            deps.onCorrected({
                count = corrections, leg = leg, kind = current.kind, position = current.position, speed = speed,
            })
            if corrections >= maxCorrections then
                finish(false, Errors.CORRECTED)
                return false
            end
            -- an anchored rewind is the server objecting to the pace, so it slows at once, climbs too; anything else is taken for geometry the route met
            if current.kind == "rewind" then
                speed = math.max(speed * Tuning.slowdown, Tuning.minSpeed)
                climbRate = math.max(climbRate * Tuning.slowdown, Tuning.minSpeed)
            else
                if current.air then airRaise = airRaise + Tuning.airRewindRaise end
                if legCorrections >= Tuning.slowAfter then
                    speed = math.max(speed * Tuning.slowdown, Tuning.minSpeed)
                    if current.blame then probe.avoid(current.blame) end
                end
            end
        end
        -- a jump lands before the ownership drop, so the server gets a moment to take the character first
        if current.kind == "jump" and not sleep(job, Tuning.jumpSettle) then return false end
        local back = awaitOwnership(job)
        if back == nil then return false end
        if back == false then
            finish(false, Errors.CORRECTED)
            return false
        end
        if not sleep(job, Tuning.correctionSettle) then return false end
        correcting = nil
        state = "planning"
        return true
    end

    local function interrupted()
        return finished or stopping ~= nil or paused ~= nil or correcting ~= nil
    end

    -- world has StreamingEnabled, so the far end of a leg is asked for before anything is planned against it
    local function stream(position)
        local World = deps.ctx.Api and deps.ctx.Api.World
        local fn = type(World) == "table" and World.streamAround or nil
        if type(fn) ~= "function" then return end
        local ok, done, code = pcall(fn, position, Tuning.streamTimeout)
        if not ok then
            base.warn("streaming ahead threw: %s", tostring(done))
        elseif done ~= true then
            base.log("streaming ahead gave up: %s", tostring(code))
        end
    end

    local function streamedNear(position)
        for i = 1, #streamedAhead do
            local entry = streamedAhead[i]
            if entry.done and distance(entry.position, position) <= Tuning.airStreamReuse then return true end
        end
        return false
    end

    -- the leg after this one is streamed in while this one flies, so legs chain without a stop to wait on the server
    local function prefetch(position)
        if streamedNear(position) then return end
        local entry = { position = position, done = false }
        streamedAhead[#streamedAhead + 1] = entry
        local job = Jobs.spawn(function()
            stream(position)
            entry.done = true
        end, { name = "Movement.prefetch" })
        if job then maid:GiveTask(job) end
    end

    local function streamOnce(position)
        if streamedNear(position) then return end
        stream(position)
        streamedAhead[#streamedAhead + 1] = { position = position, done = true }
    end

    local function pointToward(from, length)
        local flat = flatDistance(from, goal)
        if flat <= length then return goal end
        local t = length / flat
        return Vector3.new(from.X + (goal.X - from.X) * t, from.Y, from.Z + (goal.Z - from.Z) * t)
    end

    -- flying is allowed and only geometry is off limits, so a leg goes through the air whenever it can; nil hands it to pathfinding
    local function airLeg(here)
        if not Tuning.airRoutes then return nil end
        local final = flatDistance(here, goal) <= Tuning.airLeg
        if final then
            streamOnce(goal)
            if interrupted() then return nil end
            if air then
                local points = Air.fly(probe, here, goal, true, airRaise)
                if points then return { points = points, goal = goal, air = true }, true end
                return nil
            end
            for _, spot in ipairs(Planner.candidates(probe, here, goal, { final = true, reach = reach })) do
                local points = Air.fly(probe, here, spot, true, airRaise)
                if interrupted() then return nil end
                if points then return { points = points, goal = spot, air = true }, true end
            end
            return nil
        end
        local legEnd = pointToward(here, Tuning.airLeg)
        streamOnce(legEnd)
        if interrupted() then return nil end
        prefetch(pointToward(legEnd, Tuning.airLeg))
        -- the leg ends as high as the stretch after it needs, so it never dips only to climb back out
        local hold = Air.ahead(probe, legEnd, pointToward(legEnd, Tuning.airLookahead))
        local points = Air.fly(probe, here, legEnd, false, airRaise, hold)
        if points then return { points = points, goal = points[#points], air = true }, false end
        return nil
    end

    -- a goal under a roof that nothing plans to from here (live 2026-10-24: the Dire Wolf's den, under the terrain beside a giant skull) is entered on foot from where the pathfinder's own route last has open sky, flown to first
    local mouthTried = false
    local function mouthLeg(here)
        if mouthTried or interrupted() then return nil end
        mouthTried = true
        local spots = Planner.mouth(probe, here, goal)
        if not spots or distance(spots[1], here) <= reach then return nil end
        base.log("the target is under a roof; going to the way in first")
        for _, spot in ipairs(spots) do
            local points = Air.fly(probe, here, spot, true, airRaise)
            if interrupted() then return nil end
            if points then return { points = points, goal = spot, air = true }, false end
        end
        local walk = Planner.plan(probe, here, spots[1], { final = true, reach = Tuning.reach })
        if walk then return walk, false end
        return nil
    end

    -- the leg shrinks when the pathfinder will not solve it in one piece; the destination itself is only tried once
    local function attemptLeg(here)
        local airPlan, airFinal = airLeg(here)
        if airPlan or interrupted() then return airPlan, airFinal end
        local flat = flatDistance(here, goal)
        -- the pathfinder only knows floors, so the last stretch to an air goal is flown or nothing
        if air and flat <= Tuning.airLeg then return nil end
        local triedFinal = false
        for _, length in ipairs(Tuning.legLengths) do
            local final = flat <= length
            if not (final and triedFinal) then
                triedFinal = triedFinal or final
                local legEnd = goal
                if not final then
                    local t = length / flat
                    legEnd = Vector3.new(here.X + (goal.X - here.X) * t, here.Y + (goal.Y - here.Y) * t, here.Z + (goal.Z - here.Z) * t)
                end
                stream(legEnd)
                if interrupted() then return nil end
                local plan = Planner.plan(probe, here, legEnd, { final = final, reach = reach, toward = goal })
                if interrupted() then return nil end
                if plan then return plan, final end
            end
        end
        return mouthLeg(here)
    end

    -- avoid zones are a guess at what the server objected to, so a leg they make impossible is planned again without them
    local function planLeg(here)
        local plan, final = attemptLeg(here)
        if plan or interrupted() or probe.zoneCount() == 0 then return plan, final end
        base.log("no route around the corrected stretch, planning through it again")
        probe.clearZones()
        return attemptLeg(here)
    end

    -- one straight swept walk to a spot, slower when pace says so; answers how it ended
    local function walk(job, spot, pace, kind)
        local okR, part = State.root()
        if not okR then return "gone" end
        local here = part.Position
        if distance(here, spot) <= 0.05 then return "done" end
        if not probe.sweep(here, spot) then return "blocked" end
        local current = { points = { spot }, kind = kind, speed = pace }
        run(job, current)
        return current.ended
    end

    -- the pathfinder calls a closed door NoPath: reach our side of it, step slowly into its pad, give the server a moment to swing it, then leave by a side that has a path on; nil when the door could not even be reached
    local function workDoor(job, door, here, atDoor)
        local sides = Doors.sides(probe, door, here)
        if not sides then return nil end
        local entry = nil
        if atDoor then
            -- already standing in it, so the pad is touched again from whichever side we can step straight out to
            for _, spot in ipairs({ sides.near or false, sides.far or false }) do
                if spot and not entry then
                    if door.panel then probe.ignore(door.panel) end
                    local ended = walk(job, spot, nil, "door")
                    if ended == "done" then
                        entry = spot
                    elseif ended ~= "blocked" then
                        return false
                    end
                end
            end
            if not entry then return nil end
        else
            -- the side facing us across the door's plane first, but for a door in a side wall that can be the inside, so the other side may be the one that pathfinds
            local approach = nil
            for _, spot in ipairs({ sides.near or false, sides.far or false }) do
                if spot and not approach then
                    approach = Planner.plan(probe, here, spot, { final = true, reach = Tuning.doorReach })
                    if interrupted() then return false end
                    if approach then entry = spot end
                end
            end
            if not approach then return nil end
            if #approach.points > 0 then
                local current = { points = approach.points, kind = "door" }
                run(job, current)
                if finished then return false end
                if current.ended == "blocked" then return nil end
                if current.ended ~= "done" then return false end
            end
        end

        doorAttempts = doorAttempts + 1
        doorsTried[door.key] = true
        if door.panel then probe.ignore(door.panel) end
        local opened = false
        local before = Doors.pose(door.panel)
        local listener = Doors.listen(deps.ctx, door, function() opened = true end)
        if listener then maid:GiveTask(listener) end
        local stepped = walk(job, sides.pad, Tuning.doorSpeed, "door")
        if stepped == "done" then
            local limit = now() + Tuning.doorWait
            while not opened and not Doors.swung(door.panel, before) and now() < limit do
                if not sleep(job, 0) or interrupted() then break end
            end
            opened = opened or Doors.swung(door.panel, before)
        end
        if listener then listener:Disconnect() end
        if finished or interrupted() or (stepped ~= "done" and stepped ~= "blocked") then return false end
        base.log("door %s %s", door.name, opened and "opened" or "stayed shut")

        if opened then
            -- the far side first when we came to cross it; from inside the doorway, whichever side is nearer the target
            local other = sides.far
            if entry ~= sides.near then other = sides.near end
            local exits = {}
            if other then exits[#exits + 1] = other end
            exits[#exits + 1] = entry
            if atDoor and #exits == 2 and flatDistance(exits[2], goal) < flatDistance(exits[1], goal) then
                exits[1], exits[2] = exits[2], exits[1]
            end
            for _, exit in ipairs(exits) do
                local plan = attemptLeg(exit)
                if interrupted() then return false end
                if plan then
                    local ended = walk(job, exit, nil, "door")
                    if ended == "done" then return true end
                    if ended ~= "blocked" then return false end
                end
            end
            -- inside a building a door can open onto a hallway with no route on until the next door opens, so one we came to cross is crossed anyway and the trip goes on from the far side
            if not atDoor and other and other ~= entry and probe.roofed(entry) then
                base.log("through door %s with no route past it yet", door.name)
                local ended = walk(job, other, nil, "door")
                if ended == "done" then return true end
                if ended ~= "blocked" then return false end
            end
        end

        -- shut, or no side of it leads anywhere: back out the way we came and never plan through that doorway again
        local back = walk(job, entry, nil, "door")
        if back ~= "done" and back ~= "blocked" then return false end
        probe.block(door.position)
        return true
    end

    local function canStepOut(here)
        if #stepOrigins >= Tuning.stepOuts then return false end
        for _, origin in ipairs(stepOrigins) do
            if distance(origin, here) < Tuning.stepOutSpacing then return false end
        end
        return true
    end

    -- a start the pathfinder will not take: the nearest free spot on each ring that sweeps clean and plans on is walked to
    local function stepOut(job, here)
        stepOrigins[#stepOrigins + 1] = here
        local triedRings = {}
        for _, spot in ipairs(Planner.freeSpots(probe, here)) do
            local ring = math.floor(flatDistance(spot, here) * 2 + 0.5)
            if not triedRings[ring] and probe.sweep(here, spot) then
                triedRings[ring] = true
                local plan = attemptLeg(spot)
                if interrupted() then return false end
                if plan then
                    local ended = walk(job, spot, nil, "stepping")
                    if ended == "done" then return true end
                    if ended ~= "blocked" then return false end
                end
            end
        end
        return nil
    end

    -- a NoPath is worked through in order: a door we stand in, a start the pathfinder will not take, then the doors between us and the target; leaving a building, the doors come before stepping out
    local function recover(job, here, doorsFirst)
        recoverSince = now()
        local result = nil
        if doorAttempts < Tuning.doorAttempts then
            local door = Doors.at(deps.ctx, here, doorsTried)
