    local labelTop = corners and (corners.topLeft + corners.topRight) * 0.5 or self.screenPoint
    local labelBottom = corners and (corners.bottomLeft + corners.bottomRight) * 0.5 or self.screenPoint

    local name = group.name
    self.name.Visible = enabled and onScreen and name.enabled and labelTop ~= nil
    if self.name.Visible then
        local n = self.name
        n.Text = self.displayName
        n.Size = textSize; n.Font = textFont
        n.Color = self:resolveColor(name.color)
        n.Transparency = name.transparency
        n.Outline = name.outline
        n.OutlineColor = name.outlineColor
        n.Position = labelTop - Vector2.new(0, n.TextBounds.Y) - NAME_OFFSET
