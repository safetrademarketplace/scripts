    if opts.body ~= nil then
        local okEncode, body = pcall(HttpService.JSONEncode, HttpService, opts.body)
        if not okEncode or type(body) ~= "string" then return nil, "encode failed", 0, nil end
        encoded = body
    end

    local reqOpts = { Url = opts.url, Method = method, Headers = headers, Body = encoded }

    -- only idempotent verbs retry: replaying a POST could double-submit a config or a webhook
    local retryable = opts.retry ~= false and (method == "GET" or method == "HEAD" or opts.retry)
    local ok, res
    if retryable then
        ok, res = M.retry(reqOpts, type(opts.retry) == "table" and opts.retry or nil)
    else
        ok, res = M.request(reqOpts)
    end

    if not ok or type(res) ~= "table" then
        return nil, "request failed: " .. tostring(res), 0, nil
    end

    local status = readStatus(res)
    local raw    = readBody(res) or ""

    local decoded
    if raw ~= "" then
        local okDecode, value = pcall(HttpService.JSONDecode, HttpService, raw)
        if okDecode then decoded = value end
    end

    if status >= 200 and status < 300 then
        if raw ~= "" and decoded == nil then return nil, "decode failed", status, nil end
        return decoded or {}, nil, status, decoded
    end

    local message
