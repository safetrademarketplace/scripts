    -- WaypointClient.lua:59-62,125: gates are tagged models, the client hangs a ChatObjectPrompt on the PrimaryPart
    function places.waypoints()
        local list = {}
        for _, model in ipairs(CollectionService:GetTagged("Waypoint")) do
            if model:IsA("Model") then
                local entry = modelEntry(model)
                entry.prompt = entry.root and entry.root:FindFirstChild("ChatObjectPrompt")
                list[#list + 1] = entry
            end
        end
        table.sort(list, Read.byName)
        return true, list
    end

    -- RespawnClient.lua:216-233: a shrine with no uid is open to everyone, otherwise the player attribute named by it unlocks it
    function places.shrines()
        local folder = Read.walk(Workspace, SHRINES)
        if folder == nil then return false, Errors.NOT_STREAMED end
        local player = References.player
        local list = {}
        for _, model in ipairs(folder:GetChildren()) do
            if model:IsA("Model") then
                local entry = modelEntry(model)
                local uid = Read.text(model:GetAttribute("uid"))
                local range = model:GetAttribute("Range")
                entry.uid = uid
                entry.unlocked = uid == nil or Read.truthy(player:GetAttribute(uid))
                entry.range = type(range) == "number" and range or SHRINE_RANGE
                entry.regions = regionList(Read.text(model:GetAttribute("Region")))
                list[#list + 1] = entry
            end
        end
        table.sort(list, Read.byName)
        return true, list
    end

    -- RespawnClient.lua:212-213,262: the TrueSpawn stat names the child, whose first BasePart is where the inn puts you
    function places.spawns()
        local folder = Read.walk(Workspace, SPAWNS)
        if folder == nil then return false, Errors.NOT_STREAMED end
        local current = env.stat("TrueSpawn")
        local list = {}
        for _, child in ipairs(folder:GetChildren()) do
            local part = child:IsA("BasePart") and child or child:FindFirstChildWhichIsA("BasePart")
            list[#list + 1] = {
                name        = child.Name,
                displayName = INNS[child.Name] or Read.readable(child.Name),
                instance    = child,
                part        = part,
                streamed    = part ~= nil,
                position    = part and part.Position or Read.position(child),
                current     = current == child.Name,
            }
        end
        table.sort(list, Read.byName)
        return true, list
    end

    -- "@" children are quest set pieces (ShrineClient.lua:17, OutpostClient.lua:11), not destinations
    function places.areas()
        local folder = Read.walk(Workspace, AREAS)
        if folder == nil then return false, Errors.NOT_STREAMED end
        local list = {}
        for _, area in ipairs(folder:GetChildren()) do
            local name = area.Name
            if string.sub(name, 1, 1) ~= "@" then
                -- a miss stays unset, so an area that had not streamed in is measured again next time
                if centres[name] == nil then centres[name] = centreOf(area) end
                list[#list + 1] = {
                    name        = name,
                    displayName = Read.text(area:GetAttribute("DisplayName")) or Read.readable(name),
                    instance    = area,
                    position    = centres[name],
                }
            end
        end
        table.sort(list, Read.byName)
        return true, list
    end

    function places.pois()
        local list = {}
        for _, inst in ipairs(CollectionService:GetTagged("POI")) do
            list[#list + 1] = {
                instance = inst,
                model    = inst:IsA("Model") and inst or Read.nearestModel(inst),
                name     = poiName(inst) or Read.readable(inst.Name),
                category = poiCategory(inst),
                position = Read.position(inst),
            }
        end
        table.sort(list, Read.byName)
        return true, list
    end

    function places.locations()
        local list = zones()
        if list == nil then return false, Errors.NOT_STREAMED end
        local out = {}
        for i, zone in ipairs(list) do
            out[i] = {
                name        = zone.name,
                displayName = zone.displayName,
                position    = zone.position,
                size        = zone.size,
                priority    = zone.priority,
                environment = zone.environment,
                noFlight    = zone.noFlight,
                mapLocation = zone.mapLocation,
            }
        end
        return true, out
    end

    -- LocationClient.lua:886-895: the highest Subsidiary wins, and a tie keeps the zone the game already shows
    function places.locationAt(point)
        local list = zones()
        if list == nil then return false, Errors.NOT_STREAMED end
        local current = env.location()
        local best
        for _, zone in ipairs(list) do
            if inside(zone, point) and (best == nil or zone.priority > best.priority
                or (zone.priority == best.priority and zone.name == current)) then
                best = zone
            end
        end
        if best == nil then return true, nil end
        return true, best.name
    end

    -- MapService.lua:336-350: the first area rectangle holding the point's X and Z, edges included
    function places.regionAt(point)
        for _, area in ipairs(env.catalog.areas()) do
            if point.X >= area.minX and point.X <= area.maxX and point.Z >= area.minZ and point.Z <= area.maxZ then
                return true, area.name
            end
        end
        return true, nil
    end

    function places.waypointModels()
        local out = {}
        for _, inst in ipairs(CollectionService:GetTagged("Waypoint")) do
            if inst:IsA("Model") then out[#out + 1] = inst end
        end
        return out
    end

    function places.shrineModels()
        local folder = Read.walk(Workspace, SHRINES)
        local out = {}
        if folder == nil then return out end
        for _, inst in ipairs(folder:GetChildren()) do
            if inst:IsA("Model") then out[#out + 1] = inst end
        end
        return out
    end

    -- a point of interest that is a bare part has no model for the esp to draw, so it is left out here
    function places.poiModels()
        local out, added = {}, {}
        for _, inst in ipairs(CollectionService:GetTagged("POI")) do
            local model = inst:IsA("Model") and inst or Read.nearestModel(inst)
            if model ~= nil and not added[model] then
                added[model] = true
                out[#out + 1] = model
            end
        end
        return out
    end

    -- an unstreamed Map is an empty list rather than a failure, which is the contract Movement codes against
    function places.doors(filter)
        doorWatch.ensure()
        local list = {}
        for _, model in ipairs(doorWatch.present()) do
            local touch = model:FindFirstChild(DOOR_TOUCH)
            if touch ~= nil and touch:IsA("BasePart") then
                local panel = model:FindFirstChild(DOOR_PANEL)
                if panel ~= nil and not panel:IsA("BasePart") then panel = nil end
                list[#list + 1] = {
                    model    = model,
                    touch    = touch,
                    panel    = panel,
                    position = touch.Position,
                    outward  = touch.CFrame.LookVector,
                }
            end
        end
        return true, Read.finish(list, filter, env.origin(filter))
    end

    function places.destroy()
        doorWatch.destroy()
        zoneLinks:DoCleaning()
        zoneRoot, zoneCache = nil, nil
    end

    return places
end

return M

end)
__bundle_register("Api/World/Members", function(require, _LOADED, __bundle_register, __bundle_modules)
-- world members: lazily watches one container that streaming may add or remove at any time, tracking its member instances and whether each member's root part has streamed in; a miss is never cached, and a missing container is retried on a slow heartbeat while anything wants it

local Maid      = require("Utility/Maid")
local Scheduler = require("Utility/Scheduler")

local RETRY_INTERVAL = 2

local M = {}

-- opts: label, resolve() -> container or nil, mode "children" | "nested" (through Folders) | "descendants", accept(inst) -> bool, part (child a member needs to count as present), onAdded(member), onRemoved(member), safe(label, fn, ...)
function M.new(opts)
    local label, resolve, accept, part, safe = opts.label, opts.resolve, opts.accept, opts.part, opts.safe
    local mode = opts.mode or "children"

    local watch = {}
    local links = Maid.new()
    local records = {}
    local folders = {}
    local container, retry = nil, nil
    local wanted, dead = false, false

    -- silent once destroyed, so unload never reads as every member leaving
    local function emit(fn, member)
        if fn ~= nil and not dead then safe(label .. " listener", fn, member) end
    end

    local function settle(member)
        local record = records[member]
        if record == nil then return end
        local present = member.Parent ~= nil and (part == nil or member:FindFirstChild(part) ~= nil)
        if present == record.present then return end
        record.present = present
        if present then emit(opts.onAdded, member) else emit(opts.onRemoved, member) end
    end

    local function settleOn(member, child)
        if child.Name == part then settle(member) end
    end

    local function track(member)
        if records[member] ~= nil or not accept(member) then return end
        local record = { links = Maid.new(), present = false }
        records[member] = record
        if part ~= nil then
            local function onChild(child) safe(label .. " part", settleOn, member, child) end
            record.links:GiveTask(member.ChildAdded:Connect(onChild))
            record.links:GiveTask(member.ChildRemoved:Connect(onChild))
        end
        settle(member)
    end

    local function untrack(member)
        local record = records[member]
        if record == nil then return end
        records[member] = nil
        record.links:DoCleaning()
        if record.present then emit(opts.onRemoved, member) end
    end

    -- listeners may call back into the index, so a sweep always walks a copy
    local function snapshot(set, keep)
        local out = {}
        for item in pairs(set) do
            if keep == nil or keep(item) then out[#out + 1] = item end
        end
        return out
    end

    local watchFolder, unwatchFolder, recheck

    local function consider(inst)
        if mode == "nested" and inst:IsA("Folder") then
            watchFolder(inst)
        else
            track(inst)
        end
    end

    local function forget(inst)
        if folders[inst] ~= nil then unwatchFolder(inst) else untrack(inst) end
    end

    watchFolder = function(folder)
        if folders[folder] ~= nil then return end
        local folderLinks = Maid.new()
        folders[folder] = folderLinks
        folderLinks:GiveTask(folder.ChildAdded:Connect(function(child) safe(label .. " added", consider, child) end))
        folderLinks:GiveTask(folder.ChildRemoved:Connect(function(child) safe(label .. " removed", forget, child) end))
        for _, child in ipairs(folder:GetChildren()) do consider(child) end
    end

    unwatchFolder = function(folder)
        local folderLinks = folders[folder]
        if folderLinks == nil then return end
        folders[folder] = nil
        folderLinks:DoCleaning()
        local function inside(inst) return inst:IsDescendantOf(folder) end
        for _, inner in ipairs(snapshot(folders, inside)) do unwatchFolder(inner) end
        for _, member in ipairs(snapshot(records, inside)) do untrack(member) end
    end

    local function detach()
        container = nil
        links:DoCleaning()
        for _, folder in ipairs(snapshot(folders)) do unwatchFolder(folder) end
        for _, member in ipairs(snapshot(records)) do untrack(member) end
    end

    local function attach(found)
        container = found
        links:GiveTask(found.AncestryChanged:Connect(function() safe(label .. " ancestry", recheck) end))
        if mode == "descendants" then
            -- the cheap tests run outside safe: a workspace-wide index sees every streamed instance
            links:GiveTask(found.DescendantAdded:Connect(function(inst)
                if accept(inst) then safe(label .. " added", track, inst) end
            end))
            links:GiveTask(found.DescendantRemoving:Connect(function(inst)
                if records[inst] ~= nil then safe(label .. " removed", untrack, inst) end
            end))
            for _, inst in ipairs(found:GetDescendants()) do track(inst) end
        else
            links:GiveTask(found.ChildAdded:Connect(function(child) safe(label .. " added", consider, child) end))
            links:GiveTask(found.ChildRemoved:Connect(function(child) safe(label .. " removed", forget, child) end))
            for _, child in ipairs(found:GetChildren()) do consider(child) end
        end
    end

    local function stopRetry()
        if retry == nil then return end
        retry:Disconnect()
        retry = nil
    end

    local function connect()
        local found = resolve()
        if found == nil then return false end
        stopRetry()
        attach(found)
        return true
    end

    local function startRetry()
        if retry ~= nil or dead then return end
        retry = Scheduler.heartbeat(function()
            safe(label .. " retry", function()
                if container ~= nil or dead then
                    stopRetry()
                    return
                end
                connect()
            end)
        end, { interval = RETRY_INTERVAL, name = "World." .. label })
    end

    recheck = function()
        if dead then return end
        local found = resolve()
        if found == container then return end
        detach()
        if found ~= nil then
            attach(found)
        elseif wanted then
            startRetry()
        end
    end

    -- true once the container is watched; the first call is what starts the index
    function watch.ensure()
        if dead then return false end
        wanted = true
        if container ~= nil and container.Parent == nil then detach() end
        if container ~= nil then return true end
        if connect() then return true end
        startRetry()
        return false
    end

    function watch.present()
        local out = {}
        for member, record in pairs(records) do
            if record.present and member.Parent ~= nil then out[#out + 1] = member end
        end
        return out
    end

    function watch.all()
        local out = {}
        for member in pairs(records) do
            if member.Parent ~= nil then out[#out + 1] = member end
        end
        return out
    end

    function watch.destroy()
        if dead then return end
        dead = true
        stopRetry()
        detach()
    end

    return watch
end

return M

end)
__bundle_register("Api/World/Errors", function(require, _LOADED, __bundle_register, __bundle_modules)
-- world errors: the string codes every map-index getter hands back as its failure result

return {
    NOT_READY     = "world/not_ready",
    BAD_ARGS      = "world/bad_args",
    NONE          = "world/none",
