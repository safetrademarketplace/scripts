            local args = { ... }
            -- AddTab/AddKeyTab signatures: (Name, IconName) or (Info table)
            if type(args[1]) == "string" then
                args[1] = T(args[1])
            elseif type(args[1]) == "table" then
                translateInfo(args[1])
            end
            local tab = orig(self, table.unpack(args))
            return wrapTab(tab)
        end
    end

    wrapTabFactory("AddTab")
    wrapTabFactory("AddKeyTab")

    -- sidebar section headers: the name at build time and on every later SetText, like a tab's name
    do
        local origAddSection = window.AddSection
        if type(origAddSection) == "function" then
            window.AddSection = function(self, first, ...)
                if type(first) == "string" then
                    first = T(first)
                elseif type(first) == "table" then
                    translateInfo(first)
                end
                local section = origAddSection(self, first, ...)
                if type(section) == "table" and type(section.SetText) == "function" and not section.__cerb_localize_wrapped then
                    section.__cerb_localize_wrapped = true
                    local origSetText = section.SetText
                    section.SetText = function(sself, text, ...)
                        return origSetText(sself, tStr(text), ...)
                    end
                end
                return section
            end
        end
    end

    do
        local origAddDialog = window.AddDialog
        if type(origAddDialog) == "function" then
            window.AddDialog = function(self, idx, info)
                if type(info) == "table" then translateInfo(info) end
                local dlg = origAddDialog(self, idx, info)
                if dlg then patchFuncs(dlg) end
                return dlg
            end
        end
    end

    return window
end

local libraryPatched = false
local function patchLibrary(Library)
    if libraryPatched or type(Library) ~= "table" then return Library end
    libraryPatched = true

    local origNotify = Library.Notify
    if type(origNotify) == "function" then
        Library.Notify = function(self, info, time, soundId)
            if type(info) == "string" then
                info = T(info)
            elseif type(info) == "table" then
                translateInfo(info)
            end
            return origNotify(self, info, time, soundId)
        end
    end

    local origCreateWindow = Library.CreateWindow
    if type(origCreateWindow) == "function" then
        Library.CreateWindow = function(self, info)
            if type(info) == "table" then translateInfo(info) end
            local window = origCreateWindow(self, info)
            return wrapWindow(window)
        end
    end

    return Library
end

-- TextTruncate=AtEnd sweep guards against translation length blowup; skips TextWrapped labels, the window title, and english passthrough entirely

-- resolved lazily so the per-descendant fast path never walks the ancestor chain
local windowTitleLabel = nil

-- MainFrame → TopBar (Frame with Y.Offset == 48) → TitleHolder → TextLabel, mirrors UiRuntime.tintTopbarIcon
local function findWindowTitleLabel(Library)
    local sg = Library and Library.ScreenGui
    local main = sg and sg:FindFirstChild("Main")
    if not main then return nil end
    local topBar
    for _, child in ipairs(main:GetChildren()) do
        if child:IsA("Frame") and child.Size.Y.Offset == 48 then
            topBar = child
            break
        end
    end
    if not topBar then return nil end
    local titleHolder = topBar:FindFirstChildOfClass("Frame")
    if not titleHolder then return nil end
    return titleHolder:FindFirstChildOfClass("TextLabel")
end

local function ensureTruncate(inst)
