__bundle_register("Api/Webhook/Embed", function(require, _LOADED, __bundle_register, __bundle_modules)
-- webhook embed builder: turns a spec into a discord embed, applies theme defaults, truncates to discord's per-field limits, and scrubs player names when anonymize is on

local M = {}

-- discord embed field limits (over these the whole send 400s, so we truncate)
local LIMIT = {
    title       = 256,
    description  = 4096,
    fieldName   = 256,
    fieldValue  = 1024,
    fields      = 25,
    footer      = 2048,
    authorName  = 256,
}

local function truncate(s, max)
    s = tostring(s or "")
    if #s <= max then return s end
    return s:sub(1, max - 1) .. "…"
end

-- color3 or already-packed int -> discord's 0xrrggbb integer
local function discordColor(c)
    if type(c) == "number" then return math.floor(c) end
    if typeof(c) == "Color3" then
        return math.floor(c.R * 255) * 65536
            + math.floor(c.G * 255) * 256
            + math.floor(c.B * 255)
    end
    return nil
end
M.discordColor = discordColor

function M.new(Services)
    local Players = Services.Players

    -- weak-keyed escaped-pattern cache; stored name/display auto-invalidate on mid-session rename
    local escapedCache = setmetatable({}, { __mode = "k" })

    local function escapePattern(s)
        return tostring(s or ""):gsub("([^%w])", "%%%1")
    end

    local function getEscaped(plr)
        local entry = escapedCache[plr]
        local name = tostring(plr.Name or "")
        local display = tostring(plr.DisplayName or "")
        if entry and entry.name == name and entry.display == display then
            return entry
        end
        entry = {
            name       = name,
            display    = display,
            patName    = name ~= "" and escapePattern(name) or nil,
            patDisplay = (display ~= "" and display ~= name) and escapePattern(display) or nil,
        }
        escapedCache[plr] = entry
        return entry
    end

    -- replace player names with "Anonymous"; gsubs gated behind cheap plain-finds so no-match strings stay one scan
    local function anonymize(text)
        local out = tostring(text or "")
        if out == "" then return out end
        local hasAt = string.find(out, "@", 1, true) ~= nil
        for _, plr in ipairs(Players:GetPlayers()) do
            local e = getEscaped(plr)
            if e.patName and string.find(out, e.name, 1, true) then
                if hasAt then out = out:gsub("@" .. e.patName, "@Anonymous") end
                out = out:gsub(e.patName, "Anonymous")
            end
            if e.patDisplay and string.find(out, e.display, 1, true) then
                if hasAt then out = out:gsub("@" .. e.patDisplay, "@Anonymous") end
                out = out:gsub(e.patDisplay, "Anonymous")
            end
        end
        return out
    end

    -- spec = embed content; opts = live theme { defaultColor, anon, attribution, playerName, gameName }
    local function build(spec, opts)
        spec = spec or {}
        opts = opts or {}
        local anon = opts.anon == true
        local function clean(s) return anon and anonymize(s) or tostring(s or "") end

        local embed = {}

        if spec.title and spec.title ~= "" then
            embed.title = truncate(clean(spec.title), LIMIT.title)
        end
        if spec.description and spec.description ~= "" then
            embed.description = truncate(clean(spec.description), LIMIT.description)
        end
        if spec.url and spec.url ~= "" then embed.url = tostring(spec.url) end

        local color = discordColor(spec.color) or discordColor(opts.defaultColor)
        if color then embed.color = color end

        local fields = {}
        if type(spec.fields) == "table" then
            for _, f in ipairs(spec.fields) do
                if type(f) == "table" and f.name and f.value then
                    fields[#fields + 1] = {
                        name   = truncate(clean(f.name), LIMIT.fieldName),
                        value  = truncate(clean(f.value), LIMIT.fieldValue),
                        inline = f.inline == true,
                    }
                end
            end
        end

        -- session attribution unless a spec opts out or anon hides the player
        local wantAttribution = spec.attribution ~= false and opts.attribution ~= false
        if wantAttribution and not anon and opts.playerName then
            fields[#fields + 1] = { name = "Player", value = truncate(tostring(opts.playerName), LIMIT.fieldValue), inline = true }
        end
        if wantAttribution and opts.gameName then
            fields[#fields + 1] = { name = "Game", value = truncate(tostring(opts.gameName), LIMIT.fieldValue), inline = true }
        end

        if #fields > 0 then
            if #fields > LIMIT.fields then
                for i = #fields, LIMIT.fields + 1, -1 do fields[i] = nil end
            end
            embed.fields = fields
        end

        if type(spec.thumbnail) == "string" and spec.thumbnail ~= "" then
            embed.thumbnail = { url = spec.thumbnail }
        end
        if type(spec.image) == "string" and spec.image ~= "" then
            embed.image = { url = spec.image }
        end

        if type(spec.author) == "table" and spec.author.name then
            embed.author = { name = truncate(clean(spec.author.name), LIMIT.authorName) }
            if type(spec.author.icon) == "string" and spec.author.icon ~= "" then
                embed.author.icon_url = spec.author.icon
            end
        end

        if spec.footer ~= nil then
            local text, icon
            if type(spec.footer) == "table" then
                text, icon = spec.footer.text, spec.footer.icon
            else
                text = spec.footer
            end
            if text and text ~= "" then
                embed.footer = { text = truncate(clean(text), LIMIT.footer) }
                if type(icon) == "string" and icon ~= "" then embed.footer.icon_url = icon end
            end
        end

        if spec.timestamp == true then
            embed.timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
        elseif type(spec.timestamp) == "string" then
            embed.timestamp = spec.timestamp
        end

        return embed
    end

    return {
        build        = build,
        anonymize    = anonymize,
        discordColor = discordColor,
    }
end

return M

end)
__bundle_register("Api/Webhook/Transport", function(require, _LOADED, __bundle_register, __bundle_modules)
-- webhook http layer: enqueues built payloads onto a bounded fifo that one lazy worker paces out to discord, backing off + requeuing on rate-limit; the worker spawns on first send and exits when the queue drains, so it's idle-free

local Http = require("Utility/Helpers/Http")
local Jobs = require("Utility/Jobs")

-- pacing/backoff tunables, file-scoped so behaviour is visible at a glance
local MIN_GAP_SECONDS   = 0.75   -- min spacing between sends (burst-friendly, well under 429s)
local RATE_BACKOFF      = 2.0    -- fallback sleep on a 429 with no Retry-After
local TRANSIENT_BACKOFF = 3.0    -- sleep before re-sending after a timeout or 5xx
local MAX_ATTEMPTS      = 3      -- per-item send attempts before it's dropped
local MAX_PENDING       = 120    -- queue cap; oldest is dropped past this

local M = {}

local function statusOf(res)
    if type(res) ~= "table" then return nil end
    return tonumber(res.StatusCode or res.Status or res.status_code)
end

-- best-effort Retry-After (seconds) from a 429 response; executors vary in shape
local function retryAfter(res, decode)
    if type(res) ~= "table" then return nil end
    local h = res.Headers or res.headers
    if type(h) == "table" then
        local v = tonumber(h["Retry-After"] or h["retry-after"])
        if v then return v end
    end
    if type(res.Body) == "string" and res.Body ~= "" and type(decode) == "function" then
        local ok, decoded = pcall(decode, res.Body)
        if ok and type(decoded) == "table" and tonumber(decoded.retry_after) then
            return tonumber(decoded.retry_after)
        end
    end
    return nil
end

-- opts = { encode = fn(tbl)->str, decode = fn(str)->tbl, log, warn, onResult = fn(label, ok, status) }
function M.new(opts)
    local encode   = opts.encode
    local decode   = opts.decode
    local log      = opts.log or function() end
    local warn     = opts.warn or function() end
    local onResult = opts.onResult or function() end

    local queue = {}      -- FIFO of { url, payload, label, attempts }
    local head, tail = 1, 0
    local running = false
    local stopped = false
    local workerJob = nil

    local function pending()
        return tail - head + 1
    end

    -- fire the shared result hook + the per-send onDone (test pings await this) exactly once
    local function finish(item, ok, status)
        onResult(item.label, ok, status)
        local cb = item.onDone
        if cb then item.onDone = nil; pcall(cb, ok, status) end
    end

    -- one send. returns true on success, false to requeue (rate-limited), nil to drop
    local function sendOne(item)
        local okEnc, body = pcall(encode, item.payload)
        if not okEnc or type(body) ~= "string" then
            warn("payload encode failed: %s", tostring(body))
            finish(item, false, nil)
            return nil
        end

        local ok, res = Http.request({
            Url     = item.url,
            Method  = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body    = body,
        })

        local status = statusOf(res)
        if ok and (status == nil or (status >= 200 and status < 300)) then
            log("sent %s -> HTTP %s (%d queued)", tostring(item.label), tostring(status or "?"), pending() - 1)
            finish(item, true, status)
            return true
        end

        -- a timeout arrives as a transport failure with no status; requeue those alongside 429s and 5xx rather than losing the event
        if Http.isTransient(ok, res) then
            item.lastStatus = status
            local wait = (status == 429 and (retryAfter(res, decode) or RATE_BACKOFF)) or TRANSIENT_BACKOFF
            warn("%s on %s, retrying in %.2fs", status == 429 and "rate-limited" or "transient failure",
                tostring(item.label), wait)
            task.wait(wait)
            return false
        end

        warn("send %s failed (HTTP %s, ok=%s)", tostring(item.label), tostring(status), tostring(ok))
        finish(item, false, status)
        return nil
    end

    -- named local (not a literal) so the auto-wrapper leaves the worker virtualized — sub-30Hz pacer, no perf need, no secrets
    local function worker(job)
        while job.alive and not stopped and head <= tail do
            local item = queue[head]
            local verdict = sendOne(item)
            if verdict == false and item.attempts < MAX_ATTEMPTS then
                item.attempts = item.attempts + 1   -- keep at head, retry after the backoff
            else
                if verdict == false then
                    warn("dropping %s after %d attempts", tostring(item.label), item.attempts)
                    finish(item, false, item.lastStatus)
                end
                queue[head] = nil
                head = head + 1
            end
            if not stopped and head <= tail then
                if not job:sleep(MIN_GAP_SECONDS) then return end
            end
        end
        if head > tail then head, tail = 1, 0 end   -- reset indices when fully drained
        running = false
        workerJob = nil
    end

    -- onDone(ok, status) is an optional per-send result callback (used by test pings)
    local function post(url, payload, label, onDone)
        if stopped then return false, "transport stopped" end
        if type(url) ~= "string" or url == "" then return false, "no url" end
        if type(encode) ~= "function" then return false, "no encoder" end

        if pending() >= MAX_PENDING then
            local dropped = queue[head]
            queue[head] = nil
            head = head + 1
            warn("queue full (%d) — dropped oldest (%s)", MAX_PENDING, dropped and tostring(dropped.label) or "?")
            if dropped then finish(dropped, false, nil) end
        end

        tail = tail + 1
        queue[tail] = { url = url, payload = payload, label = label or "event", attempts = 1, onDone = onDone }

        if not running then
            running = true
            workerJob = Jobs.spawn(worker, { name = "WebhookQueue" })
        end
        return true
    end

    local function stop()
        stopped = true
        -- cancel rather than let the worker notice: it may be parked in a 3s transient backoff
        if workerJob then workerJob:Cancel(); workerJob = nil end
        running = false
        for i = head, tail do queue[i] = nil end
        head, tail = 1, 0
    end

    return {
        post    = post,
        stop    = stop,
        pending = pending,
    }
end

return M

end)
__bundle_register("Api/Esp", function(require, _LOADED, __bundle_register, __bundle_modules)
-- esp api: from-scratch Drawing engine (box/box3d/name/distance/health/tracer/arrow/skeleton + chams) over a group registry that Api/Esp/Sources fills with clover rpg's own categories; groups rescan round-robin at most one per heartbeat and the render lane only moves what a rescan built; built once at boot, shared as ctx.Api.Esp

local Api         = require("Api")
local EntityIndex = require("Utility/EntityIndex")
local Scheduler   = require("Utility/Scheduler")
local UiHost      = require("UI/UiHost")
local Groups      = require("Api/Esp/Groups")
local Object      = require("Api/Esp/Object")
local Sources     = require("Api/Esp/Sources")

-- a group that keeps throwing is reported once per this many seconds, not at its rescan rate
local WARN_EVERY = 30

local M = {}

function M.new(ctx)
    local base = Api.define("Esp", ctx)
    local Services = ctx.Services
    local References = ctx.References
    local Workspace = Services.Workspace

    local hasDrawing = type(Drawing) == "table" and type(Drawing.new) == "function"

    local index  = EntityIndex.get(ctx)
    local groups = Groups.new({ index = index })
    local shared = { textSize = 13, textFont = 2 }

    local container = Instance.new("Folder")
    pcall(function() container.Parent = UiHost.pick() end)
    base.maid:GiveTask(function() pcall(container.Destroy, container) end)

    local deps = { container = container }
    local objects = {}       -- key -> { [instance] = Object }
    local due = {}           -- key -> os.clock() its next rescan is owed at
    local cursor = 0
    local warnedAt = {}
    local groupList = groups.List()  -- cached so the per-frame rescan loop allocates nothing; refreshed on RegisterGroup

    local function warnThrottled(what, fmt, ...)
        local now = os.clock()
        if warnedAt[what] and now - warnedAt[what] < WARN_EVERY then return end
        warnedAt[what] = now
        base.warn(fmt, ...)
    end

    local function clear(key)
        local bucket = objects[key]
        if not bucket then return end
        for inst, obj in pairs(bucket) do obj:Destruct(); bucket[inst] = nil end
    end

    -- drawings live in each object's bin (not in the container), so tear them all down on unload
    base.maid:GiveTask(function()
        for key in pairs(objects) do clear(key) end
    end)

    local function localRoot()
        local char = References.player and References.player.Character
        return char and char:FindFirstChild("HumanoidRootPart")
    end

    local function myPosition()
        local root = localRoot()
        return root and root.Position
    end

    local function targetPosition(t)
        local inst = t.instance
        if t.kind == "player" then
            local ch = inst.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            return hrp and hrp.Position
        end
        if not inst.Parent then return nil end
        if inst:IsA("BasePart") then return inst.Position end
        local hrp = inst:FindFirstChild("HumanoidRootPart") or inst.PrimaryPart
        if hrp then return hrp.Position end
        local ok, pivot = pcall(inst.GetPivot, inst)
        return ok and pivot.Position or nil
    end

    -- reconcile a group's live objects with its source list; distance-capped at maxTracked so nearest targets win
    local function rescan(gd)
        local cfg = gd.config
        local bucket = objects[gd.key]
        if not bucket then bucket = {}; objects[gd.key] = bucket end

        if not (cfg.enabled and hasDrawing) then
            clear(gd.key)
            return
        end

        local ok, targets = pcall(gd.source, gd)
        if not ok then
            warnThrottled("source:" .. gd.key, "%s source threw: %s", gd.key, tostring(targets))
            return
        end
        -- a source that could not read the game hands back nil, which keeps what is on screen
        if type(targets) ~= "table" then return end

        local cap = cfg.maxTracked or 100
        if #targets > cap then
            local myPos = myPosition()
            if myPos then
                for _, t in ipairs(targets) do
                    local p = targetPosition(t)
                    t._d = p and (p - myPos).Magnitude or math.huge
                end
                table.sort(targets, function(a, b) return a._d < b._d end)
            end
        end

        local present = {}
        for i = 1, math.min(#targets, cap) do
            local t = targets[i]
            if t.instance ~= nil then present[t.instance] = t end
        end

        for inst, obj in pairs(bucket) do
            local t = present[inst]
            if t then
                obj:SetLabel(t.label)
            else
                obj:Destruct()
                bucket[inst] = nil
            end
        end
        for inst, t in pairs(present) do
            if not bucket[inst] then bucket[inst] = Object.new(t, cfg, shared, deps) end
        end
    end

    -- round-robin from the last group served, so one slow source never starves the rest and rescans never stack on a frame
    base.maid:GiveTask(Scheduler.heartbeat(function()
        local count = #groupList
        if count == 0 then return end
        local now = os.clock()
        for step = 1, count do
            local i = (cursor + step - 1) % count + 1
            local key = groupList[i].key
            local gd = groups.Get(key)
            if gd and now >= (due[key] or 0) then
                due[key] = now + (gd.config.refreshInterval or 1.0)
                local bucket = objects[key]
                -- a group that is off with nothing on screen costs nothing and does not take this frame's turn
                if gd.config.enabled or (bucket and next(bucket) ~= nil) then
                    cursor = i
                    local ok, err = pcall(rescan, gd)
                    if not ok then warnThrottled("rescan:" .. key, "%s rescan threw: %s", key, tostring(err)) end
                    return
                end
            end
        end
    end, { name = "EspRescan", priority = 210, deferrable = true }))

    -- a throwing object is torn down, not left to spam
    base.maid:GiveTask(Scheduler.render(function()
        local camera = Workspace.CurrentCamera
        if not camera then return end
        local viewport = camera.ViewportSize
        for _, bucket in pairs(objects) do
            for inst, obj in pairs(bucket) do
                local ok = pcall(obj.Tick, obj, camera, viewport)
                if not ok then obj:Destruct(); bucket[inst] = nil end
            end
        end
    end, { name = "EspDraw", priority = 205, deferrable = true }))

    local function register(def)
        local ok = groups.Register(def)
        if ok then
            groupList = groups.List()
            due[def.key] = 0
        end
        return ok
    end

    -- a filter or switch moved, so the list is rebuilt on the next heartbeat rather than at the group's interval
    local function setConfig(key, partial)
        if groups.SetConfig(key, partial) then due[key] = 0 end
    end

    Sources.install(register, ctx, myPosition)

    if not hasDrawing then base.warn("Drawing api unavailable — esp will not render") end
    base.log("esp api ready (drawing=%s, %d groups)", tostring(hasDrawing), #groupList)

    return {
        RegisterGroup  = register,
        GetGroupList   = function() return groups.List() end,
        GetGroupConfig = function(key) local g = groups.Get(key); return g and g.config end,
        SetGroupConfig = setConfig,
        SetEnabled     = function(key, on) setConfig(key, { enabled = on == true }) end,
        SetShared      = function(cfg) if type(cfg) == "table" then for k, v in pairs(cfg) do shared[k] = v end end end,
        GetShared      = function() return shared end,
        -- apply one field across every group (drives the universal ui controls)
        SetAllGroups   = function(partial)
            for _, entry in ipairs(groups.List()) do setConfig(entry.key, partial) end
        end,
        HasDrawing     = function() return hasDrawing end,
    }
end

return M

end)
__bundle_register("Api/Esp/Sources", function(require, _LOADED, __bundle_register, __bundle_modules)
-- esp sources: clover rpg's groups (mobs, bosses, npcs, quest givers, ores, crops, waypoints, shrines, shops, hidden things, points of interest) built over the World and Professions indexes; each source runs at its group's rescan rate, hands back { instance, kind, label } rows and returns nil when the game could not be read, which keeps what is on screen

local Groups = require("Api/Esp/Groups")
local Read   = require("Api/World/Read")

local KIND = "entity"

local MOB     = Color3.fromRGB(255, 150, 50)
local BOSS    = Color3.fromRGB(255, 215, 0)
local NPC     = Color3.fromRGB(110, 200, 255)
local QUEST   = Color3.fromRGB(255, 120, 220)
local ORE     = Color3.fromRGB(170, 180, 255)
local CROP    = Color3.fromRGB(130, 225, 100)
local GATE    = Color3.fromRGB(80, 230, 220)
local SHRINE  = Color3.fromRGB(255, 185, 120)
local SHOP    = Color3.fromRGB(255, 245, 160)
local HIDDEN  = Color3.fromRGB(190, 110, 255)
local POI     = Color3.fromRGB(150, 255, 200)

-- ManaVisionClient.lua:321-327: what mana vision reveals
local CONCEALED = "Concealed"

-- node models only exist where the map has streamed in, so a node past this is never worth resolving
local NODE_RANGE = 1000
local NODE_REACH = 300
local NODE_CAP   = 40

local NOT_READY = " (not ready)"

local M = {}

local function capOf(cfg)
    return math.max(1, math.floor(cfg.maxTracked or 100))
end

-- a World list filter: range-limited only while the user limits range
local function near(cfg, filter)
    if cfg.limitDistance then filter.maxDistance = cfg.maxDistance end
    return filter
end

local function row(instance, label)
    return { instance = instance, kind = KIND, label = label }
end

-- something the engine can anchor: a model, or a bare part drawn as a point
local function drawable(inst)
    if inst == nil then return nil end
    if inst:IsA("Model") or inst:IsA("BasePart") then return inst end
    return nil
end

-- a body group draws boxes on rigs, so its accent rides the box and the name stays white
local function bodyConfig(accent, refresh)
    local cfg = Groups.defaultConfig(accent)
    cfg.refreshInterval = refresh
    return cfg
end

-- a point group draws a label, so its name and distance carry the accent instead
local function pointConfig(accent, refresh)
    local cfg = Groups.defaultConfig(accent)
    cfg.refreshInterval = refresh
    cfg.box.enabled = false
    cfg.health.bar = false
    cfg.name.color = accent
    cfg.distance.enabled = true
    cfg.distance.color = accent
    return cfg
end

-- register(def) is the engine's; origin() is the local character's position or nil
function M.install(register, ctx, origin)
    local apis = type(ctx.Api) == "table" and ctx.Api or {}
    local World = type(apis.World) == "table" and apis.World or nil
    local Professions = type(apis.Professions) == "table" and apis.Professions or nil
    local CollectionService = ctx.Services.CollectionService

    -- World answers (true, list) or (false, code); a failure keeps what is on screen
    local function listed(ok, list)
        if not ok or type(list) ~= "table" then return nil end
        return list
    end

    -- one row per instance build keeps; a list that comes nearest first stops at cap, any other is left whole for the engine to rank by distance
    local function rows(list, cap, build)
        if list == nil then return nil end
        local out, seen = {}, {}
        for _, entry in ipairs(list) do
            if cap ~= nil and #out >= cap then break end
            local inst, label = build(entry)
            if inst ~= nil and not seen[inst] then
                seen[inst] = true
                out[#out + 1] = row(inst, label)
            end
        end
        return out
    end

    local function mobSource(bosses)
        return function(g)
            local cfg = g.config
            local filter = near(cfg, { alive = true })
            if bosses then
                filter.bossOnly = true
                filter.limit = capOf(cfg)
            end
            return rows(listed(World.mobs(filter)), capOf(cfg), function(entry)
                if entry.boss and not bosses then return nil end
                return entry.model, entry.name
            end)
