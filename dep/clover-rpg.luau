local CALLBACK = "GetMousePosition"

local M = {}

local function isPart(value)
    return typeof(value) == "Instance" and value:IsA("BasePart") and value.Parent ~= nil
end

-- Mouse.Hit faces along the camera ray, so the spoofed hit looks from the camera through the target
local function hitFrame(position)
    local camera = Services.Workspace.CurrentCamera
    if camera ~= nil then
        local away = position - camera.CFrame.Position
        if away.Magnitude > 1e-3 then return CFrame.lookAt(position, position + away.Unit) end
    end
    return CFrame.new(position)
end

