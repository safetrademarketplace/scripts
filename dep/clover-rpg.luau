        if not ok then return false, fatal end
        local untilAt = nil
        if window then untilAt = os.clock() + window end
        press = { char = char, window = window, untilAt = untilAt }
        startBeat()
        return true
    end

    function guard.holding()
        return press ~= nil and press.window == nil
    end

    function guard.pressing()
        return press ~= nil
    end

    function guard.parrying()
        return press ~= nil and press.window ~= nil
    end

    -- a parry still running becomes the held block, so the key never lifts between them
    function guard.hold()
