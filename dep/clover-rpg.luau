-- interact locate: where a prompt or a dialogue subject stands, which prompt a container carries, and whether two handles are one instance now that cloneref makes == unreliable

local Locate = {}

-- two reads of one instance in the same frame agree exactly; this only absorbs float noise
local MATCH_RADIUS = 1

local function isInstance(value)
    return typeof(value) == "Instance"
end

-- Parent hands back the game's own handle, never == a cloneref'd container, so depth is counted to the root; every candidate shares the container's ancestry, so the order is the same
local function depthOf(inst)
    local depth, node = 0, inst.Parent
    while node ~= nil do
        depth = depth + 1
        node = node.Parent
    end
    return depth
end

-- the engine anchors a prompt to its part, its attachment's world position or its model's pivot; anywhere else it never shows
function Locate.promptPosition(prompt)
    local parent = prompt.Parent
    if parent == nil then return nil end
    if parent:IsA("BasePart") then return parent.Position end
    if parent:IsA("Attachment") then return parent.WorldPosition end
    if parent:IsA("Model") then return parent:GetPivot().Position end
    return nil
end

function Locate.position(inst)
    if inst:IsA("ProximityPrompt") then return Locate.promptPosition(inst) end
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Attachment") then return inst.WorldPosition end
    if inst:IsA("Model") then return inst:GetPivot().Position end
    return nil
end

-- the shallowest match, so a prompt on the root beats one buried in an accessory; the second value says a match exists but is switched off
function Locate.find(container, name, includeDisabled)
    local best, bestDepth, sawDisabled = nil, math.huge, false
    for _, inst in ipairs(container:GetDescendants()) do
        if inst.ClassName == "ProximityPrompt" and (name == nil or inst.Name == name) then
            if includeDisabled or inst.Enabled then
                local depth = depthOf(inst)
                if depth < bestDepth then
                    best, bestDepth = inst, depth
                end
            else
                sawDisabled = true
            end
        end
    end
    return best, sawDisabled
end

-- one full path standing in one spot; same-named siblings under one folder are told apart by where they stand
function Locate.same(a, b)
    if not isInstance(a) or not isInstance(b) then return false end
    if rawequal(a, b) then return true end
    if a.ClassName ~= b.ClassName or a.Name ~= b.Name then return false end
    if a:GetFullName() ~= b:GetFullName() then return false end
    local atA, atB = Locate.position(a), Locate.position(b)
    if atA == nil or atB == nil then return atA == nil and atB == nil end
    return (atA - atB).Magnitude <= MATCH_RADIUS
end

return Locate

end)
