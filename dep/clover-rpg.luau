__bundle_register("Features/Player/Movement/Flight", function(require, _LOADED, __bundle_register, __bundle_modules)
-- flight sub-module of movement (LinearVelocity constraint flight)
local Str       = require("Utility/Helpers/Str")
local Scheduler = require("Utility/Scheduler")
local Place     = require("UI/Place")

return function(ctx)
    local Services   = ctx.Services
    local References = ctx.References
    local Library    = ctx.Library
    local Options    = ctx.Options
    local Toggles    = ctx.Toggles
    local track      = ctx.track

    local FlightGroup = Place.groupbox(ctx, "Flight", "move-3d", { fallback = "Player", side = "Left" })
    if not FlightGroup then return {} end

    FlightGroup:AddToggle("FlightEnabled", {
        Text = "Flight",
        Default = false
    }):AddKeyPicker("FlightKey", {
        -- unbound: Y is the game's own broom key
        Default = nil,
        SyncToggleState = true,
        Mode = "Toggle"
    })

    local FlightBox = FlightGroup:AddDependencyBox()

    FlightBox:AddSlider("FlightSpeed", {
        Text = "Flight Speed",
        Default = 100,
        Min = 30,
        Max = 400,
        Rounding = 0
    })

    FlightBox:SetupDependencies({
        { Toggles.FlightEnabled, true },
    })

    local currentFlightSpeed = Options.FlightSpeed.Value

    -- per-session random names: constraints on the HRP replicate to the server, so a fixed name would be a deterministic kick condition
    local flightConn
    local MOVER_NAME  = "_lv"  .. Str.randomHex(8)
    local ATTACH_NAME = "_att" .. Str.randomHex(8)

    -- touch has no space or shift, so vertical gets its own on-screen buttons while flight is running
    local ASCEND   = "_fu" .. Str.randomHex(6)
    local DESCEND  = "_fd" .. Str.randomHex(6)
    local vertical = 0

    local function verticalAction(sign)
        return function(_, state)
            if state == Enum.UserInputState.Begin then
                vertical = sign
            elseif vertical == sign then
                vertical = 0
            end
            return Enum.ContextActionResult.Pass
        end
    end

    local function bindTouchVertical()
        if not Services.UserInputService.TouchEnabled then return end
        local CAS = Services.ContextActionService
        -- no input types: the binding exists purely to place a touch button, never to swallow a key or a pad stick
        CAS:BindAction(ASCEND, verticalAction(1), true)
        CAS:BindAction(DESCEND, verticalAction(-1), true)
        CAS:SetTitle(ASCEND, "Up")
        CAS:SetTitle(DESCEND, "Down")
    end

    local function unbindTouchVertical()
        local CAS = Services.ContextActionService
        pcall(CAS.UnbindAction, CAS, ASCEND)
        pcall(CAS.UnbindAction, CAS, DESCEND)
        vertical = 0
    end

    local function removeMovers(hrp)
        if not hrp then return end
        for _, v in ipairs(hrp:GetChildren()) do
            if v.Name == MOVER_NAME or v.Name == ATTACH_NAME then
                v:Destroy()
            end
        end
    end

    local function setupMovers(hrp)
        removeMovers(hrp)

        local a0 = Instance.new("Attachment")
        a0.Name = ATTACH_NAME
        a0.Parent = hrp

        local lv = Instance.new("LinearVelocity")
        lv.Name = MOVER_NAME
        lv.Attachment0 = a0
        -- 1e7 gives huge margin over character weight without math.huge, which anti-cheats heuristically flag on player constraints
        lv.MaxForce = 1e7
        lv.VectorVelocity = Vector3.zero
        lv.RelativeTo = Enum.ActuatorRelativeTo.World
        lv.Parent = hrp

        return lv
    end

    local function startFlight()
        if flightConn then return end
        Library:Notify("Flight enabled.", 2)

        bindTouchVertical()
        flightConn = track(Scheduler.render(function()
            local hrp = References.humanoidRootPart
            local camera = References.camera
            if not hrp or not camera then return end

            -- rebuild movers if missing (player respawned while flight active)
            local lv = hrp:FindFirstChild(MOVER_NAME)
            if not lv then
                lv = setupMovers(hrp)
            end

            local cframe = camera.CFrame
            local look, right, up = cframe.LookVector, cframe.RightVector, cframe.UpVector
            local dir = Vector3.zero
            local KC = Enum.KeyCode

            if Services.UserInputService:IsKeyDown(KC.W) then dir = dir + look end
            if Services.UserInputService:IsKeyDown(KC.S) then dir = dir - look end
            if Services.UserInputService:IsKeyDown(KC.A) then dir = dir - right end
            if Services.UserInputService:IsKeyDown(KC.D) then dir = dir + right end
            if Services.UserInputService:IsKeyDown(KC.Space) then dir = dir + up end
            if Services.UserInputService:IsKeyDown(KC.LeftShift)
                or Services.UserInputService:IsKeyDown(KC.LeftControl) then
                dir = dir - up
            end

            -- MoveDirection is already camera-resolved world space, so never re-project it; only taken when no key produced a direction
            if dir.Magnitude == 0 and References.humanoid then
                dir = dir + References.humanoid.MoveDirection
            end

            if vertical ~= 0 then
                dir = dir + Vector3.yAxis * vertical
            end

            if dir.Magnitude > 0 then
                lv.VectorVelocity = dir.Unit * currentFlightSpeed
            else
                lv.VectorVelocity = Vector3.zero
            end

            hrp.AssemblyAngularVelocity = Vector3.zero
        end, { name = "Flight", priority = 50 }))
    end

    local function stopFlight()
        if flightConn then
            Library:Notify("Flight disabled.", 2)
            flightConn:Disconnect()
            flightConn = nil
            unbindTouchVertical()

            if References.humanoidRootPart then
                removeMovers(References.humanoidRootPart)
                References.humanoidRootPart.AssemblyAngularVelocity = Vector3.zero
                References.humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
            end
        end
    end

    if Toggles.FlightEnabled then
        Toggles.FlightEnabled:OnChanged(function()
            if Toggles.FlightEnabled.Value then startFlight() else stopFlight() end
        end)
    end

    if Options.FlightSpeed then
        Options.FlightSpeed:OnChanged(function()
            currentFlightSpeed = Options.FlightSpeed.Value
        end)
    end

    return { startFlight = startFlight, stopFlight = stopFlight }
end

end)
