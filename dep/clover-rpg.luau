__bundle_register("Api/Respawn", function(require, _LOADED, __bundle_register, __bundle_modules)
-- respawn api: brings a dead character back the way the respawn screen does (RespawnClient.lua:23-50), at the nearest unlocked shrine of the region when the screen would offer one, the mission's own spawn inside a mission and the inn otherwise, only once the screen itself has opened; afterwards it puts back anything the screen left behind (its scriptable camera hovering over the spawn, the overlay, and the streaming focus on the spawn point, live 2026-10-24, which kept the world from streaming in round the character); shared as ctx.Api.Respawn
local References = require("References")
local Services   = require("Services")
local Executor   = require("Utility/Executor")
local Jobs       = require("Utility/Jobs")
local Api        = require("Api")
local Errors     = require("Api/Respawn/Errors")

local REMOTE = "LoadCharacter"
-- RespawnClient.lua:252-262: the screen opens three seconds after Died, and never while an invasion holds respawns
local SCREEN_DELAY = 3
-- Basic.lua:56
local SHRINE_RANGE = 700
local ANSWER_WAIT  = 10
-- the screen is waited for this much past SCREEN_DELAY before asking anyway; the new character is checked this long after it is alive, once the screen's own CharacterAdded handler has run
local SCREEN_GRACE = 2
local SPAWN_WAIT   = 10
local RESTORE_AFTER = 1.5

local M = {}

function M.new(ctx)
    local base = Api.define("Respawn", ctx)
    local api = { Errors = Errors }
    local closed = false
    local diedAt = nil
    local scheduleRestore

    local function state()
        local s = ctx.Api and ctx.Api.State
        if type(s) == "table" then return s end
        return nil
    end

    local function settle(label, ok, ...)
        if ok then return ... end
        base.warn("%s threw: %s", label, tostring((...)))
        return false, Errors.FAILED
    end

    local function expose(name, fn)
        local label = "Respawn." .. name
        api[name] = function(...)
            if closed then return false, Errors.NOT_READY end
            return settle(label, pcall(fn, ...))
        end
    end

    local function screen()
        local player = References.player
        local gui = player and player:FindFirstChild("PlayerGui")
        local ui = gui and gui:FindFirstChild("RespawnUI")
        return ui and ui:FindFirstChild("Visual") or nil
    end

    -- RespawnClient.lua:132-240: FadeUI(true) shows Visual.Main
    local function screenOpen()
        local visual = screen()
        local main = visual and visual:FindFirstChild("Main")
        return main ~= nil and main.Visible == true
    end

    local function dead()
        local s = state()
        if s == nil then return nil end
        local ok, isDead = s.dead()
        if not ok then return true end
        return isDead == true
    end

    -- RespawnClient.lua:212-232: an unlocked shrine of this region in range of where the character fell
    local function nearestShrine(from)
        local map = Services.Workspace:FindFirstChild("Map")
        local structures = map and map:FindFirstChild("Structures")
        local shrines = structures and structures:FindFirstChild("Shrines")
        if shrines == nil or from == nil then return nil end
        local s = state()
        local location = nil
        if s ~= nil then
            local ok, name = s.location()
            if ok then location = name end
        end
        local best, bestDistance = nil, math.huge
        for _, shrine in ipairs(shrines:GetChildren()) do
            local primary = shrine:IsA("Model") and shrine.PrimaryPart or nil
            if primary then
                local uid = shrine:GetAttribute("uid")
                if not uid or References.player:GetAttribute(uid) then
                    local range = shrine:GetAttribute("Range") or SHRINE_RANGE
                    local gap = (primary.Position - from).Magnitude
                    if gap < range and gap < bestDistance then
                        local region = shrine:GetAttribute("Region")
                        local fits = not region or region == ""
                        if not fits and location then
                            for part in string.gmatch(region, "[^_]+") do
                                if part == location then fits = true end
                            end
                        end
                        if fits then best, bestDistance = shrine, gap end
                    end
                end
            end
        end
        return best
    end

    local function fellAt()
        local s = state()
        if s == nil then return nil end
        local ok, root = s.root()
        if ok and root then return root.Position end
        return nil
    end

    -- the choice the screen would leave the player: inside a mission its own spawn, else a shrine when one is offered, else the inn
    local function choose(want)
        if References.player:GetAttribute("InMissionInstance") and want ~= "inn" then return "mission" end
        if want == "inn" then return "inn" end
        local shrine = nearestShrine(fellAt())
        if shrine then return "shrine", shrine end
        if want == "shrine" then return nil end
        return "inn"
    end

    -- (true, { dead, ready, why, choice, shrine }) so a farm can say what it is waiting on
    expose("status", function()
        local isDead = dead()
        if isDead == nil then return false, Errors.NOT_READY end
        local out = { dead = isDead, ready = false }
        if not isDead then return true, out end
        if References.player:GetAttribute("InvasionRespawnLocked") then
            out.why = "locked"
        elseif not screenOpen() and diedAt and os.clock() - diedAt < SCREEN_DELAY + SCREEN_GRACE then
            out.why = "too_soon"
        else
            out.ready = true
        end
        local choice, shrine = choose("auto")
        out.choice, out.shrine = choice, shrine and shrine.Name or nil
        return true, out
    end)

