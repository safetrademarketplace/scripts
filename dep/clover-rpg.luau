__bundle_register("Features/Navigation/Teleports/Ground", function(require, _LOADED, __bundle_register, __bundle_modules)
-- teleport ground: the read-only rays the teleports feature aims with, the floor under a centre that may hang in the air and the ground under the mouse; nothing here moves anything

local Services = require("Services")

local Workspace        = Services.Workspace
local UserInputService = Services.UserInputService

-- people, mobs and npcs are never the floor, so a ray passes through them to the ground beneath
local SKIPPED = { "pCharacters", "FightableNPCS", "NPCS" }
-- started this far above a point, so a roof overhead is never read as its floor
local LIFT = 2
local MOUSE_RANGE = 2000

local M = {}

local function params(extra)
    local skip = {}
    for _, name in ipairs(SKIPPED) do
        local folder = Workspace:FindFirstChild(name)
        if folder then skip[#skip + 1] = folder end
    end
    if extra then skip[#skip + 1] = extra end
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = skip
    -- a see-through zone box or a tree you can walk through is not somewhere to stand
    rayParams.RespectCanCollide = true
    return rayParams
end

local function cast(origin, direction, rayParams)
    local ok, hit = pcall(Workspace.Raycast, Workspace, origin, direction, rayParams)
    if ok and hit then return hit.Position end
    return nil
end

-- the floor under point within depth studs, else (when above is given) the highest floor found looking down from that far over it; nil while nothing there has streamed in
function M.under(point, depth, above)
    local rayParams = params(nil)
    local hit = cast(point + Vector3.new(0, LIFT, 0), Vector3.new(0, -(depth + LIFT), 0), rayParams)
    if hit or not above or above <= 0 then return hit end
    return cast(point + Vector3.new(0, above, 0), Vector3.new(0, -(above + depth), 0), rayParams)
end

-- the solid ground under the mouse, your own character left out
function M.mouse(character)
    local camera = Workspace.CurrentCamera
    if not camera then return nil end
    local at = UserInputService:GetMouseLocation()
    local ray = camera:ViewportPointToRay(at.X, at.Y)
    return cast(ray.Origin, ray.Direction * MOUSE_RANGE, params(character))
end

return M

end)
__bundle_register("Features/Navigation/Teleports/Places", function(require, _LOADED, __bundle_register, __bundle_modules)
-- teleport places box: pick a kind of place and a destination the world api knows, travel there, stop, and read live how the trip is going; the pick is held by key so a refresh that renumbers it keeps it picked

local Place   = require("UI/Place")
local Widgets = require("Features/Navigation/Teleports/Widgets")

return function(deps)
    local Destinations = deps.Destinations
    local Travel       = deps.Travel
    local categories   = deps.categories

    local box = Place.groupbox(deps.Env, "Places", "map", { fallback = "Teleports", side = "Left" })
    if not box then return nil end

    local labels, byLabel = {}, {}
    for _, category in ipairs(categories) do
        labels[#labels + 1] = category.label
        byLabel[category.label] = category
    end

    local current = categories[1]
    local records, recordByLabel, recordByKey = {}, {}, {}
    local pickedKey = nil
    local note = nil
    -- the labels as a set, so a relist that only reorders them leaves the dropdown alone
    local shownSet = ""

    local destination, setAbout

    local function picked()
        return pickedKey ~= nil and recordByKey[pickedKey] or nil
    end

    local function describe()
        local record = picked()
        if not record then return setAbout(note or "Pick a destination.") end
        local parts = {}
        local away = Destinations.away(record)
        if away then parts[#parts + 1] = away end
        if record.about then parts[#parts + 1] = record.about end
        if note and note ~= "" and #records > 0 then parts[#parts + 1] = note end
        setAbout(#parts > 0 and table.concat(parts, " ") or " ")
    end

    local function setKey(list)
        local copy = {}
        for i, label in ipairs(list) do copy[i] = label end
        table.sort(copy)
        return table.concat(copy, "\n")
    end

    -- force rebuilds the dropdown in the new order; otherwise it is only rebuilt when places came or went
    local function relist(force)
        records, note = Destinations.build(current.key)
        recordByLabel, recordByKey = {}, {}
        local shown = {}
        for _, record in ipairs(records) do
            shown[#shown + 1] = record.label
            recordByLabel[record.label] = record
            recordByKey[record.key] = record
        end
        if not recordByKey[pickedKey] then pickedKey = records[1] and records[1].key or nil end
        local set = setKey(shown)
        local rebuild = force or set ~= shownSet
        shownSet = set
        local record = picked()
        destination.fill(rebuild and shown or nil, record and record.label or nil)
        describe()
    end

    Widgets.picker(box, "TP_Category", {
        Text    = "Kind Of Place",
        Values  = labels,
        Default = current.label,
        Tooltip = "What kind of place to pick from.",
    }, function(value)
        local category = byLabel[value]
        if not category or category == current then return end
        current = category
        pickedKey = nil
        relist(true)
    end)

    destination = Widgets.picker(box, "TP_Location", {
        Text       = "Destination",
        Values     = {},
        Searchable = true,
        Tooltip    = "Where to go. Places with the same name are listed nearest first.",
    }, function(value)
        local record = value and recordByLabel[value] or nil
        if record then pickedKey = record.key end
        describe()
    end)

    setAbout = Widgets.line(box, "Pick a destination.")

    box:AddButton({
        Text    = "Go",
        Tooltip = "Travel to the picked destination. You glide there along the ground at your Travel Speed.",
        Func    = function() Travel.go(picked()) end,
    }):AddButton({
        Text    = "Stop",
        Tooltip = "Stop where you are.",
        Func    = function() Travel.stop() end,
    })

    box:AddButton({
        Text    = "Refresh List",
        Tooltip = "Look again. Some places only load in once you get closer to them.",
        Func    = function() relist(true) end,
    })

    local setStatus = Widgets.line(box, Travel.line())

    local function status()
        setStatus(Travel.line())
    end

    relist(true)

    return {
        describe = function()
            describe()
            status()
        end,
        relist = function() relist(false) end,
        status = status,
    }
end

end)
