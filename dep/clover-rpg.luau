    local function http_get(url)
        local ok, res = Http.request({ Url = url, Method = "GET" })
        if ok and res and (res.Body or res.body) then
            return true, (res.Body or res.body)
        end
        return false, "No HTTP function (syn.request/request/http_request/http.request)"
    end

    local function write_bytes(path, bytes)
        if not writefile then
            return false, "writefile missing"
        end
        local ok, err = pcall(function()
            writefile(path, bytes)
        end)
        if not ok then
            return false, tostring(err)
        end
        return true
    end

    local function url_hash(s)
        local h = 5381
        for i = 1, #s do
            h = (h * 33 + string.byte(s, i)) % 4294967296
        end
        return string.format("%08x", h)
    end

    local function cache_path_for(url)
        local ext = url:match("%.([A-Za-z0-9]+)%f[%z%?%#]") or "bin"
        ext = ext:lower()
        if ext ~= "mp3" and ext ~= "ogg" and ext ~= "wav" then
            ext = "mp3"
        end
        return ("%s/%s.%s"):format(CACHE_DIR, url_hash(url), ext)
    end

    local function map_to_asset(path)
        if getcustomasset then
            local ok, v = pcall(getcustomasset, path)
            if ok and type(v) == "string" and #v > 0 then
                return true, v
            end
        end

        if getsynasset then
            local ok, v = pcall(getsynasset, path)
            if ok and type(v) == "string" and #v > 0 then
                return true, v
            end
        end

        if getsynfile then
            local ok, v = pcall(getsynfile, path)
            if ok and type(v) == "string" and #v > 0 then
                return true, v
            end
        end

