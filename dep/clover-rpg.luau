        self.arrow.Color = self:resolveColor(arrow.color)
        self.arrow.Transparency = arrow.transparency
        if self.arrowOutln.Visible then
            self.arrowOutln.PointA = a; self.arrowOutln.PointB = b; self.arrowOutln.PointC = c
            self.arrowOutln.Color = arrow.outlineColor
        end
    end
end

function Object:Tick(camera, viewport)
    self:Update(camera, viewport)
    self:Render(camera, viewport)
end

return Object

end)
__bundle_register("Api/Esp/Geometry", function(require, _LOADED, __bundle_register, __bundle_modules)
-- projection + bounding-box + rig/skeleton math for the esp renderer; hot per-frame helpers run native-speed in the unobfuscated half

local floor = math.floor

local VERTICES = {
    Vector3.new(-1, -1, -1), Vector3.new(-1, 1, -1), Vector3.new(-1, 1, 1), Vector3.new(-1, -1, 1),
    Vector3.new(1, -1, -1),  Vector3.new(1, 1, -1),  Vector3.new(1, 1, 1),  Vector3.new(1, -1, 1),
}

-- adjacent part-name pairs to connect with a line
local R15_BONES = {
    { "Head", "UpperTorso" }, { "UpperTorso", "LowerTorso" },
    { "UpperTorso", "LeftUpperArm" }, { "LeftUpperArm", "LeftLowerArm" }, { "LeftLowerArm", "LeftHand" },
    { "UpperTorso", "RightUpperArm" }, { "RightUpperArm", "RightLowerArm" }, { "RightLowerArm", "RightHand" },
    { "LowerTorso", "LeftUpperLeg" }, { "LeftUpperLeg", "LeftLowerLeg" }, { "LeftLowerLeg", "LeftFoot" },
    { "LowerTorso", "RightUpperLeg" }, { "RightUpperLeg", "RightLowerLeg" }, { "RightLowerLeg", "RightFoot" },
}
local R6_BONES = {
    { "Head", "Torso" },
    { "Torso", "Left Arm" }, { "Torso", "Right Arm" },
    { "Torso", "Left Leg" }, { "Torso", "Right Leg" },
}

local M = {}

function M.isBodyPart(name)
    return name == "Head" or name:find("Torso") or name:find("Leg") or name:find("Arm")
end

-- rig from Humanoid.RigType, falling back to part presence
function M.bones(character, humanoid)
    local rig = humanoid and humanoid.RigType
    if rig == Enum.HumanoidRigType.R15 then return R15_BONES end
    if rig == Enum.HumanoidRigType.R6 then return R6_BONES end
    return character:FindFirstChild("UpperTorso") and R15_BONES or R6_BONES
end

M.worldToScreen = function(camera, world)
    local screen, onScreen = camera:WorldToViewportPoint(world)
    return Vector2.new(screen.X, screen.Y), onScreen, screen.Z
end

M.rotateVector = function(vector, radians)
    local x, y = vector.X, vector.Y
    local c, s = math.cos(radians), math.sin(radians)
    return Vector2.new(x * c - y * s, x * s + y * c)
end

M.boundingBox = function(parts)
    local min, max
    for i = 1, #parts do
        local cframe, size = parts[i].CFrame, parts[i].Size
        min = (min or cframe.Position):Min((cframe - size * 0.5).Position)
        max = (max or cframe.Position):Max((cframe + size * 0.5).Position)
    end
    if not min then return nil end
    local center = (min + max) * 0.5
    return CFrame.new(center, Vector3.new(center.X, center.Y, max.Z)), max - min
end

M.corners = function(camera, viewportSize, cframe, size)
    local corners = table.create(8)
    for i = 1, 8 do
        local screen = camera:WorldToViewportPoint((cframe + size * 0.5 * VERTICES[i]).Position)
        corners[i] = Vector2.new(screen.X, screen.Y)
    end
    local min = viewportSize:Min(table.unpack(corners))
    local max = Vector2.zero:Max(table.unpack(corners))
    return {
        corners = corners,
        topLeft = Vector2.new(floor(min.X), floor(min.Y)),
        topRight = Vector2.new(floor(max.X), floor(min.Y)),
        bottomLeft = Vector2.new(floor(min.X), floor(max.Y)),
        bottomRight = Vector2.new(floor(max.X), floor(max.Y)),
    }
end

return M

end)
__bundle_register("Utility/EntityIndex", function(require, _LOADED, __bundle_register, __bundle_modules)
-- shared session-wide target index (non-local players + non-player humanoid models); workspace listeners start lazily on first entities() call

local M = {}

local shared = nil

local function build(ctx)
    local Services   = ctx.Services
    local References = ctx.References

    local maid = (ctx.NewMaid and ctx.NewMaid())
        or (ctx.Maid and type(ctx.Maid.new) == "function" and ctx.Maid.new())
        or nil

    local entityModels  = {}
    local playerCharSet = {}
    local entityReady   = false

    local function rebuildPlayerCharSet()
        table.clear(playerCharSet)
        for _, plr in ipairs(Services.Players:GetPlayers()) do
            if plr.Character then playerCharSet[plr.Character] = true end
        end
    end

    local function isPlayerModelName(name)
        return type(name) == "string" and name ~= ""
            and Services.Players:FindFirstChild(name) ~= nil
    end

    local function shouldTrack(model)
        if not (model and model:IsA("Model") and model.Parent) then return false end
        if Services.Players:GetPlayerFromCharacter(model) then return false end
        if isPlayerModelName(model.Name) then return false end
        if playerCharSet[model] then return false end
        return model:FindFirstChildOfClass("Humanoid") ~= nil
    end

    local function ensureEntityIndex()
        if entityReady then return end
        entityReady = true
        table.clear(entityModels)
        rebuildPlayerCharSet()
        for _, d in ipairs(Services.Workspace:GetDescendants()) do
            if d:IsA("Humanoid") then
                local model = d.Parent
                if shouldTrack(model) then entityModels[model] = true end
            end
        end
        if not maid then return end
        maid:GiveTask(Services.Workspace.DescendantAdded:Connect(function(d)
            if d:IsA("Humanoid") then
                local model = d.Parent
                if shouldTrack(model) then entityModels[model] = true end
            end
        end))
        maid:GiveTask(Services.Workspace.DescendantRemoving:Connect(function(d)
            if d:IsA("Humanoid") then
                local model = d.Parent
                if model then entityModels[model] = nil end
                return
            end
            if d:IsA("Model") then entityModels[d] = nil; playerCharSet[d] = nil end
        end))
    end

    -- optional narrowing by workspace folder, CollectionService tag or predicate; no options = every non-player humanoid
    local function passesOptions(model, options)
        if not options then return true end
        if options.predicate then
            local ok, pass = pcall(options.predicate, model)
            if not ok or not pass then return false end
        end
        if options.tag and not Services.CollectionService:HasTag(model, options.tag) then
            return false
        end
        if options.folders then
            local inFolder = false
            for _, name in ipairs(options.folders) do
                local folder = Services.Workspace:FindFirstChild(name)
                if folder and model:IsDescendantOf(folder) then inFolder = true; break end
            end
            if not inFolder then return false end
        end
        return true
    end

    -- eager player-character tracking (cheap, needed for exclusion + players())
    rebuildPlayerCharSet()
    local function trackPlayer(plr)
        if not maid then return end
        maid:GiveTask(plr.CharacterAdded:Connect(function(char)
            playerCharSet[char] = true
            entityModels[char] = nil
        end))
        maid:GiveTask(plr.CharacterRemoving:Connect(function(char)
            playerCharSet[char] = nil
            entityModels[char] = nil
        end))
    end
    if maid then
        maid:GiveTask(Services.Players.PlayerAdded:Connect(function(plr)
            trackPlayer(plr)
            rebuildPlayerCharSet()
        end))
    end
    for _, plr in ipairs(Services.Players:GetPlayers()) do trackPlayer(plr) end

    local function players()
        local out = {}
        -- compare by UserId, not reference: References.player is a cloneref, so `plr ~= it` never excludes self
        local localId = (References.player and References.player.UserId)
            or (Services.Players.LocalPlayer and Services.Players.LocalPlayer.UserId)
        for _, plr in ipairs(Services.Players:GetPlayers()) do
            if plr.UserId ~= localId then out[#out + 1] = plr end
        end
        return out
    end

    local function entities(options)
        ensureEntityIndex()
        local out = {}
        for model in pairs(entityModels) do
            if model and model.Parent and not playerCharSet[model] then
                if passesOptions(model, options) then out[#out + 1] = model end
            else
                entityModels[model] = nil
            end
        end
        return out
    end

    if maid and ctx.Unloader and type(ctx.Unloader.Register) == "function" then
        ctx.Unloader:Register(function()
            maid:DoCleaning()
            shared = nil
        end)
    end

    return { players = players, entities = entities }
end

function M.get(ctx)
    if not shared then shared = build(ctx) end
    return shared
end

return M

end)
