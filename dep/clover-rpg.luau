__bundle_register("Api/Movement/Water", function(require, _LOADED, __bundle_register, __bundle_modules)
-- movement water: the level the game swims a character at (WaterZones.lua:45-87), a SwimWater lake's top less SURFACE_DEPTH or else the sea at SEA_LEVEL outside every DeadZones volume; below it SwimClient pins the root with an AlignPosition no mover can pull out of, so no route may dip under it
local Services = require("Services")

local SEA_LEVEL     = 1
local SURFACE_DEPTH = 1
local LAKE_TAG      = "SwimWater"

local M = {}

-- DeadZones.lua:8-30 reads its own Configurations once at load; so does this, from the instances rather than a second require of the module
local zones = nil

local function deadZones()
    if zones then return zones end
    zones = {}
    local modules = Services.ReplicatedStorage:FindFirstChild("Modules")
    local folder = modules and modules:FindFirstChild("DeadZones")
    if not folder then return zones end
    for _, item in ipairs(folder:GetDescendants()) do
        if item:IsA("Configuration") then
            local position, size = item:FindFirstChild("Position"), item:FindFirstChild("Size")
            local frame, extent = position and position.Value, size and size.Value
            if typeof(frame) == "CFrame" and typeof(extent) == "Vector3" then
                zones[#zones + 1] = { frame = frame, half = extent / 2 }
            end
        end
    end
    return zones
end

local function inDeadZone(point)
    for _, zone in ipairs(deadZones()) do
        local at, half = zone.frame:PointToObjectSpace(point), zone.half
        if math.abs(at.X) < half.X and math.abs(at.Y) < half.Y and math.abs(at.Z) < half.Z then return true end
    end
    return false
end

-- a reader over the lakes streamed in right now, for one planning pass: level(point) is the swim level there, or nil where nothing swims
function M.reader()
    local lakes = {}
    local ok, tagged = pcall(function() return Services.CollectionService:GetTagged(LAKE_TAG) end)
    if ok and type(tagged) == "table" then
        for _, part in ipairs(tagged) do
            if part:IsA("BasePart") then lakes[#lakes + 1] = part end
        end
    end
    return function(point)
        local best = nil
        for _, lake in ipairs(lakes) do
            local okLake, top = pcall(function()
                local half = lake.Size / 2
                local at = lake.CFrame:PointToObjectSpace(point)
                if math.abs(at.X) <= half.X and math.abs(at.Z) <= half.Z and at.Y >= -half.Y - 2 then
                    return lake.Position.Y + half.Y - SURFACE_DEPTH
                end
                return nil
            end)
            if okLake and top and (not best or top > best) then best = top end
        end
        if best then return best end
        if inDeadZone(point) then return nil end
        return SEA_LEVEL
    end
end

return M

end)
