        { Toggles.SpeedEnabled, true },
    })

    local currentSpeedValue = Options.SpeedValue.Value

    local speedPropConn
    local speedCharConn
    local speedEnabled = false
    local speedOrigWalkSpeed
    local speedOrigHumanoid

    local function cacheSpeedBaseline(hum)
        if not hum then return end
        if speedOrigHumanoid ~= hum then
            speedOrigHumanoid = hum
            speedOrigWalkSpeed = hum.WalkSpeed
        end
    end

    local function applySpeed()
        local hum = References.humanoid
        if not hum then return end
        if hum.WalkSpeed ~= currentSpeedValue then
            hum.WalkSpeed = currentSpeedValue
        end
    end

    local function bindHumanoid()
