local LiveModules  = require("Features/Clover/PlayerUtils/LiveModules")
local RespawnPatch = require("Features/Clover/PlayerUtils/RespawnPatch")
local TablePatch   = require("Features/Clover/PlayerUtils/TablePatch")

local UNSUPPORTED = "This doesn't work on your executor."
local WANTED = { "dash" }

local function isDashClass(t)
    return type(rawget(t, "StartGroundDash")) == "function" and type(rawget(t, "StartAirDash")) == "function"
end

-- the same test the game's own air dash pick makes, minus owning the air dash skill
local function inAir(self)
    local humanoid = self.Humanoid
    if humanoid == nil or humanoid:GetState() ~= Enum.HumanoidStateType.Freefall then return false end
    local state = self.State
    return not (state ~= nil and state:IsSwimming())
end

