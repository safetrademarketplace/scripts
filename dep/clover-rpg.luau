    local Options = env.Options
    local Window  = env.Window

    local CFG          = hooks.CFG
    local Live         = hooks.Live
    local saveConfig   = hooks.saveConfig
    local applyCurrent = hooks.applyCurrent

    local hexToColor3 = Presets.hexToColor3
    local color3ToHex = Presets.color3ToHex

    local function propsFromBuilder()
        if not Options or not Toggles then return nil end
        local t      = Options.CursorType and Options.CursorType.Value or "crosshair"
        local color3 = (Options.PrimaryColor and Options.PrimaryColor.Value) or Color3.new(1, 1, 1)
        local out3   = (Options.OutlineColor and Options.OutlineColor.Value) or Color3.new(0, 0, 0)
        local outEn  = Toggles.OutlineEnabled and (Toggles.OutlineEnabled.Value == true) or false
        local outT   = (Options.OutlineThick and Options.OutlineThick.Value) or 1

        if t == "crosshair" then
            return {
                type             = "crosshair",
                color            = color3,
                thickness        = (Options.CH_Thickness and Options.CH_Thickness.Value) or 2,
                length           = (Options.CH_Length and Options.CH_Length.Value) or 18,
                gap              = (Options.CH_Gap and Options.CH_Gap.Value) or 8,
                lineCount        = (Options.CH_LineCount and Options.CH_LineCount.Value) or 4,
                centerDot        = Toggles.CH_CenterDot and (Toggles.CH_CenterDot.Value == true) or false,
                dotSize          = (Options.CH_DotSize and Options.CH_DotSize.Value) or 2,
                outline          = outEn,
                outlineThickness = outT,
                outlineColor     = out3
            }
        else
            return {
                type             = "dot",
                color            = color3,
                size             = (Options.DOT_Size and Options.DOT_Size.Value) or 10,
                outline          = outEn,
                outlineThickness = outT,
                outlineColor     = out3
            }
        end
    end

    local function buildPresetPropsForSave()
        local P = propsFromBuilder()
        if not P then return nil end
        if P.type == "crosshair" then
            return {
                type = "crosshair",
                props = {
                    color            = color3ToHex(P.color),
                    thickness        = P.thickness,
                    length           = P.length,
                    gap              = P.gap,
                    lineCount        = P.lineCount,
                    centerDot        = P.centerDot,
                    dotSize          = P.dotSize,
                    outline          = P.outline,
                    outlineColor     = color3ToHex(P.outlineColor),
                    outlineThickness = P.outlineThickness
                }
            }
        else
            return {
                type = "dot",
                props = {
                    color            = color3ToHex(P.color),
                    size             = P.size,
                    outline          = P.outline,
                    outlineColor     = color3ToHex(P.outlineColor),
                    outlineThickness = P.outlineThickness
                }
            }
        end
    end

    local CustomCursorGroup = Place.groupbox(env, "Cursor Builder", "mouse-pointer", { fallback = "Fun", side = "Right" })
    if not CustomCursorGroup then return { propsFromBuilder = propsFromBuilder } end

    CustomCursorGroup:AddToggle("CursorEnabled", {
        Text    = "Enable Custom Cursor",
        Default = CFG.enabled,
        Callback = function(on)
            CFG.enabled = on == true
            saveConfig(CFG)
            applyCurrent()
            Library:Notify(on and "Custom cursor enabled." or "Custom cursor disabled.", 2)
        end
    })

    CustomCursorGroup:AddToggle("LiveBuild", {
        Text    = "Live Build",
        Tooltip = "Apply changes instantly as you modify the builder options.",
        Default = false,
        Callback = function(v)
            Live.enabled = v == true
            applyCurrent()
        end
    })

    local initialNames = Presets.buildNames(CFG.entries)
    local dd = CustomCursorGroup:AddDropdown("CursorSelect", {
        Text    = "Select Preset",
        Values  = initialNames,
        Default = (table.find(initialNames, CFG.selected) and CFG.selected) or initialNames[1],
        Callback = function(name)
            if name and Presets.getEntry(CFG.entries, name) then
                CFG.selected = name
                saveConfig(CFG)
                if not Live.enabled then
                    applyCurrent()
                end
            end
        end
    })

    if not table.find(initialNames, CFG.selected) and initialNames[1] then
        CFG.selected = initialNames[1]
        saveConfig(CFG)
        dd:SetValue(CFG.selected)
    end

    CustomCursorGroup:AddDivider()

    CustomCursorGroup:AddSlider("XNudge", {
        Text     = "X Nudge (px)",
        Default  = CFG.settings.xNudge or 0,
        Min      = -40,
        Max      = 40,
        Rounding = 0,
        Callback = function(v)
            CFG.settings.xNudge = v
            saveConfig(CFG)
        end
    })
    CustomCursorGroup:AddSlider("YNudge", {
        Text     = "Y Nudge (px)",
        Default  = CFG.settings.yNudge or 0,
        Min      = -40,
        Max      = 40,
        Rounding = 0,
        Callback = function(v)
            CFG.settings.yNudge = v
            saveConfig(CFG)
        end
    })

    CustomCursorGroup:AddDivider()

    local function liveApply() if Live.enabled then applyCurrent() end end

    CustomCursorGroup:AddDropdown("CursorType", {
        Text    = "Type",
        Values  = { "crosshair", "dot" },
        Default = "crosshair"
    })

    CustomCursorGroup:AddLabel("Primary Color"):AddColorPicker("PrimaryColor", {
        Default  = hexToColor3("#FFFFFF"),
        Callback = liveApply
    })

    CustomCursorGroup:AddToggle("OutlineEnabled", {
        Text     = "Outline",
        Default  = true,
        Callback = liveApply
    })
    local OutlineBox = CustomCursorGroup:AddDependencyBox()
    OutlineBox:AddLabel("Outline Color"):AddColorPicker("OutlineColor", {
        Default  = hexToColor3("#000000"),
        Callback = liveApply
    })
    OutlineBox:AddSlider("OutlineThick", {
        Text     = "Outline Thickness",
        Default  = 1,
        Min      = 0,
        Max      = 6,
        Rounding = 0,
        Callback = liveApply
    })
    OutlineBox:SetupDependencies({
        { Toggles.OutlineEnabled, true },
    })

    CustomCursorGroup:AddSlider("CH_LineCount", {
        Text     = "Number of Lines",
        Tooltip  = "Can be a little buggy, to fix any issues in alignment just update the gap.",
        Default  = 4,
        Min      = 2,
        Max      = 24,
        Rounding = 0,
        Callback = liveApply
    })
    CustomCursorGroup:AddSlider("CH_Thickness", {
        Text     = "Line Thickness",
        Default  = 2,
        Min      = 1,
        Max      = 12,
        Rounding = 0,
        Callback = liveApply
    })
    CustomCursorGroup:AddSlider("CH_Length", {
        Text     = "Line Length",
        Default  = 18,
        Min      = 2,
        Max      = 128,
        Rounding = 0,
        Callback = liveApply
    })
    CustomCursorGroup:AddSlider("CH_Gap", {
        Text     = "Gap",
        Default  = 8,
        Min      = 0,
        Max      = 96,
        Rounding = 0,
        Callback = liveApply
    })
    CustomCursorGroup:AddToggle("CH_CenterDot", {
        Text     = "Center Dot",
        Default  = false,
        Callback = liveApply
    })
    local CenterDotBox = CustomCursorGroup:AddDependencyBox()
    CenterDotBox:AddSlider("CH_DotSize", {
        Text     = "Center Dot Size",
        Default  = 2,
        Min      = 1,
        Max      = 24,
        Rounding = 0,
        Callback = liveApply
    })
    CenterDotBox:SetupDependencies({
        { Toggles.CH_CenterDot, true },
    })

    CustomCursorGroup:AddSlider("DOT_Size", {
        Text     = "Dot Size",
        Default  = 10,
        Min      = 1,
        Max      = 128,
        Rounding = 0,
        Callback = liveApply
    })

    CustomCursorGroup:AddDivider()
    CustomCursorGroup:AddInput("PresetName", {
        Text        = "Preset Name",
        Placeholder = "My Crosshair",
        Finished    = false
    })

    CustomCursorGroup:AddButton({
        Text = "Save / Update Preset",
        Func = function()
            local nm = tostring(Options.PresetName.Value or ""):gsub("^%s+", ""):gsub("%s+$", "")
            if nm == "" then
                Library:Notify("Enter a preset name.", 2)
                return
            end
            local built = buildPresetPropsForSave()
            if not built then return end

            local idx = Presets.getEntryIndex(CFG.entries, nm)
            local entry = {
                name   = nm,
                locked = false,
                type   = built.type,
                props  = built.props
            }
            if idx then
                CFG.entries[idx] = entry
            else
                table.insert(CFG.entries, entry)
            end
            CFG.selected = nm
            saveConfig(CFG)
            local names = Presets.buildNames(CFG.entries)
            dd:SetValues(names)
            dd:SetValue(nm)
            if not Live.enabled then applyCurrent() end
            Library:Notify(idx and "Preset updated." or "Preset saved.", 2)
        end
    })

    CustomCursorGroup:AddButton({
        Text = "Remove Selected",
        Func = function()
            local sel = dd.Value
            local idx, e = Presets.getEntryIndex(CFG.entries, sel or "")
            if not e then
                return Library:Notify("Select a preset first.", 2)
            end
            if e.locked then
                return Library:Notify("That preset is locked.", 2)
            end
            table.remove(CFG.entries, idx)
            local names = Presets.buildNames(CFG.entries)
            if #names == 0 then
                -- restore defaults inline so the dropdown never goes empty
                local fresh = table.clone(Presets.DEFAULTS)
                for k, v in pairs(fresh) do CFG[k] = v end
                names = Presets.buildNames(CFG.entries)
            end
            CFG.selected = names[1]
            saveConfig(CFG)
            dd:SetValues(names)
            dd:SetValue(CFG.selected)
            if not Live.enabled then applyCurrent() end
            Library:Notify("Preset removed.", 2)
        end
    })

    local function doRestoreDefaults()
        local fresh = table.clone(Presets.DEFAULTS)
        for k, v in pairs(fresh) do CFG[k] = v end
        saveConfig(CFG)
        local names = Presets.buildNames(CFG.entries)
        dd:SetValues(names)
        dd:SetValue(CFG.selected)
        if not Live.enabled then applyCurrent() end
        Library:Notify("Defaults restored.", 2)
    end

    CustomCursorGroup:AddButton({
        Text = "Restore Defaults",
        Func = function()
            if Window and Window.AddDialog then
                Window:AddDialog("CursorRestoreDefaultsDialog", {
                    Title = "Restore Default Cursors?",
                    Description = "This will erase any presets you have made and bring back the built-in ones.",
                    AutoDismiss = true,
                    OutsideClickDismiss = true,
                    FooterButtons = {
                        Cancel = {
                            Title = "Keep My Presets",
                            Variant = "Ghost",
                            Order = 1,
                            Callback = function() end,
                        },
                        Confirm = {
                            Title = "Restore Defaults",
                            Variant = "Destructive",
                            Order = 2,
                            Callback = doRestoreDefaults,
                        },
                    },
                })
            else
                doRestoreDefaults()
            end
        end
    })

    return {
        propsFromBuilder = propsFromBuilder,
        dropdown         = dd,
    }
end

end)
