        if not okClaim then return false, claimable, why end
        if not claimable then return false, Errors.NONE end
        if inFlight then return false, Errors.BUSY end
        inFlight = true
        local ok, a, b, c, d = pcall(invoke, nil, "ClaimTotal")
        inFlight = false
        if not ok then
            base.warn("claimTotal threw: %s", tostring(a))
            return false, Errors.FAILED
        end
        return a, b, c, d
    end

    return self
end

return M

end)
__bundle_register("Api/Professions/Nodes", function(require, _LOADED, __bundle_register, __bundle_modules)
-- nodes: the profession node registry (ReplicatedStorage.ProfessionNodes, never streamed) joined to its streamed world models, plus owned tool power read from the game's own registries; a streamed model is only ever cached once found

local Services   = require("Services")
local References = require("References")
local VMath      = require("Utility/Helpers/VMath")

-- TrackerClient.lua:192-231: a model belongs to a record when the names match and it sits this close to the record's Position
local MODEL_RADIUS_SQ = 6 * 6

local KINDS = {
    Ore     = { folder = "Ores",  prompt = "MinePrompt",    registry = "PickaxeRegistry" },
    Harvest = { folder = "Crops", prompt = "HarvestPrompt", registry = "SickleRegistry" },
}

local M = {}

M.KINDS = KINDS

local function child(parent, name)
    if parent == nil then return nil end
    return parent:FindFirstChild(name)
end

-- TrackerClient.lua:171-173
local function modelPart(model)
    return model.PrimaryPart or model:FindFirstChild("Handle") or model:FindFirstChildWhichIsA("BasePart")
end

local function byDistance(a, b)
    return a.distance < b.distance
end

function M.new(env)
    local self = {}

    -- static attributes per record, read once; Available and RespawnAt are read fresh on every call
    local statics = setmetatable({}, { __mode = "k" })
    local matched = setmetatable({}, { __mode = "kv" })
    local registries = {}
    local missingInteract = false

    local function recordsFolder()
        return child(Services.ReplicatedStorage, "ProfessionNodes")
    end

    local function harvestable()
        return child(child(Services.Workspace, "Map"), "Harvestable")
    end

    -- TrackerClient.lua:110-121: a Configuration with a known Kind, keyed by Item or else its own name
    local function static(record)
        local cached = statics[record]
        if cached then return cached end
        if not record:IsA("Configuration") then return nil end
        local kind = record:GetAttribute("Kind")
        if KINDS[kind] == nil then return nil end
        local position = record:GetAttribute("Position")
        if typeof(position) ~= "Vector3" then return nil end
        local item = record:GetAttribute("Item")
        if type(item) ~= "string" or item == "" then item = record.Name end
        local power = record:GetAttribute("Power")
        if type(power) ~= "number" then power = 0 end
        local drop = record:GetAttribute("Drop")
        if type(drop) ~= "string" or drop == "" then drop = nil end
        cached = { kind = kind, item = item, drop = drop, position = position, power = power }
        statics[record] = cached
        return cached
    end

    local function describe(record, info, now, distance)
        -- TrackerClient.lua:1086: only an explicit false is depleted
        local available = record:GetAttribute("Available") ~= false
        local respawnIn = 0
        if not available then
            local at = record:GetAttribute("RespawnAt")
            if type(at) == "number" and type(now) == "number" and at > now then respawnIn = at - now end
        end
        return {
            record    = record,
            kind      = info.kind,
            item      = info.item,
            drop      = info.drop,
            position  = info.position,
            available = available,
            respawnIn = respawnIn,
            power     = info.power,
            distance  = distance,
        }
    end

    -- filter is already validated; the static tests run first so a depleted-state read is only paid for a candidate
    function self.list(filter, now)
        local folder = recordsFolder()
        if folder == nil then return {} end
        local out, best = {}, nil
        local nearestOnly = filter.origin ~= nil and filter.limit == 1
        local maxSq = filter.maxDistance and filter.maxDistance * filter.maxDistance
        for _, record in ipairs(folder:GetChildren()) do
            local info = static(record)
            if info ~= nil
                and (filter.kind == nil or info.kind == filter.kind)
                and (filter.items == nil or filter.items[info.item] == true)
                and (filter.maxPower == nil or info.power <= filter.maxPower) then
                local distSq
                if filter.origin then distSq = VMath.distanceSqr3(info.position, filter.origin) end
                if (maxSq == nil or distSq <= maxSq) and (not nearestOnly or best == nil or distSq < best.distSq) then
                    local wanted = true
                    if filter.available ~= nil then
                        wanted = (record:GetAttribute("Available") ~= false) == filter.available
                    end
                    if wanted then
                        local node = describe(record, info, now, distSq and math.sqrt(distSq))
                        if nearestOnly then
                            best = { node = node, distSq = distSq }
                        else
                            out[#out + 1] = node
                        end
                    end
                end
            end
        end
        if nearestOnly then
            if best then out[1] = best.node end
            return out
        end
        if filter.origin then table.sort(out, byDistance) end
        if filter.limit and #out > filter.limit then
            for i = #out, filter.limit + 1, -1 do out[i] = nil end
        end
        return out
    end

    function self.itemNames(kind)
        local folder = recordsFolder()
        if folder == nil then return {} end
        local seen, out = {}, {}
        for _, record in ipairs(folder:GetChildren()) do
            local info = static(record)
            if info ~= nil and (kind == nil or info.kind == kind) and not seen[info.item] then
                seen[info.item] = true
                out[#out + 1] = info.item
            end
        end
        table.sort(out)
        return out
    end

    function self.info(record)
        if typeof(record) ~= "Instance" then return nil end
        return static(record)
    end

    -- a hit is re-checked for a parent before reuse, a miss is never remembered: the model streams in and out
    function self.model(record, info)
        local cached = matched[record]
        if cached ~= nil and cached.Parent ~= nil then return cached end
        matched[record] = nil
        local folder = child(harvestable(), KINDS[info.kind].folder)
        if folder == nil then return nil end
        for _, candidate in ipairs(folder:GetChildren()) do
            if candidate.Name == info.item and candidate:IsA("Model") then
                local part = modelPart(candidate)
                if part ~= nil and VMath.distanceSqr3(part.Position, info.position) <= MODEL_RADIUS_SQ then
                    matched[record] = candidate
                    return candidate
                end
            end
        end
        return nil
    end

    -- the prompt, or nil and Interact's reason (a switched-off prompt reads as interact/disabled)
    function self.prompt(model, info)
        local interact = env.api("Interact")
        if interact == nil or type(interact.findPrompt) ~= "function" then
            if not missingInteract then
                missingInteract = true
                env.base.warn("the Interact api is missing, so node prompts cannot be found")
            end
            return nil
        end
        local ok, prompt = interact.findPrompt(model, KINDS[info.kind].prompt)
        if ok then return prompt end
        return nil, prompt
    end

    -- HarvestController.PickaxeRegistry / SickleRegistry: pure data tool-name -> power, kept once loaded
    local function registry(kind)
        local cached = registries[kind]
        if cached then return cached end
        local module = child(child(harvestable(), "HarvestController"), KINDS[kind].registry)
        if module == nil then return nil end
        local ok, data = pcall(require, module)
        if not ok or type(data) ~= "table" then
            env.base.warn("%s did not load: %s", KINDS[kind].registry, tostring(data))
            return nil
        end
        local copy = {}
        for name, power in pairs(data) do
            if type(name) == "string" and type(power) == "number" then copy[name] = power end
        end
        registries[kind] = copy
        return copy
    end

    -- info, then the model and its prompt as far as they have streamed in, then Interact's reason for a missing prompt
    function self.resolve(node)
        if type(node) ~= "table" then return nil end
        local info = self.info(node.record)
        if info == nil then return nil end
        local model = self.model(node.record, info)
        if model == nil then return info end
        local prompt, why = self.prompt(model, info)
        return info, model, prompt, why
    end

    -- best power owned across Inventory, Backpack and the character, plus the best one held in hand
    function self.toolPower(kind, character)
        local powers = registry(kind)
        if powers == nil then return nil end
        local best, bestName, held = 0, nil, 0
        local function scan(container, inHand)
            if container == nil then return end
            for _, item in ipairs(container:GetChildren()) do
                local power = powers[item.Name]
                if power ~= nil then
                    if power > best then best, bestName = power, item.Name end
                    if inHand and power > held then held = power end
                end
            end
        end
        local player = References.player
        scan(child(player, "Inventory"), false)
        scan(child(player, "Backpack"), false)
        scan(character, true)
        return best, bestName, held
    end

    return self
end

return M

end)
__bundle_register("Api/Professions/Gather", function(require, _LOADED, __bundle_register, __bundle_modules)
-- gather: drives one node from prompt to close; it never moves the character, fires the node's prompt through Interact (which refuses out of range) and lets the solver answer the session that opens

local References = require("References")
local Jobs       = require("Utility/Jobs")
local Errors     = require("Api/Professions/Errors")

-- the server opens the minigame straight off the trigger, so nothing inside this means it refused
local OPEN_TIMEOUT = 3
local DEFAULT_TIMEOUT = 30
-- the stock bump replicates around the close, so a finished gather gives it this long to land
local STOCK_SETTLE = 1
local STOCK_POLL = 0.1

local MINIGAMES = { Ore = "Mining", Harvest = "Harvesting" }

local M = {}

local function validTimeout(value)
    return type(value) == "number" and value == value and value > 0 and value < math.huge
end

-- parks the calling thread until settle runs or the deadline passes; a settle after that resumes nothing
local function park(timeout, register)
    local caller = coroutine.running()
    local outcome, parked = nil, false
    local function settle(value)
        if outcome ~= nil then return end
        outcome = value
        if parked and coroutine.status(caller) == "suspended" then task.defer(caller) end
    end
    if register then register(settle) end
    if outcome == nil then
        local timer = Jobs.delay(timeout, function() settle(false) end, { name = "Professions wait" })
        parked = true
        while outcome == nil do coroutine.yield() end
        parked = false
        if timer then timer:Cancel() end
    end
    return outcome
end

-- InventoryListener.lua:32-60: a material stack is an Inventory child carrying a Stock attribute
local function stock()
    local out = {}
    local inventory = References.player:FindFirstChild("Inventory")
    if inventory == nil then return out end
    for _, item in ipairs(inventory:GetChildren()) do
        local count = item:GetAttribute("Stock")
        if type(count) == "number" then out[item.Name] = (out[item.Name] or 0) + count end
    end
    return out
end

local function difference(before, after)
    local out, changed = {}, false
    for name, count in pairs(after) do
        local delta = count - (before[name] or 0)
        if delta ~= 0 then
            out[name] = delta
            changed = true
        end
    end
    for name, count in pairs(before) do
        if after[name] == nil then
            out[name] = -count
            changed = true
        end
    end
    return out, changed
end

function M.new(env, solver, nodes)
    local self = {}
    local running = false

    local function interactCode(interact, code)
        local codes = interact.Errors
        if code == nil or type(codes) ~= "table" then return Errors.FAILED end
        if code == codes.NOT_IN_RANGE then return Errors.NOT_IN_RANGE end
        if code == codes.BLOCKED or code == codes.BUSY then return Errors.BUSY end
        if code == codes.NO_PROMPT then return Errors.NOT_STREAMED end
        if code == codes.DISABLED then return Errors.NONE end
        return Errors.FAILED
    end

    local function drive(interact, prompt, minigame, timeout, watcher)
        local before = stock()
        solver.arm(minigame)
        local fired, code, detail = interact.prompt(prompt)
        if not fired then
            solver.disarm(minigame)
            return false, interactCode(interact, code), code, detail
        end
        if env.closed() then return false, Errors.NOT_READY end
        local started = os.clock()
        park(OPEN_TIMEOUT, function(settle)
            watcher.notify = settle
            if watcher.session ~= nil then settle(true) end
        end)
        if env.closed() then return false, Errors.NOT_READY end
        if watcher.session == nil then
            solver.disarm(minigame)
            return false, Errors.TIMEOUT, "open"
        end
        local left = timeout - (os.clock() - started)
        if watcher.closed == nil and left > 0 then
            park(left, function(settle)
                watcher.notify = settle
                if watcher.closed ~= nil then settle(true) end
            end)
        end
        if env.closed() then return false, Errors.NOT_READY end
        if watcher.closed == nil then
            solver.cancelSession(watcher.session)
            return false, Errors.TIMEOUT, "close"
        end
        local view = watcher.closed
        local delta, changed = difference(before, stock())
        local waited = 0
        while not changed and view.outcome == "Done" and waited < STOCK_SETTLE and not env.closed() do
            park(STOCK_POLL)
            waited = waited + STOCK_POLL
            delta, changed = difference(before, stock())
        end
        return true, {
            outcome    = view.outcome,
            kind       = minigame,
            mode       = view.mode,
            rounds     = view.rounds,
            answered   = view.answered,
            results    = view.results,
            stockDelta = delta,
        }
    end

    function self.gather(node, opts)
        if opts ~= nil and type(opts) ~= "table" then return false, Errors.BAD_ARGS end
        local timeout = DEFAULT_TIMEOUT
        if opts ~= nil and opts.timeout ~= nil then
            if not validTimeout(opts.timeout) then return false, Errors.BAD_ARGS end
            timeout = opts.timeout
        end
        local info, model, prompt, why = nodes.resolve(node)
        if info == nil then return false, Errors.BAD_ARGS end
        if not coroutine.isyieldable() then return false, Errors.FAILED, "the calling thread cannot yield" end
        local minigame = MINIGAMES[info.kind]
        if running or solver.isOpen(minigame) then return false, Errors.BUSY end
        if model == nil then return false, Errors.NOT_STREAMED end
        local interact = env.api("Interact")
        if interact == nil or type(interact.prompt) ~= "function" then return false, Errors.FAILED, "no interact api" end
        if prompt == nil then
            if why ~= nil and type(interact.Errors) == "table" and why == interact.Errors.DISABLED then
                return false, Errors.NONE, why
            end
            return false, Errors.NOT_STREAMED, why
        end
        local release, holdWhy = solver.hold(minigame)
        if release == nil then return false, Errors.FAILED, holdWhy end
        running = true
        local watcher = solver.watch(minigame)
        local ok, a, b, c, d = pcall(drive, interact, prompt, minigame, timeout, watcher)
        solver.unwatch(watcher)
        running = false
        solver.releaseAfter(minigame, release)
        if not ok then
            env.base.warn("gather threw: %s", tostring(a))
            return false, Errors.FAILED
        end
        return a, b, c, d
    end

    return self
end

return M

end)
