            if radius <= opts.reach then radii[#radii + 1] = radius end
        end
        score = function(spot) return distance(spot, from) end
    else
        local toward = opts.toward or goal
        radii = Tuning.legRings
        score = function(spot) return flatDistance(spot, toward) end
    end
    append(list, sortedRing(probe, goal, radii, goal.Y, not final, score))
    return list
end

-- standing spots square to either side of a segment, nearest first
local function sidesteps(probe, a, b)
    local dx, dz = b.X - a.X, b.Z - a.Z
    local length = math.sqrt(dx * dx + dz * dz)
    if length < 1e-3 then return {} end
    local px, pz = -dz / length, dx / length
    local mx, my, mz = (a.X + b.X) / 2, (a.Y + b.Y) / 2, (a.Z + b.Z) / 2
    local out = {}
    for _, offset in ipairs(Tuning.sidesteps) do
        for _, side in ipairs({ offset, -offset }) do
            local spot = probe.spot(mx + px * side, mz + pz * side, my, false)
            if spot then out[#out + 1] = spot end
        end
    end
    return out
end

-- standing spots a few studs round a start the pathfinder will not take, nearest first, probed from just above the feet
function M.freeSpots(probe, here)
    return sortedRing(probe, here, Tuning.stepOutRings, here.Y - probe.height, false, function(spot)
        return distance(spot, here)
    end)
end

-- standing spots round an indoor start with open sky over them, nearest first: the way out a far trip takes before its air legs
function M.skySpots(probe, here)
    local spots = sortedRing(probe, here, Tuning.skyRings, here.Y - probe.height, false, function(spot)
        return distance(spot, here)
    end)
    local out = {}
    for _, spot in ipairs(spots) do
        if not probe.roofed(spot) then
            out[#out + 1] = spot
            if #out >= Tuning.skyWanted then break end
        end
    end
    return out
end

local function pathFrom(probe, from, to, budget)
    if budget.left <= 0 then return nil end
    budget.left = budget.left - 1
    local waypoints = compute(feet(probe, from), feet(probe, to))
    if not waypoints then return nil end
    return (chain(probe, from, closeOut(standingPoints(probe, waypoints, true), to)))
end

local function pathTo(probe, start, spot, budget)
    if budget.left <= 0 then return nil end
    budget.left = budget.left - 1
    local waypoints = compute(feet(probe, start), feet(probe, spot))
    if not waypoints then return nil end
    local route, blockedFrom, blockedTo = chain(probe, start, closeOut(standingPoints(probe, waypoints, true), spot))
    if route then return route end

    -- a step aside from the segment nothing could lift over, reached straight when it can be, then a path on from there
    for _, via in ipairs(sidesteps(probe, blockedFrom, blockedTo)) do
        if budget.left <= 0 then break end
        local first = chain(probe, start, { via })
        if not first then first = pathFrom(probe, start, via, budget) end
        if first then
            local second = pathFrom(probe, via, spot, budget)
            if second then return append(first, second) end
        end
    end
    return nil
end

-- open terrain the navmesh does not cover: short straight hops, each dropped onto CanCollide floor probed from just above the last one
local function groundTo(probe, start, spot)
    local dx, dz = spot.X - start.X, spot.Z - start.Z
    local steps = math.max(1, math.ceil(math.sqrt(dx * dx + dz * dz) / Tuning.groundStep))
    local floorY = start.Y - probe.height
    local points = {}
    for i = 1, steps do
        local t = i / steps
        local x, z = start.X + dx * t, start.Z + dz * t
        local y
        if i == steps then
            y = spot.Y - probe.height
        else
            y = probe.floor(x, z, floorY + Tuning.climbProbe, Tuning.climbProbe + Tuning.dropProbe)
        end
        if not y then return nil end
        points[i] = Vector3.new(x, y + probe.height, z)
        floorY = y
    end
    return (chain(probe, start, points))
end

-- a goal under a roof (a den, a cave): the standing points on the pathfinder's own route there that last have open sky over them, the way in first and a few before it, since the way in itself can sit under an overhang no flight reaches; nil when the goal is open to the sky or there is no route at all
function M.mouth(probe, from, goal)
    if not probe.roofed(goal) then return nil end
    local waypoints = compute(feet(probe, from), feet(probe, goal))
    if not waypoints then return nil end
    local points = standingPoints(probe, waypoints, true)
    local out = {}
    for i = #points, 1, -1 do
        if not probe.roofed(points[i]) then
            out[#out + 1] = points[i]
            if #out >= Tuning.mouthSpots then break end
        elseif #out > 0 then
            break
        end
    end
    if #out == 0 then return nil end
    return out
end

-- one leg from where the character is: {points, goal, via} or nil once pathfinding and the ground walk have both failed every candidate
function M.plan(probe, from, goal, opts)
    opts = opts or {}
    local start = from
    local prefix = {}

    -- hanging in the air (a lift, a ledge, a server rewind) is brought down to the floor before anything else
    local floorY = probe.floorUnder(from, Tuning.landProbe)
    if floorY then
        local grounded = Vector3.new(from.X, floorY + probe.height, from.Z)
        if from.Y - grounded.Y > Tuning.airGap and probe.sweep(from, grounded, true) then
            prefix[1] = grounded
            start = grounded
        end
    end

    local candidates = M.candidates(probe, start, goal, opts)
    local tries = math.min(#candidates, Tuning.ringTries + 1)
    local budget = { left = opts.computes or Tuning.maxComputes }

    for i = 1, tries do
        if budget.left <= 0 then break end
        local route = pathTo(probe, start, candidates[i], budget)
        if route then
            return { points = append(prefix, route), goal = candidates[i], via = "path" }
        end
    end
    for i = 1, tries do
        local route = groundTo(probe, start, candidates[i])
        if route then
            return { points = append(prefix, route), goal = candidates[i], via = "ground" }
        end
    end
    return nil
end

return M

end)
