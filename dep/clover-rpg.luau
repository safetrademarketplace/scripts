            if not getModel(candidate) then return "target gone" end
            if not getCFrame(candidate) then return "target has no position" end
        end

        if requireAlive then
            local hum = getHumanoid(candidate)
            if hum then
                local dead = false
                pcall(function() dead = hum:GetState() == Enum.HumanoidStateType.Dead end)
                if dead then return "target died" end
                if (tonumber(hum.MaxHealth) or 0) > 0 and (tonumber(hum.Health) or 0) <= 0 then
