        end
    end
    table.sort(out, function(a, b) return a.score < b.score end)
    return out
end

-- whether the root stands in a door's pad or against its frame; the pad's look vector is its local -Z, so Size.Z runs along it
function M.inside(door, here)
    local ox, oz = flatOutward(door.outward)
    local p = door.position
    local dx, dz = here.X - p.X, here.Z - p.Z
    local along = math.abs(dx * ox + dz * oz)
    local across = math.abs(dz * ox - dx * oz)
    local depth, width, height = Tuning.padDepth, Tuning.padWidth, Tuning.padHeight
    local ok, size = pcall(function() return door.touch.Size end)
    if ok and finiteVector(size) then depth, width, height = size.Z / 2, size.X / 2, size.Y / 2 end
    return along <= depth + Tuning.padSlack and across <= width + Tuning.frameSlack
        and math.abs(here.Y - p.Y) <= height + Tuning.padSlack + Tuning.padHeight
end

function M.at(ctx, here, tried)
    for _, door in ipairs(query(ctx, here, Tuning.doorwaySearch)) do
        if not tried[door.key] and M.inside(door, here) then return door end
    end
    return nil
end

-- standing spots in the pad and a stand-off either side of it, the near one on our side; a side the body does not fit is nil
function M.sides(probe, door, here)
    local ox, oz = flatOutward(door.outward)
    local p = door.position
    -- probed down from the pad's own center: the pad and the panel never stop a CanCollide ray
    local floorY = probe.floor(p.X, p.Z, p.Y, Tuning.landProbe)
    if not floorY then return nil end
    local side = 1
    if (here.X - p.X) * ox + (here.Z - p.Z) * oz < 0 then side = -1 end
    local reach = Tuning.doorStandoff
    return {
        pad  = Vector3.new(p.X, floorY + probe.height, p.Z),
        near = probe.spot(p.X + ox * side * reach, p.Z + oz * side * reach, floorY),
        far  = probe.spot(p.X - ox * side * reach, p.Z - oz * side * reach, floorY),
    }
end

-- CloverClient.lua:1262: Client.Door carries (door model, { Opened, Direction }, hinge speed?, silent?, sound?); a door of the same name opening elsewhere is not this one
function M.listen(ctx, door, onOpen)
    local net = ctx.Api and ctx.Api.CloverNet
    local on = type(net) == "table" and net.on or nil
    if type(on) ~= "function" then return nil end
    local ok, okOn, handle = pcall(on, "Client/Door", function(model, data)
        if type(data) ~= "table" or data.Opened ~= true or M.name(model) ~= door.name then return end
        local okAt, at = pcall(function() return model:GetPivot().Position end)
        if okAt and finiteVector(at) and flatDistance(at, door.position) > Tuning.doorEventNear then return end
        onOpen()
    end)
    if ok and okOn and type(handle) == "table" then return handle end
    return nil
end

function M.pose(panel)
    if typeof(panel) ~= "Instance" then return nil end
    local ok, frame = pcall(function() return panel.CFrame end)
    if not ok or typeof(frame) ~= "CFrame" then return nil end
    local okRead, position, look = pcall(function() return frame.Position, frame.LookVector end)
    if not okRead then return nil end
    return { position = position, look = look }
end

-- the hinge swings the panel a quarter turn, so a small move or turn is already an opening
function M.swung(panel, before)
    if not before then return false end
    local now = M.pose(panel)
    if not now then return false end
    local p, q = now.position, before.position
    local dx, dy, dz = p.X - q.X, p.Y - q.Y, p.Z - q.Z
    if math.sqrt(dx * dx + dy * dy + dz * dz) > Tuning.doorSwing then return true end
    local a, b = now.look, before.look
    return a.X * b.X + a.Y * b.Y + a.Z * b.Z < Tuning.doorTurn
end

return M

end)
