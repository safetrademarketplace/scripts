local Log         = require("Utility/Log")
local UiHost      = require("UI/UiHost")

local TweenService = Services.TweenService
local Lighting     = Services.Lighting
local Game         = Services.Game

local SupportLink = "https://discord.gg/cerberus"

local Theme = {
    Panel   = Color3.fromRGB(20, 20, 24),
    Error   = Color3.fromRGB(255, 80, 80),
}

local function trim(s, maxLen)
    s = tostring(s or "")
    if #s <= maxLen then return s end
    return s:sub(1, maxLen - 3) .. "..."
end

local function splitLines(s)
    local lines = {}
    s = tostring(s or "")
    for line in (s .. "\n"):gmatch("([^\n]*)\n") do
        lines[#lines + 1] = line
    end
    return lines
end

local function normalizeWhitespace(s)
    return tostring(s or ""):gsub("^%s+", ""):gsub("%s+$", "")
end

local function extractModuleFromError(errText)
    return tostring(errText or ""):match("%[Module%s+([^%]]+)%]")
end

local function extractTopFrame(errText)
    for _, line in ipairs(splitLines(errText)) do
        local frame = line:match("^(script%s+[^:]+:%d+)")
        if frame then return frame end
    end
    return nil
end

local function buildCollapsedStack(errText)
    local out, seen = {}, {}
    for _, line in ipairs(splitLines(errText)) do
        local clean = normalizeWhitespace(line)
        if clean ~= "" and not seen[clean] then
            seen[clean] = true
            out[#out + 1] = clean
        end
    end
    return out
end

local function moduleTimeline(events)
    local out = {}
    for _, eventLine in ipairs(events or {}) do
        local ev = tostring(eventLine)
        if ev:find("[STEP] Begin Module ", 1, true) or ev:find("[STEP] Completed Module ", 1, true) then
            out[#out + 1] = ev
        end
    end
    return out
end

local function buildHints(label, errText, topFrame, moduleName)
    local hints = {}
    hints[#hints + 1] = "Keep and share the full report, including Recent Debug Events."

    if moduleName then
        hints[#hints + 1] = ("Failure appears inside '%s'. Check ctx fields and recent edits in that module."):format(moduleName)
    end
    if topFrame then
        hints[#hints + 1] = ("Top stack frame: %s"):format(topFrame)
    end
    if tostring(errText):find("attempt to call a nil value", 1, true) then
        hints[#hints + 1] = "Likely nil-call: verify renamed callbacks/functions and missing injections in module context."
    end
    if tostring(errText):find("attempt to index a nil value", 1, true) then
        hints[#hints + 1] = "Nil-index: a required field on ctx (or a sub-table) is missing at the point of use."
    end
    if tostring(label):find("Bootstrap", 1, true) then
        hints[#hints + 1] = "Bootstrap failed during module loading. Use Recent Module Timeline to find the failing boundary."
    end
    return hints
end

