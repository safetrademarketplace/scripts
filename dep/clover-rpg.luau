__bundle_register("Api/Quests", function(require, _LOADED, __bundle_register, __bundle_modules)
-- quests api: the quests you have (LocalPlayer.Quests, their tasks and how far along each is), the repeatable quests the game offers (ReplicatedStorage.Modules.ClientNPCS.Quests, giver, cooldown and where the giver stands), and taking one on or handing one in the way the dialogue actions do (DM.Actions.AcceptQuest / CompleteQuest); live 2026-10-24 neither needs the dialogue open, only the giver close by; shared as ctx.Api.Quests
local References = require("References")
local Services   = require("Services")
local Api        = require("Api")
local Errors     = require("Api/Quests/Errors")

local ACCEPT, COMPLETE, COOLDOWN = "NPC", "Client/UpdateQuestLog", "QuestCooldown"
local ANSWER_WAIT = 4
local POLL = 0.1
-- the verb a kill task's name starts with, stripped to leave the monster (Javier's "Defeat Nightcharmers", Skadi's "Hunt the Dire Wolf")
local KILL_VERBS = { "defeat", "hunt", "exterminate", "eliminate", "kill", "slay" }
local FILLERS = { "the", "wild", "some", "a", "an" }
local RACE_PREFIX = "compete in the "

local M = {}

local function lower(s)
    return string.lower(s or "")
end

local function squash(s)
    return (string.gsub(lower(s), "[^%w]", ""))
end

local function position(value)
    if typeof(value) == "CFrame" then return value.Position end
    if typeof(value) == "Vector3" and value.Magnitude > 1e-3 then return value end
    return nil
end

-- "Defeat Nightcharmers" -> "nightcharmer", "Hunt wild wolves" -> "wolf"; nil when the name isn't a kill
local function killTarget(name)
    local words = {}
    for word in string.gmatch(lower(name), "%a+") do words[#words + 1] = word end
    if #words < 2 then return nil end
    local isKill = false
    for _, verb in ipairs(KILL_VERBS) do
        if words[1] == verb then isKill = true end
    end
    if not isKill then return nil end
    local rest = {}
    for i = 2, #words do
        local filler = false
        for _, f in ipairs(FILLERS) do
            if words[i] == f and #rest == 0 then filler = true end
        end
        if not filler then rest[#rest + 1] = words[i] end
    end
    local stem = table.concat(rest)
    if string.sub(stem, -3) == "ves" then
        stem = string.sub(stem, 1, -4) .. "f"
    elseif string.sub(stem, -1) == "s" and string.sub(stem, -2) ~= "ss" then
        stem = string.sub(stem, 1, -2)
    end
    if stem == "" then return nil end
    return stem
end

-- a quest's cooldown as QuestCooldown answers it: nil when it can be taken, "OneTime" once done for good, else "09 Minute(s) " and the like
local function cooldownSeconds(answer)
    if answer == nil then return 0 end
    if answer == "OneTime" then return math.huge end
    if type(answer) ~= "string" then return nil end
    local total, found = 0, false
    for amount, unit in string.gmatch(answer, "(%d+)%s*(%a+)") do
        local n = tonumber(amount) or 0
        local u = lower(unit)
        found = true
        if string.find(u, "^h") then
            total = total + n * 3600
        elseif string.find(u, "^m") then
            total = total + n * 60
        else
            total = total + n
        end
    end
    if not found then return nil end
    return total
end

-- the monster names a kill task's target means: exact matches when there are any ("wolf" is never the Dire Wolf), else the names it starts ("mushknight" -> MushknightRed)
local function matchMobs(stem, names)
    local exact, prefix = {}, {}
    if type(stem) ~= "string" or stem == "" then return exact end
    for _, name in ipairs(names) do
        local flat = squash(name)
        if flat == stem then
            exact[#exact + 1] = name
        elseif string.sub(flat, 1, #stem) == stem then
            prefix[#prefix + 1] = name
        end
    end
    if #exact > 0 then return exact end
    return prefix
end

M.killTarget = killTarget
M.cooldownSeconds = cooldownSeconds
M.matchMobs = matchMobs

function M.new(ctx)
    local base = Api.define("Quests", ctx)
    local api = { Errors = Errors }
    local closed = false

    local function net()
        local found = ctx.Api and ctx.Api.CloverNet
        if type(found) == "table" then return found end
        return nil
    end

    local function settle(label, ok, ...)
        if ok then return ... end
        base.warn("%s threw: %s", label, tostring((...)))
        return false, Errors.NOT_READY
    end

    local function expose(name, fn)
        local label = "Quests." .. name
        api[name] = function(...)
            if closed then return false, Errors.NOT_READY end
            return settle(label, pcall(fn, ...))
        end
    end

    local function questsFolder()
        local player = References.player
        return player and player:FindFirstChild("Quests") or nil
    end

    local function templates()
        local modules = Services.ReplicatedStorage:FindFirstChild("Modules")
        local npcs = modules and modules:FindFirstChild("ClientNPCS")
        return npcs and npcs:FindFirstChild("Quests") or nil
    end

    local function stockOf(item)
        local player = References.player
        local inventory = player and player:FindFirstChild("Inventory")
        local entry = inventory and type(item) == "string" and item ~= "" and inventory:FindFirstChild(item) or nil
        if not entry then return 0 end
        local stock = entry:GetAttribute("Stock")
        if type(stock) == "number" then return stock end
        return 1
    end

    -- what a task asks for: collect (TaskType Collect, counted off the inventory, RSM.CheckQuestCompletion.lua:24-28), kill (named for a monster), race (a course), else other
    local function readTask(entry)
        local name = entry.Name
        local kind, target = "other", nil
        local object = entry:GetAttribute("Object")
        if entry:GetAttribute("TaskType") == "Collect" then
            kind, target = "collect", object ~= "" and object or nil
        elseif string.sub(lower(name), 1, #RACE_PREFIX) == RACE_PREFIX then
            kind, target = "race", string.sub(name, #RACE_PREFIX + 1)
        else
            local stem = killTarget(name)
            if stem then kind, target = "kill", stem end
        end
        local max = entry:GetAttribute("TaskMax")
        if type(max) ~= "number" then max = 1 end
        local progress = entry:GetAttribute("TaskProgress")
        if kind == "collect" and target then progress = stockOf(target) end
        if type(progress) ~= "number" then progress = 0 end
        return {
            name     = name,
            kind     = kind,
            target   = target,
            progress = math.min(progress, max),
            max      = max,
            done     = progress >= max,
            position = position(entry:GetAttribute("TrackPosition")),
            hidden   = entry:GetAttribute("Hidden") == true,
        }
    end

    local function tasksOf(folder)
        local out = {}
        local holder = folder:FindFirstChild("Tasks") or folder
        for _, entry in ipairs(holder:GetChildren()) do
            if entry.Name ~= "Tasks" then out[#out + 1] = readTask(entry) end
        end
        table.sort(out, function(a, b) return a.name < b.name end)
        return out
    end

    local function readQuest(folder)
        local tasks = tasksOf(folder)
        local ready = #tasks > 0
        for _, entry in ipairs(tasks) do
            if not entry.done then ready = false end
        end
        local completed = folder:GetAttribute("Completed") == true
        local cooldown = folder:GetAttribute("CooldownType")
        return {
            key        = folder.Name,
            title      = folder:GetAttribute("Quest") or folder.Name,
            completed  = completed,
            ready      = ready and not completed,
            repeatable = cooldown ~= nil and cooldown ~= "OneTime",
            giver      = folder:GetAttribute("ReturnNPC") or folder.Name,
            returnAt   = position(folder:GetAttribute("ReturnPosition")),
            tasks      = tasks,
        }
    end

    -- (true, list) of the quests you have taken; ready means every task is done and it only wants handing in
    expose("active", function()
        local folder = questsFolder()
        if not folder then return false, Errors.NOT_READY end
        local out = {}
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("Folder") and child:GetAttribute("Quest") ~= nil then out[#out + 1] = readQuest(child) end
        end
        table.sort(out, function(a, b) return a.key < b.key end)
        return true, out
    end)

    expose("quest", function(key)
        if type(key) ~= "string" or key == "" then return false, Errors.BAD_ARGS end
        local folder = questsFolder()
        if not folder then return false, Errors.NOT_READY end
        local child = folder:FindFirstChild(key)
        if not (child and child:GetAttribute("Quest") ~= nil) then return false, Errors.NO_QUEST end
        return true, readQuest(child)
    end)

    -- (true, list) of the quests that can be taken again and again: { giver, title, cooldown (seconds), position (where the giver stands), region, tasks }
    expose("repeatables", function()
        local root = templates()
        if not root then return false, Errors.NOT_READY end
        local out = {}
        for _, folder in ipairs(root:GetDescendants()) do
            if folder:IsA("Folder") and folder:GetAttribute("Quest") ~= nil then
                local cooldown = folder:GetAttribute("CooldownType")
                if cooldown ~= nil and cooldown ~= "OneTime" then
                    out[#out + 1] = {
                        giver    = folder.Name,
                        title    = folder:GetAttribute("Quest"),
                        cooldown = tonumber(cooldown),
                        position = position(folder:GetAttribute("ReturnPosition")),
                        region   = folder:GetAttribute("Legacy"),
                        tasks    = tasksOf(folder),
                    }
                end
            end
        end
        table.sort(out, function(a, b) return a.giver < b.giver end)
        return true, out
    end)

    -- (true, seconds left, raw answer): 0 when it can be taken now, math.huge once a one-time quest is done
    expose("cooldown", function(giver)
        if type(giver) ~= "string" or giver == "" then return false, Errors.BAD_ARGS end
        local remote = net()
        if not remote then return false, Errors.NOT_READY end
        local ok, answer = remote.callWith(COOLDOWN, { timeout = ANSWER_WAIT }, giver)
        if not ok then return false, Errors.NO_ANSWER, answer end
        local seconds = cooldownSeconds(answer)
        if seconds == nil then return false, Errors.FAILED, answer end
        return true, seconds, answer
    end)

    local function waitFor(predicate)
        local limit = os.clock() + ANSWER_WAIT
        while os.clock() < limit do
            if predicate() then return true end
            task.wait(POLL)
        end
        return predicate()
    end

    -- takes the giver's quest; the character has to be standing by the giver
    expose("accept", function(npc)
        if typeof(npc) ~= "Instance" or not npc:IsA("Model") then return false, Errors.BAD_ARGS end
        if not coroutine.isyieldable() then return false, Errors.BAD_ARGS end
        local folder = questsFolder()
        local remote = net()
        if not (folder and remote) then return false, Errors.NOT_READY end
        local key = npc.Name
        local existing = folder:FindFirstChild(key)
        if existing and existing:GetAttribute("Completed") ~= true then return true, readQuest(existing) end
        local ok, code = remote.fire(ACCEPT, "Quest", npc)
        if not ok then return false, Errors.FAILED, code end
        local taken = waitFor(function()
            local child = folder:FindFirstChild(key)
            return child ~= nil and child:GetAttribute("Completed") ~= true
        end)
        if not taken then return false, Errors.NO_ANSWER end
        return true, readQuest(folder:FindFirstChild(key))
    end)

    -- hands in a quest whose tasks are all done (a repeatable one's folder goes, a one-time one is marked Completed)
    expose("turnIn", function(key)
        if type(key) ~= "string" or key == "" then return false, Errors.BAD_ARGS end
        if not coroutine.isyieldable() then return false, Errors.BAD_ARGS end
        local folder = questsFolder()
        local remote = net()
        if not (folder and remote) then return false, Errors.NOT_READY end
        local child = folder:FindFirstChild(key)
        if not child then return false, Errors.NO_QUEST end
        local ok, code = remote.fire(COMPLETE, "Complete", key)
        if not ok then return false, Errors.FAILED, code end
        local handed = waitFor(function()
            local now = folder:FindFirstChild(key)
            return now == nil or now:GetAttribute("Completed") == true
        end)
        if not handed then return false, Errors.NO_ANSWER end
        return true
    end)

    api.matchMobs = matchMobs

    if base.maid then
        base.maid:GiveTask(function() closed = true end)
    end

    return api
end

return M

end)
