        local view = summary(s)
        for watcher in pairs(watchers) do
            if watcher.kind == kind and watcher.session == nil then
                watcher.session = s
                if watcher.notify then watcher.notify(true) end
            end
        end
        openSignal:Fire(view)
    end

    local function onEvent(kind, event, data)
        if dead or type(data) ~= "table" then return end
        if event == "Open" then
            onOpen(kind, data)
            return
        end
        local s = sessions[kind]
        if s == nil or s.id ~= data.Session then return end
        s.lastHeard = os.clock()
        if event == KINDS[kind].step then
            local id = data.Id
            -- the server's re-send of a round carries the same id, and the server must still hear one answer
            if id == nil or s.seen[id] then return end
            s.seen[id] = true
            s.rounds = s.rounds + 1
            absorb(s, data)
            if s.mode ~= "watch" then schedule(s, data) end
        elseif event == "Result" then
            absorb(s, data)
            if type(data.Result) == "string" then
                s.lastResult = data.Result
                s.results[#s.results + 1] = data.Result
            end
            resultSignal:Fire(summary(s), data.Result)
