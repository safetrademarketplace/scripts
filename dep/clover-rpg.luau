end

function M.new(ctx)
    local base = Api.define("Combat", ctx)
    local maid = base.maid

    local api = { Errors = Errors }

    local closed = false
    local parryWindow = DEFAULT_PARRY_WINDOW
    local gameGlobals = nil
    local casting = false
    local castJob = nil
    local pendingUse = nil

    local function state()
        local s = ctx.Api and ctx.Api.State
        if type(s) == "table" then return s end
        return nil
    end

    local function net()
        local n = ctx.Api and ctx.Api.CloverNet
        if type(n) == "table" then return n end
        return nil
    end

    -- a State getter's values, or nil when the read itself failed
    local function read(name, ...)
        local s = state()
        if s == nil then return nil end
        local ok, a, b = s[name](...)
        if ok ~= true then return nil end
        return a, b
    end

    -- (readable, value): an attribute the server never wrote reads fine as nil
    local function stat(name)
        local s = state()
        if s == nil then return false end
        local ok, value = s.stat(name)
        return ok == true, value
    end

    local function has(name)
        return read("has", name) == true
    end

    local function liveCharacter()
        return read("character")
    end

    -- nil when the character can act, else (code, reason)
    local function aliveRefusal()
        local alive = read("alive")
        if alive == nil then return Errors.NOT_READY end
        if not alive then return Errors.CANT_ACT, "Dead" end
        return nil
    end

    -- nil when the game would allow the action, else (code, the first state it would refuse it for)
    local function refusal(action)
        local can, reason = read("can", action)
        if can == nil then return Errors.NOT_READY end
        if can then return nil end
        return Errors.CANT_ACT, reason
    end

    local function falling()
        local humanoid = read("humanoid")
        if humanoid == nil then return nil end
        return humanoid:GetState() == Enum.HumanoidStateType.Freefall and not has("Swimming")
    end

    -- the transport's own not-ready stays not-ready; every other refusal is a failed send carrying the transport's code
    local function outcome(n, ok, code)
        if ok then return true end
        if code == n.Errors.NOT_READY then return false, Errors.NOT_READY end
        return false, Errors.SEND_FAILED, code
    end

    local function send(ns, name, data)
        local n = net()
        if n == nil then return false, Errors.NOT_READY end
        return outcome(n, n.send(ns, name, data))
    end

    local function fire(path, ...)
        local n = net()
        if n == nil then return false, Errors.NOT_READY end
        return outcome(n, n.fire(path, ...))
    end

    -- the game's own _G, where BackpackClient keeps Use; the executor's _G is a sandbox. kept once found, never while missing
    local function globals()
        if gameGlobals ~= nil then return gameGlobals end
        local getrenv = Executor.get("getrenv")
        if type(getrenv) ~= "function" then return nil end
        local ok, env = pcall(getrenv)
        if not ok or type(env) ~= "table" then return nil end
        local g = env._G
        if type(g) ~= "table" then return nil end
        gameGlobals = g
        return g
    end

    -- (tool, equipped) or (nil, nil, code); CombatClient.lua:236-238 gates on the first Tool the character holds
    local function findWeapon()
        local readable, style = stat("FightingStyle")
        if not readable then return nil, nil, Errors.NOT_READY end
        if type(style) ~= "string" or style == "" then return nil, nil, Errors.NO_WEAPON end
        local char = liveCharacter()
        local held = char and char:FindFirstChildWhichIsA("Tool")
        if held ~= nil and held.Name == style and isWeapon(held) then return held, true end
        local tool = toolIn(References.player:FindFirstChild("Backpack"), style) or toolIn(char, style)
        if tool ~= nil and isWeapon(tool) then return tool, false end
        return nil, nil, Errors.NO_WEAPON
    end

    -- BackpackClient.lua:853-865 then :1918: the first tool of that name, castable only when it carries a Skill child
    local function skillTool(name)
        local tool = toolIn(References.player:FindFirstChild("Backpack"), name) or toolIn(liveCharacter(), name)
        if tool ~= nil and tool:FindFirstChild("Skill") ~= nil then return tool end
        return nil
    end

    local function collectSkills(container, out, seen)
        if container == nil then return end
        for _, child in ipairs(container:GetChildren()) do
            local name = child.Name
            if not seen[name] and child:IsA("Tool") then
                seen[name] = true
                if child:FindFirstChild("Skill") ~= nil then out[#out + 1] = child end
            end
        end
    end

    -- only our own lowering is undone: a value something else wrote since is left alone
    local function restoreUse()
        local pending = pendingUse
        if pending == nil then return end
        pendingUse = nil
        if pending.globals.Use == false then pending.globals.Use = pending.prior end
    end

    local function endCast()
        castJob = nil
        casting = false
    end

    -- BackpackClient.lua:947-957: Transform gives Use back at once but holds the cast a frame, DoubleClick holds Use down for that frame
    local function settleCast(style)
        if style ~= "DoubleClick" then restoreUse() end
        if style ~= "DoubleClick" and style ~= "Transform" then return end
        casting = true
        castJob = Jobs.delay(0, function()
            restoreUse()
            endCast()
        end, { name = "Combat.cast" })
        if castJob == nil then
            restoreUse()
            endCast()
        end
    end

    local catalogue = Skills.new({ warn = base.warn })

    local guard = Guard.new({
        send = function(action)
            local ok, code = send("Combat", "BlockInput", { Action = action })
            if ok then return true end
            return false, code == Errors.NOT_READY
        end,
        alive = function(char)
            if char.Parent == nil then return false end
            return read("alive") == true
        end,
        character = liveCharacter,
    })

    local aim = Aim.new({ net = net, warn = base.warn })

    local incoming = Incoming.new({ net = net, safe = base.safe, log = base.log })

    -- a throw on an instance tree in an unexpected shape becomes a code, so a caller never needs its own pcall
    local function settle(label, ok, ...)
        if ok then return ... end
        base.warn("%s threw: %s", label, tostring((...)))
        return false, Errors.NOT_READY
    end

    local function expose(name, fn)
        local label = "Combat." .. name
        api[name] = function(...)
            if closed then return false, Errors.NOT_READY end
            return settle(label, pcall(fn, ...))
        end
    end

    expose("weapon", function()
        local tool, equipped, code = findWeapon()
        if tool == nil then return false, code end
        return true, {
            tool     = tool,
            name     = tool.Name,
            equipped = equipped,
            kind     = tool:GetAttribute("Combat") or tool:GetAttribute("Sword"),
        }
    end)

    -- BackpackClient.lua:691-697: the game will not equip while the inventory is processing, while incapacitated or while Use is down
    local function equipRefusal()
        local busy, why = read("busy")
        if busy == nil then return Errors.NOT_READY end
        if busy then return Errors.BUSY, why end
        if CollectionService:HasTag(References.player, "ProcessingInventory") then return Errors.BUSY, "ProcessingInventory" end
        local down, reason = read("incapacitated")
        if down == nil then return Errors.NOT_READY end
        if down then return Errors.CANT_ACT, reason end
        local g = globals()
        if g ~= nil and not g.Use then return Errors.BUSY, "Use" end
        return nil
    end

    expose("equipWeapon", function()
        local tool, equipped, missing = findWeapon()
        if tool == nil then return false, missing end
        if equipped then return true end
        local code, reason = equipRefusal()
        if code then return false, code, reason end
        local humanoid = read("humanoid")
        if humanoid == nil then return false, Errors.NOT_READY end
        -- the game's Animate script sends Inventory.ToggleWeapon "Draw" by itself once the tool lands in the character
        humanoid:EquipTool(tool)
        local deadline = os.clock() + EQUIP_TIMEOUT
        while true do
            local _, now = findWeapon()
            if now then return true end
            if closed then return false, Errors.NOT_READY end
            if os.clock() >= deadline or not coroutine.isyieldable() then return false, Errors.NOT_EQUIPPED end
            task.wait()
        end
    end)

    expose("attack", function(kind, opts)
        if kind == nil then kind = "light" end
        local spec = ATTACKS[kind]
        if spec == nil or (opts ~= nil and type(opts) ~= "table") then return false, Errors.BAD_ARGS end
        local tool, equipped, missing = findWeapon()
        if tool == nil then return false, missing end
        if not equipped then return false, Errors.NOT_EQUIPPED end
        local code, reason = refusal("combat")
        if code then return false, code, reason end
        local inAir = falling()
        if inAir == nil then return false, Errors.NOT_READY end
        local action = spec.action
        if spec.falling then
            if not inAir then return false, Errors.CANT_ACT, "NotFalling" end
            -- CombatClient.lua:50: an air swing waits out the Airborne launch an uppercut leaves behind
            if kind == "air" and has("Airborne") then return false, Errors.CANT_ACT, "Airborne" end
        elseif kind == "light" and inAir and not has("Airborne") then
            -- CombatClient.lua:49-52: the game's own m1 goes out as an air attack while falling
            action = "AirAttack"
        end
        local sprint = false
        if spec.sprint then
            if opts ~= nil and opts.sprint ~= nil then
                sprint = opts.sprint == true
            else
                sprint = has("Sprinting")
            end
        end
        return send("Combat", "AttackInput", { Action = action, SprintAttack = sprint })
    end)

    -- CombatClient.lua:269-272: the feint rides the weapon gate; Action is always true
    expose("misdirect", function()
        local tool, equipped, missing = findWeapon()
        if tool == nil then return false, missing end
        if not equipped then return false, Errors.NOT_EQUIPPED end
        if has("MisdirectCooldown") then return false, Errors.ON_COOLDOWN end
        local code, reason = refusal("combat")
        if code then return false, code, reason end
        return send("Combat", "MisdirectInput", { Action = true })
    end)

    -- the game holds no weapon gate on the block key, and keeps sending while a stun or a swing lets the server start the block late
    expose("block", function(on)
        if type(on) ~= "boolean" then return false, Errors.BAD_ARGS end
        if not on then
            guard.release()
            return true
        end
        local code, reason = aliveRefusal()
        if code then return false, code, reason end
        local ok, fatal = guard.hold()
        if ok then return true end
        if fatal then return false, Errors.NOT_READY end
        return false, Errors.SEND_FAILED
    end)

    expose("parry", function(opts)
        if opts ~= nil and type(opts) ~= "table" then return false, Errors.BAD_ARGS end
        local window = parryWindow
        if opts ~= nil and opts.window ~= nil then
            if not validWindow(opts.window) then return false, Errors.BAD_ARGS end
            window = opts.window
        end
        if guard.parrying() then return false, Errors.BUSY end
        local can, reason = read("can", "parry")
        if can == nil then return false, Errors.NOT_READY end
        -- our own held block is let go first, so the game's Blocking refusal does not stand against this press
        if not can and not (BLOCKING[reason] and guard.holding()) then return false, Errors.CANT_ACT, reason end
        local ok, fatal = guard.tap(window)
        if ok then return true end
        if fatal then return false, Errors.NOT_READY end
        return false, Errors.SEND_FAILED
    end)

    -- the packet only buys the server's Dodging i-frames: the roll's 0.3 s of movement is client-side (Dash.lua:208-244) and belongs to the Movement api
    expose("roll", function(typeOf)
        if typeOf == nil then typeOf = "" end
        if not ROLLS[typeOf] then return false, Errors.BAD_ARGS end
        local code, reason = refusal("dash")
        if code then return false, code, reason end
        if typeOf == "AirDash" then
            local inAir = falling()
            if inAir == nil then return false, Errors.NOT_READY end
            if not inAir then return false, Errors.CANT_ACT, "NotFalling" end
            local char = liveCharacter()
            if char == nil then return false, Errors.NOT_READY end
            if char:FindFirstChild("Air Dash") == nil then return false, Errors.CANT_ACT, "NoAirDash" end
        elseif typeOf == "Surge" then
            local char = liveCharacter()
            if char == nil then return false, Errors.NOT_READY end
            if char:FindFirstChild("Chrono Surge") == nil then return false, Errors.CANT_ACT, "NoChronoSurge" end
            if has("ChronoSurgeCD") then return false, Errors.ON_COOLDOWN end
            local vitals = read("vitals")
            if vitals == nil then return false, Errors.NOT_READY end
            if not (vitals.energy > SURGE_MIN_ENERGY) then return false, Errors.NO_ENERGY end
        end
        return send("Combat", "RollInput", { Action = "Roll", typeOf = typeOf })
    end)

    -- Dash.lua:309-325: the game sends this on every right click and stops its own roll when the server echoes it back
    expose("cancelRoll", function()
        local code, reason = aliveRefusal()
        if code then return false, code, reason end
        return send("Combat", "RollInput", { Action = "Cancel" })
    end)

    -- Crouch.lua:21-37 behind StateManager.lua:595-607 CanCrouch and :424-426 IsCrouching; asking for what already holds sends nothing
    expose("crouch", function(on)
        if type(on) ~= "boolean" then return false, Errors.BAD_ARGS end
        local code, reason = aliveRefusal()
        if code then return false, code, reason end
        local crouching = has("Crouching")
        if not on then
            if not crouching then return true end
            return send("Combat", "CrouchInput", { Action = "Stop Crouching" })
        end
        if crouching then return true end
        if has("Blocking") then return false, Errors.CANT_ACT, "Blocking" end
        if has("SwordBlocking") then return false, Errors.CANT_ACT, "SwordBlocking" end
        local down, why = read("incapacitated")
        if down == nil then return false, Errors.NOT_READY end
        if down then return false, Errors.CANT_ACT, why end
        if read("flying") == true then return false, Errors.CANT_ACT, "Flying" end
        for _, name in ipairs(CROUCH_HELD) do
            if has(name) then return false, Errors.CANT_ACT, name end
        end
        return send("Combat", "CrouchInput", { Action = "Start Crouching" })
    end)

    -- remaining is the server's own CD countdown; ready means off cooldown and affordable right now
    expose("skills", function()
        local tools, seen = {}, {}
        collectSkills(References.player:FindFirstChild("Backpack"), tools, seen)
        collectSkills(liveCharacter(), tools, seen)
        local vitals = read("vitals")
        local energy = vitals and vitals.energy
        local out = {}
        for _, tool in ipairs(tools) do
            local name = tool.Name
            local info, available = catalogue.lookup(name)
            if not available then return false, Errors.NOT_READY end
            if info ~= nil then
                local remaining = read("skillCooldown", name) or 0
                local cost = info.EnergyCost or 0
                out[#out + 1] = {
                    name       = name,
                    tool       = tool,
                    skillset   = info.Skillset,
                    style      = info.Style,
                    remote     = Skills.route(info.Skillset),
                    energyCost = cost,
                    cooldown   = info.Cooldown,
                    remaining  = remaining,
                    ready      = remaining <= 0 and energy ~= nil and cost <= energy,
                }
            end
        end
        return true, out
    end)

    -- BackpackClient.lua:885-959 without its half-second retry: a refusal comes straight back for the caller to retry
    expose("cast", function(name)
        if type(name) ~= "string" or name == "" then return false, Errors.BAD_ARGS end
        local tool = skillTool(name)
        if tool == nil then return false, Errors.NO_SKILL end
        local info, available = catalogue.lookup(tool.Name)
        if not available then return false, Errors.NOT_READY end
        if info == nil then return false, Errors.NO_SKILL end
        if casting then return false, Errors.BUSY end
        -- _G.Use is only down while a cast is in flight or a cutscene holds the player
        local g = globals()
        if g ~= nil and g.Use == false then return false, Errors.BUSY, "Use" end
        -- CanUseSkill already refuses Parried and Stunned, the two states the game checks first
        local code, reason = refusal("skill")
        if code then return false, code, reason end
        local vitals = read("vitals")
        if vitals == nil then return false, Errors.NOT_READY end
        if (info.EnergyCost or 0) > vitals.energy then return false, Errors.NO_ENERGY end
        local remaining = read("skillCooldown", tool.Name)
        if remaining == nil then return false, Errors.NOT_READY end
        if remaining > 0 then return false, Errors.ON_COOLDOWN end
        if g ~= nil then
            pendingUse = { globals = g, prior = g.Use }
            g.Use = false
        end
        local ok, failure, detail = fire(Skills.route(info.Skillset), tool.Name)
        if not ok then
            restoreUse()
            return false, failure, detail
        end
        settleCast(info.Style)
        return true
    end)

    -- UtilityClient.lua:198,401-405: the wheel fires the name alone, and a spell is unlocked once the player's Skills folder holds it
    expose("utility", function(name)
        if not UTILITY[name] then return false, Errors.BAD_ARGS end
        local code, reason = aliveRefusal()
        if code then return false, code, reason end
        local learned = References.player:FindFirstChild("Skills")
        if learned == nil or learned:FindFirstChild(name) == nil then return false, Errors.NO_SKILL end
        local info, available = catalogue.lookup(name)
        if not available then return false, Errors.NOT_READY end
        local vitals = read("vitals")
        if vitals == nil then return false, Errors.NOT_READY end
        if info ~= nil and (info.EnergyCost or 0) > vitals.energy then return false, Errors.NO_ENERGY end
        local remaining = read("skillCooldown", name)
        if remaining == nil then return false, Errors.NOT_READY end
        if remaining > 0 then return false, Errors.ON_COOLDOWN end
        return fire("Utility", name)
    end)

    -- CombatClient.lua:113-117: an empty packet; StateManager.displayTags.lua:80-85 names its cooldown after the magic
    expose("ultimate", function()
        local code, reason = aliveRefusal()
        if code then return false, code, reason end
        local readable, magic = stat("Magic")
        if not readable then return false, Errors.NOT_READY end
        if type(magic) ~= "string" or magic == "" or magic == "None" then return false, Errors.CANT_ACT, "NoMagic" end
        if has(magic .. " UltimateCooldown") then return false, Errors.ON_COOLDOWN end
        return send("Magic", "Ultimate", {})
    end)

    -- SpiritClient.lua:16-21,33-35 and RageClient.lua:19-29: one bind, the deity's spirit or a Beast grimoire's rage
    expose("surge", function(kind)
        if kind ~= nil and kind ~= "spirit" and kind ~= "beast" then return false, Errors.BAD_ARGS end
        local code, reason = aliveRefusal()
        if code then return false, code, reason end
        local readable, magic = stat("Magic")
        if not readable then return false, Errors.NOT_READY end
        if kind == nil then
            kind = "spirit"
            if magic == "Beast" then kind = "beast" end
        end
        if kind == "beast" then
            if magic ~= "Beast" then return false, Errors.CANT_ACT, "NotBeast" end
            return fire("Beast", "Trigger")
        end
        local okDeity, deity = stat("Deity")
        if not okDeity then return false, Errors.NOT_READY end
        if type(deity) ~= "string" or deity == "" then return false, Errors.CANT_ACT, "NoDeity" end
        local okMeter, meter = stat("SpiritMeter")
        if not okMeter then return false, Errors.NOT_READY end
        if type(meter) ~= "number" or meter < SPIRIT_METER_MAX then return false, Errors.NO_ENERGY end
        return fire("Spirit", "Trigger")
    end)

    -- Carry_Grip.lua:17-29: no target travels, the server takes the nearest downed body
    local function downedEvent(action)
        local code, reason = aliveRefusal()
        if code then return false, code, reason end
        local down, why = read("incapacitated")
        if down == nil then return false, Errors.NOT_READY end
        if down then return false, Errors.CANT_ACT, why end
        return fire("Player/DownedEvents", action)
    end

    expose("grip", function() return downedEvent("Grip") end)
    expose("carry", function() return downedEvent("Carry") end)

    -- provider() -> (position: Vector3, part: BasePart?) or nil to let the game answer
    -- the instakill: a mob whose root this client simulates (a heavy hit or a skill's knock hands it over now and then) takes a lethal hit, a zero and a Dead state, and the server takes a humanoid's state from its owner; one the server still owns is refused untouched, so a farm keeps fighting and tries again
    -- opts.force tries it whatever isnetworkowner says (it can read false on a mob that is ours, the Ouwland lesson) and again on a mob whose health already reads 0 here: whether it took is then the caller's to judge by the mob's instance leaving the world
    expose("execute", function(model, opts)
        if typeof(model) ~= "Instance" or not model:IsA("Model") then return false, Errors.BAD_ARGS end
        if opts ~= nil and (type(opts) ~= "table" or (opts.force ~= nil and type(opts.force) ~= "boolean")) then return false, Errors.BAD_ARGS end
        local force = opts ~= nil and opts.force == true
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        local root = model:FindFirstChild("HumanoidRootPart")
        if humanoid == nil or root == nil then return false, Errors.BAD_ARGS end
        if humanoid.Health <= 0 and not force then return true end
        if not force then
            local isOwner = Executor.get("isnetworkowner")
            if type(isOwner) ~= "function" then return false, Errors.NOT_READY end
            local okOwn, owned = pcall(isOwner, root)
            if not (okOwn and owned == true) then return false, Errors.NOT_OWNER end
        end
        pcall(function() humanoid:TakeDamage(humanoid.MaxHealth * 10 + 1000) end)
        pcall(function() humanoid.Health = 0 end)
        pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Dead) end)
        return true
    end)

    expose("setAim", function(provider)
        if type(provider) ~= "function" then return false, Errors.BAD_ARGS end
        local ok, handle = aim.set(provider)
        if ok then return true, handle end
        return false, AIM_CODES[handle] or Errors.NOT_READY
    end)

    expose("clearAim", function()
        aim.clear()
        return true
    end)

    -- parryWindow: seconds a parry press is held when parry() is not handed its own window
    expose("configure", function(opts)
        if type(opts) ~= "table" then return false, Errors.BAD_ARGS end
        if opts.parryWindow ~= nil then
            if not validWindow(opts.parryWindow) then return false, Errors.BAD_ARGS end
            parryWindow = opts.parryWindow
        end
        return true
    end)

    -- consumers get Connect alone, dot or colon, and a handle a maid takes as-is
    local onIncoming = {}
    function onIncoming.Connect(a, b)
        local fn = b
        if type(a) == "function" then fn = a end
        if type(fn) ~= "function" or closed then return { Disconnect = noop, Destroy = noop } end
        local disconnect = incoming.connect(fn) or noop
        local function release() disconnect() end
        return { Disconnect = release, Destroy = release }
    end
    api.onIncoming = onIncoming

    -- the held key and the aim go back while the transport is still open, which the session's reverse-order unload guarantees
    if maid then
        maid:GiveTask(function()
            if closed then return end
            guard.close()
            aim.close()
            incoming.close()
            if castJob ~= nil then castJob:Cancel() end
            restoreUse()
            endCast()
            closed = true
        end)
    end

    return api
end

return M

end)
__bundle_register("Api/Combat/Skills", function(require, _LOADED, __bundle_register, __bundle_modules)
-- combat skills: the game's skill catalogue (ReplicatedStorage.Modules.Skills, a pure data module) and the remote each skillset casts on, mirroring BackpackClient's GetRemote; the module is kept once found and never while missing

local Services = require("Services")

-- BackpackClient.lua:870-883: anything not listed, a missing skillset included, casts on Remotes.Magic
local ROUTES = { Weapon = "Weapon", Combat = "Misc", Starter = "Misc" }
local DEFAULT_ROUTE = "Magic"

local M = {}

function M.route(skillset)
    if skillset == nil then return DEFAULT_ROUTE end
    return ROUTES[skillset] or DEFAULT_ROUTE
end

-- deps.warn(fmt, ...)
function M.new(deps)
    local catalogue, lastError

    local function resolve()
        if catalogue then return catalogue end
        local modules = Services.ReplicatedStorage:FindFirstChild("Modules")
        local instance = modules and modules:FindFirstChild("Skills")
        if instance == nil then return nil end
        -- the executor hands back the game's cached copy, so this never re-runs the module
        local ok, mod = pcall(require, instance)
        if not ok then
            if tostring(mod) ~= lastError then
                lastError = tostring(mod)
                deps.warn("require Skills failed: %s", lastError)
            end
            return nil
        end
        if type(mod) ~= "table" or type(mod.Skills) ~= "table" then return nil end
        catalogue = mod
        return mod
    end

    local self = {}

    -- (info, true) for a known skill, (nil, true) for an unknown one, (nil, false) while the catalogue is unreadable
    function self.lookup(name)
        local mod = resolve()
        if mod == nil then return nil, false end
        local info = mod.Skills[name]
