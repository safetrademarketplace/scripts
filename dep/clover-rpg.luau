            stats.rolled = stats.rolled + 1
            threat.outcome = "rolled"
            return
        end
        if request.block and Combat.block(true) == true then
            stats.blocked = stats.blocked + 1
            blockUntil = math.max(blockUntil or 0, due + BLOCK_HOLD)
        end
    end

    -- an attack nothing is known of is blocked until it lands, or a roll goes out when blocking is not wanted
    local function guardFor(threat, now)
        threat.pressed = now
        threat.guarded = true
        local request = threat.request
        local Combat = apiOf("Combat")
        if not Combat then return end
        if request.block and Combat.block(true) == true then
            stats.blocked = stats.blocked + 1
            blockUntil = math.max(blockUntil or 0, threat.tell + GUARD_LIMIT)
            return
        end
        if request.roll and Combat.roll() == true then
            stats.rolled = stats.rolled + 1
            threat.outcome = "rolled"
        end
    end

    local function frame()
        local now = os.clock()
        if blockUntil and now >= blockUntil then
            blockUntil = nil
            local Combat = apiOf("Combat")
            if Combat then Combat.block(false) end
        end
        local lag = ping()
        for i = #threats, 1, -1 do
            local threat = threats[i]
            if now - threat.tell > THREAT_LIFE then
                table.remove(threats, i)
                -- what happened to each attack, for tuning: when it was pressed and when it struck, both from its tell
                history[#history + 1] = {
                    key = keyOf(threat), expected = delayOf(threat), outcome = threat.outcome or (threat.pressed and "pressed") or "ignored",
                    pressed = threat.pressed and (threat.pressed - threat.tell) or nil, landed = threat.landed,
                }
                if #history > HISTORY then table.remove(history, 1) end
            elseif threat.struckAt and threat.outcome == nil and now - threat.struckAt > LABEL_AFTER then
                -- it reached us and took no health: the block (or the parry window's tail) had it
                threat.outcome = threat.guarded and "guarded" or "blocked"
                if threat.guarded then stats.guarded = stats.guarded + 1 end
            elseif not threat.pressed then
                if known(threat) then
                    local delay, spread = timingOf(threat)
                    local due = threat.tell + delay
                    if now >= due - spread - lag - LEAD - offset then press(threat, now, due) end
                elseif now >= threat.tell + GUARD_REACT then
                    guardFor(threat, now)
                end
            end
        end
        save(false)
    end

    -- ===== the engine's life: running while anything asks =====

    local function start()
        if running then return end
        running = true
        local CloverNet = apiOf("CloverNet")
        if CloverNet then
            local okVfx, vfx = CloverNet.on(NPC_VFX, onVfx)
            if okVfx and vfx then hooks[#hooks + 1] = vfx end
            local okSword, sword = CloverNet.on(SWORD, onSword)
            if okSword and sword then hooks[#hooks + 1] = sword end
        end
        hooks[#hooks + 1] = Scheduler.heartbeat(frame, { name = "Parry.frame", priority = 5 })
        hooks[#hooks + 1] = Scheduler.heartbeat(function()
            bindHealth()
            refreshWatch()
        end, { name = "Parry.watch", interval = WATCH_EVERY })
        bindHealth()
        refreshWatch()
    end

    local function stop()
        if not running then return end
        running = false
        for _, hook in ipairs(hooks) do hook:Disconnect() end
        hooks = {}
        for model in pairs(watched) do unwatch(model) end
        if health.conn then health.conn:Disconnect() end
        if health.struckConn then health.struckConn:Disconnect() end
        health.humanoid, health.conn, health.last, health.char, health.struckConn = nil, nil, nil, nil, nil
        threats = {}
        if blockUntil then
            blockUntil = nil
            local Combat = apiOf("Combat")
            if Combat then Combat.block(false) end
        end
        save(true)
    end

    local function readRequest(name, opts, into)
        if opts ~= nil and type(opts) ~= "table" then return nil end
        opts = opts or {}
        local request = into or { name = name, range = 30, roll = true, block = true }
        if opts.range ~= nil then
            if not (finite(opts.range) and opts.range > 0) then return nil end
            request.range = opts.range
        end
        if opts.roll ~= nil then
            if type(opts.roll) ~= "boolean" then return nil end
            request.roll = opts.roll
        end
        if opts.block ~= nil then
            if type(opts.block) ~= "boolean" then return nil end
            request.block = opts.block
        end
        if opts.filter ~= nil then
            if type(opts.filter) ~= "function" then return nil end
            request.filter = opts.filter
        end
        return request
    end

    -- name says who asked; range in studs (30), roll and block as the fallbacks to a refused parry (both on), filter(model) to narrow which mobs
    expose("request", function(name, opts)
        if type(name) ~= "string" or name == "" then return false, Errors.BAD_ARGS end
        local request = readRequest(name, opts)
        if not request then return false, Errors.BAD_ARGS end
        tokens = tokens + 1
        local token = { id = tokens, name = name }
        requests[token] = request
        start()
        return true, token
    end)

    expose("adjust", function(token, opts)
        local request = requests[token]
        if not request then return false, Errors.NO_TOKEN end
        if not readRequest(request.name, opts, { name = request.name, range = request.range, roll = request.roll, block = request.block, filter = request.filter }) then
            return false, Errors.BAD_ARGS
        end
        readRequest(request.name, opts, request)
        return true
    end)

    expose("release", function(token)
        if not requests[token] then return false, Errors.NO_TOKEN end
        requests[token] = nil
        if next(requests) == nil then stop() end
        return true
    end)

    -- offset in seconds: positive presses earlier, for a connection the ping alone does not account for
    expose("configure", function(settings)
        if type(settings) ~= "table" then return false, Errors.BAD_ARGS end
        if settings.offset ~= nil then
            if not (finite(settings.offset) and math.abs(settings.offset) <= 0.5) then return false, Errors.BAD_ARGS end
            offset = settings.offset
        end
        return true
    end)

    expose("settings", function()
        local names = {}
        for _, request in pairs(requests) do names[#names + 1] = request.name end
        table.sort(names)
        return true, { offset = offset, active = running, requests = names }
    end)

    expose("stats", function()
        local learned = 0
        for _ in pairs(moves) do learned = learned + 1 end
        return true, {
            pressed = stats.pressed, parried = stats.parried, rolled = stats.rolled, blocked = stats.blocked, hits = stats.hits,
            guarded = stats.guarded, ignored = stats.ignored, watching = watchCount, learned = learned,
        }
    end)

    -- the soonest attack still to land on us, or nil: { model, strikeIn (seconds, from what is learned), known, guarded }; a fight holds its swings when one is due before a swing would finish
    expose("incoming", function()
        local now = os.clock()
        local soonest = nil
        for _, threat in ipairs(threats) do
            if not threat.learned and threat.outcome == nil and now - threat.tell <= SAMPLE_MAX then
                local isKnown = known(threat)
                local due = threat.tell + delayOf(threat)
                -- an unknown attack is taken as landing any moment until it does
                if not isKnown then due = now end
                if not soonest or due < soonest.due then
                    soonest = { model = threat.model, due = due, known = isKnown, guarded = threat.guarded == true }
                end
            end
        end
        if not soonest then return true, nil end
        return true, { model = soonest.model, strikeIn = math.max(soonest.due - now, 0), known = soonest.known, guarded = soonest.guarded }
    end)

    -- every attack learned so far, most practised first
    expose("moves", function()
        local out = {}
        for key, entry in pairs(moves) do out[#out + 1] = { key = key, delay = entry.delay, spread = entry.spread, samples = entry.samples } end
        table.sort(out, function(a, b)
            if a.samples ~= b.samples then return a.samples > b.samples end
            return a.key < b.key
        end)
        return true, out
    end)

    -- the last attacks seen, oldest first, each with its learned delay, when it was pressed and when it landed (seconds from its tell)
    expose("history", function()
        local out = {}
        for i, entry in ipairs(history) do
            out[i] = { key = entry.key, expected = entry.expected, outcome = entry.outcome, pressed = entry.pressed, landed = entry.landed }
        end
        return true, out
    end)

    expose("forget", function()
        moves = {}
        dirty = true
        save(true)
        return true
    end)

    api.onParry = listenable(parrySignal)

    load()

    if base.maid then
        base.maid:GiveTask(function()
            stop()
            requests = {}
            closed = true
        end)
    end

    return api
end

return M

end)
