    end

    Toggles.Fullbright:OnChanged(function()
        if Toggles.Fullbright.Value then fbOn() else fbOff() end
    end)

    Options.Fullbright_Mode:OnChanged(function()
        if active then holdLook() end
    end)

    Options.Fullbright_Brightness:OnChanged(function()
        if active then hold(Lighting, "Brightness", brightness()) end
    end)

    return { cleanup = fbOff }
end

