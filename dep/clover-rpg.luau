__bundle_register("Api/World/Interactables", function(require, _LOADED, __bundle_register, __bundle_modules)
-- world interactables: what a player uses rather than fights — shop items with their price, bankers, trainers, alchemy cauldrons, sell vendors resolved to their npcs, and any prompt by name near a point

local Services = require("Services")
local Errors   = require("Api/World/Errors")
local Members  = require("Api/World/Members")
local Read     = require("Api/World/Read")

local Workspace         = Services.Workspace
local CollectionService = Services.CollectionService

local SHOP_ITEMS = { "Objects", "ShopObjects" }
local BANKERS    = { "Objects", "Bankers" }
local TRAINERS   = { "Objects", "Trainers" }

local M = {}

local function isBuyPrompt(inst)
    return inst.ClassName == "ProximityPrompt" and inst.Name == "BuyPrompt"
end

local function isPrompt(inst)
    return inst.ClassName == "ProximityPrompt"
end

-- ProximityClient.lua:279-300 for the name and the Price child, ShopClient.lua:45 for Unique
local function shopEntry(prompt)
    local model = Read.nearestModel(prompt)
    local price = prompt:FindFirstChild("Price")
    local value = price ~= nil and price:IsA("ValueBase") and price.Value or nil
    return {
        prompt   = prompt,
        model    = model,
        name     = Read.shopLabel(prompt),
        price    = type(value) == "number" and value or nil,
        unique   = model ~= nil and Read.truthy(model:GetAttribute("Unique")),
        position = Read.position(prompt.Parent),
    }
end

-- the dialogue name lives in each object's Info module, which is never required, so the prompt and model labels stand in
local function staffEntry(child)
    local prompt = child:IsA("ProximityPrompt") and child or child:FindFirstChildWhichIsA("ProximityPrompt", true)
    local model = child:IsA("Model") and child or nil
    local name = prompt and (Read.text(prompt.ObjectText) or Read.text(prompt:GetAttribute("DisplayName")))
    if name == nil and model ~= nil then name = Read.text(model:GetAttribute("DisplayName")) end
    return {
        key      = child.Name,
        name     = name or Read.readable(child.Name),
        instance = child,
        model    = model,
        prompt   = prompt,
        position = prompt and Read.position(prompt.Parent) or Read.position(child),
    }
end

local function promptEntry(prompt, position)
    return {
        prompt       = prompt,
        name         = prompt.Name,
        label        = Read.promptLabel(prompt),
        model        = Read.nearestModel(prompt),
        part         = prompt.Parent,
        position     = position,
        enabled      = prompt.Enabled,
        maxDistance  = prompt.MaxActivationDistance,
        holdDuration = prompt.HoldDuration,
    }
end

-- env: catalog, entities, safe, origin(filter)
function M.new(env)
    local interactables = {}
    local byName = {}

    local shopWatch = Members.new({
        label   = "shops",
        resolve = function() return Read.walk(Workspace, SHOP_ITEMS) end,
        mode    = "descendants",
        accept  = isBuyPrompt,
        safe    = env.safe,
    })

    -- built on the first prompts() call with one sweep of the workspace, then kept current by its descendant signals and bucketed by prompt name
    local promptWatch = Members.new({
        label     = "prompts",
        resolve   = function() return Workspace end,
        mode      = "descendants",
        accept    = isPrompt,
        safe      = env.safe,
        onAdded   = function(prompt)
            local bucket = byName[prompt.Name]
            if bucket == nil then
                bucket = {}
                byName[prompt.Name] = bucket
            end
            bucket[prompt] = true
        end,
        onRemoved = function(prompt)
            local bucket = byName[prompt.Name]
            if bucket ~= nil then bucket[prompt] = nil end
        end,
    })

    local function staffed(segments)
        local folder = Read.walk(Workspace, segments)
        if folder == nil then return false, Errors.NOT_STREAMED end
        local list = {}
        for _, child in ipairs(folder:GetChildren()) do list[#list + 1] = staffEntry(child) end
        table.sort(list, Read.byName)
        return true, Read.finish(list, nil, env.origin(nil))
    end

    function interactables.shops()
        if not shopWatch.ensure() then return false, Errors.NOT_STREAMED end
        local list = {}
        for _, prompt in ipairs(shopWatch.all()) do list[#list + 1] = shopEntry(prompt) end
        table.sort(list, Read.byName)
        return true, Read.finish(list, nil, env.origin(nil))
    end

    -- Bankers Niko and Romano (inventory_economy.md §4.3)
    function interactables.bankers()
        return staffed(BANKERS)
    end

    function interactables.trainers()
        return staffed(TRAINERS)
    end

    -- Alchemy.lua:8 names the tag, AlchemyClient.lua:2018 finds the prompt directly under the station
    function interactables.cauldrons()
        local list = {}
        for _, station in ipairs(CollectionService:GetTagged("AlchemyCauldron")) do
            local prompt = station:FindFirstChild("AlchemyPrompt")
            if prompt ~= nil and not prompt:IsA("ProximityPrompt") then prompt = nil end
            list[#list + 1] = {
                instance = station,
                model    = station:IsA("Model") and station or Read.nearestModel(station),
                prompt   = prompt,
                position = Read.position(station),
            }
        end
        return true, Read.finish(list, nil, env.origin(nil))
    end

    -- a vendor whose model is not on the client yet is left out, never guessed at
    function interactables.sellers()
        local list = {}
        for _, name in ipairs(env.catalog.sellers()) do
            local ok, entry = env.entities.npc(name)
            if ok then
                list[#list + 1] = entry
            elseif entry == Errors.NOT_STREAMED then
                return false, entry
            end
        end
        return true, Read.finish(list, nil, env.origin(nil))
    end

    function interactables.prompts(name, origin, radius)
        promptWatch.ensure()
        local list = {}
        for prompt in pairs(byName[name] or {}) do
            local position = prompt.Parent ~= nil and Read.position(prompt.Parent) or nil
            if position ~= nil and (position - origin).Magnitude <= radius then
                list[#list + 1] = promptEntry(prompt, position)
            end
        end
        return true, Read.finish(list, nil, origin)
    end

    function interactables.shopModels()
        shopWatch.ensure()
        local out, added = {}, {}
        for _, prompt in ipairs(shopWatch.all()) do
            local model = Read.nearestModel(prompt)
            if model ~= nil and not added[model] then
                added[model] = true
                out[#out + 1] = model
            end
        end
        return out
    end

    function interactables.destroy()
        shopWatch.destroy()
        promptWatch.destroy()
        byName = {}
    end

    return interactables
end

return M

end)
__bundle_register("Api/World/Entities", function(require, _LOADED, __bundle_register, __bundle_modules)
-- world entities: the live mob, dialogue npc and other-player indexes; mobs and npcs come from watched folders so streaming, spawning and respawns keep them current, other players come from Core's shared EntityIndex

local Services      = require("Services")
local EntityIndex   = require("Utility/EntityIndex")
local PlayerHelpers = require("Utility/Helpers/Players")
local Errors        = require("Api/World/Errors")
local Members       = require("Api/World/Members")
local Read          = require("Api/World/Read")

local Workspace = Services.Workspace

-- both folders hold models whose parts stream separately, so a member counts once its root is in
local ROOT = "HumanoidRootPart"

local M = {}

M.MOB_FILTER = {
    name = "string", names = "names", alive = "boolean", bossOnly = "boolean",
    origin = "vector", maxDistance = "distance", limit = "count",
}

M.NPC_FILTER = {
    name = "string", names = "names", questGiver = "boolean", disabled = "boolean", streamed = "boolean",
    origin = "vector", maxDistance = "distance", limit = "count",
}

M.PLAYER_FILTER = {
    name = "string", names = "names", alive = "boolean",
    origin = "vector", maxDistance = "distance", limit = "count",
}

local function isModel(inst)
    return inst:IsA("Model")
end

local function wants(filter, key, value)
    local wanted = filter and filter[key]
    return wanted == nil or wanted == value
end

local function beastOf(beasts, baseName)
    if beasts == nil then return nil end
    return beasts.byModel[baseName]
end

local function mobEntry(model, beasts)
    local baseName, respawnable = Read.stripRespawn(model.Name)
    local beast = beastOf(beasts, baseName)
    local root = model:FindFirstChild(ROOT)
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local entry = {
        model       = model,
        name        = beast and beast.displayName or baseName,
        baseName    = baseName,
        root        = root,
        humanoid    = humanoid,
        respawnable = respawnable,
        boss        = beast ~= nil and beast.boss,
        alerted     = Read.truthy(model:GetAttribute("Alerted")),
        tags        = Read.tags(model),
        alive       = false,
    }
    if root ~= nil then entry.position = root.Position end
    if humanoid ~= nil then
        entry.health, entry.maxHealth = humanoid.Health, humanoid.MaxHealth
        entry.alive = entry.health > 0
    end
    return entry
end

-- an npc whose parts have streamed out is still a known destination: it answers through its pivot with no root or prompt
local function npcEntry(model)
    local root = model:FindFirstChild(ROOT)
    local prompt = root and root:FindFirstChild("ChatPrompt")
    if prompt ~= nil and not prompt:IsA("ProximityPrompt") then prompt = nil end
    return {
        model      = model,
        name       = model.Name,
        root       = root,
        streamed   = root ~= nil,
        position   = root and root.Position or Read.position(model),
        prompt     = prompt,
        questGiver = Read.hasTag(model, "QuestNPC"),
        disabled   = Read.hasTag(model, "InteractDisabled"),
    }
end

-- env: ctx, catalog, safe, origin(filter), mobAdded(entry), mobRemoved(entry)
function M.new(env)
    local entities = {}
    local catalog = env.catalog
    local seen = {}

    local mobWatch = Members.new({
        label   = "mobs",
        resolve = function() return Workspace:FindFirstChild("FightableNPCS") end,
        mode    = "children",
        accept  = isModel,
        part    = ROOT,
        safe    = env.safe,
        onAdded = function(model)
            seen[(Read.stripRespawn(model.Name))] = true
            env.mobAdded(mobEntry(model, catalog.beasts()))
        end,
        -- the model may already be gone, so only what its name says is reported
        onRemoved = function(model)
            local baseName, respawnable = Read.stripRespawn(model.Name)
            local beast = beastOf(catalog.beasts(), baseName)
            env.mobRemoved({
                model       = model,
                name        = beast and beast.displayName or baseName,
                baseName    = baseName,
                respawnable = respawnable,
                boss        = beast ~= nil and beast.boss,
            })
        end,
    })

    local npcWatch = Members.new({
        label   = "npcs",
        resolve = function() return Workspace:FindFirstChild("NPCS") end,
        mode    = "nested",
        accept  = isModel,
        part    = ROOT,
        safe    = env.safe,
    })

    function entities.watchMobs()
        mobWatch.ensure()
    end

    function entities.mobs(filter)
        if not mobWatch.ensure() then return false, Errors.NOT_STREAMED end
        local beasts = catalog.beasts()
        local names = Read.nameSet(filter)
        local bossOnly = filter ~= nil and filter.bossOnly == true
        local list = {}
        for _, model in ipairs(mobWatch.present()) do
            local entry = mobEntry(model, beasts)
            if (names == nil or names[entry.name] or names[entry.baseName])
                and wants(filter, "alive", entry.alive)
                and (entry.boss or not bossOnly) then
                list[#list + 1] = entry
            end
        end
        return true, Read.finish(list, filter, env.origin(filter))
    end

    function entities.nearestMob(filter)
        if env.origin(filter) == nil then return false, Errors.NOT_READY end
        local ok, list = entities.mobs(filter)
        if not ok then return false, list end
        if list[1] == nil then return false, Errors.NONE end
        return true, list[1]
    end

    -- every name a filter could want: mobs streamed in this session plus the whole bestiary
    function entities.mobNames()
        mobWatch.ensure()
        local beasts = catalog.beasts()
        local set = {}
        for baseName in pairs(seen) do
            local beast = beastOf(beasts, baseName)
            set[beast and beast.displayName or baseName] = true
        end
        if beasts ~= nil then
            for _, name in ipairs(beasts.names) do set[name] = true end
        end
        local out = {}
        for name in pairs(set) do out[#out + 1] = name end
        table.sort(out)
        return true, out
    end

    function entities.npcs(filter)
        if not npcWatch.ensure() then return false, Errors.NOT_STREAMED end
        local names = Read.nameSet(filter)
        local list = {}
        for _, model in ipairs(npcWatch.all()) do
            if names == nil or names[model.Name] then
                local entry = npcEntry(model)
                if wants(filter, "questGiver", entry.questGiver)
                    and wants(filter, "disabled", entry.disabled)
                    and wants(filter, "streamed", entry.streamed) then
                    list[#list + 1] = entry
                end
            end
        end
        return true, Read.finish(list, filter, env.origin(filter))
    end

    -- several models can share a name (villagers, guards): a streamed one wins, then the nearest
    function entities.npc(name)
        if not npcWatch.ensure() then return false, Errors.NOT_STREAMED end
        local origin = env.origin(nil)
        local best
        for _, model in ipairs(npcWatch.all()) do
            if model.Name == name then
                local entry = npcEntry(model)
                if origin ~= nil and entry.position ~= nil then entry.distance = (entry.position - origin).Magnitude end
                local better = best == nil
                    or (entry.streamed and not best.streamed)
                    or (entry.streamed == best.streamed and (entry.distance or math.huge) < (best.distance or math.huge))
                if better then best = entry end
            end
        end
        if best == nil then return false, Errors.NOT_FOUND end
        return true, best
    end

    -- characters whose root has not streamed in are left out: there is nothing to stand next to or aim at
    function entities.players(filter)
        local names = Read.nameSet(filter)
        local list = {}
        for _, player in ipairs(EntityIndex.get(env.ctx).players()) do
            local character = player.Character
            local root = PlayerHelpers.getRootPart(character)
            if root ~= nil and (names == nil or names[player.Name] or names[player.DisplayName]) then
                local humanoid = PlayerHelpers.getHumanoid(character)
                local alive = humanoid ~= nil and humanoid.Health > 0
                if wants(filter, "alive", alive) then
                    list[#list + 1] = {
                        player      = player,
                        name        = player.Name,
                        displayName = player.DisplayName,
                        character   = character,
                        root        = root,
                        humanoid    = humanoid,
                        position    = root.Position,
                        alive       = alive,
                    }
                end
            end
        end
        return true, Read.finish(list, filter, env.origin(filter))
    end

    function entities.mobModels()
        mobWatch.ensure()
        return mobWatch.present()
    end

    function entities.bossModels()
        mobWatch.ensure()
        local beasts = catalog.beasts()
        local out = {}
        for _, model in ipairs(mobWatch.present()) do
            local beast = beastOf(beasts, (Read.stripRespawn(model.Name)))
            if beast ~= nil and beast.boss then out[#out + 1] = model end
        end
        return out
    end

    function entities.npcModels()
        npcWatch.ensure()
        return npcWatch.all()
    end

    function entities.questGiverModels()
        npcWatch.ensure()
        local out = {}
        for _, model in ipairs(npcWatch.all()) do
            if Read.hasTag(model, "QuestNPC") then out[#out + 1] = model end
        end
        return out
    end

    function entities.destroy()
        mobWatch.destroy()
        npcWatch.destroy()
    end

    return entities
end

return M

end)
__bundle_register("Api/World/Catalog", function(require, _LOADED, __bundle_register, __bundle_modules)
-- world catalog: the game's own data modules the index classifies against (bestiary, region rectangles, sell vendors); each is kept once it has been read and a failure is never cached, while the region and vendor tables fall back to the values cited below

local Services = require("Services")
local Read     = require("Api/World/Read")

-- BeastDefinitions.lua:280-311: the two rarest milestone tiers (10 and 20 kills) are the bosses and mini-bosses
local BOSS_MILESTONE = 20

local REGION_SUFFIX = " Region"

-- RegionDefinitions.lua:8-27, only while the module cannot be read
local FALLBACK_AREAS = {
    { name = "Kamo",     minX = -4083.995,  maxX = 3650.495,  minZ = -3023.0352, maxZ = 3838.375 },
    { name = "Mushroom", minX = -1575.9951, maxX = 3773.495,  minZ = -7988.035,  maxZ = -3022.625 },
    { name = "Eldritch", minX = 3650.005,   maxX = 13406.495, minZ = -2867.0352, maxZ = 8735.375 },
}

-- ClientNPCS.Sell.lua:8,46,72,86: the entries whose dialogue offers the "Sell" action
local FALLBACK_SELLERS = { "Aerion", "Glowy", "Gracia", "Lance" }

local PATHS = {
    beasts  = { "Modules", "BeastDefinitions" },
    regions = { "Modules", "MapService", "RegionDefinitions" },
    sellers = { "Modules", "ClientNPCS", "Sell" },
}

local function buildBeasts(data)
    local byModel, names = {}, {}
    for key, def in pairs(data) do
        if type(def) == "table" and type(def.ModelName) == "string" then
            local displayName = Read.text(def.DisplayName) or tostring(key)
            local milestone = tonumber(def.MilestoneKills)
            local modelName = Read.stripRespawn(def.ModelName)
            byModel[modelName] = {
                key            = key,
                displayName    = displayName,
                milestoneKills = milestone,
                boss           = (milestone ~= nil and milestone <= BOSS_MILESTONE) or def.ChestRolls ~= nil,
            }
            names[#names + 1] = displayName
        end
    end
    if #names == 0 then return nil end
    return { byModel = byModel, names = names }
end

-- MapService.lua:203-226 reads the same corners into XZ rectangles
local function buildAreas(data)
    local out = {}
    for _, area in ipairs(type(data.Areas) == "table" and data.Areas or {}) do
        local a, b = area.Corner1, area.Corner2
        if type(area.Name) == "string" and typeof(a) == "Vector3" and typeof(b) == "Vector3" then
            local name = area.Name
            if string.sub(name, -#REGION_SUFFIX) == REGION_SUFFIX then name = string.sub(name, 1, -#REGION_SUFFIX - 1) end
            out[#out + 1] = {
                name = name,
                minX = math.min(a.X, b.X), maxX = math.max(a.X, b.X),
                minZ = math.min(a.Z, b.Z), maxZ = math.max(a.Z, b.Z),
            }
        end
    end
    if #out == 0 then return nil end
    return out
end

local function offersSell(def)
    if type(def) ~= "table" or type(def.nodes) ~= "table" then return false end
    for _, node in pairs(def.nodes) do
        if type(node) == "table" and type(node.choices) == "table" then
            for _, choice in ipairs(node.choices) do
                if type(choice) == "table" and choice.action == "Sell" then return true end
            end
        end
    end
    return false
end

local function buildSellers(data)
    local out = {}
    for name, def in pairs(data) do
        if type(name) == "string" and offersSell(def) then out[#out + 1] = name end
    end
    if #out == 0 then return nil end
    table.sort(out)
    return out
end

local M = {}

function M.new(report)
    local catalog = {}
    local kept = {}
    local failures = {}

    local function fail(key, message)
        if failures[key] == message then return end
        failures[key] = message
        report("%s could not be read: %s", key, message)
    end

    -- pure data modules, so the executor's require hands back the table the game already holds
    local function read(key, build)
        if kept[key] ~= nil then return kept[key] end
        local inst = Read.walk(Services.ReplicatedStorage, PATHS[key])
        if inst == nil or not inst:IsA("ModuleScript") then return nil end
        local okRequire, data = pcall(require, inst)
        if not okRequire or type(data) ~= "table" then
            fail(key, okRequire and ("returned a " .. type(data)) or tostring(data))
            return nil
        end
        local okBuild, built = pcall(build, data)
        if not okBuild or built == nil then
            fail(key, okBuild and "it held nothing usable" or tostring(built))
            return nil
        end
        kept[key] = built
        return built
    end

    -- nil until the bestiary can be read: mobs then keep their own names and nothing counts as a boss
    function catalog.beasts()
        return read("beasts", buildBeasts)
    end

    function catalog.areas()
        return read("regions", buildAreas) or FALLBACK_AREAS
    end

    function catalog.sellers()
        return read("sellers", buildSellers) or FALLBACK_SELLERS
    end

    return catalog
end

return M

end)
