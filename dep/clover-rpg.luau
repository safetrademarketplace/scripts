    function self:_recomputeBootTarget()
        if not self.bootPhase then return end
        local stepRatio = math.min((self.bootAdvance or 0) / self.bootExpectedSteps, 1)
        local elapsed   = tick() - (self.bootStartTime or tick())
        local timeRatio = math.min(elapsed / self.bootMinSeconds, 1)
        local progress  = math.min(stepRatio, timeRatio) * 0.95
        if progress > (self.target or 0) then
            self.target = progress
        end
    end

    function self:_startLoop()
