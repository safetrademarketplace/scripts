    end

    local function wanted()
        if whenHurt then return { "speed", "dash" } end
        return { "speed" }
    end

    local function restore()
        if slows.restore() + hurt.restore() > 0 then refresh() end
    end

    local patch = RespawnPatch.new({
        name       = "CloverNoSlowdown",
        References = References,
        apply      = apply,
        wanted     = wanted,
        restore    = restore,
    })

    group:AddToggle("CloverNoSlowdown", {
        Text            = "No Slowdown",
        Default         = false,
        Tooltip         = "Getting hit, stunned or swinging won't slow you down or stop you jumping. Things that fully stop you, like being knocked down or frozen, still work.",
        Disabled        = not supported,
        DisabledTooltip = UNSUPPORTED,
        Callback        = function(on)
            patch.set(on and supported)
        end,
    })

    local hurtBox = group:AddDependencyBox()
    hurtBox:AddToggle("CloverNoSlowdownWhenHurt", {
        Text            = "Also When Hurt",
        Default         = false,
        Tooltip         = "You won't slow down when your health is low, and your rolls stay full speed when you're hurt or in the air. The low health heartbeat and limp won't play while this is on.",
        Disabled        = not supported,
        DisabledTooltip = UNSUPPORTED,
        Callback        = function(on)
            on = on == true and supported
            if on == whenHurt then return end
            whenHurt = on
            if on then
                patch.reapply()
            elseif hurt.restore() > 0 then
                refresh()
            end
        end,
    })
    hurtBox:SetupDependencies({
        { Toggles.CloverNoSlowdown, true },
    })

    return { cleanup = patch.destroy }
end

end)
__bundle_register("Features/Clover/PlayerUtils/RespawnPatch", function(require, _LOADED, __bundle_register, __bundle_modules)
-- respawn patch: runs a feature's live-table patch at once and again after every spawn until every kind the new character must give is patched, then hands every write back on stop; what counts as found is the feature's call, since an old character's tables can linger in memory
local Jobs = require("Utility/Jobs")
local Log  = require("Utility/Log")

-- a new character's scripts build their tables once they run, so look this many times this far apart
local RESCAN_TRIES    = 20
local RESCAN_INTERVAL = 0.5

local M = {}

-- spec: name, References, apply() -> kind -> found this pass, wanted() -> kinds each character must give, restore()
function M.new(spec)
    local active  = false
    local scanJob = nil
    -- kinds found since the last spawn, so a later look only waits for what is still missing
    local found   = {}

    local function cancelScan()
        if scanJob then
            scanJob:Cancel()
            scanJob = nil
        end
    end

    local function missing()
        local out = {}
        for _, kind in ipairs(spec.wanted()) do
            if not found[kind] then out[kind] = true end
        end
        return out
    end

    -- true once nothing this character must give is still missing
    local function apply()
        for kind, ok in pairs(spec.apply()) do
            if ok then found[kind] = true end
        end
        return next(missing()) == nil
    end

    local function scan()
        cancelScan()
        if next(missing()) == nil then return end
        scanJob = Jobs.spawn(function(job)
            for _ = 1, RESCAN_TRIES do
                if not job:sleep(RESCAN_INTERVAL) then return end
                if apply() then
                    scanJob = nil
                    return
                end
            end
            scanJob = nil
            Log.devwarn("CloverUtils", "%s gave up waiting for the character's tables", spec.name)
        end, { name = spec.name .. ".rescan" })
    end

    local function onSpawn()
        if not active then return end
        found = {}
        scan()
    end

    local api = {}

    function api.set(on)
        on = on == true
        if on == active then return end
        active = on
        if on then
            found = {}
            if not apply() then scan() end
            return
        end
        cancelScan()
        found = {}
        spec.restore()
    end

    -- for an option that widens what is patched while on: patch now, and keep looking for anything new it wants
    function api.reapply()
        if not active then return end
        if not apply() then scan() end
    end

    -- fires at once for the current character, a no-op while off
    local unsubscribe = spec.References.onCharacter(onSpawn)

    function api.destroy()
        unsubscribe()
        api.set(false)
    end

    return api
end

return M

end)
