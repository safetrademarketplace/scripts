        local hum = References.humanoid
        if not hum then return end
        cacheSpeedBaseline(hum)
        applySpeed()
        speedPropConn = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
            if speedEnabled then applySpeed() end
        end)
    end

    local function startSpeed()
        if speedEnabled then return end
        speedEnabled = true
        Library:Notify("Speed enabled.", 2)
        bindHumanoid()
