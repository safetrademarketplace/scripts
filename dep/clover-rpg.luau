    local References = ctx.References

    local getgc     = Executor.get("getgc")
    local supported = type(getgc) == "function"

    local active = false
    local writes = TablePatch.new()

    -- a wrapper left behind by a restore that could not land still steps aside once this is off
    local function wrap(original)
        return function(self, ...)
            if active and inAir(self) then return self:StartAirDash(...) end
            return original(self, ...)
        end
    end

    local lookup = {
        section    = "CloverUtils",
        getgc      = getgc,
        isreadonly = Executor.get("isreadonly"),
        matches    = isDashClass,
        patched    = function(t) return writes.wrote(t, "StartGroundDash") end,
        patch      = function(t) writes.write(t, "StartGroundDash", wrap(rawget(t, "StartGroundDash"))) end,
    }

    local patch = RespawnPatch.new({
        name       = "CloverAirDash",
        References = References,
        apply      = function()
            return { dash = LiveModules.patchOwn(References.character, "Dash", lookup) }
        end,
        wanted     = function() return WANTED end,
        restore    = writes.restore,
    })

    ctx.CloverGroup:AddToggle("CloverAirDash", {
        Text            = "Air Dash",
        Default         = false,
        Tooltip         = "Rolling while you're in the air does a quick dash toward your mouse instead, even without the Air Dash skill.",
        Disabled        = not supported,
        DisabledTooltip = UNSUPPORTED,
        Callback        = function(on)
            active = on == true and supported
            patch.set(active)
        end,
    })

    return {
        cleanup = function()
            active = false
            patch.destroy()
        end,
    }
end

end)
