            out[#out + 1] = { name = beast.displayName, model = model, boss = beast.boss == true }
        end
        table.sort(out, function(a, b) return a.name < b.name end)
        return true, out
    end)

    -- (true, list) of the region rectangles (RegionDefinitions): { name, minX, maxX, minZ, maxZ }
    expose("regions", nil, function()
        local out = {}
        for i, area in ipairs(env.catalog.areas()) do
            out[i] = { name = area.name, minX = area.minX, maxX = area.maxX, minZ = area.minZ, maxZ = area.maxZ }
        end
        return true, out
    end)

    -- (true, list) of where a boss has been seen, newest first: { position, seenAt (os.time) }; asking starts the mob index, so sightings are learned from then on
    expose("bossSpots", function(name) return type(name) ~= "string" or name == "" end, function(name)
        base.safe("watch mobs", entities.watchMobs)
        local out = {}
        for _, spot in ipairs(type(sightings[name]) == "table" and sightings[name] or {}) do
            if type(spot) == "table" and type(spot[1]) == "number" and type(spot[2]) == "number" and type(spot[3]) == "number" then
                out[#out + 1] = { position = Vector3.new(spot[1], spot[2], spot[3]), seenAt = spot[4] }
            end
        end
        return true, out
    end)

    expose("waypoints", nil, places.waypoints)
    expose("shrines", nil, places.shrines)
    expose("spawns", nil, places.spawns)
    expose("areas", nil, places.areas)
    expose("pois", nil, places.pois)
    expose("locations", nil, places.locations)
    expose("locationAt", function(point) return not isVector(point) end, places.locationAt)
    expose("regionAt", function(point) return not isVector(point) end, places.regionAt)
    expose("doors", badFilter(Places.DOOR_FILTER), places.doors)

    expose("shops", nil, interactables.shops)
    expose("bankers", nil, interactables.bankers)
    expose("trainers", nil, interactables.trainers)
    expose("cauldrons", nil, interactables.cauldrons)
    expose("sellers", nil, interactables.sellers)
    expose("prompts", function(name, at, radius)
        return type(name) ~= "string" or name == "" or not isVector(at)
            or type(radius) ~= "number" or radius ~= radius or radius <= 0
    end, interactables.prompts)

    local ESP_MODELS = {
        mobs        = entities.mobModels,
        bosses      = entities.bossModels,
        npcs        = entities.npcModels,
        questGivers = entities.questGiverModels,
        waypoints   = places.waypointModels,
        shrines     = places.shrineModels,
        shops       = interactables.shopModels,
        pois        = places.poiModels,
    }
    local espSources = {}

    -- rows shaped exactly as core/Api/Esp/Groups.lua sources return them; empty once unloaded or on any failure
    local function espSource(kind)
        if espSources[kind] ~= nil then return espSources[kind] end
        local models = ESP_MODELS[kind]
        local label = "World.esp " .. kind
        local lastError
        local function source()
            if closed then return {} end
            local ok, list = pcall(models)
            if not ok then
                if tostring(list) ~= lastError then
                    lastError = tostring(list)
                    base.warn("%s threw: %s", label, lastError)
                end
                return {}
            end
            local out = {}
            for i, model in ipairs(list) do out[i] = { instance = model, kind = ESP_KIND } end
            return out
        end
        espSources[kind] = source
        return source
    end

    expose("espSource", function(kind)
        return type(kind) ~= "string" or ESP_MODELS[kind] == nil
    end, function(kind)
        return true, espSource(kind)
    end)

    -- Connect alone, dot or colon, with a handle a maid takes as-is; connecting is what starts the mob index
    local function listenable(signal)
        local facade = {}
        function facade.Connect(a, b)
            local fn = b
            if type(a) == "function" then fn = a end
            if type(fn) ~= "function" or closed then return { Disconnect = noop, Destroy = noop } end
            local inner = signal:Connect(fn)
            local function disconnect() inner:Disconnect() end
            base.safe("watch mobs", entities.watchMobs)
            return { Disconnect = disconnect, Destroy = disconnect }
        end
        return facade
    end

    api.onMobAdded   = listenable(addedSignal)
    api.onMobRemoved = listenable(removedSignal)

    if base.maid then
        base.maid:GiveTask(function()
            closed = true
            entities.destroy()
            places.destroy()
            interactables.destroy()
        end)
    end

    return api
end

return M

end)
__bundle_register("Api/World/Places", function(require, _LOADED, __bundle_register, __bundle_modules)
-- world places: travel points and map zones — waypoint gates, respawn shrines, inn spawns, named areas, points of interest, doors, the _Locations zones with the game's own which-zone-am-i rule, and the three region rectangles

local Services   = require("Services")
local References = require("References")
local Maid       = require("Utility/Maid")
local Errors     = require("Api/World/Errors")
local Members    = require("Api/World/Members")
local Read       = require("Api/World/Read")

local Workspace         = Services.Workspace
local CollectionService = Services.CollectionService
local ReplicatedStorage = Services.ReplicatedStorage

local SHRINES = { "Map", "Structures", "Shrines" }
local SPAWNS  = { "Effects", "Spawns" }
local AREAS   = { "Map", "Areas" }

-- Basic.lua:56, what RespawnClient.lua:223 falls back to
local SHRINE_RANGE = 700

-- RespawnClient.lua:85-90: the inn each TrueSpawn key respawns at
local INNS = { Default = "Kamo Inn", Eldritch = "Eldritch Inn", DOT = "Beams Inn", Mushroom = "Mushroom Inn" }

local POI_ROOT  = "PointsOfInterest (POI)"
local POI_DEPTH = 8

-- verified live in Kamo Village: a door is a Model named Door whose direct TouchDetection part makes the server swing its DoorPart open
local DOOR       = "Door"
local DOOR_TOUCH = "TouchDetection"
local DOOR_PANEL = "DoorPart"

local M = {}

M.DOOR_FILTER = { origin = "vector", maxDistance = "distance", limit = "count" }

-- RespawnClient.lua:93-99: an "_"-separated list of location names the shrine serves
local function regionList(text)
    if text == nil then return nil end
    local out = {}
    for piece in string.gmatch(text, "[^_]+") do out[#out + 1] = piece end
    return out
end

local function modelEntry(model)
    local root = model.PrimaryPart
    return {
        model    = model,
        name     = model.Name,
        root     = root,
        streamed = root ~= nil,
        position = root and root.Position or Read.position(model),
    }
end

-- bounding-box centre of every BasePart that has streamed in, or nil when none has
local function centreOf(area)
    local minX, minY, minZ, maxX, maxY, maxZ
    local function add(p)
        if minX == nil then
            minX, minY, minZ, maxX, maxY, maxZ = p.X, p.Y, p.Z, p.X, p.Y, p.Z
            return
        end
        minX, minY, minZ = math.min(minX, p.X), math.min(minY, p.Y), math.min(minZ, p.Z)
        maxX, maxY, maxZ = math.max(maxX, p.X), math.max(maxY, p.Y), math.max(maxZ, p.Z)
    end
    if area:IsA("BasePart") then add(area.Position) end
    for _, inst in ipairs(area:GetDescendants()) do
        if inst:IsA("BasePart") then add(inst.Position) end
    end
    if minX == nil then return nil end
    return Vector3.new((minX + maxX) / 2, (minY + maxY) / 2, (minZ + maxZ) / 2)
end

-- POIClient.lua:14-28: the billboard's Main.header carries the name the game shows
local function poiName(inst)
    local board = inst:FindFirstChildWhichIsA("BillboardGui")
    local main = board and board:FindFirstChild("Main")
    local header = main and main:FindFirstChild("header")
    if header ~= nil and header:IsA("TextLabel") then return Read.text(header.Text) end
    return nil
end

-- the folder right under the POI root (Kamo, Eldritch, Misc. …)
local function poiCategory(inst)
    local node = inst.Parent
    for _ = 1, POI_DEPTH do
        if node == nil then return nil end
        local parent = node.Parent
        if parent ~= nil and parent.Name == POI_ROOT then return node.Name end
        node = parent
    end
    return nil
end

-- LocationClient.lua:751-761: a CFrame keeps its rotation, a Vector3 is degrees
local function orientation(value)
    if typeof(value) == "CFrame" then return value.Rotation end
    if typeof(value) == "Vector3" then
        return CFrame.fromOrientation(math.rad(value.X), math.rad(value.Y), math.rad(value.Z))
    end
    return CFrame.identity
end

-- LocationClient.lua:763-830: a zone is a Folder with Position and Size, an oriented box ranked by Subsidiary
local function readZone(folder)
    local position, size = folder:GetAttribute("Position"), folder:GetAttribute("Size")
    if typeof(position) ~= "Vector3" or typeof(size) ~= "Vector3" then return nil end
    return {
        name        = folder.Name,
        displayName = Read.text(folder:GetAttribute("DisplayName")) or folder.Name,
        position    = position,
        size        = size,
        priority    = tonumber(folder:GetAttribute("Subsidiary")) or 0,
        environment = Read.text(folder:GetAttribute("Environment")),
        noFlight    = folder:GetAttribute("NOFLIGHT") == true,
        mapLocation = folder:GetAttribute("MapLocation") == true,
        cframe      = CFrame.new(position) * orientation(folder:GetAttribute("Orientation")),
        half        = size / 2,
    }
end

-- RegionManager.lua:13-28
local function inside(zone, point)
    local rel = zone.cframe:PointToObjectSpace(point)
    return math.abs(rel.X) <= zone.half.X and math.abs(rel.Y) <= zone.half.Y and math.abs(rel.Z) <= zone.half.Z
end

-- env: catalog, safe, origin(filter), location() -> the zone the game shows now, stat(name)
function M.new(env)
    local places = {}
    local centres = {}
    local zoneLinks = Maid.new()
    local zoneRoot, zoneCache = nil, nil

    -- every Door anywhere under Map: one sweep on first use, then its descendant signals; a door counts while its TouchDetection is streamed in
    local doorWatch = Members.new({
        label   = "doors",
        resolve = function() return Workspace:FindFirstChild("Map") end,
        mode    = "descendants",
        accept  = function(inst) return inst.Name == DOOR and inst:IsA("Model") end,
        part    = DOOR_TOUCH,
        safe    = env.safe,
    })

    -- the zone tree grows at runtime (Locations.lua:51-61), so any add or remove drops the cache
    local function zones()
        local root = ReplicatedStorage:FindFirstChild("_Locations")
        if root == nil then return nil end
        if root ~= zoneRoot then
            zoneLinks:DoCleaning()
            zoneRoot, zoneCache = root, nil
            local function stale() zoneCache = nil end
            zoneLinks:GiveTask(root.DescendantAdded:Connect(stale))
            zoneLinks:GiveTask(root.DescendantRemoving:Connect(stale))
        end
        if zoneCache == nil then
            local list = {}
            for _, inst in ipairs(root:GetDescendants()) do
                if inst:IsA("Folder") then
                    local zone = readZone(inst)
                    if zone ~= nil then list[#list + 1] = zone end
