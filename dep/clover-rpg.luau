        local Movement = api("Movement")
        if Movement and r.token then pcall(Movement.release, r.token) end
        r.token = nil
        local Combat = api("Combat")
        if Combat and r.aimed then pcall(Combat.clearAim) end
        -- a block the fight was holding is let go with the farm
        if Combat then pcall(Combat.block, false) end
