    end

    local function absorb(s, data)
        if type(data.Momentum) == "number" then s.momentum = data.Momentum end
        if type(data.Health) == "number" then s.health = data.Health end
    end

    -- mining's Close carries no outcome, so an emptied health bar is what reads as mined
    local function closeOutcome(s, data)
