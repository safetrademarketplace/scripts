local BAG_SEARCH = 25

local M = {}

local function newStats()
    return {
        startedAt = nil, kills = 0, gathered = 0, deaths = 0, items = {}, executes = 0, parries = 0, races = 0, lastRace = nil,
        quests = 0, lastQuest = nil, bosses = 0, lastBoss = nil, looted = 0, recovered = 0, sold = 0, marks = 0,
    }
end

function M.new(deps)
    local engine = { stats = newStats() }
    local settings = deps.settings
    -- the orchestrator's tracker, so a farm's job is torn down with the menu whatever state it is in
    local track = deps.track or function(handle) return handle end
    local run = nil

    local function api(name)
        local found = deps.Api and deps.Api[name]
        if type(found) == "table" then return found end
        return nil
    end

    local function changed()
        if deps.onChange then pcall(deps.onChange) end
    end

    function engine.running()
        return run and run.name or nil
    end

    function engine.status()
        return run and run.status or nil
    end

    function engine.resetStats()
