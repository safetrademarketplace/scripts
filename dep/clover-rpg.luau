    local Options      = ctx.Options
    local Toggles      = ctx.Toggles
    local VisualsGroup = ctx.VisualsGroup

    VisualsGroup:AddToggle("Fullbright", {
        Text    = "Fullbright",
        Default = false,
        Tooltip = "Keeps the world in bright daylight with no fog or haze, wherever you go.",
    })

    local FullbrightBox = VisualsGroup:AddDependencyBox()

    FullbrightBox:AddDropdown("Fullbright_Mode", {
        Text    = "Lighting Mode",
        Default = 1,
        Values  = { "Passive", "Aggressive" },
        Tooltip = "Passive: daylight that keeps shadows.\nAggressive: even brighter, with no shadows at all.",
    })

    FullbrightBox:AddSlider("Fullbright_Brightness", {
        Text     = "Brightness",
        Default  = 2,
        Min      = 0.01,
        Max      = 5,
        Rounding = 3,
    })

    FullbrightBox:SetupDependencies({
        { Toggles.Fullbright, true },
    })

