        beat:Disconnect()
        beat = nil
    end

    -- the release goes out only when asked: a press that ended with its character died with the game's own script too
    local function finish(sendRelease)
        local p = press
        press = nil
        stopBeat()
        if p ~= nil and sendRelease then deps.send(END_BLOCK) end
    end

    local function step()
        local p = press
        if p == nil or closed then
            stopBeat()
            return
        end
        if not deps.alive(p.char) then
            finish(false)
            return
        end
        local now = os.clock()
        if p.fresh then
            -- a press that had to let go of a held block starts here, a frame after its release
            p.fresh = false
            if p.window then p.untilAt = now + p.window end
        elseif p.untilAt ~= nil and now >= p.untilAt then
            finish(true)
            return
        end
        local ok, fatal = deps.send(BLOCK_INPUT)
        if not ok and fatal then finish(false) end
    end

