        if parsed == nil then return false, Errors.BAD_ARGS end
        if parsed.origin == nil then
            parsed.origin = characterPosition()
            if parsed.origin == nil then return false, Errors.FAILED, "no character to measure from" end
        end
        parsed.limit = 1
        local found = nodes.list(parsed, serverNow())[1]
        if found == nil then return false, Errors.NONE end
