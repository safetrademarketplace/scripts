__bundle_register("Utility/Helpers/VMath", function(require, _LOADED, __bundle_register, __bundle_modules)
-- squared-distance helpers; the hottest per-entity-per-frame math across esp/aimbot/instakill, native-speed in the unobfuscated half

local M = {}

M.distanceSqr3 = function(a, b)
    local dx = a.X - b.X
    local dy = a.Y - b.Y
    local dz = a.Z - b.Z
    return dx * dx + dy * dy + dz * dz
end

M.distanceSqr2 = function(a, b)
    local dx = a.X - b.X
    local dz = a.Z - b.Z
    return dx * dx + dz * dz
end

return M

end)
__bundle_register("Features/Visuals/Visuals/NoFog", function(require, _LOADED, __bundle_register, __bundle_modules)
-- no-fog sub-module of visuals: kills fog/atmosphere/clouds/post-fx and reapplies on property changes so per-frame lighting rewrites can't undo it
return function(ctx)
    local Services     = ctx.Services
    local Toggles      = ctx.Toggles
    local VisualsGroup = ctx.VisualsGroup

    VisualsGroup:AddToggle("NoFog", {
        Text = "No Fog",
        Default = false,
        Tooltip = "Disables fog, atmosphere, clouds, and post-processing effects that obscure vision.",
    })

    local saved, conns, applying = nil, {}, false

    local function pushConn(c) conns[#conns + 1] = c; return c end

    local function clearConns()
        for i = 1, #conns do
            pcall(function() conns[i]:Disconnect() end)
        end
        conns = {}
    end

    local function applyFogProps()
        applying = true
        Services.Lighting.FogEnd = 1e10
        Services.Lighting.FogStart = 1e10
        applying = false
    end

    local function suppressAtmosphere(inst)
        if not saved then return end
        if not saved.Atmo[inst] then
            saved.Atmo[inst] = { D = inst.Density, H = inst.Haze, G = inst.Glare }
        end
        inst.Density, inst.Haze, inst.Glare = 0, 0, 0
    end

    local function suppressClouds(inst)
        if not saved then return end
        if not saved.Clouds[inst] then
            saved.Clouds[inst] = { Cover = inst.Cover, Density = inst.Density }
        end
        inst.Cover, inst.Density = 0, 0
    end

    local function suppressPostEffect(inst)
        if inst:IsA("BloomEffect") or inst:IsA("SunRaysEffect")
            or inst:IsA("DepthOfFieldEffect") or inst:IsA("ColorCorrectionEffect")
            or inst:IsA("BlurEffect") then
            if inst.Enabled then
                inst:SetAttribute("NFWasEnabled", true)
                inst.Enabled = false
            end
            return true
        end
        return false
    end

    local function handleLightingDescendant(inst)
        if suppressPostEffect(inst) then return end
        if inst:IsA("Atmosphere") then
            suppressAtmosphere(inst)
            pushConn(inst:GetPropertyChangedSignal("Density"):Connect(function()
                if saved and inst.Density > 0 then suppressAtmosphere(inst) end
            end))
            pushConn(inst:GetPropertyChangedSignal("Haze"):Connect(function()
                if saved and inst.Haze > 0 then suppressAtmosphere(inst) end
            end))
        end
    end

    local function nfOn()
        if saved then return end
        saved = {
            FogEnd   = Services.Lighting.FogEnd,
            FogStart = Services.Lighting.FogStart,
            FogColor = Services.Lighting.FogColor,
            Atmo     = {},
            Clouds   = {},
        }

        applyFogProps()
        for _, d in ipairs(Services.Lighting:GetDescendants()) do
            handleLightingDescendant(d)
        end

        pushConn(Services.Lighting:GetPropertyChangedSignal("FogEnd"):Connect(function()
            if saved and not applying and Services.Lighting.FogEnd < 1e9 then applyFogProps() end
        end))
        pushConn(Services.Lighting:GetPropertyChangedSignal("FogStart"):Connect(function()
            if saved and not applying and Services.Lighting.FogStart < 1e9 then applyFogProps() end
        end))
        pushConn(Services.Lighting.DescendantAdded:Connect(handleLightingDescendant))

        local terrain = Services.Workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            for _, c in ipairs(terrain:GetChildren()) do
                if c:IsA("Clouds") then suppressClouds(c) end
            end
            pushConn(terrain.ChildAdded:Connect(function(c)
                if c:IsA("Clouds") then suppressClouds(c) end
            end))
        end
    end

    local function nfOff()
        if not saved then return end
        clearConns()
        applying = true
        Services.Lighting.FogEnd   = saved.FogEnd
        Services.Lighting.FogStart = saved.FogStart
        Services.Lighting.FogColor = saved.FogColor
        applying = false
        for _, d in ipairs(Services.Lighting:GetDescendants()) do
            if d:GetAttribute("NFWasEnabled") then
                d:SetAttribute("NFWasEnabled", nil)
                if d.Enabled ~= nil then d.Enabled = true end
            end
        end
        for inst, v in pairs(saved.Atmo) do
            if inst and inst.Parent then
                pcall(function() inst.Density, inst.Haze, inst.Glare = v.D, v.H, v.G end)
            end
        end
        for inst, v in pairs(saved.Clouds) do
            if inst and inst.Parent then
                pcall(function() inst.Cover, inst.Density = v.Cover, v.Density end)
            end
        end
        saved = nil
    end

    Toggles.NoFog:OnChanged(function()
        if Toggles.NoFog.Value then nfOn() else nfOff() end
    end)

    return { cleanup = nfOff }
end

end)
