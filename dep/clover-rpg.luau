__bundle_register("Features/Clover/Gathering", function(require, _LOADED, __bundle_register, __bundle_modules)
-- gathering orchestrator: builds the minigames, resource tracker, professions and tools boxes through UI/Place (the tab file decides where each goes), reads the game only once every box is built, then keeps their lines fresh at a modest pace while the menu is open
local Log       = require("Utility/Log")
local Mount     = require("Utility/Mount")
local Scheduler = require("Utility/Scheduler")
local Place     = require("UI/Place")
local Minigames = require("Features/Clover/Gathering/Minigames")
local Progress  = require("Features/Clover/Gathering/Progress")
local Tools     = require("Features/Clover/Gathering/Tools")
local Tracker   = require("Features/Clover/Gathering/Tracker")

local REFRESH_EVERY = 1

local BOXES = {
    { name = "Minigames",        icon = "gamepad-2", side = "Left",  factory = Minigames },
    { name = "Resource Tracker", icon = "radar",     side = "Left",  factory = Tracker },
    { name = "Professions",      icon = "award",     side = "Right", factory = Progress },
    { name = "Tools",            icon = "pickaxe",   side = "Right", factory = Tools },
}

return function(ctx)
    local O = Mount.orchestrator(ctx, "Gathering")
    if not O then return end

    if not (ctx.Api and type(ctx.Api.Professions) == "table") then
        Log.devwarn("Gathering", "the professions api is missing, so the gathering tab won't load")
        return
    end

    local parts = {}
    for _, spec in ipairs(BOXES) do
        local box = Place.groupbox(ctx, spec.name, spec.icon, { fallback = "Gathering", side = spec.side })
        if box then
            parts[#parts + 1] = { name = spec.name, api = O.mount(spec.factory, O.subCtx({ GatherGroup = box })) }
        end
    end

    -- one box failing never stops the others, and says so once
    local failed = {}
    local function each(method)
        for _, part in ipairs(parts) do
            local fn = part.api[method]
            if type(fn) == "function" then
                local ok, err = pcall(fn)
                if not ok and not failed[part.name] then
                    failed[part.name] = true
                    Log.devwarn("Gathering", "%s %s threw: %s", part.name, method, tostring(err))
                end
            end
        end
    end

    -- a game read between two widget builds drops the identity the next build needs, so every first read waits for all of them
    each("start")

    local Library = ctx.Library
    O.track(Scheduler.heartbeat(function()
        if Library and not Library.Toggled then return end
        each("refresh")
    end, { name = "Gathering.refresh", interval = REFRESH_EVERY, deferrable = true }))

    O.finalize()
end

end)
__bundle_register("Features/Clover/Gathering/Tracker", function(require, _LOADED, __bundle_register, __bundle_modules)
-- resource tracker box: runs the game's own ore and plant tracker at its top tier (outlines through walls, respawn timers, map pins) for every node type, by answering Professions:GetPlayerBenefits with the top tier for your own mining and harvesting only and widening that tier's range and type cap; switching it off puts back exactly what it changed
local Executor = require("Utility/Executor")
local Jobs     = require("Utility/Jobs")
local Log      = require("Utility/Log")
local Ui       = require("Features/Clover/Gathering/Ui")

-- the top tier's own range; raise it to see further (more map pins)
local RANGE = 2000
-- node types one tracker follows at once; the game allows 2
local TYPES = 99
-- TrackerClient.lua:34-58: the fourth tier is the one with outlines, timers and map pins
local TOP_TIER = 4

-- TrackerClient.lua:14-33: each tracker reads its picks from a comma list in a player attribute
local TRACKERS = {
    { attribute = "Tracker_Ore",     kind = "Ore" },
    { attribute = "Tracker_Harvest", kind = "Harvest" },
}
local PROFESSIONS = { Mining = true, Harvesting = true }

-- a respawn can rebuild the tracker gui with a fresh tier list, so look this many times this far apart
local RESCAN_TRIES    = 10
local RESCAN_INTERVAL = 1

local OFF = "Off."

local function assign(t, key, value)
    t[key] = value
end

-- the professions module: GetPlayerBenefits beside GetBenefits, both its own fields
local function isBenefits(t)
    return type(rawget(t, "GetPlayerBenefits")) == "function" and type(rawget(t, "GetBenefits")) == "function"
end

return function(ctx)
    local Professions       = ctx.Api.Professions
    local References        = ctx.References
    local ReplicatedStorage = ctx.Services.ReplicatedStorage
    local group             = ctx.GatherGroup

    local getgc       = Executor.get("getgc")
    local islclosure  = Executor.get("islclosure")
    local isreadonly  = Executor.get("isreadonly")
    local getupvalues = Executor.get("debug.getupvalues") or Executor.get("getupvalues")
    local canWiden    = type(getgc) == "function" and type(getupvalues) == "function"
        and type(debug) == "table" and type(debug.info) == "function"

    local player = References.player
    -- References.player is a cloneref, so the game's own LocalPlayer never compares equal to it; the UserId does
    local myId = player.UserId

    local active = false
    -- module -> { original, wrapper, live }; kept strongly, every one of them must be put back
    local wrapped = {}
    -- top tier table -> what it held before; weak, a tier list whose gui is gone needs nothing back
    local tiers = setmetatable({}, { __mode = "k" })
    -- attribute -> { value = what it held }, only for the ones we filled in
    local filled = {}
    local rescanJob = nil
    local status

    local function isLocal(who)
        return typeof(who) == "Instance" and who:IsA("Player") and who.UserId == myId
    end

    local function wrap(module)
        local original = rawget(module, "GetPlayerBenefits")
        local entry = { original = original, live = true }
        entry.wrapper = function(self, who, profession, ...)
            local benefits = original(self, who, profession, ...)
            if entry.live and PROFESSIONS[profession] and isLocal(who) then
                -- a copy, so the shared benefits table and every other field stay untouched
                local copy = type(benefits) == "table" and table.clone(benefits) or {}
                copy.tracker = TOP_TIER
                return copy
            end
            return benefits
        end
        local ok, err = pcall(assign, module, "GetPlayerBenefits", entry.wrapper)
        if not ok then
            Log.devwarn("Gathering", "the tracker could not wrap a professions module: %s", tostring(err))
            return false
        end
        wrapped[module] = entry
        return true
    end

    local function wrapBenefits()
        local candidates = {}
        if type(getgc) == "function" then
            local ok, objects = pcall(getgc, true)
            if ok and type(objects) == "table" then
                candidates = objects
            else
                Log.devwarn("Gathering", "the tracker could not list live tables: %s", tostring(objects))
            end
        end
        -- the module straight from require too: a heap scan alone can miss it, and a miss is never remembered
        local modules = ReplicatedStorage:FindFirstChild("Modules")
        local instance = modules and modules:FindFirstChild("Professions")
        if instance then
            local ok, module = pcall(require, instance)
            if ok and type(module) == "table" then candidates[#candidates + 1] = module end
        end
        local count = 0
        for _, v in ipairs(candidates) do
            if type(v) == "table" and not wrapped[v] and not (isreadonly and isreadonly(v)) and isBenefits(v) then
                if wrap(v) then count = count + 1 end
            end
        end
        return count
    end

    -- the tier list is a local of TrackerClient's refreshConfig; every generation of it still in memory is widened
    local function widenTiers()
        if not canWiden then return 0 end
        local ok, objects = pcall(getgc, false)
        if not ok or type(objects) ~= "table" then return 0 end
        local count = 0
        for _, f in ipairs(objects) do
            if type(f) == "function" and (not islclosure or islclosure(f)) then
                local okInfo, name, source = pcall(debug.info, f, "ns")
                if okInfo and name == "refreshConfig" and type(source) == "string" and source:find("TrackerClient", 1, true) then
                    local okUp, upvalues = pcall(getupvalues, f)
                    if okUp and type(upvalues) == "table" then
                        for _, up in pairs(upvalues) do
                            local top = type(up) == "table" and rawget(up, TOP_TIER)
                            if type(top) == "table" and rawget(top, "MapMarkers") and not (isreadonly and isreadonly(top)) then
                                if not tiers[top] then tiers[top] = { Range = top.Range, Types = top.Types } end
                                top.Range, top.Types = RANGE, TYPES
                                count = count + 1
                            end
                        end
                    end
                end
            end
        end
        return count
    end

    -- a tracker you have already picked types in is left as you set it
    local function chooseNodes()
        for _, tracker in ipairs(TRACKERS) do
            local current = player:GetAttribute(tracker.attribute)
            if type(current) ~= "string" or current == "" then
                local ok, names = Professions.itemNames(tracker.kind)
                if ok and type(names) == "table" and #names > 0 then
                    if filled[tracker.attribute] == nil then filled[tracker.attribute] = { value = current } end
                    player:SetAttribute(tracker.attribute, table.concat(names, ","))
                end
            end
        end
    end

    -- the tracker re-reads its tier whenever its selection attribute changes, so nudge it
    local function nudge()
        for _, tracker in ipairs(TRACKERS) do
            local current = player:GetAttribute(tracker.attribute)
            if type(current) == "string" and current ~= "" then
                player:SetAttribute(tracker.attribute, current .. " ")
                player:SetAttribute(tracker.attribute, current)
            end
        end
    end

    local function describe(hooked, widened)
        if hooked == 0 and next(wrapped) == nil then
            return "Couldn't find the game's tracker yet. Switch this off and on again once you've fully loaded in."
        end
        if widened > 0 then
            return ("On: your ore and plant trackers follow every type out to %s studs, with outlines, respawn timers and map pins."):format(Ui.commas(RANGE))
        end
        if not canWiden then
            return "On at the top tier. Your executor can't raise how many types it follows, so pick up to 2 of each in the game's tracker."
        end
        return "On at the top tier. The tracker hasn't loaded yet, so it follows 2 types of each for now; it tries again when you respawn."
    end

    local function cancelRescan()
        if rescanJob then
            rescanJob:Cancel()
            rescanJob = nil
        end
    end

    local function start()
        if active then return end
        active = true
        local hooked = wrapBenefits()
        local widened = widenTiers()
        chooseNodes()
        nudge()
        Log.dev("Gathering", "tracker on: %d module(s) wrapped, %d tier list(s) widened", hooked, widened)
        Ui.text(status, describe(hooked, widened))
    end

    local function stop()
        if not active then return end
        active = false
        cancelRescan()
        for module, entry in pairs(wrapped) do
            entry.live = false
            -- a wrapper someone else stacked on top keeps ours beneath it, which now just passes through
            if rawget(module, "GetPlayerBenefits") == entry.wrapper then
                pcall(assign, module, "GetPlayerBenefits", entry.original)
            end
        end
        table.clear(wrapped)
        for top, was in pairs(tiers) do
            top.Range, top.Types = was.Range, was.Types
        end
        table.clear(tiers)
        for attribute, prior in pairs(filled) do
            player:SetAttribute(attribute, prior.value)
        end
        table.clear(filled)
        nudge()
        Ui.text(status, OFF)
    end

    -- the old tier list is still in memory and widens at once, so every try runs to let the rebuilt one be found too
    local function onSpawn()
        if not active then return end
        cancelRescan()
        rescanJob = Jobs.spawn(function(job)
            for _ = 1, RESCAN_TRIES do
                if not job:sleep(RESCAN_INTERVAL) or not active then return end
                local hooked = 0
                if next(wrapped) == nil then hooked = wrapBenefits() end
                local widened = widenTiers()
                if hooked > 0 or widened > 0 then
                    nudge()
                    Ui.text(status, describe(hooked, widened))
                end
            end
        end, { name = "Gathering.tracker.rescan" })
    end

    group:AddToggle("GatherTracker", {
        Text     = "Unlock Full Tracker",
        Default  = false,
        Tooltip  = "Unlocks the game's best ore and plant tracker, with outlines through walls, respawn timers and map pins, and lets it follow every ore and plant type at once.",
        Callback = function(on)
            if on then start() else stop() end
        end,
    })

    status = group:AddLabel({ Text = OFF, DoesWrap = true })

    local unsubscribe = References.onCharacter(onSpawn)

    local function cleanup()
        unsubscribe()
        stop()
    end

    return { cleanup = cleanup }
end

end)
__bundle_register("Features/Clover/Gathering/Tools", function(require, _LOADED, __bundle_register, __bundle_modules)
-- tools box: your best pickaxe and sickle and what they can gather, the nearest node of a chosen resource you can gather, and a go button that glides you there through the movement api; it claims the mover for each trip, gives it back when the trip ends and never takes it from anything else
local Ui = require("Features/Clover/Gathering/Ui")

local OWNER = "Gathering"
local REACH = 5

local KINDS = {
    { kind = "Ore",     tool = "pickaxe", verb = "mine" },
    { kind = "Harvest", tool = "sickle",  verb = "harvest" },
}
local BY_KIND = {}
for _, spec in ipairs(KINDS) do BY_KIND[spec.kind] = spec end

-- what each movement failure means to a player, keyed by the api's own Errors names
local MOVE_LINES = {
    NOT_READY    = "Travel isn't ready yet. Try again in a moment.",
    BAD_ARGS     = "Couldn't work out where that is.",
    NO_CHARACTER = "Your character isn't in the world right now.",
    NOT_OWNER    = "Something else took over moving you, so this trip stopped.",
    BUSY         = "Something else is moving you right now. Stop it first, then try again.",
    NO_PATH      = "Couldn't find a way there from here.",
    BLOCKED      = "The way there is blocked, so the trip stopped.",
    CORRECTED    = "The game kept pulling you back, so the trip stopped.",
    INTERRUPTED  = "The game moved you itself, so the trip stopped.",
    DIED         = "You died, so the trip stopped.",
    RESPAWNED    = "You respawned, so the trip stopped.",
    TIMED_OUT    = "The trip was taking far too long, so it stopped.",
    CANCELLED    = "Trip stopped.",
}
local MOVE_FALLBACK = "Something went wrong on the way."

local PICK = "Pick a resource to find the nearest one you can gather."

return function(ctx)
    local Professions = ctx.Api.Professions
    local Movement    = ctx.Api.Movement
    if type(Movement) ~= "table" then Movement = nil end
    local Library = ctx.Library
    local group   = ctx.GatherGroup

    local items  = {}
    local kindOf = {}
    local powers = {}
    local chosen = nil
    -- the node go would head for, re-read every refresh
    local target = nil
    -- the trip under way: { token, label, trip, done }
    local current = nil
    local toolsLabel, picker, nodeLabel, goButton

    local function explain(code)
        local errors = Movement and Movement.Errors
        if type(errors) == "table" and code ~= nil then
            for name, value in pairs(errors) do
                if value == code then return MOVE_LINES[name] or MOVE_FALLBACK end
            end
        end
        return MOVE_FALLBACK
    end

    local function syncGo()
        if current then
            Ui.caption(goButton, "Stop")
            Ui.disabled(goButton, false)
        else
            Ui.caption(goButton, "Go")
            Ui.disabled(goButton, Movement == nil or target == nil)
        end
    end

    -- both kinds' names in one list; a name is never memoized as missing, the registry may still be replicating
    local function loadItems()
        local list, map = {}, {}
        for _, spec in ipairs(KINDS) do
            local ok, names = Professions.itemNames(spec.kind)
            if ok and type(names) == "table" then
                for _, name in ipairs(names) do
                    if map[name] == nil then
                        map[name] = spec.kind
                        list[#list + 1] = name
                    end
                end
            end
        end
        if #list == 0 then return end
        table.sort(list)
        items, kindOf = list, map
        Ui.values(picker, items)
    end

    local function describeTools()
        local lines = {}
        for _, spec in ipairs(KINDS) do
            local ok, power, toolName = Professions.toolPower(spec.kind)
            if not ok then
                powers[spec.kind] = nil
                lines[#lines + 1] = ("Couldn't check your %s yet."):format(spec.tool)
            elseif (tonumber(power) or 0) <= 0 then
                powers[spec.kind] = 0
                lines[#lines + 1] = ("You don't own a %s yet."):format(spec.tool)
            else
                powers[spec.kind] = power
                lines[#lines + 1] = ("Your %s (%s) can %s nodes up to power %d."):format(
                    spec.tool, Ui.clean(toolName), spec.verb, math.floor(power))
            end
        end
        Ui.text(toolsLabel, table.concat(lines, "\n"))
    end

    local function tripLine()
        local label = Ui.clean(current.label)
        local trip = current.trip
        if trip == nil then return ("Heading to the %s..."):format(label) end
        local ok, status = pcall(trip.status)
        if ok and type(status) == "table" and type(status.distance) == "number" then
            return ("Heading to the %s: %s studs left."):format(label, Ui.commas(status.distance))
        end
        return ("Heading to the %s..."):format(label)
    end

    -- why nothing qualifies: the nearest one is too strong for your tool, or every one nearby is still growing back
    local function missingLine(spec, item, power)
        local okAny, any = Professions.nearestNode({ kind = spec.kind, items = { item }, available = true })
        if okAny then
            return ("%s needs a %s of power %d or more."):format(item, spec.tool, math.floor(tonumber(any.power) or 0))
        end
        local okDown, down = Professions.nearestNode({ kind = spec.kind, items = { item }, available = false, maxPower = power })
        if okDown then
            return ("Every %s you can %s has been gathered. The nearest grows back in %s."):format(item, spec.verb, Ui.duration(down.respawnIn))
        end
        return ("There's no %s you can %s right now."):format(item, spec.verb)
    end

    local function describeNode()
        target = nil
        if current then
            Ui.text(nodeLabel, tripLine())
            syncGo()
            return
        end
        if chosen == nil or kindOf[chosen] == nil then
            Ui.text(nodeLabel, PICK)
            syncGo()
            return
        end
        local spec = BY_KIND[kindOf[chosen]]
        local power = powers[spec.kind]
        local item = Ui.clean(chosen)
        if power == nil then
            Ui.text(nodeLabel, ("Checking your %s..."):format(spec.tool))
            syncGo()
            return
        end
        local ok, node = Professions.nearestNode({ kind = spec.kind, items = { chosen }, available = true, maxPower = power })
        if ok then
            target = node
            Ui.text(nodeLabel, ("Nearest %s you can %s: %s studs away."):format(item, spec.verb, Ui.commas(node.distance)))
        elseif node == Professions.Errors.NONE then
            Ui.text(nodeLabel, missingLine(spec, item, power))
        else
            Ui.text(nodeLabel, "Your character isn't in the world right now.")
        end
        syncGo()
    end

    local function refresh()
        if #items == 0 then loadItems() end
        describeTools()
        describeNode()
    end

    local function finish(trip, arrived, reason)
        if trip.done then return end
        trip.done = true
        if current == trip then current = nil end
        Movement.release(trip.token)
        if arrived then
            Ui.notify(Library, ("You're at the %s."):format(Ui.clean(trip.label)))
        else
            Ui.notify(Library, explain(reason))
        end
        describeNode()
    end

    -- giving the claim back ends the trip; its own cancel report then finds it already done
    local function stop()
        local trip = current
        if trip == nil then return end
        current = nil
        trip.done = true
        Movement.release(trip.token)
    end

    local function go()
        if current then
            stop()
            Ui.notify(Library, MOVE_LINES.CANCELLED)
            describeNode()
            return
        end
        if Movement == nil then
            Ui.notify(Library, MOVE_LINES.NOT_READY)
            return
        end
        describeNode()
        local node = target
        if node == nil then
            Ui.notify(Library, "There's nothing to go to right now.")
            return
        end
        local okClaim, token = Movement.claim(OWNER)
        if not okClaim then
            Ui.notify(Library, explain(token))
            return
        end
        local trip = { token = token, label = node.item, done = false }
        current = trip
        local okMove, handle = Movement.moveTo(node.position, {
            token  = token,
            reach  = REACH,
            onDone = function(arrived, reason) finish(trip, arrived, reason) end,
        })
        if not okMove then
            if current == trip then current = nil end
            trip.done = true
            Movement.release(token)
            Ui.notify(Library, explain(handle))
            describeNode()
            return
        end
        -- a trip can end before moveTo even returns
        if trip.done then return end
        trip.trip = handle
        describeNode()
    end

    toolsLabel = group:AddLabel({ Text = "Checking your tools...", DoesWrap = true })
    picker = group:AddDropdown("GatherNodeItem", {
        Text      = "Resource",
        Values    = {},
        AllowNull = true,
        Tooltip   = "The ore or plant to look for.",
        Callback  = function(value)
            chosen = value
            describeNode()
        end,
    })
    nodeLabel = group:AddLabel({ Text = PICK, DoesWrap = true })
    goButton = group:AddButton("GatherGo", {
        Text            = "Go",
        Func            = go,
        Disabled        = true,
        Tooltip         = "Glides you to the nearest one you can gather. Press it again to stop.",
        DisabledTooltip = "Pick a resource that's up and that your tools can gather.",
    })

    local function cleanup()
        stop()
    end

    return { refresh = refresh, start = refresh, cleanup = cleanup }
end

end)
__bundle_register("Features/Clover/Gathering/Progress", function(require, _LOADED, __bundle_register, __bundle_modules)
-- professions box: every profession's level, xp and rank with whether its rank challenge is ready, plus claiming the total level reward and starting a ready rank challenge (the api plays mining and harvesting challenges through the solver); results read as the game's own lines
local Jobs = require("Utility/Jobs")
local Ui   = require("Features/Clover/Gathering/Ui")

local READY_COLOR = "#86efac"

-- ProfessionClient.lua:719-776: the game's own words for each way a challenge can end
local CHALLENGE_RESULTS = {
    Failed    = "Challenge failed.",
    NotReady  = "Not ready yet: fill your XP bar first.",
    Busy      = "You're already in a challenge.",
    Cancelled = "Challenge cancelled.",
    Idle      = "Challenge timed out.",
    Left      = "Challenge ended.",
    Cooldown  = "That challenge is cooling down. Try again later.",
}

-- what each api failure means to a player, keyed by the api's own Errors names
local FAILURES = {
    BUSY               = "Still waiting on your last request. Give it a moment.",
    TIMEOUT            = "The game didn't answer in time. Try again in a moment.",
    NOT_READY          = "Professions aren't ready yet. Try again in a moment.",
    UNKNOWN_PROFESSION = "You don't have that profession yet.",
}

local IDLE = "Pick a profession whose rank challenge is ready, then start it."

return function(ctx)
    local Professions = ctx.Api.Professions
    local group       = ctx.GatherGroup

    local busy     = false
    local canClaim = false
    local ready    = {}
    local chosen   = nil
    local job      = nil
    local levelsLabel, claimButton, picker, startButton, resultLabel

    local function failureName(code)
        local errors = Professions.Errors
        if type(errors) ~= "table" or code == nil then return nil end
        for name, value in pairs(errors) do
            if value == code then return name end
        end
        return nil
    end

    local function claimLine(ok, result)
        if ok then
            if type(result) == "table" and result.Result == "Claimed" then
                if result.Paid == false then return "Reward claimed. Its Locked Essence was already claimed on another slot." end
                return "Total level reward claimed!"
            end
            return "The game didn't hand the reward over. Try again."
        end
        local name = failureName(result)
        if name == "NONE" then return "There's no total level reward to claim yet." end
        return FAILURES[name] or "Couldn't claim the reward. Try again."
    end

    local function challengeLine(profession, ok, result, detail)
        if ok then
            if type(result) ~= "table" then return "The challenge ended." end
            if result.Result == "Passed" then
                if type(result.Level) == "number" then
                    return ("Passed! Your %s is now level %d."):format(profession, math.floor(result.Level))
                end
                return "Passed!"
            end
            if result.Result == "Race" then
                return ("Head to %s and finish in under %s seconds."):format(Ui.clean(result.Race), Ui.clean(result.TargetTime))
            end
            return CHALLENGE_RESULTS[result.Result] or "The challenge ended."
        end
        local name = failureName(result)
        if name == "NONE" then
            if detail == "cooldown" then return CHALLENGE_RESULTS.Cooldown end
            return "That challenge isn't ready yet: fill its XP bar first."
        end
        if name == "BUSY" then return "A challenge or reward claim is already running. Wait for it to finish." end
        return FAILURES[name] or "Couldn't start the challenge. Try again."
    end

    local function line(profession, entry)
        local parts = { ("<b>%s</b>  Lv %d"):format(Ui.clean(profession), math.floor(tonumber(entry.level) or 0)) }
        if type(entry.rank) == "string" and entry.rank ~= "" then parts[#parts + 1] = Ui.clean(entry.rank) end
        if type(entry.xp) == "number" and type(entry.maxXp) == "number" then
            parts[#parts + 1] = ("%s / %s XP"):format(Ui.commas(entry.xp), Ui.commas(entry.maxXp))
        end
        if entry.challengeReady then
            parts[#parts + 1] = ('<font color="%s">rank challenge ready</font>'):format(READY_COLOR)
        elseif (tonumber(entry.challengeCooldown) or 0) > 0 then
            parts[#parts + 1] = "challenge in " .. Ui.duration(entry.challengeCooldown)
        end
        return table.concat(parts, " · ")
    end

    local function syncButtons()
        Ui.disabled(claimButton, busy or not canClaim)
        Ui.disabled(startButton, busy or chosen == nil or not ready[chosen])
    end

    local function refresh()
        local ok, levels = Professions.levels()
        local readyList = {}
        if not ok or type(levels) ~= "table" then
            Ui.text(levelsLabel, "Your professions haven't loaded yet.")
        else
            local names = {}
            for name in pairs(levels) do names[#names + 1] = name end
            table.sort(names)
            local lines = {}
            for _, name in ipairs(names) do
                local entry = levels[name]
                lines[#lines + 1] = line(name, entry)
                if entry.challengeReady then readyList[#readyList + 1] = name end
            end
            if #lines == 0 then
                Ui.text(levelsLabel, "You haven't started any professions yet.")
            else
                Ui.text(levelsLabel, table.concat(lines, "\n"))
            end
        end

        ready = {}
        for _, name in ipairs(readyList) do ready[name] = true end
        local okClaim, claimable = Professions.canClaimTotal()
        canClaim = okClaim == true and claimable == true

        Ui.values(picker, readyList)
        -- a pick that is no longer ready gives way to the first one that is, so the button is usable at once
        if (chosen == nil or not ready[chosen]) and chosen ~= readyList[1] then
            Ui.set(picker, readyList[1])
        end
        syncButtons()
    end

    -- both remotes stay open while the server works (a gather challenge for the whole minigame), so they run on their own job
    local function run(name, opening, body)
        if busy then return end
        busy = true
        syncButtons()
        Ui.text(resultLabel, opening)
        job = Jobs.spawn(function()
            local text = body()
            busy = false
            Ui.text(resultLabel, text)
            refresh()
        end, { name = name })
    end

    local function claim()
        run("Gathering.claimTotal", "Claiming your total level reward...", function()
            local ok, result = Professions.claimTotal()
            return claimLine(ok, result)
        end)
    end

    local function startChallenge()
        local profession = chosen
        if profession == nil or not ready[profession] then
            Ui.text(resultLabel, IDLE)
            return
        end
        run("Gathering.challenge", ("Your %s rank challenge is running..."):format(Ui.clean(profession)), function()
            local ok, result, detail = Professions.challenge(profession)
            return challengeLine(profession, ok, result, detail)
        end)
    end

    levelsLabel = group:AddLabel({ Text = "Loading your professions...", DoesWrap = true })
    claimButton = group:AddButton("GatherClaimTotal", {
        Text            = "Claim Total Level Rewards",
        Func            = claim,
        Disabled        = true,
        Tooltip         = "Collects the reward for reaching the next total of all your profession levels added up.",
        DisabledTooltip = "Level your professions up further to reach the next total level reward.",
    })
    picker = group:AddDropdown("GatherChallengeProfession", {
        Text      = "Ready Rank Challenge",
        Values    = {},
        AllowNull = true,
        Tooltip   = "Your professions whose rank challenge you can start right now.",
        Callback  = function(value)
            chosen = value
            syncButtons()
        end,
    })
    startButton = group:AddButton("GatherStartChallenge", {
        Text            = "Start Rank Challenge",
        Func            = startChallenge,
        Disabled        = true,
        Tooltip         = "Starts the chosen profession's rank challenge. Mining and harvesting challenges are played for you.",
        DisabledTooltip = "None of your professions has a rank challenge ready.",
    })
    resultLabel = group:AddLabel({ Text = IDLE, DoesWrap = true })

    local function cleanup()
        if job then
            job:Cancel()
            job = nil
        end
    end

    return { refresh = refresh, start = refresh, cleanup = cleanup }
end

end)
__bundle_register("Features/Clover/Gathering/Minigames", function(require, _LOADED, __bundle_register, __bundle_modules)
-- minigames box: switches the professions solver on for mining, harvesting or both, so it answers those minigames however they were started (by hand too), sets how often it goes for a perfect hit, and narrates the minigame it is playing
local Ui = require("Features/Clover/Gathering/Ui")

local DEFAULT_CHANCE = 85

local NAMES = { Mining = "Mining", Harvesting = "Harvesting" }
local VERBS = { Mining = "mining", Harvesting = "harvesting" }

local RESULTS = { Critical = "perfect hit", Hit = "hit", Miss = "miss", Void = "no hit" }

local OFF = "Off."

return function(ctx)
    local solver = ctx.Api.Professions.solver
    local group  = ctx.GatherGroup

    local want    = { on = false, mining = true, harvesting = true }
    local chance  = DEFAULT_CHANCE
    -- whether our switch last turned the solver on, so turning off never touches a solver someone else runs
    local running = false
    local status, master

    local function waitingLine()
        if want.mining and want.harvesting then return "Waiting for you to start mining or harvesting." end
        if want.mining then return "Waiting for you to start mining." end
        return "Waiting for you to start harvesting."
    end

    local function subject(view)
        local name = NAMES[view.kind] or "Gathering"
        if type(view.title) == "string" and view.title ~= "" then return name .. " " .. Ui.clean(view.title) end
        return name
    end

    local function playingLine(view)
        local line = subject(view)
        local last = RESULTS[view.lastResult]
        if last then
            line = ("%s · round %d · last: %s"):format(line, math.floor(tonumber(view.rounds) or 0), last)
        else
            line = line .. " · starting"
        end
        -- the game's own handler could not be set aside, so nothing answers this one for you
        if view.mode == "watch" then line = line .. " · your executor can't play this one, so it's up to you" end
        return line
    end

    local function closedLine(view)
        local verb = VERBS[view.kind] or "gathering"
        local what = subject(view)
        local outcome = view.outcome
        if outcome == "Done" then
            local perfect, total = 0, 0
            for _, result in ipairs(view.results or {}) do
                total = total + 1
                if result == "Critical" then perfect = perfect + 1 end
            end
            return ("Finished %s: %d of %d perfect."):format(what, perfect, total)
        elseif outcome == "Cancelled" then
            return ("Stopped %s."):format(what)
        elseif outcome == "Released" then
            return ("Handed %s back to you."):format(what)
        elseif outcome == "Idle" then
            return ("The %s minigame went quiet, so it was left."):format(verb)
        end
        return ("The %s minigame ended."):format(verb)
    end

    local function currentLine()
        local ok, view = solver.session()
        if ok and type(view) == "table" then return playingLine(view) end
        return waitingLine()
    end

    local function apply()
        if not want.on then
            if running then
                running = false
                solver.disable()
            end
            Ui.text(status, OFF)
            return
        end
        if not want.mining and not want.harvesting then
            if running then
                running = false
                solver.disable()
            end
            Ui.text(status, "Pick Mining, Harvesting or both for it to play.")
            return
        end
        solver.configure({ critRate = chance / 100 })
        running = solver.enable({ mining = want.mining, harvesting = want.harvesting }) == true
        if not running then
            -- nothing to hook into in this place, so the switch goes back off rather than pretend
            Ui.set(master, false)
            Ui.text(status, "Couldn't find the minigames here. Try again in the open world.")
            return
        end
        Ui.text(status, currentLine())
    end

    master = group:AddToggle("GatherAutoMinigame", {
        Text     = "Auto Minigame",
        Default  = false,
        Tooltip  = "Plays the mining and harvesting minigames for you, however you started them, even by hand.",
        Callback = function(on)
            want.on = on == true
            apply()
        end,
    })

    local options = group:AddDependencyBox()
    options:AddToggle("GatherAutoMining", {
        Text     = "Mining",
        Default  = true,
        Tooltip  = "Plays the mining minigame.",
        Callback = function(on)
            want.mining = on == true
            apply()
        end,
    })
    options:AddToggle("GatherAutoHarvesting", {
        Text     = "Harvesting",
        Default  = true,
        Tooltip  = "Plays the harvesting minigame.",
        Callback = function(on)
            want.harvesting = on == true
            apply()
        end,
    })
    options:AddSlider("GatherPerfectChance", {
        Text     = "Perfect hit chance",
        Default  = DEFAULT_CHANCE,
        Min      = 0,
        Max      = 100,
        Rounding = 0,
        Suffix   = "%",
        Tooltip  = "Lower looks more natural — the rest still land as normal hits, never misses",
        Callback = function(value)
            chance = tonumber(value) or DEFAULT_CHANCE
            solver.configure({ critRate = chance / 100 })
        end,
    })
    options:SetupDependencies({
        { master, true },
    })

    status = group:AddLabel({ Text = OFF, DoesWrap = true })

    -- the solver's signals come in on the minigame remote's own thread, which Ui.text raises for the menu
    ctx.track(solver.onOpen:Connect(function(view)
        Ui.text(status, playingLine(view))
    end))
    ctx.track(solver.onResult:Connect(function(view)
        Ui.text(status, playingLine(view))
    end))
    ctx.track(solver.onClose:Connect(function(view)
        -- a replaced session is followed straight away by the open that replaced it
        if view.outcome == "Replaced" or view.outcome == "Unloaded" then return end
        Ui.text(status, closedLine(view))
    end))

    local function cleanup()
        want.on = false
        if running then
            running = false
            solver.disable()
        end
    end

    return { cleanup = cleanup }
end

end)
