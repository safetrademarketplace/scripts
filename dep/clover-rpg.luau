-- movement planner: turns one leg into root positions the stepper tweens along, every segment already swept clear; pathfinding first, then ring spots near a target the path cannot reach, then straight segments that follow the ground

local Services = require("Services")
local Tuning   = require("Api/Movement/Tuning")

local PathfindingService = Services.PathfindingService

-- kamo village doors are server touch pads (Structures.Door.TouchDetection, opened by Remotes.Client.Door); a closed one is just geometry to route around
local AGENT = {
    AgentRadius     = Tuning.agentRadius,
    AgentHeight     = Tuning.agentHeight,
    AgentCanJump    = Tuning.agentCanJump,
    AgentCanClimb   = Tuning.agentCanClimb,
    WaypointSpacing = Tuning.waypointSpacing,
}

-- points closer than this to the one before add nothing to a route
local MERGE = 0.05

local M = {}

local function flatDistance(a, b)
    local dx, dz = a.X - b.X, a.Z - b.Z
    return math.sqrt(dx * dx + dz * dz)
end

local function distance(a, b)
    local dx, dy, dz = a.X - b.X, a.Y - b.Y, a.Z - b.Z
    return math.sqrt(dx * dx + dy * dy + dz * dz)
end

local function feet(probe, point)
    return Vector3.new(point.X, point.Y - probe.height, point.Z)
end

local function append(list, points)
    for i = 1, #points do list[#list + 1] = points[i] end
    return list
end

-- a path is created per compute call: one shared Path object races between movers and hands each the other's waypoints
local function compute(from, to)
    local made, path = pcall(PathfindingService.CreatePath, PathfindingService, AGENT)
    if not made or not path then return nil end
    local waypoints = nil
    if pcall(path.ComputeAsync, path, from, to) then
        local okStatus, status = pcall(function() return path.Status end)
        if okStatus and status == Enum.PathStatus.Success then
            local okRead, list = pcall(path.GetWaypoints, path)
            if okRead and type(list) == "table" and #list > 0 then waypoints = list end
        end
    end
    pcall(path.Destroy, path)
    return waypoints
end

-- straight when the body box sweeps clean, otherwise up and across at the lowest lift that does; a jump waypoint is just this with no lift
local function connect(probe, a, b)
    if probe.sweep(a, b) then return { b } end
    local base = math.max(a.Y, b.Y)
    for _, lift in ipairs(Tuning.lifts) do
        local top = base + lift
        local up = Vector3.new(a.X, top, a.Z)
        local over = Vector3.new(b.X, top, b.Z)
        if probe.sweep(a, up, true) and probe.sweep(up, over, true) and probe.sweep(over, b, true) then
            local out, last = {}, a
            for _, point in ipairs({ up, over, b }) do
                if distance(point, last) > MERGE then
                    out[#out + 1] = point
                    last = point
                end
            end
            return out
        end
    end
    return nil
end

-- the whole chain or nothing; a point no lift can reach may be skipped for one a little further on (a drop too close to its ledge, a waypoint on a fence), and the first that cannot is named
local function chain(probe, start, points)
    local out, last = {}, start
    local i = 1
    while i <= #points do
        local linked, reached = nil, nil
        for j = i, math.min(i + Tuning.skipAhead, #points) do
            linked = connect(probe, last, points[j])
            if linked then
                reached = j
                break
