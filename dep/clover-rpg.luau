            BackgroundTransparency = 1,
            BorderSizePixel  = 0,
            Parent           = panel,
        })
        self.contentArea = content

        -- click-outside + Esc close at the UIS level; backdrop.Activated is unreliable because clicks on non-Active child Frames fall through
        table.insert(self.connections, UserInputService.InputBegan:Connect(function(input, processed)
            if processed then return end
            if not self.opened then return end

            if input.KeyCode == Enum.KeyCode.Escape then
                self:Hide()
                return
            end

            local kind = input.UserInputType
            if kind ~= Enum.UserInputType.MouseButton1
                and kind ~= Enum.UserInputType.Touch
            then return end

            local p = self.panel
            if not p or not p.Parent then return end
            local pos  = p.AbsolutePosition
            local size = p.AbsoluteSize
            local mx, my = input.Position.X, input.Position.Y
            if mx >= pos.X and mx <= pos.X + size.X
                and my >= pos.Y and my <= pos.Y + size.Y
            then
                return  -- inside panel — keep open
            end
            self:Hide()
        end))

        -- tear down on unload so a re-exec doesn't leak the ScreenGui
        if not self.unloaderRegistered and self.services.Unloader and self.services.Unloader.Register then
            self.unloaderRegistered = true
            self.services.Unloader:Register(function()
                self:_destroy()
            end)
        end
    end

    function shell:_destroy()
        for _, conn in ipairs(self.connections) do
            pcall(function() conn:Disconnect() end)
        end
        self.connections = {}
        if self.gui then
            pcall(function() self.gui:Destroy() end)
        end
        self.gui = nil
        self.backdrop = nil
        self.panel = nil
        self.contentArea = nil
        self.tabBar = nil
        self.tabButtons = {}
