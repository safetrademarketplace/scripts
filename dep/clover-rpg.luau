    self.instance = target.instance
    self.kind     = target.kind          -- "player" | "entity" | "object"
    self.group    = group                -- live config ref (group.config)
    -- a bare part has no rig and no PrimaryPart to read, so it is never treated as a character
    self.isPart   = self.kind ~= "player" and target.instance:IsA("BasePart")
    self.shared   = shared
    self.deps     = deps
    self.bin      = {}
    self.charCache = {}
    self.childCount = 0

