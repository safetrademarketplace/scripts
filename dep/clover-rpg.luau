            Log.devwarn("CloverUtils", "no slowdown could not list live functions: %s", tostring(objects))
            return
        end
        for _, f in ipairs(objects) do
            if type(f) == "function" and (not islclosure or islclosure(f)) then
                local okInfo, name, source = pcall(debug.info, f, "ns")
                if okInfo and name == "updateHumanoid" and type(source) == "string" and source:find("HumanoidHandler", 1, true) then
                    pcall(f)
                end
            end
        end
        -- running the game's closures can drop the identity the menu needs once this callback returns
        Identity.elevate()
    end

    local function apply()
        local found, fresh = {}, 0
        local basic = whenHurt and LiveModules.shared(Services, "Basic", "CloverUtils") or nil
        local weight = ENCUMBRANCE and LiveModules.shared(Services, "Weight", "CloverUtils") or nil
        for _, v in ipairs(LiveModules.tables(getgc, "CloverUtils", basic, weight)) do
            if type(v) == "table" and not (isreadonly and isreadonly(v)) then
                if isSpeedTable(v) then
                    local n = patchSpeed(v)
                    if n > 0 then
                        found.speed = true
                        fresh = fresh + n
                    end
                elseif ENCUMBRANCE and isWeight(v) then
                    if rawget(v, "OVERENCUMBERED_SPEED") ~= 1 then
                        slows.write(v, "OVERENCUMBERED_SPEED", 1)
                        fresh = fresh + 1
                    end
                elseif whenHurt and isBasic(v) then
                    if rawget(v, "LowThreshold") ~= 0 then
                        hurt.write(v, "LowThreshold", 0)
                        fresh = fresh + 1
                    end
                end
            end
        end
        if fresh > 0 then
            refresh()
            Log.dev("CloverUtils", "no slowdown cleared %d entries", fresh)
        end
