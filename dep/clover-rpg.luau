    end)

    expose(api, "itemNames", function(kind)
        if kind ~= nil and Nodes.KINDS[kind] == nil then return false, Errors.BAD_ARGS end
        return true, nodes.itemNames(kind)
    end)

    -- the prompt is nil while it has not streamed in or is switched off
    expose(api, "nodeModel", function(node)
        local info, model, prompt = nodes.resolve(node)
        if info == nil then return false, Errors.BAD_ARGS end
        if model == nil then return false, Errors.NOT_STREAMED end
        return true, model, prompt
    end)

    -- best owned power, the tool that gives it, and the best power held in hand; which one the server gates on is unsettled
    expose(api, "toolPower", function(kind)
        if Nodes.KINDS[kind] == nil then return false, Errors.BAD_ARGS end
        local character = nil
        local state = apiOf("State")
        if state ~= nil then
            local ok, char = state.character()
            if ok then character = char end
        end
        local power, tool, held = nodes.toolPower(kind, character)
        if power == nil then return false, Errors.FAILED, "the tool registry has not loaded" end
        return true, power, tool, held
    end)

    expose(api, "gather", gather.gather)
    expose(api, "cancel", solver.cancel)

    api.solver = {}
    expose(api.solver, "enable", solver.enable)
    expose(api.solver, "disable", solver.disable)
    expose(api.solver, "enabled", solver.enabled)
    expose(api.solver, "session", function() return true, solver.session() end)
    expose(api.solver, "configure", solver.configure)
    expose(api.solver, "settings", function() return true, solver.settings() end)
    api.solver.onOpen   = listenable(solver.openSignal)
    api.solver.onResult = listenable(solver.resultSignal)
    api.solver.onClose  = listenable(solver.closeSignal)

    if base.maid then
        base.maid:GiveTask(function()
            closed = true
            solver.shutdown()
        end)
    end

    return api
end

return M

end)
