    local ok, position, part = pcall(provider)
    if not ok then
        onThrow(position)
        return original(...)
    end
    if typeof(position) ~= "Vector3" then return original(...) end
    if wantTarget then
        if isPart(part) then return part end
        return original(...)
    end
    if asCFrame then return hitFrame(position) end
    return position
end

-- deps.net() -> CloverNet | nil; deps.warn(fmt, ...)
function M.new(deps)
    local aim = {}

    local current = nil
    local closed = false

    local function codeFor(net, code)
        local errors = net.Errors or {}
        if code == errors.BUSY then return "busy" end
        if code == errors.NO_CALLBACK_API or code == errors.NO_ORIGINAL
            or code == errors.NO_REMOTE or code == errors.WRONG_CLASS then
