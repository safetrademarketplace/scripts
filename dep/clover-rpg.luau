__bundle_register("Features/Clover/PlayerUtils/NoSlowdown", function(require, _LOADED, __bundle_register, __bundle_modules)
-- no slowdown sub-module of clover utils: clears the slowing entries (stunned, slowed, parried, airborne, swinging, soft stun, detained) from HumanoidHandler's own walk speed table and the over-encumbered slow, and with also when hurt on the low-health walk slow and the halved roll when hurt or mid-air, then reruns the game's updateHumanoid so the change lands at once
local Executor     = require("Utility/Executor")
local Identity     = require("Utility/Identity")
local Log          = require("Utility/Log")
local LiveModules  = require("Features/Clover/PlayerUtils/LiveModules")
local RespawnPatch = require("Features/Clover/PlayerUtils/RespawnPatch")
local TablePatch   = require("Features/Clover/PlayerUtils/TablePatch")

-- also clear the full stops (knocked, frozen, locked, cant move, block broken); some hold you still in cutscenes
local HARD_STOPS = false
-- also drop the 0.8x over-encumbered slow
local ENCUMBRANCE = true

local UNSUPPORTED = "This doesn't work on your executor."

-- HumanoidHandler's script-local table; one live copy per character, Flashstep is the only entry at 35
local function isSpeedTable(t)
    local stunned, flash = rawget(t, "Stunned"), rawget(t, "Flashstep")
    return type(stunned) == "table" and type(flash) == "table" and rawget(flash, "Speed") == 35
end

local function isWeight(t)
    return type(rawget(t, "OVERENCUMBERED_SPEED")) == "number" and type(rawget(t, "IsOverencumbered")) == "function"
end

local function isBasic(t)
    return type(rawget(t, "LowThreshold")) == "number" and type(rawget(t, "LevelXPScale")) == "number"
end

local function isDashClass(t)
    return type(rawget(t, "GetDashSpeed")) == "function" and type(rawget(t, "StartGroundDash")) == "function"
end

-- the dash module's own speed with its low-health and mid-air cuts left out
local function fullDashSpeed(self)
    return 55 + self.Agility.Level.Value * 0.06
end

return function(ctx)
    local Services   = ctx.Services
    local References = ctx.References
    local Toggles    = ctx.Toggles
    local group      = ctx.CloverGroup

    local getgc      = Executor.get("getgc")
    local islclosure = Executor.get("islclosure")
    local isreadonly = Executor.get("isreadonly")
    local supported  = type(getgc) == "function"

    -- the slows every character has, and the hurt ones, so turning also when hurt off puts back only its own
    local slows = TablePatch.new()
    local hurt  = TablePatch.new()
    local whenHurt = false

    local dashLookup = {
        section    = "CloverUtils",
        getgc      = getgc,
        isreadonly = isreadonly,
        matches    = isDashClass,
        patched    = function(t) return rawget(t, "GetDashSpeed") == fullDashSpeed end,
        patch      = function(t) hurt.write(t, "GetDashSpeed", fullDashSpeed) end,
    }

    -- a Speed of 0 pins walk speed to zero in the game's loop, so a cleared entry gets nil, never 0
    local function patchSpeed(t)
        local n = 0
        for _, entry in pairs(t) do
            local speed = type(entry) == "table" and rawget(entry, "Speed")
            if type(speed) == "number" and (speed < 0 or (HARD_STOPS and speed == 0)) then
                slows.write(entry, "Speed", nil)
                slows.write(entry, "jumpDisabled", false)
