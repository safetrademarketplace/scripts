__bundle_register("Features/Home", function(require, _LOADED, __bundle_register, __bundle_modules)
-- home: about (named after Meta.name), key status, executor, links and feedback on the left, latest updates, dashboard and credits on the right, each built through UI/Place so the tab file can move it
local ExecutorSupport = require("Utility/ExecutorSupport")
local Place           = require("UI/Place")
local PremiumPopup    = require("UI/PremiumPopup")
local Connectivity    = require("Features/Connectivity")

return function(ctx)
    local References = ctx.References
    local Library    = ctx.Library
    local Options    = ctx.Options
    local META       = ctx.META or {}
    local Helpers    = ctx.Helpers
    local Toggles    = Library.Toggles

    local aboutGroup = Place.groupbox(ctx, META.name or "Cerberus", "info", { fallback = "Home", side = "Left" })
    if aboutGroup then
        aboutGroup:AddDivider()
        aboutGroup:AddLabel(('<b>Version</b>  %s'):format(META.version or "v1.0.0"))
        aboutGroup:AddLabel(('<b>Updated</b>  %s'):format(META.updated or "Unknown"))
        aboutGroup:AddLabel(('<b>Status</b>  <font color="#86efac">%s</font>'):format(META.status or "Stable Release"))
        aboutGroup:AddDivider()
    end

    do
        local KeyCheck = ctx.Api and ctx.Api.KeyCheck
        local keyGroup = KeyCheck and KeyCheck.HasKey() and Place.groupbox(ctx, "Key Status", "key", { fallback = "Home", side = "Left" })
        if keyGroup then
            local execLabel   = keyGroup:AddLabel({ Text = '<b>Executions:</b>  <font color="#9ca3af">Loading...</font>', DoesWrap = true })
            local statusLabel = keyGroup:AddLabel({ Text = '<b>Expiry:</b>  <font color="#9ca3af">Loading...</font>', DoesWrap = true })

            local function set(label, prefix, text, color)
                if label and label.SetText then
                    pcall(label.SetText, label, ('<b>%s:</b>  <font color="%s">%s</font>'):format(prefix, color, text))
                end
            end

            -- the sdk fetch, status policy and countdown all live in ctx.Api.KeyCheck; this is display only
            task.spawn(function()
                local result = KeyCheck.Check()
                if result.valid and result.data then
                    set(execLabel, "Executions", tostring(result.data.totalExecutions or 0), "#9ca3af")
                    KeyCheck.StartCountdown(result.data.authExpire, function(text, state)
                        local color = (state == "expired" and "#fca5a5")
                            or (state == "lifetime" and "#86efac")
                            or "#fde047"
                        set(statusLabel, "Expiry", text, color)
                    end)
                else
                    set(execLabel, "Executions", "N/A", "#fca5a5")
                    set(statusLabel, "Status", result.message or "Key check failed", result.color or "#fca5a5")
                end
            end)
        end
    end

    local executorGroup = Place.groupbox(ctx, "Executor", "code", { fallback = "Home", side = "Left" })
    if executorGroup then
        local report = ExecutorSupport.analyze(META, References.executorName)

        local statusColor
        if not report.ok then
            statusColor = "#fca5a5"
        elseif report.isLimited or #report.missingRecommended > 0 then
            statusColor = "#fde047"
        else
            statusColor = "#86efac"
        end

        executorGroup:AddLabel({
            Text    = ('<b>Executor</b>  %s'):format(report.executorName),
            DoesWrap = true,
        })
        executorGroup:AddLabel({
            Text    = ('<b>Status</b>  <font color="%s">%s</font>'):format(statusColor, report.statusLabel),
            DoesWrap = true,
        })

        local gaps = ExecutorSupport.describeGaps(report)
        if #gaps > 0 then
            executorGroup:AddDivider()
            for _, line in ipairs(gaps) do
                local label, body = line:match("^(.-):%s*(.*)$")
                if label and body then
                    executorGroup:AddLabel({
                        Text    = ('<font color="#9ca3af"><b>%s</b></font>  %s'):format(label, body),
                        DoesWrap = true,
                    })
                else
                    executorGroup:AddLabel({ Text = line, DoesWrap = true })
                end
            end
        end

        if report.isLimited and report.ok then
            executorGroup:AddDivider()
            executorGroup:AddLabel({
                Text    = ('<font color="#fde047"><b>Note</b></font>  %s\'s drawing/gethui APIs are limited — ESP and some UI may not render correctly.'):format(
                    report.isXeno and "Xeno" or "Solara"),
                DoesWrap = true,
            })
        end
    end

    local linksGroup = Place.groupbox(ctx, "Links", "link", { fallback = "Home", side = "Left" })
    if linksGroup then
        local urls = META.urls or {}

        local function link(text, url, msg)
            if Helpers.copyLink and url then
                linksGroup:AddButton({
                    Text = text,
                    Tooltip = url,
                    Func = function()
                        Helpers.copyLink(url, msg)
                    end,
                })
