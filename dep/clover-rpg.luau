__bundle_register("Features/Navigation/Teleports/Destinations", function(require, _LOADED, __bundle_register, __bundle_modules)
-- teleport destinations: every place the teleports tab can send you in clover rpg, built fresh from the world and professions apis; each record has a key that survives a refresh, a label, a live position for the mover to aim at and how close it has to get

local Ground = require("Features/Navigation/Teleports/Ground")
local Words  = require("Features/Navigation/Teleports/Words")

-- how close a trip stops: near enough to talk, buy, gather or fight, short of standing inside the thing
local REACH = { person = 6, object = 7, node = 5, mob = 8 }
-- a zone or area centre is the middle of a box that can sit well above the floor, so the floor under it is looked for
local AREA_DEPTH = 300
local AREA_ABOVE = 200
local POI_DEPTH  = 60
-- a zone box is searched from just over its own top down to just under its bottom
local ZONE_MARGIN = 20

local NOT_LOADED = "These haven't loaded in yet. Get closer to them or press Refresh."
local PART_LOADED = "Some of these haven't loaded in yet, so the list may grow as you get closer."
local NO_CHARACTER = "Your character isn't in the world right now."

local M = {}

M.CATEGORIES = {
    { key = "areas",    label = "Areas" },
    { key = "zones",    label = "Towns & Zones" },
    { key = "npcs",     label = "NPCs" },
    { key = "services", label = "Shops & Services" },
    { key = "gates",    label = "Waypoint Gates" },
    { key = "shrines",  label = "Shrines" },
    { key = "pois",     label = "Points of Interest" },
}

M.RESOURCE_KINDS = {
    { label = "Ores",  kind = "Ore" },
    { label = "Crops", kind = "Harvest" },
}

M.REACH = REACH

local commas, duration = Words.commas, Words.duration

local function fixed(position)
    return function() return position end
end

local function nowhere()
    return nil
end

-- a live part followed while it lasts and remembered once it is gone, so a trip still ends somewhere real
local function chase(part, fallback)
    local last = fallback
    return function()
        if part ~= nil and part.Parent ~= nil then last = part.Position end
        return last
    end
end

-- an npc's root streams in and out on its own, so it is looked up again whenever the one held has gone
local function chaseModel(model, root, fallback)
    local last = fallback
    return function()
        if not (root and root.Parent) and model and model.Parent then root = model:FindFirstChild("HumanoidRootPart") end
        if root and root.Parent then last = root.Position end
        return last
    end
end

-- aimed at the raw centre until the floor under it has streamed in, then held on that floor
local function grounded(position, depth, above)
    if position == nil then return nowhere end
    local floor = nil
    return function()
        if floor == nil then floor = Ground.under(position, depth, above) end
        return floor or position
    end
end

local function lower(text)
    return string.lower(tostring(text or ""))
end

-- by label, the same label nearest-first; a label two destinations share gets " (2)" on the second, so the dropdown never holds one name for two places
local function finish(records, origin)
    for _, record in ipairs(records) do
        local position = record.position
        record.distance = (origin and position) and (position - origin).Magnitude or math.huge
        record.sortKey = lower(record.label)
    end
    table.sort(records, function(a, b)
        if a.sortKey ~= b.sortKey then return a.sortKey < b.sortKey end
        return a.distance < b.distance
    end)
    local used = {}
    for _, record in ipairs(records) do
        local base, label, n = record.label, record.label, 1
        while used[label] do
            n = n + 1
            label = ("%s (%d)"):format(base, n)
        end
        used[label] = true
        record.label = label
        if record.key == nil then record.key = "label:" .. label end
    end
    return records
end

function M.new(deps)
    local Api       = deps.Api
    local Waypoints = deps.Waypoints

    local dest = {}

    -- any api may have failed to build, so a missing one (or a throw) reads as a failed call
    local function ask(apiName, method, ...)
        local api = Api and Api[apiName]
        local fn = type(api) == "table" and api[method] or nil
        if type(fn) ~= "function" then return false, nil end
        -- every result passes through: estimate answers (ok, seconds, distance), and a third value dropped here read as 0 studs
        local results = table.pack(pcall(fn, ...))
        if not results[1] then return false, nil end
        return table.unpack(results, 2, results.n)
    end

    local function code(apiName, name)
        local api = Api and Api[apiName]
        local errors = type(api) == "table" and api.Errors or nil
        return type(errors) == "table" and errors[name] or nil
    end

    local function notStreamed(err)
        return err ~= nil and err == code("World", "NOT_STREAMED")
    end

    function dest.here()
        local ok, root = ask("State", "root")
        if not ok or root == nil then return nil end
        return root.Position
    end

    -- name and display name -> centre, so an area that has not streamed in can still be found through its zone
    local function zoneCentres()
        local ok, list = ask("World", "locations")
        local out = {}
        if not ok or type(list) ~= "table" then return out end
        for _, zone in ipairs(list) do
            if zone.position then
                out[zone.name] = out[zone.name] or zone.position
                if zone.displayName then out[zone.displayName] = out[zone.displayName] or zone.position end
            end
        end
        return out
    end

    local SOURCES = {}

    function SOURCES.areas(out)
        local ok, list = ask("World", "areas")
        if not ok then return notStreamed(list) end
        local zones = zoneCentres()
        for _, area in ipairs(list) do
            local label = area.displayName or area.name
            local position = area.position or zones[area.name] or zones[label]
            out[#out + 1] = {
                key      = area.instance or ("area:" .. area.name),
                label    = label,
                position = position,
                where    = grounded(position, AREA_DEPTH, AREA_ABOVE),
            }
        end
        return false
    end

    function SOURCES.zones(out)
        local ok, list = ask("World", "locations")
        if not ok then return notStreamed(list) end
        for _, zone in ipairs(list) do
            local half = zone.size and zone.size.Y / 2 or AREA_DEPTH
            out[#out + 1] = {
                key      = "zone:" .. zone.name,
                label    = zone.displayName or zone.name,
                position = zone.position,
                where    = grounded(zone.position, half + ZONE_MARGIN, half + ZONE_MARGIN),
            }
        end
        return false
    end

    local function person(entry, prefix)
        return {
            key      = entry.model or entry.instance,
            label    = prefix and (prefix .. entry.name) or entry.name,
            position = entry.position,
            where    = chaseModel(entry.model, entry.root, entry.position),
            reach    = REACH.person,
            about    = entry.questGiver and "Gives quests." or nil,
        }
    end

    function SOURCES.npcs(out)
        local ok, list = ask("World", "npcs")
        if not ok then return notStreamed(list) end
        for _, npc in ipairs(list) do out[#out + 1] = person(npc) end
        return false
    end

    -- each list is read on its own, so one that has not streamed in leaves the rest standing
    local SERVICES = {
        { method = "shops", entry = function(shop)
            return {
                key      = shop.prompt,
                label    = "Shop: " .. shop.name,
                position = shop.position,
                where    = fixed(shop.position),
                reach    = REACH.object,
                about    = shop.price and ("Costs %s Marks."):format(commas(shop.price)) or nil,
            }
        end },
        { method = "sellers", entry = function(npc) return person(npc, "Seller: ") end },
        { method = "bankers", entry = function(staff)
            return { key = staff.instance, label = "Banker: " .. staff.name, position = staff.position, where = fixed(staff.position), reach = REACH.person }
        end },
        { method = "trainers", entry = function(staff)
            return { key = staff.instance, label = "Trainer: " .. staff.name, position = staff.position, where = fixed(staff.position), reach = REACH.person }
        end },
        { method = "cauldrons", entry = function(station)
            return {
                key      = station.instance,
                label    = "Cauldron",
                position = station.position,
                where    = fixed(station.position),
                reach    = REACH.object,
                about    = "An alchemy cauldron for brewing.",
            }
        end },
        { method = "spawns", entry = function(inn)
            return {
                key      = inn.instance,
                label    = "Inn: " .. (inn.displayName or inn.name),
                position = inn.position,
                where    = fixed(inn.position),
                about    = inn.current and "This is the inn you respawn at." or nil,
            }
        end },
    }

    function SOURCES.services(out)
        local missing = false
        for _, source in ipairs(SERVICES) do
            local ok, list = ask("World", source.method)
            if ok and type(list) == "table" then
                for _, entry in ipairs(list) do
                    if entry.position then out[#out + 1] = source.entry(entry) end
                end
            elseif notStreamed(list) then
                missing = true
            end
        end
        return missing
    end

    function SOURCES.gates(out)
        local ok, list = ask("World", "waypoints")
        if not ok then return notStreamed(list) end
        for _, gate in ipairs(list) do
            out[#out + 1] = {
                key      = gate.model,
                label    = gate.name,
                position = gate.position,
                where    = chase(gate.root, gate.position),
                reach    = REACH.object,
            }
        end
        return false
    end

    function SOURCES.shrines(out)
        local ok, list = ask("World", "shrines")
        if not ok then return notStreamed(list) end
        for _, shrine in ipairs(list) do
            out[#out + 1] = {
                key      = shrine.model,
                label    = shrine.unlocked and (shrine.name .. " (unlocked)") or shrine.name,
                position = shrine.position,
                where    = chase(shrine.root, shrine.position),
                reach    = REACH.object,
                about    = shrine.unlocked and "Unlocked." or "Not unlocked yet.",
            }
        end
        return false
    end

    -- the game files a few points under a catch-all folder, which says nothing about where they are
    local function poiPlace(category)
        if type(category) ~= "string" or category == "" or lower(category):sub(1, 4) == "misc" then return nil end
        return category
    end

    function SOURCES.pois(out)
        local ok, list = ask("World", "pois")
        if not ok then return notStreamed(list) end
        for _, poi in ipairs(list) do
            local place = poiPlace(poi.category)
            out[#out + 1] = {
                key      = poi.instance,
                label    = place and ("%s (%s)"):format(poi.name, place) or poi.name,
                position = poi.position,
                where    = grounded(poi.position, POI_DEPTH, 0),
            }
        end
        return false
    end

    -- the records for one category and a line about the list when it is empty or partly loaded
    function dest.build(categoryKey)
        local source = SOURCES[categoryKey]
        if not source then return {}, nil end
        local out = {}
        local missing = source(out)
        finish(out, dest.here())
        local note = nil
        if missing then note = #out == 0 and NOT_LOADED or PART_LOADED end
        if #out == 0 and note == nil then note = "Nothing like that has been found here." end
        return out, note
    end

    -- distance and travel time to a record from where you stand, at the speed set in the menu
    function dest.away(record)
        local okWhere, position = pcall(record.where)
        if not okWhere or position == nil then return "Not loaded in yet. Get closer or press Refresh." end
        local ok, seconds, distance = ask("Movement", "estimate", position)
        if not ok or type(seconds) ~= "number" then return nil end
        return ("%s studs away, about %s at your speed."):format(commas(distance), duration(seconds))
    end

    function dest.mobNames()
        local ok, list = ask("World", "mobNames")
        if ok and type(list) == "table" then return list end
        return {}
    end

    -- the nearest living mob of that name, or nil and why not
    function dest.mob(name)
        local ok, entry = ask("World", "nearestMob", { name = name, alive = true })
        if ok and type(entry) == "table" then
            return {
                key   = entry.model,
                label = entry.name,
                where = chase(entry.root, entry.position),
                reach = REACH.mob,
            }
        end
        if notStreamed(entry) then return nil, "Mobs haven't loaded in yet. Try again in a moment." end
        if entry == code("World", "NOT_READY") then return nil, NO_CHARACTER end
        return nil, ("No living %s is loaded near you. Mobs far away only show up once you get closer."):format(name)
    end

    function dest.mobLine(name)
        local ok, list = ask("World", "mobs", { name = name, alive = true })
        if not ok then
            if notStreamed(list) then return "Mobs haven't loaded in yet." end
            return nil
        end
        if #list == 0 then return ("No living %s is loaded near you right now."):format(name) end
        local nearest = list[1].distance
        local count = #list == 1 and "1 is" or ("%d are"):format(#list)
        if nearest == nil then return ("%s loaded near you."):format(count) end
        return ("Nearest is %s studs away. %s loaded near you."):format(commas(nearest), count)
    end

    function dest.itemNames(kind)
        local ok, list = ask("Professions", "itemNames", kind)
        if ok and type(list) == "table" then return list end
        return {}
    end

    -- why there is no ready node of that item: all used up (and when the first grows back) or none anywhere
    local function noneReady(kind, item)
        local ok, list = ask("Professions", "nodes", { kind = kind, items = { item }, available = false })
        if not ok or type(list) ~= "table" or #list == 0 then
            return ("There's no %s anywhere on this map."):format(item)
        end
        local soonest = nil
        for _, node in ipairs(list) do
            local wait = tonumber(node.respawnIn)
            if wait and wait > 0 and (soonest == nil or wait < soonest) then soonest = wait end
        end
        if soonest then
            return ("Every %s is used up right now. The next one grows back in %s."):format(item, duration(soonest))
        end
        return ("Every %s is used up right now."):format(item)
    end

    local function nearestNode(kind, item)
        local ok, node = ask("Professions", "nearestNode", { kind = kind, items = { item }, available = true })
        if ok and type(node) == "table" then return node end
        if node == code("Professions", "NONE") then return nil, noneReady(kind, item) end
        if node == code("Professions", "FAILED") then return nil, NO_CHARACTER end
        return nil, "Resources haven't loaded yet. Try again in a moment."
    end

    -- the nearest ready node of that item, or nil and why not
    function dest.node(kind, item)
        local node, why = nearestNode(kind, item)
        if not node then return nil, why end
        return {
            key   = node.record,
            label = item,
            where = fixed(node.position),
            reach = REACH.node,
        }
    end

    function dest.nodeLine(kind, item)
        local node, why = nearestNode(kind, item)
        if not node then return why end
        if node.distance == nil then return ("A ready %s was found."):format(item) end
        return ("Nearest ready one is %s studs away."):format(commas(node.distance))
    end

    function dest.spot(name)
        return {
            key   = "spot:" .. name,
            label = name,
            where = function() return Waypoints.list[name] end,
        }
    end

    -- where you clicked; quiet, so moving around by clicking never stacks up notifications
    function dest.point(position)
        return {
            key   = "point",
            label = "where you clicked",
            where = fixed(position),
            quiet = true,
        }
    end

    -- the readable name of the zone you stand in, for a spot saved without a name
    function dest.zoneName()
        local ok, name = ask("State", "location")
        if not ok or type(name) ~= "string" then return nil end
        local okZones, list = ask("World", "locations")
        if okZones and type(list) == "table" then
            for _, zone in ipairs(list) do
                if zone.name == name then return zone.displayName or name end
            end
        end
        return name
    end

    return dest
end

return M

end)
