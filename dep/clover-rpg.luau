        local gate = gates[kind]
        if gate.armJob then
            gate.armJob:Cancel()
            gate.armJob = nil
        end
        local mode = "full"
        if not park(kind) then
            -- a partial park would only blind the handler while another still answers
            release(kind)
            if kind == "Mining" then mode = "assist" else mode = "watch" end
            base.log("%s session runs in %s mode: the game's own handler could not be parked", kind, mode)
        end
        serial = serial + 1
        local s = {
            kind      = kind,
            id        = data.Session,
            title     = data.Title,
            grace     = { RedGrace = tonumber(data.RedGrace) or 0, GreenGrace = tonumber(data.GreenGrace) or 0 },
            health    = type(data.Health) == "number" and data.Health or 1,
            momentum  = 0,
            rounds    = 0,
            answers   = 0,
            results   = {},
            seen      = {},
            after     = {},
            mode      = mode,
            serial    = serial,
            lastHeard = os.clock(),
            closed    = false,
            maid      = Maid.new(),
        }
        sessions[kind] = s
        if mode == "full" then lockPrompts() end
        s.maid:GiveTask(Jobs.spawn(function(job)
            while not s.closed do
                local left = s.lastHeard + IDLE_CLOSE - os.clock()
                if left <= 0 then
                    base.warn("%s session went silent, so it is treated as over", kind)
                    finish(s, "Idle")
