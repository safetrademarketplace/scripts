            end
            return
        end
        kit.setHome(at)
        if kit.flying() then
            guard(kit, false)
            kit.status("Landing to fight.")
            kit.land()
            return
        end
        fight(kit, mob, gap)
        settle(kit)
    end

    return brain
end

return M

