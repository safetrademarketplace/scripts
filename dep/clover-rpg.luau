    if not TARGET_LOCALE then return text end
    if not registry[text] then registry[text] = true end
    local hit = cache[text]
    if hit then return hit end
    -- if the API is declared dead the worker is gone — don't queue more work
    if apiAvailable then enqueue(text) end
    return text
end

