local PlayersH = require("Utility/Helpers/Players")
local VMath    = require("Utility/Helpers/VMath")

local M = {}

-- a candidate is { group, name, player?, model?, instance? }; every accessor tolerates whichever subset a fork's gather() filled in
function M.new(opts)
    local index = opts.index

    local function getModel(candidate)
        if type(candidate) ~= "table" then return nil end
        if candidate.player then
            local char = candidate.player.Character
            return (char and char.Parent) and char or nil
        end
        if candidate.model and candidate.model.Parent then return candidate.model end
        local inst = candidate.instance
        if not (inst and inst.Parent) then return nil end
        if inst:IsA("Model") then return inst end
        if inst:IsA("BasePart") then return inst:FindFirstAncestorOfClass("Model") end
        return nil
    end

    local function getHumanoid(candidate)
        local model = getModel(candidate)
        return model and model:FindFirstChildOfClass("Humanoid") or nil
    end

    local function getRoot(candidate)
        if type(candidate) == "table" then
            local inst = candidate.instance
            if inst and inst.Parent and inst:IsA("BasePart") then return inst end
        end
        local model = getModel(candidate)
        return model and PlayersH.getRootPart(model) or nil
    end

    local function getCFrame(candidate)
        local root = getRoot(candidate)
        if root then return root.CFrame end
        local model = getModel(candidate)
        if not model then return nil end
        local ok, pivot = pcall(model.GetPivot, model)
        return (ok and typeof(pivot) == "CFrame") and pivot or nil
    end

    local function getName(candidate)
        if type(candidate) ~= "table" then return "Unknown" end
        if type(candidate.name) == "string" and candidate.name ~= "" then return candidate.name end
        local player = candidate.player
        if player then return (player.DisplayName ~= "" and player.DisplayName) or player.Name end
        local model = getModel(candidate)
        return (model and model.Name) or "Unknown"
    end

    -- the handle a candidate keeps across list refreshes; two candidates sharing one are the same target
    local function token(candidate)
        if type(candidate) ~= "table" then return nil end
        return candidate.player or candidate.model or candidate.instance or getRoot(candidate)
    end

    -- strict about nil on purpose: "no target" is not a target, so it never counts as a match
    local function same(a, b)
        if a == nil or b == nil then return false end
        local left = token(a)
        return left ~= nil and left == token(b)
    end

