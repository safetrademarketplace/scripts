            finish(s, closeOutcome(s, data), data)
        end
    end

    -- our own connection is found by diffing the remote's connections around the connect, so a closure check that lies cannot park it
    local function listen(kind)
        if links[kind] then return true end
        local net = transport()
        if net == nil then return false, "no transport" end
        local path = KINDS[kind].path
        local okRemote, remote = net.remote(path)
        if not okRemote then return false, remote end
        local before = functionsIn(listConnections(remote))
        local ok, handle = net.on(path, function(event, data) onEvent(kind, event, data) end)
        if not ok then return false, handle end
        local own, fresh = nil, 0
        for fn in pairs(functionsIn(listConnections(remote))) do
            if not before[fn] then
                own = fn
                fresh = fresh + 1
            end
        end
        if fresh ~= 1 then own = nil end
        links[kind] = { handle = handle, remote = remote, own = own }
        return true
    end

    local function unlisten(kind)
        local link = links[kind]
        if link == nil then return end
        links[kind] = nil
        link.handle.Disconnect()
    end

    -- an exclusive session cannot be handed back mid-flight (the game never saw it open), so it is cancelled the game's way
    local function deactivate(kind)
        local s = sessions[kind]
        if s ~= nil then
            if s.mode == "full" then
                sendCancel(kind)
                finish(s, "Cancelled")
            else
                finish(s, "Released")
            end
        end
        local gate = gates[kind]
        if gate.armJob then
            gate.armJob:Cancel()
            gate.armJob = nil
        end
        release(kind)
        unlisten(kind)
    end

    local function onPromptTriggered(prompt, player)
        if dead then return end
        if player ~= nil and field(player, "UserId") ~= field(References.player, "UserId") then return end
        local kind = PROMPT_KINDS[field(prompt, "Name")]
        if kind ~= nil and active(kind) then self.arm(kind) end
    end

    -- a hand-fired node prompt parks the handlers before the server's Open can reach them
    local function refreshPromptWatch()
        local on = active("Mining") or active("Harvesting")
        if on and promptWatch == nil then
            local service = Services.ProximityPromptService
            if service == nil then return end
            promptWatch = service.PromptTriggered:Connect(function(prompt, player)
                base.safe("prompt watch", onPromptTriggered, prompt, player)
            end)
        elseif not on and promptWatch ~= nil then
            promptWatch:Disconnect()
            promptWatch = nil
        end
    end

    local function refresh(kind)
        local ok, why = true, nil
        if active(kind) then
            ok, why = listen(kind)
        elseif links[kind] then
            deactivate(kind)
        end
        refreshPromptWatch()
        return ok, why
    end

    local function newest()
        local best
        for _, s in pairs(sessions) do
            if best == nil or s.serial > best.serial then best = s end
        end
        return best
    end

    function self.enable(opts)
        if opts ~= nil and type(opts) ~= "table" then return false, Errors.BAD_ARGS end
        local mining, harvesting = true, true
        if opts ~= nil then
            if opts.mining ~= nil and type(opts.mining) ~= "boolean" then return false, Errors.BAD_ARGS end
            if opts.harvesting ~= nil and type(opts.harvesting) ~= "boolean" then return false, Errors.BAD_ARGS end
            mining = opts.mining ~= false
            harvesting = opts.harvesting ~= false
        end
        if not mining and not harvesting then return false, Errors.BAD_ARGS end
        wanted.Mining, wanted.Harvesting = mining, harvesting
        local listening, why = false, nil
        for kind in pairs(KINDS) do
            local ok, reason = refresh(kind)
            if not ok then
                why = reason
                wanted[kind] = false
                refresh(kind)
            elseif wanted[kind] then
                listening = true
            end
        end
        if not listening then return false, Errors.FAILED, why end
        return true
    end

    function self.disable()
        wanted.Mining, wanted.Harvesting = false, false
        for kind in pairs(KINDS) do refresh(kind) end
        return true
    end

    -- the user's switch only; a gather holding the solver for its own session does not count
    function self.enabled()
        return wanted.Mining or wanted.Harvesting
    end

    function self.session()
        local s = newest()
        if s == nil then return nil end
        return summary(s)
    end

    function self.configure(opts)
        if type(opts) ~= "table" then return false, Errors.BAD_ARGS end
        for key in pairs(opts) do
            if key ~= "critRate" then return false, Errors.BAD_ARGS end
        end
        local rate = opts.critRate
        if rate ~= nil then
            if type(rate) ~= "number" or rate ~= rate or rate < 0 or rate > 1 then return false, Errors.BAD_ARGS end
            critRate = rate
        end
        return true
    end

    function self.settings()
        return { critRate = critRate }
    end

    function self.isOpen(kind)
        return sessions[kind] ~= nil
    end

    -- keeps the kind answered until the returned release runs, whatever the user's switch says
    function self.hold(kind)
        if dead then return nil, Errors.NOT_READY end
        holds[kind] = holds[kind] + 1
        local ok, why = refresh(kind)
        if not ok then
            holds[kind] = holds[kind] - 1
            refresh(kind)
            return nil, why
        end
        local released = false
        return function()
            if released then return end
            released = true
            holds[kind] = holds[kind] - 1
            refresh(kind)
        end
    end

    -- a release handed in while that kind's session is open waits for its close, so the solver never drops a live session
    function self.releaseAfter(kind, release)
        local s = sessions[kind]
        if s ~= nil then
            s.after[#s.after + 1] = release
        else
            release()
        end
    end

    function self.arm(kind)
        if not active(kind) then return end
        local gate = gates[kind]
        park(kind)
        if gate.armJob then gate.armJob:Cancel() end
        gate.armJob = Jobs.delay(ARM_WINDOW, function()
            gate.armJob = nil
            local s = sessions[kind]
            if s == nil or s.mode ~= "full" then release(kind) end
        end, { name = "Professions arm" })
    end

    function self.disarm(kind)
        local gate = gates[kind]
        if gate.armJob then
            gate.armJob:Cancel()
            gate.armJob = nil
        end
        local s = sessions[kind]
        if s == nil or s.mode ~= "full" then release(kind) end
    end

    function self.watch(kind)
        local watcher = { kind = kind }
        watchers[watcher] = true
        return watcher
    end

    function self.unwatch(watcher)
        watchers[watcher] = nil
    end

    -- sends the game's Cancel and closes locally right away, as the game's own cancel key does
    function self.cancelSession(s)
        if s == nil or s.closed then return false, Errors.NO_SESSION end
        local ok, code = sendCancel(s.kind)
        if not ok then return false, Errors.FAILED, code end
        finish(s, "Cancelled")
        return true
    end

    function self.cancel()
        return self.cancelSession(newest())
    end

    -- runs before the transport's own cleanup, so an exclusive session can still be cancelled on the wire
    function self.shutdown()
        if dead then return end
        for kind, s in pairs(sessions) do
            if s.mode == "full" then sendCancel(kind) end
        end
        dead = true
        for _, s in pairs(sessions) do finish(s, "Unloaded") end
        for kind, gate in pairs(gates) do
            if gate.armJob then
                gate.armJob:Cancel()
                gate.armJob = nil
            end
            release(kind)
        end
        for kind in pairs(KINDS) do unlisten(kind) end
        refreshPromptWatch()
        unlockPromptsNow()
        for watcher in pairs(watchers) do
            if watcher.notify then watcher.notify(false) end
        end
    end

    return self
end

return M

end)
__bundle_register("Api/Professions/Minigames", function(require, _LOADED, __bundle_register, __bundle_modules)
-- minigames: the timing maths of both gathering minigames, mirrored from the game's own clients, plus a randomised aim that lands the grade asked for without sitting on a centre or an edge

local M = {}

-- HarvestRingsClient.lua:245 floors a ring's travel so a zero never divides
local MIN_TRAVEL = 0.05
-- the share of a zone aimed into, centred, so answers spread across it without grazing an edge
local AIM_SHARE = 0.6
-- zones narrower than these (a turn fraction, degrees) are treated as absent
local MIN_SPAN = 1e-4
local MIN_ANGLE = 0.05

local function finite(value)
    return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

-- signed turns per second; HarvestTimingClient.lua:661 reads a missing Direction as 1
local function rate(round)
    local direction = round.Direction
    if direction == nil then direction = 1 end
    if not finite(direction) or not finite(round.Speed) then return nil end
    local value = direction * round.Speed
    if value == 0 then return nil end
    return value
end

function M.validRound(round)
    return type(round) == "table" and round.Id ~= nil and finite(round.StartTime) and finite(round.StartPos)
        and finite(round.RedStart) and finite(round.RedSize) and rate(round) ~= nil
end

-- HarvestTimingClient.lua:661-662
function M.pointerAt(round, t)
    local elapsed = t - round.StartTime
    if elapsed < 0 then elapsed = 0 end
    return (round.StartPos + (rate(round) or 0) * elapsed) % 1
end

-- HarvestTimingClient.lua:668-678, red tested before green as the client does
function M.judgeStrike(round, t, open)
    local pos = M.pointerAt(round, t)
    local redGrace = (type(open) == "table" and tonumber(open.RedGrace)) or 0
    local greenGrace = (type(open) == "table" and tonumber(open.GreenGrace)) or 0
    if (pos - (round.RedStart - redGrace)) % 1 <= round.RedSize + 2 * redGrace then return "Critical" end
    if finite(round.GreenStart) and finite(round.GreenSize)
        and (pos - (round.GreenStart - greenGrace)) % 1 <= round.GreenSize + 2 * greenGrace then
        return "Hit"
    end
    return "Miss"
end

-- the first server time at or after notBefore that the pointer sits on target (a fraction of a turn); never before StartTime
function M.timeAt(round, target, notBefore)
    if not M.validRound(round) or not finite(target) then return nil end
    local turns = rate(round)
    local speed = math.abs(turns)
    local sign = 1
    if turns < 0 then sign = -1 end
    local t = round.StartTime + (((target - round.StartPos) * sign) % 1) / speed
    if finite(notBefore) and t < notBefore then
        local period = 1 / speed
        t = t + math.ceil((notBefore - t) / period) * period
    end
    return t
end

-- a uniform point in the middle share of a span, so no answer sits on an edge or dead on a centre
local function inner(start, span, roll)
    return start + span * ((1 - AIM_SHARE) / 2 + AIM_SHARE * roll)
end

-- the arcs of one zone left after cutting another out of it, both as (start, span) in turns on the circle
local function cut(start, span, holeStart, holeSpan)
    local offset = (holeStart - start) % 1
    local holes
    if offset + holeSpan <= 1 then
        holes = { { offset, offset + holeSpan } }
    else
        holes = { { offset, 1 }, { 0, offset + holeSpan - 1 } }
    end
    local pieces = { { 0, math.min(span, 1) } }
    for _, hole in ipairs(holes) do
        local kept = {}
        for _, piece in ipairs(pieces) do
            if hole[2] <= piece[1] or hole[1] >= piece[2] then
                kept[#kept + 1] = piece
            else
                if hole[1] > piece[1] then kept[#kept + 1] = { piece[1], hole[1] } end
                if hole[2] < piece[2] then kept[#kept + 1] = { hole[2], piece[2] } end
            end
        end
        pieces = kept
    end
    local arcs = {}
    for _, piece in ipairs(pieces) do
        if piece[2] - piece[1] > MIN_SPAN then arcs[#arcs + 1] = { start + piece[1], piece[2] - piece[1] } end
    end
    return arcs
end

-- one arc, chosen in proportion to its length
local function pickArc(arcs, rand)
    local total = 0
    for _, arc in ipairs(arcs) do total = total + arc[2] end
    local roll = rand() * total
    for _, arc in ipairs(arcs) do
        if roll < arc[2] then return arc end
        roll = roll - arc[2]
    end
    return arcs[#arcs]
end

-- where on the turn to strike: inside red (with its grace) for a crit, else inside green but clear of red for a plain hit; with no such green it aims for the crit, never a miss
function M.aimStrike(round, open, wantCrit, rand)
    local redGrace = (type(open) == "table" and tonumber(open.RedGrace)) or 0
    local greenGrace = (type(open) == "table" and tonumber(open.GreenGrace)) or 0
    local redStart, redSpan = round.RedStart - redGrace, round.RedSize + 2 * redGrace
    if not wantCrit and finite(round.GreenStart) and finite(round.GreenSize) then
        local arcs = cut(round.GreenStart - greenGrace, round.GreenSize + 2 * greenGrace, redStart, redSpan)
        if #arcs > 0 then
            local arc = pickArc(arcs, rand)
            return inner(arc[1], arc[2], rand()) % 1, "Hit"
        end
    end
    return inner(redStart, redSpan, rand()) % 1, "Critical"
end

function M.validRing(ring)
    return type(ring) == "table" and ring.Id ~= nil and finite(ring.StartTime) and finite(ring.Travel)
        and finite(ring.GapCenter) and (ring.Spin == nil or finite(ring.Spin))
end

function M.ringTravel(ring)
    return math.max(ring.Travel, MIN_TRAVEL)
end

-- HarvestRingsClient.lua:376-380: reported on the first frame the ring has fully closed
function M.ringDue(ring)
    return ring.StartTime + M.ringTravel(ring)
end

-- HarvestRingsClient.lua:371: the gap stops turning once the ring lands
function M.gapAt(ring, t)
    local elapsed = t - ring.StartTime
    if elapsed < 0 then elapsed = 0 end
    return ring.GapCenter + (ring.Spin or 0) * math.min(elapsed, M.ringTravel(ring))
end

function M.ringAngle(ring)
    return M.gapAt(ring, M.ringDue(ring)) % 360
end

-- where to point at the close: inside the crit band around the resting gap, else in the gap clear of that band; whichever exists, never outside the gap
function M.aimRing(ring, wantCrit, rand)
    local half = tonumber(ring.GapHalf) or 0
    local band = math.min(half * (tonumber(ring.CritShare) or 0), half)
    local canCrit, canHit = band > MIN_ANGLE, half - band > MIN_ANGLE
    local offset, kind = 0, "Critical"
    if canCrit and (wantCrit or not canHit) then
        offset = inner(-band, 2 * band, rand())
    elseif canHit then
        local side = 1
        if rand() < 0.5 then side = -1 end
        offset, kind = side * inner(band, half - band, rand()), "Hit"
    end
    return (M.ringAngle(ring) + offset) % 360, kind
end

-- HarvestRingsClient.lua:382; the crit band (GapHalf * CritShare around the centre) is inferred, the client never draws it
function M.judgeRing(ring, pointer, t)
    local off = math.abs((pointer - M.gapAt(ring, t) + 180) % 360 - 180)
    local half = tonumber(ring.GapHalf) or 0
    if off <= half * (tonumber(ring.CritShare) or 0) then return "Critical" end
    if off <= half then return "Hit" end
    return "Miss"
end

return M

end)
