__bundle_register("Utility/Helpers/Players", function(require, _LOADED, __bundle_register, __bundle_modules)
-- pure player/character lookups — no ctx, no state

local Services = require("Services")
local Players  = Services.Players

local M = {}

-- display name match wins over username
function M.findByName(name)
    if type(name) ~= "string" or name == "" then return nil end
    local lower = name:lower()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.DisplayName:lower() == lower then return plr end
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name:lower() == lower then return plr end
    end
    return nil
end

-- HumanoidRootPart preferred, then PrimaryPart, then any BasePart descendant
function M.getRootPart(model)
    if not (model and model.Parent) then return nil end
    return model:FindFirstChild("HumanoidRootPart")
        or model.PrimaryPart
        or model:FindFirstChildWhichIsA("BasePart")
end

function M.getHumanoid(model)
    if not (model and model.Parent) then return nil end
    return model:FindFirstChildOfClass("Humanoid")
end

return M

end)
__bundle_register("Api/Attach/Session", function(require, _LOADED, __bundle_register, __bundle_modules)
-- attach sessions: scoped handles that pin one instance, hand back every setting they borrowed, and release ownership when they end

local M = {}

function M.new(deps)
    local Controls = deps.Controls
    local Engine   = deps.Engine
    local signal   = deps.signal

    local owner, current = nil, nil

    -- advisory, not a lock: it stops two farms fighting over the engine, it does not shut the ui out
    local function claim(id)
        id = tostring(id or "anonymous")
        if owner ~= nil and owner ~= id then
            return nil, "already claimed by " .. owner
        end
        owner = id
        local released = false
        return function()
            if released then return end
            released = true
            if owner == id then owner = nil end
        end
    end

    local function open(instance, opts)
        if typeof(instance) ~= "Instance" or not instance.Parent then
            return nil, "instance invalid"
        end
        opts = (type(opts) == "table") and opts or {}

        if current then current:Detach("replaced") end

        local release = nil
        if opts.owner ~= nil then
            local fn, err = claim(opts.owner)
            if not fn then return nil, err end
            release = fn
        end

        -- only what the caller actually overrode is captured, so an untouched setting is never written back
        local restore = {}
        if type(opts.offset) == "table" then
            restore.offset = Controls.getOffset()
            Controls.setOffset(opts.offset)
        end
        if opts.retarget ~= nil then
            restore.retarget = Controls.getRetarget()
            Controls.setRetarget(opts.retarget)
        end
        if opts.mover ~= nil then
            restore.mover = Controls.getMover()
            Controls.setMover(opts.mover)
        end

        local ok, err = Controls.setExplicit(instance, { name = opts.name, group = opts.group })
        if not ok then
            if release then release() end
            return nil, err or "instance invalid"
        end

        local startedEngine = false
        if opts.autoStart ~= false and not Engine.IsRunning() then
            Engine.Start()
            startedEngine = true
        end

        local session = { OnLost = signal() }
        local alive, conns = true, {}

        function session:GetTarget() return instance end
        function session:IsActive() return alive and Controls.getExplicit() == instance end
        function session:SetOffset(offset) if alive then Controls.setOffset(offset) end end

        function session:Detach(reason)
            if not alive then return end
            alive = false
            for i = #conns, 1, -1 do
                conns[i]:Disconnect()
                conns[i] = nil
            end
            if Controls.getExplicit() == instance then Controls.setExplicit(nil) end
            if restore.offset then Controls.setOffset(restore.offset) end
            if restore.retarget then Controls.setRetarget(restore.retarget) end
            if restore.mover then Controls.setMover(restore.mover) end
            if release then
                release()
                release = nil
            end
            if startedEngine and opts.autoStop ~= false and Engine.IsRunning() then Engine.Stop() end
            if current == session then current = nil end
            self.OnLost:Fire(tostring(reason or "detached"))
        end

        -- the engine only drops the explicit target once it has given up on it, so that is the real end of the session
        conns[#conns + 1] = Engine.Lost:Connect(function(_, reason)
            if alive and Controls.getExplicit() ~= instance then session:Detach(reason or "lost") end
        end)
        conns[#conns + 1] = Engine.Stopped:Connect(function()
            if alive then session:Detach("engine stopped") end
        end)

        current = session
        return session
    end

    return {
        Open     = open,
        Claim    = claim,
        GetOwner = function() return owner end,
        GetCurrent = function() return current end,
    }
end

return M

end)
__bundle_register("Api/Attach/Selection", function(require, _LOADED, __bundle_register, __bundle_modules)
-- attach selection: owns the candidate list, the user's picks and the priority order that resolves them into one live target

local VMath = require("Utility/Helpers/VMath")

local M = {}

local LOST_GRACE = 4.0  -- seconds an invalid target is held onto; a player who dies comes back on the same handle

function M.new(deps)
    local Groups    = deps.Groups
    local Targeting = deps.Targeting

    local group         = Groups.First() or "Players"
    local retarget      = "removed"
    local followNearest = false

    local picks    = {}    -- name -> true, the targets the user ticked
    local explicit = nil   -- { instance, name, group } from AttachTo; outranks everything else
    local memory   = nil   -- { instance, name, group, position }, what to find again after a blink out or respawn
    local manual   = false -- a fresh pick should preempt the target we are already holding

    local explicitInvalidSince, activeInvalidSince = nil, nil

    local list, byName, names = {}, {}, {}

    local function invalidReason(candidate)
        return Targeting.invalidReason(candidate, retarget == "health")
    end

    local function isValid(candidate)
        return candidate ~= nil and invalidReason(candidate) == nil
    end

    -- rebuilds the list; the second return is false when the names are unchanged, so the ui only redraws on real churn
    local function refresh()
        local def = Groups.Get(group)
        list = (def and def.gather(def)) or {}
        table.sort(list, function(a, b) return tostring(a.name) < tostring(b.name) end)

        local changed = #list ~= #names
        local fresh = table.create(#list)
        table.clear(byName)
        for i, candidate in ipairs(list) do
            byName[candidate.name] = candidate
            fresh[i] = candidate.name
            if not changed and names[i] ~= candidate.name then changed = true end
        end
        names = fresh
        return fresh, changed
    end

    local function nearest(fromPart, filter)
        local best, bestDist = nil, math.huge
        for _, candidate in ipairs(list) do
            if (filter == nil or filter(candidate)) and isValid(candidate) then
                local dist = Targeting.distanceSqr(fromPart, candidate)
                if dist < bestDist then best, bestDist = candidate, dist end
            end
        end
        return best
    end

    local function isPicked(candidate)
        return picks[candidate.name] == true
    end

    local function explicitCandidate()
        if not explicit then return nil end
        return Targeting.fromInstance(explicit.instance, explicit.name, explicit.group)
    end

    -- the remembered instance first, then the same name in the same group nearest to where it was standing
    local function recall(fromPart)
        if not memory then return nil end

        local direct = Targeting.fromInstance(memory.instance, memory.name, memory.group)
        if isValid(direct) then return direct end

        local best, bestDist = nil, math.huge
        for _, candidate in ipairs(list) do
            if (memory.group == nil or candidate.group == memory.group)
                and (memory.name == nil or candidate.name == memory.name)
                and isValid(candidate)
            then
                local root = Targeting.getRoot(candidate)
                local dist = math.huge
                if root then
                    dist = memory.position and VMath.distanceSqr3(root.Position, memory.position)
                        or Targeting.distanceSqr(fromPart, candidate)
                end
                if dist < bestDist then best, bestDist = candidate, dist end
            end
        end
        return best
    end

    local function remember(candidate)
        local token = Targeting.token(candidate)
        if typeof(token) ~= "Instance" or not token.Parent then return end
        local root = Targeting.getRoot(candidate)
        memory = {
            instance = token,
            name     = Targeting.getName(candidate),
            group    = candidate.group,
            position = root and root.Position or nil,
        }
    end

    -- an invalid target is kept for a moment before it is given up on, so a death or a stream-out is not a retarget
    local function withinGrace(since)
        return since ~= nil and (os.clock() - since) < LOST_GRACE
    end

    -- returns the target to hold this tick, plus a { name, reason } the engine should report as a loss
    local function resolve(fromPart, active)
        local lost = nil

        if explicit then
            local candidate = explicitCandidate()
            if isValid(candidate) then
                explicitInvalidSince = nil
                return candidate, nil
            end

            explicitInvalidSince = explicitInvalidSince or os.clock()
            if withinGrace(explicitInvalidSince) then
                return candidate or active, nil
            end

            -- the engine reports the loss for a target it already held, so only speak up for one it never reached
            if not Targeting.same(active, candidate) then
                lost = {
                    name   = explicit.name or (candidate and candidate.name) or "Target",
                    reason = (candidate and invalidReason(candidate)) or "target gone",
                }
            else
                -- same target: hand the countdown to the sticky branch instead of restarting it there
                activeInvalidSince = activeInvalidSince or explicitInvalidSince
            end
            explicit, explicitInvalidSince = nil, nil
        end

        if not (manual and not followNearest) and active ~= nil then
            if isValid(active) then
                activeInvalidSince, memory = nil, nil
                return active, lost
            end

            activeInvalidSince = activeInvalidSince or os.clock()
            if withinGrace(activeInvalidSince) then
                return active, lost
            end

            lost = lost or { name = Targeting.getName(active), reason = invalidReason(active) or "target gone" }
            remember(active)
            activeInvalidSince = nil
        end

        local remembered = recall(fromPart)
        if remembered then
            memory = nil
            return remembered, lost
        end

        if followNearest then
            return nearest(fromPart, nil), lost
        end

        local picked = nearest(fromPart, isPicked)
        if picked then
            manual = false
            return picked, lost
        end

        return nil, lost
    end

    local function setGroup(keyOrLabel)
        local key = Groups.Resolve(keyOrLabel)
        if not key or key == group then return false end
        -- picks are names inside one group, so carrying them across would silently target the wrong thing
        group, picks, manual = key, {}, false
        activeInvalidSince = nil
        refresh()
        return true
    end

    -- takes the array the api documents or the name -> bool map obsidian's multi dropdown hands back
    local function setPicks(source)
        local fresh = {}
        if type(source) == "table" then
            for key, value in pairs(source) do
                local name = (type(key) == "number") and value or key
                local on = (type(key) == "number") or value == true
                if on and type(name) == "string" then fresh[name] = true end
            end
        end
        picks = fresh
        manual = next(picks) ~= nil
    end

    local function pickOne(name)
        if not byName[name] then return false end
        picks, manual = { [name] = true }, true
        return true
    end

    local function setExplicit(inst, meta)
        explicitInvalidSince = nil
        if inst == nil then
            explicit = nil
            return true
        end
        if typeof(inst) ~= "Instance" or not inst.Parent then return false, "instance invalid" end
        meta = (type(meta) == "table") and meta or {}
        explicit = { instance = inst, name = meta.name, group = meta.group }
        manual = true
        return true
    end

    return {
        Refresh       = refresh,
        Resolve       = resolve,
        Remember      = remember,
        Forget        = function() memory = nil end,
        InvalidReason = invalidReason,

        SetGroup      = setGroup,
        SetPicks      = setPicks,
        PickOne       = pickOne,
        SetExplicit   = setExplicit,
        SetRetarget   = function(mode)
            retarget = (tostring(mode or ""):lower() == "removed") and "removed" or "health"
        end,
        SetFollowNearest = function(on)
            followNearest = on == true
            if followNearest then manual = false end
        end,

        GetGroup    = function() return group end,
        GetRetarget = function() return retarget end,
        GetExplicit = function() return explicit and explicit.instance or nil end,
        FollowsNearest = function() return followNearest end,
        GetNames    = function() return table.move(names, 1, #names, 1, table.create(#names)) end,
        GetPicks    = function()
            local out = {}
            for name in pairs(picks) do out[name] = true end
            return out
        end,
    }
end

return M

end)
__bundle_register("Api/Attach/Runtime", function(require, _LOADED, __bundle_register, __bundle_modules)
-- attach runtime: the character-scoped overrides attach needs while it runs, reapplied on every respawn and restored on stop

local M = {}

function M.new(deps)
    local Helpers    = deps.Helpers
    local NewMaid    = deps.NewMaid
    local References = deps.References

    local options = { autoRotate = true, noclip = true, invisicam = true }
    local maid, stopping = nil, false

    local function holdCharacter(char)
        if not options.autoRotate then return end
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.AutoRotate = false end
    end

    local function start()
        if maid then return end
        -- maid first: every override registers its own restore as it lands, so a failure part-way still unwinds
        maid = NewMaid()

        if options.noclip then
            Helpers.startNoclip()
            maid:GiveTask(function() Helpers.stopNoclip() end)
        end

        if options.autoRotate then
            maid:GiveTask(function()
                local hum = References.humanoid
                if hum and hum.Parent then hum.AutoRotate = true end
            end)
        end

        if options.invisicam then
            local player = References.player
            local previous = player.DevCameraOcclusionMode

            local function force()
                if stopping then return end
                player.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Invisicam
            end

            force()
            -- a changed-signal instead of a per-frame write: catches the game re-setting it at no frame cost
            maid:GiveTask(player:GetPropertyChangedSignal("DevCameraOcclusionMode"):Connect(force))
            maid:GiveTask(function() player.DevCameraOcclusionMode = previous end)
        end

        -- fires for the live character straight away, so this covers both the current one and every respawn
        maid:GiveTask(References.onCharacter(holdCharacter))
    end

    local function stop()
        if not maid then return end
        stopping = true
        pcall(function() maid:DoCleaning() end)
        maid, stopping = nil, false
    end

    -- forks that must not touch the camera or collisions narrow the override set before starting
    local function configure(overrides)
        if type(overrides) ~= "table" then return false end
        for key, value in pairs(overrides) do
            if options[key] ~= nil then options[key] = value == true end
        end
        return true
    end

    return {
        Start     = start,
        Stop      = stop,
        Configure = configure,
        IsActive  = function() return maid ~= nil end,
    }
end

return M

end)
__bundle_register("Api/Attach/Placement", function(require, _LOADED, __bundle_register, __bundle_modules)
-- attach placement: turns the live target into the cframe the character should hold, slewing the offset and riding out brief gaps in the target's own cframe

local M = {}

local DEFAULT_OFFSET = { right = 0, up = 8, forward = 0 }
local OFFSET_SLEW    = 240   -- studs/second the applied offset may chase the requested one; a jump trips physics snapback
local CFRAME_GRACE   = 4     -- seconds the last good cframe is reused while the target reports none
local BASIS_VELOCITY = 1.25  -- studs/second of target motion before the offset frame follows travel instead of facing
local FLAT_EPSILON   = 0.01  -- below this the offset is effectively straight up, so facing falls back to the basis

function M.new(deps)
    local Targeting = deps.Targeting

    local requested = { right = DEFAULT_OFFSET.right, up = DEFAULT_OFFSET.up, forward = DEFAULT_OFFSET.forward }
    local applied   = { right = DEFAULT_OFFSET.right, up = DEFAULT_OFFSET.up, forward = DEFAULT_OFFSET.forward }

    local basisToken, basisLook = nil, nil
    local lastDesired, blindSince = nil, nil

    local function copyOf(source)
        return { right = source.right, up = source.up, forward = source.forward }
    end

    local function setOffset(a, b, c)
        local source = (type(a) == "table") and a or { right = a, up = b, forward = c }
        requested.right   = tonumber(source.right)   or requested.right
        requested.up      = tonumber(source.up)      or requested.up
        requested.forward = tonumber(source.forward) or requested.forward
    end

    local function approach(current, target, maxStep)
        local delta = target - current
        if math.abs(delta) <= maxStep then return target end
        return current + ((delta > 0) and maxStep or -maxStep)
    end

    -- dt-scaled so the slew rate is the same at 30fps and 240fps
    local function step(dt)
        local maxStep = OFFSET_SLEW * math.max(tonumber(dt) or 0, 0)
        if maxStep <= 0 then return end
        applied.right   = approach(applied.right,   requested.right,   maxStep)
        applied.up      = approach(applied.up,      requested.up,      maxStep)
        applied.forward = approach(applied.forward, requested.forward, maxStep)
    end

    -- the frame the offset is expressed in: the target's facing when first seen, switching to its travel direction once it moves
    local function basisOf(candidate, targetCf)
        local token = Targeting.token(candidate)
        if not token then return targetCf end

        if basisToken ~= token or not basisLook then
            basisToken = token
            local look = targetCf.LookVector
            local flat = Vector3.new(look.X, 0, look.Z)
            basisLook = (flat.Magnitude < FLAT_EPSILON) and Vector3.new(0, 0, -1) or flat.Unit
        end

        local root = Targeting.getRoot(candidate)
        if root then
            local velocity = root.AssemblyLinearVelocity
            local flat = Vector3.new(velocity.X, 0, velocity.Z)
            if flat.Magnitude >= BASIS_VELOCITY then basisLook = flat.Unit end
        end

        return CFrame.lookAt(targetCf.Position, targetCf.Position + basisLook, Vector3.yAxis)
    end

    local function desired(candidate)
        local targetCf = Targeting.getCFrame(candidate)
        if not targetCf then
            blindSince = blindSince or os.clock()
            if lastDesired and (os.clock() - blindSince) <= CFRAME_GRACE then return lastDesired end
            return nil
        end
        blindSince = nil

        local basis = basisOf(candidate, targetCf)
        local origin = targetCf.Position
            + basis.RightVector * applied.right
            + Vector3.yAxis * applied.up
            + basis.LookVector * applied.forward

        -- upright and turned toward the target: a character pitched face-down at a target below it reads as an anomaly
        local toTarget = Vector3.new(targetCf.Position.X - origin.X, 0, targetCf.Position.Z - origin.Z)
        local facing = (toTarget.Magnitude > FLAT_EPSILON) and toTarget.Unit or basis.LookVector
        lastDesired = CFrame.lookAt(origin, origin + facing, Vector3.yAxis)
        return lastDesired
    end

    local function reset()
        basisToken, basisLook = nil, nil
        lastDesired, blindSince = nil, nil
    end

    return {
        Step       = step,
        Desired    = desired,
        Reset      = reset,
        SetOffset  = setOffset,
        GetOffset  = function() return copyOf(requested) end,
        GetDefault = function() return copyOf(DEFAULT_OFFSET) end,
        HasFix     = function() return lastDesired ~= nil end,
    }
end

return M

end)
__bundle_register("Api/Attach/Movers", function(require, _LOADED, __bundle_register, __bundle_modules)
-- attach movers: the interchangeable ways to hold the character on a placement cframe, so a fork that cannot afford cframe writes can swap the pin instead of forking the engine

local Str = require("Utility/Helpers/Str")

local M = {}

local function zeroVelocity(part)
    part.AssemblyLinearVelocity = Vector3.zero
    part.AssemblyAngularVelocity = Vector3.zero
end

local function pinCFrame(hrp, cf)
    hrp.CFrame = cf
    zeroVelocity(hrp)
end

-- a mover def is { key, label, available() -> bool, new(deps) -> { hold, release } }; hold runs every tick and owns its own change detection
function M.new(deps)
    local NewMaid = deps.NewMaid

    -- hrp children replicate to the server, so the constraint names carry no brand string
    local moverName = "_at" .. Str.randomHex(8)

    local defs, order = {}, {}

    local function register(def)
        if type(def) ~= "table" then return false end
        if type(def.key) ~= "string" or def.key == "" then return false end
        if type(def.new) ~= "function" then return false end
        if not defs[def.key] then order[#order + 1] = def.key end
        defs[def.key] = {
            key       = def.key,
            label     = tostring(def.label or def.key),
            available = (type(def.available) == "function") and def.available or function() return true end,
            new       = def.new,
        }
        return true
    end

    -- the target owns our physics rep, so the server reads a carried player rather than a teleporting one
    register({
        key   = "physics",
        label = "Physics Rep",
        available = function() return type(sethiddenproperty) == "function" end,
        new = function()
            local pinnedRoot, pinnedHrp = nil, nil
            return {
                hold = function(hrp, cf, targetRoot)
                    pinCFrame(hrp, cf)
                    if not targetRoot then return end
                    -- the property lives on our root, so a respawn needs it set again even for the same target
                    if pinnedRoot ~= targetRoot or pinnedHrp ~= hrp then
                        pcall(sethiddenproperty, hrp, "PhysicsRepRootPart", targetRoot)
                        pinnedRoot, pinnedHrp = targetRoot, hrp
                    end
                    pcall(zeroVelocity, targetRoot)
                end,
                release = function(hrp)
                    if hrp and hrp.Parent and pinnedRoot then
                        pcall(sethiddenproperty, hrp, "PhysicsRepRootPart", nil)
                    end
                    pinnedRoot, pinnedHrp = nil, nil
                end,
            }
        end,
    })

    -- the same pin without the hidden property, for executors that do not expose it
    register({
        key   = "cframe",
        label = "Direct",
        new = function()
            return {
                hold = function(hrp, cf) pinCFrame(hrp, cf) end,
                release = function() end,
            }
        end,
    })

    -- no cframe writes at all: constraints drag the character there, for games that watch for position jumps
    register({
        key   = "align",
        label = "Constraints",
        new = function()
            local bound, bin, position, orientation = nil, nil, nil, nil

            local function teardown()
                if bin then bin:DoCleaning() end
                bound, bin, position, orientation = nil, nil, nil, nil
            end

            local function build(hrp)
                teardown()
                bin = NewMaid()

                for _, child in ipairs(hrp:GetChildren()) do
                    if child.Name == moverName then child:Destroy() end
                end

                local attachment = Instance.new("Attachment")
                attachment.Name = moverName
                attachment.Parent = hrp
                bin:GiveTask(attachment)

                position = Instance.new("AlignPosition")
                position.Name = moverName
                position.Mode = Enum.PositionAlignmentMode.OneAttachment
                position.Attachment0 = attachment
                position.ApplyAtCenterOfMass = true
                position.Responsiveness = 200
                -- finite constants rather than math.huge: an infinite-force constraint is a known anti-cheat heuristic
                position.MaxForce = 1e7
                position.MaxVelocity = 1e4
                position.Parent = hrp
                bin:GiveTask(position)

                orientation = Instance.new("AlignOrientation")
                orientation.Name = moverName
                orientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
                orientation.Attachment0 = attachment
                orientation.Responsiveness = 200
                orientation.RigidityEnabled = true
                orientation.MaxTorque = 1e7
                orientation.Parent = hrp
                bin:GiveTask(orientation)

                bound = hrp
            end

            return {
                hold = function(hrp, cf)
                    if bound ~= hrp or not (position and position.Parent) then build(hrp) end
                    position.Position = cf.Position
                    orientation.CFrame = cf
                end,
                release = teardown,
            }
        end,
    })

    local function get(key)
        return (type(key) == "string") and defs[key] or nil
    end

    -- takes a key or a display label; an unknown or unsupported one degrades to the best supported mover
    local function resolve(keyOrLabel)
        local def = get(keyOrLabel)
        if not def and type(keyOrLabel) == "string" then
            for _, key in ipairs(order) do
                if defs[key].label == keyOrLabel then
                    def = defs[key]
                    break
                end
            end
        end
        if def and def.available() then return def end
        for _, other in ipairs(order) do
            if defs[other].available() then return defs[other] end
        end
        return nil
    end

    local function create(key)
        local def = resolve(key)
        if not def then return nil end
        return def.new({ NewMaid = NewMaid }), def
    end

    local function list()
        local out = {}
