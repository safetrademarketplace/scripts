__bundle_register("Features/Clover/PlayerUtils/AttributeHold", function(require, _LOADED, __bundle_register, __bundle_modules)
-- attribute hold: keeps one attribute on the local character at a wanted value while the game keeps resetting it, follows every respawn, and puts back what it changed on release
local M = {}

-- spec: attribute, value to hold, only (replace just this one value), restore = "clear" to remove it on release instead of putting back the first value seen
function M.new(References, spec)
    local attribute = spec.attribute
    local held      = spec.value
    local only      = spec.only
    local clear     = spec.restore == "clear"

    local prior = setmetatable({}, { __mode = "k" })
    local active = false
    local charConn, unsubscribe = nil, nil

    local function hold(char)
        local current = char:GetAttribute(attribute)
        if not clear and prior[char] == nil then prior[char] = { value = current } end
        if current == held or (only ~= nil and current ~= only) then return end
        if clear then prior[char] = {} end
        char:SetAttribute(attribute, held)
    end

    local function watch(char)
        if charConn then charConn:Disconnect() end
        hold(char)
        -- the game resets it (a hard landing, a cast running out, every accepted roll), so put it straight back
        charConn = char:GetAttributeChangedSignal(attribute):Connect(function() hold(char) end)
    end

    local function release()
        if unsubscribe then unsubscribe(); unsubscribe = nil end
        if charConn then charConn:Disconnect(); charConn = nil end
        for char, p in pairs(prior) do
            if char.Parent then char:SetAttribute(attribute, p.value) end
        end
        table.clear(prior)
    end

    local api = {}

    function api.set(on)
        on = on == true
        if on == active then return end
        active = on
        if on then
            -- fires at once for the current character, then on every respawn
            unsubscribe = References.onCharacter(watch)
        else
            release()
        end
    end

    function api.stop()
        api.set(false)
    end

    return api
end

return M

end)
