        getName        = getName,
        token          = token,
        same           = same,
        fromInstance   = fromInstance,
        distanceSqr    = distanceSqr,
        invalidReason  = invalidReason,
        uniqueName     = uniqueName,
        gatherPlayers  = gatherPlayers,
        gatherEntities = gatherEntities,
    }
end

return M

