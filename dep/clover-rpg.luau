end)
__bundle_register("Api/Attach/Engine", function(require, _LOADED, __bundle_register, __bundle_modules)
-- attach engine: the tick loop that resolves a target, holds the character on it through the active mover, and reports every transition as a signal

local Scheduler = require("Utility/Scheduler")

local M = {}

local REFRESH_SECONDS = 0.5  -- candidate list rebuild cadence
local DEFAULT_MOVER   = "physics"

function M.new(deps)
    local Movers     = deps.Movers
    local Placement  = deps.Placement
    local References = deps.References
    local Runtime    = deps.Runtime
    local Selection  = deps.Selection
    local Targeting  = deps.Targeting
    local base       = deps.base
    local maid       = deps.maid

    local signals = {
        Started        = base.signal(),
        Stopped        = base.signal(),
        Attached       = base.signal(),
        Lost           = base.signal(),
        TargetChanged  = base.signal(),
        TargetsChanged = base.signal(),
    }

    local running, autoRefresh = false, false
    local active, attached = nil, false
    local mover, moverKey = nil, nil
    local tickHandle = nil

    -- SessionLifecycle owns these handles, so read through and revalidate rather than writing them back
    local function localRoot()
        local hrp = References.humanoidRootPart
        if hrp and hrp.Parent then return hrp end
        local char = References.player and References.player.Character
        hrp = char and char:FindFirstChild("HumanoidRootPart")
        return (hrp and hrp.Parent) and hrp or nil
    end

    local function setMover(key)
        local def = Movers.Resolve(key)
        if not def then return false end
        if def.key == moverKey and mover then return true end
        if mover then mover.release(localRoot()) end
        local instance = Movers.Create(def.key)
        if not instance then
            mover, moverKey = nil, nil
            return false
        end
        mover, moverKey = instance, def.key
        return true
    end

    -- release is for a target going away, never for one switching: every mover rebinds itself inside hold
    local function clearTarget(hrp, release)
        local name = active and Targeting.getName(active) or nil
        active, attached = nil, false
        if release and mover then mover.release(hrp) end
        return name
    end

    local function tick(dt)
        local hrp = localRoot()
        if not hrp then
            -- mid-respawn: keep the target in mind so the next character picks it straight back up
            if active then Selection.Remember(active) end
            return
        end
        if not mover then return end

        Placement.Step(dt)

        local target, lost = Selection.Resolve(hrp, active)
        if lost then signals.Lost:Fire(lost.name, lost.reason) end

        if not target then
            local previous = clearTarget(hrp, true)
            if previous then signals.TargetChanged:Fire(previous, nil, nil) end
            return
        end

        if not Targeting.same(active, target) then
            local previous = clearTarget(hrp, false)
            active = target
            Placement.Reset()
            Selection.Forget()
            local name = Targeting.getName(target)
            base.log("target -> %s", name)
            signals.TargetChanged:Fire(previous, name, target)
        end

        -- selection hands back an invalid target while its grace window runs; hold the slot but do not pin to a corpse
        if Selection.InvalidReason(active) then
            attached = false
            return
        end

        local desired = Placement.Desired(active)
        if not desired then return end

        mover.hold(hrp, desired, Targeting.getRoot(active))
        if not attached then
            attached = true
            signals.Attached:Fire(Targeting.getName(active), active)
        end
    end

    local function start()
        if running then return false end
        running = true
        Placement.Reset()
        Runtime.Start()
        base.log("start")

        -- the outer xpcall keeps the traceback and stops a transient step error from striking the task out
        tickHandle = Scheduler.heartbeat(function(dt)
            local ok, err = xpcall(tick, function(e) return debug.traceback(tostring(e), 2) end, dt)
            if not ok then base.warn("tick failed: %s", tostring(err)) end
        end, { name = "AttachStep", priority = 50 })

        signals.Started:Fire()
        return true
    end

    local function stop()
        if not running then return false end
        running = false
        if tickHandle then
            tickHandle:Disconnect()
            tickHandle = nil
        end
        clearTarget(localRoot(), true)
        Runtime.Stop()
        base.log("stop")
        signals.Stopped:Fire()
        return true
    end

    -- one deferrable low-priority task covers both the ui list and the engine's own candidate pool
    maid:GiveTask(Scheduler.heartbeat(function()
        if not (running or autoRefresh) then return end
        local ok, names, changed = pcall(Selection.Refresh)
        if not ok then
            base.warn("target refresh failed: %s", tostring(names))
            return
        end
        if changed then signals.TargetsChanged:Fire(names) end
    end, { name = "AttachTargets", priority = 200, interval = REFRESH_SECONDS, deferrable = true }))

    maid:GiveTask(References.onCharacterRemoving(function()
        if running and active then Selection.Remember(active) end
        clearTarget(nil, false)
        if mover then mover.release(nil) end
    end))

    maid:GiveTask(function() stop() end)

    setMover(DEFAULT_MOVER)
    Selection.Refresh()

    return {
        Started        = signals.Started,
        Stopped        = signals.Stopped,
        Attached       = signals.Attached,
        Lost           = signals.Lost,
        TargetChanged  = signals.TargetChanged,
        TargetsChanged = signals.TargetsChanged,

        Start     = start,
        Stop      = stop,
        IsRunning = function() return running end,

        SetMover = setMover,
        GetMover = function() return moverKey end,

        -- the ui turns this on while it is mounted; off, the list only rebuilds while attach is actually running
        SetAutoRefresh = function(on) autoRefresh = on == true end,

        -- rebuilds and announces unconditionally, for when the groups themselves changed rather than the world
        PublishTargets = function()
            local names = Selection.Refresh()
            signals.TargetsChanged:Fire(names)
            return names
        end,

        GetActiveTarget = function() return active end,

        GetStatus = function()
            local target = nil
            if active then
                local inst = Targeting.token(active)
                target = {
                    name     = Targeting.getName(active),
                    instance = (typeof(inst) == "Instance") and inst or nil,
                    group    = active.group,
                }
            end
            return {
                running       = running,
                attached      = running and attached and Placement.HasFix(),
                target        = target,
                group         = Selection.GetGroup(),
                retarget      = Selection.GetRetarget(),
                followNearest = Selection.FollowsNearest(),
                mover         = moverKey,
                offset        = Placement.GetOffset(),
            }
        end,
    }
end

return M

end)
__bundle_register("Api/Parry", function(require, _LOADED, __bundle_register, __bundle_modules)
-- parry api: parries mob attacks as they land off the tells the game leaks to every client (live 2026-10-24): a mob's model takes State_Swinging as a plain swing starts and State_SkillActive as a special starts, its attack animation starts with it, and a special's strike arrives as Remotes.Client.NPCVFX phase 1; every attack (the mob's kind and the animation it plays) keeps its own delay from tell to strike, learned off the strike vfx, the parries that land and every strike that reaches us, blocked or not (each one stamps StateEnd_NoHealthRegen on the character), and the press goes out that long after the tell less the ping and a lead, falling back to a roll's i-frames or a held block when the game refuses the parry; an attack never seen before is blocked from its tell until it lands rather than parried on a guess, and learned from that; incoming() tells a fight when the next strike is due so it never swings into one; one engine for every consumer (the auto parry box, the farms), running while any of them asks; shared as ctx.Api.Parry
local References = require("References")
local Scheduler  = require("Utility/Scheduler")
local Store      = require("Utility/Store")
local Api        = require("Api")
local Errors     = require("Api/Parry/Errors")

local SWINGING, SKILL = "State_Swinging", "State_SkillActive"
local NPC_VFX, SWORD = "Client/NPCVFX", "Sword"
-- measured on wolves: a swing's tell to its hit 1.00 s, a special's 0.98 s; anything never seen starts from these
local DEFAULT_DELAY = { Swinging = 1.0, SkillActive = 0.98 }
-- the press is meant to reach the server this far ahead of the strike, earlier again by how much the attack's timing wanders, and GetNetworkPing is the round trip
-- live 2026-10-24 on wolves: presses 0.08-0.20 s ahead all parried, every hit that got through was pressed under 0.05 s ahead of a strike that came early
local LEAD     = 0.12
local PING_CAP = 0.5
local SPREAD_START, SPREAD_CAP = 0.05, 0.2
-- the press is held this long, so a strike later than the parry window still lands on a block
local PRESS_HOLD = 0.35
-- a new sample's weight against what was learned, and the spread a sample has to sit in to count
local LEARN = 0.3
local SAMPLE_MIN, SAMPLE_MAX = 0.12, 2.5
-- once a move is settled, a strike this far off what it learned is another mob's (live 2026-10-24: two wolves at once taught a 0.9 s bite 0.41 s and the next press went out early); only a run of them in a row is taken as the move really changing
local SETTLED, OUTLIER, OUTLIER_RUN = 3, 0.25, 3
-- an attack's animation starts within this of its tell; a threat is forgotten this long after its tell
local ANIM_PAIR   = 0.15
local THREAT_LIFE = 3
-- presses this close together are one press, and a parry confirmed this soon after a press is that press's
local COALESCE = 0.25
local CONFIRM  = 0.6
-- a refused parry falls back to a block held this long past the strike
local BLOCK_HOLD = 0.3
-- an attack with nothing learned is blocked this soon after its tell (pressing block opens a 0.25 s parry window first, live 2026-10-24) and held until it lands, or this long at most
local GUARD_REACT = 0.08
local GUARD_LIMIT = 2.6
-- every strike that reaches the character, blocked or not, stamps this (live 2026-10-24: a blocked wolf bite moved it with no health lost)
local STRUCK = "StateEnd_NoHealthRegen"
local LABEL_AFTER = 0.15
local WATCH_EVERY = 0.4
local WATCH_SLACK = 30
local WATCH_LIMIT = 30
local SAVE_EVERY  = 10
local STORE_KEY   = "moves"
local HISTORY     = 30

local M = {}

local function finite(n)
    return type(n) == "number" and n == n and n > -math.huge and n < math.huge
end

local function noop() end

function M.new(ctx)
    local base = Api.define("Parry", ctx)
    local api = { Errors = Errors }
    local namespace = Store.GAME .. "/parry"

    local closed = false
    local requests, tokens = {}, 0
    local offset = 0
    local moves = {}
    local dirty, savedAt = false, os.clock()
    local stats = { pressed = 0, parried = 0, rolled = 0, blocked = 0, hits = 0, guarded = 0, ignored = 0 }
    local watched, watchCount = {}, 0
    local threats = {}
    local history = {}
    local hooks = {}
    local running = false
    local blockUntil = nil
    local lastPress = -math.huge
    local health = { humanoid = nil, conn = nil, last = nil, char = nil, struckConn = nil }
    local parrySignal = base.signal()

    local function apiOf(name)
        local found = ctx.Api and ctx.Api[name]
        if type(found) == "table" then return found end
        return nil
    end

    local function settle(label, ok, ...)
        if ok then return ... end
        base.warn("%s threw: %s", label, tostring((...)))
        return false, Errors.NOT_READY
    end

    local function expose(name, fn)
        local label = "Parry." .. name
        api[name] = function(...)
            if closed then return false, Errors.NOT_READY end
            return settle(label, pcall(fn, ...))
        end
    end

    local function listenable(signal)
        local facade = {}
        function facade.Connect(a, b)
            local fn = b
            if type(a) == "function" then fn = a end
            if type(fn) ~= "function" or closed then return { Disconnect = noop, Destroy = noop } end
            local inner = signal:Connect(fn)
            local function disconnect() inner:Disconnect() end
            return { Disconnect = disconnect, Destroy = disconnect }
        end
        return facade
    end

    -- ===== learned delays =====

    local function load()
        local saved = Store.read(namespace, STORE_KEY, {})
        if type(saved) ~= "table" then return end
        for key, entry in pairs(saved) do
            if type(key) == "string" and type(entry) == "table" and finite(entry.delay) and finite(entry.samples)
                and entry.delay >= SAMPLE_MIN and entry.delay <= SAMPLE_MAX then
                local spread = finite(entry.spread) and math.min(math.max(entry.spread, 0), SPREAD_CAP) or SPREAD_START
                moves[key] = { delay = entry.delay, spread = spread, samples = math.floor(entry.samples) }
            end
        end
    end

    local function save(force)
        if not dirty then return end
        if not force and os.clock() - savedAt < SAVE_EVERY then return end
        dirty, savedAt = false, os.clock()
        local out = {}
        for key, entry in pairs(moves) do out[key] = { delay = entry.delay, spread = entry.spread, samples = entry.samples } end
        Store.write(namespace, STORE_KEY, out)
    end

    local function learn(key, sample)
        if not (finite(sample) and sample >= SAMPLE_MIN and sample <= SAMPLE_MAX) then return end
        local entry = moves[key]
        if entry == nil then
            moves[key] = { delay = sample, spread = SPREAD_START, samples = 1 }
        elseif entry.samples >= SETTLED and math.abs(sample - entry.delay) > math.max(OUTLIER, entry.spread * 3)
            and (entry.odd or 0) + 1 < OUTLIER_RUN then
            entry.odd = (entry.odd or 0) + 1
            stats.ignored = stats.ignored + 1
            return
        else
            entry.odd = 0
            -- how far the strikes wander from the learned delay, so the press can go out ahead of the early ones
            entry.spread = math.min(entry.spread * (1 - LEARN) + math.abs(sample - entry.delay) * LEARN, SPREAD_CAP)
            entry.delay = entry.delay * (1 - LEARN) + sample * LEARN
            entry.samples = entry.samples + 1
        end
        dirty = true
    end

    local function keyOf(threat)
        return threat.base .. "/" .. (threat.anim or threat.kind)
    end

    -- the learned delay and how far it wanders; an attack never seen goes off its mob's other attack of the kind, else the default
    local function timingOf(threat)
        local entry = moves[keyOf(threat)] or moves[threat.base .. "/" .. threat.kind]
        if entry then return entry.delay, entry.spread end
        return DEFAULT_DELAY[threat.kind] or DEFAULT_DELAY.Swinging, SPREAD_START
    end

    local function delayOf(threat)
        return (timingOf(threat))
    end

    -- whether anything of this attack is known; a guess is never pressed on
    local function known(threat)
        return moves[keyOf(threat)] ~= nil or moves[threat.base .. "/" .. threat.kind] ~= nil
    end

    -- one sample per strike, whichever signal saw it first
    local function strike(threat, now)
        if threat.learned then return end
        threat.learned = true
        threat.landed = threat.landed or (now - threat.tell)
        learn(keyOf(threat), now - threat.tell)
        -- a guard is let go once what it was held for has landed
        if threat.guarded and blockUntil then blockUntil = math.min(blockUntil, now + BLOCK_HOLD) end
    end

    -- ===== who may be parried =====

    local function character()
        local State = apiOf("State")
        if not State then return nil end
        local ok, char = State.character()
        if ok then return char end
        return nil
    end

    local function rootPosition()
        local State = apiOf("State")
        if not State then return nil end
        local ok, root = State.root()
        if ok and root then return root.Position end
        return nil
    end

    local function widest()
        local range = 0
        for _, request in pairs(requests) do
            if request.range > range then range = request.range end
        end
        return range
    end

    -- the request that covers a mob this far away, if any; the first that does decides roll and block
    local function coverFor(model, gap)
        for _, request in pairs(requests) do
            if gap <= request.range then
                local fits = true
                if request.filter then
                    local ok, answer = pcall(request.filter, model)
                    fits = ok and answer == true
                end
                if fits then return request end
            end
        end
        return nil
    end

    local function ping()
        local ok, value = pcall(function() return References.player:GetNetworkPing() end)
        if ok and finite(value) and value > 0 then return math.min(value, PING_CAP) end
        return 0
    end

    -- ===== tells =====

    local function onTell(entry, kind)
        local here = rootPosition()
        if not here then return end
        local ok, gap = pcall(function() return (entry.root.Position - here).Magnitude end)
        if not ok then return end
        local request = coverFor(entry.model, gap)
        if not request then return end
        local now = os.clock()
        local threat = { model = entry.model, base = entry.base, kind = kind, tell = now, request = request }
        -- the animation can start in the same frame as the attribute, before it
        if entry.anim and now - entry.anim.at <= ANIM_PAIR then threat.anim = entry.anim.id end
        threats[#threats + 1] = threat
    end

    local function onAnim(entry, track)
        local ok, id = pcall(function() return track.Animation and track.Animation.AnimationId:match("%d+") end)
        if not ok or not id then return end
        local now = os.clock()
        entry.anim = { id = id, at = now }
        for i = #threats, 1, -1 do
            local threat = threats[i]
            if threat.model == entry.model and not threat.anim and not threat.pressed and now - threat.tell <= ANIM_PAIR then
