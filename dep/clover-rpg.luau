__bundle_register("Features/Clover/Notifications/Server", function(require, _LOADED, __bundle_register, __bundle_modules)
-- alerts, the server: a server event starting, a raid starting (a place the go-to button can head for while the raid is still listed) and the game's announcements, each told once
local RaidStarted = require("Api/Webhook/Events/RaidStarted")
local ServerEvent = require("Api/Webhook/Events/ServerEvent")
local Watch       = require("Api/Webhook/Events/Watch")
local Words       = require("Api/Webhook/Events/Words")

-- CustomChat.Client.load.lua:412-415 shows Announcement's text in chat; NotifyClient.lua:589-601 gives a "Significant" game event the big flourish
local ANNOUNCEMENT = "Announcement"
local GAME_EVENTS = "gameEvents"
local SIGNIFICANT = "Significant"
-- the same event name starting again inside this is the same event
local EVENT_AGAIN = 120
local RAID_TOLD_FOR = 1800
local ANNOUNCE_AGAIN = 30

local M = {}

function M.new(deps)
    local Services, feed = deps.Services, deps.feed
    local source = {}
    local eventsHandle, raidsHandle, announceHandles = nil, nil, nil

    local function eventLine(event)
        local name = Words.plain(event.name) or "a server event"
        if event.timer and event.timer > 0 then
            return ("A server event started: %s (%s left)."):format(name, Words.duration(event.timer))
        end
        return ("A server event started: %s."):format(name)
    end

    local function onEvent(event)
        feed.post({
            kind     = "serverEvent",
            subject  = event.name,
            cooldown = EVENT_AGAIN,
            text     = eventLine(event),
            event    = ServerEvent,
            facts    = event,
        })
    end

    function source.setEvents(on)
        if on and eventsHandle == nil then
            local running = Watch.serverEvent()
            if running then
                feed.mark("serverEvent", running.name, EVENT_AGAIN)
                feed.notify(("Server event alerts are on. %s is on right now."):format(Words.plain(running.name) or "A server event"))
            else
                feed.notify("Server event alerts are on. No server event is on right now.")
            end
            eventsHandle = Watch.serverEvents(onEvent)
        elseif not on and eventsHandle ~= nil then
            eventsHandle:Disconnect()
            eventsHandle = nil
        end
    end

    local function raidPlace(facts)
        local raid = facts.raid
        local label = facts.where and ("the raid in %s"):format(facts.where) or "the raid"
        return {
            key    = raid,
            label  = label,
            check  = function()
                if raid.Parent == nil then return false, ("%s has ended"):format(label) end
                return true
            end,
            target = facts.position,
        }
    end

    local function onRaid(raid)
        local facts = RaidStarted.facts(raid)
        feed.post({
            kind     = "raid",
            subject  = facts.raid,
            cooldown = RAID_TOLD_FOR,
            text     = facts.where and ("A raid started in %s."):format(facts.where) or "A raid started.",
            place    = facts.position and raidPlace(facts) or nil,
            event    = RaidStarted,
            facts    = facts,
        })
    end

    function source.setRaids(on)
        if on and raidsHandle == nil then
            local names = {}
            local raids = Watch.activeRaids()
            for index = #raids, 1, -1 do
                local facts = RaidStarted.facts(raids[index])
                feed.mark("raid", facts.raid, RAID_TOLD_FOR)
                if facts.position then feed.remember(raidPlace(facts)) end
                table.insert(names, 1, facts.where or "somewhere unknown")
            end
            if #names == 0 then
                feed.notify("Raid alerts are on. No raid is going on right now.")
            else
                feed.notify(("Raid alerts are on. Raids going on right now: %s."):format(Words.list(names)))
            end
            raidsHandle = Watch.raids(onRaid)
        elseif not on and raidsHandle ~= nil then
            raidsHandle:Disconnect()
            raidsHandle = nil
        end
    end

    local function announce(text)
        local shown = Words.plain(text)
        if shown == nil then return end
        feed.post({
            kind     = "announcement",
            subject  = shown,
            cooldown = ANNOUNCE_AGAIN,
            text     = ("Announcement: %s"):format(shown),
            title    = "Announcement",
        })
    end

    local function remote(name)
        return function()
            local remotes = Services.ReplicatedStorage:FindFirstChild("Remotes")
            local found = remotes and remotes:FindFirstChild(name)
            if found ~= nil and found:IsA("RemoteEvent") then return found end
            return nil
        end
    end

    function source.setAnnouncements(on)
        if on and announceHandles == nil then
            announceHandles = {
                Watch.follow("announcements", remote(ANNOUNCEMENT), function(event, links)
                    links:GiveTask(event.OnClientEvent:Connect(announce))
                end),
                -- every other kind is a small alert about you alone, which the game already shows
                Watch.follow("gameEvents", remote(GAME_EVENTS), function(event, links)
                    links:GiveTask(event.OnClientEvent:Connect(function(text, kind)
                        if kind == SIGNIFICANT then announce(text) end
                    end))
                end),
            }
        elseif not on and announceHandles ~= nil then
            for _, watch in ipairs(announceHandles) do watch:Disconnect() end
            announceHandles = nil
        end
    end

    function source.stop()
        source.setEvents(false)
        source.setRaids(false)
        source.setAnnouncements(false)
    end

    return source
end

return M

end)
__bundle_register("Api/Webhook/Events/Words", function(require, _LOADED, __bundle_register, __bundle_modules)
-- clover words: how the alerts tab and the clover webhook posts say things in plain english (a player's name, a place by the name the map shows, a time, a list), with server text stripped of rich text tags since a notice renders rich text
local Api = require("Api")

local M = {}

-- "<b>Hi</b> <3" -> "Hi 3"; nil for anything that leaves nothing to show
function M.plain(text)
    if type(text) ~= "string" then return nil end
    local out = string.gsub(text, "<[^<>]*>", "")
    out = string.gsub(out, "[<>]", "")
    out = string.gsub(out, "^%s+", "")
    out = string.gsub(out, "%s+$", "")
    if out == "" then return nil end
    return out
end

-- "a game admin" -> "A game admin"
function M.capital(text)
    text = tostring(text or "")
    return string.upper(string.sub(text, 1, 1)) .. string.sub(text, 2)
end

-- "BroomFlying" -> "Broom Flying"
function M.readable(name)
    local out = string.gsub(tostring(name or ""), "_", " ")
    out = string.gsub(out, "(%l)(%u)", "%1 %2")
    return out
end

-- "Display (@name)", or the name alone when the two match
function M.player(name, displayName)
    name = M.plain(name) or "Someone"
    local shown = M.plain(displayName)
    if shown == nil or shown == name then return name end
    return ("%s (@%s)"):format(shown, name)
end

function M.count(n, one, many)
    return ("%d %s"):format(n, n == 1 and one or many)
end

-- "45 seconds", "3 minutes", "1 hour 5 minutes"
function M.duration(seconds)
    seconds = math.max(0, math.floor((tonumber(seconds) or 0) + 0.5))
    if seconds < 60 then return M.count(seconds, "second", "seconds") end
    local minutes = math.floor(seconds / 60 + 0.5)
    if minutes < 60 then return M.count(minutes, "minute", "minutes") end
    local hours = math.floor(minutes / 60)
    local rest = minutes - hours * 60
    if rest == 0 then return M.count(hours, "hour", "hours") end
    return ("%s %s"):format(M.count(hours, "hour", "hours"), M.count(rest, "minute", "minutes"))
end

-- "A", "A and B", "A, B and C", "A, B, C and 2 more"
function M.list(names, most)
    most = most or 3
    local n = #names
    if n == 0 then return "" end
    if n == 1 then return names[1] end
    if n <= most then return table.concat(names, ", ", 1, n - 1) .. " and " .. names[n] end
    return ("%s and %d more"):format(table.concat(names, ", ", 1, most), n - most)
end

-- whole numbers bare, anything else to one decimal
function M.number(value)
    value = tonumber(value) or 0
    if value == math.floor(value) then return ("%d"):format(value) end
    return ("%.1f"):format(value)
end

function M.signed(value)
    value = tonumber(value) or 0
    if value > 0 then return "+" .. M.number(value) end
    return M.number(value)
end

-- a zone's name as the map shows it
function M.zone(name)
    if type(name) ~= "string" or name == "" then return nil end
    local World = Api.get("World")
    local ok, list = false, nil
    if World ~= nil then ok, list = World.locations() end
    if ok and type(list) == "table" then
        for _, zone in ipairs(list) do
            if zone.name == name then return M.plain(zone.displayName) or M.plain(name) end
        end
    end
    return M.plain(name)
end

-- "Kamo Village" (the game's zone under the point), else "the Kamo region", else nil
function M.where(position)
    if typeof(position) ~= "Vector3" then return nil end
    local World = Api.get("World")
    if World == nil then return nil end
    local ok, zone = World.locationAt(position)
    if ok and zone ~= nil then return M.zone(zone) end
    local okRegion, region = World.regionAt(position)
    if okRegion and type(region) == "string" then return ("the %s region"):format(region) end
    return nil
end

-- where the local player is: the zone the game shows, else by position
function M.here()
    local State = Api.get("State")
    if State == nil then return nil end
    local ok, name = State.location()
    if ok and name ~= nil then return M.zone(name) end
    local okRoot, root = State.root()
    if okRoot and root ~= nil then return M.where(root.Position) end
    return nil
end

return M

end)
__bundle_register("Api", function(require, _LOADED, __bundle_register, __bundle_modules)
-- api framework + boot orchestrator: scoped logger, safe-call helpers, shared signal, unload-wired maid per api; Api.build instantiates the manifest into ctx.Api

local Log = require("Utility/Log")

-- requires must be string literals for the static bundler, and deferred in loaders so Api/<Name> can require this module back without a circular-load deadlock
local LOADERS = {
    -- transport first: every game api below reaches the network through it
    { name = "CloverNet", load = function() return require("Api/CloverNet") end },
    -- read model next: movers and drivers gate on its readiness and can-act checks
    { name = "State",     load = function() return require("Api/State") end },
    -- the map index before anything that moves or interacts, so movers can stream legs through it
    { name = "World",     load = function() return require("Api/World") end },
    { name = "Interact",  load = function() return require("Api/Interact") end },
    -- the only sanctioned way to move the character: tweened routes, never walking or jumping in one step
    { name = "Movement",  load = function() return require("Api/Movement") end },
    -- after the mover, which the combat drivers never touch but features pair with
    { name = "Combat",    load = function() return require("Api/Combat") end },
    -- gathering drives prompts through Interact, so it loads after it
    { name = "Professions", load = function() return require("Api/Professions") end },
    -- reads the quest folders and the giver templates; accepting and handing in go through CloverNet
    { name = "Quests",  load = function() return require("Api/Quests") end },
    -- what you carry and selling it; loot bags and picking them up, which fires prompts through Interact
    { name = "Inventory", load = function() return require("Api/Inventory") end },
    { name = "Loot",    load = function() return require("Api/Loot") end },
    -- after State, whose death signal it times the respawn screen from
    { name = "Respawn", load = function() return require("Api/Respawn") end },
    -- races are flown by features through Movement; the api only talks to the race server
    { name = "Racing",  load = function() return require("Api/Racing") end },
    -- after Combat, whose parry, roll and block it presses, and World, whose mobs it watches
    { name = "Parry",   load = function() return require("Api/Parry") end },
    { name = "Attach",  load = function() return require("Api/Attach") end },
    { name = "Esp",     load = function() return require("Api/Esp") end },
    { name = "Webhook", load = function() return require("Api/Webhook") end },
    { name = "KeyCheck", load = function() return require("Api/KeyCheck") end },
    { name = "Link",    load = function() return require("Api/Link") end },
}

local Api = {}

-- Fire pcalls every subscriber so one bad handler can't break the emit
function Api.signal()
    local subs = {}
    local sig = {}
    function sig:Connect(fn)
        if type(fn) ~= "function" then return { Disconnect = function() end } end
        local token = {}
        subs[token] = fn
        return { Disconnect = function() subs[token] = nil end }
    end
    function sig:Fire(...)
        for _, fn in pairs(subs) do pcall(fn, ...) end
    end
    return sig
end

local function newMaid(ctx)
    if type(ctx.NewMaid) == "function" then return ctx.NewMaid() end
    if ctx.Maid and type(ctx.Maid.new) == "function" then return ctx.Maid.new() end
    return nil
end

-- per-api base; maid cleanup registers with the session unloader so an api never leaks on unload
function Api.define(name, ctx)
