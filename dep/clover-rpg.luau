    if resolver then return end
    resolver = Jobs.spawn(function(job)
        while requested and job.alive do
            requested = false
            resolve(job)
        end
        resolver = nil
    end, { name = "LiveConsole" })
end

local function flush(entry)
    if not write(entry) then schedule() end
end

-- printing the real text is what makes a reopen safe: a bind that never lands costs the color, never the line
local function emit(entry)
