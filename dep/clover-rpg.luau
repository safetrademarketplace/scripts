    local watch = M.follow("raids", raidFolder, function(folder, links)
        local known = setmetatable({}, { __mode = "k" })
        for _, raid in ipairs(folder:GetChildren()) do known[raid] = true end
        links:GiveTask(folder.ChildAdded:Connect(function(raid)
            if known[raid] then return end
            known[raid] = true
            fire(raidEntry(raid))
