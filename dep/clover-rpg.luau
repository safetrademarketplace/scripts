        for _, item in ipairs(list) do
            if item.sellable and settings.sellItems[item.name] and not keep[item.name] and item.stock > 0 then
                local okSell, earned = Inventory.sell(item.name, "SellAll")
                if okSell then
                    kit.add("sold", item.stock)
                    if type(earned) == "number" and earned > 0 then kit.add("marks", earned) end
                end
            end
        end
    end

    -- the brain's step does one piece of work (a fight, a trip, a gather) and returns; the loop around it handles death and faults
    local function loop(r, job)
        r.thread = coroutine.running()
        local kit = makeKit(r, job)
        local faults = 0
        while not kit.stopped() do
            local alive = aliveNow()
            if alive == false then
                if not revive(r, kit) then return end
                local okBags, bagErr = pcall(recoverBags, kit)
                if not okBags and deps.warn then deps.warn("death bag pickup threw: %s", tostring(bagErr)) end
                if kit.stopped() then return end
            elseif alive == nil then
                kit.status("Waiting for your character.")
                if not kit.sleep(1) then return end
            else
                if settings.autoSell and os.clock() >= (r.nextSell or 0) then
                    r.nextSell = os.clock() + SELL_EVERY
                    local okSell, sellErr = pcall(sellPass, kit)
                    if not okSell and deps.warn then deps.warn("auto sell threw: %s", tostring(sellErr)) end
                end
                local ok, err = pcall(r.brain.step, kit)
                if kit.stopped() then return end
                if ok then
                    faults = 0
                else
                    faults = faults + 1
                    if deps.warn then deps.warn("%s step threw (%d of %d): %s", r.name, faults, MAX_FAULTS, tostring(err)) end
                    if faults >= MAX_FAULTS then
                        engine.stop("fault")
                        return
                    end
                    if not kit.sleep(FAULT_PAUSE) then return end
                end
            end
            if not kit.sleep(0) then return end
        end
    end

    -- one farm at a time: starting one stops whichever was running
    function engine.start(name, brain)
        engine.stop("switched")
        local Movement = api("Movement")
        if not Movement then return false, "no_movement" end
        local ok, token = Movement.claim(name)
        if not ok then return false, token end
        local r = { name = name, brain = brain, token = token, deathTimes = {}, hooks = {}, status = "Starting..." }
        run = r
        if not engine.stats.startedAt then engine.stats.startedAt = os.clock() end
        if brain.begin then pcall(brain.begin) end
        r.job = track(Jobs.spawn(function(job) loop(r, job) end, { name = "Farm." .. name }))
        if not r.job then
            run = nil
            release(r)
            return false, "no_job"
        end
        changed()
        return true
    end

    return engine
end

return M

end)
__bundle_register("Features/Clover/Farm/Bosses", function(require, _LOADED, __bundle_register, __bundle_modules)
-- boss farm brain: hunts the bosses you pick at their spawns, which it knows without them being streamed in: the spots a full sweep of the map found (built in), every boss the world api has seen since (it remembers each one that streams in, across sessions) and where quests point; a boss it still has no spot for is searched for by sweeping the map on the broom. It fights each with the mob farm's fighting, picks up what it drops, and makes the rounds of the spots while the bosses respawn
local Services = require("Services")
local Mobs     = require("Features/Clover/Farm/Mobs")

local M = {}

-- a picked boss streamed in this close is fought straight away
local SEARCH = 2500
-- a spot is reached to this close, watched this long for its boss, and looked at again this long after it was found empty
local SPOT_REACH = 40
local LOOK_TIME  = 6
local RECHECK    = 90
-- a spot is looked over from this far above it on the broom: landing at every one cost the 8 s broom cooldown on the way to the next (the user, 2026-10-24: "we keep losing our broom")
local SPOT_HOVER = 40
-- a boss's drop is looked for this close to where it fell, for this long
local LOOT_RADIUS = 45
local LOOT_WAIT   = 5
-- a boss with no known spot is searched for over the regions in rows this far apart (live 2026-10-24: a Dire Wolf streamed in from ~700 studs), flown this high over the ground
local SWEEP_STEP  = 1000
local SWEEP_ABOVE = 150
-- with the ground there still not streamed in, over the tallest peak (Aether's Peak, ~1,144)
local SWEEP_HIGH  = 1300
-- where sweeping the regions and visiting the named places found each boss (live 2026-10-24), before anything was learned; the Elk roams, the Dire Wolf keeps to Old Fang's Den under the terrain by the skull, Aldric is always streamed in
local KNOWN = {
    ["Dire Wolf"]             = { Vector3.new(800, -32, 152), Vector3.new(791, -25, 232) },
    ["Wandering Elk"]         = { Vector3.new(4646, 207, 3856), Vector3.new(4546, 215, 3677), Vector3.new(5153, 297, -548) },
    ["Aldric the Unmastered"] = { Vector3.new(1243, 244, -4469) },
    ["Holda the Witch"]       = { Vector3.new(-902, 88, 1303) },
    ["Raven Blackwood"]       = { Vector3.new(-1778, 51, -13) },
}

local function distance(a, b)
    return (a - b).Magnitude
end

local function flatDistance(a, b)
    local dx, dz = a.X - b.X, a.Z - b.Z
    return math.sqrt(dx * dx + dz * dz)
end

local function chosenList(set)
    local out = {}
    for name, on in pairs(set) do
        if on then out[#out + 1] = name end
    end
    table.sort(out)
    return out
end

local function spotKey(name, position)
    return ("%s@%d,%d"):format(name, math.floor(position.X / 25), math.floor(position.Z / 25))
end

local function rootOf(mob)
    local ok, position = pcall(function() return mob.root.Position end)
    if ok then return position end
    return nil
end

local function dead(mob)
    local ok, gone = pcall(function() return mob.model.Parent == nil or mob.humanoid.Health <= 0 end)
    return not ok or gone
end

-- cfg is the live settings table the menu writes (bosses, a set; loot); shared.mob is the mob farm's settings, which the fighting borrows
function M.new(cfg, shared)
    local brain = {}
    local mobCfg = setmetatable({ names = {} }, { __index = shared.mob })
    local fighter = Mobs.new(mobCfg)
    local checked, seeds = {}, nil
    local fighting = nil
    local sweep, sweepAt = nil, 1

    function brain.begin()
        checked, seeds, fighting = {}, nil, nil
        sweepAt = 1
        fighter.begin()
    end

    -- where the quests say a boss lives ("Hunt the Dire Wolf", "Eliminate Holda the Witch"), learned once
    local function seedFromQuests(kit, names)
        seeds = {}
        local Quests = kit.api("Quests")
        if not Quests then return end
        local ok, list = Quests.repeatables()
        if not ok or type(list) ~= "table" then return end
        for _, template in ipairs(list) do
            for _, task in ipairs(template.tasks or {}) do
                if task.kind == "kill" and task.position then
                    for _, name in ipairs(Quests.matchMobs(task.target, names)) do
                        seeds[name] = seeds[name] or {}
                        table.insert(seeds[name], task.position)
                    end
                end
            end
        end
    end

    local function spotsFor(kit, name)
        local out = {}
        local World = kit.api("World")
        if World then
            local ok, list = World.bossSpots(name)
            if ok and type(list) == "table" then
                for _, spot in ipairs(list) do out[#out + 1] = spot.position end
            end
        end
        for _, position in ipairs(KNOWN[name] or {}) do out[#out + 1] = position end
        for _, position in ipairs(seeds and seeds[name] or {}) do out[#out + 1] = position end
        return out
    end

    -- the regions in rows SWEEP_STEP apart, each row the other way from the last, nearest region first
    local function sweepPoints(kit, here)
        local World = kit.api("World")
        local ok, regions = false, nil
        if World then ok, regions = World.regions() end
        if not ok or type(regions) ~= "table" then return {} end
        table.sort(regions, function(a, b)
            local ca = Vector3.new((a.minX + a.maxX) / 2, here.Y, (a.minZ + a.maxZ) / 2)
            local cb = Vector3.new((b.minX + b.maxX) / 2, here.Y, (b.minZ + b.maxZ) / 2)
            return distance(ca, here) < distance(cb, here)
        end)
        local out = {}
        for _, region in ipairs(regions) do
            local row = 0
            for z = region.minZ + SWEEP_STEP / 2, region.maxZ, SWEEP_STEP do
                row = row + 1
                local xs = {}
                for x = region.minX + SWEEP_STEP / 2, region.maxX, SWEEP_STEP do xs[#xs + 1] = x end
                if row % 2 == 0 then
                    for i = #xs, 1, -1 do out[#out + 1] = Vector3.new(xs[i], 0, z) end
                else
                    for _, x in ipairs(xs) do out[#out + 1] = Vector3.new(x, 0, z) end
                end
            end
        end
        return out
    end

    local sweepParams = nil
    -- the ground is only there to measure once it has streamed in (live 2026-10-24: a fixed height over unstreamed ground ended inside a mountain)
    local function groundAt(kit, point)
        local World = kit.api("World")
        if World then pcall(World.streamAround, Vector3.new(point.X, SWEEP_ABOVE, point.Z)) end
        if not sweepParams then
            sweepParams = RaycastParams.new()
            sweepParams.FilterType = Enum.RaycastFilterType.Exclude
            sweepParams.RespectCanCollide = true
        end
        local okHit, hit = pcall(Services.Workspace.Raycast, Services.Workspace, Vector3.new(point.X, 3000, point.Z), Vector3.new(0, -3500, 0), sweepParams)
        if okHit and hit then return hit.Position.Y + SWEEP_ABOVE end
        return SWEEP_HIGH
    end

    -- high enough for this stop and the next, so the sweep holds a height rather than bobbing over every hill and lake (the user, 2026-10-24)
    local function overGround(kit, point, after)
        local y = groundAt(kit, point)
        if after then y = math.max(y, groundAt(kit, after)) end
        return Vector3.new(point.X, y, point.Z)
    end

    -- one more stop of the sweep; the bosses it passes are remembered by the world api and fought on the next step
    local function search(kit, names, here)
        if not sweep or #sweep == 0 then
            sweep, sweepAt = sweepPoints(kit, here), 1
            if #sweep == 0 then
                kit.status("Can't search for bosses yet: the map regions haven't loaded.")
                kit.sleep(2)
                return
            end
        end
        local point = overGround(kit, sweep[sweepAt], sweep[sweepAt % #sweep + 1])
        kit.status(("Searching the map for %s (%d of %d)."):format(names[1], sweepAt, #sweep))
        sweepAt = sweepAt % #sweep + 1
        kit.travel(point, { air = true, reach = 60 })
    end

    -- the drop of a boss that just fell: a bag nobody else's name is on, picked up where it lies
    local function loot(kit, at)
        local Loot = kit.api("Loot")
        local players = Services.Players
        if not Loot then return end
        local limit = os.clock() + LOOT_WAIT
        while os.clock() < limit do
            local ok, bags = Loot.bags({ origin = at, maxDistance = LOOT_RADIUS })
            local bag = nil
            if ok and type(bags) == "table" then
                for _, entry in ipairs(bags) do
                    local someoneElse = entry.creator ~= nil and entry.creator ~= "" and not entry.mine and players:FindFirstChild(entry.creator) ~= nil
                    if not bag and not someoneElse and entry.items > 0 then bag = entry end
                end
            end
            if bag then
                kit.status("Picking up the boss's drop.")
                local here = kit.position()
                if here and distance(here, bag.position) > 3 then kit.travel(bag.position, { reach = 2.5 }) end
                if kit.flying() then kit.land() end
                local okTake, taken = Loot.collect(bag)
                if okTake and (taken or 0) > 0 then kit.add("looted", taken) end
                return
            end
            if not kit.sleep(0.5) then return end
        end
    end

    function brain.step(kit)
        local names = chosenList(cfg.bosses)
        if #names == 0 then
            kit.status("Pick the bosses to hunt.")
            kit.sleep(1)
            return
        end
        local wanted = {}
        for _, name in ipairs(names) do wanted[name] = true end
        mobCfg.names = wanted
        if seeds == nil then seedFromQuests(kit, names) end
        local World = kit.api("World")
        local here = kit.position()
        if not (World and here) then
            kit.sleep(0.5)
            return
        end

        -- one we were fighting has fallen: counted, and its drop picked up
        if fighting and dead(fighting.mob) then
            kit.add("bosses")
            kit.stats.lastBoss = fighting.mob.name
            local at = fighting.at
            fighting = nil
            if cfg.loot and at then loot(kit, at) end
            return
        end

        local current = fighter.target()
        if not current then
            local ok, list = World.mobs({ names = names, alive = true, origin = here, maxDistance = SEARCH, limit = 1 })
            if ok and type(list) == "table" then current = list[1] end
        end
        if current then
            fighting = fighting or { mob = current }
            if fighting.mob.model ~= current.model then fighting = { mob = current } end
            fighting.at = rootOf(current) or fighting.at
            fighter.step(kit)
            return
        end
        fighting = nil

        -- none about: the nearest spot not looked at lately
        local now = os.clock()
        local best, bestGap, soonest, unknown = nil, math.huge, nil, false
        for _, name in ipairs(names) do
            local spots = spotsFor(kit, name)
            if #spots == 0 then unknown = true end
            for _, position in ipairs(spots) do
                local key = spotKey(name, position)
                local lookedAt = checked[key]
                if not lookedAt or now - lookedAt >= RECHECK then
                    local gap = flatDistance(here, position)
                    if gap < bestGap then best, bestGap = { name = name, position = position, key = key }, gap end
                else
                    local ready = lookedAt + RECHECK
                    if not soonest or ready < soonest then soonest = ready end
                end
            end
        end
        if not best then
            if unknown then return search(kit, names, here) end
            if soonest then
                kit.status(("Waiting for the bosses to come back. Looking again in %ds."):format(math.ceil(soonest - now)))
                kit.sleep(2)
                return
            end
            kit.status("None of the bosses you picked can be found.")
            kit.sleep(2)
            return
        end
        if bestGap > SPOT_REACH then
            kit.status(("Flying to where %s was seen (%d studs away)."):format(best.name, math.floor(bestGap)))
            local ok, why = kit.travel(best.position + Vector3.new(0, SPOT_HOVER, 0), { air = true, reach = SPOT_REACH })
            -- a spot the broom can't hover over (a den under the terrain) is gone to on foot
            if not ok and why ~= "stopped" then kit.travel(best.position, { reach = SPOT_REACH }) end
            return
        end
        kit.status(("Looking for %s here."):format(best.name))
        pcall(World.streamAround, best.position)
        local limit = os.clock() + LOOK_TIME
        while os.clock() < limit do
            local ok, list = World.mobs({ names = names, alive = true, origin = best.position, maxDistance = SEARCH, limit = 1 })
            if ok and type(list) == "table" and list[1] then return end
            if not kit.sleep(0.5) then return end
        end
        checked[best.key] = os.clock()
    end

    return brain
end

return M

end)
