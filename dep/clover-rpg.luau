__bundle_register("Features/Navigation/Teleports", function(require, _LOADED, __bundle_register, __bundle_modules)
-- teleports: glides you anywhere in clover rpg through the movement api, the only mover this game's server accepts (an instant jump gets pulled back) — areas, towns and zones, npcs, shops and services, waypoint gates, shrines, points of interest, the nearest mob or resource, your saved spots and wherever you click

local Identity     = require("Utility/Identity")
local Jobs         = require("Utility/Jobs")
local Log          = require("Utility/Log")
local Mount        = require("Utility/Mount")
local Destinations = require("Features/Navigation/Teleports/Destinations")
local Hunt         = require("Features/Navigation/Teleports/Hunt")
local Places       = require("Features/Navigation/Teleports/Places")
local Settings     = require("Features/Navigation/Teleports/Settings")
local Spots        = require("Features/Navigation/Teleports/Spots")
local Travel       = require("Features/Navigation/Teleports/Travel")
local Waypoints    = require("Features/Navigation/Teleports/Waypoints")

-- the menu's lines are redrawn this often while a trip runs, and this often otherwise
local TICK_MOVING = 0.25
local TICK_IDLE   = 1
-- how often the lists look for places and mobs that have streamed in since
local RELIST_EVERY = 10

return function(ctx)
    local O = Mount.orchestrator(ctx, "Teleports")
    if not O then return end

    local Api     = ctx.Api
    local Library = ctx.Library
    local Options = ctx.Options
    if not (Api and type(Api.Movement) == "table" and type(Api.World) == "table") then
        Log.warn("[Teleports] the movement or world api is missing, so teleports won't load")
        return
    end

    -- a trip's finish is reported from the mover's own thread, which has called the game and lost the identity the menu needs
    local function notify(text)
        if type(text) ~= "string" or text == "" then return end
        Identity.elevate()
        pcall(Library.Notify, Library, text, 4)
    end

    -- declared ahead of travel, which tells the places box the moment a trip starts, stops or ends
    local places, hunt, settings, spots

    local waypoints = Waypoints.new()
    local destinations = Destinations.new({ Api = Api, Waypoints = waypoints })
    local travel = Travel.new({
        Api      = Api,
        notify   = notify,
        -- the stop distance for places; people, shops, gates and resources carry their own
        reach    = function()
            local option = Options.TpReach
            return option and tonumber(option.Value) or nil
        end,
        onChange = function()
            if places then places.status() end
        end,
    })

    local deps = {
        Env           = ctx,
        Api           = Api,
        Options       = Options,
        Toggles       = ctx.Toggles,
        Destinations  = destinations,
        Travel        = travel,
        Waypoints     = waypoints,
        notify        = notify,
        categories    = Destinations.CATEGORIES,
        resourceKinds = Destinations.RESOURCE_KINDS,
    }

    places = Places(deps)
    hunt = Hunt(deps)
    settings = Settings(deps)
    spots = Spots(deps)
    local shown = { places, hunt, spots }

    local nextRelist = os.clock() + RELIST_EVERY
    -- the lines only matter while the menu is open, and every one of them asks the world for something
    O.track(Jobs.interval(TICK_IDLE, function()
        if not Library.Toggled then return end
        local relist = os.clock() >= nextRelist
        if relist then nextRelist = os.clock() + RELIST_EVERY end
        for _, box in pairs(shown) do
            if relist and box.relist then box.relist() end
            box.describe()
        end
    end, {
        name   = "Teleports.describe",
        period = function() return travel.active() and TICK_MOVING or TICK_IDLE end,
    }))

    O.track(ctx.Services.UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if spots then spots.hotkey(input.KeyCode.Name) end
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
            if settings then settings.click() end
        end
    end))

    O.onUnload(travel.kill)
    O.finalize()

    return {}
end

end)
__bundle_register("Features/Navigation/Teleports/Waypoints", function(require, _LOADED, __bundle_register, __bundle_modules)
-- teleport saved spots: the places you saved, in the order you saved them, with the hotkey bound to each, kept in the fork's store under the same file the old waypoint list used so nothing saved before is lost

local Store = require("Utility/Store")

local KEY = "waypoints"

local M = {}

local function toTable(point)
    return { x = point.X, y = point.Y, z = point.Z }
end

local function fromTable(value)
    if type(value) ~= "table" then return nil end
    local x = tonumber(value.x or value.X or value[1])
    local y = tonumber(value.y or value.Y or value[2])
    local z = tonumber(value.z or value.Z or value[3])
    if not (x and y and z) then return nil end
    return Vector3.new(x, y, z)
end

function M.new()
    local store = { list = {}, order = {}, keybinds = {} }

    local saved = Store.read(Store.GAME, KEY, nil)
    if type(saved) == "table" then
        for name, value in pairs(type(saved.list) == "table" and saved.list or {}) do
            local point = type(name) == "string" and fromTable(value) or nil
            if point then store.list[name] = point end
        end
        for _, name in ipairs(type(saved.order) == "table" and saved.order or {}) do
            if store.list[name] and not table.find(store.order, name) then store.order[#store.order + 1] = name end
        end
        -- a spot the order forgot is kept rather than lost, after the ones it remembers
        local stray = {}
        for name in pairs(store.list) do
            if not table.find(store.order, name) then stray[#stray + 1] = name end
        end
        table.sort(stray)
        for _, name in ipairs(stray) do store.order[#store.order + 1] = name end
        for name, key in pairs(type(saved.keybinds) == "table" and saved.keybinds or {}) do
            if store.list[name] then store.keybinds[name] = tostring(key) end
        end
    end

    function store.save()
        local list = {}
        for name, point in pairs(store.list) do list[name] = toTable(point) end
        Store.write(Store.GAME, KEY, { list = list, order = store.order, keybinds = store.keybinds })
    end

    -- a taken name gets " (2)", " (3)" and so on, so saving twice at one place never overwrites
    function store.freeName(base)
        local name, n = base, 1
        while store.list[name] do
            n = n + 1
            name = ("%s (%d)"):format(base, n)
        end
        return name
    end

    function store.add(base, point)
        local name = store.freeName(base)
        store.list[name] = point
        store.order[#store.order + 1] = name
        store.save()
        return name
    end

    function store.remove(name)
        if not store.list[name] then return false end
        store.list[name] = nil
        store.keybinds[name] = nil
        local at = table.find(store.order, name)
        if at then table.remove(store.order, at) end
        store.save()
        return true
    end

    function store.bind(name, key)
        if not store.list[name] then return false end
        store.keybinds[name] = key
        store.save()
        return true
    end

    function store.unbind(name)
        if store.keybinds[name] == nil then return false end
        store.keybinds[name] = nil
        store.save()
        return true
    end

    function store.clearBinds()
        if next(store.keybinds) == nil then return false end
        table.clear(store.keybinds)
        store.save()
        return true
    end

    -- the spot a key is bound to, if any
    function store.boundTo(keyName)
        for name, bound in pairs(store.keybinds) do
            if bound == keyName then return name end
        end
        return nil
    end

    return store
end

return M

end)
__bundle_register("Features/Navigation/Teleports/Travel", function(require, _LOADED, __bundle_register, __bundle_modules)
-- teleport travel: takes you to one destination at a time through the movement api, the only mover this game's server accepts; claims the mover per trip and gives it back when the trip ends or is stopped, never takes it from anything else, and says in plain words how the trip is going

local Words = require("Features/Navigation/Teleports/Words")

local OWNER = "Teleports"

-- what each movement failure means to a player, keyed by the api's own Errors names
local LINES = {
    NOT_READY    = "Travel isn't ready yet. Try again in a moment.",
    BAD_ARGS     = "Couldn't work out where that is. Press Refresh and try again.",
    NO_CHARACTER = "Your character isn't in the world right now.",
    NOT_OWNER    = "Something else took over moving you, so this trip stopped.",
    BUSY         = "Something else is moving you right now. Stop it first, then try again.",
    NO_PATH      = "Couldn't find a way there from here.",
    BLOCKED      = "The way there is blocked, so the trip stopped.",
    CORRECTED    = "The game kept pulling you back, so the trip stopped. Try a slower Travel Speed.",
    INTERRUPTED  = "The game moved you itself (a teleport or a loading screen), so the trip stopped.",
    DIED         = "You died, so the trip stopped.",
    RESPAWNED    = "You respawned, so the trip stopped.",
    TIMED_OUT    = "The trip was taking far too long, so it stopped.",
    CANCELLED    = "Trip stopped.",
}

local FALLBACK = "Something went wrong on the way."
local IDLE = "Not travelling."

local M = {}

M.LINES = LINES
M.OWNER = OWNER

function M.new(deps)
    local Api      = deps.Api
    local notify   = deps.notify
    local reach    = deps.reach
    local onChange = deps.onChange

    local travel = {}
    -- the claim, trip and record of the trip running now; nil between trips
    local current = nil
    local lastLine = IDLE
    -- bumped by every new trip, stop and unload, so a finish report from a trip already replaced says nothing
    local generation = 0

    local function movement()
        local api = Api and Api.Movement
        if type(api) == "table" then return api end
        return nil
    end

    function travel.explain(code)
        local api = movement()
        local errors = api and api.Errors
        if type(errors) == "table" and code ~= nil then
            for name, value in pairs(errors) do
                if value == code then return LINES[name] or FALLBACK end
            end
        end
        return FALLBACK
    end

    -- every start, stop and finish goes through here, so the menu's line changes the moment the trip does
    local function say(text, quiet)
        lastLine = text
        if onChange then onChange() end
        if not quiet then notify(text) end
    end

    -- gives the mover back; release also ends the trip, which then reports a cancel nobody listens for
    local function letGo(trip)
        local api = movement()
        if trip and api then api.release(trip.token) end
    end

    local function finished(mine, record, ok, reason)
        if mine ~= generation or current == nil then return end
        local trip = current
        current = nil
        letGo(trip)
        if ok then
            say(("Arrived at %s."):format(record.label), record.quiet)
        else
            say(travel.explain(reason), false)
        end
    end

    function travel.go(record)
        local api = movement()
        if not api then return say(LINES.NOT_READY) end
        if type(record) ~= "table" or type(record.where) ~= "function" then
            return say("Pick somewhere to go first.")
        end
        local okWhere, position = pcall(record.where)
        if not okWhere or typeof(position) ~= "Vector3" then
            return say(("%s hasn't loaded in yet, so there's nowhere to aim for. Get closer or press Refresh."):format(record.label))
        end

        generation = generation + 1
        local mine = generation

        -- a trip already running keeps its claim and the new one replaces it; otherwise the mover is asked for, never taken
        local token = current and current.token or nil
        if token == nil then
            local okClaim, claimed = api.claim(OWNER)
            if not okClaim then return say(travel.explain(claimed)) end
            token = claimed
        end

        local okMove, trip = api.moveTo(record.where, {
            token  = token,
            reach  = record.reach or reach(),
            onDone = function(ok, reason) finished(mine, record, ok, reason) end,
        })
        if not okMove then
            current = nil
            api.release(token)
            return say(travel.explain(trip))
        end
        current = { token = token, trip = trip, record = record }
        say(("Heading to %s."):format(record.label), true)
        if not record.quiet then notify(("Travelling to %s."):format(record.label)) end
        return true
    end

    function travel.stop()
        generation = generation + 1
        local trip = current
        current = nil
        if not trip then return say("You're not travelling anywhere.") end
        letGo(trip)
        say(LINES.CANCELLED)
    end

    function travel.active()
        return current ~= nil
    end

    -- the live line for the menu: where the trip is going, how far is left and how long that takes, or how the last one ended
    function travel.line()
        if not current then return lastLine end
        local label = current.record.label
        local ok, status = pcall(current.trip.status)
        if not ok or type(status) ~= "table" then return ("Travelling to %s..."):format(label) end
        local state = status.state
        local pulled = tonumber(status.corrections) or 0
        if state == "correcting" or (state == "planning" and pulled > 0) then
            return ("The game pulled you back. Finding another way to %s..."):format(label)
        end
        if state == "planning" then return ("Finding a way to %s..."):format(label) end
        if state == "paused" then return ("Waiting for the game to finish something, then carrying on to %s..."):format(label) end
        if state == "settling" or state == "landing" then return ("Landing at %s..."):format(label) end
        if state == "moving" and type(status.distance) == "number" then
            local line = ("Heading to %s: %s studs left"):format(label, Words.commas(status.distance))
            local speed = tonumber(status.speed)
            if speed and speed > 0 then
                line = line .. (", about %s."):format(Words.duration(math.max(1, status.distance / speed)))
            else
                line = line .. "."
            end
            if pulled > 0 then line = line .. (" Pulled back %s so far."):format(Words.times(pulled)) end
            return line
        end
        return ("Travelling to %s..."):format(label)
    end

    -- for unload: ends the trip and gives the mover back without a word
    function travel.kill()
        generation = generation + 1
        local trip = current
        current = nil
        letGo(trip)
    end

    return travel
end

return M

end)
__bundle_register("Features/Navigation/Teleports/Words", function(require, _LOADED, __bundle_register, __bundle_modules)
-- teleport words: how distances, waits and counts read in the teleports tab's lines, so every box words them the same way

local M = {}

-- 12345.6 -> "12,346"
function M.commas(n)
    local text = tostring(math.floor((tonumber(n) or 0) + 0.5))
    local out = text:reverse():gsub("(%d%d%d)", "%1,"):reverse()
    return (out:gsub("^,", ""))
end

-- whole seconds rounded up, as "45s" or "2m 05s"
function M.duration(seconds)
    seconds = math.max(0, math.ceil(tonumber(seconds) or 0))
    if seconds >= 60 then return ("%dm %02ds"):format(math.floor(seconds / 60), seconds % 60) end
    return ("%ds"):format(seconds)
end

function M.times(n)
    if n == 1 then return "once" end
    if n == 2 then return "twice" end
    return ("%d times"):format(n)
end

return M

end)
