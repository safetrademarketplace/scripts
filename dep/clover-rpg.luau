__bundle_register("Api/CloverNet", function(require, _LOADED, __bundle_register, __bundle_modules)
-- clovernet api: the fork's one way onto the network — packets and queries through the game's live ByteNetMax Packets module, loose remotes by path, a honeypot deny list, a per-second packet cap and restorable server-to-client callback wraps; shared as ctx.Api.CloverNet

local Services = require("Services")
local Executor = require("Utility/Executor")
local Jobs     = require("Utility/Jobs")
local Api      = require("Api")
local Deny     = require("Api/CloverNet/Deny")
local Errors   = require("Api/CloverNet/Errors")

-- the server drops a player's whole frame batch past MAX_BUFFER_SIZE bytes a second (4096 live, about 1 kb of it already the game's), so a runaway feature loop is refused here before it starves the game's own packets; queries drain the same bucket and count too
local DEFAULT_SEND_CAP = 90
local MAX_SEND_CAP     = 500
local CAP_WINDOW       = 1

-- queries and RemoteFunctions both wait forever on a server that never answers
local DEFAULT_TIMEOUT = 10

local MAX_PATH_LENGTH = 200

local NOT_YIELDABLE = "the calling thread cannot yield"

local EVENT_CLASSES = { RemoteEvent = true, UnreliableRemoteEvent = true }

local TREE_PREFIXES = {}
for _, tree in ipairs(Deny.trees) do
    TREE_PREFIXES[#TREE_PREFIXES + 1] = tree .. "/"
end

local DENIED_ARGUMENTS = {}
for remotePath, modes in pairs(Deny.arguments) do
    local set = {}
    for _, mode in ipairs(modes) do set[string.lower(mode)] = true end
    DENIED_ARGUMENTS[remotePath] = set
end

local M = {}

local function validName(value)
    return type(value) == "string" and value:match("^[%a_][%w_]*$") ~= nil
end

local function validTimeout(value)
    return type(value) == "number" and value == value and value > 0 and value < math.huge
end

-- "/"-separated with no empty segment, or nil
local function splitPath(path)
    if type(path) ~= "string" or path == "" or #path > MAX_PATH_LENGTH then return nil end
    local segments = {}
    for segment in (path .. "/"):gmatch("([^/]*)/") do
        if segment == "" then return nil end
        segments[#segments + 1] = segment
    end
    return segments
end

-- deny entries are written without the folder, so "Admin" and "Remotes/Admin" are one remote to the guard
local function denyKey(segments, path)
    if segments[1] == "Remotes" and #segments > 1 then return table.concat(segments, "/", 2) end
    return path
end

local function remoteDenied(key, first)
    if Deny.remotes[key] then return true end
    for i, tree in ipairs(Deny.trees) do
        if key == tree or key:sub(1, #TREE_PREFIXES[i]) == TREE_PREFIXES[i] then return true end
    end
    local modes = DENIED_ARGUMENTS[key]
    if modes ~= nil and type(first) == "string" and modes[string.lower(first)] then return true end
    return false
end

local function packetDenied(ns, name)
    local names = Deny.packets[ns]
    return names ~= nil and names[name] == true
end

-- every touch of a game object is hoisted into a named function so it can run under pcall without a closure per call
local function findChild(parent, name) return parent:FindFirstChild(name) end
local function readProp(instance, key) return instance[key] end
local function setCallback(remote, fn) remote.OnClientInvoke = fn end
local function fireRemote(remote, ...) remote:FireServer(...) end
local function invokeRemote(remote, ...) return remote:InvokeServer(...) end
local function disconnectConnection(conn) conn:Disconnect() end
local function sendPacket(packet, data) packet.send(data) end
local function invokeQuery(query, data) return query.invoke(data) end
local function listenPacket(packet, fn) packet.listen(fn) end
local function packetListeners(packet) return packet.getListeners() end
local function disconnectPacket(packet, fn) packet.disconnect(fn) end

local function child(parent, name)
    local ok, found = pcall(findChild, parent, name)
    if ok then return found end
    return nil
end

local function prop(instance, key)
    local ok, value = pcall(readProp, instance, key)
    if ok then return value end
    return nil
end

local function walk(root, segments)
    local node = root
    for i = 1, #segments do
        node = child(node, segments[i])
        if node == nil then return nil end
    end
    return node
end

local function lookupMember(bus, ns, kind, name)
    local space = bus[ns]
    if type(space) ~= "table" then return nil end
    local members = space[kind]
    if type(members) ~= "table" then return nil end
    return members[name]
end

local function listed(packet, fn)
    local ok, list = pcall(packetListeners, packet)
    return ok and type(list) == "table" and table.find(list, fn) ~= nil
end

function M.new(ctx)
    local base = Api.define("CloverNet", ctx)
    local maid = base.maid

    local api = { Errors = Errors }

    -- the module and the folder are kept once found and never while missing: both can replicate after boot
    local packetsModule, remotesFolder, lastRequireError
    local found = setmetatable({}, { __mode = "v" })
    local wraps = {}
    local closed = false

    local sendCap, defaultTimeout = DEFAULT_SEND_CAP, DEFAULT_TIMEOUT
    -- ring of the last sendCap admission times; the slot about to be overwritten is the oldest
    local stamps, head = {}, 1

    local counters = {
        sends = 0, fires = 0, invokes = 0, calls = 0,
        refused = 0, denied = 0, failed = 0, timeouts = 0,
        listeners = 0, connections = 0, wraps = 0,
    }

    local function hold(item)
        if maid == nil then return nil end
        return maid:GiveTask(item)
    end

    -- releasing a slot runs its task once more, which every handle here treats as a no-op
    local function release(slot, item)
        if maid == nil or slot == nil then return end
        if maid[slot] == item then maid[slot] = nil end
    end

    -- after unload nothing this fork still holds can reach the wire, and a dead generation never reads as ready or hands out a game object
    if maid then maid:GiveTask(function() closed = true end) end

    local function resolveRemotes()
        if remotesFolder then return remotesFolder end
        remotesFolder = child(Services.ReplicatedStorage, "Remotes")
        return remotesFolder
    end

    -- require hands back the game's own cached table, so our sends share its per-heartbeat batch
    local function resolvePackets()
        if packetsModule then return packetsModule end
        local modules = child(Services.ReplicatedStorage, "Modules")
        local instance = modules and child(modules, "Packets")
        if instance == nil then return nil end
        local ok, bus = pcall(require, instance)
        if not ok then
            if tostring(bus) ~= lastRequireError then
                lastRequireError = tostring(bus)
                base.warn("require Packets failed: %s", lastRequireError)
            end
            return nil
        end
        if type(bus) ~= "table" then return nil end
        packetsModule = bus
        return bus
    end

    local function member(kind, ns, name)
        if not validName(ns) or not validName(name) then return nil, Errors.BAD_ARGS end
        if closed then return nil, Errors.NOT_READY end
        local bus = resolvePackets()
        if bus == nil then return nil, Errors.NOT_READY end
        local ok, value = pcall(lookupMember, bus, ns, kind, name)
        if not ok or type(value) ~= "table" then
            if kind == "packets" then return nil, Errors.NO_PACKET end
            return nil, Errors.NO_QUERY
        end
        return value
    end

    -- Remotes/<path> first, then the ReplicatedStorage root; a hit is re-checked for a parent before reuse
    local function resolveRemote(path, segments)
        local cached = found[path]
        if cached ~= nil and prop(cached, "Parent") ~= nil then return cached end
        local folder = resolveRemotes()
        local instance = folder and walk(folder, segments)
        if instance == nil then instance = walk(Services.ReplicatedStorage, segments) end
        if instance == nil then
            if folder == nil then return nil, Errors.NOT_READY end
            return nil, Errors.NO_REMOTE
        end
        found[path] = instance
        return instance
    end

    local function capFull(now)
        local oldest = stamps[head]
        return oldest ~= nil and now - oldest < CAP_WINDOW
    end

    local function stamp(now)
        stamps[head] = now
        head = head % sendCap + 1
    end

    -- validation, the closed gate, the deny list and resolution, in that order, so a honeypot is refused even before anything has loaded
    local function outgoing(path, first)
        local segments = splitPath(path)
        if segments == nil then return nil, Errors.BAD_ARGS end
        if closed then return nil, Errors.NOT_READY end
        if remoteDenied(denyKey(segments, path), first) then
            counters.denied = counters.denied + 1
            return nil, Errors.DENIED
        end
        return resolveRemote(path, segments)
    end

    -- the caller parks on its own thread until the answer or the deadline lands; a late answer resumes a cancelled worker and goes nowhere
    local function await(label, timeout, fn, ...)
        local args = table.pack(...)
        local caller = coroutine.running()
        local outcome, parked, worker, timer = nil, false, nil, nil

        local function settle(result)
            if outcome ~= nil then return end
            outcome = result
            if parked and coroutine.status(caller) == "suspended" then task.defer(caller) end
        end

        worker = Jobs.spawn(function()
            local result = table.pack(pcall(fn, table.unpack(args, 1, args.n)))
            if timer then timer:Cancel() end
            settle(result)
        end, { name = "CloverNet " .. label })
        if worker == nil then
            counters.failed = counters.failed + 1
            return false, Errors.INVOKE_FAILED
        end

        if outcome == nil then
            timer = Jobs.delay(timeout, function()
                worker:Cancel()
                settle(false)
            end, { name = "CloverNet " .. label .. " deadline" })
            if timer == nil then
                worker:Cancel()
                counters.failed = counters.failed + 1
                return false, Errors.INVOKE_FAILED
            end
            parked = true
            while outcome == nil do coroutine.yield() end
            parked = false
        end

        if outcome == false then
            counters.timeouts = counters.timeouts + 1
            base.warn("%s gave up after %ss", label, tostring(timeout))
            return false, Errors.TIMEOUT
        end
        if not outcome[1] then
            counters.failed = counters.failed + 1
            base.warn("%s failed: %s", label, tostring(outcome[2]))
            return false, Errors.INVOKE_FAILED, tostring(outcome[2])
        end
        return true, table.unpack(outcome, 2, outcome.n)
    end

    function api.ready()
        if closed then return false end
        return resolvePackets() ~= nil and resolveRemotes() ~= nil
    end

    function api.packet(ns, name)
        local packet, err = member("packets", ns, name)
        if packet == nil then return false, err end
        return true, packet
    end

    function api.query(ns, name)
        local query, err = member("queries", ns, name)
        if query == nil then return false, err end
        return true, query
    end

    function api.denied(path, ...)
        local segments = splitPath(path)
        if segments == nil then return false end
        return remoteDenied(denyKey(segments, path), (...))
    end

    function api.deniedPacket(ns, name)
        if type(ns) ~= "string" or type(name) ~= "string" then return false end
        return packetDenied(ns, name)
    end

    function api.send(ns, name, data)
        if not validName(ns) or not validName(name) then return false, Errors.BAD_ARGS end
        if closed then return false, Errors.NOT_READY end
        if packetDenied(ns, name) then
            counters.denied = counters.denied + 1
            return false, Errors.DENIED
        end
        local packet, err = member("packets", ns, name)
        if packet == nil then return false, err end
        local now = os.clock()
        if capFull(now) then
            counters.refused = counters.refused + 1
            return false, Errors.RATE_LIMITED
        end
        local ok, sendErr = pcall(sendPacket, packet, data)
        if not ok then
            counters.failed = counters.failed + 1
            base.warn("send %s.%s failed: %s", ns, name, tostring(sendErr))
            return false, Errors.SEND_FAILED, tostring(sendErr)
        end
        stamp(now)
        counters.sends = counters.sends + 1
        return true
    end

    function api.invoke(ns, name, data, timeout)
        if not validName(ns) or not validName(name) then return false, Errors.BAD_ARGS end
        if timeout ~= nil and not validTimeout(timeout) then return false, Errors.BAD_ARGS end
        if closed then return false, Errors.NOT_READY end
        if packetDenied(ns, name) then
            counters.denied = counters.denied + 1
            return false, Errors.DENIED
        end
        local query, err = member("queries", ns, name)
        if query == nil then return false, err end
        if not coroutine.isyieldable() then return false, Errors.INVOKE_FAILED, NOT_YIELDABLE end
        local now = os.clock()
        if capFull(now) then
            counters.refused = counters.refused + 1
            return false, Errors.RATE_LIMITED
        end
        stamp(now)
        counters.invokes = counters.invokes + 1
        return await("invoke " .. ns .. "." .. name, timeout or defaultTimeout, invokeQuery, query, data)
    end

    function api.listen(ns, name, fn)
        if type(fn) ~= "function" then return false, Errors.BAD_ARGS end
        if closed then return false, Errors.NOT_READY end
        local packet, err = member("packets", ns, name)
        if packet == nil then return false, err end

        local label = "listen " .. ns .. "." .. name
        local handle = { alive = true }
        local slot

        -- the bus calls each listener with (data, player) and the player is always nil on the client
        local function relay(data)
            if handle.alive then base.safe(label, fn, data) end
        end

        -- the bus's disconnect removes the last listener when its argument is already gone (its own listenOnce and wait evict that way), so ours goes only while still listed
        local function detach()
            if listed(packet, relay) then base.safe(label .. " disconnect", disconnectPacket, packet, relay) end
        end

        local ok, listenErr = pcall(listenPacket, packet, relay)
        if not ok then
            base.warn("%s failed: %s", label, tostring(listenErr))
            return false, Errors.NO_PACKET, tostring(listenErr)
        end

        -- deferred because a handler may disconnect mid-dispatch, and removing from the list the bus is walking skips the next listener, maybe the game's
        function handle.Disconnect()
            if not handle.alive then return end
            handle.alive = false
            counters.listeners = counters.listeners - 1
            task.defer(detach)
            release(slot, handle)
        end
        handle.Destroy = handle.Disconnect

        -- false once disconnected, or once the game's own eviction bug has dropped us
        function handle.connected()
            return handle.alive and listed(packet, relay)
        end

        counters.listeners = counters.listeners + 1
        slot = hold(handle)
        return true, handle
    end

    function api.remote(path)
        local segments = splitPath(path)
        if segments == nil then return false, Errors.BAD_ARGS end
        if closed then return false, Errors.NOT_READY end
        local remote, err = resolveRemote(path, segments)
        if remote == nil then return false, err end
        return true, remote
    end

    function api.fire(path, ...)
        local remote, err = outgoing(path, (...))
        if remote == nil then return false, err end
        if not EVENT_CLASSES[prop(remote, "ClassName")] then return false, Errors.WRONG_CLASS end
        local ok, fireErr = pcall(fireRemote, remote, ...)
        if not ok then
            counters.failed = counters.failed + 1
            base.warn("fire %s failed: %s", path, tostring(fireErr))
            return false, Errors.SEND_FAILED, tostring(fireErr)
        end
        counters.fires = counters.fires + 1
        return true
    end

    -- a remote the game hands out at runtime rather than one under Remotes (a loot bag's take and collect-all events, LootClient.lua:154-160, 275-277); only a RemoteEvent, and counted like any other fire
    function api.fireInstance(remote, ...)
        if closed then return false, Errors.NOT_READY end
        if typeof(remote) ~= "Instance" then return false, Errors.BAD_ARGS end
        if not EVENT_CLASSES[prop(remote, "ClassName")] then return false, Errors.WRONG_CLASS end
        local ok, fireErr = pcall(fireRemote, remote, ...)
        if not ok then
            counters.failed = counters.failed + 1
            base.warn("fire %s failed: %s", tostring(prop(remote, "Name")), tostring(fireErr))
            return false, Errors.SEND_FAILED, tostring(fireErr)
        end
        counters.fires = counters.fires + 1
        return true
    end

    local function callRemote(path, timeout, ...)
        local remote, err = outgoing(path, (...))
        if remote == nil then return false, err end
        if prop(remote, "ClassName") ~= "RemoteFunction" then return false, Errors.WRONG_CLASS end
        if not coroutine.isyieldable() then return false, Errors.INVOKE_FAILED, NOT_YIELDABLE end
        counters.calls = counters.calls + 1
        return await("call " .. path, timeout, invokeRemote, remote, ...)
    end

    function api.call(path, ...)
        return callRemote(path, defaultTimeout, ...)
    end

    function api.callWith(path, opts, ...)
        local timeout = defaultTimeout
        if opts ~= nil then
            if type(opts) ~= "table" then return false, Errors.BAD_ARGS end
            if opts.timeout ~= nil then
                if not validTimeout(opts.timeout) then return false, Errors.BAD_ARGS end
                timeout = opts.timeout
            end
        end
        return callRemote(path, timeout, ...)
    end

    function api.on(path, fn)
        if type(fn) ~= "function" then return false, Errors.BAD_ARGS end
        local segments = splitPath(path)
        if segments == nil then return false, Errors.BAD_ARGS end
        if closed then return false, Errors.NOT_READY end
        local remote, err = resolveRemote(path, segments)
        if remote == nil then return false, err end
        if not EVENT_CLASSES[prop(remote, "ClassName")] then return false, Errors.WRONG_CLASS end

        local label = "on " .. path
        local handle = { alive = true }
        local slot, conn

        local ok, connectErr = pcall(function()
            conn = remote.OnClientEvent:Connect(function(...)
                if handle.alive then base.safe(label, fn, ...) end
            end)
        end)
        if not ok or conn == nil then
            base.warn("%s failed: %s", label, tostring(connectErr))
            return false, Errors.WRONG_CLASS, tostring(connectErr)
        end

        function handle.Disconnect()
            if not handle.alive then return end
            handle.alive = false
            counters.connections = counters.connections - 1
            base.safe(label .. " disconnect", disconnectConnection, conn)
            release(slot, handle)
        end
        handle.Destroy = handle.Disconnect

        counters.connections = counters.connections + 1
        slot = hold(handle)
        return true, handle
    end

    function api.wrapCallback(path, wrapper)
        if type(wrapper) ~= "function" then return false, Errors.BAD_ARGS end
        local segments = splitPath(path)
        if segments == nil then return false, Errors.BAD_ARGS end
        if closed then return false, Errors.NOT_READY end
        local key = denyKey(segments, path)
        if wraps[key] then return false, Errors.BUSY end
        local remote, err = resolveRemote(path, segments)
        if remote == nil then return false, err end
        if prop(remote, "ClassName") ~= "RemoteFunction" then return false, Errors.WRONG_CLASS end

        local getcallbackvalue = Executor.get("getcallbackvalue")
        if type(getcallbackvalue) ~= "function" then return false, Errors.NO_CALLBACK_API end
        -- reading OnClientInvoke directly throws, so the game's function only comes back through the executor
        local okRead, original = pcall(getcallbackvalue, remote, "OnClientInvoke")
        if not okRead or type(original) ~= "function" then return false, Errors.NO_ORIGINAL end

        local label = "callback " .. path
        local handle = { active = true }
        local slot

        -- a wrapper that throws must not change what the server gets back, so the game's own answer stands in
        local function installed(...)
            if not handle.active then return original(...) end
            local result = table.pack(pcall(wrapper, original, ...))
            if result[1] then return table.unpack(result, 2, result.n) end
            base.warn("%s wrapper threw: %s", label, tostring(result[2]))
            return original(...)
        end

        local okSet, setErr = pcall(setCallback, remote, installed)
        if not okSet then
            base.warn("%s install failed: %s", label, tostring(setErr))
            return false, Errors.NO_CALLBACK_API, tostring(setErr)
        end

        -- the executor re-wraps a callback set from executor context, so what reads back is its wrapper around ours, never ours itself
        local okSeen, seen = pcall(getcallbackvalue, remote, "OnClientInvoke")
        if not okSeen then seen = nil end

        -- put back only while ours is still installed: a newer callback the game set since must not be clobbered, and ours passes straight through once inactive
        function handle.Restore()
            if not handle.active then return end
            handle.active = false
            if wraps[key] == handle then wraps[key] = nil end
            counters.wraps = counters.wraps - 1
            local okNow, current = pcall(getcallbackvalue, remote, "OnClientInvoke")
            if not okNow or current == installed or (seen ~= nil and current == seen) then
                base.safe(label .. " restore", setCallback, remote, original)
            end
            release(slot, handle)
        end
        handle.Destroy = handle.Restore

        wraps[key] = handle
        counters.wraps = counters.wraps + 1
        slot = hold(handle)
        return true, handle
    end

    -- sendCap: packets plus queries per rolling second; timeout: the default wait for invoke and call
    function api.configure(opts)
        if type(opts) ~= "table" then return false, Errors.BAD_ARGS end
        local cap, timeout = opts.sendCap, opts.timeout
        if cap ~= nil and (type(cap) ~= "number" or cap ~= math.floor(cap) or cap < 1 or cap > MAX_SEND_CAP) then
            return false, Errors.BAD_ARGS
        end
        if timeout ~= nil and not validTimeout(timeout) then return false, Errors.BAD_ARGS end

        -- the newest stamps carry over, so changing the cap never opens a fresh burst
        if cap ~= nil and cap ~= sendCap then
            local now, recent = os.clock(), {}
            for _, at in pairs(stamps) do
                if now - at < CAP_WINDOW then recent[#recent + 1] = at end
            end
            table.sort(recent)
            sendCap, stamps, head = cap, {}, 1
            for i = math.max(1, #recent - cap + 1), #recent do stamp(recent[i]) end
        end
        if timeout ~= nil then defaultTimeout = timeout end
        return true
    end

    function api.stats()
        local now, used = os.clock(), 0
        for _, at in pairs(stamps) do
            if now - at < CAP_WINDOW then used = used + 1 end
        end
        local out = {}
        for key, value in pairs(counters) do out[key] = value end
        out.sendCap = sendCap
        out.windowUsed = used
        out.timeout = defaultTimeout
        out.ready = api.ready()
        return true, out
    end

    return api
end

return M

end)
