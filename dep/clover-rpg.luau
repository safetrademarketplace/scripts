__bundle_register("Features/Visuals/Visuals", function(require, _LOADED, __bundle_register, __bundle_modules)
-- visuals orchestrator: four boxes built through UI/Place, camera (infinite zoom, fov), freecam, world (fog, fullbright, x-ray) and the player radar, so the tab file decides where they go (the visuals tab when nothing is injected, the radar falling back to esp)
local Mount          = require("Utility/Mount")
local Place          = require("UI/Place")
local FOV            = require("Features/Visuals/Visuals/FOV")
local Freecam        = require("Features/Visuals/Visuals/Freecam")
local Fullbright     = require("Features/Visuals/Visuals/Fullbright")
local InfiniteCamera = require("Features/Visuals/Visuals/InfiniteCamera")
local NoFog          = require("Features/Visuals/Visuals/NoFog")
local Radar          = require("Features/Visuals/Visuals/Radar")
local XRay           = require("Features/Visuals/Visuals/XRay")

return function(ctx)
    local O = Mount.orchestrator(ctx, "Visuals")
    if not O then return end

    local camera = Place.groupbox(ctx, "Camera", "camera", { fallback = "Visuals", side = "Left" })
    if camera then
        local cCtx = O.subCtx({ VisualsGroup = camera })
        O.mount(InfiniteCamera, cCtx)
        O.mount(FOV, cCtx)
    end

    local freecam = Place.groupbox(ctx, "Freecam", "video", { fallback = "Visuals", side = "Left" })
    if freecam then O.mount(Freecam, O.subCtx({ VisualsGroup = freecam })) end

    local world = Place.groupbox(ctx, "World", "sun", { fallback = "Visuals", side = "Right" })
    if world then
        local wCtx = O.subCtx({ VisualsGroup = world })
        O.mount(NoFog, wCtx)
        O.mount(Fullbright, wCtx)
        O.mount(XRay, wCtx)
    end

    -- under world, so the visuals tab has two boxes a side
    O.mount(Radar, O.subCtx())

    O.finalize()
end

end)
__bundle_register("Features/Visuals/Visuals/XRay", function(require, _LOADED, __bundle_register, __bundle_modules)
-- x-ray sub-module of visuals (LocalTransparencyModifier on non-character parts)
return function(ctx)
    local Services     = ctx.Services
    local Toggles      = ctx.Toggles
    local VisualsGroup = ctx.VisualsGroup
    local track        = ctx.track

    VisualsGroup:AddToggle("XRay", {
        Text = "X-Ray",
        Default = false,
        Tooltip = "See through structures"
    })

    local xrayConn = nil
    local scanGen = 0

    local function isCharacterPart(part)
        local inst = part.Parent
        for _ = 1, 3 do
            if not inst or inst == Services.Workspace then break end
            if inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid") then
                return true
            end
            inst = inst.Parent
        end
        return false
    end

    local function processPart(part, on)
        if not part:IsA("BasePart") then return end

        if part.Transparency >= 1 then return end

        if not isCharacterPart(part) then
            part.LocalTransparencyModifier = on and 0.5 or 0
        end
    end

    -- gen bump cancels in-flight scans without reading live toggle state (at cleanup the toggle is still true); chunked yields keep big-map scans from freezing a frame
    local SCAN_CHUNK = 500
    local scanWorkspace = function(on, gen)
        local n = 0
        for _, v in ipairs(Services.Workspace:GetDescendants()) do
            if gen ~= scanGen then break end
            processPart(v, on)
            n = n + 1
            if n >= SCAN_CHUNK then
                n = 0
                task.wait()
                if gen ~= scanGen then break end
            end
        end
    end

    local function setXRay(on)
        scanGen = scanGen + 1
        local myGen = scanGen
        task.defer(function()
            scanWorkspace(on, myGen)
        end)

        if on then
            if not xrayConn then
                xrayConn = track(Services.Workspace.DescendantAdded:Connect(function(descendant)
                    processPart(descendant, true)
                end))
            end
        else
            if xrayConn then
                xrayConn:Disconnect()
                xrayConn = nil
            end
        end
    end

    Toggles.XRay:OnChanged(function()
        setXRay(Toggles.XRay.Value)
    end)

    local function cleanup()
        if xrayConn then
            xrayConn:Disconnect()
            xrayConn = nil
        end
        -- invalidate pending deferred scans, then reset synchronously so LocalTransparencyModifier is cleared before unload
        scanGen = scanGen + 1
        pcall(function()
            for _, v in ipairs(Services.Workspace:GetDescendants()) do
                processPart(v, false)
            end
        end)
    end

    return { cleanup = cleanup }
end

end)
