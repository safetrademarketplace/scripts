            if paintTask == nil then
                paintTask = Scheduler.render(painter.updateFOV, { name = "SilentAimFOV", priority = 70, deferrable = true })
            end
            return
        end
        if paintTask then
            paintTask:Disconnect()
            paintTask = nil
        end
        if circle.FOVCircle then painter.updateFOV() end
    end

    local function release()
        if handle then
            handle.Destroy()
            handle = nil
        end
    end

    local function setEnabled(on)
