__bundle_register("Api/Racing", function(require, _LOADED, __bundle_register, __bundle_modules)
-- racing api: broom races through RacingRemote, started from anywhere with no racer to talk to (live 2026-10-24), and the race the server is running for us read off RacingRemote.Client (RacingClient.lua:57-209): its start marker, the one gate it shows at a time, the time and leaderboard placement at the end; start points are learned as the server hands them out and best times kept per course; shared as ctx.Api.Racing
local References = require("References")
local Services   = require("Services")
local Store      = require("Utility/Store")
local Api        = require("Api")
local Errors     = require("Api/Racing/Errors")

local REMOTE, EVENTS = "RacingRemote", "RacingRemote/Client"
local COURSES = "@BroomRacing"
-- the gate model's TouchPart is a 25 x 25 disc (live 2026-10-24); a crossing 10.4 off its centre still counted
local GATE_RADIUS = 12.5
-- where each course's start marker was measured (live 2026-10-24), until the server hands one out again
local KNOWN_STARTS = {
    ["Kamo Broom Blitz"]   = Vector3.new(-445.2, 133.4, 2018.8),
    ["Elden Derby"]        = Vector3.new(5891.3, 282.5, 3893.0),
    ["Broomshroom Zoom"]   = Vector3.new(131.1, 416.3, -4241.5),
    ["Bayou Broomba"]      = Vector3.new(8180.6, 355.3, 1566.9),
    ["Larceny Lap"]        = Vector3.new(-1779.1, 387.2, -1336.2),
    ["Dewfall Dash Derby"] = Vector3.new(-100.9, 114.7, -2158.6),
}
local STORE_KEY = "courses"
-- InRace lags the race's end and start by a moment either way
local SETTLE = 3

local M = {}

local function finite(n)
    return type(n) == "number" and n == n and n > -math.huge and n < math.huge
end

function M.new(ctx)
    local base = Api.define("Racing", ctx)
    local api = { Errors = Errors }
    local namespace = Store.GAME .. "/racing"

    local closed = false
    local hook = nil
    local eventSignal = base.signal()
    -- the race the server says we are in: idle, starting (asked for), waiting (go to the marker), countdown, racing
    local race = { phase = "idle" }
    local endedAt, outSince = nil, nil
    local last = nil
    local counts = { finished = 0, failed = 0 }
    local saved = Store.read(namespace, STORE_KEY, {})
    if type(saved) ~= "table" then saved = {} end
    -- per course: start = { x, y, z } and best = seconds
    local courses = saved

    local function net()
        local found = ctx.Api and ctx.Api.CloverNet
        if type(found) == "table" then return found end
        return nil
    end

    local function settle(label, ok, ...)
        if ok then return ... end
        base.warn("%s threw: %s", label, tostring((...)))
        return false, Errors.NOT_READY
    end

    local function expose(name, fn)
        local label = "Racing." .. name
        api[name] = function(...)
            if closed then return false, Errors.NOT_READY end
            return settle(label, pcall(fn, ...))
        end
    end

    local function save()
        Store.write(namespace, STORE_KEY, courses)
    end

    local function entry(course)
        local found = courses[course]
        if type(found) ~= "table" then
            found = {}
            courses[course] = found
        end
        return found
    end

    local function startOf(course)
        local found = courses[course]
        local s = type(found) == "table" and found.start or nil
        if type(s) == "table" and finite(s[1]) and finite(s[2]) and finite(s[3]) then return Vector3.new(s[1], s[2], s[3]) end
        return KNOWN_STARTS[course]
    end

    local function folder()
        local map = Services.Workspace:FindFirstChild("Map")
        return map and map:FindFirstChild(COURSES) or nil
    end

    local function emit(kind, info)
        eventSignal:Fire(kind, info)
    end

    local function gateEntry(cf, finish)
        race.shown = (race.shown or 0) + 1
        -- the disc's thin axis is its X, so a gate is crossed along its RightVector, either way
        return {
            position = cf.Position,
            normal   = cf.RightVector,
            finish   = finish,
            index    = race.shown,
            radius   = GATE_RADIUS,
            shownAt  = os.clock(),
        }
    end

    local function inRace()
        local char = References.player and References.player.Character
        if not char then return nil end
        return char:GetAttribute("InRace") == true
    end

    local function drawnGate()
        local effects = Services.Workspace:FindFirstChild("Effects")
        local debris = effects and effects:FindFirstChild("Debris")
        if not debris then return nil end
        for _, model in ipairs(debris:GetChildren()) do
            local primary = model:IsA("Model") and model.Name == "Gate" and model.PrimaryPart or nil
            if primary then return primary.CFrame end
        end
        return nil
    end

    -- a race already under way when this api started (a reload mid-course) is picked up from the gate the game's own client drew; the server ignores Quit mid-race (live 2026-10-24), so the only way out of one is through its gates. InRace outlives End by a moment, so a race that just ended is never picked up again
    local function recover()
        local t = os.clock()
        if race.phase ~= "idle" or (endedAt and t - endedAt < SETTLE) or not inRace() then return end
        local cf = drawnGate()
        if not cf then return end
        race.phase = "racing"
        race.gate = gateEntry(cf, false)
        base.log("picked up a race already under way")
    end

    -- a race the server no longer has (InRace gone for a while with no End heard) is dropped
    local function expire()
        if race.phase ~= "racing" then
            outSince = nil
            return
        end
        if inRace() ~= false then
            outSince = nil
            return
        end
        local t = os.clock()
        outSince = outSince or t
        if t - outSince >= SETTLE then
            base.log("dropped a race the server no longer has")
            race, outSince = { phase = "idle" }, nil
        end
    end

    local function onCreate(list, id)
        if type(list) ~= "table" then return end
        for _, item in pairs(list) do
            if type(item) == "table" then
                for key, cf in pairs(item) do
                    if typeof(cf) == "CFrame" then
                        if key == "START" then
                            race.start, race.id = cf.Position, id
                            if race.phase == "starting" or race.phase == "idle" then race.phase = "waiting" end
                            if race.course then
                                local e = entry(race.course)
                                e.start = { cf.X, cf.Y, cf.Z }
                                save()
                            end
                            emit("start", { position = cf.Position })
                        elseif key == "Gate" or key == "FinishGate" then
