__bundle_register("Api/Loot", function(require, _LOADED, __bundle_register, __bundle_modules)
-- loot api: the loot bags lying on the map (live 2026-10-24: a model under Workspace.Objects with a Creator attribute naming whose it is, an Items Configuration of item folders each holding its own take remote, and a 5-stud Prompt), opened by firing that prompt and emptied through the collect-all remote the server hands back on Remotes.LOOT (LootClient.lua:214-277), item by item when collect-all is cooling down; and where your own death bags lie (DeathBag_<id> player attributes, MapService.lua:793-870); shared as ctx.Api.Loot
local References = require("References")
local Services   = require("Services")
local Api        = require("Api")
local Errors     = require("Api/Loot/Errors")

local EVENT = "LOOT"
local PROMPT, ITEMS = "Prompt", "Items"
local DEATH_PREFIX = "DeathBag_"
-- LootClient.lua:255-259 closes the window past 11 studs of the bag
local REACH = 11
local ANSWER_WAIT = 3
-- the server hands over one item at a time behind a short debounce (live 2026-10-24: firing every take at once got one of two), so each is waited on before the next
local EMPTY_WAIT = 10
local TAKE_WAIT = 1.2
local POLL = 0.1
-- an open answer this fresh, its container still there, is reused rather than firing the prompt again (the game disables it while its loot window is up)
local ANSWER_REUSE = 30

local M = {}

local function isVector(v)
    return typeof(v) == "Vector3"
end

function M.new(ctx)
    local base = Api.define("Loot", ctx)
    local api = { Errors = Errors }
    local closed = false
    local hook = nil
    -- the last LOOT answer per prompt full name, so a collect finds the one its own prompt brought
    local answers = {}

    local function apiOf(name)
        local found = ctx.Api and ctx.Api[name]
        if type(found) == "table" then return found end
        return nil
    end

    local function settle(label, ok, ...)
        if ok then return ... end
        base.warn("%s threw: %s", label, tostring((...)))
        return false, Errors.NOT_READY
    end

    local function expose(name, fn)
        local label = "Loot." .. name
        api[name] = function(...)
            if closed then return false, Errors.NOT_READY end
            return settle(label, pcall(fn, ...))
        end
    end

    local function fullName(instance)
        local ok, name = pcall(function() return instance:GetFullName() end)
        if ok then return name end
        return nil
    end

    local function onLoot(prompt, owner, container, position, collectAll)
        local key = typeof(prompt) == "Instance" and fullName(prompt) or nil
        if not key then return end
        answers[key] = { container = container, position = position, collectAll = collectAll, owner = owner, at = os.clock() }
    end

    local function ensure()
        if hook then return true end
        local net = apiOf("CloverNet")
        if not net then return false end
        local ok, handle = net.on(EVENT, onLoot)
        if not ok or not handle then return false end
        hook = handle
        if base.maid then base.maid:GiveTask(handle) end
        return true
    end

    local function itemCount(container)
        local n = 0
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("Folder") then n = n + 1 end
        end
        return n
    end

    local function entryOf(model)
        local prompt = model:FindFirstChild(PROMPT, true)
        local items = model:FindFirstChild(ITEMS)
        if not (prompt and prompt:IsA("ProximityPrompt") and items) then return nil end
        local okPos, position = pcall(function() return model:GetPivot().Position end)
        if not okPos then return nil end
        local creator = model:GetAttribute("Creator")
        local player = References.player
        return {
            model    = model,
            prompt   = prompt,
            position = position,
            creator  = type(creator) == "string" and creator or nil,
            mine     = player ~= nil and creator == player.Name,
            items    = itemCount(items),
        }
    end

    -- (true, list) nearest first; filter: origin, maxDistance, mine (only yours), unowned (only ones nobody's name is on)
    expose("bags", function(filter)
        if filter ~= nil and type(filter) ~= "table" then return false, Errors.BAD_ARGS end
        filter = filter or {}
        local objects = Services.Workspace:FindFirstChild("Objects")
        if not objects then return true, {} end
        local origin = filter.origin
        if origin ~= nil and not isVector(origin) then return false, Errors.BAD_ARGS end
        local out = {}
        for _, model in ipairs(objects:GetChildren()) do
            if model:IsA("Model") then
                local entry = entryOf(model)
                local wanted = entry ~= nil
                if wanted and filter.mine and not entry.mine then wanted = false end
                if wanted and filter.unowned and entry.creator ~= nil and entry.creator ~= "" then wanted = false end
                if wanted and origin then
                    entry.distance = (entry.position - origin).Magnitude
                    if filter.maxDistance and entry.distance > filter.maxDistance then wanted = false end
                end
                if wanted then out[#out + 1] = entry end
            end
        end
        table.sort(out, function(a, b) return (a.distance or 0) < (b.distance or 0) end)
        return true, out
    end)

    -- (true, list) of where your own death bags were dropped: { id, position }
    expose("deathBags", function()
        local player = References.player
        if not player then return false, Errors.NOT_READY end
        local out = {}
        for key, value in pairs(player:GetAttributes()) do
            if string.sub(key, 1, #DEATH_PREFIX) == DEATH_PREFIX and isVector(value) then
                out[#out + 1] = { id = string.sub(key, #DEATH_PREFIX + 1), position = value }
            end
        end
        return true, out
    end)

    -- empties a bag the character stands by: (true, items taken); yields
    expose("collect", function(bag)
        if type(bag) ~= "table" or typeof(bag.prompt) ~= "Instance" then return false, Errors.BAD_ARGS end
        if not coroutine.isyieldable() then return false, Errors.BAD_ARGS end
        local Interact, net = apiOf("Interact"), apiOf("CloverNet")
        if not (Interact and net and ensure()) then return false, Errors.NOT_READY end
        if bag.prompt.Parent == nil then return false, Errors.NO_BAG end
        local key = fullName(bag.prompt)
        local answer = key and answers[key]
        if not (answer and os.clock() - answer.at <= ANSWER_REUSE and typeof(answer.container) == "Instance" and answer.container.Parent ~= nil) then
            answer = nil
            local asked = os.clock()
            local okFire, code = Interact.prompt(bag.prompt)
            if not okFire then
                if code == (Interact.Errors and Interact.Errors.NOT_IN_RANGE) then return false, Errors.TOO_FAR end
                return false, Errors.FAILED, code
            end
            local limit = os.clock() + ANSWER_WAIT
            while os.clock() < limit do
                local found = key and answers[key]
                if found and found.at >= asked then
                    answer = found
                    break
                end
                task.wait(POLL)
            end
        end
        if not answer or typeof(answer.container) ~= "Instance" then return false, Errors.NO_ANSWER end
        local container = answer.container
        local before = itemCount(container)
        if before == 0 then return true, 0 end
        if typeof(answer.collectAll) == "Instance" then net.fireInstance(answer.collectAll) end
        task.wait(TAKE_WAIT)
        -- collect-all has a per-player cooldown (LootClient.lua:265-293), so whatever is left is taken one item at a time
        local limit = os.clock() + EMPTY_WAIT
        while os.clock() < limit and container.Parent ~= nil and itemCount(container) > 0 do
            local folder = nil
            for _, child in ipairs(container:GetChildren()) do
                if not folder and child:IsA("Folder") then folder = child end
            end
            local take = folder and folder:FindFirstChildWhichIsA("RemoteEvent") or nil
            if not take then break end
            net.fireInstance(take)
            local until_ = os.clock() + TAKE_WAIT
            while os.clock() < until_ and folder.Parent ~= nil do task.wait(POLL) end
        end
        local left = container.Parent ~= nil and itemCount(container) or 0
        return true, before - left
    end)

    api.reach = REACH

    ensure()

    if base.maid then
        base.maid:GiveTask(function() closed = true end)
    end

    return api
end

return M

end)
