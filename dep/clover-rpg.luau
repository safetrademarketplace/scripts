local Storage = require("Features/Fun/CustomCursor/Storage")
local Render  = require("Features/Fun/CustomCursor/Render")
local Ui      = require("Features/Fun/CustomCursor/Ui")

return function(ctx)
    local Services   = ctx.Services
    local References = ctx.References
    local track      = ctx.track

    local CFG  = Storage.load()
    local Live = { enabled = false }

    local renderer = Render({
        Services   = Services,
        Library    = ctx.Library,
        References = References,
        track      = track,
    })

    -- forward declared so Ui can wire it into callbacks; defined right after Ui mounts
    local applyCurrent

    local ui = Ui({
        Tabs      = ctx.Tabs,
        Tab       = ctx.Tab,
        Side      = ctx.Side,
        Collapsed = ctx.Collapsed,
        Library   = ctx.Library,
        Toggles   = ctx.Toggles,
        Options   = ctx.Options,
        Window    = ctx.Window,
    }, {
        CFG          = CFG,
        Live         = Live,
        saveConfig   = function(cfg) Storage.save(cfg) end,
        applyCurrent = function() if applyCurrent then applyCurrent() end end,
    })

    local function currentProps()
        if Live.enabled then
            return ui.propsFromBuilder()
        else
            return Presets.propsFromPreset(Presets.getEntry(CFG.entries, CFG.selected))
        end
    end

    applyCurrent = function()
        renderer.apply(currentProps(), CFG.enabled)
    end

    -- renderer owns the per-frame loop; pulls state through callbacks so it stays decoupled from CFG layout
    renderer.bindLoop({
        getProps  = currentProps,
        isEnabled = function() return CFG.enabled end,
        getNudge  = function()
            return CFG.settings.xNudge or 0, CFG.settings.yNudge or 0
        end,
    })

    track(References.player.CharacterAdded:Connect(function()
        task.wait(0.25)
        if renderer.isDestroyed() then return end
        renderer.resetHidden()  -- re-apply after respawn
        applyCurrent()
    end))

    applyCurrent()

    local function cleanup()
        CFG.enabled = false
        renderer.destroy()
    end

    return { cleanup = cleanup }
end

