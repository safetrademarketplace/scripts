__bundle_register("UI/UiHost", function(require, _LOADED, __bundle_register, __bundle_modules)
-- picks the best ScreenGui parent: gethui() when trustworthy, else cloned CoreGui, else PlayerGui

local Services   = require("Services")
local References = require("References")

local M = {}

local function execIsLimited()
    local name = tostring(References.executorName or ""):lower()
    return name:find("xeno", 1, true) ~= nil
        or name:find("solara", 1, true) ~= nil
end

-- re-evaluated on every call: the executor environment can change between teleports / re-execs
function M.pick()
    if not execIsLimited() then
        local fn = rawget(getfenv(), "gethui") or rawget(_G, "gethui")
        if type(fn) == "function" then
            local okCall, root = pcall(fn)
            if okCall and typeof(root) == "Instance" then
                return root
            end
        end
    end

    if Services.CoreGui then
        return Services.CoreGui
    end

    -- last-resort PlayerGui is visible to in-game scripts
    local lp = Services.Players and Services.Players.LocalPlayer
    if lp then
        local pg = lp:FindFirstChildOfClass("PlayerGui")
        if pg then return pg end
    end

    return nil
end

-- exposed so callers like AntiAFK can branch on gethui availability
function M.isLimited()
    return execIsLimited()
end

return M

end)
