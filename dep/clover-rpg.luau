-- state api: the read model of the local player and character (profile, stats, vitals, game states, cooldowns, can-act predicates, readiness); shared as ctx.Api.State, it reads instances only and never writes

local Services      = require("Services")
local References    = require("References")
local PlayerHelpers = require("Utility/Helpers/Players")
local Maid          = require("Utility/Maid")
local Scheduler     = require("Utility/Scheduler")
local Api           = require("Api")
local Errors        = require("Api/State/Errors")
local Predicates    = require("Api/State/Predicates")

local Workspace         = Services.Workspace
local CollectionService = Services.CollectionService

local READY_INTERVAL     = 0.25
local TRANSITION_POLL    = 1
-- TeleportCharacter.lua:55-96 gives up after 12 tries half a second apart, so an "In" this old lost its "Out"
local TRANSITION_STALE   = 15
-- Weight.lua:6,113-116
local BASE_MAX_WEIGHT    = 80
-- Basic.lua:61
local FLYING_ATTRIBUTE   = "Flying"

local STATS = { "Agility", "Endurance", "Intelligence", "Magic Power", "Strength", "Vitality" }

local PROFILE_ATTRIBUTES = {
    level         = "Level",
    xp            = "XP",
    maxXp         = "MXP",
    marks         = "Marks",
    insight       = "Insight",
    essence       = "Essence",
    lockedEssence = "LockedEssence",
    statPoints    = "StatPoints",
    skillPoints   = "SkillPoints",
    magicVariant  = "MagicVariant",
    fightingStyle = "FightingStyle",
    trueSpawn     = "TrueSpawn",
}

-- StateManager.displayTags.lua:13-80 lists every timed cooldown the hud draws; this one is the only name that hides it
local COOLDOWN_IDS = { ChaseDebounce = true }

local function noop() end

local function truthy(value)
    return value ~= nil and value ~= false
end

local function hasTag(inst, tag)
    return CollectionService:HasTag(inst, tag)
end

local function valueOf(parent, name)
    local node = parent:FindFirstChild(name)
    if node and node:IsA("ValueBase") then return node.Value end
    return nil
end

local function numberOf(parent, name)
    local value = valueOf(parent, name)
    if type(value) == "number" then return value end
    return nil
end

local function textOf(parent, name)
    local value = valueOf(parent, name)
    if type(value) == "string" and value ~= "" then return value end
    return nil
end

local function emptyToNil(value)
    if value == "" then return nil end
    return value
end

-- Names.lua:54-72: the last non-empty word split on single spaces, and never the first word
local function familyName(full)
    if type(full) ~= "string" then return nil end
    local words, start = {}, 1
    while true do
        local stop = string.find(full, " ", start, true)
        if not stop then
            words[#words + 1] = string.sub(full, start)
            break
        end
        words[#words + 1] = string.sub(full, start, stop - 1)
        start = stop + 1
    end
    for i = #words, 2, -1 do
        if words[i] ~= "" then return words[i] end
    end
    return nil
end

local function isCooldown(id)
    if COOLDOWN_IDS[id] then return true end
    if string.find(string.lower(id), "cooldown", 1, true) then return true end
    return string.sub(id, -2) == "CD"
end

-- the game anchors and tests the PrimaryPart (StateManager.lua:687, TeleportCharacter.lua:47-48), which is the root
local function primaryRoot(char)
    return char.PrimaryPart or char:FindFirstChild("HumanoidRootPart")
end

-- matched by name and class, never ==, because Services hands out cloneref'd handles
local function inWorld(char)
    local parent = char.Parent
    if not parent or parent.Name ~= "pCharacters" then return false end
    local world = parent.Parent
    return world ~= nil and world.ClassName == "Workspace"
end

-- a handle from another api may be a connection, a {Disconnect}/{Destroy} table or a bare function
local function release(handle)
    local kind = typeof(handle)
    if kind == "function" then
        handle()
    elseif kind == "RBXScriptConnection" then
        handle:Disconnect()
    elseif kind == "table" then
        if type(handle.Disconnect) == "function" then
            handle:Disconnect()
        elseif type(handle.Destroy) == "function" then
            handle:Destroy()
        end
    end
end

-- BackpackClient.lua:1657-1710: a CD-tagged Configuration named "<skill>_<suffix>" counts its own Time down
local function skillCooldowns(char, wanted)
    local out = {}
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Configuration") and hasTag(child, "CD") then
            local skill = string.match(child.Name, "^([^_]+)")
            local left = child:GetAttribute("Time")
            if skill and (wanted == nil or skill == wanted) and type(left) == "number" and left > 0 then
                if left > (out[skill] or 0) then out[skill] = left end
            end
        end
    end
    return out
end

-- the six reads the predicates are built from, over whichever character they are handed
local reader = {}

function reader.has(char, name)
    return char:GetAttribute(Predicates.stateKey(name)) == true
end

function reader.alive(char)
    local humanoid = PlayerHelpers.getHumanoid(char)
    return humanoid ~= nil and humanoid.Health > 0
end

function reader.flying(char)
    return truthy(char:GetAttribute(FLYING_ATTRIBUTE))
end

function reader.grabbed(char)
    local root = primaryRoot(char)
    if not root then return false end
    return root:FindFirstChild("GrabbingWeld") ~= nil or root:FindFirstChild("GrabWeld") ~= nil
end

function reader.anchored(char)
    local root = primaryRoot(char)
    if not root then return nil end
    return root.Anchored == true
end

function reader.hyperArmor(char)
    return hasTag(char, "HyperArmor")
end

local M = {}

function M.new(ctx)
    local base = Api.define("State", ctx)

    local api = { Errors = Errors }

    local readySignal    = base.signal()
    local diedSignal     = base.signal()
    local teleportSignal = base.signal()

    local closed          = false
    local current         = nil
    local teleportingNow  = false
    local transitionSince = nil
    local transitionConn  = nil
    local transitionWatch = nil
    local locationScript  = nil
    local statHandles     = {}

    -- a throw on an instance tree in an unexpected shape becomes a code, so a caller never needs its own pcall
    local function settle(label, ok, ...)
        if ok then return ... end
        base.warn("%s threw: %s", label, tostring((...)))
        return false, Errors.NOT_LOADED
    end

    local function expose(name, fn)
        local label = "State." .. name
        api[name] = function(...) return settle(label, pcall(fn, ...)) end
    end

    -- consumers get Connect alone, dot or colon, and a handle a maid takes as-is
    local function listenable(signal)
        local facade = {}
        function facade.Connect(a, b)
            local fn = b
            if type(a) == "function" then fn = a end
            if type(fn) ~= "function" or closed then return { Disconnect = noop, Destroy = noop } end
            local inner = signal:Connect(fn)
            local function disconnect() inner:Disconnect() end
            return { Disconnect = disconnect, Destroy = disconnect }
        end
        return facade
    end

    -- never cached: the character and everything under it is replaced on every respawn
    local function liveCharacter()
        local char = References.character
        if char and char.Parent then return char end
        local player = References.player
        char = player and player.Character
        if char and char.Parent then return char end
        return nil
    end

    local function playerFolder()
        return References.player:FindFirstChild("PlayerFolder")
    end

    local function serverNow()
        return Workspace:GetServerTimeNow()
    end

    local function transitionPending()
        return transitionSince ~= nil and (os.clock() - transitionSince) < TRANSITION_STALE
    end

    local function computeTeleporting()
        if transitionPending() then return true end
        local char = liveCharacter()
        return char ~= nil and reader.anchored(char) == true
    end

    local function refreshTeleport()
        if closed then return end
        local now = computeTeleporting()
        if now == teleportingNow then return end
        teleportingNow = now
        teleportSignal:Fire(now)
    end

    local function stopTransitionWatch()
        if not transitionWatch then return end
        transitionWatch:Disconnect()
        transitionWatch = nil
    end

    -- only runs while an "In" is waiting on its "Out", to retire one the server never closed
    local function startTransitionWatch()
        if transitionWatch then return end
        transitionWatch = Scheduler.heartbeat(function()
            base.safe("transition watch", function()
                if transitionPending() then return end
                transitionSince = nil
                stopTransitionWatch()
                refreshTeleport()
            end)
        end, { interval = TRANSITION_POLL, name = "State.transition" })
    end

    -- TeleportCharacter.lua:103-129: the server sends "In" before the move and "Out" once the root is let go
    local function onTransition(data)
        if closed or type(data) ~= "table" or data.Type ~= "Teleport" then return end
        if data.Action == "In" then
            transitionSince = os.clock()
            startTransitionWatch()
        elseif data.Action == "Out" then
            transitionSince = nil
            stopTransitionWatch()
        else
            return
        end
        refreshTeleport()
    end

    -- the transport is built beside this api, so it is looked for again at every spawn until it answers
    local function watchTransition()
        if transitionConn ~= nil or closed then return end
        local net = ctx.Api and ctx.Api.CloverNet
        local on = type(net) == "table" and net.on or nil
        if type(on) ~= "function" then return end
        local okCall, ok, conn = pcall(on, "Transition", function(data)
            base.safe("transition", onTransition, data)
        end)
        if not okCall then
            base.warn("transition watch threw: %s", tostring(ok))
        elseif ok and conn ~= nil then
            transitionConn = conn
        else
            base.log("transition watch unavailable: %s", tostring(conn))
        end
    end

    -- player_state.md §4 in order; the first unmet condition is the reason
    local function readiness(char)
        local player = References.player
        if player:GetAttribute("Loaded") ~= true then return "NotLoaded" end
        if not char then return "NoCharacter" end
        if not inWorld(char) then return "NotInWorld" end
        local humanoid = PlayerHelpers.getHumanoid(char)
        if not humanoid then return "NoHumanoid" end
        if not (humanoid.Health > 0) then return "Dead" end
        if not char:FindFirstChild("States") then return "NoStates" end
        if not hasTag(char, "BPLoaded") then return "NoBackpack" end
        if char:GetAttribute("RaceTraitsLoaded") ~= true then return "NoRaceTraits" end
        if hasTag(char, "Dead") then return "Dead" end
        local anchored = reader.anchored(char)
        if anchored == nil then return "NoRoot" end
        if anchored then return "Anchored" end
        if truthy(char:GetAttribute("InCutscene")) then return "Cutscene" end
        local bin = player:FindFirstChild("bin")
        local event = bin and valueOf(bin, "Event")
        if type(event) == "string" and event ~= "" then return "Event" end
        return nil
    end

    -- Vanity.lua:39-66 in the game's own order, then the two holds that screen does not cover
    local function busyReason(char)
        local player = References.player
        if truthy(char:GetAttribute("InCutscene")) then return "Cutscene" end
        if hasTag(char, "Dead") then return "Dead" end
        local bin = player:FindFirstChild("bin")
        if bin then
            local event = valueOf(bin, "Event")
            if event ~= nil and event ~= "" then return "Event" end
            if truthy(valueOf(bin, "Chatting")) then return "Chat" end
            if truthy(valueOf(bin, "Cinematic")) then return "Cinematic" end
            if truthy(valueOf(bin, "InGUI")) then return "GUI" end
        end
        if truthy(player:GetAttribute("InMenu")) then return "Menu" end
        if truthy(char:GetAttribute("Meditating")) then return "Meditating" end
        return nil
    end

    -- polled at a modest interval from spawn until the first ready, then never again for that spawn
    local function watchReady(spawn)
        local watch
        local function check()
            if spawn.ready or spawn.ended or closed then return end
            if readiness(spawn.char) ~= nil then return end
            spawn.ready = true
            if watch then watch:Disconnect() end
            readySignal:Fire(spawn.char)
        end
        watch = Scheduler.heartbeat(function()
            base.safe("ready watch", check)
        end, { interval = READY_INTERVAL, name = "State.ready" })
        if watch then spawn.maid:GiveTask(watch) end
        check()
    end

    local function endSpawn(silent)
        local spawn = current
        if spawn then
            current = nil
            spawn.ended = true
            spawn.maid:DoCleaning()
        end
        transitionSince = nil
        stopTransitionWatch()
        if teleportingNow then
            teleportingNow = false
            if not silent then teleportSignal:Fire(false) end
        end
    end

    local function beginSpawn(char)
        if closed or not char then return end
        if current and rawequal(current.char, char) then return end
        -- only a spawn nobody closed is ended here: a transition that landed before this spawn was announced belongs to it
        if current then endSpawn(false) end
        local spawn = { char = char, maid = Maid.new(), ready = false, died = false, ended = false }
        current = spawn

        -- looked up directly, not through PlayerHelpers: this runs before the character is guaranteed a parent
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            spawn.maid:GiveTask(humanoid.Died:Connect(function()
                if spawn.died or spawn.ended or closed then return end
                spawn.died = true
                diedSignal:Fire(spawn.char)
            end))
        end

        local root = primaryRoot(char)
        if root then
            spawn.maid:GiveTask(root:GetPropertyChangedSignal("Anchored"):Connect(function()
                base.safe("teleport watch", refreshTeleport)
            end))
        end

        watchTransition()
        watchReady(spawn)
        refreshTeleport()
    end

    expose("player", function()
        local player = References.player
        if not player then return false, Errors.NOT_LOADED end
        return true, player
    end)

    expose("character", function()
        local char = liveCharacter()
        if not char then return false, Errors.NO_CHARACTER end
        return true, char
    end)

    expose("root", function()
        local root = PlayerHelpers.getRootPart(liveCharacter())
        if not root then return false, Errors.NO_CHARACTER end
        return true, root
    end)

    expose("humanoid", function()
        local humanoid = PlayerHelpers.getHumanoid(liveCharacter())
        if not humanoid then return false, Errors.NO_CHARACTER end
        return true, humanoid
    end)

    -- StateManager.lua:410-414
    expose("alive", function()
        local humanoid = PlayerHelpers.getHumanoid(liveCharacter())
        if not humanoid then return false, Errors.NO_CHARACTER end
        return true, humanoid.Health > 0
    end)

    -- StatManager.lua:62-65: the raw PlayerFolder attribute, nil when the server never wrote it
    expose("stat", function(name)
        if type(name) ~= "string" or name == "" then return false, Errors.BAD_ARGS end
        local folder = playerFolder()
        if not folder then return false, Errors.NOT_LOADED end
        return true, folder:GetAttribute(name)
    end)

    -- StatManager.lua:77-83; PlayerFolder lives on the player, so the watch outlives every respawn
    expose("onStat", function(name, fn)
        if type(name) ~= "string" or name == "" or type(fn) ~= "function" then return false, Errors.BAD_ARGS end
        if closed then return false, Errors.NOT_LOADED end
        local folder = playerFolder()
        if not folder then return false, Errors.NOT_LOADED end
        local conn = folder:GetAttributeChangedSignal(name):Connect(function()
            base.safe("onStat " .. name, fn, folder:GetAttribute(name))
        end)
        local handle = {}
        local function disconnect()
            if not statHandles[handle] then return end
            statHandles[handle] = nil
            conn:Disconnect()
        end
        handle.Disconnect = disconnect
        handle.Destroy = disconnect
        statHandles[handle] = true
        return true, handle
    end)

    expose("profile", function()
        local folder = playerFolder()
        if not folder then return false, Errors.NOT_LOADED end
        local player = References.player
        local out = {}
        for field, attribute in pairs(PROFILE_ATTRIBUTES) do
            out[field] = emptyToNil(folder:GetAttribute(attribute))
        end
        -- StatClient.lua:126-133: "None" and "" both mean no grimoire
        local magic = folder:GetAttribute("Magic")
        if magic ~= "None" then out.magic = emptyToNil(magic) end
        local customize = player:FindFirstChild("CustomizeFolder")
        if customize then
            out.race = textOf(customize, "Race")
            out.characterName = textOf(customize, "CharacterName")
            out.familyName = familyName(out.characterName)
        end
        -- TitleClient.lua:29-35: "" is no title equipped
        local titles = player:FindFirstChild("PlayerTitles")
        if titles then out.title = textOf(titles, "Title") end
        return true, out
    end)

    -- StatClient.lua:86-91
    expose("attributes", function()
        local skills = References.player:FindFirstChild("Skills")
        if not skills then return false, Errors.NOT_LOADED end
        local out = {}
        for _, name in ipairs(STATS) do
            local stat = skills:FindFirstChild(name)
            local level = stat and numberOf(stat, "Level")
            if level == nil then return false, Errors.NOT_LOADED end
            out[name] = level
        end
        return true, out
    end)

    -- GameplayHandle.lua:27,43-61
    expose("vitals", function()
        local char = liveCharacter()
        local humanoid = PlayerHelpers.getHumanoid(char)
        if not humanoid then return false, Errors.NO_CHARACTER end
        local states = char:FindFirstChild("States")
        if not states then return false, Errors.NOT_LOADED end
        local energy, maxEnergy = numberOf(states, "Energy"), numberOf(states, "MaxEnergy")
        local resolve, maxResolve = numberOf(states, "Resolve"), numberOf(states, "MaxResolve")
        if energy == nil or maxEnergy == nil or resolve == nil or maxResolve == nil then
            return false, Errors.NOT_LOADED
        end
        return true, {
            health     = humanoid.Health,
            maxHealth  = humanoid.MaxHealth,
            energy     = energy,
            maxEnergy  = maxEnergy,
            resolve    = resolve,
            maxResolve = maxResolve,
        }
    end)

    -- StateManager.lua:168-183
    expose("has", function(name)
        if type(name) ~= "string" or name == "" then return false, Errors.BAD_ARGS end
        local char = liveCharacter()
        if not char then return false, Errors.NO_CHARACTER end
        return true, reader.has(char, name)
    end)

    -- StateManager.lua:121-132
    expose("states", function()
        local char = liveCharacter()
        if not char then return false, Errors.NO_CHARACTER end
        local out = {}
        for key, value in pairs(char:GetAttributes()) do
            local id = value == true and string.match(key, "^State_(.+)$")
            if id then out[#out + 1] = Predicates.stateName(id) end
        end
        table.sort(out)
        return true, out
    end)

    -- StateManager.lua:185-224: StateEnd_ is a server-time stamp, so only the server clock can measure it
    expose("remaining", function(name)
        if type(name) ~= "string" or name == "" then return false, Errors.BAD_ARGS end
        local char = liveCharacter()
        if not char then return false, Errors.NO_CHARACTER end
        if not reader.has(char, name) then return true, 0 end
        local stamp = char:GetAttribute("StateEnd_" .. Predicates.stateId(name))
        if type(stamp) ~= "number" then return true, 0 end
        local left = stamp - serverNow()
        if left > 0 then return true, left end
        return true, 0
    end)

    expose("cooldowns", function()
        local char = liveCharacter()
        if not char then return false, Errors.NO_CHARACTER end
        local now = serverNow()
        local attributes = char:GetAttributes()
        local combat = {}
        for key, stamp in pairs(attributes) do
            local id = string.match(key, "^StateEnd_(.+)$")
            if id and type(stamp) == "number" and attributes["State_" .. id] == true and isCooldown(id) then
                local left = stamp - now
                if left > 0 then combat[id] = left end
            end
        end
        return true, { combat = combat, skills = skillCooldowns(char) }
    end)

    expose("skillCooldown", function(name)
        if type(name) ~= "string" or name == "" then return false, Errors.BAD_ARGS end
        local char = liveCharacter()
        if not char then return false, Errors.NO_CHARACTER end
        return true, skillCooldowns(char, name)[name] or 0
    end)

    -- soft only matters to "act", where it is the game's CanAction(true)
    expose("can", function(action, soft)
        if type(action) ~= "string" then return false, Errors.BAD_ARGS end
        if not Predicates.known(action) then return false, Errors.UNKNOWN_ACTION end
        local char = liveCharacter()
        if not char then return false, Errors.NO_CHARACTER end
        local reason = Predicates.blocker(reader, char, action, soft == true)
        if reason then return true, false, reason end
        return true, true
    end)

    expose("incapacitated", function()
        local char = liveCharacter()
        if not char then return false, Errors.NO_CHARACTER end
        local reason = Predicates.incapacitated(reader, char)
        return true, reason ~= nil, reason
    end)

    -- RespawnClient.lua:303-314, Vanity.lua:48
    expose("dead", function()
        local char = liveCharacter()
        local humanoid = PlayerHelpers.getHumanoid(char)
        if not humanoid then return false, Errors.NO_CHARACTER end
        return true, humanoid.Health <= 0 or hasTag(char, "Dead")
    end)

    expose("flying", function()
        local char = liveCharacter()
        if not char then return false, Errors.NO_CHARACTER end
        return true, Predicates.flying(reader, char)
    end)

    -- SafezoneClient.lua:12-17
    expose("inSafezone", function()
        local humanoid = PlayerHelpers.getHumanoid(liveCharacter())
        if not humanoid then return false, Errors.NO_CHARACTER end
        return true, humanoid:GetAttribute("InSafezone") == true
    end)

    -- DangerClient.lua:9-27: falsy when clear, otherwise the kind of fight, "PlayerCombat" being pvp
    expose("inCombat", function()
        local value = References.player:GetAttribute("InCombat")
        if not truthy(value) or value == "" then return true, false end
        if type(value) == "string" then return true, true, value end
        return true, true
    end)

    -- automation must not act while this is true
    expose("busy", function()
        local char = liveCharacter()
        if not char then return false, Errors.NO_CHARACTER end
        local reason = busyReason(char)
        return true, reason ~= nil, reason
    end)

    expose("teleporting", function()
        return true, computeTeleporting()
    end)

    -- TeleportCharacter.lua:103-129 brackets the server's own teleports with a Transition; ZeroSecure's rewinds only anchor the root
    expose("transitioning", function()
        return true, transitionPending()
    end)

    expose("ready", function()
        local reason = readiness(liveCharacter())
        return true, reason == nil, reason
    end)

    -- RespawnClient.lua:28: the location script carries it; held only once found, and dropped when the gui resets
    expose("location", function()
        local client = locationScript
        if not (client and client.Parent) then
            locationScript = nil
            local gui = References.player:FindFirstChild("PlayerGui")
            client = gui and gui:FindFirstChild("LocationClient", true)
            if not client then return true, nil end
            locationScript = client
        end
        local name = client:GetAttribute("CurrentLocation")
        if type(name) ~= "string" or name == "" then return true, nil end
        return true, name
    end)

    -- ProfessionClient.lua:97-110: a profession is any value with both an XP and an MXP sibling
    expose("professions", function()
        local folder = References.player:FindFirstChild("Professions")
        if not folder then return false, Errors.NOT_LOADED end
        local out = {}
        for _, child in ipairs(folder:GetChildren()) do
            local name = child.Name
            local level = child:IsA("ValueBase") and child.Value
            local xp, maxXp = numberOf(folder, name .. "XP"), numberOf(folder, name .. "MXP")
            if type(level) == "number" and xp ~= nil and maxXp ~= nil then
                out[name] = { level = level, xp = xp, maxXp = maxXp }
            end
        end
        return true, out
    end)

    -- DialogueManager.lua:161
    expose("reputation", function()
        local folder = References.player:FindFirstChild("Factions")
        if not folder then return false, Errors.NOT_LOADED end
        local out = {}
        for _, child in ipairs(folder:GetChildren()) do
            local value = child:IsA("ValueBase") and child.Value
            if type(value) == "number" then out[child.Name] = value end
        end
        return true, out
    end)

    -- Weight.lua:108-121: an unwritten weight is none carried and an unwritten cap is the base cap
    expose("carry", function()
        local player = References.player
        local weight = player:GetAttribute("CarryWeight")
        local max = player:GetAttribute("MaxCarryWeight")
        return true, {
            weight    = type(weight) == "number" and weight or 0,
            max       = type(max) == "number" and max or BASE_MAX_WEIGHT,
            unlimited = player:GetAttribute("UnlimitedCarryWeight") == true,
        }
    end)

    expose("serverTime", function()
        return true, serverNow()
    end)

    api.onReady    = listenable(readySignal)
    api.onDied     = listenable(diedSignal)
    api.onTeleport = listenable(teleportSignal)

    local unsubscribeAdded = References.onCharacter(function(char)
        base.safe("character added", beginSpawn, char)
    end)
    local unsubscribeRemoving = References.onCharacterRemoving(function()
        base.safe("character removing", endSpawn, false)
    end)

    if base.maid then
        base.maid:GiveTask(function()
            closed = true
            unsubscribeAdded()
            unsubscribeRemoving()
            endSpawn(true)
            local conn = transitionConn
            transitionConn = nil
            if conn ~= nil then base.safe("release transition watch", release, conn) end
            for handle in pairs(statHandles) do handle.Disconnect() end
        end)
    end

    return api
end

return M

end)
__bundle_register("Api/State/Predicates", function(require, _LOADED, __bundle_register, __bundle_modules)
-- state predicates: the game's own can-act rules (ReplicatedStorage.Modules.StateManager) mirrored line for line over a reader, each answering with the first state that would make the game refuse

local M = {}

-- game state names holding non-word characters, so a listed id can be handed back under the name the game uses
local SPACED_NAMES = {
    "Aerial Cooldown", "Aerial Critical Cooldown", "Crippling Fakeout Cooldown", "Dirty Casting Multiplier",
    "Infernal DefianceCooldown", "Negate ", "Strong Core", "Strong Core Cooldown", "Unyielding Bastion Cooldown",
    "Using Skill", "en garde",
    "Flame UltimateCooldown", "Light UltimateCooldown", "Lightning UltimateCooldown",
    "Shadow UltimateCooldown", "Time UltimateCooldown", "Wind UltimateCooldown",
}

local INCAPACITATING = { "Knocked", "Downed", "Detained", "Ragdoll", "BlockBroken", "Incapacitated" }
local BLOCKING       = { "Blocking", "SwordBlocking" }
local USING_COMBAT   = { "CombatDebounce", "Uppercutting" }
local COMBAT_HELD    = { "MisdirectActive", "Attacking", "Parried", "Occupied", "Stunned", "CantCombat", "ParriedAttack" }
local PARRY_HELD     = { "ParryCooldown", "Occupied", "Attacking" }
local BLOCK_HELD     = { "Stunned", "Occupied", "Attacking" }
local DASH_HELD      = { "Parried", "Occupied", "Stunned", "ParriedAttack", "Attacking" }
local SKILL_HELD     = { "ParriedAttack", "Stunned", "Parried", "Occupied", "MisdirectActive" }
local ACTION_HELD    = { "Locked", "Swinging", "Disabled" }

local ids, keys, names = {}, {}, {}

-- StateManager.lua:24,168-183: every non-alphanumeric character becomes an underscore
function M.stateId(name)
    local id = ids[name]
    if id then return id end
    id = (string.gsub(name, "%W", "_"))
    ids[name] = id
    keys[name] = "State_" .. id
    if names[id] == nil then names[id] = name end
    return id
end

function M.stateKey(name)
    local key = keys[name]
    if key then return key end
    M.stateId(name)
    return keys[name]
end

function M.stateName(id)
    return names[id] or id
end

for _, name in ipairs(SPACED_NAMES) do M.stateId(name) end

local function state(r, char, name)
    if r.has(char, name) then return name end
    return nil
end

local function first(r, char, list)
    for i = 1, #list do
        local name = list[i]
        if r.has(char, name) then return name end
    end
    return nil
end

-- StateManager.lua:485-491
local function grabbed(r, char)
    if r.grabbed(char) then return "Grabbed" end
    return nil
end

-- StateManager.lua:428-434: a dead character is incapacitated too
local function incapacitated(r, char)
    if not r.alive(char) then return "Dead" end
    return first(r, char, INCAPACITATING) or grabbed(r, char)
end

-- StateManager.lua:464-471
local function flying(r, char)
    if r.alive(char) and r.flying(char) then return "Flying" end
    return nil
end

-- every Is* the game folds in also requires alive; each check below has already answered for a dead character
local CHECKS = {}

-- StateManager.lua:493-510
function CHECKS.combat(r, char)
    if not r.alive(char) then return "Dead" end
    return state(r, char, "Downed")
        or incapacitated(r, char)
        or first(r, char, BLOCKING)
        or state(r, char, "Parrying")
        or state(r, char, "Dodging")
        or flying(r, char)
        or state(r, char, "SkillActive")
        or first(r, char, COMBAT_HELD)
        or first(r, char, USING_COMBAT)
end

-- StateManager.lua:512-528
function CHECKS.parry(r, char)
    if not r.alive(char) then return "Dead" end
    return first(r, char, BLOCKING)
        or incapacitated(r, char)
        or state(r, char, "Dodging")
        or state(r, char, "Parrying")
        or flying(r, char)
        or state(r, char, "SkillActive")
        or first(r, char, PARRY_HELD)
end

-- StateManager.lua:530-545
function CHECKS.block(r, char)
    if not r.alive(char) then return "Dead" end
    return first(r, char, BLOCKING)
        or incapacitated(r, char)
        or flying(r, char)
        or state(r, char, "SkillActive")
        or state(r, char, "Dodging")
        or first(r, char, BLOCK_HELD)
end

-- StateManager.lua:547-551
function CHECKS.dash(r, char)
    if not r.alive(char) then return "Dead" end
    return state(r, char, "DashCooldown")
        or first(r, char, DASH_HELD)
        or flying(r, char)
        or incapacitated(r, char)
        or state(r, char, "SkillActive")
        or state(r, char, "Dodging")
        or state(r, char, "Parrying")
end

-- StateManager.lua:623-640
function CHECKS.skill(r, char)
    if not r.alive(char) then return "Dead" end
    return state(r, char, "SkillActive")
        or grabbed(r, char)
        or incapacitated(r, char)
        or flying(r, char)
        or first(r, char, BLOCKING)
        or state(r, char, "Parrying")
        or state(r, char, "Dodging")
        or first(r, char, USING_COMBAT)
        or first(r, char, SKILL_HELD)
end

-- StateManager.lua:675-704; soft is the game's CanAction(true), which lets a stun or a parry through
function CHECKS.act(r, char, soft)
    local held = incapacitated(r, char)
        or grabbed(r, char)
        or state(r, char, "SkillActive")
        or first(r, char, ACTION_HELD)
    if held then return held end
    local anchored = r.anchored(char)
    if anchored == nil then return "NoRoot" end
    if anchored then return "Anchored" end
    local guard = first(r, char, BLOCKING) or state(r, char, "Dodging") or state(r, char, "Parrying")
    -- hyper armour shrugs off stun, parried and occupied, never blocking, dodging or parrying
    if r.hyperArmor(char) or r.has(char, "HyperArmor") then return guard end
    if soft then return guard or state(r, char, "Occupied") end
    return guard or state(r, char, "Stunned") or state(r, char, "Parried") or state(r, char, "Occupied")
end

M.ACTIONS = { "combat", "skill", "dash", "parry", "block", "act" }

function M.known(action)
    return CHECKS[action] ~= nil
end

-- nil when the game would allow the action, otherwise the first state it would refuse it for
function M.blocker(r, char, action, soft)
    return CHECKS[action](r, char, soft)
end

function M.incapacitated(r, char)
    return incapacitated(r, char)
end

function M.flying(r, char)
    return flying(r, char) ~= nil
end

return M

