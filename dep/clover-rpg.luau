__bundle_register("Features/Navigation/Teleports/Widgets", function(require, _LOADED, __bundle_register, __bundle_modules)
-- teleport widgets: the change-only status label and the self-guarded dropdown every teleports box shares; each write raises the identity obsidian needs first and stays pcall'd, since most come from a job thread that has just called the game

local Identity = require("Utility/Identity")

local M = {}

-- a wrapped label and its setter, which only touches the label when the text really changed
function M.line(groupbox, text)
    local label = groupbox:AddLabel(text, true)
    local shown = text
    return function(nextText)
        if nextText == nil or nextText == shown then return end
        Identity.elevate()
        if pcall(label.SetText, label, nextText) then shown = nextText end
    end
end

-- a dropdown whose own refills never read as the player's pick: onPick hears only a choice made in the menu
function M.picker(groupbox, id, info, onPick)
    local box = groupbox:AddDropdown(id, info)
    local filling = false

    box:OnChanged(function(value)
        if filling then return end
        onPick(value)
    end)

    local picker = { box = box }

    -- a new list when labels is given (nil keeps the one shown), then want picked
    function picker.fill(labels, want)
        filling = true
        Identity.elevate()
        if labels ~= nil then pcall(box.SetValues, box, labels) end
        if box.Value ~= want then pcall(box.SetValue, box, want) end
        filling = false
    end

    function picker.value()
        return box.Value
    end

    return picker
end

return M

end)
