                end
            end
        end
    end

    local function onEvent(kind, a, b)
        if kind == "Create" then
            onCreate(a, b)
        elseif kind == "Destroy" then
            -- every gate and the start marker carry the race's id, each orb its own
            if race.id ~= nil and a == race.id then
                if race.gate then
                    race.passed = (race.passed or 0) + 1
                    emit("passed", race.gate)
                end
                race.gate = nil
            end
        elseif kind == "Display" then
            if race.phase == "idle" or race.phase == "starting" then race.phase = "waiting" end
            if type(a) == "string" then race.course = a end
        elseif kind == "Countdown" then
            race.phase = "countdown"
            emit("countdown", { text = a })
        elseif kind == "Start" then
            race.phase = "racing"
            race.startedAt = os.clock()
            emit("go", {})
        elseif kind == "End" then
            local course = race.course
            local time = finite(a) and a or nil
            last = { course = course, time = time, placement = finite(b) and b or nil, finished = true, at = os.clock() }
            counts.finished = counts.finished + 1
            if course and time then
                local e = entry(course)
                if not finite(e.best) or time < e.best then
                    e.best = time
                    save()
                end
            end
            race, endedAt = { phase = "idle" }, os.clock()
            emit("finished", last)
        elseif kind == "Placement" then
            if last and finite(a) then last.placement = a end
            emit("placement", { placement = a })
        elseif kind == "Failed" then
            base.log("race failed (%s, %s, %d gates passed)", tostring(race.course), race.phase, race.passed or 0)
            if race.phase ~= "idle" then
                last = { course = race.course, failed = true, at = os.clock() }
                counts.failed = counts.failed + 1
            end
            race, endedAt = { phase = "idle" }, os.clock()
            emit("failed", last)
        end
    end

    -- RacingRemote only exists in the World place, so the listener is taken when a verb first finds it
    local function ensure()
        if hook then return true end
        local remote = net()
        if not remote then return false end
        local ok, handle = remote.on(EVENTS, onEvent)
        if not ok or not handle then return false end
        hook = handle
        if base.maid then base.maid:GiveTask(handle) end
        return true
    end

    -- the courses this server has, each with its start point when known and the best time we have flown it
    expose("courses", function()
        local root = folder()
        if not root then return false, Errors.NOT_READY end
        local out = {}
        for _, child in ipairs(root:GetChildren()) do
            if child:IsA("Folder") then
                local e = courses[child.Name]
                out[#out + 1] = {
                    name  = child.Name,
                    start = startOf(child.Name),
                    best  = type(e) == "table" and finite(e.best) and e.best or nil,
                }
            end
        end
        table.sort(out, function(x, y) return x.name < y.name end)
        return true, out
    end)

    expose("start", function(course)
        if type(course) ~= "string" or course == "" then return false, Errors.BAD_ARGS end
        local root = folder()
        if not root then return false, Errors.NOT_READY end
        local folderOf = root:FindFirstChild(course)
        if not (folderOf and folderOf:IsA("Folder")) then return false, Errors.NO_COURSE end
        if not ensure() then return false, Errors.NOT_READY end
        local remote = net()
        local ok, code = remote.fire(REMOTE, "Start", course)
        if not ok then return false, Errors.FAILED, code end
        race = { phase = "starting", course = course, askedAt = os.clock() }
        return true
    end)

    -- only a race not yet under way can be quit; mid-race the server ignores it
    expose("quit", function()
        local remote = net()
        if not remote then return false, Errors.NOT_READY end
        local ok, code = remote.fire(REMOTE, "Quit")
        if not ok then return false, Errors.FAILED, code end
        return true
    end)

    -- (true, { phase, course, start, gate, passed, startedAt, askedAt, inRace }); a gate is { position, normal, finish, index, radius }
    expose("status", function()
        ensure()
        recover()
        expire()
        return true, {
            phase     = race.phase,
            course    = race.course,
            start     = race.start or (race.course and startOf(race.course)) or nil,
            gate      = race.gate,
            passed    = race.passed or 0,
            startedAt = race.startedAt,
            askedAt   = race.askedAt,
            inRace    = inRace(),
        }
    end)

    -- the last race to end: { course, time, placement, finished } or { course, failed }
    expose("last", function()
        return true, last
    end)

    expose("stats", function()
        return true, { finished = counts.finished, failed = counts.failed }
    end)

    expose("startPoint", function(course)
        if type(course) ~= "string" then return false, Errors.BAD_ARGS end
        local point = startOf(course)
        if not point then return false, Errors.NO_COURSE end
        return true, point
    end)

    expose("best", function(course)
        if type(course) ~= "string" then return false, Errors.BAD_ARGS end
        local e = courses[course]
        return true, type(e) == "table" and finite(e.best) and e.best or nil
    end)

    -- kind is start, countdown, go, gate, passed, finished, placement or failed
    api.onEvent = {
        Connect = function(a, b)
            local fn = b
            if type(a) == "function" then fn = a end
            if type(fn) ~= "function" or closed then return { Disconnect = function() end, Destroy = function() end } end
            ensure()
            local inner = eventSignal:Connect(fn)
            local function disconnect() inner:Disconnect() end
            return { Disconnect = disconnect, Destroy = disconnect }
        end,
    }

    ensure()

    if base.maid then
        base.maid:GiveTask(function() closed = true end)
    end

    return api
end

return M

end)
