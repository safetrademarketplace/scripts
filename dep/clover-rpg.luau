__bundle_register("Api/Inventory", function(require, _LOADED, __bundle_register, __bundle_modules)
-- inventory api: what you carry (one Backpack Tool per item, its stock and quality on the matching LocalPlayer.Inventory entry) read against the game's pure-data Items catalog (type, rarity, whether it sells and for how much, Items.lua:36-42), and selling it through Remotes.Player.SellEvent the way the backpack's sell menu does (BackpackClient.lua:1792-1832); live 2026-10-24 the server took a sale with no merchant anywhere near; shared as ctx.Api.Inventory
local References = require("References")
local Services   = require("Services")
local Api        = require("Api")
local Errors     = require("Api/Inventory/Errors")

local SELL = "Player/SellEvent"
local MODES = { SellOne = true, SellHalf = true, SellAll = true }
local ANSWER_WAIT = 6

local M = {}

local function finite(n)
    return type(n) == "number" and n == n and n > -math.huge and n < math.huge
end

function M.new(ctx)
    local base = Api.define("Inventory", ctx)
    local api = { Errors = Errors }
    local closed = false
    local catalog, lastLoadError = nil, nil

    local function apiOf(name)
        local found = ctx.Api and ctx.Api[name]
        if type(found) == "table" then return found end
        return nil
    end

    local function settle(label, ok, ...)
        if ok then return ... end
        base.warn("%s threw: %s", label, tostring((...)))
        return false, Errors.NOT_READY
    end

    local function expose(name, fn)
        local label = "Inventory." .. name
        api[name] = function(...)
            if closed then return false, Errors.NOT_READY end
            return settle(label, pcall(fn, ...))
        end
    end

    -- ReplicatedStorage.Modules.Items is data the game fills at require time; kept once loaded, never while missing
    local function items()
        if catalog then return catalog end
        local modules = Services.ReplicatedStorage:FindFirstChild("Modules")
        local instance = modules and modules:FindFirstChild("Items")
        if not instance then return nil end
        local ok, value = pcall(require, instance)
        if not ok or type(value) ~= "table" or type(value.AllItems) ~= "table" then
            if tostring(value) ~= lastLoadError then
                lastLoadError = tostring(value)
                base.warn("the Items module did not load: %s", lastLoadError)
            end
            return nil
        end
        catalog = value
        return value
    end

    -- Formatter.lua:9-11: the base name is the key up to its first underscore
    local function baseName(key)
        return (string.split(key, "_"))[1]
    end

    local function sellPrice(mod, name, def)
        if type(mod.GetSellPrice) == "function" then
            local ok, price = pcall(mod.GetSellPrice, mod, name)
            if ok and finite(price) then return price end
        end
        if finite(def.SellPrice) then return def.SellPrice end
        return 0
    end

    local function equippedKeys()
        local out = {}
        local player = References.player
        local folder = player and player:FindFirstChild("PlayerFolder")
        if not folder then return out end
        for key, value in pairs(folder:GetAttributes()) do
            if type(value) == "string" and value ~= "" and (key == "FightingStyle" or string.sub(key, 1, 8) == "Equipped") then out[value] = true end
        end
        return out
    end

    local function readItems()
        local player = References.player
        local backpack = player and player:FindFirstChild("Backpack")
        local inventory = player and player:FindFirstChild("Inventory")
        local mod = items()
        if not (backpack and inventory and mod) then return nil end
        local equipped = equippedKeys()
        local out = {}
        local function add(tool)
            if not tool:IsA("Tool") then return nil end
            local name = baseName(tool.Name)
            local def = mod.AllItems[name]
            if type(def) ~= "table" then return nil end
            local entry = inventory:FindFirstChild(tool.Name)
            local stock = entry and entry:GetAttribute("Stock") or tool:GetAttribute("Stock")
            if not finite(stock) then stock = 1 end
            local locked = tool:GetAttribute("Locked") == true or (entry ~= nil and entry:GetAttribute("Locked") == true)
            out[#out + 1] = {
                key      = tool.Name,
                name     = name,
                tool     = tool,
                type     = def.Type,
                rarity   = def.Rarity,
                stock    = stock,
                sellable = def.Sellable == true and not locked and not equipped[tool.Name],
                price    = sellPrice(mod, name, def),
                locked   = locked,
                equipped = equipped[tool.Name] == true,
            }
            return out[#out]
        end
        for _, tool in ipairs(backpack:GetChildren()) do add(tool) end
        local char = player.Character
        if char then
            for _, tool in ipairs(char:GetChildren()) do
                local held = add(tool)
                if held then held.equipped, held.sellable = true, false end
            end
        end
        table.sort(out, function(a, b) return a.name < b.name end)
        return out
    end

    -- (true, list) of what you carry: { key, name, type, rarity, stock, sellable, price, locked, equipped }; an equipped or locked item never counts as sellable
    expose("items", function()
        local list = readItems()
        if not list then return false, Errors.NOT_READY end
        local out = {}
        for i, item in ipairs(list) do
            out[i] = {
                key = item.key, name = item.name, type = item.type, rarity = item.rarity, stock = item.stock,
                sellable = item.sellable, price = item.price, locked = item.locked, equipped = item.equipped,
            }
        end
        return true, out
    end)

    -- (true, list) of the names of every sellable item the catalog has, for a picker
    expose("sellableNames", function()
        local mod = items()
        if not mod then return false, Errors.NOT_READY end
        local out = {}
        for name, def in pairs(mod.AllItems) do
            if type(name) == "string" and type(def) == "table" and def.Sellable == true then out[#out + 1] = name end
        end
        table.sort(out)
        return true, out
    end)

    -- sells every one of an item you carry (mode SellAll, the default) or one or half; (true, marks earned); yields
    expose("sell", function(name, mode)
        if type(name) ~= "string" or name == "" then return false, Errors.BAD_ARGS end
        mode = mode or "SellAll"
        if not MODES[mode] then return false, Errors.BAD_ARGS end
        if not coroutine.isyieldable() then return false, Errors.BAD_ARGS end
        local list = readItems()
        local net = apiOf("CloverNet")
        if not (list and net) then return false, Errors.NOT_READY end
        local target = nil
        for _, item in ipairs(list) do
            if item.name == name or item.key == name then target = item end
        end
        if not target then return false, Errors.NO_ITEM end
        if not target.sellable then return false, Errors.NOT_SELLABLE end
        local player = References.player
        local folder = player and player:FindFirstChild("PlayerFolder")
        local before = folder and folder:GetAttribute("Marks")
        local ok, answer = net.callWith(SELL, { timeout = ANSWER_WAIT }, mode, target.tool)
        if not ok then return false, Errors.NO_ANSWER, answer end
        if answer ~= true then return false, Errors.FAILED, answer end
        local after = folder and folder:GetAttribute("Marks")
        local earned = (finite(before) and finite(after)) and math.max(after - before, 0) or 0
        return true, earned
    end)

    if base.maid then
        base.maid:GiveTask(function() closed = true end)
    end

    return api
end

return M

end)
