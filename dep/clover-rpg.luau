__bundle_register("Features/Visuals/Visuals/Fullbright", function(require, _LOADED, __bundle_register, __bundle_modules)
-- fullbright sub-module of visuals: holds daylight with no fog or haze on the live Lighting, Atmosphere and zone colour grade, stops the day cycle through the game's own ClockDisabled switch, and on stop lets the zone script re-apply its look by staling the Atmosphere's Active attribute
local CLOCK_SWITCH = "ClockDisabled"
local ZONE_KEY     = "Active"
