local Tuning = require("Api/Movement/Tuning")

local M = {}

local function finite(n)
    return type(n) == "number" and n == n and n > -math.huge and n < math.huge
end

local function finiteVector(v)
    return typeof(v) == "Vector3" and finite(v.X) and finite(v.Y) and finite(v.Z)
end

local function flatDistance(a, b)
    local dx, dz = a.X - b.X, a.Z - b.Z
    return math.sqrt(dx * dx + dz * dz)
end

-- cloneref'd handles never compare equal, so a door is only ever known by its full name
function M.name(instance)
    local ok, name = pcall(function() return instance:GetFullName() end)
    if ok and type(name) == "string" then return name end
    return nil
end

-- and every Kamo door shares one full name (live 2026-10-24: Workspace.Map.Areas.Kamo_Village.Structures.Door, room doors and the front door alike), so it is told apart by where it stands
local function keyOf(name, position)
    return ("%s@%d,%d"):format(name, math.floor(position.X + 0.5), math.floor(position.Z + 0.5))
end

local function flatOutward(outward)
    local length = math.sqrt(outward.X * outward.X + outward.Z * outward.Z)
    if length < 1e-3 then return nil end
    return outward.X / length, outward.Z / length
end

-- World.doors, read fresh every time; a World without a door index is simply no help
local function query(ctx, origin, radius, limit)
    local World = ctx.Api and ctx.Api.World
    local doors = type(World) == "table" and World.doors or nil
    if type(doors) ~= "function" then return {} end
    local ok, okList, list = pcall(doors, { origin = origin, maxDistance = radius, limit = limit or Tuning.doorLimit })
    if not (ok and okList and type(list) == "table") then return {} end
    local out = {}
    for _, entry in ipairs(list) do
        if type(entry) == "table" and typeof(entry.touch) == "Instance" and finiteVector(entry.position)
            and finiteVector(entry.outward) and flatOutward(entry.outward) then
            local name = M.name(entry.model or entry.touch)
            if name then
                local panel = nil
                if typeof(entry.panel) == "Instance" then panel = entry.panel end
                out[#out + 1] = {
                    name = name, key = keyOf(name, entry.position), touch = entry.touch, panel = panel,
                    position = entry.position, outward = entry.outward,
                }
            end
        end
    end
    return out
end

-- doors near the target and near us, nearest the target first, each once, none already tried and none too far to plan to; with a probe, a door with open sky past it comes first, since it leads out of the building (live 2026-10-24: nine doors within 52 studs of an inn room, the rest of them other rooms)
function M.find(ctx, here, goal, tried, probe)
    local seen, out = {}, {}
    local function add(list)
        for _, door in ipairs(list) do
            if not seen[door.key] and not tried[door.key] and flatDistance(here, door.position) <= Tuning.legLengths[1] then
                seen[door.key] = true
                door.score = flatDistance(door.position, goal)
                out[#out + 1] = door
            end
        end
    end
    add(query(ctx, goal, Tuning.doorNearTarget))
    add(query(ctx, here, Tuning.doorNearUs, Tuning.doorScan))
    if probe then
        for _, door in ipairs(out) do
            local ox, oz = flatOutward(door.outward)
            local p = door.position
            local side = 1
            if (here.X - p.X) * ox + (here.Z - p.Z) * oz < 0 then side = -1 end
            local far = Vector3.new(p.X - ox * side * Tuning.doorStandoff, p.Y, p.Z - oz * side * Tuning.doorStandoff)
