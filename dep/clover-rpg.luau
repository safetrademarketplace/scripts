__bundle_register("Api/Professions", function(require, _LOADED, __bundle_register, __bundle_modules)
-- professions api: profession progress, the node registry with its streamed models, the gathering minigame solver and the gather driver on top of it; shared as ctx.Api.Professions, every method is dot-called, never throws, and none of it moves the character

local Api      = require("Api")
local Errors   = require("Api/Professions/Errors")
local Gather   = require("Api/Professions/Gather")
local Nodes    = require("Api/Professions/Nodes")
local Progress = require("Api/Professions/Progress")
local Solver   = require("Api/Professions/Solver")

local M = {}

local function noop() end

local function finite(value)
    return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

-- a nodes() filter, validated and with items normalised to a set; nil is a bad argument
local function readFilter(filter, originOptional)
    if filter == nil then return {} end
    if type(filter) ~= "table" then return nil end
    local out = {}
    if filter.kind ~= nil then
        if Nodes.KINDS[filter.kind] == nil then return nil end
        out.kind = filter.kind
    end
    if filter.items ~= nil then
        if type(filter.items) ~= "table" then return nil end
        local set = {}
        for key, value in pairs(filter.items) do
            if type(key) == "string" and value == true then
                set[key] = true
            elseif type(key) == "number" and type(value) == "string" then
                set[value] = true
            else
                return nil
            end
        end
        out.items = set
    end
    if filter.available ~= nil then
        if type(filter.available) ~= "boolean" then return nil end
        out.available = filter.available
    end
    if filter.maxPower ~= nil then
        if not finite(filter.maxPower) then return nil end
        out.maxPower = filter.maxPower
    end
    if filter.origin ~= nil then
        if typeof(filter.origin) ~= "Vector3" then return nil end
        out.origin = filter.origin
    end
    if filter.maxDistance ~= nil then
        if not finite(filter.maxDistance) or filter.maxDistance <= 0 then return nil end
        if out.origin == nil and not originOptional then return nil end
        out.maxDistance = filter.maxDistance
    end
    if filter.limit ~= nil then
        if not finite(filter.limit) or filter.limit < 1 or filter.limit ~= math.floor(filter.limit) then return nil end
        out.limit = filter.limit
    end
    return out
end

function M.new(ctx)
    local base = Api.define("Professions", ctx)

    local api = { Errors = Errors }
    local closed = false

    -- the sibling apis are looked up at call time: each is built beside this one and any of them may have failed to build
    local function apiOf(name)
        local apis = ctx.Api
        if type(apis) ~= "table" then return nil end
        local found = apis[name]
        if type(found) == "table" then return found end
        return nil
    end

    local env = {
        base   = base,
        api    = apiOf,
        closed = function() return closed end,
    }

    local solver   = Solver.new(env)
    local nodes    = Nodes.new(env)
    local progress = Progress.new(env, solver)
    local gather   = Gather.new(env, solver, nodes)

    -- a throw on an instance tree in an unexpected shape becomes a code, so a caller never needs its own pcall
    local function settle(label, ok, ...)
        if ok then return ... end
        base.warn("%s threw: %s", label, tostring((...)))
        return false, Errors.FAILED
    end

    local function expose(target, name, fn)
        local label = "Professions." .. name
        target[name] = function(...)
            if closed then return false, Errors.NOT_READY end
            return settle(label, pcall(fn, ...))
        end
    end

