        return true
    end
    local stateFile = string.format("Cerberus/%s/settings/autoshow_state.json", References.gameName)
    if not isfile(stateFile) then
        return true
    end
    local okRead, raw = pcall(readfile, stateFile)
    if not okRead or type(raw) ~= "string" then
        return true
    end
    local HttpService = Services.HttpService
    local okDecode, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
    if not okDecode or type(decoded) ~= "table" then
        return true
    end
    if type(decoded.autoshow) == "boolean" then
        return decoded.autoshow
    end
    return true
end

function M.setup(Config)
    Globals.set("__rbx_runtime_ui", Library)

    -- must land before CreateWindow: the library resolves its own chrome icons off this module
    Library:SetIconModule(Icons)

    -- patches must install before CreateWindow so the Window/Tab/Groupbox closures are the wrapped variants
    Localize.start()
    LocalizePatch.install(Library)
    Premium.install(Library)

    if ThemeManager and ThemeManager.SetLibrary then
        ThemeManager:SetLibrary(Library)
    end

    Library.ForceCheckbox = false
    Library.ShowToggleFrameInKeybinds = true

    local autoShowState = getAutoShowState()
    -- AutoShow stays false so the window doesn't pop over the fading loader; Cerberus.lua applies the saved preference later
    local Window = Library:CreateWindow({
        Title = "Cerberus",
        Footer = References.gameName .. " | https://getcerberus.com",
        Icon = 124492948563353,
        NotifySide = "Right",
        ShowCustomCursor = false,
        AutoShow = false,
        Font = Enum.Font.BuilderSans,
        CornerRadius = 10,
        -- the search box looks through every tab and jumps to the first one with a match, since the menu is too big to search one tab at a time
        GlobalSearch = true,
        -- library ships these off by default; slate wants the motion
        Animations = {
            ToggleWindow = true,
            TabSwitch = false,
            Groupbox = true,
            Dropdown = true,
            KeyPicker = true,
        },
    })

    tintTopbarIcon(Library)
    installInstanceMarker()

    local Tabs = FeatureRegistry.buildTabs(Window, Config)

    return {
        Library       = Library,
        ThemeManager  = ThemeManager,
        SaveManager   = SaveManager,
        Window        = Window,
        Tabs          = Tabs,
        AutoShowState = autoShowState,
    }
end

