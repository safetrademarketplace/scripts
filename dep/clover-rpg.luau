    local clockWas = nil
    local addedConn, removedConn = nil, nil
    -- inst -> prop -> { want, original, conn }
    local held = {}

    local function hold(inst, prop, want)
        local props = held[inst]
        if props == nil then
            props = {}
            held[inst] = props
        end
        local entry = props[prop]
        if entry == nil then
