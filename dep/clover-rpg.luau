        local here = rootPosition()
        if not (World and here) then return end
        -- by presence, not health: an instakill mode zeroes a mob's health on this client while the server's mob fights on
        local ok, list = World.mobs({ origin = here, maxDistance = widest() + WATCH_SLACK, limit = WATCH_LIMIT })
