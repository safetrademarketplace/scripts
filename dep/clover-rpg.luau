            local scrollLayout = Instance.new("UIListLayout", scroll)
            scrollLayout.FillDirection = Enum.FillDirection.Vertical
            scrollLayout.SortOrder     = Enum.SortOrder.LayoutOrder
            scrollLayout.Padding       = UDim.new(0, 4)

            local function resyncCanvas()
                scroll.CanvasSize = UDim2.fromOffset(0, scrollLayout.AbsoluteContentSize.Y + 8)
                scroll.CanvasPosition = Vector2.new(0,
                    math.max(0, scrollLayout.AbsoluteContentSize.Y - scroll.AbsoluteSize.Y))
            end
            track(scrollLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(resyncCanvas))

            local function colorFor(kind)
                if kind == "Error"   then return Color3.fromRGB(255, 90, 90) end
                if kind == "Warning" then return Color3.fromRGB(255, 210, 100) end
                return Color3.fromRGB(210, 215, 230)
            end

            -- FIFO of parented TextLabels capped at maxBuffer; without eviction a noisy game ballooned scroll children indefinitely
            local visibleLabels = {}

            local function addLine(text, kind)
                local enabled = (kind == "Log" and state.showLog)
                    or (kind == "Warning" and state.showWarn)
                    or (kind == "Error" and state.showErr)
                if not enabled then return end

                local tl = Instance.new("TextLabel")
                tl.BackgroundTransparency = 1
                tl.Font              = Enum.Font.Code
                tl.TextXAlignment    = Enum.TextXAlignment.Left
                tl.TextYAlignment    = Enum.TextYAlignment.Top
                tl.TextWrapped       = true
                tl.RichText          = false
                tl.Size              = UDim2.new(1, -8, 0, 0)
                tl.AutomaticSize     = Enum.AutomaticSize.Y
                tl.TextSize          = 14
                tl.TextColor3        = colorFor(kind)
                tl.Text              = "[" .. kind .. "] " .. text
                tl.Parent            = scroll

                visibleLabels[#visibleLabels + 1] = tl
                while #visibleLabels > state.maxBuffer do
                    local oldest = table.remove(visibleLabels, 1)
                    if oldest then oldest:Destroy() end
                end
            end

            rebuild = function()
                for i = 1, #visibleLabels do
                    local lbl = visibleLabels[i]
                    if lbl then lbl:Destroy() end
                end
                table.clear(visibleLabels)
                for i = 1, #state.buffer do
                    local entry = state.buffer[i]
                    addLine(entry.msg, entry.type)
                end
                resyncCanvas()
            end

            track(clearBtn.Activated:Connect(function()
                table.clear(state.buffer)
                rebuild()
            end))

            track(copyBtn.Activated:Connect(function()
                local out = {}
                for i = 1, #state.buffer do
                    local entry = state.buffer[i]
                    local enabled = (entry.type == "Log" and state.showLog)
                        or (entry.type == "Warning" and state.showWarn)
                        or (entry.type == "Error" and state.showErr)
                    if enabled then
                        out[#out + 1] = "[" .. entry.type .. "] " .. entry.msg
                    end
                end
                local text = table.concat(out, "\n")
                if setclipboard then
                    pcall(setclipboard, text)
                elseif toclipboard then
                    pcall(toclipboard, text)
                end
            end))

            makeFilterPill("Errors",   function() return state.showErr  end, function(v) state.showErr  = v end)
            makeFilterPill("Logs",     function() return state.showLog  end, function(v) state.showLog  = v end)
            makeFilterPill("Warnings", function() return state.showWarn end, function(v) state.showWarn = v end)

            local function setMinimized(wantMin)
                state.minimized = wantMin
                if wantMin then
                    body.Visible = false
                    window.Size  = UDim2.new(window.Size.X.Scale, window.Size.X.Offset, 0, 34)
                else
                    body.Visible = true
                    window.Size  = UDim2.new(0, 560, 0, 300)
                end
            end

            track(minBtn.Activated:Connect(function() setMinimized(not state.minimized) end))
            track(closeBtn.Activated:Connect(cleanup))

            track(LogService.MessageOut:Connect(function(message, mt)
                bufferMessage(message, mt)
                local entry = state.buffer[#state.buffer]
                if entry then
                    addLine(entry.msg, entry.type)
                    resyncCanvas()
                end
            end))

            state.gui = screenGui
            -- give the gui to the maid so unload teardown reaches the window even if close was never clicked
            if maid then maid:GiveTask(screenGui) end
            rebuild()
        end

        buildGui()
        currentConsole = { cleanup = cleanup }
    end

    ConsoleGroup:AddButton({
        Text = "Console",
        Func = function()
            Library:Notify("Launched console.", 3)
            launchConsole()
        end
    })

    return {
        cleanup = function()
            if currentConsole then currentConsole.cleanup() end
        end,
    }
end

end)
__bundle_register("Features/Misc/ServerPanel", function(require, _LOADED, __bundle_register, __bundle_modules)
-- serverPanel sub-module of Misc: SmartServerHop + auto-hop UI
local Http  = require("Utility/Helpers/Http")
local Jobs  = require("Utility/Jobs")
local Place = require("UI/Place")

return function(ctx)
    local Services   = ctx.Services
    local References = ctx.References
    local Library    = ctx.Library
    local Options    = ctx.Options
    local Toggles    = ctx.Toggles

    local function SmartServerHop(filter, maxPlayersLimit, maxPingLimit, placeId, maxPages)
        local httpRequest = Http.client()
        if not httpRequest then
            return false, "No HTTP request function available"
        end

        placeId = tonumber(placeId) or Services.Game.PlaceId
        maxPages = maxPages or 2
        local currentJob = Services.Game.JobId

        local function fetchPage(cursor)
            local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(placeId)
            if cursor and cursor ~= "" then
                url = url .. "&cursor=" .. Services.HttpService:UrlEncode(cursor)
            end

            local okCall, res = pcall(httpRequest, {
                Url = url,
                Method = "GET",
                Headers = { ["Content-Type"] = "application/json" }
            })

            if not okCall or type(res) ~= "table" then
                return false, "HTTP request failed"
            end

            -- executors surface status under different keys; accept any 2xx, mirroring Auth/Http.lua normalisation
            local status = res.StatusCode or res.status_code or res.Status
            local ok2xx = type(status) == "number" and status >= 200 and status < 300
            if status == nil and res.Success ~= nil then ok2xx = res.Success == true end

            if not ok2xx then
                local msg = res.StatusMessage or res.status_message or ("HTTP " .. tostring(status or "error"))
                return false, msg
            end

            local body = res.Body or res.body
            if type(body) ~= "string" or body == "" then
                return false, "Empty HTTP response"
            end

            local ok, decoded = pcall(Services.HttpService.JSONDecode, Services.HttpService, body)
            if not ok then
                return false, "JSON decode failed"
            end

            return true, decoded
        end

        local candidates = {}
        local cursor = nil
        local pages = 0

        while pages < maxPages do
            local ok, dataOrErr = fetchPage(cursor)
            if not ok then return false, dataOrErr end

            local data = dataOrErr
            if type(data.data) ~= "table" then break end

            for _, srv in ipairs(data.data) do
                local jobId = srv.id
                local playing = srv.playing or 0
                local maxPlayers = srv.maxPlayers or 0
                local ping = srv.ping or srv.playerPing

                if jobId ~= currentJob then
                    local hasSpace = (playing < maxPlayers)

                    local okPlayers = true
                    if maxPlayersLimit then
                        okPlayers = (playing <= maxPlayersLimit)
                    end

                    local okPing = true
                    if maxPingLimit then
                        if ping == nil then
                            okPing = false
                        else
                            okPing = (ping <= maxPingLimit)
                        end
                    end

                    if hasSpace and okPlayers and okPing then
                        table.insert(candidates, {
                            jobId = jobId,
                            players = playing,
                            maxPlayers = maxPlayers,
                            ping = ping or math.huge,
                            raw = srv
                        })
                    end
                end
            end

            cursor = data.nextPageCursor
            pages = pages + 1
            if not cursor or cursor == "" then break end
        end

        if #candidates == 0 then
            return false, "No suitable servers found"
        end

        if filter == "lowest_player" then
            table.sort(candidates, function(a, b)
                if a.players == b.players then return a.ping < b.ping end
                return a.players < b.players
            end)
        elseif filter == "lowest_ping" then
            table.sort(candidates, function(a, b)
                if a.ping == b.ping then return a.players < b.players end
                return a.ping < b.ping
            end)
        elseif filter == "random" then
            math.randomseed(os.time() + #candidates)
            local idx = math.random(1, #candidates)
            local chosen = candidates[idx]
            local ok, err = pcall(function()
                Services.TeleportService:TeleportToPlaceInstance(placeId, chosen.jobId, References.player)
            end)
            if not ok then return false, "Teleport failed: " .. tostring(err) end
            return true, "Teleporting to random server"
        else
            table.sort(candidates, function(a, b)
                if a.ping == b.ping then return a.players < b.players end
                return a.ping < b.ping
            end)
        end

        local chosen = candidates[1]
        local ok, err = pcall(function()
            Services.TeleportService:TeleportToPlaceInstance(placeId, chosen.jobId, References.player)
        end)
        if not ok then return false, "Teleport failed: " .. tostring(err) end

        return true, "Teleporting to server " .. tostring(chosen.jobId)
    end

    -- no box means no auto-hop to drive, but the hop itself still serves the misc api
    local ServerGroup = Place.groupbox(ctx, "Server Panel", "server", { fallback = "Misc", side = "Left" })
    if not ServerGroup then return { SmartServerHop = SmartServerHop } end

    ServerGroup:AddSlider("SERVER_MaxPlayers", {
        Text = "Max Player Count",
        Min = 1,
        Max = 50,
        Default = 20,
        Rounding = 0
    })

    ServerGroup:AddSlider("SERVER_MaxPing", {
        Text = "Max Ping (ms)",
        Min = 1,
        Max = 1000,
        Default = 200,
        Rounding = 0
    })

    local filterValues = { "Lowest Players", "Lowest Ping", "Random" }

    ServerGroup:AddDropdown("SERVER_Filter", {
        Text = "Filter",
        Values = filterValues,
        Default = "Lowest Ping",
        Multi = false
    })

    local function getFilterKey()
        local v = Options.SERVER_Filter and Options.SERVER_Filter.Value or "Lowest Ping"
        if v == "Lowest Players" then
            return "lowest_player"
        elseif v == "Random" then
            return "random"
        else
            return "lowest_ping"
        end
    end

    local function doSingleHop()
        local maxPlayers = tonumber(Options.SERVER_MaxPlayers and Options.SERVER_MaxPlayers.Value) or nil
        local maxPing = tonumber(Options.SERVER_MaxPing and Options.SERVER_MaxPing.Value) or nil
        local filterKey = getFilterKey()

        local ok, msg = SmartServerHop(filterKey, maxPlayers, maxPing)
        if not ok then
            Library:Notify("[Server Hop] Failed: " .. tostring(msg), 4)
        else
            Library:Notify("[Server Hop] " .. tostring(msg), 4)
        end
    end

    ServerGroup:AddButton({
        Text = "Server Hop Once",
        Func = function() doSingleHop() end
    })

    local serverAutoHopRunning = false
    local serverAutoHopJob = nil

    local function stopServerAutoHop()
        serverAutoHopRunning = false
        if serverAutoHopJob then
            serverAutoHopJob:Cancel()
            serverAutoHopJob = nil
        end
    end

    local function startServerAutoHop()
        if serverAutoHopRunning then return end
        serverAutoHopRunning = true

        -- the 0.5s poll that used to make the interval interruptible is gone: Cancel is immediate
        local function hopInterval()
            return math.clamp(tonumber(Options.SERVER_AutoHopInterval and Options.SERVER_AutoHopInterval.Value) or 60, 1, 600)
        end

        serverAutoHopJob = Jobs.interval(hopInterval(), function(job)
            if not serverAutoHopRunning or not (Toggles.SERVER_AutoHop and Toggles.SERVER_AutoHop.Value) then
                job:Cancel()
                return
            end

            local maxPlayers = tonumber(Options.SERVER_MaxPlayers and Options.SERVER_MaxPlayers.Value) or nil
