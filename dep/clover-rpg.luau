    self.distance.Visible = enabled and onScreen and dist.enabled and self.distanceStuds ~= nil and labelBottom ~= nil
    if self.distance.Visible then
        local d = self.distance
        d.Text = round(self.distanceStuds) .. " studs"
        d.Size = textSize; d.Font = textFont
        d.Color = self:resolveColor(dist.color)
        d.Transparency = dist.transparency
        d.Outline = dist.outline
        d.OutlineColor = dist.outlineColor
