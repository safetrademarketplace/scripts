local TabHome       = require("Tabs/Home")
local TabFarm       = require("Tabs/Farm")
local TabGathering  = require("Tabs/Gathering")
local TabTeleports  = require("Tabs/Teleports")
local TabAlerts     = require("Tabs/Alerts")
local TabCombat     = require("Tabs/Combat")
local TabPlayer     = require("Tabs/Player")
local TabESP        = require("Tabs/ESP")
local TabVisuals    = require("Tabs/Visuals")
local TabMisc       = require("Tabs/Misc")
local TabFun        = require("Tabs/Fun")
local TabUISettings = require("Tabs/UISettings")

local M = {}

-- display = entry order, mount = ascending mountOrder (UISettings first so theme/save hooks land before features); configKeys all-false skips the tab, none = always present
-- an optional `section` puts a sidebar header above the first shown tab of each run of rows sharing it
M.tabs = {
    { key = "Home",        label = "Home",        icon = "house",        mount = TabHome,       mountOrder = 2,  configKeys = { "Home" } },

    { key = "Farm",        label = "Farm",        icon = "tractor",      mount = TabFarm,       mountOrder = 12, section = "FARMING", configKeys = { "Farm" } },
    { key = "Gathering",   label = "Gathering",   icon = "pickaxe",      mount = TabGathering,  mountOrder = 11, section = "FARMING", configKeys = { "Gathering" } },

    { key = "Teleports",   label = "Teleports",   icon = "map-pin",      mount = TabTeleports,  mountOrder = 5,  section = "WORLD",   configKeys = { "Teleports" } },
    { key = "Alerts",      label = "Alerts",      icon = "bell-ring",    mount = TabAlerts,     mountOrder = 17, section = "WORLD",   configKeys = { "Notifications", "Webhook" } },

    { key = "Combat",      label = "Combat",      icon = "swords",       mount = TabCombat,     mountOrder = 7,  section = "COMBAT",  configKeys = { "Aimbot", "Instakill", "AutoParry", "SilentAim" } },

    { key = "Player",      label = "Player",      icon = "circle-user",  mount = TabPlayer,     mountOrder = 6,  section = "PLAYER",  captureAs = "Movement", configKeys = { "Movement", "PlayerUtils", "CloverUtils" } },

    { key = "ESP",         label = "ESP",         icon = "eye",          mount = TabESP,        mountOrder = 8,  section = "VISUALS", configKeys = { "ESP" } },
    { key = "Visuals",     label = "Visuals",     icon = "glasses",      mount = TabVisuals,    mountOrder = 9,  section = "VISUALS", configKeys = { "Visuals", "CloverUtils" } },

    { key = "Misc",        label = "Misc",        icon = "archive",      mount = TabMisc,       mountOrder = 10, section = "MISC",    configKeys = { "Misc" } },
    { key = "Fun",         label = "Fun",         icon = "joystick",     mount = TabFun,        mountOrder = 18, section = "MISC",    configKeys = { "Fun" } },
    { key = "UI Settings", label = "UI Settings", icon = "settings",     mount = TabUISettings, mountOrder = 1,  section = "MISC" },
}

local function isTabEnabled(def, Config)
    if not def.configKeys then return true end
    if type(Config) ~= "table" then return true end
    for _, key in ipairs(def.configKeys) do
        if Config[key] then return true end
    end
    return false
end

-- a header goes in only when a shown tab starts a new section, so a section whose tabs are all switched off leaves no empty header behind
function M.buildTabs(Window, Config)
    local Tabs = {}
    local section = nil
    for _, def in ipairs(M.tabs) do
        if isTabEnabled(def, Config) then
            if def.section ~= section then
                section = def.section
                if section ~= nil and type(Window.AddSection) == "function" then Window:AddSection(section) end
            end
            Tabs[def.key] = Window:AddTab(def.label, def.icon)
        end
    end
    return Tabs
end

function M.mountAll(ctx, Debug)
    local ordered = {}
    for _, def in ipairs(M.tabs) do ordered[#ordered + 1] = def end
    table.sort(ordered, function(a, b)
        return (a.mountOrder or math.huge) < (b.mountOrder or math.huge)
    end)

    local captured = {}
    local Tabs = ctx.Tabs or {}
    for _, def in ipairs(ordered) do
        if Tabs[def.key] then
            Debug:LoadModule(def.key, function()
                local result = def.mount(ctx)
                if def.captureAs then captured[def.captureAs] = result end
            end)
        end
    end
    return captured
end

return M

end)
