        if current ~= nil then return false, "busy" end
        local net = deps.net()
        if net == nil then return false, "not_ready" end

        local entry = { provider = provider, live = true, threw = false }

        -- a provider that throws is logged once per override, then the game answers for it
        local function onThrow(err)
            if entry.threw then return end
            entry.threw = true
            deps.warn("aim provider threw: %s", tostring(err))
        end

        local function wrapper(original, ...)
            if not entry.live then return original(...) end
            return M.answer(entry.provider, original, onThrow, ...)
        end

        local ok, wrap = net.wrapCallback(CALLBACK, wrapper)
        if not ok then return false, codeFor(net, wrap) end
        entry.wrap = wrap
        current = entry

        local handle = {}
        function handle.Destroy()
            if not entry.live then return end
            entry.live = false
            if current == entry then current = nil end
            wrap.Restore()
        end
        handle.Disconnect = handle.Destroy
        handle.Restore = handle.Destroy
        function handle.active() return entry.live end
        return true, handle
    end

    function aim.clear()
        local entry = current
        if entry == nil then return false end
        current = nil
        entry.live = false
        entry.wrap.Restore()
        return true
    end

    function aim.close()
        if closed then return end
        aim.clear()
        closed = true
    end

    return aim
end

return M

end)
