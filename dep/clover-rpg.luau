__bundle_register("Api/Professions/Progress", function(require, _LOADED, __bundle_register, __bundle_modules)
-- progress: profession levels, ranks, rank-challenge readiness and the total-level reward, read off LocalPlayer.Professions and the game's pure-data Professions module; challenge and claim go through Remotes.ProfessionRemote

local Services   = require("Services")
local References = require("References")
local Errors     = require("Api/Professions/Errors")

local REMOTE = "ProfessionRemote"
-- a gather challenge's invoke stays open for the whole minigame (ProfessionClient.lua:597-612 only reads the result after)
local CHALLENGE_TIMEOUT = 120
-- the professions whose challenge is a minigame the solver can answer
local MINIGAMES = { Mining = "Mining", Harvesting = "Harvesting" }

local M = {}

local function validTimeout(value)
    return type(value) == "number" and value == value and value > 0 and value < math.huge
end

function M.new(env, solver)
    local self = {}
    local base = env.base
    local module = nil
    local lastLoadError = nil
    local inFlight = false

    -- ReplicatedStorage.Modules.Professions is pure data (its children are too), so require hands back plain tables; kept once loaded, never while missing
    local function data()
        if module then return module end
        local modules = Services.ReplicatedStorage:FindFirstChild("Modules")
        local instance = modules and modules:FindFirstChild("Professions")
        if instance == nil then return nil end
        local ok, value = pcall(require, instance)
        if not ok or type(value) ~= "table" then
