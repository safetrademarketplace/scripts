    -- ===== outcomes =====

    local function bestThreat(now, predicate)
        local best, bestError = nil, math.huge
        for _, threat in ipairs(threats) do
            local since = now - threat.tell
            if since >= SAMPLE_MIN and since <= SAMPLE_MAX and predicate(threat) then
                local miss = math.abs(since - delayOf(threat))
                if miss < bestError then best, bestError = threat, miss end
            end
        end
        return best
    end

    local function onSword(kind, who)
        if kind ~= "Parry" or who == nil or who ~= character() then return end
        local now = os.clock()
        local threat = bestThreat(now, function(t) return t.pressed ~= nil and now - t.pressed <= CONFIRM and not t.outcome end)
        if not threat then return end
        threat.outcome = "parried"
        stats.parried = stats.parried + 1
        strike(threat, now)
        parrySignal:Fire(threat.model, keyOf(threat))
    end

    local function onVfx(_, model, phase)
        if phase ~= 1 then return end
        local now = os.clock()
        local threat = bestThreat(now, function(t) return t.model == model and not t.learned end)
        if not threat then return end
        strike(threat, now)
    end

    local function onHealth(value)
        local last = health.last
        health.last = value
        if not (finite(value) and finite(last)) or value >= last - 0.5 then return end
        local now = os.clock()
        local threat = bestThreat(now, function(t) return t.outcome == nil end)
        stats.hits = stats.hits + 1
        if not threat then return end
        threat.outcome = "hit"
        strike(threat, now)
    end

    -- a strike that reached us; whether it was a hit is HealthChanged's to say, so the frame labels it a moment later
    local function onStruck()
        local now = os.clock()
        local threat = bestThreat(now, function(t) return not t.learned and t.outcome ~= "parried" end)
        if not threat then return end
        threat.struckAt = now
