        Text = "Rotation Mode",
        Values = { "Camera", "North" },
        Default = "Camera",
        Callback = function(v) radar.mode = v end
    })

    RadarBox:SetupDependencies({
        { Toggles.Radar_Enable, true },
    })

    return { cleanup = destroyRadar }
end

