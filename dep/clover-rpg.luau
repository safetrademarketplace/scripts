__bundle_register("Features/Combat/Aimbot/Aim", function(require, _LOADED, __bundle_register, __bundle_modules)
-- aim targeting + execution: visibility raycast, enemy/friendly/NPC selection, predicted lookAt + camera lerp
return function(cfg, deps)
    local Workspace   = deps.Workspace
    local Players     = deps.Players
    local LocalPlayer = deps.LocalPlayer
    local UserInput   = deps.UserInput
    local getCamera   = deps.getCamera

    local function tableHas(t, val)
        return t and table.find(t, val) ~= nil
    end

    -- throttled: full GetDescendants() of the mob folder is the biggest per-frame cost
    local NPC_REFRESH_INTERVAL = 0.1
    local npcCache = {}
    local npcCacheClock = -math.huge
    local function refreshNPCs()
        local now = os.clock()
        if now - npcCacheClock < NPC_REFRESH_INTERVAL then return npcCache end
        npcCacheClock = now
        local list = {}
        local folder = Workspace:FindFirstChild("NPCS")
            or Workspace:FindFirstChild("NPCs")
            or Workspace:FindFirstChild("Mobs")
        if folder then
            for _, m in ipairs(folder:GetDescendants()) do
                if m:IsA("Model") and m:FindFirstChildOfClass("Humanoid") then
                    list[#list + 1] = m
                end
            end
        end
        npcCache = list
        return list
    end

    -- 50ms player-target cache; chooseTarget's own liveness checks handle staleness
    local TARGET_REFRESH_INTERVAL = 0.05
    local targetCache = {}
    local targetCacheClock = -math.huge
    local lastTypesSig = ""

    local function typesSig(types)
        if not types then return "" end
        return table.concat(types, "|")
    end

    local RayParams = RaycastParams.new()
    RayParams.FilterType = Enum.RaycastFilterType.Exclude

    local function isVisible(part, targetChar)
        if not cfg.WallCheck then return true end
        local cam = getCamera()
        if not cam or not part then return false end

        RayParams.FilterDescendantsInstances = { LocalPlayer.Character, cam }

        local origin = cam.CFrame.Position
        local dir    = part.Position - origin

        local result = Workspace:Raycast(origin, dir, RayParams)
        if not result then return true end
        local hit = result.Instance
        if hit == part then return true end
        if targetChar and hit:IsDescendantOf(targetChar) then return true end
        return false
    end

    local function isEnemy(player)
        if not player then return false end
        -- if no teams exist, everyone is enemy
        if not LocalPlayer.Team or not player.Team then return true end
        return player.Team ~= LocalPlayer.Team
    end

    local function getTargets()
        local types = cfg.TargetTypes or { "Enemy Players" }
        local sig = typesSig(types)
        local now = os.clock()
        if sig == lastTypesSig and (now - targetCacheClock) < TARGET_REFRESH_INTERVAL then
            return targetCache
        end
        targetCacheClock = now
        lastTypesSig = sig

        local list = {}
        local wantEnemies    = tableHas(types, "Enemy Players")
        local wantFriendlies = tableHas(types, "Friendly Players")
        local wantNPCs       = tableHas(types, "NPCs")

        if wantEnemies or wantFriendlies then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        local enemy = isEnemy(plr)
                        if wantEnemies and enemy then
                            list[#list + 1] = plr.Character
                        elseif wantFriendlies and not enemy then
                            list[#list + 1] = plr.Character
                        end
                    end
                end
            end
        end

        if wantNPCs then
            for _, m in ipairs(refreshNPCs()) do
                -- validate liveness — cache may be 100ms stale
                if m.Parent and m:FindFirstChildOfClass("Humanoid") then
                    list[#list + 1] = m
                end
            end
        end
        targetCache = list
        return list
    end

    local function pickTargetPart(char)
        local primaryName = cfg.TargetParts[1] or "Head"

        if math.random(1, 100) <= (cfg.BodyChance or 0) then
            return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
        end

        return char:FindFirstChild(primaryName)
            or char:FindFirstChild("Head")
            or char:FindFirstChild("HumanoidRootPart")
            or char:FindFirstChildWhichIsA("BasePart")
    end

    local function chooseTarget()
        local cam = getCamera()
        if not cam then return nil end

        local mousePos = UserInput:GetMouseLocation()
        local fov2 = cfg.FOV * cfg.FOV
        local bestChar, bestDist2 = nil, math.huge

        -- cull off-screen/out-of-FOV first; isVisible's Workspace:Raycast is the expensive step
        for _, char in ipairs(getTargets()) do
            local part = pickTargetPart(char)
            if part then
                local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
                if onScreen then
                    local dx = screenPos.X - mousePos.X
                    local dy = screenPos.Y - mousePos.Y
                    local d2 = dx * dx + dy * dy
                    if d2 <= fov2 and d2 < bestDist2 and isVisible(part, char) then
                        bestChar = char
                        bestDist2 = d2
                    end
                end
            end
        end
        return bestChar
    end

    local function aimAt(char)
        local cam = getCamera()
        if not cam then return end

        local part = pickTargetPart(char)
        if not part then return end

        local camCFrame = cam.CFrame
        local origin = camCFrame.Position

        local vel = part.AssemblyLinearVelocity or part.Velocity or Vector3.zero
        local predictedPos = part.Position + (vel * cfg.Prediction)

        local dist3D = (predictedPos - origin).Magnitude
        predictedPos = predictedPos + Vector3.new(0, (dist3D / 100) * cfg.DropCompensation, 0)

        -- lerp from the current camera CFrame — overwriting it outright breaks 3rd-person cameras
        local alpha = math.clamp(1 - cfg.Smoothness, 0, 1)
        if alpha <= 0 then return end
        local lookAtCFrame = CFrame.lookAt(origin, predictedPos)
        cam.CFrame = cam.CFrame:Lerp(lookAtCFrame, alpha)

        if cfg.ShowAimLine then
            local vps = cam.ViewportSize
            cfg.AimLine.From = Vector2.new(vps.X * 0.5, vps.Y)
            local sp = cam:WorldToViewportPoint(predictedPos)
            cfg.AimLine.To = Vector2.new(sp.X, sp.Y)
            cfg.AimLine.Visible = true
        else
            cfg.AimLine.Visible = false
        end
    end

    local function shouldAim()
        if UserInput.TouchEnabled then return cfg.MobileAutoAim end

        if typeof(cfg.AimKey) == "EnumItem" and cfg.AimKey.EnumType == Enum.KeyCode then
            if UserInput:IsKeyDown(cfg.AimKey) then return true end
        elseif cfg.AimKey == Enum.UserInputType.MouseButton2 then
            if UserInput:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return true end
        end

        -- hardcoded secondary: right mouse button
        if UserInput:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return true end
        return false
    end

    return {
        chooseTarget = chooseTarget,
        aimAt        = aimAt,
        shouldAim    = shouldAim,
    }
end

end)
