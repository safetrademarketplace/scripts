                lbl.Name = "Studs"
                lbl.BackgroundTransparency = 1
                lbl.Font = Enum.Font.Gotham
                lbl.TextColor3 = Color3.fromRGB(150, 150, 150)
                lbl.TextSize = 10 * radar.scale
                lbl.AnchorPoint = Vector2.new(0.5, 0)
