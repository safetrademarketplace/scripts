local M = {}

-- a group def is { key, label?, gather = function(def) -> candidates, options? }; gather reads def.options to narrow itself
function M.new(targeting)
    local defs, order = {}, {}

    local function register(def)
        if type(def) ~= "table" then return false end
        if type(def.key) ~= "string" or def.key == "" then return false end
        if type(def.gather) ~= "function" then return false end
        if not defs[def.key] then order[#order + 1] = def.key end
        defs[def.key] = {
            key     = def.key,
            label   = tostring(def.label or def.key),
            gather  = def.gather,
            options = (type(def.options) == "table") and def.options or {},
        }
        return true
    end

    register({ key = "Players",  label = "Players",  gather = function(def) return targeting.gatherPlayers(def) end })
    register({ key = "Entities", label = "Entities", gather = function(def) return targeting.gatherEntities(def) end })

    local function get(key)
        return (type(key) == "string") and defs[key] or nil
    end

    -- takes either a key or the display label, so a ui dropdown can hand back whichever it happens to hold
    local function resolve(keyOrLabel)
        if type(keyOrLabel) ~= "string" then return nil end
        if defs[keyOrLabel] then return keyOrLabel end
        for _, key in ipairs(order) do
            if defs[key].label == keyOrLabel then return key end
        end
        return nil
    end

    local function list()
        local out = table.create(#order)
        for i, key in ipairs(order) do
            out[i] = { key = key, label = defs[key].label }
        end
        return out
    end

    local function setOptions(key, options)
        local def = get(key)
        if not (def and type(options) == "table") then return false end
        def.options = options
        return true
    end

    return {
        Register   = register,
        Get        = get,
        Resolve    = resolve,
        List       = list,
        SetOptions = setOptions,
        First      = function() return order[1] end,
    }
end

