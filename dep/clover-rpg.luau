                end
                Ui.values(bossPicker, names)
                -- asking once starts the mob index, so boss spots are learned from boot, farm or no farm
                World.bossSpots(names[1] or "")
                bossesLoaded = true
            end
        end
        if not sellLoaded and type(Inventory) == "table" then
            local ok, names = Inventory.sellableNames()
            if ok and type(names) == "table" and #names > 0 then
                Ui.values(sellPicker, names)
                sellLoaded = true
            end
        end
        if not questsLoaded and type(QuestApi) == "table" then
            local ok, list = QuestApi.repeatables()
            if ok and type(list) == "table" and #list > 0 then
                local names = {}
                for _, template in ipairs(list) do
                    local label = ("%s (%s)"):format(Ui.clean(template.title or template.giver), Ui.clean(template.giver))
                    giverOf[label] = template.giver
                    names[#names + 1] = label
                end
                table.sort(names)
                Ui.values(questPicker, names)
                questsLoaded = true
            end
        end
        if not coursesLoaded and type(Racing) == "table" then
            local ok, list = Racing.courses()
            if ok and type(list) == "table" and #list > 0 then
                local names = {}
                for i, course in ipairs(list) do names[i] = course.name end
                Ui.values(coursePicker, names)
                coursesLoaded = true
            end
        end
        if not mobsLoaded and type(World) == "table" then
            local ok, names = World.mobNames()
            if ok and type(names) == "table" and #names > 0 then
                local list = {}
                for i, name in ipairs(names) do list[i] = name end
                table.sort(list)
                Ui.values(mobPicker, list)
                mobsLoaded = true
            end
        end
        if not itemsLoaded and type(Professions) == "table" then
            local list, seen = {}, {}
            for _, kind in ipairs({ "Ore", "Harvest" }) do
                local ok, names = Professions.itemNames(kind)
                if ok and type(names) == "table" then
                    for _, name in ipairs(names) do
                        if not seen[name] then
                            seen[name] = true
                            list[#list + 1] = name
                        end
                    end
                end
            end
            if #list > 0 then
                table.sort(list)
                Ui.values(itemPicker, list)
                itemsLoaded = true
            end
        end
    end

    local function refresh()
        for name, label in pairs(labels) do
            if engine.running() == name then
                Ui.text(label, Ui.clean(engine.status() or "Starting..."))
            else
                Ui.text(label, "Off")
            end
        end
        Ui.text(statsLabel, statsLine())
    end

    loadLists()
    O.track(Scheduler.heartbeat(function()
        if not (mobsLoaded and itemsLoaded and coursesLoaded and questsLoaded and bossesLoaded and sellLoaded) then loadLists() end
        if Library and not Library.Toggled then return end
        refresh()
    end, { name = "Farm.refresh", interval = REFRESH_EVERY, deferrable = true }))

    O.onUnload(function() engine.stop("unload") end)
    O.finalize()
end

end)
__bundle_register("Features/Clover/Farm/Races", function(require, _LOADED, __bundle_register, __bundle_modules)
-- broom race farm brain: asks the race server for your course (or the Broom Flying rank challenge's course once one is ready), flies to its start marker on the broom, holds there through the countdown, then steers through each gate the moment the server shows it, lining up first when it would clip the ring's edge and flying a gate again when the server didn't count it; then it goes again
local M = {}

-- the countdown began with the root 1.3 from the marker (live 2026-10-24); a marker further off than FAR is reached by a planned trip, nearer it is steered at
local START_REACH = 1.5
local FAR = 120
-- the server answers Start with the marker within a frame or two (live), and drops a race nobody reached the start of after ~180 s
local ASK_WAIT = 4
local START_LIMIT = 150
-- aim this far through a gate's plane, or line up this far in front of it first when the straight line would cross further out than LINE_UP of its radius
local PAST = 12
local APPROACH = 22
local LINE_UP = 0.5
-- with no gate shown yet (the next one arrives ~0.1-0.25 s after a crossing), carry on this far along the last one's line
local CARRY = 40
-- a crossing the server hasn't counted after this long is flown again from the other side
local RETRY_AFTER = 1
-- a gate the broom gets nowhere near is tried again from this far above; the server ignores Quit mid-race (live 2026-10-24), so the only way out is through
local CLIMB_OUT = 60
local CLIMB_TIME = 1.5
local CHALLENGE = "Broom Flying"
local CHALLENGE_TRIES = 2

-- cfg is the live settings table the menu writes: course, speed, challenge
function M.new(cfg)
    local brain = {}
    local steer = nil
    local challengeCourse, challengeTries = nil, 0
    local lastAim, lastDir = nil, nil
    local gates = {}
    local racingApi, seenAt = nil, nil

    function brain.begin()
        steer, challengeCourse, challengeTries = nil, nil, 0
        lastAim, lastDir, gates, seenAt = nil, nil, {}, nil
    end

    -- a race not yet under way is given up when the farm stops; one mid-course ends at its next gate whenever the farm (or the player) flies it
    function brain.stop()
        steer = nil
        if racingApi then pcall(racingApi.quit) end
    end

    local function steering(kit)
        if steer then
            local status = steer.status()
            if status.state ~= "ended" and status.state ~= "arrived" then return steer end
        end
        steer = kit.steer()
        return steer
    end

    -- the rank challenge is taken as soon as it's ready and its course raced next; its course stays picked through a failed try or two
    local function pickCourse(kit)
        if cfg.challenge and not challengeCourse then
            local Professions = kit.api("Professions")
            if Professions then
                local ok, levels = Professions.levels()
                local entry = ok and type(levels) == "table" and levels[CHALLENGE] or nil
                if entry and entry.challengeReady then
                    kit.status("Taking the Broom Flying rank challenge.")
                    local okChallenge, result = Professions.challenge(CHALLENGE)
                    if okChallenge and type(result) == "table" and result.Result == "Race" and type(result.Race) == "string" then
                        challengeCourse, challengeTries = result.Race, 0
                    end
                end
            end
        end
        return challengeCourse or cfg.course
    end

    -- the point to fly at for this gate: through its middle, or lined up in front of it first
    local function aimFor(gate, here, now)
        local record = gates[gate.index]
        if not record then
            local side = (here - gate.position):Dot(gate.normal)
            local dir = gate.normal
            if side > 0 then dir = -dir end
            record = { dir = dir }
            gates[gate.index] = record
        end
        local dir = record.dir
        local offset = here - gate.position
        local depth = -offset:Dot(dir)
        if depth <= 0 then
            -- through it; the server answers within a frame or two, so one still shown a second later wasn't counted
            record.crossedAt = record.crossedAt or now
            if now - record.crossedAt > RETRY_AFTER then
                record.dir, record.crossedAt = -dir, nil
            end
            return gate.position + record.dir * PAST, record.dir
        end
        record.crossedAt = nil
        local lateral = (offset + dir * depth).Magnitude
        if lateral * PAST / (depth + PAST) > gate.radius * LINE_UP then
            return gate.position - dir * APPROACH, dir
        end
        return gate.position + dir * PAST, dir
    end

    local function holdAt(kit, Racing, point, keep)
        local handle = steering(kit)
        if not handle then
            kit.sleep(0.5)
            return
        end
        handle.toward(point, cfg.speed)
        while not kit.stopped() do
            local ok, s = Racing.status()
            if not ok or not keep(s) then return end
            if not kit.sleep(0) then return end
            if handle.status().state == "ended" then return end
        end
    end

    local function fly(kit, Racing)
        local handle = steering(kit)
        if not handle then
            kit.status("Waiting for your broom.")
            kit.sleep(0.5)
            return
        end
        while not kit.stopped() do
            local ok, s = Racing.status()
            if not ok or s.phase ~= "racing" then return end
            local status = handle.status()
            if status.state == "ended" then return end
            local here = kit.position()
            if here then
                local gate = s.gate
                if gate then
                    local aim, dir = aimFor(gate, here, os.clock())
                    lastAim, lastDir = aim, dir
                    handle.toward(aim, cfg.speed)
                    if gate.finish then
                        kit.status(("Racing %s: heading for the finish."):format(s.course or "the course"))
                    else
                        kit.status(("Racing %s: gate %d."):format(s.course or "the course", gate.index))
                    end
                elseif lastAim and lastDir then
                    handle.toward(lastAim + lastDir * CARRY, cfg.speed)
                end
                if status.stuck then
                    kit.status("Something is in the way, so the farm is going over it.")
                    handle.toward(here + Vector3.new(0, CLIMB_OUT, 0), cfg.speed)
                    if not kit.sleep(CLIMB_TIME) then return end
                end
            end
            if not kit.sleep(0) then return end
        end
    end

    local function record(kit, Racing)
        local ok, last = Racing.last()
        if not ok then return end
        -- a race that ended before the farm started isn't the farm's
        if seenAt == nil then
            seenAt = type(last) == "table" and last.at or false
            return
        end
        if type(last) ~= "table" or last.at == seenAt then return end
        seenAt = last.at
        if last.finished then
            kit.add("races")
            local line = ("%s in %.2fs"):format(last.course or "a race", last.time or 0)
            if last.placement then line = line .. (" (#%d this month)"):format(last.placement) end
            kit.stats.lastRace = line
            if last.course == challengeCourse then challengeCourse = nil end
        elseif last.failed and last.course == challengeCourse then
            challengeTries = challengeTries + 1
            if challengeTries >= CHALLENGE_TRIES then challengeCourse = nil end
        end
    end

    function brain.step(kit)
        local Racing = kit.api("Racing")
        if not Racing then
            kit.status("Racing isn't ready yet.")
            kit.sleep(1)
            return
        end
        racingApi = Racing
        local ok, s = Racing.status()
        if not ok then
            kit.sleep(1)
            return
        end
        record(kit, Racing)

        if s.phase == "idle" then
            local course = pickCourse(kit)
            if not course then
                kit.status("Pick a course to race.")
                kit.sleep(1)
                return
            end
            gates, lastAim, lastDir = {}, nil, nil
            local started = Racing.start(course)
            if not started then
                kit.status(("Couldn't start %s right now."):format(course))
                kit.sleep(2)
                return
            end
            local limit = os.clock() + ASK_WAIT
            while os.clock() < limit do
                if not kit.sleep(0.1) then return end
                local okNow, now = Racing.status()
                if okNow and now.phase ~= "starting" then return end
            end
            -- the server never answered; asked again on the next step
            Racing.quit()
            kit.sleep(1)
            return
        end

        if s.phase == "starting" then
            kit.sleep(0.1)
            return
        end

        if s.phase == "waiting" then
            local here = kit.position()
            if not (here and s.start) then
                kit.sleep(0.2)
                return
            end
            if s.askedAt and os.clock() - s.askedAt > START_LIMIT then
                Racing.quit()
                kit.sleep(1)
                return
            end
            local gap = (here - s.start).Magnitude
            if gap > FAR then
                kit.status(("Flying to the start of %s (%d studs away)."):format(s.course or "the race", math.floor(gap)))
                steer = nil
                kit.travel(s.start, { air = true, reach = START_REACH })
                return
            end
            kit.status(("Lining up at the start of %s."):format(s.course or "the race"))
            holdAt(kit, Racing, s.start, function(now) return now.phase == "waiting" end)
            return
        end

        if s.phase == "countdown" then
            kit.status(("Waiting for the countdown on %s."):format(s.course or "the race"))
            holdAt(kit, Racing, s.start or kit.position(), function(now) return now.phase == "countdown" end)
            return
        end

        if s.phase == "racing" then
            fly(kit, Racing)
            return
        end
        kit.sleep(0.2)
    end

    return brain
end

return M

end)
__bundle_register("Features/Clover/Farm/Quests", function(require, _LOADED, __bundle_register, __bundle_modules)
-- quest farm brain: works through the repeatable quests you pick: takes one whose giver is off cooldown (nearest first), does its tasks with the farm's own brains (the gathering farm for a gather, the mob farm for a hunt where the quest points, the race farm for a race), hands it in at the giver and goes on, waiting out the cooldowns when every quest is resting; a quest it has no way to do is left alone
local Mobs  = require("Features/Clover/Farm/Mobs")
local Nodes = require("Features/Clover/Farm/Nodes")
local Races = require("Features/Clover/Farm/Races")

local M = {}

-- live 2026-10-24: accepting and handing in both answered from beside the giver with no dialogue open
local GIVER_REACH = 8
-- a giver's cooldown is asked again no sooner than this, and a giver that would not give is left this long
local RECHECK = 30
local GIVE_UP = 120
-- monsters for a hunt are looked for within this of where the quest points; further than that it flies there first
local AREA = 250
-- a hunt with none of its monsters about for this long (Night Charmers only come out after dark) is set aside this long while other quests go on
local NO_MOB_WAIT = 45
local SET_ASIDE = 300
local WAIT = 5

local function distance(a, b)
    return (a - b).Magnitude
end

local function chosenList(set)
    local out = {}
    for name, on in pairs(set) do
        if on then out[#out + 1] = name end
    end
    table.sort(out)
    return out
end

local function minutes(seconds)
    if seconds < 60 then return ("%ds"):format(math.ceil(seconds)) end
    return ("%dm %02ds"):format(math.floor(seconds / 60), math.floor(seconds % 60))
end

-- cfg is the live settings table the menu writes (givers, a set); shared holds the mob, gathering and race farms' own settings, which the quests borrow
function M.new(cfg, shared)
    local brain = {}
    local mobCfg = setmetatable({ names = {} }, { __index = shared.mob })
    local nodeCfg = setmetatable({ items = {} }, { __index = shared.node })
    local raceCfg = setmetatable({ course = nil, challenge = false }, { __index = shared.race })
    local subs = { kill = Mobs.new(mobCfg), collect = Nodes.new(nodeCfg), race = Races.new(raceCfg) }
    local using = nil
    local readyAt, askedAt, skipped, unable = {}, {}, {}, {}
    local aside, emptySince = {}, nil
    local gatherable = nil

    function brain.begin()
        using, readyAt, askedAt, skipped, unable, gatherable = nil, {}, {}, {}, {}, nil
        aside, emptySince = {}, nil
        for _, sub in pairs(subs) do
            if sub.begin then sub.begin() end
        end
    end

    function brain.stop(why)
        for _, sub in pairs(subs) do
            if sub.stop then pcall(sub.stop, why) end
        end
    end

    local function switch(kit, kind)
        if using == kind then return subs[kind] end
        local previous = using and subs[using] or nil
        if previous and previous.stop then pcall(previous.stop, "switched") end
        -- a block the hunt was holding is let go before anything else is tried
        local Combat = kit.api("Combat")
        if Combat then pcall(Combat.block, false) end
        using = kind
        if subs[kind].begin then subs[kind].begin() end
        return subs[kind]
    end

    -- the nodes that give an item: a plant is its own node, an ore drops from rocks of other names (live 2026-10-24: Silver from Pebble and Stone Cluster); nil when nothing the gathering farm reaches gives it (Wood and Stone come from no node)
    local function nodesFor(kit, item)
        if gatherable == nil then
            local Professions = kit.api("Professions")
            if not Professions then return nil end
            local map = {}
            for _, kind in ipairs({ "Ore", "Harvest" }) do
                local ok, list = Professions.nodes({ kind = kind })
                if ok and type(list) == "table" then
                    for _, entry in ipairs(list) do
                        local gives = entry.drop or entry.item
                        if type(gives) == "string" and type(entry.item) == "string" then
                            map[gives] = map[gives] or {}
                            map[gives][entry.item] = true
                        end
                    end
                end
            end
            if next(map) == nil then return nil end
            gatherable = map
        end
        return gatherable[item]
    end

    local function mobsFor(kit, Quests, stem)
        local World = kit.api("World")
        if not World then return {} end
        local ok, names = World.mobNames()
        if not ok or type(names) ~= "table" then return {} end
        return Quests.matchMobs(stem, names)
    end

    local function giverModel(kit, name)
        local World = kit.api("World")
        if not World then return nil end
        local ok, entry = World.npc(name)
        if ok and type(entry) == "table" then return entry.model end
        return nil
    end

    -- stands by the giver; answers its model once there
    local function reachGiver(kit, name, at)
        local here = kit.position()
        if not here then return nil end
        local model = giverModel(kit, name)
        local spot = (model and model:GetPivot().Position) or at
        if not spot then return nil end
        if distance(here, spot) > GIVER_REACH + 2 then
            kit.status(("Flying to %s (%d studs away)."):format(name, math.floor(distance(here, spot))))
            kit.travel(spot, { reach = GIVER_REACH })
            return nil
        end
        if kit.flying() then
            kit.land()
            return nil
        end
        return model or giverModel(kit, name)
    end

    local function handIn(kit, Quests, quest, template)
        local model = reachGiver(kit, quest.giver, (template and template.position) or quest.returnAt)
        if not model then return end
        kit.status(("Handing in %s."):format(quest.title))
        local ok = Quests.turnIn(quest.key)
        if not ok then
            -- the game's own dialogue hands it in on opening (DM.lua:93-106) when the plain send was not taken
            local Interact = kit.api("Interact")
            if Interact then
                Interact.talk(model)
                kit.sleep(1)
                pcall(Interact.close)
            end
            local okNow, now = Quests.quest(quest.key)
            ok = not okNow or (type(now) == "table" and now.completed)
        end
        if ok then
            kit.add("quests")
            kit.stats.lastQuest = quest.title
            local cooldown = template and template.cooldown or 600
            readyAt[quest.key] = os.clock() + cooldown
        else
            skipped[quest.key] = os.clock() + GIVE_UP
        end
    end

    -- one piece of the task, done by the brain that farms that kind of thing
    local function work(kit, Quests, quest, task)
        local here = kit.position()
        local nodes = task.kind == "collect" and task.target and nodesFor(kit, task.target) or nil
        if nodes then
            nodeCfg.items = nodes
            if task.position and here and distance(here, task.position) > AREA then kit.setHome(task.position) end
            return switch(kit, "collect").step(kit)
        end
        if task.kind == "kill" then
            local names = mobsFor(kit, Quests, task.target)
            if #names == 0 then
                unable[quest.key] = ("Couldn't tell which monster %s wants."):format(quest.title)
                return
            end
            local set = {}
            for _, name in ipairs(names) do set[name] = true end
            mobCfg.names = set
            if task.position then
                kit.setHome(task.position)
                local World = kit.api("World")
                local near = nil
                if World and here then
                    local okNear, list = World.mobs({ names = names, alive = true, origin = here, maxDistance = AREA, limit = 1 })
                    near = okNear and type(list) == "table" and list[1] or nil
                end
                if not near and here and distance(here, task.position) > AREA then
                    kit.status(("Flying to where the %s are for %s."):format(names[1], quest.title))
                    switch(kit, "kill")
                    kit.travel(task.position, { reach = 40 })
                    return
                end
            end
            local hunt = switch(kit, "kill")
            hunt.step(kit)
            if hunt.target() then
                emptySince = nil
            elseif here and task.position and distance(here, task.position) <= AREA * 2 then
                emptySince = emptySince or os.clock()
                if os.clock() - emptySince > NO_MOB_WAIT then
                    emptySince = nil
                    aside[quest.key] = os.clock() + SET_ASIDE
                end
            end
            return
        end
        if task.kind == "race" and task.target then
            raceCfg.course = task.target
            return switch(kit, "race").step(kit)
        end
        unable[quest.key] = ("%s needs something the farm can't do yet (%s)."):format(quest.title, task.name)
    end

    local function templatesBy(Quests)
        local ok, list = Quests.repeatables()
        local out = {}
        if ok and type(list) == "table" then
            for _, template in ipairs(list) do out[template.giver] = template end
        end
        return out
    end

    -- the nearest picked quest that can be taken now; cooldowns are asked as they come up, never more than every RECHECK
    local function takeNext(kit, Quests, givers, templates, holding)
        local here = kit.position()
        if not here then return end
        local now = os.clock()
        local options, soonest = {}, nil
        for _, giver in ipairs(givers) do
            local template = templates[giver]
            if template and template.position and not unable[giver] and not holding[giver] and (skipped[giver] or 0) <= now then
                local at = readyAt[giver] or 0
                if at <= now then
                    options[#options + 1] = template
                elseif not soonest or at < soonest then
                    soonest = at
                end
            end
        end
        table.sort(options, function(a, b) return distance(here, a.position) < distance(here, b.position) end)
        for _, template in ipairs(options) do
            local giver = template.giver
            if (askedAt[giver] or -math.huge) + RECHECK <= now then
                askedAt[giver] = now
                local ok, left = Quests.cooldown(giver)
                if ok and left > 0 then
                    readyAt[giver] = now + left
                    if not soonest or readyAt[giver] < soonest then soonest = readyAt[giver] end
                end
            end
            if (readyAt[giver] or 0) <= now then
                local model = reachGiver(kit, giver, template.position)
                if not model then return end
                kit.status(("Taking %s from %s."):format(template.title, giver))
                local taken = Quests.accept(model)
                if not taken then
                    skipped[giver] = os.clock() + GIVE_UP
                    readyAt[giver] = nil
                end
                return
            end
        end
        local _, setAside = next(aside)
        if soonest then
            kit.status(("Every quest you picked is resting. The next one is ready in %s."):format(minutes(soonest - now)))
        elseif setAside and setAside > now then
            kit.status(("The monsters for your hunts aren't out right now. Looking again in %s."):format(minutes(setAside - now)))
        elseif next(unable) then
            local _, why = next(unable)
            kit.status(why)
        else
            kit.status("None of the quests you picked can be taken right now.")
        end
        kit.sleep(WAIT)
    end

    function brain.step(kit)
        local Quests = kit.api("Quests")
        if not Quests then
            kit.status("Quests aren't ready yet.")
            kit.sleep(1)
            return
        end
        local givers = chosenList(cfg.givers)
        if #givers == 0 then
            kit.status("Pick the quests to do.")
            kit.sleep(1)
            return
        end
        local picked = {}
        for _, giver in ipairs(givers) do picked[giver] = true end
        local templates = templatesBy(Quests)
        local ok, active = Quests.active()
        local holding = {}
        if ok and type(active) == "table" then
            for _, quest in ipairs(active) do
                if not quest.completed then holding[quest.key] = true end
            end
            for _, quest in ipairs(active) do
                if picked[quest.key] and not quest.completed and not unable[quest.key] and (aside[quest.key] or 0) <= os.clock() then
                    if quest.ready then return handIn(kit, Quests, quest, templates[quest.key]) end
                    for _, task in ipairs(quest.tasks) do
                        if not task.done and not task.hidden then
                            kit.status(("%s: %s (%d of %d)."):format(quest.title, task.name, task.progress, task.max))
                            return work(kit, Quests, quest, task)
                        end
                    end
                end
            end
        end
        return takeNext(kit, Quests, givers, templates, holding)
    end

    return brain
end

return M

end)
__bundle_register("Features/Clover/Farm/Nodes", function(require, _LOADED, __bundle_register, __bundle_modules)
-- gathering farm brain: latches onto the nearest ready node of the chosen resources that your tools can gather until it is gathered, flies over on the broom, lands beside it and plays the gather through the professions api (its solver answers the minigame), and heads back to where it was gathering when nothing nearby is ready
local M = {}

local KINDS = { "Ore", "Harvest" }
local SEARCH = 3000
-- the gather prompt is fired from here; a node it could not gather twice is left alone for a while
local REACH = 5
local FAILS = 2
local SKIP_FOR = 90
local WAIT = 3
local GATHER_TIMEOUT = 40
local HOME_FAR = 300

local function distance(a, b)
    return (a - b).Magnitude
end

local function chosenList(items)
    local out = {}
    for name, on in pairs(items) do
        if on then out[#out + 1] = name end
    end
    table.sort(out)
    return out
end

local function describe(list)
    if #list == 1 then return list[1] end
    if #list == 2 then return list[1] .. " or " .. list[2] end
    return "the resources you picked"
end

-- cfg is the live settings table the menu writes: items (a set) and ownTools
function M.new(cfg)
    local brain = {}
    local node = nil
    local skipped, failures = {}, {}

    function brain.begin()
        node, skipped, failures = nil, {}, {}
    end

    local function codeName(Professions, code)
        local errors = Professions.Errors
        if type(errors) ~= "table" then return nil end
        for name, value in pairs(errors) do
            if value == code then return name end
        end
        return nil
    end

    local function pick(kit, Professions)
        local here = kit.position()
        if not here then return nil end
        local now = os.clock()
        local best = nil
        -- the professions filter takes a set of true values only
        local wanted = {}
        for name, on in pairs(cfg.items) do
            if on then wanted[name] = true end
        end
        for _, kind in ipairs(KINDS) do
            local filter = { kind = kind, items = wanted, available = true, origin = here, maxDistance = SEARCH, limit = 8 }
            local usable = true
            if cfg.ownTools then
                local okPower, power = Professions.toolPower(kind)
                if okPower and (tonumber(power) or 0) > 0 then
                    filter.maxPower = power
                elseif okPower then
                    usable = false
                end
            end
            if usable then
                local ok, list = Professions.nodes(filter)
                if ok and type(list) == "table" then
                    for _, entry in ipairs(list) do
                        local skipUntil = skipped[entry.record]
                        if not skipUntil or skipUntil < now then
                            if not best or entry.distance < best.distance then best = entry end
                            break
                        end
                    end
                end
            end
        end
        return best
    end

    local function fail(entry)
        failures[entry.record] = (failures[entry.record] or 0) + 1
        if failures[entry.record] >= FAILS then
            skipped[entry.record] = os.clock() + SKIP_FOR
            failures[entry.record] = nil
        end
        node = nil
    end

    function brain.step(kit)
        local items = chosenList(cfg.items)
        if #items == 0 then
            kit.status("Pick the resources to gather.")
            kit.sleep(1)
            return
        end
        local Professions = kit.api("Professions")
        if not Professions then
            kit.status("Gathering isn't ready yet.")
            kit.sleep(1)
            return
        end
        if node and not cfg.items[node.item] then node = nil end
        if not node then
            node = pick(kit, Professions)
            if not node then
                local home, here = kit.home(), kit.position()
                if home and here and distance(home, here) > HOME_FAR then
                    kit.status("Heading back to where you were gathering.")
                    kit.travel(home, { reach = 20 })
                    return
                end
                kit.status(("No %s ready nearby. Waiting for one to grow back."):format(describe(items)))
                kit.sleep(WAIT)
                return
            end
        end

        local here = kit.position()
        if not here then return end
        local gap = distance(here, node.position)
        if gap > REACH + 1 then
            kit.status(("Flying to %s (%d studs away)."):format(node.item, math.floor(gap)))
            local ok, why = kit.travel(node.position, { reach = REACH })
            if not ok and why ~= "stopped" then fail(node) end
            return
        end
        if kit.flying() then
            kit.status("Landing to gather.")
            kit.land()
            return
        end
        kit.setHome(node.position)
        kit.status(("Gathering %s."):format(node.item))
        local ok, result = Professions.gather(node, { timeout = GATHER_TIMEOUT })
        if ok then
            kit.add("gathered")
            if type(result) == "table" and type(result.stockDelta) == "table" then
                for item, count in pairs(result.stockDelta) do
                    if type(count) == "number" and count > 0 then kit.addItem(item, count) end
                end
            end
            failures[node.record] = nil
            node = nil
            return
        end
        local why = codeName(Professions, result)
        if why == "NOT_STREAMED" or why == "BUSY" then
            kit.sleep(0.5)
        elseif why == "NONE" then
            node = nil
        else
            fail(node)
            kit.sleep(0.5)
        end
    end

    return brain
end

return M

end)
__bundle_register("Features/Clover/Farm/Mobs", function(require, _LOADED, __bundle_register, __bundle_modules)
-- mob farm brain: picks the mob of the chosen kinds it can best take (near, alone, already hurt) and stays on it until it dies, flies over on the broom and lands beside it to fight on foot (the game refuses swings and casts on a broom); with parrying on it fights around the parry: no swing is started that a strike due from the parry api would catch mid-swing (a swinging character's parry is refused), heavies go into the windows the mob's own state attributes say it cannot strike in (stunned, or CantStrike after its attack) and right after a parry lands, lights fill the rest; it watches every frame after a hit for the moment the mob is handed over to finish it with the instakill; without parrying it blocks between swings instead; it never backs off, however low its health
local M = {}

local SEARCH      = 2500
-- further than this it flies; a flight lands this far short of the mob so the landing never ends on top of it
local FIGHT_RANGE = 30
local APPROACH    = 12
-- swings registered from up to about 9 studs live (6.2 seen landing on a wolf); it swings from this far, so a mob shuffling about is not chased after every hit, and chases to this close
local MELEE       = 8
local CHASE_REACH = 4
-- live 2026-10-24 (a level 6 with gauntlets on a wolf): a held block soaked every hit for 12 s but one, a block break with its 1.2 s stun
local GUARD_EVERY = 2
local GUARD_TIME  = 0.9
local WAIT_GUARD  = 0.15
-- the frames after a swing the server is likeliest to hand the mob over in
local LAND_TIME   = 0.35
-- in instakill mode a mob gone this soon after the first instakill on it was the instakill's doing; slower, it was worn down
local EXECUTE_CREDIT = 1
-- a mob it could not kill or reach in this long is left alone for a while
local TARGET_TIME = 90
local SKIP_FOR    = 30
-- picking: each other mob this close to a candidate counts against it as this many studs, and a hurt one is worth this much nearer
local CROWD_GAP   = 25
local CROWD_COST  = 60
local HURT_BONUS  = 80
local HOME_FAR    = 300
-- StateManager.displayTags.lua: the state the heavy attack leaves while it recharges
local HEAVY_COOLDOWN = "HeavyAttackCooldown"
-- the parry api parries what the mobs wind up within this range; the mob is open for a moment after a parry lands, so the guard drops and every swing goes in
local PARRY_RANGE = 30
local PUNISH_TIME = 1
-- how long a swing keeps the character busy (live 2026-10-24: a light held State_Attacking 0.57 s; a heavy is slower), so one is only started with that long left before a strike, plus a margin
local SWING_TIME   = { light = 0.6, heavy = 0.95 }
local STRIKE_SLACK = 0.12
local HOLD_POLL    = 0.03

local function distance(a, b)
    return (a - b).Magnitude
end

local function healthAlive(mob)
    local ok, living = pcall(function()
        return mob.model.Parent ~= nil and mob.humanoid.Parent ~= nil and mob.root.Parent ~= nil and mob.humanoid.Health > 0
    end)
    return ok and living
end

local function rootOf(mob)
    local ok, position = pcall(function() return mob.root.Position end)
    if ok then return position end
    return nil
end

-- how long the mob cannot strike for, off the attributes it carries (live 2026-10-24 on a wolf: State_Stunned 0.75 s after our hit, State_CantStrike 3 s after it finishes an attack, each with a StateEnd_ server-time stamp)
local function freeFor(mob, now)
    if not now then return 0 end
