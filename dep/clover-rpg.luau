__bundle_register("Api/Webhook/Events/InventoryChange", function(require, _LOADED, __bundle_register, __bundle_modules)
-- inventory change event: emits on Backpack tool add/remove; the universal fallback forks override with a replica-based watcher

return {
    key     = "InventoryChange",
    label   = "Backpack Item Change",
    default = false,
    options = {
        { key = "removals", kind = "toggle", label = "Notify on Removal", default = true },
    },
    arm = function(bus)
        local player = bus.References.player

        -- weak-keyed so destroyed tools don't pin gc; guards double-fire on quick swaps
        local seen = setmetatable({}, { __mode = "k" })
        -- backpack listeners live in their own maid so they re-bind cleanly each respawn
        local backpackMaid = bus.NewMaid()
        bus.cleanup(function() backpackMaid:DoCleaning() end)

        local function trackTool(tool)
            if not (tool and tool:IsA("Tool")) or seen[tool] then return end
            seen[tool] = true
            bus.emit({ title = "Item Obtained", description = tool.Name })
        end
        local function untrackTool(tool)
            if not (tool and seen[tool]) then return end
            seen[tool] = nil
            if bus.getOption("removals", true) then
                bus.emit({ title = "Item Removed", description = tool.Name })
            end
        end

        local function hookBackpack(bp)
            backpackMaid:DoCleaning()
            if not bp then return end
            backpackMaid:GiveTask(bp.ChildAdded:Connect(trackTool))
            backpackMaid:GiveTask(bp.ChildRemoved:Connect(untrackTool))
            for _, child in ipairs(bp:GetChildren()) do trackTool(child) end
        end

        bus.track(player.ChildAdded:Connect(function(child)
            if child.Name == "Backpack" then hookBackpack(child) end
        end))
        bus.track(player.ChildRemoved:Connect(function(child)
            if child.Name == "Backpack" then backpackMaid:DoCleaning() end
        end))
        hookBackpack(player:FindFirstChild("Backpack"))
    end,
}

end)
