            s.maid:GiveTask(Jobs.spawn(function(job)
                if waitFor(job, due) then send(s, id, id, due) end
            end, { name = "Professions strike" }))
            return
        end
        if not Minigames.validRing(data) then
            base.warn("left a harvesting ring unanswered: it could not be timed")
            return
        end
        local due = Minigames.ringDue(data)
        local angle = Minigames.aimRing(data, wantCrit, math.random)
