__bundle_register("Api/World/Read", function(require, _LOADED, __bundle_register, __bundle_modules)
-- world read: the instance readers and list filter every world index family shares; pure functions over whatever they are handed, so a streamed-out part reads as nil, never as a throw

local Services = require("Services")

local CollectionService = Services.CollectionService

local RESPAWN_SUFFIX = " Respawnable"

local CHECKS = {
    string   = function(v) return type(v) == "string" and v ~= "" end,
    boolean  = function(v) return type(v) == "boolean" end,
    vector   = function(v) return typeof(v) == "Vector3" end,
    distance = function(v) return type(v) == "number" and v == v and v >= 0 end,
    count    = function(v) return type(v) == "number" and v >= 1 and v == math.floor(v) end,
    -- a set ({ Wolf = true }) or an array ({ "Wolf" }) of names
    names    = function(v)
        if type(v) ~= "table" then return false end
        for key, value in pairs(v) do
            local listed = type(key) == "number" and type(value) == "string"
            local keyed = type(key) == "string" and type(value) == "boolean"
            if not (listed or keyed) then return false end
        end
        return true
    end,
}

local M = {}

function M.truthy(value)
    return value ~= nil and value ~= false
end

function M.text(value)
    if type(value) == "string" and value ~= "" then return value end
    return nil
end

-- "Kamo Guard Respawnable" -> "Kamo Guard", true
function M.stripRespawn(name)
    local cut = #name - #RESPAWN_SUFFIX
    if cut > 0 and string.sub(name, cut + 1) == RESPAWN_SUFFIX then
        return string.sub(name, 1, cut), true
    end
    return name, false
end

-- "DOT_Encampment" -> "DOT Encampment", "MagicTower" -> "Magic Tower"
function M.readable(name)
    local out = string.gsub(name, "_", " ")
    out = string.gsub(out, "(%l)(%u)", "%1 %2")
    out = string.gsub(out, "%s+", " ")
    out = string.gsub(out, "^ ", "")
    out = string.gsub(out, " $", "")
    return out
end

function M.walk(root, segments)
    local node = root
    for i = 1, #segments do
        node = node:FindFirstChild(segments[i])
        if node == nil then return nil end
    end
    return node
end

-- anything a prompt or marker can sit in; a model with no part streamed still answers through its pivot
function M.position(inst)
    if inst == nil then return nil end
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Attachment") then return inst.WorldPosition end
    if inst:IsA("Model") then return inst:GetPivot().Position end
    return nil
end

-- ProximityClient.lua:48-52: the workspace is a Model too, so it never counts as the owner
function M.nearestModel(inst)
    local model = inst:FindFirstAncestorWhichIsA("Model")
    if model == nil or model.ClassName == "Workspace" then return nil end
    return model
end

-- ProximityClient.lua:63-84, the label the game draws over an ordinary prompt
function M.promptLabel(prompt)
    local text = M.text(prompt.ObjectText) or M.text(prompt:GetAttribute("DisplayName"))
    if text then return text end
    local model = M.nearestModel(prompt)
    if model == nil then return nil end
    return M.text(model:GetAttribute("DisplayName")) or model.Name
end

-- ProximityClient.lua:279-283: a BuyPrompt asks its model before itself
function M.shopLabel(prompt)
    local text = M.text(prompt.ObjectText)
    if text then return text end
    local model = M.nearestModel(prompt)
    if model ~= nil then return M.text(model:GetAttribute("DisplayName")) or model.Name end
    return M.text(prompt:GetAttribute("DisplayName")) or "Item"
end

function M.hasTag(inst, tag)
    return CollectionService:HasTag(inst, tag)
end

function M.tags(inst)
    local out = {}
    for _, name in ipairs(CollectionService:GetTags(inst)) do out[name] = true end
    return out
end

function M.byName(a, b)
    return a.name < b.name
end

-- true when a filter carries a key the spec does not list or a value of the wrong shape
function M.badFilter(filter, spec)
    if filter == nil then return false end
    if type(filter) ~= "table" then return true end
    for key, value in pairs(filter) do
        local kind = spec[key]
        if kind == nil or not CHECKS[kind](value) then return true end
    end
    return false
end

-- filter.name and filter.names folded into one lookup set, or nil when neither narrows the list
function M.nameSet(filter)
    if filter == nil or (filter.name == nil and filter.names == nil) then return nil end
    local set = {}
    if filter.name ~= nil then set[filter.name] = true end
    for key, value in pairs(filter.names or {}) do
        if type(key) == "number" then
            set[value] = true
        elseif value then
            set[key] = true
        end
    end
    return set
end

-- distance from origin onto every entry, then maxDistance, nearest-first order and limit
function M.finish(entries, filter, origin)
    local maxDistance = filter and filter.maxDistance
    local limit = filter and filter.limit
    local out = {}
    for _, entry in ipairs(entries) do
        local keep = true
        if origin ~= nil and entry.position ~= nil then
            entry.distance = (entry.position - origin).Magnitude
            if maxDistance ~= nil and entry.distance > maxDistance then keep = false end
        elseif maxDistance ~= nil then
            keep = false
        end
        if keep then out[#out + 1] = entry end
    end
    if origin ~= nil then
        table.sort(out, function(a, b) return (a.distance or math.huge) < (b.distance or math.huge) end)
    end
    if limit ~= nil then
        for i = #out, limit + 1, -1 do out[i] = nil end
    end
    return out
end

return M

end)
__bundle_register("Api/Esp/Groups", function(require, _LOADED, __bundle_register, __bundle_modules)
-- esp group registry: group = { key, label, icon, source(group) -> { {instance, kind, label?} }, config, options, elements }; config is the style schema the renderer reads live, options are the group's own filters (the ui renders them, the source reads config.options) and elements limits which style controls the ui offers

local M = {}

-- config fields the renderer reads each frame; a change to anything else changes what a source lists
local STYLE = {
    teamColor = true, box = true, boxFill = true, box3d = true, name = true, distance = true,
    health = true, tracer = true, arrow = true, skeleton = true, chams = true,
}

-- the style controls a group that marks a spot rather than a body offers; a group with no elements offers them all
M.POINT = { name = true, distance = true, tracer = true, arrow = true, chams = true }

local OPTION_TYPES = { toggle = true, multi = true }

-- one fresh, fully-populated config per group (accent tints the box/tracer/fill/chams)
local function defaultConfig(accent)
    accent = accent or Color3.fromRGB(255, 60, 60)
    local black, white = Color3.new(), Color3.new(1, 1, 1)
    return {
        enabled = false, teamColor = false, limitDistance = false, maxDistance = 150,
        maxTracked = 100, refreshInterval = 1.0, options = {},
        box      = { enabled = true,  color = accent, transparency = 1, thickness = 1, outline = true, outlineColor = black },
        boxFill  = { enabled = false, color = accent, transparency = 0.35 },
        box3d    = { enabled = false, color = accent, transparency = 1, thickness = 1 },
        name     = { enabled = true,  color = white, transparency = 1, outline = true, outlineColor = black },
        distance = { enabled = false, color = white, transparency = 1, outline = true, outlineColor = black },
        health   = { bar = true, text = false, healthyColor = Color3.new(0, 1, 0), dyingColor = Color3.new(1, 0, 0), outline = true, outlineColor = black, textColor = white },
        tracer   = { enabled = false, origin = "Bottom", color = accent, transparency = 1, outline = true, outlineColor = black },
        arrow    = { enabled = false, color = white, transparency = 1, size = 15, radius = 150, outline = true, outlineColor = black },
        skeleton = { enabled = false, color = white, transparency = 1, thickness = 1 },
        chams    = { enabled = false, fillColor = accent, fillTransparency = 0.5, outlineColor = white, outlineTransparency = 0, visibleOnly = false },
    }
end

M.defaultConfig = defaultConfig

-- keeps the well-formed option specs and seeds each one's starting value; a multi pick starts as false, meaning no filter
local function readOptions(list, options)
    local out, seen = {}, {}
    if type(list) ~= "table" then return out end
    for _, option in ipairs(list) do
        local valid = type(option) == "table" and OPTION_TYPES[option.type]
            and type(option.id) == "string" and option.id ~= "" and not seen[option.id]
            and type(option.field) == "string" and option.field ~= ""
        if valid then
            seen[option.id] = true
            out[#out + 1] = option
            if options[option.field] == nil then
                if option.type == "toggle" then
                    options[option.field] = option.default == true
                else
                    options[option.field] = false
                end
            end
        end
    end
    return out
end

function M.new(deps)
    local index = deps.index
    local groups = {}
    local order = {}

    local function register(def)
        if type(def) ~= "table" or type(def.key) ~= "string" or def.key == "" then return false end
        if type(def.source) ~= "function" then return false end
        local config = def.config or defaultConfig()
        if type(config.options) ~= "table" then config.options = {} end
        if not groups[def.key] then order[#order + 1] = def.key end
        groups[def.key] = {
            key      = def.key,
            label    = def.label or def.key,
            icon     = def.icon,
            source   = def.source,
            config   = config,
            options  = readOptions(def.options, config.options),
            elements = type(def.elements) == "table" and def.elements or nil,
        }
        return true
    end

    -- two-level merge so the ui can push one knob (e.g. { box = { enabled = true } } or { options = { items = set } }); true when a non-style field moved, which changes the target list
    local function setConfig(key, partial)
        local g = groups[key]
        if not g or type(partial) ~= "table" then return false end
        local listChanged = false
        for k, v in pairs(partial) do
            if not STYLE[k] then listChanged = true end
            if type(v) == "table" and type(g.config[k]) == "table" then
                for kk, vv in pairs(v) do g.config[k][kk] = vv end
            else
                g.config[k] = v
            end
        end
        return listChanged
    end

    register({
        key = "Players", label = "Players", config = defaultConfig(Color3.fromRGB(255, 60, 60)),
        source = function()
            local out = {}
            for _, plr in ipairs(index.players()) do out[#out + 1] = { instance = plr, kind = "player" } end
            return out
        end,
    })

    return {
        Register = register,
        Get = function(key) return groups[key] end,
        List = function()
            local out = {}
            for _, key in ipairs(order) do
                local g = groups[key]
                out[#out + 1] = { key = g.key, label = g.label, icon = g.icon, options = g.options, elements = g.elements }
            end
            return out
        end,
        SetConfig = setConfig,
    }
end

return M

end)
__bundle_register("Api/Esp/Object", function(require, _LOADED, __bundle_register, __bundle_modules)
