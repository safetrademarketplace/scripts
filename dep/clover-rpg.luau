        entry.want = want
        if not settled(inst, prop, want) then inst[prop] = want end
    end

    local function release(inst, prop)
        local props = held[inst]
        local entry = props and props[prop]
        if entry == nil then return end
        entry.conn:Disconnect()
        props[prop] = nil
        inst[prop] = entry.original
    end

    local function holdAll(inst, props)
        for prop, want in pairs(props) do hold(inst, prop, want) end
    end

    local function holdChild(child)
        if child:IsA("Atmosphere") then
            holdAll(child, ATMOSPHERE)
        elseif child:IsA("ColorCorrectionEffect") and child.Name == GRADE_NAME then
            holdAll(child, GRADE)
        end
    end

    -- a child that leaves Lighting takes its hold with it; there is nothing left to put back
    local function forget(child)
        local props = held[child]
        if props == nil then return end
        for _, entry in pairs(props) do entry.conn:Disconnect() end
