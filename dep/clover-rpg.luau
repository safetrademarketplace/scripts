__bundle_register("Features/Visuals/ESP/Ui", function(require, _LOADED, __bundle_register, __bundle_modules)
-- esp ui: universal groupbox + one box per engine group holding the group's own options (toggles, multi-pick filters) and the style controls it can draw (box/fill/3d/name/distance/health/tracer/skeleton/arrow/chams/team-color), dependency-gated (a group's controls hide until it's enabled, sub-settings hide until their element is on) and bound to the shared ctx.Api.Esp engine. groups come from Engine.GetGroupList() so fork groups appear automatically; every box is built through UI/Place, universal on the left and the groups alternating right/left; a pick list that was empty at build is filled once its group has values
local Identity = require("Utility/Identity")
local Jobs     = require("Utility/Jobs")
local Place    = require("UI/Place")

-- seconds between asks for a pick list that had no values yet
local REFILL_EVERY = 5

return function(deps)
    local Options = deps.Options
    local Toggles = deps.Toggles
    local Engine  = deps.Engine
    local track   = deps.track

    if not (Engine and Place.tab(deps, "ESP")) then return end

    -- pick lists still waiting for values: { id, option, pick }
    local pending = {}

    -- a toggle with an attached color picker; pickers fire Callback, not :OnChanged
    local function coloredToggle(container, id, text, dflt, toggleApply, colorId, colorDflt, title, colorApply)
        local t = container:AddToggle(id, { Text = text, Default = dflt, Callback = toggleApply })
        t:AddColorPicker(colorId, { Default = colorDflt, Title = title,
            Callback = function() colorApply(Options[colorId].Value) end })
        return t
    end

    -- obsidian measures dropdown text as rich text, so a game string must not carry a bare angle bracket
    local function shown(text)
        return (text:gsub("<", "("):gsub(">", ")"))
    end

    -- a group's values for one pick: the list shown and the map from each shown name back to the game's own
    local function pickValues(option)
        local list = option.values
        if type(list) == "function" then
            local ok, result = pcall(list)
            list = ok and result or nil
        end
        local values, rawOf = {}, {}
        if type(list) ~= "table" then return values, rawOf end
        for _, raw in ipairs(list) do
            if type(raw) == "string" and raw ~= "" then
                local label = shown(raw)
                if rawOf[label] == nil then
                    values[#values + 1] = label
                    rawOf[label] = raw
                end
            end
        end
        return values, rawOf
    end

    -- a multi pick hands back shown name -> true; the engine gets the game's names, or false for no filter
    local function pickedSet(value, rawOf)
        local set = nil
        if type(value) ~= "table" then return false end
        for label, on in pairs(value) do
            local raw = on == true and rawOf[label] or nil
            if raw then
                set = set or {}
                set[raw] = true
            end
        end
        return set or false
    end

    local function buildUniversal()
        local Uni = Place.groupbox(deps, "Universal", "settings", { fallback = "ESP", side = "Left" })
        if not Uni then return end
        Uni:AddSlider("ESP_TextSize", { Text = "Text Size", Default = 13, Min = 10, Max = 28, Rounding = 0,
            Callback = function(v) Engine.SetShared({ textSize = v }) end })
        Uni:AddDropdown("ESP_TracerOrigin", { Text = "Tracer Origin", Values = { "Bottom", "Middle", "Top" }, Default = "Bottom",
            Callback = function(v) Engine.SetAllGroups({ tracer = { origin = v } }) end })
        Uni:AddToggle("ESP_LimitRange", { Text = "Limit Range", Default = false,
            Callback = function(v) Engine.SetAllGroups({ limitDistance = v }) end })
        local rangeBox = Uni:AddDependencyBox()
        rangeBox:AddSlider("ESP_MaxRange", { Text = "Range (studs)", Default = 150, Min = 50, Max = 2000, Rounding = 0,
            Callback = function(v) Engine.SetAllGroups({ maxDistance = v }) end })
        rangeBox:SetupDependencies({ { Toggles.ESP_LimitRange, true } })
    end

    -- the group's own switches and filters, pushed into config.options where its source reads them
    local function buildOptions(body, key, cfg, options, picks)
        local current = cfg.options or {}
        for i, option in ipairs(options) do
            local id = key .. "_" .. option.id
            local field = option.field
            if option.type == "toggle" then
                body:AddToggle(id, { Text = option.text, Default = current[field] == true, Tooltip = option.tooltip,
                    Callback = function(v) Engine.SetGroupConfig(key, { options = { [field] = v == true } }) end })
            elseif option.type == "multi" then
                local pick = picks[i]
                body:AddDropdown(id, { Text = option.text, Values = pick.values, Default = {}, Multi = true,
                    AllowNull = true, Searchable = true, Tooltip = option.tooltip,
                    Callback = function(value)
                        Engine.SetGroupConfig(key, { options = { [field] = pickedSet(value, pick.rawOf) } })
                    end })
                if #pick.values == 0 then pending[#pending + 1] = { id = id, option = option, pick = pick } end
            end
        end
    end

    local function buildGroup(group, side)
        local key = group.key
        local cfg = Engine.GetGroupConfig(key)
        if not cfg then return end
        local isPlayers = key == "Players"
        local elements = group.elements
        local function offers(element) return elements == nil or elements[element] == true end

        -- pick values are read before the box exists: a game read between Add* calls can drop the identity obsidian needs
        local options = group.options or {}
        local picks = {}
        for i, option in ipairs(options) do
            if option.type == "multi" then
                local values, rawOf = pickValues(option)
                picks[i] = { values = values, rawOf = rawOf }
            end
        end

        local gbox = Place.groupbox(deps, group.label, group.icon or "eye", { fallback = "ESP", side = side })
        if not gbox then return end

        gbox:AddToggle(key .. "_Enable", { Text = "Enabled", Default = cfg.enabled,
            Callback = function(v) Engine.SetEnabled(key, v) end })

        -- everything below hides until the group is enabled
        local body = gbox:AddDependencyBox()

        buildOptions(body, key, cfg, options, picks)

        if isPlayers then
            body:AddToggle(key .. "_TeamColor", { Text = "Use Team Color", Default = cfg.teamColor,
                Callback = function(v) Engine.SetGroupConfig(key, { teamColor = v }) end })
        end

        if offers("box") then
            coloredToggle(body, key .. "_Box", "Box", cfg.box.enabled,
                function(v) Engine.SetGroupConfig(key, { box = { enabled = v } }) end,
                key .. "_BoxColor", cfg.box.color, "Box Color",
                function(c) Engine.SetGroupConfig(key, { box = { color = c }, boxFill = { color = c }, box3d = { color = c } }) end)
            -- box sub-settings hide until Box is on
            local boxOpts = body:AddDependencyBox()
            boxOpts:AddToggle(key .. "_BoxOutline", { Text = "Outline", Default = cfg.box.outline,
                Callback = function(v) Engine.SetGroupConfig(key, { box = { outline = v } }) end })
            boxOpts:AddToggle(key .. "_Box3d", { Text = "3D Box", Default = cfg.box3d.enabled,
                Callback = function(v) Engine.SetGroupConfig(key, { box3d = { enabled = v } }) end })
            boxOpts:AddToggle(key .. "_BoxFill", { Text = "Fill", Default = cfg.boxFill.enabled,
                Callback = function(v) Engine.SetGroupConfig(key, { boxFill = { enabled = v } }) end })
            boxOpts:AddSlider(key .. "_BoxFillAlpha", { Text = "Fill Opacity", Default = math.floor(cfg.boxFill.transparency * 100), Min = 0, Max = 100, Rounding = 0, Suffix = "%",
                Callback = function(v) Engine.SetGroupConfig(key, { boxFill = { transparency = v / 100 } }) end })
            boxOpts:SetupDependencies({ { Toggles[key .. "_Box"], true } })
        end

        coloredToggle(body, key .. "_Name", "Name", cfg.name.enabled,
            function(v) Engine.SetGroupConfig(key, { name = { enabled = v } }) end,
            key .. "_NameColor", cfg.name.color, "Name Color",
            function(c) Engine.SetGroupConfig(key, { name = { color = c } }) end)

        coloredToggle(body, key .. "_Distance", "Distance", cfg.distance.enabled,
            function(v) Engine.SetGroupConfig(key, { distance = { enabled = v } }) end,
            key .. "_DistColor", cfg.distance.color, "Distance Color",
            function(c) Engine.SetGroupConfig(key, { distance = { color = c } }) end)

        if offers("health") then
            body:AddToggle(key .. "_HealthBar", { Text = "Health Bar", Default = cfg.health.bar,
                Callback = function(v) Engine.SetGroupConfig(key, { health = { bar = v } }) end })
            body:AddToggle(key .. "_HealthText", { Text = "Health Text", Default = cfg.health.text,
                Callback = function(v) Engine.SetGroupConfig(key, { health = { text = v } }) end })
        end

        coloredToggle(body, key .. "_Tracer", "Tracer", cfg.tracer.enabled,
            function(v) Engine.SetGroupConfig(key, { tracer = { enabled = v } }) end,
            key .. "_TracerColor", cfg.tracer.color, "Tracer Color",
            function(c) Engine.SetGroupConfig(key, { tracer = { color = c } }) end)

        if offers("skeleton") then
            coloredToggle(body, key .. "_Skeleton", "Skeleton", cfg.skeleton.enabled,
                function(v) Engine.SetGroupConfig(key, { skeleton = { enabled = v } }) end,
                key .. "_SkeletonColor", cfg.skeleton.color, "Skeleton Color",
                function(c) Engine.SetGroupConfig(key, { skeleton = { color = c } }) end)
        end

        body:AddToggle(key .. "_Arrow", { Text = "Off-Screen Arrow", Default = cfg.arrow.enabled,
            Callback = function(v) Engine.SetGroupConfig(key, { arrow = { enabled = v } }) end })

        local chamsT = body:AddToggle(key .. "_Chams", { Text = "Chams", Default = cfg.chams.enabled,
            Callback = function(v) Engine.SetGroupConfig(key, { chams = { enabled = v } }) end })
        chamsT:AddColorPicker(key .. "_ChamsFill", { Default = cfg.chams.fillColor, Title = "Chams Fill",
            Callback = function() Engine.SetGroupConfig(key, { chams = { fillColor = Options[key .. "_ChamsFill"].Value } }) end })
        chamsT:AddColorPicker(key .. "_ChamsOutline", { Default = cfg.chams.outlineColor, Title = "Chams Outline",
            Callback = function() Engine.SetGroupConfig(key, { chams = { outlineColor = Options[key .. "_ChamsOutline"].Value } }) end })
        local chamsOpts = body:AddDependencyBox()
        chamsOpts:AddToggle(key .. "_ChamsVisible", { Text = "Visible-Only", Default = cfg.chams.visibleOnly,
            Callback = function(v) Engine.SetGroupConfig(key, { chams = { visibleOnly = v } }) end })
        chamsOpts:SetupDependencies({ { Toggles[key .. "_Chams"], true } })

        body:SetupDependencies({ { Toggles[key .. "_Enable"], true } })
    end

    -- the map back to game names is swapped before the list, so a pick made the moment it appears still resolves
    local function refill(job)
        for i = #pending, 1, -1 do
            local row = pending[i]
            local values, rawOf = pickValues(row.option)
            local dropdown = Options[row.id]
            if #values > 0 and dropdown and type(dropdown.SetValues) == "function" then
                row.pick.rawOf = rawOf
                -- a menu write from a job thread needs the gui identity, or it never reaches the screen
                Identity.elevate()
                if pcall(dropdown.SetValues, dropdown, values) then
                    row.pick.values = values
                    table.remove(pending, i)
                end
            end
        end
        if #pending == 0 then job:Cancel() end
    end

    buildUniversal()
    for i, group in ipairs(Engine.GetGroupList()) do
        buildGroup(group, (i % 2 == 1) and "Right" or "Left")
    end

    if #pending > 0 and type(track) == "function" then
        track(Jobs.interval(REFILL_EVERY, refill, { name = "EspPickValues" }))
    end
end

end)
__bundle_register("Tabs/Player", function(require, _LOADED, __bundle_register, __bundle_modules)
-- player tab: flight, speed and jump on the left, clover utils then the utilities and safety boxes on the right (all through UI/Place); returns the Movement module so Cerberus.lua can re-arm it on respawn
local Host        = require("Tabs/Host")
local CloverUtils = require("Features/Clover/PlayerUtils")
local Movement    = require("Features/Player/Movement")
local PlayerUtils = require("Features/Player/Utils")

return function(ctx)
    local Config = ctx.Config
    local movementInst

    -- the game's own utilities head the right column, so they mount first
    if Config.CloverUtils then
        CloverUtils(Host.at(ctx, ctx.Tabs.Player, "Right"))
    end
    if Config.PlayerUtils then
        local sub = Host.at(ctx, ctx.Tabs.Player, "Right")
        sub.quickReset = ctx.Helpers.quickReset
        PlayerUtils(sub)
    end
    if Config.Movement then
        movementInst = Movement(Host.at(ctx, ctx.Tabs.Player, "Left"))
    end

    return movementInst
end

end)
__bundle_register("Features/Player/Utils", function(require, _LOADED, __bundle_register, __bundle_modules)
-- utils orchestrator: two boxes built through UI/Place, utilities (auto use tool, zoom, quick reset, remove kill bricks, fps cap, performance mode) and safety (mod safety, anti-afk, anti-kick, auto rejoin); noclip and desync are gone, the server rewinds both here
local Mount            = require("Utility/Mount")
local Place            = require("UI/Place")
local AntiAFK          = require("Features/Player/Utils/AntiAFK")
local AntiKick         = require("Features/Player/Utils/AntiKick")
local AutoRejoin       = require("Features/Player/Utils/AutoRejoin")
local AutoUseTool      = require("Features/Player/Utils/AutoUseTool")
local FPSCap           = require("Features/Player/Utils/FPSCap")
local ModSafety        = require("Features/Player/Utils/ModSafety")
local PerformanceMode  = require("Features/Player/Utils/PerformanceMode")
local QuickReset       = require("Features/Player/Utils/QuickReset")
local RemoveKillBricks = require("Features/Player/Utils/RemoveKillBricks")
local Zoom             = require("Features/Player/Utils/Zoom")

return function(ctx)
    local O = Mount.orchestrator(ctx, "Utils")
    if not O then return end

    -- every sub-module reads its box as ctx.UtilsGroup; O.mount registers returned cleanup/destroy with the unloader
    local utilities = Place.groupbox(ctx, "Utilities", "wrench", { fallback = "Player", side = "Right" })
    if utilities then
        local uCtx = O.subCtx({ UtilsGroup = utilities, quickReset = ctx.quickReset })
        O.mount(AutoUseTool, uCtx)
        O.mount(Zoom, uCtx)
        O.mount(QuickReset, uCtx)
        O.mount(RemoveKillBricks, uCtx)
        O.mount(FPSCap, uCtx)
        O.mount(PerformanceMode, uCtx)
    end

    local safety = Place.groupbox(ctx, "Safety", "shield", { fallback = "Player", side = "Right" })
    if safety then
        local sCtx = O.subCtx({ UtilsGroup = safety })
        O.mount(ModSafety, sCtx)
        O.mount(AntiAFK, sCtx)
        O.mount(AntiKick, sCtx)
        O.mount(AutoRejoin, sCtx)
    end

    O.finalize()
    return {}
end

end)
__bundle_register("Features/Player/Utils/Zoom", function(require, _LOADED, __bundle_register, __bundle_modules)
-- zoom sub-module of utils (fov-based zoom on the render lane)
local Scheduler = require("Utility/Scheduler")

return function(ctx)
    local Services   = ctx.Services
    local Library    = ctx.Library
    local References = ctx.References
    local Toggles    = ctx.Toggles
    local UtilsGroup = ctx.UtilsGroup
    local track      = ctx.track

    local Zoom = { on = false, conn = nil, origFov = nil, strength = 2 }

    local function applyZoom()
        local cam = References.camera or Services.Workspace.CurrentCamera
        if not (cam and Zoom.origFov) then return end
        cam.FieldOfView = math.clamp(Zoom.origFov / math.max(0.1, Zoom.strength), 10, 120)
    end

    local function stopZoom()
        Zoom.on = false
        if Zoom.conn then
            pcall(function() Zoom.conn:Disconnect() end); Zoom.conn = nil
        end
        local cam = References.camera or Services.Workspace.CurrentCamera
        if cam and Zoom.origFov then pcall(function() cam.FieldOfView = Zoom.origFov end) end
    end

    local tg = UtilsGroup:AddToggle("ZOOM_Enable", {
        Text = "Zoom",
        Default = false,
        Callback = function(on)
            local cam = References.camera or Services.Workspace.CurrentCamera
            if not cam then
                Library:Notify("Camera not ready.", 3); if tg.SetValue then tg:SetValue(false) end; return
            end
            if on then
                if not Zoom.origFov then Zoom.origFov = cam.FieldOfView end
                Zoom.on = true; applyZoom()
                if not Zoom.conn then
                    Zoom.conn = track(Scheduler.render(function()
                        if Zoom.on then applyZoom() end
                    end, { name = "Zoom", priority = 50 }))
                end
            else
                stopZoom()
            end
        end
    }):AddKeyPicker("ZoomKey", {
        Default = nil,
        SyncToggleState = true,
        Mode = "Toggle",
    })

    local ZoomBox = UtilsGroup:AddDependencyBox()

    ZoomBox:AddSlider("ZOOM_Strength", {
        Text = "Zoom Strength",
        Default = 2,
        Min = 1,
        Max = 10,
        Rounding = 1,
        Callback = function(v)
            Zoom.strength = v; if Zoom.on then applyZoom() end
        end
    })

    ZoomBox:SetupDependencies({
        { Toggles.ZOOM_Enable, true },
    })

    return { cleanup = stopZoom }
end

end)
__bundle_register("Features/Player/Utils/RemoveKillBricks", function(require, _LOADED, __bundle_register, __bundle_modules)
-- remove-killbricks sub-module of utils: neutralizes kill/lava/damage-named parts
return function(ctx)
    local Services   = ctx.Services
    local UtilsGroup = ctx.UtilsGroup

    local killParts = {}
    local addConn = nil

    local function isKillName(name)
        local n = name:lower()
        return n:find("kill") or n:find("lava") or n:find("damage")
    end

    local function neutralize(v)
        if killParts[v] then return end
        killParts[v] = { touch = v.CanTouch, collide = v.CanCollide, trans = v.Transparency }
        v.CanTouch = false; v.CanCollide = false; v.Transparency = 0.5
    end

    local function setKillBricks(on)
        if not on then
            if addConn then addConn:Disconnect(); addConn = nil end
            for part, orig in pairs(killParts) do
                if part and part.Parent then
                    part.CanTouch     = orig.touch
                    part.CanCollide   = orig.collide
                    part.Transparency = orig.trans
                end
            end
            table.clear(killParts); return
        end

        for _, v in ipairs(Services.Workspace:GetDescendants()) do
            if v:IsA("BasePart") and isKillName(v.Name) then
                neutralize(v)
            end
        end

        -- DescendantAdded catches streamed-in and dynamically spawned kill bricks the one-shot scan misses
        if not addConn then
            addConn = Services.Workspace.DescendantAdded:Connect(function(v)
                if v:IsA("BasePart") and isKillName(v.Name) then
                    neutralize(v)
                end
            end)
        end
    end

    UtilsGroup:AddToggle("RemoveKillBricks", {
        Text = "Remove KillBricks",
        Default = false,
        Tooltip = "Disable bricks that cause death/damage",
        Callback = function(v) setKillBricks(v) end
    })

    local function cleanup()
        setKillBricks(false)
    end

    return { cleanup = cleanup }
end

end)
