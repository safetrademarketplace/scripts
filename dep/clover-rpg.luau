        removedConn = Lighting.ChildRemoved:Connect(forget)
    end

    local function fbOff()
        if not active then return end
        active = false
        addedConn:Disconnect()
        removedConn:Disconnect()
        addedConn, removedConn = nil, nil
        for inst, props in pairs(held) do
            for prop, entry in pairs(props) do
