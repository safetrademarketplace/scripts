__bundle_register("Features/Clover/VisualUtils/RevealQuestSteps", function(require, _LOADED, __bundle_register, __bundle_modules)
-- reveal hidden quest steps sub-module of clover visuals: clears the Hidden flag on your quest folder that the quest log, the map and the on-screen tracker all filter on, so secret steps and where they are show up; the server can hide a step again, so each one is watched, and only steps this revealed are hidden again on off
local FOLDER = "Quests"
local FLAG   = "Hidden"

return function(ctx)
    local player = ctx.References.player

    local active = false
    local addedConn, removingConn, waitConn = nil, nil, nil
    -- one listener per step, dropped as the step goes so a long session doesn't pile them up
    local watched = {}
    local revealed = setmetatable({}, { __mode = "k" })

    local function reveal(inst)
        if inst:GetAttribute(FLAG) == true then
            revealed[inst] = true
            inst:SetAttribute(FLAG, false)
        end
    end

    local function watch(inst)
        if watched[inst] then return end
        reveal(inst)
        -- the server can hide a step again when the quest moves on
        watched[inst] = inst:GetAttributeChangedSignal(FLAG):Connect(function() reveal(inst) end)
    end

    local function unwatch(inst)
        local conn = watched[inst]
        if conn then
            conn:Disconnect()
            watched[inst] = nil
        end
        revealed[inst] = nil
    end

    local function attach(quests)
        if waitConn then
            waitConn:Disconnect()
            waitConn = nil
        end
        for _, inst in ipairs(quests:GetDescendants()) do watch(inst) end
        addedConn = quests.DescendantAdded:Connect(watch)
        removingConn = quests.DescendantRemoving:Connect(unwatch)
    end

    local function set(on)
        on = on == true
        if on == active then return end
        active = on
        if on then
            local quests = player:FindFirstChild(FOLDER)
            if quests then
                attach(quests)
            else
                waitConn = player.ChildAdded:Connect(function(child)
                    if child.Name == FOLDER then attach(child) end
                end)
            end
            return
        end
        if waitConn then
            waitConn:Disconnect()
            waitConn = nil
        end
        if addedConn then
            addedConn:Disconnect()
            addedConn = nil
        end
        if removingConn then
            removingConn:Disconnect()
            removingConn = nil
        end
        for _, conn in pairs(watched) do conn:Disconnect() end
        table.clear(watched)
        for inst in pairs(revealed) do
            if inst.Parent then inst:SetAttribute(FLAG, true) end
        end
        table.clear(revealed)
    end

    ctx.CloverGroup:AddToggle("CloverRevealQuestSteps", {
        Text     = "Reveal Hidden Quest Steps",
        Default  = false,
        Tooltip  = "Shows quest steps the game keeps secret, in your quest log, on the map and on screen, so you know where to go.",
        Callback = set,
    })

    return { cleanup = function() set(false) end }
end

end)
__bundle_register("Features/Clover/VisualUtils/NoScreenEffects", function(require, _LOADED, __bundle_register, __bundle_modules)
-- no screen effects sub-module of clover visuals: switches off the blind white-out (the game's Client.ScreenFX handler, which only ever draws "BlindLight") and the stun blur, both of which only ever change your own screen
local Executor = require("Utility/Executor")
local Log      = require("Utility/Log")

-- the size CloverClient gives its stun blur before parenting it to Lighting
local STUN_BLUR = 15

local TOOLTIP         = "Stops bright flashes from blinding you and hits from blurring your screen."
local TOOLTIP_PARTIAL = "Stops hits from blurring your screen. Your executor can't block the blinding flash, so that may still show."

local function isStunBlur(child)
    return child:IsA("BlurEffect") and child.Size == STUN_BLUR
end

return function(ctx)
    local Services   = ctx.Services
    local References = ctx.References
    local Lighting   = Services.Lighting

    -- without it the blur half still works; only the white-out half is skipped
    local getconnections = Executor.get("getconnections")
    if type(getconnections) ~= "function" then getconnections = nil end

    local active = false
    local unsubscribe, blurConn = nil, nil
    local gameHandlers = {}
    local blurred = setmetatable({}, { __mode = "k" })

    local function hookFlash()
        if #gameHandlers > 0 or not getconnections then return end
        local remotes = Services.ReplicatedStorage:FindFirstChild("Remotes")
        local client = remotes and remotes:FindFirstChild("Client")
        local screenFx = client and client:FindFirstChild("ScreenFX")
        if not screenFx then return end
        local ok, list = pcall(getconnections, screenFx.OnClientEvent)
        if not ok or type(list) ~= "table" then
            Log.devwarn("CloverVisuals", "no screen effects could not list the flash handlers: %s", tostring(list))
            return
        end
        for _, conn in ipairs(list) do
            if conn.Function and pcall(function() conn:Disable() end) then
                gameHandlers[#gameHandlers + 1] = conn
            end
        end
        Log.dev("CloverVisuals", "no screen effects switched off %d flash handlers", #gameHandlers)
    end

    local function unhookFlash()
        for _, conn in ipairs(gameHandlers) do
            pcall(function() conn:Enable() end)
        end
        table.clear(gameHandlers)
    end

    -- switched off, not destroyed: the game's own tween still fades it out and cleans it up
    local function hideBlur(child)
        if isStunBlur(child) and child.Enabled then
            blurred[child] = true
            child.Enabled = false
        end
    end

    local function showBlurs()
        for blur in pairs(blurred) do
            if blur.Parent then blur.Enabled = true end
        end
        table.clear(blurred)
    end

    local function set(on)
        on = on == true
        if on == active then return end
        active = on
        if on then
            hookFlash()
            for _, child in ipairs(Lighting:GetChildren()) do hideBlur(child) end
            blurConn = Lighting.ChildAdded:Connect(hideBlur)
            -- the remote may not have replicated when this went on, so each spawn looks again
            unsubscribe = References.onCharacter(hookFlash)
            return
        end
        if unsubscribe then
            unsubscribe()
            unsubscribe = nil
        end
        if blurConn then
            blurConn:Disconnect()
            blurConn = nil
        end
        unhookFlash()
        showBlurs()
    end

    ctx.CloverGroup:AddToggle("CloverNoScreenEffects", {
        Text     = "No Screen Effects",
        Default  = false,
        Tooltip  = getconnections and TOOLTIP or TOOLTIP_PARTIAL,
        Callback = set,
    })

    return { cleanup = function() set(false) end }
end

end)
__bundle_register("Features/Clover/VisualUtils/NoCameraShake", function(require, _LOADED, __bundle_register, __bundle_modules)
-- no camera shake sub-module of clover visuals: turns the shake methods of both CameraShaker classes (the PlayerScripts copy behind the global shaker and Client.Shake, and the ReplicatedStorage one every spell's own shaker uses) into no-ops and drops shakes already playing; never :Stop(), queued shakes pile up and all play on Start
local Executor    = require("Utility/Executor")
local Log         = require("Utility/Log")
local LiveModules = require("Features/Clover/PlayerUtils/LiveModules")
local TablePatch  = require("Features/Clover/PlayerUtils/TablePatch")

local METHODS = { "Shake", "ShakeOnce", "ShakeSustain", "StartShake" }
local OWN_SHAKER = { "PlayerScripts", "CloverClient", "CameraShaker", "CameraShaker" }

local UNSUPPORTED = "This doesn't work on your executor."

local function noop() end

local function isShakerClass(t)
    return type(rawget(t, "ShakeOnce")) == "function"
        and type(rawget(t, "StartShake")) == "function"
        and type(rawget(t, "new")) == "function"
end

return function(ctx)
    local Services   = ctx.Services
    local References = ctx.References

    local getgc      = Executor.get("getgc")
    local isreadonly = Executor.get("isreadonly")
    local supported  = type(getgc) == "function"

    local active = false
    local writes = TablePatch.new()

    local function mute()
        -- both classes straight from require too; a heap scan alone can miss one
        local tables = LiveModules.tables(getgc, "CloverVisuals",
            LiveModules.shared(Services, "CameraShaker", "CloverVisuals"),
            LiveModules.require(References.player, OWN_SHAKER, "CloverVisuals"))
        local classes = 0
        for _, v in ipairs(tables) do
            if type(v) == "table" and not (isreadonly and isreadonly(v)) then
                if isShakerClass(v) and not writes.wrote(v, "ShakeOnce") then
                    for _, name in ipairs(METHODS) do
                        if rawget(v, name) ~= nil then writes.write(v, name, noop) end
                    end
                    classes = classes + 1
                elseif type(rawget(v, "_camShakeInstances")) == "table" then
                    -- a live shaker: drop the shakes it is already playing
                    table.clear(v._camShakeInstances)
                end
            end
        end
        if classes == 0 then
            Log.devwarn("CloverVisuals", "no camera shake found no shaker classes")
        else
            Log.dev("CloverVisuals", "no camera shake muted %d shaker classes", classes)
        end
    end

    local function set(on)
        on = on == true and supported
        if on == active then return end
        active = on
        if on then mute() else writes.restore() end
    end

    ctx.CloverGroup:AddToggle("CloverNoCameraShake", {
        Text            = "No Camera Shake",
        Default         = false,
        Tooltip         = "Stops your screen from shaking when spells and hits go off.",
        Disabled        = not supported,
        DisabledTooltip = UNSUPPORTED,
        Callback        = set,
    })

    return { cleanup = function() set(false) end }
end

end)
__bundle_register("Features/Clover/PlayerUtils/TablePatch", function(require, _LOADED, __bundle_register, __bundle_modules)
-- table patch: writes fields on the game's live tables, keeps each field's value from before the first write, and puts every one back exactly on restore
local M = {}

function M.new()
    -- weak keys: a table the game lets go of (an old character's module) takes its saved values with it
    local saved = setmetatable({}, { __mode = "k" })

    local api = {}

    function api.write(t, key, value)
        local keys = saved[t]
        if keys == nil then
            keys = {}
            saved[t] = keys
        end
        if keys[key] == nil then keys[key] = { value = rawget(t, key) } end
        rawset(t, key, value)
    end

    function api.wrote(t, key)
        local keys = saved[t]
        return keys ~= nil and keys[key] ~= nil
    end

    -- how many fields went back, so a caller can skip rerunning the game's code when nothing did
    function api.restore()
        local n = 0
        for t, keys in pairs(saved) do
            for key, box in pairs(keys) do
                -- a table the game froze since keeps our value; the rest still go back
                if pcall(rawset, t, key, box.value) then n = n + 1 end
            end
        end
        table.clear(saved)
        return n
    end

    return api
end

return M

end)
__bundle_register("Features/Clover/PlayerUtils/LiveModules", function(require, _LOADED, __bundle_register, __bundle_modules)
-- live modules: hands features the game's live tables, modules by require first (on this executor it returns the game's own cached copy) and the rest from a heap scan, which can miss a table that is definitely live, so nothing here ever remembers a miss
local Identity = require("Utility/Identity")
local Log      = require("Utility/Log")

local M = {}

-- root.<names...>; a missing link anywhere is a miss, never an error
local function find(root, names)
    local at = root
    for _, name in ipairs(names) do
        if at == nil then return nil end
        at = at:FindFirstChild(name)
    end
    return at
end

function M.load(module, section)
    if module == nil or not module:IsA("ModuleScript") then return nil end
    local ok, value = pcall(require, module)
    -- the game's code can run on this thread and drop the identity the menu needs once the callback returns
    Identity.elevate()
    if ok and type(value) == "table" then return value end
    if not ok then
        Log.devwarn(section or "LiveModules", "could not load %s: %s", module.Name, tostring(value))
    end
    return nil
end

function M.require(root, names, section)
    return M.load(find(root, names), section)
end

-- ReplicatedStorage.Modules.<name>, one copy for the whole session
function M.shared(Services, name, section)
    return M.require(Services.ReplicatedStorage, { "Modules", name }, section)
end

-- the character's own ModuleScript under its State Handler; nil until the character has built it
function M.characterScript(char, name)
    if char == nil then return nil end
    return find(char, { "CharacterScripts", "State Handler", "Client", name })
end

-- every live table worth testing: the heap scan with the required tables added, so a scan that misses them or fails outright still hands them over
function M.tables(getgc, section, ...)
    local out = nil
    if type(getgc) == "function" then
        local ok, objects = pcall(getgc, true)
        if ok and type(objects) == "table" then
            out = objects
        else
            Log.devwarn(section or "LiveModules", "could not list live objects: %s", tostring(objects))
        end
    end
    out = out or {}
    for i = 1, select("#", ...) do
        local t = select(i, ...)
        if type(t) == "table" then out[#out + 1] = t end
    end
    return out
end

-- patches the character's own copy of a module and says whether that copy is now patched; only when require can't load it does the heap scan run, patching every live copy and trusting a fresh patch to be this character's
-- spec: section, getgc, isreadonly, matches(t), patched(t), patch(t)
function M.patchOwn(char, name, spec)
    local module = M.characterScript(char, name)
    -- an old character's copy can linger in memory unpatched, so nothing is looked for before this one exists
    if module == nil then return false end
    local isreadonly = spec.isreadonly
    local own = M.load(module, spec.section)
    if own ~= nil and spec.matches(own) then
        if not spec.patched(own) and not (isreadonly and isreadonly(own)) then spec.patch(own) end
        return spec.patched(own)
    end
    local fresh = false
    for _, v in ipairs(M.tables(spec.getgc, spec.section)) do
        if type(v) == "table" and spec.matches(v) and not spec.patched(v) and not (isreadonly and isreadonly(v)) then
            spec.patch(v)
            fresh = true
        end
    end
    return fresh
end

return M

end)
