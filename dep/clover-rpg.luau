    local function listenable(signal)
        local facade = {}
        function facade.Connect(a, b)
            local fn = b
            if type(a) == "function" then fn = a end
            if type(fn) ~= "function" or closed then return { Disconnect = noop, Destroy = noop } end
            local inner = signal:Connect(fn)
            local function disconnect() inner:Disconnect() end
            return { Disconnect = disconnect, Destroy = disconnect }
        end
        return facade
    end

    local function serverNow()
        local state = apiOf("State")
        if state == nil then return nil end
        local ok, now = state.serverTime()
        if ok and type(now) == "number" then return now end
        return nil
    end

    local function characterPosition()
        local state = apiOf("State")
        if state == nil then return nil end
        local ok, root = state.root()
        if not ok or root == nil then return nil end
        return root.Position
    end

    expose(api, "levels", progress.levels)
    expose(api, "challenge", progress.challenge)
    expose(api, "canClaimTotal", progress.canClaimTotal)
    expose(api, "claimTotal", progress.claimTotal)

    expose(api, "nodes", function(filter)
        local parsed = readFilter(filter, false)
        if parsed == nil then return false, Errors.BAD_ARGS end
        return true, nodes.list(parsed, serverNow())
    end)

    -- measured from the character unless an origin is given
    expose(api, "nearestNode", function(filter)
