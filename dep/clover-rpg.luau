    local function unlockPromptsLater()
        if not promptsOwned then return end
        local generation = promptsGen
        if promptsJob then promptsJob:Cancel() end
        promptsJob = Jobs.delay(PROMPT_RESTORE_DELAY, function()
            promptsJob = nil
            if dead or generation ~= promptsGen or exclusiveOpen() or not promptsOwned then return end
            promptsOwned = false
            setPrompts(true)
        end, { name = "Professions prompt restore" })
    end

    local function summary(s)
        local results = {}
        for i, result in ipairs(s.results) do results[i] = result end
        return {
            kind       = s.kind,
            id         = s.id,
            title      = s.title,
            health     = s.health,
            momentum   = s.momentum,
            rounds     = s.rounds,
            answered   = s.answers,
            lastResult = s.lastResult,
            results    = results,
            mode       = s.mode,
            outcome    = s.outcome,
        }
    end

    local function sendCancel(kind)
        local net = transport()
        if net == nil then return false, "no transport" end
        local ok, code = net.fire(KINDS[kind].path, "Cancel")
        if not ok then base.warn("%s cancel failed: %s", kind, tostring(code)) end
        return ok, code
    end

    local function finish(s, outcome, closeData, keepGate)
        if s.closed then return end
        s.closed = true
        s.outcome = outcome
        if sessions[s.kind] == s then sessions[s.kind] = nil end
        s.maid:DoCleaning()
        if s.mode == "full" then
            if not keepGate then release(s.kind, closeData or { Session = s.id }) end
            if not dead then unlockPromptsLater() end
        end
        local view = summary(s)
        for watcher in pairs(watchers) do
            if watcher.session == s then
                watcher.closed = view
                if watcher.notify then watcher.notify(true) end
            end
        end
        closeSignal:Fire(view)
        for _, after in ipairs(s.after) do base.safe("session close hook", after) end
    end

    local function current(s)
        return not s.closed and sessions[s.kind] == s and active(s.kind)
    end

    local function send(s, id, ...)
        if not current(s) then return end
        s.answers = s.answers + 1
        local net = transport()
        if net == nil then
            base.warn("no transport for a %s answer", s.kind)
            return
        end
        local ok, code = net.fire(KINDS[s.kind].path, ...)
        if not ok then base.warn("%s answer %s failed: %s", s.kind, tostring(id), tostring(code)) end
    end

    local function waitFor(job, due)
        while true do
            local now = serverNow()
            if now == nil then return false end
            if now >= due then return true end
            if not job:sleep(due - now) then return false end
        end
    end

    -- the grade is rolled per answer, so the crit share drifts like a player's instead of reading as a constant
    local function schedule(s, data)
        local id = data.Id
        local wantCrit = math.random() < critRate
        if s.kind == "Mining" then
            local now = serverNow()
            local due = nil
            if now ~= nil and Minigames.validRound(data) then
                due = Minigames.timeAt(data, Minigames.aimStrike(data, s.grace, wantCrit, math.random), now - STALE_LIMIT)
