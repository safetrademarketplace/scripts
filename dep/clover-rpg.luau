        Text = "Enable Radar",
        Default = false,
        Callback = function(v) if v then createRadar() else destroyRadar() end end
    })

    local RadarBox = RadarGroup:AddDependencyBox()

    RadarBox:AddSlider("Radar_Range", {
        Text = "Range",
        Default = 500,
        Min = 100,
        Max = 2000,
        Rounding = 0,
        Suffix = " studs",
        Callback = function(v)
