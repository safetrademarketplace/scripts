    local function restore()
        if dead() ~= false then return false end
        local player = References.player
        local camera = Services.Workspace.CurrentCamera
        local char = player.Character
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        local repaired = false
        local visual = screen()
        if visual then
            for _, name in ipairs({ "Main", "Vignette" }) do
                local item = visual:FindFirstChild(name)
                if item and item.Visible then
                    item.Visible = false
                    repaired = true
                end
            end
            local skull = visual:FindFirstChild("Skull")
            local message = skull and skull:FindFirstChild("Message")
            if message and message.Visible then
                message.Visible = false
                repaired = true
            end
        end
        local getrenv = Executor.get("getrenv")
        if type(getrenv) == "function" then
            local okHover, hovering = pcall(function() return getrenv()._G.CameraHover end)
            if okHover and hovering then
                pcall(function() getrenv()._G.CameraHover = false end)
                repaired = true
            end
        end
        if player.ReplicationFocus ~= nil then
            pcall(function() player.ReplicationFocus = nil end)
            repaired = true
        end
        if camera and camera.CameraType == Enum.CameraType.Scriptable then
            camera.CameraType = Enum.CameraType.Custom
            repaired = true
        end
        if camera and humanoid and camera.CameraSubject ~= humanoid then
            camera.CameraSubject = humanoid
            repaired = true
        end
        if repaired then base.log("put the view back after a respawn") end
        return true, repaired
    end

    scheduleRestore = function()
        local job = Jobs.spawn(function(job)
            local limit = os.clock() + SPAWN_WAIT
            while dead() ~= false and os.clock() < limit do
                if not job:sleep(0.25) then return end
            end
            if not job:sleep(RESTORE_AFTER) then return end
            base.safe("restore view", restore)
        end, { name = "Respawn.restore" })
        if job and base.maid then base.maid:GiveTask(job) end
    end

    expose("restore", function()
        return restore()
    end)

    -- "auto" (the default), "shrine" or "inn"; answers once the server has taken the request, the new character arrives on its own
    expose("respawn", function(want)
        if want == nil then want = "auto" end
        if want ~= "auto" and want ~= "shrine" and want ~= "inn" then return false, Errors.BAD_ARGS end
        local isDead = dead()
        if isDead == nil then return false, Errors.NOT_READY end
        if not isDead then return false, Errors.ALIVE end
        if References.player:GetAttribute("InvasionRespawnLocked") then return false, Errors.LOCKED end
        -- asked before the screen opened, the screen's own close on the new character runs first and its opening lands on a living character (live 2026-10-24)
        if not screenOpen() and diedAt and os.clock() - diedAt < SCREEN_DELAY + SCREEN_GRACE then return false, Errors.TOO_SOON end
        local choice = choose(want)
        if choice == nil then return false, Errors.NO_SHRINE end
        local net = ctx.Api and ctx.Api.CloverNet
        if type(net) ~= "table" then return false, Errors.NOT_READY end
        local ok, code
        if choice == "shrine" then
            local s = state()
            local location = nil
            if s ~= nil then
                local okLoc, name = s.location()
                if okLoc then location = name end
            end
            ok, code = net.callWith(REMOTE, { timeout = ANSWER_WAIT }, "Nearest", location)
        elseif choice == "mission" then
            ok, code = net.callWith(REMOTE, { timeout = ANSWER_WAIT }, "Mission")
        else
            ok, code = net.callWith(REMOTE, { timeout = ANSWER_WAIT })
        end
        if not ok then return false, Errors.FAILED, code end
        scheduleRestore()
        return true, choice
    end)

    local s = state()
    if s ~= nil and type(s.onDied) == "table" then
        local handle = s.onDied.Connect(function() diedAt = os.clock() end)
        if base.maid and handle then base.maid:GiveTask(handle) end
    end

    if base.maid then
        base.maid:GiveTask(function() closed = true end)
    end

    return api
end

return M

end)
