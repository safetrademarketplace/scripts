M.KINDS = KINDS

-- every touch of an executor connection object runs under pcall: their shape differs per executor
local function index(object, key) return object[key] end
local function assign(object, key, value) object[key] = value end

local function field(object, key)
    local ok, value = pcall(index, object, key)
    if ok then return value end
    return nil
end

local function invoke(object, method, ...)
    local fn = field(object, method)
    if type(fn) ~= "function" then return false end
    return pcall(fn, object, ...)
end

