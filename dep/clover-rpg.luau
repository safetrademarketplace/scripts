local Executor  = require("Utility/Executor")
local Jobs      = require("Utility/Jobs")
local Maid      = require("Utility/Maid")
local Scheduler = require("Utility/Scheduler")
local Air       = require("Api/Movement/Air")
local Broom     = require("Api/Movement/Broom")
local Doors     = require("Api/Movement/Doors")
local Errors    = require("Api/Movement/Errors")
local Planner   = require("Api/Movement/Planner")
local Probe     = require("Api/Movement/Probe")
local Tuning    = require("Api/Movement/Tuning")

local distance = Probe.distance
local now = os.clock

-- route endings after which the character is pinned where it stopped, so a pause to think never turns into a fall
local PIN_AFTER = { done = true, blocked = true, stopped = true, retarget = true, arrived = true, timeout = true }

local M = {}

local function finiteNumber(n)
    return type(n) == "number" and n == n and n > -math.huge and n < math.huge
end

function M.finite(v)
    return typeof(v) == "Vector3" and finiteNumber(v.X) and finiteNumber(v.Y) and finiteNumber(v.Z)
end

M.finiteNumber = finiteNumber

local function flatDistance(a, b)
    local dx, dz = a.X - b.X, a.Z - b.Z
    return math.sqrt(dx * dx + dz * dz)
end

-- flat distance plus whatever height lies outside the body, so a node on the floor and an npc's root both count as within reach
local function bodyDistance(position, height, goal)
    local dx, dz = goal.X - position.X, goal.Z - position.Z
    local feetY, headY = position.Y - height, position.Y + Tuning.headroom
    local dy = 0
    if goal.Y < feetY then
        dy = feetY - goal.Y
    elseif goal.Y > headY then
        dy = goal.Y - headY
    end
    return math.sqrt(dx * dx + dy * dy + dz * dz)
end


local function readPosition(fn)
    local ok, value = pcall(fn)
    if ok and M.finite(value) then return value end
    return nil
end

-- a Vector3 stays put, a part or a model is followed, a function is asked again; every read is re-done each leg and a failed one is nil
function M.resolver(target)
    if typeof(target) == "Vector3" then
        if not M.finite(target) then return nil end
        return function() return target end
    end
    if type(target) == "function" then
        return function() return readPosition(target) end
    end
    if typeof(target) ~= "Instance" then return nil end
    local okPart, isPart = pcall(function() return target:IsA("BasePart") end)
    if okPart and isPart then
        return function() return readPosition(function() return target.Position end) end
    end
    local okModel, isModel = pcall(function() return target:IsA("Model") end)
    if okModel and isModel then
        return function() return readPosition(function() return target:GetPivot().Position end) end
    end
    return nil
end

local function sharpTurn(a, b, c)
    local ix, iy, iz = b.X - a.X, b.Y - a.Y, b.Z - a.Z
    local ox, oy, oz = c.X - b.X, c.Y - b.Y, c.Z - b.Z
    local inLength = math.sqrt(ix * ix + iy * iy + iz * iz)
    local outLength = math.sqrt(ox * ox + oy * oy + oz * oz)
    if inLength < 1e-3 or outLength < 1e-3 then return false end
    return (ix * ox + iy * oy + iz * oz) / (inLength * outLength) < Tuning.cornerCos
