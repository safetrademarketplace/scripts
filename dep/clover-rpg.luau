        speedEnabled = false
        if not silent then Library:Notify("Speed disabled.", 2) end
        if speedPropConn then speedPropConn:Disconnect(); speedPropConn = nil end
        if speedCharConn then speedCharConn(); speedCharConn = nil end

        local hum = References.humanoid
        if hum and speedOrigHumanoid == hum and speedOrigWalkSpeed ~= nil then
            hum.WalkSpeed = speedOrigWalkSpeed
        end
    end

