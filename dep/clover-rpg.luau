__bundle_register("Api/Webhook/Registry", function(require, _LOADED, __bundle_register, __bundle_modules)
-- webhook event registry: named embed sources with a declarative option schema (auto-rendered by the ui) and a lazy arm(); universal events plus fork events register here

local M = {}

-- option kinds the ui knows how to render + the store knows how to persist; dropdown/multi pick from `values`
local OPTION_KINDS = {
    toggle   = true,
    slider   = true,
    dropdown = true,
    multi    = true,
    input    = true,
}

local function sanitizeOptions(raw)
    if type(raw) ~= "table" then return {} end
    local out = {}
    for _, opt in ipairs(raw) do
        if type(opt) == "table" and type(opt.key) == "string" and opt.key ~= ""
            and OPTION_KINDS[opt.kind] then
            out[#out + 1] = {
                key     = opt.key,
                kind    = opt.kind,
                label   = opt.label or opt.key,
                default = opt.default,
                values  = opt.values,
                min     = opt.min,
                max     = opt.max,
                tooltip = opt.tooltip,
            }
        end
    end
    return out
end

function M.new()
    local events = {}
    local order  = {}

    -- def = { key, label, default, options = {schema...}, arm = fn(bus) }
    local function register(def)
        if type(def) ~= "table" or type(def.key) ~= "string" or def.key == "" then return false end
        if not events[def.key] then order[#order + 1] = def.key end
        events[def.key] = {
            key     = def.key,
            label   = def.label or def.key,
            default = def.default == true,
            options = sanitizeOptions(def.options),
            arm     = type(def.arm) == "function" and def.arm or nil,
        }
        return true
    end

    local function get(key) return events[key] end

    -- ordered snapshot for the ui (key, label, default, options)
    local function list()
        local out = {}
        for _, key in ipairs(order) do
            local e = events[key]
            out[#out + 1] = {
                key     = e.key,
                label   = e.label,
                default = e.default,
                options = e.options,
            }
        end
        return out
    end

    local function keys()
        local out = {}
        for _, key in ipairs(order) do out[#out + 1] = key end
        return out
    end

    return {
        Register = register,
        Get      = get,
        List     = list,
        keys     = keys,
    }
end

return M

end)
__bundle_register("Api/Webhook/Store", function(require, _LOADED, __bundle_register, __bundle_modules)
-- webhook persistence: owns webhooks.json — destination url + routes, embed theme, enabled events, and per-event options, migrating the old {url,color,anon,selected} layout forward

local Store = require("Utility/Store")

local SCHEMA_VERSION = 2

local M = {}

local function clampComponent(value)
    local n = tonumber(value)
    if not n then return nil end
    if n <= 1 then n = n * 255 end
    n = math.floor(n + 0.5)
    if n < 0 then n = 0 elseif n > 255 then n = 255 end
    return n
end

local function colorToTable(c)
    if typeof(c) ~= "Color3" then return nil end
    return { r = clampComponent(c.R), g = clampComponent(c.G), b = clampComponent(c.B) }
end

local function tableToColor(t)
    if type(t) ~= "table" then return nil end
    local r = clampComponent(t.r or t.R or t[1])
    local g = clampComponent(t.g or t.G or t[2])
    local b = clampComponent(t.b or t.B or t[3])
    if r and g and b then return Color3.fromRGB(r, g, b) end
    return nil
end

function M.new(ctx)
    local DEFAULT_COLOR = Color3.fromRGB(54, 150, 45)
    local KEY           = "webhooks"

    local data = {
        url        = "",
        routes     = {},   -- name -> url
        color      = DEFAULT_COLOR,
        anon       = false,
        username   = "",   -- "" = fall back to theme default
        avatarUrl  = "",
        events     = {},   -- key -> bool
        options    = {},   -- key -> { optKey -> value }
    }

    -- normalize a persisted enabled-map that may be legacy {name=true} or an array
    local function normalizeEvents(raw)
        local out = {}
        if type(raw) ~= "table" then return out end
        local sawBool = false
        for k, v in pairs(raw) do
            if type(v) == "boolean" then sawBool = true; if v then out[tostring(k)] = true end end
        end
        if sawBool then return out end
        for _, name in ipairs(raw) do
            if type(name) == "string" then out[name] = true end
        end
        return out
    end

    local function loadFromDisk()
        local obj = Store.read(Store.GAME, KEY)
        if type(obj) ~= "table" then return end

        if type(obj.url) == "string" then data.url = obj.url end
        if type(obj.anon) == "boolean" then data.anon = obj.anon end
        if type(obj.username) == "string" then data.username = obj.username end
        if type(obj.avatarUrl) == "string" then data.avatarUrl = obj.avatarUrl end
        local color = tableToColor(obj.color)
        if color then data.color = color end
        if type(obj.routes) == "table" then
            for name, url in pairs(obj.routes) do
                if type(name) == "string" and type(url) == "string" then data.routes[name] = url end
            end
        end
        -- events: new `events` map, else migrate the old `selected`/`events` list
        data.events = normalizeEvents(obj.events or obj.selected)
        if type(obj.options) == "table" then
            for key, opts in pairs(obj.options) do
                if type(key) == "string" and type(opts) == "table" then data.options[key] = opts end
            end
        elseif type(obj.eventOptions) == "table" then
            for key, opts in pairs(obj.eventOptions) do
                if type(key) == "string" and type(opts) == "table" then data.options[key] = opts end
            end
        end
    end

    loadFromDisk()

    -- true when no file existed at load — lets the api seed first-run event defaults
    local fresh = not Store.exists(Store.GAME, KEY)

    -- suspendSave starts true to swallow the callback flurry while the ui :SetValues controls from disk; the feature flips it false once settled
    local suspendSave = true

    local function serialize()
        return {
            version   = SCHEMA_VERSION,
            url       = tostring(data.url or ""),
            routes    = data.routes,
            color     = colorToTable(data.color or DEFAULT_COLOR) or colorToTable(DEFAULT_COLOR),
            anon      = data.anon == true,
            username  = tostring(data.username or ""),
            avatarUrl = tostring(data.avatarUrl or ""),
            events    = data.events,
            options   = data.options,
        }
    end

    local function writeNow()
        Store.write(Store.GAME, KEY, serialize())
    end

    local function save()
        if suspendSave then return end
        writeNow()
    end

    -- ensure a file exists on first launch even while the save guard is up
    if fresh then writeNow() end

    local api = {
        data         = data,
        defaultColor = DEFAULT_COLOR,
        file         = Store.path(Store.GAME, KEY),
    }

    function api.getUrl() return tostring(data.url or "") end
    function api.setUrl(v)
        data.url = (type(v) == "string") and v or tostring(v or "")
        save()
    end

    function api.getRoute(name)
        if name == nil or name == "" then return api.getUrl() end
        return data.routes[name] or api.getUrl()
    end
    function api.setRoute(name, url)
        if type(name) ~= "string" or name == "" then return end
        if url == nil or url == "" then data.routes[name] = nil
        else data.routes[name] = tostring(url) end
        save()
    end
    function api.getRoutes() return data.routes end

    function api.getColor() return data.color or DEFAULT_COLOR end
    function api.setColor(c)
        data.color = (typeof(c) == "Color3") and c or DEFAULT_COLOR
        save()
    end

    function api.getAnon() return data.anon == true end
    function api.setAnon(v) data.anon = v == true; save() end

    function api.getUsername()
        return (data.username ~= "" and data.username) or nil
    end
    function api.setUsername(v) data.username = tostring(v or ""); save() end

    function api.getAvatarUrl()
        return (data.avatarUrl ~= "" and data.avatarUrl) or nil
    end
    function api.setAvatarUrl(v) data.avatarUrl = tostring(v or ""); save() end

    function api.isEventEnabled(key) return data.events[key] == true end
    function api.setEventEnabled(key, on)
        if type(key) ~= "string" then return end
