-- attach api: pins the local character onto a chosen player, entity or fork-registered target; built once at boot and shared as ctx.Api.Attach

local Api         = require("Api")
local EntityIndex = require("Utility/EntityIndex")
local Engine      = require("Api/Attach/Engine")
local Groups      = require("Api/Attach/Groups")
local Movers      = require("Api/Attach/Movers")
local Placement   = require("Api/Attach/Placement")
local Runtime     = require("Api/Attach/Runtime")
local Selection   = require("Api/Attach/Selection")
local Session     = require("Api/Attach/Session")
local Targeting   = require("Api/Attach/Targeting")

local M = {}

function M.new(ctx)
    local base = Api.define("Attach", ctx)

    local newMaid = ctx.NewMaid
        or ((ctx.Maid and type(ctx.Maid.new) == "function") and function() return ctx.Maid.new() end)
    if not (newMaid and base.maid) then
        base.warn("no maid factory on ctx; attach not built")
        return nil
    end

    local targeting = Targeting.new({ index = EntityIndex.get(ctx) })
    local groups    = Groups.new(targeting)
    local placement = Placement.new({ Targeting = targeting })
    local movers    = Movers.new({ NewMaid = newMaid })
    local selection = Selection.new({ Groups = groups, Targeting = targeting })
    local runtime   = Runtime.new({
        Helpers    = ctx.Helpers,
        NewMaid    = newMaid,
        References = ctx.References,
    })

    local engine = Engine.new({
        Movers     = movers,
        Placement  = placement,
        References = ctx.References,
        Runtime    = runtime,
        Selection  = selection,
        Targeting  = targeting,
        base       = base,
        maid       = base.maid,
    })

    -- the narrow slice a session borrows and hands back, so Session never reaches into the subsystems itself
    local sessions = Session.new({
        Controls = {
            getExplicit = selection.GetExplicit,
            setExplicit = selection.SetExplicit,
            getMover    = engine.GetMover,
            setMover    = engine.SetMover,
            getOffset   = placement.GetOffset,
            setOffset   = placement.SetOffset,
            getRetarget = selection.GetRetarget,
            setRetarget = selection.SetRetarget,
        },
        Engine = engine,
        signal = base.signal,
    })

    local function setGroup(keyOrLabel)
        if not selection.SetGroup(keyOrLabel) then return false end
        engine.PublishTargets()
        return true
    end

    -- a group added or narrowed while it is the live one takes effect now instead of on the next refresh tick
    local function registerGroup(def)
        if not groups.Register(def) then return false end
        if def.key == selection.GetGroup() then engine.PublishTargets() end
        return true
    end

    local function setGroupOptions(key, options)
        if not groups.SetOptions(key, options) then return false end
        if key == selection.GetGroup() then engine.PublishTargets() end
        return true
    end

    base.log("ready")

    return {
        Start     = engine.Start,
        Stop      = engine.Stop,
        IsRunning = engine.IsRunning,

        AttachTo = sessions.Open,
        Claim    = sessions.Claim,
        GetOwner = sessions.GetOwner,

        GetGroups       = groups.List,
        GetGroup        = selection.GetGroup,
        SetGroup        = setGroup,
        RegisterGroup   = registerGroup,
        SetGroupOptions = setGroupOptions,

        RefreshTargets      = engine.PublishTargets,
        GetTargets          = selection.GetNames,
        GetPicked           = selection.GetPicks,
        SetTargets          = selection.SetPicks,
        SetTarget           = selection.PickOne,
        SetExplicitTarget   = selection.SetExplicit,
        ClearExplicitTarget = function() return selection.SetExplicit(nil) end,
        SetFollowNearest    = selection.SetFollowNearest,
        SetRetarget         = selection.SetRetarget,
        SetAutoRefresh      = engine.SetAutoRefresh,

        GetOffset        = placement.GetOffset,
        SetOffset        = placement.SetOffset,
        GetDefaultOffset = placement.GetDefault,

        GetMovers     = movers.List,
        GetMover      = engine.GetMover,
        SetMover      = engine.SetMover,
